{
  "name": "cv",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=1 astro dev",
    "build": "astro build && node scripts/render-oembed-card.mjs",
    "preview": "ASTRO_PREVIEW_BACKGROUND=1 astro preview",
    "deploy": "npm run check && npm run build && E2E_PREBUILT=1 playwright test && wrangler deploy",
    "astro": "astro",
    "check": "astro check",
    "generate:tokyo-map": "node scripts/generate-tokyo-map.mjs",
    "generate:catalog-thumb": "node scripts/render-catalog-thumb.mjs",
    "og:image": "node scripts/capture-og-image.mjs",
    "test:e2e": "playwright test",
    "test:audit": "playwright test --config playwright.audit.config.ts",
    "test:audit:html-validate": "AUDIT_HTML=html-validate playwright test --config playwright.audit.config.ts audit/markup.spec.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/vue": "^7.0.3",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@iconify-json/lucide": "^1.2.140",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "path-data-polyfill": "^1.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "uuid": "^14.0.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vue/tsconfig": "^0.9.1",
    "chrome-launcher": "^1.2.2",
    "html-validate": "^11.16.2",
    "lighthouse": "^13.5.0",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}
