---
import ThemePicker from '@/components/ThemePicker.astro';
import { AUTHOR_NAME, CONTACT, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '@/site';

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);
const oembedUrl = new URL('/oembed.json', SITE_URL);
oembedUrl.searchParams.set('url', canonical.toString());
oembedUrl.searchParams.set('format', 'json');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR_NAME} />
    <meta property="profile:first_name" content="Hugo" />
    <meta property="profile:last_name" content="Sales" />
    <meta property="profile:username" content={CONTACT.username} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/json+oembed" href={oembedUrl} title={title} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      />
    </noscript>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('cv-theme');
          if (stored && ['light', 'dark', 'arctic', 'dark-forest'].includes(stored)) {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <ThemePicker />
    <slot />
    <footer class="desktop-hint">
      <p>This page works best when viewed on a desktop.</p>
    </footer>
  </body>
</html>

<style lang="scss" is:global>
/* No list-markers by default, since lists are used more often for semantics */
ul, ol {
  list-style: none;
}

.desktop-hint {
  display: none;
  position: fixed;
  inset: auto 0 0;
  z-index: 9;
  padding: 0.45rem 1rem calc(0.45rem + env(safe-area-inset-bottom, 0px));
  text-align: center;
  font: 0.72rem/1.35 var(--font-poppins);
  color: var(--ink-muted);
  background: color-mix(in oklch, var(--surface-raised), transparent 12%);
  border-top: 1px solid var(--line);
  backdrop-filter: blur(8px);

  @media (max-width: 52rem) {
    display: block;
  }
}

/* Avoid browser default inconsistent heading font-sizes */
h1, h2, h3, h4, h5, h6 {
  font-size: 1rem;
}

/* Remove the inconsistent (among browsers) default ul,ol padding or margin  */
/* the default spacing on headings does not match nor align with normal interline spacing at all, so let's get rid of it. */
/* zero out the spacing around pre, form, body, html, p, blockquote as well */
/* form elements are oddly inconsistent, and not quite CSS emulatable. */
/*  nonetheless strip their margin and padding as well */
ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, body, html, p, blockquote, fieldset, input, textarea, figure {
  margin: 0;
  padding: 0;
  border: none;
}

/* Whoever thought blue linked image borders were a good idea? */
a img,
:link img,
:visited img {
  border: none;
}

address {
  font-style: normal;
}

input {
  font: inherit;
  border-color: currentColor;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  view-transition-name: none;
  --font-poppins: "Poppins", system-ui, sans-serif;
}

/* The binder's materials. Every colour is derived from the theme's canvas so the
   four themes get the same set without four copies: the desk is the canvas
   taken down a step, the back cover board two steps, and each index tab keeps
   its own hue at a lightness that sits mid-way in either mode (a light canvas
   gives a pastel tab, a dark one a deep tab). A divider's stock is the sheet
   tinted a little toward its own tab, so tab and sheet read as one section. */
body {
  --desk: oklch(from var(--theme-canvas) calc(l - 0.06) c h);
  --board: oklch(from var(--theme-canvas) calc(l - 0.11) calc(c * 1.5) h);

  --tab-cover: oklch(from var(--theme-canvas) calc(0.4 + 0.43 * l) 0.1 80);
  --tab-materials: oklch(from var(--theme-canvas) calc(0.4 + 0.43 * l) 0.1 250);
  --tab-demos: oklch(from var(--theme-canvas) calc(0.4 + 0.43 * l) 0.1 25);
  --tab-oss: oklch(from var(--theme-canvas) calc(0.4 + 0.43 * l) 0.1 150);

  --stock-cover: color-mix(in oklch, var(--surface-page), var(--tab-cover) 16%);
  --stock-materials: color-mix(in oklch, var(--surface-page), var(--tab-materials) 8%);
  --stock-demos: color-mix(in oklch, var(--surface-page), var(--tab-demos) 8%);
  --stock-oss: color-mix(in oklch, var(--surface-page), var(--tab-oss) 12%);

  --rule: color-mix(in oklch, var(--ink), transparent 88%);
}

main {
  --page-gap: clamp(1rem, 4vw, 2.5rem);
  /* em, not ch: the cap is a page width, and ch pins it to whatever font this
     element inherits. 60em is 960px, which also keeps the demo sheets above the
     56em mark where TechnicalDrawing/Page.astro tucks the note behind the fold. */
  --content-max: 60em;
  /* The demo stacks sit in the breakout column, so this is what caps them. */
  --breakout-max: var(--content-max);

  /* The desk either side of the sheet. On a wide screen the rings pass through
     the left one and the index tabs hang off the right one, so it grows past
     the page gap there. */
  --rail: var(--page-gap);
  /* The sheet's own margin: punched on the left, tabs on the right. */
  --sheet-pad: 0.75rem;
  --sheet-pad-block: 2rem;
  /* Desk showing between one divider and the next; the peeking edges of the
     dividers below live in it. */
  --sheet-gap: 1.25rem;
  /* One per divider in index.astro; the rails span them all so they can stick. */
  --divider-count: 4;
  /* Below 64rem the tabs are a strip fixed to the top of the screen. */
  --tab-strip: 2.5rem;

  --full-width: minmax(var(--rail), 1fr);
  --breakout: minmax(0, calc((var(--breakout-max) - var(--content-max)) / 2));
  --content: min(100% - (var(--rail) + var(--sheet-pad)) * 2, var(--content-max));

  position: relative;
  display: grid;
  grid-template-columns:
    [full-width-start] var(--full-width)
    [sheet-start] var(--sheet-pad)
    [breakout-start] var(--breakout)
    [content-start] var(--content) [content-end]
    var(--breakout) [breakout-end]
    var(--sheet-pad) [sheet-end]
    var(--full-width) [full-width-end];
  grid-template-rows: auto;
  align-content: start;
  padding-block: calc(var(--tab-strip) + 1rem) 1.5rem;

  @media (max-width: 52rem) {
    --page-gap: clamp(0.75rem, 3.5vw, 1.25rem);
    --sheet-pad-block: 1.5rem;
    padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 64rem) {
    --rail: 3.5rem;
    --sheet-pad: 2.5rem;
    --sheet-pad-block: 3rem;
    --sheet-gap: 1.5rem;
    --tab-strip: 0rem;
  }

  > :not(.full-width, .breakout, .divider, .binder-tabs, .binder-rings) {
    grid-column: content;
    min-width: 0;
  }

  .full-width {
    grid-column: full-width;
    min-width: 0;
  }

  .breakout {
    grid-column: breakout;
    min-width: 0;
  }
}

/* A divider sheet. The paper is a pseudo-element so the divider's own box can
   run on into the gap below it: the dividers then touch, and the view timeline
   and the intersection observer that pick the current tab never fall between
   two of them. */
.divider {
  --stock: var(--surface-page);
  --below-1: var(--board);
  --below-2: var(--board);

  grid-column: sheet;
  display: grid;
  grid-template-columns: subgrid;
  align-content: start;
  position: relative;
  z-index: 1;
  padding-block: var(--sheet-pad-block) calc(var(--sheet-pad-block) + var(--sheet-gap));
  scroll-margin-top: var(--tab-strip);

  > * {
    grid-column: content;
    min-width: 0;
  }

  &::before {
    content: '';
    position: absolute;
    inset: 0 0 var(--sheet-gap);
    z-index: -1;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    background-color: var(--stock);
    /* The sheet's own shadow first, so it falls on the two dividers peeking
       out below it; each of those is a filled copy a step down and right with
       a hairline edge. */
    box-shadow:
      0 0.125rem 0.375rem rgb(0 0 0 / 0.12),
      0.25rem 0.375rem 0 -1px var(--below-1),
      0.25rem 0.375rem 0 0 var(--line),
      0.5rem 0.75rem 0 -1px var(--below-2),
      0.5rem 0.75rem 0 0 var(--line);
  }

  &[data-tab='cover'] {
    --stock: var(--stock-cover);
    --below-1: var(--stock-materials);
    --below-2: var(--stock-demos);
  }

  &[data-tab='materials'] {
    --stock: var(--stock-materials);
    --below-1: var(--stock-demos);
    --below-2: var(--stock-oss);

    &::before {
      background-image:
        linear-gradient(to right, color-mix(in oklch, var(--blueprint-grid), transparent 72%) 1px, transparent 1px),
        linear-gradient(to bottom, color-mix(in oklch, var(--blueprint-grid), transparent 72%) 1px, transparent 1px);
      background-size: 2.5rem 2.5rem;
      background-position: center top;
    }
  }

  &[data-tab='demos'] {
    --stock: var(--stock-demos);
    --below-1: var(--stock-oss);

    &::before {
      background-image: radial-gradient(circle, var(--rule) 1px, transparent 1.5px);
      background-size: 1.25rem 1.25rem;
      background-position: center top;
    }
  }

  &[data-tab='oss'] {
    --stock: var(--stock-oss);

    /* Ledger paper: ruled every 1.5rem with the margin line down the left. */
    &::before {
      background-image:
        linear-gradient(to right, transparent var(--sheet-pad), oklch(0.62 0.16 20 / 0.45) var(--sheet-pad), oklch(0.62 0.16 20 / 0.45) calc(var(--sheet-pad) + 1px), transparent calc(var(--sheet-pad) + 1px)),
        repeating-linear-gradient(to bottom, transparent 0 calc(1.5rem - 1px), var(--rule) calc(1.5rem - 1px) 1.5rem);
    }
  }
}

/* How far a tab is pulled out. 1 for the section on screen, 0 for the rest;
   the scroll-driven animation below moves it, and where that is unsupported
   aria-current and :target set it outright. */
@property --proud {
  syntax: '<number>';
  inherits: false;
  initial-value: 0;
}

.binder-tabs {
  --picker-clear: 2.75rem;

  position: fixed;
  inset: 0 0 auto;
  z-index: 8;
  display: flex;
  align-items: end;
  gap: 0.375rem;
  height: var(--tab-strip);
  padding-inline: var(--page-gap) var(--picker-clear);
  background: var(--desk);
  border-bottom: 1px solid var(--line);

  @media (min-width: 52rem) {
    --picker-clear: 7rem;
  }

  a {
    --tab: var(--tab-cover);
    --lift: max(var(--proud), var(--hover, 0));

    display: grid;
    place-items: center;
    padding: calc(0.25rem + var(--lift) * 0.25rem) 0.25rem 0.25rem;
    border-radius: 0.375rem 0.375rem 0 0;
    background: color-mix(in oklch, var(--tab), var(--desk) calc(40% - var(--lift) * 40%));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.3),
      0 0 0.25rem rgb(0 0 0 / 0.15);
    color: var(--ink);
    text-decoration: none;
    transition: padding 200ms ease, background-color 200ms ease;

    &:hover,
    &:focus-visible {
      --hover: 0.5;
    }

    &:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }

    &[href='#materials'] { --tab: var(--tab-materials); }
    &[href='#demos'] { --tab: var(--tab-demos); }
    &[href='#open-source'] { --tab: var(--tab-oss); }

    /* The paper label slid into the tab. */
    span {
      display: block;
      padding: 0.25rem 0.5rem;
      border-radius: 0.125rem;
      background: var(--surface-raised);
      font-size: 0.6875rem;
      line-height: 1;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
  }

  @media (min-width: 64rem) {
    /* Down the sheet's right edge, staggered like a real set, and stuck in
       place while the sheets scroll past. Starts below the theme picker until
       the screen is wide enough for the two not to meet. */
    --rail-top: 9.5rem;

    position: sticky;
    inset: auto;
    top: 0;
    z-index: 2;
    grid-column: sheet-end / full-width-end;
    grid-row: 1 / span var(--divider-count);
    align-self: start;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;
    height: auto;
    padding: var(--rail-top) 0 0;
    margin-left: -0.25rem;
    background: none;
    border-bottom: 0;

    @media (min-width: 90rem) {
      --rail-top: 2rem;
    }

    a {
      writing-mode: vertical-rl;
      inline-size: 6.75rem;
      block-size: 2.25rem;
      padding: 0.25rem;
      border-radius: 0 0.375rem 0.375rem 0;
      box-shadow:
        inset 1px 0 0 rgb(255 255 255 / 0.3),
        0.125rem 0.125rem 0.25rem rgb(0 0 0 / 0.18);
      translate: calc(var(--lift) * 0.375rem) 0;
      transition: translate 200ms ease, background-color 200ms ease;

      span {
        inline-size: 100%;
        block-size: 100%;
        display: grid;
        place-items: center;
        padding: 0;
        font-size: 0.75rem;
      }
    }
  }
}

/* Two rings through the punched margin, stuck to the screen so the sheets
   slide along them. The arc is the half that rises out of the hole and over
   the sheet's edge; the rest is under the paper. */
.binder-rings {
  display: none;

  @media (min-width: 64rem) {
    display: block;
    grid-column: full-width-start / sheet-start;
    grid-row: 1 / span var(--divider-count);
    justify-self: end;
    align-self: start;
    position: sticky;
    top: 20vh;
    z-index: 2;
    width: 3rem;
    height: 60vh;
    margin-top: 20vh;
    pointer-events: none;

    span {
      position: absolute;
      right: -2.75rem;
      width: 3rem;
      height: 3rem;

      &:first-child { top: 0; }
      &:last-child { bottom: 0; }

      &::before,
      &::after {
        content: '';
        position: absolute;
        border-radius: 50%;
      }

      &::before {
        inset: 50% auto auto 50%;
        width: 0.75rem;
        height: 0.75rem;
        translate: -50% -50%;
        background: var(--board);
        box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.55);
      }

      &::after {
        inset: 0;
        background: conic-gradient(from 200deg, #eef0f3, #8f959f 30%, #d6d9de 55%, #767c86 80%, #eef0f3);
        mask: radial-gradient(circle, transparent calc(50% - 0.375rem), #000 calc(50% - 0.3125rem), #000 calc(50% - 0.0625rem), transparent 50%);
        clip-path: inset(0 50% 0 0);
        filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.35));
      }
    }
  }
}

/* The tab follows the sheet under a line 30% down the screen. Named timelines
   on the dividers, scoped to main, drive each tab's own animation; the
   keyframes step in and out at the range's edges so the fill leaves 0 both
   before and after. */
@supports (animation-timeline: view()) {
  main {
    timeline-scope: --tl-cover, --tl-materials, --tl-demos, --tl-oss;
  }

  .divider {
    view-timeline-inset: 30% 69%;

    &[data-tab='cover'] { view-timeline-name: --tl-cover; }
    &[data-tab='materials'] { view-timeline-name: --tl-materials; }
    &[data-tab='demos'] { view-timeline-name: --tl-demos; }
    &[data-tab='oss'] { view-timeline-name: --tl-oss; }
  }

  .binder-tabs a {
    animation: binder-tab-proud linear both;

    &[href='#cover'] { animation-timeline: --tl-cover; }
    &[href='#materials'] { animation-timeline: --tl-materials; }
    &[href='#demos'] { animation-timeline: --tl-demos; }
    &[href='#open-source'] { animation-timeline: --tl-oss; }
  }
}

@keyframes binder-tab-proud {
  0%, 100% { --proud: 0; }
  0.01%, 99.99% { --proud: 1; }
}

@supports not (animation-timeline: view()) {
  .binder-tabs a[aria-current] {
    --proud: 1;
  }

  main:has(#cover:target) .binder-tabs a[href='#cover'],
  main:has(#materials:target) .binder-tabs a[href='#materials'],
  main:has(#demos:target) .binder-tabs a[href='#demos'],
  main:has(#open-source:target) .binder-tabs a[href='#open-source'],
  main:not(:has(:target, [aria-current])) .binder-tabs a:first-child {
    --proud: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .binder-tabs a {
    transition: none;
  }
}

image, svg, img, picture {
  color-scheme: only light;
}

*, ::before, ::after {
  box-sizing: border-box;
}
</style>

<style is:global>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

.skip-link {
  position: fixed;
  top: 0.5rem;
  left: 0.5rem;
  z-index: 20;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line-strong);
  border-radius: 0.25rem;
  background: var(--surface-raised);
  color: var(--ink);
  font: 0.875rem/1.25 var(--font-poppins);
  translate: 0 -200%;

  &:focus-visible {
    translate: 0 0;
    outline: 2px solid var(--ink);
    outline-offset: 0.125rem;
  }
}

.bypass-contrast-check {
  background-image: linear-gradient(transparent, transparent);
}

.inline {
  display: inline;
}

.block {
  display: block;
}

.typewriter {
  font-family: "Special Elite", monospace, system-ui;
  font-weight: 400;
  font-style: normal;
}

.sans-serif {
  font-family: sans-serif;
  font-weight: 400;
  font-style: normal;
}

.poppins {
  font-family: var(--font-poppins);
  font-weight: 400;
  font-style: normal;
}

.monospace {
  font-family: monospace, system-ui;
  font-style: normal;
}

.marker-font {
  font-family: "Permanent Marker", cursive, system-ui;
  font-weight: 400;
  font-style: normal;
}
</style>
