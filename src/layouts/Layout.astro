---
import ThemePicker from '@/components/ThemePicker.astro';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Hugo Sales' CV",
  description = 'CV of Hugo Sales — software engineer with upstream contributions to React, Astro, {fmt}, Git, and co-maintainership of GNU social v3.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      />
    </noscript>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('cv-theme');
          if (stored && ['light', 'dark', 'arctic', 'dark-forest'].includes(stored)) {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <ThemePicker />
    <slot />
    <p class="desktop-hint" role="note">
      This page works best when viewed on a desktop.
    </p>
  </body>
</html>

<style lang="scss" is:global>
/* No list-markers by default, since lists are used more often for semantics */
ul, ol {
  list-style: none;
}

.desktop-hint {
  display: none;
  position: fixed;
  inset-inline: 0;
  bottom: 0;
  z-index: 9;
  margin: 0;
  padding: 0.55rem 1rem calc(0.55rem + env(safe-area-inset-bottom, 0px));
  text-align: center;
  font: 0.78rem/1.35 var(--font-poppins, system-ui, sans-serif);
  color: color-mix(in oklch, var(--ink, #1d241c) 88%, transparent);
  background: color-mix(in oklch, var(--surface-raised, #f4f0ea) 82%, var(--accent, #89ab24) 18%);
  border-top: 1px solid color-mix(in oklch, var(--line-strong, #333) 55%, transparent);

  @media (max-width: 52rem) {
    display: block;
  }
}

/* Avoid browser default inconsistent heading font-sizes */
h1, h2, h3, h4, h5, h6 {
  font-size: 1rem;
}

/* Remove the inconsistent (among browsers) default ul,ol padding or margin  */
/* the default spacing on headings does not match nor align with normal interline spacing at all, so let's get rid of it. */
/* zero out the spacing around pre, form, body, html, p, blockquote as well */
/* form elements are oddly inconsistent, and not quite CSS emulatable. */
/*  nonetheless strip their margin and padding as well */
ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, body, html, p, blockquote, fieldset, input, textarea, figure {
  margin: 0;
  padding: 0;
  border: none;
}

/* Whoever thought blue linked image borders were a good idea? */
a img,
:link img,
:visited img {
  border: none;
}

address {
  font-style: normal;
}

input {
  font: inherit;
  border-color: currentColor;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  view-transition-name: none;
  --font-poppins: "Poppins", system-ui, sans-serif;
}

main {
  --page-gap: clamp(1rem, 4vw, 2.5rem);
  --content-max: 120ch;
  --breakout-max: 90rem;

  --full-width: minmax(var(--page-gap), 1fr);
  --breakout: minmax(0, calc((var(--breakout-max) - var(--content-max)) / 2));
  --content: min(100% - var(--page-gap) * 2, var(--content-max));

  position: relative;
  display: grid;
  grid-template-columns:
    [full-width-start] var(--full-width)
    [breakout-start] var(--breakout)
    [content-start] var(--content) [content-end]
    var(--breakout) [breakout-end]
    var(--full-width) [full-width-end];
  grid-template-rows: auto;
  align-content: start;

  /* Quiet drafting grid */
  background-image:
    linear-gradient(to right, color-mix(in oklch, var(--blueprint-grid), transparent 78%) 1px, transparent 1px),
    linear-gradient(to bottom, color-mix(in oklch, var(--blueprint-grid), transparent 78%) 1px, transparent 1px);
  background-size: 2.5rem 2.5rem;
  background-attachment: local;

  > :not(.full-width, .breakout) {
    grid-column: content;
    min-width: 0;
  }

  .full-width {
    grid-column: full-width;
    min-width: 0;
  }

  .breakout {
    grid-column: breakout;
    min-width: 0;
  }
}

image, svg, img, picture {
  color-scheme: only light;
}

*, ::before, ::after {
  box-sizing: border-box;
}
</style>

<style is:global>
.sr-only {
  position: absolute;
  top: auto;
  width: 1px;
  height: 1px;
  border: none;
  outline: none;
  overflow: hidden;
}

.bypass-contrast-check {
  background-image: linear-gradient(transparent, transparent);
}

.inline {
  display: inline;
}

.block {
  display: block;
}

.typewriter {
  font-family: "Special Elite", monospace, system-ui;
  font-weight: 400;
  font-style: normal;
}

.sans-serif {
  font-family: sans-serif;
  font-weight: 400;
  font-style: normal;
}

.poppins {
  font-family: var(--font-poppins);
  font-weight: 400;
  font-style: normal;
}

.monospace {
  font-family: monospace, system-ui;
  font-style: normal;
}

.marker-font {
  font-family: "Permanent Marker", cursive, system-ui;
  font-weight: 400;
  font-style: normal;
}
</style>
