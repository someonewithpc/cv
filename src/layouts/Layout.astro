---
import ThemePicker from '@/components/ThemePicker.astro';
import TransportKeyArt from '@/components/TechnicalDrawing/TransportKeyArt.astro';
import { AUTHOR_NAME, CONTACT, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '@/site';

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);
const oembedUrl = new URL('/oembed.json', SITE_URL);
oembedUrl.searchParams.set('url', canonical.toString());
oembedUrl.searchParams.set('format', 'json');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR_NAME} />
    <meta property="profile:first_name" content="Hugo" />
    <meta property="profile:last_name" content="Sales" />
    <meta property="profile:username" content={CONTACT.username} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/json+oembed" href={oembedUrl} title={title} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <!-- Digits only: the stencil sets the sheet numbers in the desk margin and nothing else. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Allerta+Stencil&text=0123456789&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Allerta+Stencil&text=0123456789&display=swap" />
    </noscript>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('cv-theme');
          if (stored && ['light', 'dark', 'arctic', 'dark-forest'].includes(stored)) {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <nav class="skip-nav" aria-label="Keyboard shortcuts">
      <a class="skip-link" href="#career" accesskey="s">Skip to content</a>
      <div class="accesskey-legend">
        <p class="accesskey-legend-mod"><kbd class="ak-mod">Alt</kbd> + key</p>
        {/* Links, not accesskeys on the sections: an access key focuses its element, and focus()
            centres anything taller than the viewport, which left the reader mid-sheet on a torn
            edge. A link's access key follows the link, and the fragment jump puts the section's
            top at the top of the viewport and focuses it (tabindex="-1"). tabindex="-1" here
            keeps them out of the Tab order. */}
        <ul>
          <li><kbd>S</kbd> Skip to content</li>
          <li><kbd>T</kbd> Theme picker</li>
          <li><a href="#profile" accesskey="h" tabindex="-1"><kbd>H</kbd> Top of the page</a></li>
          <li><a href="#career" accesskey="c" tabindex="-1"><kbd>C</kbd> Career</a></li>
          <li><a href="#bill-of-materials" accesskey="b" tabindex="-1"><kbd>B</kbd> Bill of materials</a></li>
          <li><a href="#demos" accesskey="m" tabindex="-1"><kbd>M</kbd> Demos</a></li>
          <li><a href="#open-source" accesskey="o" tabindex="-1"><kbd>O</kbd> Open source</a></li>
          <li><kbd>P</kbd> Previous page, when a stack has focus</li>
          <li><kbd>N</kbd> Next page, when a stack has focus</li>
        </ul>
      </div>
      <button type="button" class="page-turn-key sr-only" tabindex="-1" accesskey="p" data-turn="ArrowLeft">Previous page</button>
      <button type="button" class="page-turn-key sr-only" tabindex="-1" accesskey="n" data-turn="ArrowRight">Next page</button>
    </nav>
    <script>
      // The two buttons above exist only so accesskey="p"/"n" have somewhere to land: pressing
      // one moves focus to the button first (the browser's own accesskey behaviour, not
      // scripted), which is the previously-focused element's `focusin.relatedTarget`. If that
      // was a paper stack, replay the same ArrowLeft/ArrowRight keydown its own listener
      // (PaperStack/fold-drag.ts) already turns pages on, then hand focus straight back so the
      // ring returns to the stack and a second press keeps working.
      for (const button of document.querySelectorAll<HTMLButtonElement>('.page-turn-key')) {
        button.addEventListener('focusin', (event) => {
          const stack = event.relatedTarget;
          const key = button.dataset.turn;
          if (!key || !(stack instanceof HTMLElement) || !stack.hasAttribute('data-paper-stack-root')) return;
          stack.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true }));
          stack.focus();
        });
      }

      // accesskey's real modifier is not something CSS can read: it is Alt on Chrome (Linux and
      // Windows), Alt+Shift on Firefox (Linux and Windows), and Ctrl+Alt on a Mac regardless of
      // browser, and there is no media query for "which browser engine" or "which OS". A UA
      // check, run once at load, is the only way to show the legend's true key combination.
      const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform ?? navigator.userAgent);
      const isFirefox = /Firefox\//.test(navigator.userAgent);
      const modifier = isMac ? 'Ctrl+Alt' : isFirefox ? 'Alt+Shift' : 'Alt';
      for (const mod of document.querySelectorAll('.ak-mod')) mod.textContent = modifier;
    </script>
    <ThemePicker />
    <TransportKeyArt />
    <slot />
  </body>
</html>

<style lang="scss" is:global>
@use "@/scss/_page-column.scss" as column;

/* No list-markers by default, since lists are used more often for semantics */
ul, ol {
  list-style: none;
}

/* Avoid browser default inconsistent heading font-sizes */
h1, h2, h3, h4, h5, h6 {
  font-size: 1rem;
}

/* Remove the inconsistent (among browsers) default ul,ol padding or margin  */
/* the default spacing on headings does not match nor align with normal interline spacing at all, so let's get rid of it. */
/* zero out the spacing around pre, form, body, html, p, blockquote as well */
/* form elements are oddly inconsistent, and not quite CSS emulatable. */
/*  nonetheless strip their margin and padding as well */
ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, body, html, p, blockquote, fieldset, input, textarea, figure {
  margin: 0;
  padding: 0;
  border: none;
}

/* Whoever thought blue linked image borders were a good idea? */
a img,
:link img,
:visited img {
  border: none;
}

address {
  font-style: normal;
}

input {
  font: inherit;
  border-color: currentColor;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  view-transition-name: none;
  --font-poppins: "Poppins", system-ui, sans-serif;
  --font-stencil: "Allerta Stencil", "Impact", "Arial Black", system-ui, sans-serif;
}

body {
  /* The theme picker's face (ThemePicker.astro), so prose, lists, captions
     and controls read as one sheet. system-ui also stops the 13px default
     size browsers give a bare monospace stack. */
  font-family: monospace, system-ui;

  /* The cutting mat the demos lie on. A light theme lifts the canvas toward vellum, a dark one
     mixes it toward the blueprint, and both rule it in the blueprint colour. The ruling stays
     close to the mat it is on, so the sheets keep the eye and the stacks' hints, which are
     written on the mat and not on their sheet, still read against it. */
  --mat-paper: light-dark(
    color-mix(in oklch, var(--theme-canvas), white 24%),
    color-mix(in oklch, var(--theme-canvas), var(--theme-blueprint) 30%)
  );
  /* The major lines' ink; the minor lines take half of it (cuttingMatGrid.ts). */
  --mat-grid-major: light-dark(
    color-mix(in oklch, var(--theme-blueprint), transparent 86%),
    color-mix(in oklch, var(--theme-blueprint), transparent 60%)
  );
  --mat-edge: light-dark(
    color-mix(in oklch, var(--ink-muted), transparent 40%),
    color-mix(in oklch, white, var(--theme-blueprint) 35%)
  );
}

main {
  /* The page column and its gutters are written from src/scss/_page-column.scss, which also
     derives from them the window widths the Career and Open Source rules switch at. A change
     to them goes there. */
  --page-gap: #{column.page-gap(column.$page-gap-wide)};
  /* rem, not ch or em: the cap is a page width, and ch pins it to whatever font this
     element inherits. The measures built on it reach elements with their own type through
     variables, and an em there would be read against that type: the sheets' --sheet-inline
     (TechnicalDrawing/Stack.astro) scales artwork set in 9 to 14px type. 60rem is 960px,
     which also keeps the demo sheets above the 56em mark where TechnicalDrawing/Page.astro
     tucks the note behind the fold. */
  --content-max: #{column.$content-max};
  /* The demo stacks sit in the breakout column, so this is what caps them. */
  --breakout-max: var(--content-max);

  /* The cutting mat's geometry belongs to the desk and not to the mat, because the folio
     stands in the margin the mat leaves and has to know where it ends (index.astro lays the
     mat out from these, Callout.astro draws its boundary and card from them). Out from the
     drawing, each side of the mat is: the callout's boundary, --mat-boundary past the view;
     --mat-clear of ruled mat past that; the unruled rim; and the mat's edge line. Edge to
     edge on a phone, the rim is the page gutter less the line, so a stack is exactly as wide
     as it was without the mat. */
  --mat-line: 1px;
  --mat-rim: calc(var(--page-gap) - var(--mat-line));
  --mat-clear: 0px;

  /* The lane a detail's title card stands in, beside the view rather than under it. It is
     open only from 105rem, where the desk holds a stack, a card and the folio side by side.
     The card is --card-gap off the view, which is the boundary's clearance and a 1.5rem
     leader, and the lane leaves the boundary's clearance out, because on the card's side the
     card is what stands out past the view and on the other side the boundary is: both reach
     the same distance out, so the mat hugs either the same. */
  --card-width: 12rem;
  --card-gap: calc(var(--mat-boundary, 0px) + 1.5rem);
  --card-lane: 0px;
  --card-display: none;

  /* The sheet number in the desk's left margin (Folio.astro). The lane it stands in is what
     the desk can spare once the mat has the width it needs, and it never grows past what a
     7.5rem numeral asks for: the numeral's own width, about 1.15 of its size for two stencil
     digits, and 1.5rem of desk left clear between it and the paper beside it. The numeral is
     then sized from the lane, so it fits the margin at every width. Below 76rem the lane
     would be under 5rem and the numeral under 3rem, so there is no folio, and no measurement
     moves for one. */
  --folio-gap: 1.5rem;
  --folio-lane: 0px;
  --type-folio: calc((var(--folio-lane) - var(--folio-gap)) / 1.15);

  /* --mat-max is as wide as the mat ever needs to be: the widest drawing, the card lane, and
     the four bands above on either side. The mat stops there and is centred, so it hugs what
     is laid on it and the rest is desk. --desk-edge is where the paper starts: the near edge
     of the widest thing the desk lays down, which is always the mat, and the folio hangs off
     it rather than off the window. */
  --mat-inset: 0px;
  --mat-max: calc(
    var(--breakout-max) + var(--card-lane)
      + (var(--mat-boundary, 0px) + var(--mat-clear) + var(--mat-rim) + var(--mat-line)) * 2
  );
  --desk-edge: max((100vw - var(--mat-max)) / 2, var(--mat-inset));

  @media (width >= 76rem) {
    --folio-lane: min(
      (100vw - var(--mat-max)) / 2,
      calc(7.5rem * 1.15 + var(--folio-gap))
    );
  }

  @media (width >= 105rem) {
    --card-lane: calc(var(--card-width) + var(--card-gap) - var(--mat-boundary));
    --card-display: block;
  }

  --full-width: minmax(var(--page-gap), 1fr);
  --breakout: minmax(0, calc((var(--breakout-max) - var(--content-max)) / 2));
  --content: min(100% - var(--page-gap) * 2, var(--content-max));

  --page-columns:
    [full-width-start] var(--full-width)
    [breakout-start] var(--breakout)
    [content-start] var(--content) [content-end]
    var(--breakout) [breakout-end]
    var(--full-width) [full-width-end];

  position: relative;
  display: grid;
  grid-template-columns: var(--page-columns);
  /* Five rows, one per sheet, written out rather than left implicit: a folio is placed in
     the row of the sheet it numbers, and an absolutely positioned grid child can only name a
     line of the explicit grid. */
  grid-template-rows: repeat(5, auto);
  align-content: start;
  padding-bottom: 1.5rem;

  @media (max-width: #{column.$page-narrow-max}) {
    --page-gap: #{column.page-gap(column.$page-gap-narrow)};
    padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
  }

  /* The page lies on a desk at every width. The desk is veneer: --theme-desk-tile is one
     scan of oak per theme with the theme's colour already baked into it (see
     scripts/bake-desk-tiles.mjs), and --theme-desk is that tile's average, so the desk is the
     same tone before the tile loads as after. Every band of content keeps the page's own
     surface, so the desk is only ever seen in the side margins and in the gaps between
     bands, never behind text. A phone has only the page gutter to spare, so there the wood
     is a strip down each edge and a band between every two sections, which is all Hugo
     asked it for. The tiles are 1440px square and the desk lays them down at half that,
     which is the side round 2 cut the drawn boards to. */
  --sheet-lift: 0 1px 1px rgb(0 0 0 / 10%), 0 0.5rem 1.25rem rgb(0 0 0 / 14%);

  background: var(--theme-desk-tile) 0 0 / 45rem 45rem var(--theme-desk);

  /* Every band on the desk is a sheet of the same paper, with the small radius and the lift
     the drawing stacks have. Narrow, that is all it is: the band keeps the width, the margins
     and the padding it already had, so no line of text moves to make room for the wood. The
     id is in the selector to outrank the sections' own margins, which the desk takes over
     once it is wide enough to. */
  &#main > *:not(.folio-rail),
  &#main > .full-width > * {
    border-radius: 0.25rem;
    background: var(--surface-page);
    box-shadow: var(--sheet-lift);
  }

  /* A full-width section is the whole viewport, so the paper belongs to the column-width
     children in it, not to it. */
  &#main > .full-width {
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  /* The name's title block is its own piece of paper, so the header it stands in lays none
     down behind it. The edge goes transparent rather than away, so the header keeps the size
     every other band has. */
  &#main > #profile {
    background: none;
    border-color: transparent;
    box-shadow: none;
  }

  /* Wider than the page column plus its margins there is desk to spare on both sides, so the
     sheets take a rim of padding and a hairline edge, their own margins and width caps go,
     and the row gap is the only rhythm left. */
  @media (width > #{column.$desk-from}) {
    /* One gap between every two sheets, and the same strip of desk above the first and below
       the last. */
    --desk-gap: 2.5rem;
    --sheet-pad: #{column.$sheet-pad};
    /* The mat and the folio share the desk margin, so the mat stops at the far side of the
       lane the sheet number stands in whenever that is the wider of the two. */
    --mat-inset: max(clamp(1.5rem, 4vw, 5rem), var(--folio-lane));

    /* On the desk the mat is a thin frame round what lies on it: 0.75rem of ruled mat past
       the boundary, then a 0.75rem rim. The boundary stands 1.75rem off the view where the
       desk is narrow, the least that holds a stack's hint line above or under it
       (Callout.astro), and opens to 3rem after the folio appears. Each side of it takes 0.15
       of every pixel the window gains and the folio lane takes the rest, so neither the mat
       nor the numeral jumps at any width. */
    --mat-rim: 0.75rem;
    --mat-clear: 0.75rem;
    --mat-boundary: clamp(1.75rem, 1.75rem + (100vw - 76rem) * 0.15, 3rem);

    row-gap: var(--desk-gap);
    padding-block: var(--desk-gap);

    &#main > *:not(.folio-rail),
    &#main > .full-width > * {
      width: 100%;
      max-width: none;
      margin-block: 0;
      padding: var(--sheet-pad);
      border: column.$sheet-border solid var(--line);
    }

    /* A full-width section is the whole viewport, so the paper belongs to the column-width
       children in it, not to it. */
    &#main > .full-width {
      row-gap: var(--desk-gap);
      padding: 0;
      border: 0;
    }
  }

  > :not(.full-width, .breakout, .folio-rail) {
    grid-column: content;
    min-width: 0;
  }

  .full-width {
    grid-column: full-width;
    min-width: 0;
  }

  .breakout {
    grid-column: breakout;
    min-width: 0;
  }
}

image, svg, img, picture {
  color-scheme: only light;
}

*, ::before, ::after {
  box-sizing: border-box;
}

/* The islands' boot placeholders (Space Builder, Drag and drop, the font picker) show a spinner
   until their script mounts them. Without script nothing ever will, so the spinner is a
   promise the page cannot keep: say so instead. */
@media (scripting: none) {
  .boot-placeholder > * {
    display: none;
  }

  .boot-placeholder::after {
    content: "This demo needs JavaScript.";
  }
}
</style>

<style is:global>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

.skip-link {
  position: fixed;
  top: 0.5rem;
  left: 0.5rem;
  z-index: 20;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line-strong);
  border-radius: 0.25rem;
  background: var(--surface-raised);
  color: var(--ink);
  font: 0.875rem/1.25 var(--font-poppins);
  translate: 0 -200%;

  &:focus-visible {
    translate: 0 0;
    outline: 2px solid var(--ink);
    outline-offset: 0.125rem;
  }
}

/* The legend's own kbd (.ak-mod) starts as "Alt", the Chrome/Windows/Linux default, and the
   Layout.astro script overwrites it once at load for Firefox (Alt+Shift) or a Mac (Ctrl+Alt),
   so the text is still correct with JS off. CSS-only reveal: shown on the same condition that
   reveals the skip link, so it needs no script to appear at all. */
.accesskey-legend {
  position: fixed;
  top: 3.25rem;
  left: 0.5rem;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line-strong);
  border-radius: 0.25rem;
  background: var(--surface-raised);
  color: var(--ink);
  font: 0.75rem/1.375 var(--font-poppins);
  opacity: 0;
  translate: 0 -0.5rem;
  pointer-events: none;
  transition: opacity 125ms ease-out, translate 125ms ease-out;

  @media (prefers-reduced-motion: reduce) {
    transition: none;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  kbd {
    display: inline-block;
    min-width: 1.25em;
    margin-inline-end: 0.375em;
    padding: 0.0625rem 0.3125rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.1875rem;
    background: var(--surface-sunken);
    font-family: monospace, system-ui;
    font-size: 0.75em;
    text-align: center;
  }
}

.accesskey-legend-mod {
  padding-block-end: 0.25rem;
  border-block-end: 1px solid var(--line);
  color: var(--ink-muted);
}

body:has(.skip-link:focus-visible, .page-turn-key:focus-visible) .accesskey-legend {
  opacity: 1;
  translate: 0 0;
}

.bypass-contrast-check {
  background-image: linear-gradient(transparent, transparent);
}

.inline {
  display: inline;
}

.block {
  display: block;
}

.typewriter {
  font-family: "Special Elite", monospace, system-ui;
  font-weight: 400;
  font-style: normal;
}

.sans-serif {
  font-family: sans-serif;
  font-weight: 400;
  font-style: normal;
}

.poppins {
  font-family: var(--font-poppins);
  font-weight: 400;
  font-style: normal;
}

.monospace {
  font-family: monospace, system-ui;
  font-style: normal;
}

.stencil {
  font-family: var(--font-stencil);
  font-weight: 400;
  font-style: normal;
  text-transform: uppercase;
}

.marker-font {
  font-family: "Permanent Marker", cursive, system-ui;
  font-weight: 400;
  font-style: normal;
}
</style>
