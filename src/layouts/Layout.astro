---
import ThemePicker from '@/components/ThemePicker.astro';
import { AUTHOR_NAME, CONTACT, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '@/site';

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);
const oembedUrl = new URL('/oembed.json', SITE_URL);
oembedUrl.searchParams.set('url', canonical.toString());
oembedUrl.searchParams.set('format', 'json');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR_NAME} />
    <meta property="profile:first_name" content="Hugo" />
    <meta property="profile:last_name" content="Sales" />
    <meta property="profile:username" content={CONTACT.username} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/json+oembed" href={oembedUrl} title={title} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <!-- Digits only: the stencil sets the sheet numbers in the desk margin and nothing else. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Allerta+Stencil&text=0123456789&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Allerta+Stencil&text=0123456789&display=swap" />
    </noscript>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('cv-theme');
          if (stored && ['light', 'dark', 'arctic', 'dark-forest'].includes(stored)) {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* ignore */
        }
      })();
    </script>
    <!-- REVIEW ONLY, strip before this lands on main. Swaps the procedural desk tile for one
         of the photographs in public/desk so Hugo can compare them:
           ?desk=<file>   paints /desk/<file>.webp at the tile's own 45rem
           &veil=<0..1>   how much desk colour lies over the tile, 0 for none
           &theme=<id>    picks the theme, so a link can carry one
           &gloss=<name>  on a dark desk only, polishes it: see GLOSS below
           &floor=&gain=  the two gloss levels by hand, for measuring
           &chroma=<c>    the veil's oklch chroma by hand, the third gloss number
         A light desk takes the photograph under a light veil, the way round 2 left it. A dark
         desk paints it the other way round, subtracting it from a base cut to its own mean, so
         see the note on the painting in the stylesheet below for why. The switch writes inline
         custom properties on the html element, which outrank the theme rules, and nothing else
         in the page knows it is here. -->
    <script is:inline>
      (() => {
        const query = new URLSearchParams(location.search);
        const tile = query.get('desk');
        const theme = query.get('theme');
        const root = document.documentElement;
        if (theme && ['light', 'dark', 'arctic', 'dark-forest'].includes(theme)) {
          root.dataset.theme = theme;
          /* The picker restores its own pick on boot and would undo the query, so tell it. */
          try {
            localStorage.setItem('cv-theme', theme);
          } catch {
            /* ignore */
          }
        }
        /* --theme-desk-grain is how far the veil is faded out, so 1 is no veil at all. The
           drawn boards are one flat tone under a heavy veil that gives them their colour. A
           scan brings its own, so it takes a sixth of that and the levelled copy takes none:
           overlay already leaves the theme's colour alone where that tile sits at mid grey. */
        const VEIL = { 'oak-7760-mid': 0 };
        /* Each tile's own mean colour, measured off the file. A dark desk subtracts a base from
           the tile, and the base is that mean less LEVEL, so every tile lands on the same near
           black however light it was cut and the only thing left to choose between them is the
           grain. LEVEL is the lightness the desk keeps, in 0 to 255, and 28 puts the painted
           desk on the L* 10 the drawn boards already paint there. */
        const MEAN = {
          'ash-4186': [206, 178, 149],
          'oak-7760': [185, 149, 120],
          'oak-7760-down': [185, 149, 120],
          'oak-7760-mid': [156, 125, 101],
          'oak-7760-smoked': [104, 96, 90],
          'oak-7760-ebonised': [54, 47, 43],
          'cc0-oak-light': [220, 185, 149],
          'cc0-oak-grey': [156, 144, 133],
          'cc0-oak-black': [107, 98, 87],
          'cc0-black-flamed': [86, 80, 77],
          'cc0-oak-light-smoked': [101, 96, 89],
          'cc0-oak-light-ebonised': [53, 48, 43],
        };
        const LEVEL = 28;
        /* Each dark theme's desk colour as ThemePicker writes it, split into lightness and hue
           so a polish can move the chroma between them and nothing else. */
        const DESK = {
          dark: [0.235, 55],
          'dark-forest': [0.225, 75],
        };
        /* How far each polish takes a dark desk. floor is the color-burn grey: it clips to
           black every fibre more than 255 - floor below the tile's own mean, so with LEVEL at
           28 a floor of 239 keeps 12 of the 28 levels the desk had. gain is the color-dodge
           grey, multiplying what is left by 255 / (255 - gain), which puts the surviving fibres
           back where they were or higher. peak, where an entry has one, runs the gain up to
           that grey across the width of the desk instead of holding it flat, which lays a broad
           window sheen over the per-fibre one. chroma is the veil's, and it is the only one of
           the three that moves colour: by the time the floor has been through it the shadows
           have no room for any, so the desk's brown lives in the sheen alone and this is the
           knob that takes it out. Floor and gain trade off against each other one for six and a
           half, which holds the sheen where satin has it, so blacker and less brown are two
           knobs and neither one drags the other. */
        const GLOSS = {
          satin: { floor: 239, gain: 112 },
          polished: { floor: 235, gain: 135 },
          lacquer: { floor: 231, gain: 166 },
          window: { floor: 235, gain: 105, peak: 160 },
        };
        const veil = (amount) =>
          root.style.setProperty('--theme-desk-grain', String(1 - Math.min(1, Math.max(0, amount))));
        const grey = (level) => `rgb(${level} ${level} ${level})`;
        const polish = ({ floor, gain, peak, chroma }) => {
          root.style.setProperty('--theme-desk-floor', `linear-gradient(${grey(floor)}, ${grey(floor)})`);
          /* Left to right, because a gradient with no vertical run cannot be cut into steps by
             the sheets lying across it: every strip of bare desk shows the same sweep. */
          root.style.setProperty(
            '--theme-desk-gain',
            peak === undefined
              ? `linear-gradient(${grey(gain)}, ${grey(gain)})`
              : `linear-gradient(to right, ${grey(gain)}, ${grey(peak)})`,
          );
          const desk = DESK[root.dataset.theme];
          if (chroma !== undefined && desk) {
            root.style.setProperty('--theme-desk', `oklch(${desk[0]} ${chroma} ${desk[1]})`);
          }
        };
        if (tile && /^[a-z0-9-]+$/.test(tile)) {
          /* Relative to the document, so this still works under the preview's sub-path. */
          const file = new URL(`desk/${tile}.webp`, document.baseURI).href;
          root.style.setProperty('--theme-desk-tile', `url(${file})`);
          root.style.setProperty('--theme-desk-tile-size', '45rem');
          const dark = root.dataset.theme === 'dark' || root.dataset.theme === 'dark-forest';
          if (dark && MEAN[tile]) {
            const base = MEAN[tile].map((channel) => Math.max(0, channel - LEVEL));
            root.style.setProperty('--theme-desk-base', `rgb(${base.join(' ')})`);
            root.style.setProperty('--theme-desk-blend', 'difference');
            /* The veil is the only thing left holding the desk's colour, so it goes opaque. */
            root.style.setProperty('--theme-desk-veil-blend', 'color');
            veil(1);
            const named = GLOSS[query.get('gloss')];
            const floor = Number(query.get('floor'));
            const gain = Number(query.get('gain'));
            const by = (key) => (query.get(key) === null ? undefined : Number(query.get(key)));
            if (Number.isFinite(floor) && Number.isFinite(gain) && query.get('floor') !== null) {
              polish({ floor, gain, peak: by('peak'), chroma: by('chroma') });
            } else if (named) {
              polish({ ...named, chroma: by('chroma') ?? named.chroma });
            }
          } else {
            veil(tile in VEIL ? VEIL[tile] : 0.15);
          }
        }
        const asked = Number(query.get('veil'));
        if (query.get('veil') !== null && Number.isFinite(asked)) veil(asked);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <ThemePicker />
    <slot />
    <footer class="desktop-hint">
      <p>This page works best when viewed on a desktop.</p>
    </footer>
  </body>
</html>

<style lang="scss" is:global>
/* No list-markers by default, since lists are used more often for semantics */
ul, ol {
  list-style: none;
}

.desktop-hint {
  display: none;
  position: fixed;
  inset: auto 0 0;
  z-index: 9;
  padding: 0.45rem 1rem calc(0.45rem + env(safe-area-inset-bottom, 0px));
  text-align: center;
  font: 0.72rem/1.35 var(--font-poppins);
  color: var(--ink-muted);
  background: color-mix(in oklch, var(--surface-raised), transparent 12%);
  border-top: 1px solid var(--line);
  backdrop-filter: blur(8px);

  @media (max-width: 52rem) {
    display: block;
  }
}

/* Avoid browser default inconsistent heading font-sizes */
h1, h2, h3, h4, h5, h6 {
  font-size: 1rem;
}

/* Remove the inconsistent (among browsers) default ul,ol padding or margin  */
/* the default spacing on headings does not match nor align with normal interline spacing at all, so let's get rid of it. */
/* zero out the spacing around pre, form, body, html, p, blockquote as well */
/* form elements are oddly inconsistent, and not quite CSS emulatable. */
/*  nonetheless strip their margin and padding as well */
ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, body, html, p, blockquote, fieldset, input, textarea, figure {
  margin: 0;
  padding: 0;
  border: none;
}

/* Whoever thought blue linked image borders were a good idea? */
a img,
:link img,
:visited img {
  border: none;
}

address {
  font-style: normal;
}

input {
  font: inherit;
  border-color: currentColor;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  view-transition-name: none;
  --font-poppins: "Poppins", system-ui, sans-serif;
  --font-stencil: "Allerta Stencil", "Impact", "Arial Black", system-ui, sans-serif;
}

body {
  /* The theme picker's face (ThemePicker.astro), so prose, lists, captions
     and controls read as one sheet. system-ui also stops the 13px default
     size browsers give a bare monospace stack. */
  font-family: monospace, system-ui;

  /* The cutting mat the demos lie on. A light theme lifts the canvas toward vellum, a dark one
     mixes it toward the blueprint, and both rule it in the blueprint colour. The ruling stays
     close to the mat it is on, so the sheets keep the eye and the stacks' hints, which are
     written on the mat and not on their sheet, still read against it. */
  --mat-paper: light-dark(
    color-mix(in oklch, var(--theme-canvas), white 24%),
    color-mix(in oklch, var(--theme-canvas), var(--theme-blueprint) 30%)
  );
  --mat-grid-minor: light-dark(
    color-mix(in oklch, var(--theme-blueprint), transparent 93%),
    color-mix(in oklch, var(--theme-blueprint), transparent 80%)
  );
  --mat-grid-major: light-dark(
    color-mix(in oklch, var(--theme-blueprint), transparent 86%),
    color-mix(in oklch, var(--theme-blueprint), transparent 60%)
  );
  --mat-edge: light-dark(
    color-mix(in oklch, var(--ink-muted), transparent 40%),
    color-mix(in oklch, white, var(--theme-blueprint) 35%)
  );
}

main {
  --page-gap: clamp(1rem, 4vw, 2.5rem);
  /* em, not ch: the cap is a page width, and ch pins it to whatever font this
     element inherits. 60em is 960px, which also keeps the demo sheets above the
     56em mark where TechnicalDrawing/Page.astro tucks the note behind the fold. */
  --content-max: 60em;
  /* The demo stacks sit in the breakout column, so this is what caps them. */
  --breakout-max: var(--content-max);

  /* The sheet number in the desk's left margin (Folio.astro). The lane it stands in is what
     the desk can spare once the cutting mat has the width it needs to lay a full drawing
     down with 3rem of mat clear on either side of it, and it never grows past what a 7.5rem
     numeral asks for: the numeral's own width, about 1.15 of its size for two stencil
     digits, and 1.5rem of desk left clear between it and whatever lies beside it. The
     numeral is then sized from the lane, so it fits the margin at every width. Below 80rem
     the desk can spare nothing and there is no folio, so no measurement moves for one. */
  --folio-gap: 1.5rem;
  --folio-lane: 0px;
  --type-folio: calc((var(--folio-lane) - var(--folio-gap)) / 1.15);

  @media (width >= 80rem) {
    --folio-lane: min(
      (100vw - var(--breakout-max) - 10rem) / 2,
      calc(7.5rem * 1.15 + var(--folio-gap))
    );
  }

  /* The cutting mat's width rule belongs to the desk and not to the mat, because the folio
     stands in the margin the mat leaves and has to know where it ends (index.astro reads
     both). --desk-edge is where the paper starts: the near edge of the widest thing the desk
     lays down, which is always the mat. Past the mat's cap the desk keeps widening and the
     mat does not, so the margin opens faster than the lane and the folio hangs off this
     rather than off the window. */
  --mat-inset: 0px;
  --mat-max: 100rem;
  --desk-edge: max((100vw - var(--mat-max)) / 2, var(--mat-inset));

  --full-width: minmax(var(--page-gap), 1fr);
  --breakout: minmax(0, calc((var(--breakout-max) - var(--content-max)) / 2));
  --content: min(100% - var(--page-gap) * 2, var(--content-max));

  position: relative;
  display: grid;
  grid-template-columns:
    [full-width-start] var(--full-width)
    [breakout-start] var(--breakout)
    [content-start] var(--content) [content-end]
    var(--breakout) [breakout-end]
    var(--full-width) [full-width-end];
  /* Four rows, one per sheet, written out rather than left implicit: a folio is placed in
     the row of the sheet it numbers, and an absolutely positioned grid child can only name a
     line of the explicit grid. */
  grid-template-rows: repeat(4, auto);
  align-content: start;
  padding-bottom: 1.5rem;

  @media (max-width: 52rem) {
    --page-gap: clamp(0.75rem, 3.5vw, 1.25rem);
    padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
  }

  /* The page lies on a desk at every width. The desk is boards: --theme-desk-tile is one
     stitched tile of them, a whole number of boards wide, built per theme by src/deskTile.ts.
     --theme-desk-grain veils it down to a tone that stays out of the way. Every band of
     content keeps the page's own surface, so the desk is only ever seen in the side margins
     and in the gaps between bands, never behind text. A phone has only the page gutter to
     spare, so there the wood is a strip down each edge and a band between every two sections,
     which is all Hugo asked it for. */
  --desk-veil: color-mix(in oklch, var(--theme-desk), transparent calc(var(--theme-desk-grain) * 100%));
  --sheet-lift: 0 1px 1px rgb(0 0 0 / 10%), 0 0.5rem 1.25rem rgb(0 0 0 / 14%);

  /* How the tile meets the desk colour is a per-theme choice, because no one blend carries
     grain the whole way down the lightness scale. Overlay scales every step the tile has by
     base * (1 - base), which is at its strongest on a mid tone and collapses to nothing as the
     base nears black or white: on a near black desk it leaves the tone and eats the fibre. A
     theme whose desk is that dark sets --theme-desk-base to a colour a little above the tile's
     own mean, --theme-desk-blend to difference so the tile is subtracted from it rather than
     scaled by it, which keeps each step at its full size however dark the result lands, and
     --theme-desk-veil-blend to color so the opaque veil hands the desk its hue and chroma back
     while the subtraction keeps the lightness. */
  /* Between the tile and the veil sit two layers that turn dark wood into a polished surface.
     --theme-desk-floor is a flat grey under color-burn, which clips to black everything below
     255 less its own level; --theme-desk-gain is a flat grey under color-dodge, which is a
     plain multiply by 255 / (255 less its own level). Clip, then open up: the range widens
     downwards rather than sliding, so the body of the desk goes black while the bright fibres
     hold the lightness they had, and that is what reads as sheen. Unset, both are `none`, a
     transparent layer that composites away to nothing, so every other desk paints as it did. */
  background-color: var(--theme-desk-base, var(--theme-desk));
  background-image:
    linear-gradient(var(--desk-veil), var(--desk-veil)),
    var(--theme-desk-gain, none),
    var(--theme-desk-floor, none),
    var(--theme-desk-tile);
  background-size: auto, auto, auto, var(--theme-desk-tile-size) var(--theme-desk-tile-size);
  background-blend-mode:
    var(--theme-desk-veil-blend, normal),
    color-dodge,
    color-burn,
    var(--theme-desk-blend, overlay);

  /* Every band on the desk is a sheet of the same paper, with the small radius and the lift
     the drawing stacks have. Narrow, that is all it is: the band keeps the width, the margins
     and the padding it already had, so no line of text moves to make room for the wood. The
     id is in the selector to outrank the sections' own margins, which the desk takes over
     once it is wide enough to. */
  &#main > *:not(.folio-rail),
  &#main > .full-width > * {
    border-radius: 0.25rem;
    background: var(--surface-page);
    box-shadow: var(--sheet-lift);
  }

  /* A full-width section is the whole viewport, so the paper belongs to the column-width
     children in it, not to it. */
  &#main > .full-width {
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  /* Wider than the page column plus its margins there is desk to spare on both sides, so the
     sheets take a rim of padding and a hairline edge, their own margins and width caps go,
     and the row gap is the only rhythm left. */
  @media (width > 64rem) {
    /* One gap between every two sheets, and the same strip of desk above the first and below
       the last. */
    --desk-gap: 2.5rem;
    --sheet-pad: 1.5rem;
    /* The mat and the folio share the desk margin, so the mat stops at the far side of the
       lane the sheet number stands in whenever that is the wider of the two. */
    --mat-inset: max(clamp(1.5rem, 4vw, 5rem), var(--folio-lane));

    row-gap: var(--desk-gap);
    padding-block: var(--desk-gap);

    &#main > *:not(.folio-rail),
    &#main > .full-width > * {
      width: 100%;
      max-width: none;
      margin-block: 0;
      padding: var(--sheet-pad);
      border: 1px solid var(--line);
    }

    &#main > .full-width {
      row-gap: var(--desk-gap);
      padding: 0;
      border: 0;
    }
  }

  > :not(.full-width, .breakout, .folio-rail) {
    grid-column: content;
    min-width: 0;
  }

  .full-width {
    grid-column: full-width;
    min-width: 0;
  }

  .breakout {
    grid-column: breakout;
    min-width: 0;
  }
}

image, svg, img, picture {
  color-scheme: only light;
}

*, ::before, ::after {
  box-sizing: border-box;
}
</style>

<style is:global>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

.skip-link {
  position: fixed;
  top: 0.5rem;
  left: 0.5rem;
  z-index: 20;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line-strong);
  border-radius: 0.25rem;
  background: var(--surface-raised);
  color: var(--ink);
  font: 0.875rem/1.25 var(--font-poppins);
  translate: 0 -200%;

  &:focus-visible {
    translate: 0 0;
    outline: 2px solid var(--ink);
    outline-offset: 0.125rem;
  }
}

.bypass-contrast-check {
  background-image: linear-gradient(transparent, transparent);
}

.inline {
  display: inline;
}

.block {
  display: block;
}

.typewriter {
  font-family: "Special Elite", monospace, system-ui;
  font-weight: 400;
  font-style: normal;
}

.sans-serif {
  font-family: sans-serif;
  font-weight: 400;
  font-style: normal;
}

.poppins {
  font-family: var(--font-poppins);
  font-weight: 400;
  font-style: normal;
}

.monospace {
  font-family: monospace, system-ui;
  font-style: normal;
}

.stencil {
  font-family: var(--font-stencil);
  font-weight: 400;
  font-style: normal;
  text-transform: uppercase;
}

.marker-font {
  font-family: "Permanent Marker", cursive, system-ui;
  font-weight: 400;
  font-style: normal;
}
</style>
