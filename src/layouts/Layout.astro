---
import ThemePicker from '@/components/ThemePicker.astro';
import { AUTHOR_NAME, CONTACT, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '@/site';

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL);

/* Zone references along the frame, as on an ISO 5457 sheet: numbers across, letters down.
   I and O are skipped there so they cannot be read as 1 and 0. More than a sheet ever needs;
   the bands clip what does not fit. */
const ZONE_LETTERS = 'ABCDEFGHJKLMNPRSTUVWXYZ'.split('');
const ZONE_ROWS = [...ZONE_LETTERS, ...ZONE_LETTERS.map((letter) => `A${letter}`)];
const ZONE_COLUMNS = Array.from({ length: 24 }, (_, index) => index + 1);
const oembedUrl = new URL('/oembed.json', SITE_URL);
oembedUrl.searchParams.set('url', canonical.toString());
oembedUrl.searchParams.set('format', 'json');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR_NAME} />
    <meta property="profile:first_name" content="Hugo" />
    <meta property="profile:last_name" content="Sales" />
    <meta property="profile:username" content={CONTACT.username} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/json+oembed" href={oembedUrl} title={title} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Poppins:wght@400;500;600;700&family=Special+Elite&display=swap"
      />
    </noscript>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('cv-theme');
          if (stored && ['light', 'dark', 'arctic', 'dark-forest'].includes(stored)) {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <ThemePicker />
    <div class="sheet">
      <ol class="zone zone-top" aria-hidden="true">{ZONE_COLUMNS.map((n) => <li>{n}</li>)}</ol>
      <ol class="zone zone-left" aria-hidden="true">{ZONE_ROWS.map((l) => <li>{l}</li>)}</ol>
      <slot />
      <ol class="zone zone-right" aria-hidden="true">{ZONE_ROWS.map((l) => <li>{l}</li>)}</ol>
      <ol class="zone zone-bottom" aria-hidden="true">{ZONE_COLUMNS.map((n) => <li>{n}</li>)}</ol>
    </div>
    <footer class="desktop-hint">
      <p>This page works best when viewed on a desktop.</p>
    </footer>
  </body>
</html>

<style lang="scss" is:global>
/* No list-markers by default, since lists are used more often for semantics */
ul, ol {
  list-style: none;
}

.desktop-hint {
  display: none;
  position: fixed;
  inset: auto 0 0;
  z-index: 9;
  padding: 0.45rem 1rem calc(0.45rem + env(safe-area-inset-bottom, 0px));
  text-align: center;
  font: 0.72rem/1.35 var(--font-poppins);
  color: var(--ink-muted);
  background: color-mix(in oklch, var(--surface-raised), transparent 12%);
  border-top: 1px solid var(--line);
  backdrop-filter: blur(8px);

  @media (max-width: 52rem) {
    display: block;
  }
}

/* Avoid browser default inconsistent heading font-sizes */
h1, h2, h3, h4, h5, h6 {
  font-size: 1rem;
}

/* Remove the inconsistent (among browsers) default ul,ol padding or margin  */
/* the default spacing on headings does not match nor align with normal interline spacing at all, so let's get rid of it. */
/* zero out the spacing around pre, form, body, html, p, blockquote as well */
/* form elements are oddly inconsistent, and not quite CSS emulatable. */
/*  nonetheless strip their margin and padding as well */
ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, body, html, p, blockquote, fieldset, input, textarea, figure {
  margin: 0;
  padding: 0;
  border: none;
}

/* Whoever thought blue linked image borders were a good idea? */
a img,
:link img,
:visited img {
  border: none;
}

address {
  font-style: normal;
}

input {
  font: inherit;
  border-color: currentColor;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  view-transition-name: none;
  --font-poppins: "Poppins", system-ui, sans-serif;
}

/* The page is one drawing sheet: the desk shows around a trimmed sheet, the zone bands run
   along its four edges, and the frame line closes around main, which is the drawing area. */
body {
  --sheet-desk: light-dark(
    color-mix(in oklch, var(--theme-canvas), var(--theme-ink) 16%),
    color-mix(in oklch, var(--theme-canvas), black 28%)
  );
  --sheet-margin: light-dark(
    color-mix(in oklch, var(--theme-canvas), var(--theme-ink) 5%),
    color-mix(in oklch, var(--theme-canvas), var(--theme-blueprint) 14%)
  );
  --sheet-paper: light-dark(
    color-mix(in oklch, var(--theme-canvas), white 24%),
    color-mix(in oklch, var(--theme-canvas), var(--theme-blueprint) 30%)
  );
  --sheet-grid-minor: light-dark(
    color-mix(in oklch, var(--theme-blueprint), transparent 88%),
    color-mix(in oklch, white, transparent 95%)
  );
  --sheet-grid-major: light-dark(
    color-mix(in oklch, var(--theme-blueprint), transparent 72%),
    color-mix(in oklch, white, transparent 88%)
  );
  --sheet-frame: light-dark(var(--ink-muted), color-mix(in oklch, white, var(--theme-blueprint) 35%));
  --sheet-lettering: light-dark(var(--ink-faint), color-mix(in oklch, white, var(--theme-blueprint) 55%));

  /* Zone band and the desk showing past the trimmed edge. */
  --sheet-band: 1.25rem;
  --sheet-trim: 1rem;
  --zone-x: 10rem;
  --zone-y: 12.5rem;

  background: var(--sheet-desk);

  @media (max-width: 52rem) {
    --sheet-band: 0.875rem;
    --sheet-trim: 0.375rem;
    --zone-x: 5rem;
    --zone-y: 20rem;
  }
}

.sheet {
  display: grid;
  grid-template-columns: var(--sheet-band) minmax(0, 1fr) var(--sheet-band);
  grid-template-rows: var(--sheet-band) minmax(0, 1fr) var(--sheet-band);
  margin: var(--sheet-trim);
  background: var(--sheet-margin);
  box-shadow: 0 0 0 1px color-mix(in oklch, var(--sheet-frame), transparent 55%);

  > main {
    grid-area: 2 / 2;
    border: 2px solid var(--sheet-frame);
  }

  .zone {
    display: grid;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    font: 0.5625rem/1 monospace, system-ui;
    letter-spacing: 0.06em;
    color: var(--sheet-lettering);
    position: relative;

    li {
      display: grid;
      place-items: center;
    }
  }

  .zone-top,
  .zone-bottom {
    grid-column: 2;
    grid-auto-flow: column;
    grid-auto-columns: var(--zone-x);

    li + li {
      border-inline-start: 1px solid var(--sheet-frame);
    }

    /* Centring mark, half way along the edge. */
    &::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      border-left: 2px solid var(--sheet-frame);
    }
  }

  .zone-top {
    grid-row: 1;
  }

  .zone-bottom {
    grid-row: 3;
  }

  .zone-left,
  .zone-right {
    grid-row: 2;
    grid-auto-rows: var(--zone-y);

    li + li {
      border-block-start: 1px solid var(--sheet-frame);
    }
  }

  .zone-left {
    grid-column: 1;
  }

  .zone-right {
    grid-column: 3;
  }
}

main {
  --page-gap: clamp(1rem, 4vw, 2.5rem);
  /* em, not ch: the cap is a page width, and ch pins it to whatever font this
     element inherits. 60em is 960px, which also keeps the demo sheets above the
     56em mark where TechnicalDrawing/Page.astro tucks the note behind the fold. */
  --content-max: 60em;
  /* The demo stacks sit in the breakout column, so this is what caps them. */
  --breakout-max: var(--content-max);

  --full-width: minmax(var(--page-gap), 1fr);
  --breakout: minmax(0, calc((var(--breakout-max) - var(--content-max)) / 2));
  --content: min(100% - var(--page-gap) * 2, var(--content-max));

  position: relative;
  display: grid;
  grid-template-columns:
    [full-width-start] var(--full-width)
    [breakout-start] var(--breakout)
    [content-start] var(--content) [content-end]
    var(--breakout) [breakout-end]
    var(--full-width) [full-width-end];
  grid-template-rows: auto;
  align-content: start;
  padding-bottom: 1.5rem;

  @media (max-width: 52rem) {
    --page-gap: clamp(0.75rem, 3.5vw, 1.25rem);
    padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
  }

  /* Drafting grid: a minor line every half rem-cell, a major one every fifth. */
  background-color: var(--sheet-paper);
  background-image:
    linear-gradient(to right, var(--sheet-grid-major) 1px, transparent 1px),
    linear-gradient(to bottom, var(--sheet-grid-major) 1px, transparent 1px),
    linear-gradient(to right, var(--sheet-grid-minor) 1px, transparent 1px),
    linear-gradient(to bottom, var(--sheet-grid-minor) 1px, transparent 1px);
  background-size: 2.5rem 2.5rem, 2.5rem 2.5rem, 0.5rem 0.5rem, 0.5rem 0.5rem;
  background-attachment: local;

  > :not(.full-width, .breakout) {
    grid-column: content;
    min-width: 0;
  }

  .full-width {
    grid-column: full-width;
    min-width: 0;
  }

  .breakout {
    grid-column: breakout;
    min-width: 0;
  }
}

image, svg, img, picture {
  color-scheme: only light;
}

*, ::before, ::after {
  box-sizing: border-box;
}
</style>

<style is:global>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

.skip-link {
  position: fixed;
  top: 0.5rem;
  left: 0.5rem;
  z-index: 20;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line-strong);
  border-radius: 0.25rem;
  background: var(--surface-raised);
  color: var(--ink);
  font: 0.875rem/1.25 var(--font-poppins);
  translate: 0 -200%;

  &:focus-visible {
    translate: 0 0;
    outline: 2px solid var(--ink);
    outline-offset: 0.125rem;
  }
}

.bypass-contrast-check {
  background-image: linear-gradient(transparent, transparent);
}

.inline {
  display: inline;
}

.block {
  display: block;
}

.typewriter {
  font-family: "Special Elite", monospace, system-ui;
  font-weight: 400;
  font-style: normal;
}

.sans-serif {
  font-family: sans-serif;
  font-weight: 400;
  font-style: normal;
}

.poppins {
  font-family: var(--font-poppins);
  font-weight: 400;
  font-style: normal;
}

.monospace {
  font-family: monospace, system-ui;
  font-style: normal;
}

.marker-font {
  font-family: "Permanent Marker", cursive, system-ui;
  font-weight: 400;
  font-style: normal;
}
</style>
