---
/**
 * REVIEW ONLY, strip before this lands on main, along with the ?desk switch in Layout.astro.
 *
 * One question: whether the light desk keeps the ash boards or comes off the same oak scan as
 * the other three. Links first, nothing above them. The wider list of every wood we ever cut is
 * on the desk-review-switch branch, which is where round 8 parked it.
 */

type Candidate = {
  file: string;
  name: string;
  say: string;
  L: string;
  C: string;
  h: string;
  grain: string;
};

/* L*, C* and hue are the tile file's own mean, which is what a light desk shows through a veil
   of a sixth. grain is the file's L* standard deviation: how hard the figure reads. */
const LIGHT: readonly Candidate[] = [
  {
    file: '',
    name: 'Ash boards, your pick',
    say: 'Sawn boards with the plank joints left in. A different scan from the other three.',
    L: '74.4',
    C: '19.7',
    h: '73',
    grain: '2.75',
  },
  {
    file: 'oak-7760',
    name: 'The oak, untouched',
    say: 'Arctic’s tile as it stands. Long cathedral figure, no joint in it, and ten points of L* darker than the ash.',
    L: '64.2',
    C: '22.2',
    h: '65',
    grain: '2.56',
  },
  {
    file: 'oak-7760-pale',
    name: 'The oak, lifted',
    say: 'The same file raised to the ash’s lightness and nothing else, so it keeps the oak’s own red.',
    L: '74.4',
    C: '22.3',
    h: '65',
    grain: '2.56',
  },
  {
    file: 'oak-7760-limed',
    name: 'The oak, limed',
    say: 'Raised, drawn back to the ash’s chroma and turned 8° towards its yellow. All four numbers land within a tenth of the ash.',
    L: '74.5',
    C: '19.7',
    h: '73',
    grain: '2.76',
  },
];

/* The other three, so the set can be flipped through in one sitting. None of them moves. */
const REST = [
  { theme: 'arctic', name: 'Arctic', say: 'The oak at its own lightness, which under a pale desk reads as bleached.' },
  { theme: 'dark', name: 'Dark', say: 'The levelled oak, no polish on it, the sheen at chroma 0.010.' },
  { theme: 'dark-forest', name: 'Forest', say: 'The same oak smoked in the file, under the theme’s own green.' },
] as const;

const lightUrl = (file: string) => (file ? `../?desk=${file}&theme=light` : '../?theme=light');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>The light desk, ash or oak</title>
    <style is:inline>
      :root {
        color-scheme: light dark;
        --ink: #1b1a17;
        --paper: #f6f3ee;
        --faint: #6b6560;
        --rule: #d8d1c7;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #ece7df;
          --paper: #171614;
          --faint: #9a938a;
          --rule: #35322d;
        }
      }

      body {
        margin: 0 auto;
        padding: 2rem 1rem 6rem;
        max-width: 54rem;
        background: var(--paper);
        color: var(--ink);
        font: 1rem/1.5 system-ui, sans-serif;
      }

      h1 {
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
      }

      h2 {
        font-size: 1.125rem;
        margin: 2.25rem 0 0.25rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--rule);
      }

      p {
        margin: 0.25rem 0 0.5rem;
        color: var(--faint);
      }

      ul {
        margin: 0.5rem 0 0;
        padding: 0;
        list-style: none;
      }

      li {
        margin-bottom: 0.4rem;
      }

      li a {
        font-weight: 600;
      }

      .say {
        color: var(--faint);
      }

      .scroll {
        overflow-x: auto;
      }

      table {
        width: 100%;
        margin: 0.75rem 0 0;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 0.4rem 0.75rem 0.4rem 0;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--rule);
      }

      th {
        font-weight: 600;
      }

      td.num,
      th.num {
        text-align: right;
        padding-right: 1rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      code {
        font-family: ui-monospace, monospace;
        font-size: 0.875em;
      }
    </style>
  </head>
  <body>
    <h1>The light desk, ash or oak</h1>
    <p>
      Arctic, dark and forest are all cut from one oak scan. Light is sawn ash, which is the odd
      one out. These four links are the light desk as you picked it and the same desk cut from
      the oak instead, treated to land on the ash’s tone.
    </p>

    <h2>Light</h2>
    <ul>
      {LIGHT.map((wood) => (
        <li>
          <a href={lightUrl(wood.file)}>{wood.name}</a> <span class="say">{wood.say}</span>
        </li>
      ))}
    </ul>

    <h2>The other three, unchanged</h2>
    <ul>
      {REST.map((pick) => (
        <li>
          <a href={`../?theme=${pick.theme}`}>{pick.name}</a> <span class="say">{pick.say}</span>
        </li>
      ))}
    </ul>

    <h2>What the four files measure</h2>
    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th>tile</th>
            <th class="num">L*</th>
            <th class="num">C*</th>
            <th class="num">hue</th>
            <th class="num">grain</th>
          </tr>
        </thead>
        <tbody>
          {LIGHT.map((wood) => (
            <tr>
              <td>
                <code>{wood.file || 'ash-4186'}</code>
              </td>
              <td class="num">{wood.L}</td>
              <td class="num">{wood.C}</td>
              <td class="num">{wood.h}</td>
              <td class="num">{wood.grain}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Both oak variants are made from the 2K scan the site already ships, moved in Lab: lightness
      is an affine ramp, chroma a scale on a and b, hue a rotation of the same pair. The limed one
      also stretches the grain by 7 per cent, which is what puts its standard deviation on the
      ash’s.
    </p>
  </body>
</html>
