---
/**
 * REVIEW ONLY, strip before this lands on main, along with the ?desk switch in Layout.astro.
 *
 * Every wood tile cut so far and the links that put each one on the desk. The page
 * deliberately skips Layout: it has no desk of its own, so the strips show the tile as the
 * file has it, before the theme's desk colour and grain veil get at it.
 */

type Tile = {
  file: string;
  name: string;
  weight: string;
  L: string;
  C: string;
  step: string;
  ratio: string;
  source: string;
  href: string;
  licence: string;
  note: string;
};

/* Poliigon's two free scans, cut in round 2. Light and arctic are settled on the ash. */
const POLIIGON: readonly Tile[] = [
  {
    file: 'ash-4186',
    name: 'Ash Wood Board, Light Beige',
    weight: '125 KB',
    L: '74.4',
    C: '19.7',
    step: '5.35',
    ratio: '0.709',
    source: 'Poliigon 4186',
    href: 'https://www.poliigon.com/texture/ash-wood-board-texture-light-beige/4186',
    licence: 'Poliigon Free',
    note: 'Your pick for light and for arctic. Boards rather than veneer, scanned with the grain already across, and the plank joints come with it.',
  },
  {
    file: 'oak-7760',
    name: 'Slip Match Oak Wood Veneer',
    weight: '184 KB',
    L: '64.2',
    C: '22.2',
    step: '5.39',
    ratio: '0.788',
    source: 'Poliigon 7760',
    href: 'https://www.poliigon.com/texture/slip-match-oak-wood-veneer-texture/7760',
    licence: 'Poliigon Free',
    note: 'The veneer turned a quarter so the grain runs across the page. Long unbroken figure, no joints anywhere. Half the treatments below start here.',
  },
  {
    file: 'oak-7760-mid',
    name: 'Slip Match Oak, levelled',
    weight: '152 KB',
    L: '54.8',
    C: '19.7',
    step: '4.46',
    ratio: '0.775',
    source: 'Poliigon 7760',
    href: 'https://www.poliigon.com/texture/slip-match-oak-wood-veneer-texture/7760',
    licence: 'Poliigon Free',
    note: 'Your near miss on forest: the same tile with its mean lifted to mid grey, so the overlay blend leaves the theme colour alone. Chroma 19.7 is the red you want out.',
  },
  {
    file: 'oak-7760-down',
    name: 'Slip Match Oak, as scanned',
    weight: '172 KB',
    L: '64.2',
    C: '22.2',
    step: '1.21',
    ratio: '0.176',
    source: 'Poliigon 7760',
    href: 'https://www.poliigon.com/texture/slip-match-oak-wood-veneer-texture/7760',
    licence: 'Poliigon Free',
    note: 'The veneer left the way it was captured, grain down the desk. Its figure lies along the measured direction rather than across it, which is why the step reads low here.',
  },
];

/* Poly Haven scans. Everything there is CC0, so these carry no conditions at all. */
const CC0: readonly Tile[] = [
  {
    file: 'cc0-oak-light',
    name: 'Oak Veneer 02',
    weight: '182 KB',
    L: '77.3',
    C: '24.1',
    step: '7.89',
    ratio: '1.222',
    source: 'Poly Haven',
    href: 'https://polyhaven.com/a/oak_veneer_02',
    licence: 'CC0',
    note: 'The crispest grain of anything measured, half again as sharp as the Poliigon oak. Far too warm to use pale, but it is the base the other two treated cuts come from.',
  },
  {
    file: 'cc0-oak-grey',
    name: 'Grey Oak Veneer 02',
    weight: '191 KB',
    L: '60.4',
    C: '8.0',
    step: '6.96',
    ratio: '0.691',
    source: 'Poly Haven',
