---
/**
 * REVIEW ONLY, strip before this lands on main, along with the ?desk switch in Layout.astro.
 *
 * Four wood tiles cut from the two Poliigon scans a free account can download, and the links
 * that put each one on the desk. The page deliberately skips Layout: it has no desk of its
 * own, so the strips show the tile as the file has it, before the theme's desk colour and
 * grain veil get at it.
 */

const TILES = [
  {
    file: 'oak-7760',
    name: 'Slip Match Oak Wood Veneer',
    asset: 7760,
    href: 'https://www.poliigon.com/texture/slip-match-oak-wood-veneer-texture/7760',
    note: 'The veneer you picked, turned a quarter so the grain runs across the page. Long unbroken figure, no joints anywhere.',
  },
  {
    file: 'oak-7760-mid',
    name: 'Slip Match Oak Wood Veneer, levelled',
    asset: 7760,
    href: 'https://www.poliigon.com/texture/slip-match-oak-wood-veneer-texture/7760',
    note: 'The same tile with its mean lifted to mid grey. The desk paints the tile with an overlay blend, and overlay leaves the backdrop alone at mid grey, so this one lends its grain and takes the theme’s colour. It is the one to try on dark and forest.',
  },
  {
    file: 'ash-4186',
    name: 'Ash Wood Board, Light Beige',
    asset: 4186,
    href: 'https://www.poliigon.com/texture/ash-wood-board-texture-light-beige/4186',
    note: 'Boards rather than veneer, scanned with the grain already across, and the plank joints come with it. The palest of the four.',
  },
  {
    file: 'oak-7760-down',
    name: 'Slip Match Oak Wood Veneer, as scanned',
    asset: 7760,
    href: 'https://www.poliigon.com/texture/slip-match-oak-wood-veneer-texture/7760',
    note: 'The veneer left the way it was captured, grain down the desk. Here to set against the boards that ship today, since down is the direction they run.',
  },
] as const;

const THEMES = [
  { id: 'light', label: 'Light', try: ['oak-7760', 'ash-4186', 'oak-7760-down'] },
  { id: 'arctic', label: 'Arctic', try: ['ash-4186', 'oak-7760-mid', 'oak-7760'] },
  { id: 'dark', label: 'Dark', try: ['oak-7760-mid', 'oak-7760', 'ash-4186'] },
  { id: 'dark-forest', label: 'Dark forest', try: ['oak-7760-mid', 'oak-7760-down', 'ash-4186'] },
] as const;

const tileByFile = Object.fromEntries(TILES.map((tile) => [tile.file, tile]));
const deskUrl = (file: string, theme: string, veil: boolean) =>
  `/?desk=${file}&theme=${theme}${veil ? '' : '&veil=0'}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Desk wood, candidates</title>
    <style is:inline>
      :root {
        color-scheme: light dark;
        --ink: #1b1a17;
        --paper: #f6f3ee;
        --faint: #6b6560;
        --rule: #d8d1c7;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #ece7df;
          --paper: #171614;
          --faint: #9a938a;
          --rule: #35322d;
        }
      }

      body {
        margin: 0 auto;
        padding: 2rem 1rem 6rem;
        max-width: 50rem;
        background: var(--paper);
        color: var(--ink);
        font: 1rem/1.6 system-ui, sans-serif;
      }

      h1 {
        font-size: 1.5rem;
        margin-bottom: 0.25rem;
      }

      h2 {
        font-size: 1.125rem;
        margin: 2.5rem 0 0.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
      }

      h3 {
        font-size: 1rem;
        margin: 1.75rem 0 0.25rem;
      }

      p {
        margin: 0.25rem 0 0.75rem;
      }

      .lede,
      .note {
        color: var(--faint);
      }

      .strip {
        height: 11rem;
        border: 1px solid var(--rule);
        border-radius: 0.25rem;
        background-repeat: repeat;
        background-size: 45rem 45rem;
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        margin: 0.5rem 0 0;
        padding: 0;
        list-style: none;
      }

      .links li {
        white-space: nowrap;
      }

      code {
        font-family: ui-monospace, monospace;
        font-size: 0.875em;
      }
    </style>
  </head>
  <body>
    <h1>Desk wood, candidates</h1>
    <p class="lede">
      Four tiles cut from two Poliigon scans. Each link opens the CV with that tile on the desk
      and the theme already picked. The desk only shows above 64rem wide, so give the window
      some room. A second link on each line drops the grain veil, which is the layer most
      likely to be softening the figure.
    </p>
    <p class="lede">
      Only two scans were free on the account, so every tile below comes from one of those two.
      The veneers picked out for dark, arctic and forest sit behind a paid plan and were left
      alone. Until one is chosen, the procedural boards stay the default.
    </p>

    <h2>The tiles</h2>
    <p class="lede">
      Shown at the size the desk paints them, 45rem across, and on their own, so this is the
      file before the theme&rsquo;s desk colour and veil reach it.
    </p>
    {TILES.map((tile) => (
      <>
        <h3>{tile.name}</h3>
        <p class="note">
          {tile.note} <a href={tile.href}>Poliigon {tile.asset}</a>, <code>{tile.file}.webp</code>
        </p>
        <div class="strip" style={`background-image: url(/desk/${tile.file}.webp)`} />
      </>
    ))}

    <h2>On the desk</h2>
    {THEMES.map((theme) => (
      <>
        <h3>{theme.label}</h3>
        <ul class="links">
          {theme.try.map((file) => (
            <li>
              <a href={deskUrl(file, theme.id, true)}>{tileByFile[file].name}</a>{' '}
              <a href={deskUrl(file, theme.id, false)}>(no veil)</a>
            </li>
          ))}
        </ul>
      </>
    ))}

    <h2>If none of them work</h2>
    <p>
      The paid veneers are still the better answer for the dark themes: nothing in a free oak
      scan is anywhere near charred. A month of Poliigon buys the whole shortlist. Their licence
      allows commercial use but forbids redistributing the assets, and a site background does
      serve the image file, so that wants a read before any of this lands.
    </p>
  </body>
</html>
