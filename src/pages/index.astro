---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import TagCloud from '@/components/TagCloud.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';
---

<Layout>
  <main>
    <Name />
    <TagCloud />

    <section id="demos">
      <VisrezLogoAnimation />
    </section>

    <OpenSourceContributions />
  </main>
</Layout>

<style>
#demos {
  margin-top: 8rem;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4em;
}
</style>
