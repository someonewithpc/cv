---
import Layout from '../layouts/Layout.astro';

import Name from '../components/Name.astro';
import TagCloud from '../components/TagCloud.astro';

import TechnicalDrawing from '../components/TechnicalDrawing.astro';

import MarkerEditorPreview from '../components/MarkerEditor/Preview.astro';
---

<Layout>
    <main>
      <Name />
      <TagCloud />

      <section id="demos">

        <TechnicalDrawing />

        <MarkerEditorPreview />
      </section>
    </main>
</Layout>

<style>
#demos {
  margin-top: 8rem;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4em;
}
</style>
