---
import Layout from '../layouts/Layout.astro';

import Name from '../components/Name.astro';
import TagCloud from '../components/TagCloud.astro';

import TechnicalDrawing from '../components/TechnicalDrawing.astro';

import VisrezLogoAnimation from '../components/VisrezLogoAnimation/Demo.astro';
import VisrezLogoAnimationRaw from '../components/VisrezLogoAnimation/Result.astro?raw';
import MarkerEditorPreview from '../components/MarkerEditor/Preview.astro';

function toKiB(text: string) {
  return Math.ceil(text.length / 1024 * 10) / 10 + 'KiB';
}

const visrezLogoAnimationSize = toKiB(VisrezLogoAnimationRaw);
---

<Layout>
    <main>
      <Name />
      <TagCloud />

      <section id="demos">

        <TechnicalDrawing
          title="Visrez Animated Loading Logo"
          scale="3:1"
          size={visrezLogoAnimationSize}
          date="2023"
        />

        <MarkerEditorPreview />
      </section>
    </main>
</Layout>

<style>
#demos {
  margin-top: 8rem;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4em;
}
</style>
