---
import Layout from '@/layouts/Layout.astro';

import Folio from '@/components/Folio.astro';
import Name from '@/components/Name.astro';
import Career from '@/components/Career/Career.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Callout from '@/components/Callout.astro';
import TitleCard from '@/components/TitleCard.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';
import VariantsDemo from '@/components/VariantsDemo/Demo.astro';
import TaggingToolDemo from '@/components/TaggingToolDemo/Demo.astro';
import SyntheticPropertiesDemo from '@/components/SyntheticPropertiesDemo/Demo.astro';
import FontPickerDemo from '@/components/FontPickerDemo/Demo.astro';
import DragDropDemo from '@/components/DragDropDemo/Demo.astro';
import SchemaDefDemo from '@/components/SchemaDefDemo/Demo.astro';
import EventBusDemo from '@/components/EventBusDemo/Demo.astro';
import FediversePlaygroundDemo from '@/components/FediversePlaygroundDemo/Demo.astro';
import LibrarySearchDemo from '@/components/LibrarySearchDemo/Demo.astro';
import WebTsModeDemo from '@/components/WebTsModeDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';

import { MAT_GRID_CSS } from '@/cuttingMatGrid';
---

<Layout>
  <style is:global set:html={MAT_GRID_CSS} />
  <main id="main">
    {/* One folio per sheet, in page order. Each label is the heading that sheet already
        shows, so the margin and the paper say the same thing; the top sheet has no heading
        but the name, so the name is what its folio reads. */}
    <Folio number={1} label="Hugo Sales" />
    <Name />

    {/* The CV itself sits right behind the title block, where a drawing keeps its revision
        table, and before the bill of materials the roles refer to. */}
    <Folio number={2} label="Career" />
    <Career />

    <Folio number={3} label="Bill of materials" />
    <TechIconCloud />

    <Folio number={4} label="Demos" />
    <section id="demos" class="full-width" aria-labelledby="demos-heading">
      <div class="cutting-mat">
        <SectionHeader
          headingId="demos-heading"
          titleJp="デモ"
          title="Demos"
          sheetCode="SH-DEMOS"
        />
        <Callout letter="A" title="Loading logo" titleJp="読みこみ中のロゴ" scale="3:1" headingId="detail-a" cardSide="start">
          <TitleCard slot="card" title="Visrez Animated Loading Logo" medium="SVG, CSS animation" year="2023">
            The Illustrator export became one path and a cube, animated by hand. The sheets
            after it show each step.
          </TitleCard>
          <VisrezLogoAnimation />
        </Callout>
        <Callout letter="B" title="Marker editor" titleJp="マーカーをつくる" scale="1:1" headingId="detail-b" cardSide="end">
          <TitleCard slot="card" title="Interactive Map Marker Editor" medium="React, Leaflet, Redux" year="2026">
            A pin editor for venue maps. Shape, border, fill and decoration are separate
            parts, and a saved pin rebuilds itself from them.
          </TitleCard>
          <MarkerEditorDemo />
        </Callout>
        <Callout letter="C" title="Space builder" titleJp="へやをつくる" scale="1:1" headingId="detail-c" cardSide="start">
          <TitleCard slot="card" title="Space Builder · Add Tool" medium="Vue, Three.js" year="2023">
            Draw a rectangle on the floor and it fills with chairs. Sliders set the spacing,
            the aisles and the seat count.
          </TitleCard>
          <SpaceBuilderDemo />
        </Callout>
        <Callout letter="D" title="Object variants" titleJp="いろいろなしゅるい" scale="1:1" headingId="detail-d" cardSide="end">
          <TitleCard slot="card" title="Space Builder · Object Variants" medium="Vue, Sass" year="2024">
            One card covers a whole group of library objects. The carousel steps through one
            cell's finishes, the dropdowns move between cells, and a pair the catalogue never
            made falls back to the nearest one it did.
          </TitleCard>
          <VariantsDemo />
        </Callout>
        <Callout letter="E" title="Tagging tool" titleJp="タグをつけるツール" scale="1:1" headingId="detail-e" cardSide="start">
          <TitleCard slot="card" title="Library Tagging Tool" medium="CSS, JavaScript" year="2025">
            One input tags a base object and every variant under it. Variants that already
            disagree keep their own value, and an object leaves the page once nothing about it
            is missing. Pick another property and the values already stored for it come back.
          </TitleCard>
          <TaggingToolDemo />
        </Callout>
        <Callout letter="F" title="Font picker" titleJp="フォントをえらぶ" scale="1:1" headingId="detail-f" cardSide="end">
          <TitleCard slot="card" title="Interactive Map Font Picker" medium="React" year="2026">
            The list of faces comes from document.fonts, each face's Unicode subsets folded
            back into one entry. Nothing in it is hardcoded, so a font that loads later shows
            up on its own.
          </TitleCard>
          <FontPickerDemo />
        </Callout>
        <Callout letter="G" title="Drag and drop" titleJp="ドラッグ＆ドロップ" scale="1:1" headingId="detail-g" cardSide="start">
          <TitleCard slot="card" title="Space Builder · Drag and Drop" medium="Vue, Three.js" year="2023">
            Drag a card off the catalogue and the object lands where it is dropped. Double-click
            one instead and the next click on the floor places it.
          </TitleCard>
          <DragDropDemo />
        </Callout>
        <Callout letter="H" title="Schema driver" titleJp="テーブルのかたち" scale="1:1" headingId="detail-h" cardSide="end">
          <TitleCard slot="card" title="schemaDef → Doctrine Metadata" medium="PHP, Symfony, Doctrine" year="2020">
            GNU social is a federated social network server, written in PHP. Each of its
            tables is one PHP array on the entity class, and a Doctrine driver turns that
            array into the ORM mapping, the database schema and the types PHPStan checks.
          </TitleCard>
          <SchemaDefDemo />
        </Callout>
        <Callout letter="I" title="Event bus" titleJp="できごとをくばる" scale="1:1" headingId="detail-i" cardSide="start">
          <TitleCard slot="card" title="GNU social · Event Dispatch" medium="PHP, Symfony" year="2022">
            GNU social is a federated social network server. Its plugins never call each other:
            a plugin listens for an event by naming a method after it, and the first one to
            answer stop has the job. Switch ImageEncoder off and no other plugin claims the JPEG,
            so the template draws a plain link. ImageEncoder shows a GIF too, then asks for its
            thumbnail with a second event, FileResizerAvailable. That one has two takers at the
            same priority. VideoEncoder asked for image/gif by name, so it goes first and keeps the
            GIF moving. Switch it off and ImageEncoder makes a still.
          </TitleCard>
          <EventBusDemo />
        </Callout>
        <Callout letter="J" title="Synthetic properties" titleJp="大きさでさがす" scale="1:1" headingId="detail-j" cardSide="end">
          <TitleCard slot="card" title="Synthetic Properties" medium="Rails, MariaDB" year="2024">
            A library object stores its size once, in centimetres. On each save, database
            triggers wrote that size out in centimetres, metres, inches and feet, so a search
            for 5ft3in or 1.6m found the same table. The triggers lived five weeks on a branch
            before Ruby callbacks replaced them.
          </TitleCard>
          <SyntheticPropertiesDemo />
        </Callout>
        <Callout letter="K" title="Fediverse playground" titleJp="たくさんのきかいがはなす" scale="1:1" headingId="detail-k" cardSide="start">
          <TitleCard slot="card" title="Fediverse Playground" medium="TypeScript, Docker" year="2026">
            A command-line tool that runs a small federated network on one machine, so you can
            test how fediverse servers talk to each other before a release. Each server gets its
            own hostname, database and branch. One YAML file in, a Docker Compose stack out.
          </TitleCard>
          <FediversePlaygroundDemo />
        </Callout>
        <Callout letter="L" title="Library search" titleJp="ものをさがす" scale="1:1" headingId="detail-l" cardSide="end">
          <TitleCard slot="card" title="Library Search & Relevance" medium="Rails, MariaDB" year="2024">
            One box searches every property of a library object, typed and derived alike.
            MariaDB scores each hit against the best hit in the chosen category. A colour
            filter only drops rows, so the rows it keeps keep their scores.
          </TitleCard>
          <LibrarySearchDemo />
        </Callout>
        <Callout letter="M" title="web-ts-mode" titleJp="いくつものげんごを読む" scale="1:1" headingId="detail-m" cardSide="start">
          <TitleCard slot="card" title="web-ts-mode" medium="Emacs Lisp, tree-sitter" year="2026">
            An Emacs major mode for web templates such as Astro and Vue, where one file mixes
            markup, TypeScript and styles. Each language gets its own tree-sitter parser over its
            part of the file, and highlighting and indenting work across the whole file.
          </TitleCard>
          <WebTsModeDemo />
        </Callout>
      </div>
    </section>

    <Folio number={5} label="Open Source" />
    <OpenSourceContributions />
  </main>
</Layout>

<style lang="scss">
#demos {
  display: grid;
  // The page's columns restated, not a subgrid of them. This section spans full-width, so it
  // is as wide as main and the tracks fall in the same place. As a subgrid, any change of
  // window width that resized the demo stacks, docking DevTools included, cost Chrome 1.3 s of
  // layout before the next frame, and the old frame stayed on screen for all of it.
  grid-template-columns: var(--page-columns);
  row-gap: 4em;
  margin-top: 8rem;

  // Cut the demos off at the window's own two edges. The fold flap is a page-sized box
  // mirrored across the crease (renderFold in fold-drag.ts), so for the length of a fold or a
  // turn its box lands wherever that reflection sends it: 830px past the sheet's right edge on
  // a deep drag at a 1440 window. Nothing paints out there, because the flap's clip-path keeps
  // it on the polygon, but an unpainted box is still scrollable overflow, and the document
  // grows a horizontal scrollbar for the length of the gesture. A mobile viewport answers the
  // same overflow by widening its layout viewport instead, which leaves a phone, or Chrome's
  // responsive device mode, showing a slice of a page half again as wide as the frame, with
  // the fixed theme picker off the side of it.
  //
  // Here and not on the sheet, because the flap's paint does leave the sheet: a deep fold and
  // a turn each sweep it some 800px off the sheet's left edge, and a clip at the sheet cuts
  // that sweep out of the animation. This section is the full-width grid column, so its border
  // box runs from 0 to documentElement.clientWidth at every window size, and a clip with no
  // margin therefore falls exactly on the two edges of the window: whatever it cuts was off
  // screen already. Sideways only, which `clip` allows and `hidden` does not, so nothing is
  // clipped vertically.
  overflow-x: clip;

  @media (max-width: 52rem) {
    row-gap: 2.5em;
    margin-top: 4.5rem;
  }

  /* On the desk the desk's row gap is what separates this section from the one above. */
  @media (width > 64rem) {
    row-gap: var(--desk-gap);
    margin-top: 0;
  }

  /* The title is written on the mat, so it reads as the mat's own and not as a sheet of its own
     above it. Where the mat has the room for the boundaries, it runs as wide as they and the
     cards do, --mat-boundary out past the drawing's column on either side. */
  .cutting-mat > :global(header) {
    margin-bottom: 0;

    @media (width >= 76rem) {
      margin-inline: calc(-1 * var(--mat-boundary));
    }
  }

  /* The details lie on a cutting mat. Past 64rem it stops short of the viewport so the desk
     shows down both sides, and it is never wider than --mat-max (Layout.astro), so it hugs
     what lies on it. Below that there is no desk, so it runs edge to edge and its rim takes
     the page gutter. The ruling covers the content box only, which is what leaves the rim
     unruled; the mat's own colour runs out to the border, so the rim is still mat and not
     desk. */
  .cutting-mat {
    grid-column: full-width;
    justify-self: center;
    width: min(100% - var(--mat-inset) * 2, var(--mat-max));
    min-width: 0;
    display: grid;
    /* The drawing's column, with room past it for the boundary and the ruled band. Where the
       mat is narrower than that the room comes out of the mat and never out of the drawing,
       down to where the boundary would pass the rim onto the mat's edge line. */
    grid-template-columns: min(
      max(
        100% - (var(--mat-boundary, 0px) + var(--mat-clear)) * 2,
        min(100% - max(0px, var(--mat-boundary, 0px) - var(--mat-rim)) * 2, var(--breakout-max))
      ),
      calc(var(--breakout-max) + var(--card-lane))
    );
    justify-content: center;
    row-gap: 4em;
    padding: var(--mat-rim);
    border: var(--mat-line) solid var(--mat-edge);
    border-radius: 0.25rem;
    background: var(--mat-paper);
    /* The ruling is drawn under the details and not over them, inside the mat's own layer. */
    position: relative;
    isolation: isolate;

    /* A tile of the grid per device pixel ratio, set by cuttingMatGrid.ts, masks the theme's
       ink: every line lands on whole device pixels, and every one of them is alike. The tile is
       sized in px and not rem, because it is drawn to the pixel. */
    &::before {
      content: '';
      position: absolute;
      inset: var(--mat-rim);
      z-index: -1;
      background: var(--mat-grid-major);
      mask: var(--mat-tile) 0 0 / var(--mat-tile-size) var(--mat-tile-size) repeat;
      pointer-events: none;
    }

    /* The ruled band down the mat is ruled mat, like the band across it, so it belongs inside
       the content box and not to the rim: the rim is the same plain band on all four sides. */
    > :global(:first-child) {
      margin-block-start: var(--mat-clear);
    }

    > :global(:last-child) {
      margin-block-end: var(--mat-clear);
    }

    @media (max-width: 52rem) {
      row-gap: 3.5em;
    }

    /* With no desk beside it the mat is as wide as the window, so its sides are only a plain
       strip and a line down each edge of the screen. They go, and the ruling runs out to the
       window's edges as if the mat went on past them. The padding takes the line's width
       back, so the details keep the width they had. */
    @media (width <= 64rem) {
      border-inline: 0;
      border-radius: 0;
      padding-inline: calc(var(--mat-rim) + var(--mat-line));

      &::before {
        inset-inline: 0;
      }
    }
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
  }
}
</style>
