---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';

/* The index tabs. One per divider below, in page order; the layout's
   --divider-count and its per-tab colours and timelines are keyed on these. */
const tabs = [
  { href: '#cover', label: 'Cover' },
  { href: '#materials', label: 'Materials' },
  { href: '#demos', label: 'Demos' },
  { href: '#open-source', label: 'Open source' },
];
---

<Layout>
  <main id="main">
    <nav class="binder-tabs typewriter" aria-label="Sections">
      {tabs.map(({ href, label }) => (
        <a href={href}><span>{label}</span></a>
      ))}
    </nav>

    <div class="binder-rings" aria-hidden="true"><span></span><span></span></div>

    <div class="divider" id="cover" data-tab="cover">
      <Name />
    </div>

    <div class="divider" id="materials" data-tab="materials">
      <TechIconCloud />
    </div>

    <section id="demos" class="divider" data-tab="demos" aria-labelledby="demos-heading">
      <SectionHeader
        headingId="demos-heading"
        titleJp="デモ"
        title="Demos"
        sheetCode="SH-DEMOS"
      />

      <VisrezLogoAnimation />
      <MarkerEditorDemo />
      <SpaceBuilderDemo />
    </section>

    <div class="divider" data-tab="oss">
      <OpenSourceContributions />
    </div>
  </main>
</Layout>

<style lang="scss">
#demos {
  row-gap: 4em;

  @media (max-width: 52rem) {
    row-gap: 2.5em;
  }

  > :global(header) {
    grid-column: content;
    margin-bottom: 0;
  }

  > :global(:not(header)) {
    grid-column: breakout;
    min-width: 0;
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
  }
}
</style>

<script>
/* Marks the tab of the section under the 30% line for assistive tech, and
   pulls it out where the stylesheet's scroll-driven animation is unsupported. */
const nav = document.querySelector<HTMLElement>('.binder-tabs');

if (nav) {
  const tabs = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
  const tabOf = new Map<Element, HTMLAnchorElement>();
  for (const tab of tabs) {
    const divider = document.querySelector(tab.hash)?.closest('.divider');
    if (divider) tabOf.set(divider, tab);
  }

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const current = tabOf.get(entry.target);
      for (const tab of tabs) {
        if (tab === current) tab.setAttribute('aria-current', 'location');
        else tab.removeAttribute('aria-current');
      }
    }
  }, { rootMargin: '-30% 0px -69% 0px' });

  tabOf.forEach((_, divider) => observer.observe(divider));
}
</script>
