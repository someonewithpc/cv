---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import TagCloud from '@/components/TagCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';
---

<Layout>
  <main>
    <Name />
    <TagCloud />

    <section id="demos" class="full-width" aria-labelledby="demos-heading">
      <SectionHeader
        headingId="demos-heading"
        titleJp="デモ"
        title="Demos"
      />

      <VisrezLogoAnimation />
      <MarkerEditorDemo />
    </section>

    <OpenSourceContributions />
  </main>
</Layout>

<style lang="scss">
#demos {
  display: grid;
  grid-template-columns: subgrid;
  row-gap: 4em;
  margin-top: 8rem;

  > :global(header) {
    grid-column: content;
    margin-bottom: 0;
  }

  > :global(:not(header)) {
    grid-column: breakout;
    min-width: 0;
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklab, var(--fg-600), transparent 35%);
    margin-inline-start: -0.125rem;
  }
}
</style>
