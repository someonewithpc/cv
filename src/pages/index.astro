---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Callout from '@/components/Callout.astro';
import TitleCard from '@/components/TitleCard.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';
import VariantsDemo from '@/components/VariantsDemo/Demo.astro';
import TaggingToolDemo from '@/components/TaggingToolDemo/Demo.astro';
import FontPickerDemo from '@/components/FontPickerDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';

/* The index tabs, one per section below and in page order. Every label is the heading that
   section already carries, so a tab and the sheet it points at say the same thing; the top
   sheet has no heading but the name, so the name is what its tab reads. */
const tabs = [
  { href: '#profile', label: 'Hugo Sales' },
  { href: '#bill-of-materials', label: 'Bill of materials' },
  { href: '#demos', label: 'Demos' },
  { href: '#open-source', label: 'Open Source' },
];
---

<Layout>
  <main id="main">
    <nav class="index-tabs" aria-label="Sections">
      {tabs.map(({ href, label }, index) => (
        <a href={href}>
          <span class="tab-number monospace" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="tab-name typewriter">{label}</span>
        </a>
      ))}
    </nav>

    <Name />
    <TechIconCloud />

    <section id="demos" class="full-width" aria-labelledby="demos-heading">
      <SectionHeader
        headingId="demos-heading"
        titleJp="デモ"
        title="Demos"
        sheetCode="SH-DEMOS"
      />

      <div class="cutting-mat">
        <Callout letter="A" title="Loading logo" titleJp="ローディングロゴ" scale="3:1" headingId="detail-a" cardSide="start">
          <TitleCard slot="card" title="Visrez Animated Loading Logo" medium="SVG, CSS animation" year="2023">
            The Illustrator export became one path and a cube, animated by hand. The blue
            sheets behind it show each step.
          </TitleCard>
          <VisrezLogoAnimation />
        </Callout>
        <Callout letter="B" title="Marker editor" titleJp="マーカーエディター" scale="1:1" headingId="detail-b" cardSide="end">
          <TitleCard slot="card" title="Interactive Map Marker Editor" medium="React, Leaflet, Redux" year="2026">
            A pin editor for venue maps. Shape, border, fill and decoration are separate
            parts, and a saved pin rebuilds itself from them.
          </TitleCard>
          <MarkerEditorDemo />
        </Callout>
        <Callout letter="C" title="Space builder" titleJp="スペースビルダー" scale="1:1" headingId="detail-c" cardSide="start">
          <TitleCard slot="card" title="Space Builder · Add Tool" medium="Vue, Three.js" year="2023">
            Draw a rectangle on the floor and it fills with chairs. Sliders set the spacing,
            the aisles and the seat count.
          </TitleCard>
          <SpaceBuilderDemo />
        </Callout>
        <Callout letter="D" title="Object variants" titleJp="オブジェクトバリアント" scale="1:1" headingId="detail-d" cardSide="end">
          <TitleCard slot="card" title="Space Builder · Object Variants" medium="Vue, Sass" year="2024">
            One card covers a whole group of library objects. The carousel steps through one
            cell's finishes, the dropdowns move between cells, and a pair the catalogue never
            made falls back to the nearest one it did.
          </TitleCard>
          <VariantsDemo />
        </Callout>
        <Callout letter="E" title="Tagging tool" titleJp="タグ付けツール" scale="1:1" headingId="detail-e" cardSide="start">
          <TitleCard slot="card" title="Library Tagging Tool" medium="CSS, JavaScript" year="2025">
            One input tags a base object and every variant under it. Variants that already
            disagree keep their own value, and an object leaves the page once nothing about it
            is missing.
          </TitleCard>
          <TaggingToolDemo />
        </Callout>
        <Callout letter="F" title="Font picker" titleJp="フォントピッカー" scale="1:1" headingId="detail-f" cardSide="end">
          <TitleCard slot="card" title="Interactive Map Font Picker" medium="React" year="2026">
            The list of faces comes from document.fonts, each face's Unicode subsets folded
            back into one entry. Nothing in it is hardcoded, so a font that loads later shows
            up on its own.
          </TitleCard>
          <FontPickerDemo />
        </Callout>
      </div>
    </section>

    <OpenSourceContributions />
  </main>
</Layout>

<style lang="scss">
#demos {
  display: grid;
  grid-template-columns: subgrid;
  row-gap: 4em;
  margin-top: 8rem;

  @media (max-width: 52rem) {
    row-gap: 2.5em;
    margin-top: 4.5rem;
  }

  /* On the desk the gap between the header sheet and the mat is the same as between any two
     sheets, and the desk's row gap is what separates this section from the one above. */
  @media (width > 64rem) {
    row-gap: var(--desk-gap);
    margin-top: 0;
  }

  > :global(header) {
    grid-column: content;
    margin-bottom: 0;
  }

  /* The details lie on a cutting mat. Past 64rem it stops short of the viewport so the desk
     shows down both sides; how far it stops short, and the width it stops growing at, are the
     desk's own measurements (--mat-inset and --mat-max in Layout.astro), since the index rail
     stands off this edge. Below 64rem there is no desk, so it runs edge to edge and its rim
     takes the page gutter. The four grid layers are laid out from the content box and clipped
     to it, which is what leaves the rim unruled; the last layer is the mat's own colour,
     clipped to the border box, so the rim is still mat and not desk. Edge to edge, the line
     counts toward the gutter, so a stack is exactly as wide as it was without the mat. */
  .cutting-mat {
    --mat-line: 1px;
    --mat-rim: calc(var(--page-gap) - var(--mat-line));

    /* The lane a detail's title card stands in, beside the view rather than under it. It is
       open only where the mat is wide enough to hold a stack and a card side by side: the mat
       stops growing at 80rem, so past 86rem the lane is this width and no more. One switch
       drives both the column here and the card itself (Callout.astro). */
    --card-width: 12rem;
    --card-gap: 3rem;
    --card-lane: 0px;
    --card-display: none;

    grid-column: full-width;
    justify-self: center;
    width: min(100% - var(--mat-inset) * 2, var(--mat-max));
    min-width: 0;
    display: grid;
    grid-template-columns: min(100%, calc(var(--breakout-max) + var(--card-lane)));
    justify-content: center;
    row-gap: 4em;
    padding: var(--mat-rim);
    border: var(--mat-line) solid var(--mat-edge);
    border-radius: 0.25rem;
    /* One ruling per axis, not a minor grid under a major one: where two of those crossed,
       four coats of ink stacked up and the stacks' peel hints stopped reading against them. */
    --mat-rule: var(--mat-grid-major) 0 1px, transparent 1px 0.5rem,
      var(--mat-grid-minor) 0.5rem calc(0.5rem + 1px), transparent calc(0.5rem + 1px) 1rem,
      var(--mat-grid-minor) 1rem calc(1rem + 1px), transparent calc(1rem + 1px) 1.5rem,
      var(--mat-grid-minor) 1.5rem calc(1.5rem + 1px), transparent calc(1.5rem + 1px) 2rem,
      var(--mat-grid-minor) 2rem calc(2rem + 1px), transparent calc(2rem + 1px) 2.5rem;

    background-color: transparent;
    background-image:
      repeating-linear-gradient(to right, var(--mat-rule)),
      repeating-linear-gradient(to bottom, var(--mat-rule)),
      linear-gradient(var(--mat-paper), var(--mat-paper));
    background-origin: content-box, content-box, border-box;
    background-clip: content-box, content-box, border-box;

    @media (width > 64rem) {
      --mat-rim: 1.5rem;
    }

    @media (width >= 86rem) {
      --card-lane: calc(var(--card-width) + var(--card-gap));
      --card-display: block;
    }

    @media (max-width: 52rem) {
      row-gap: 2.5em;
    }
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
  }
}
</style>

<script>
/* Marks the tab of the section under the 30% line for assistive tech, and pulls that tab out
   where the stylesheet's scroll-driven animation is unsupported. Nothing is marked while the
   line is over the desk between two sections, so the tab that was out stays out. */
const rail = document.querySelector<HTMLElement>('.index-tabs');

if (rail) {
  const tabs = [...rail.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
  const tabOf = new Map<Element, HTMLAnchorElement>();
  for (const tab of tabs) {
    const section = document.querySelector(tab.hash);
    if (section) tabOf.set(section, tab);
  }

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const current = tabOf.get(entry.target);
      for (const tab of tabs) {
        if (tab === current) tab.setAttribute('aria-current', 'location');
        else tab.removeAttribute('aria-current');
      }
    }
  }, { rootMargin: '-30% 0px -69% 0px' });

  tabOf.forEach((_, section) => observer.observe(section));
}
</script>
