---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Callout from '@/components/Callout.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';
import VariantsDemo from '@/components/VariantsDemo/Demo.astro';
import TaggingToolDemo from '@/components/TaggingToolDemo/Demo.astro';
import FontPickerDemo from '@/components/FontPickerDemo/Demo.astro';
import DragDropDemo from '@/components/DragDropDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';
---

<Layout>
  <main id="main">
    <Name />
    <TechIconCloud />

    <section id="demos" class="full-width" aria-labelledby="demos-heading">
      <SectionHeader
        headingId="demos-heading"
        titleJp="デモ"
        title="Demos"
        sheetCode="SH-DEMOS"
      />

      <div class="cutting-mat">
        <Callout letter="A" title="Loading logo" titleJp="ローディングロゴ" scale="3:1" headingId="detail-a">
          <VisrezLogoAnimation />
        </Callout>
        <Callout letter="B" title="Marker editor" titleJp="マーカーエディター" scale="1:1" headingId="detail-b">
          <MarkerEditorDemo />
        </Callout>
        <Callout letter="C" title="Space builder" titleJp="スペースビルダー" scale="1:1" headingId="detail-c">
          <SpaceBuilderDemo />
        </Callout>
        <Callout letter="D" title="Object variants" titleJp="オブジェクトバリアント" scale="1:1" headingId="detail-d">
          <VariantsDemo />
        </Callout>
        <Callout letter="E" title="Tagging tool" titleJp="タグ付けツール" scale="1:1" headingId="detail-e">
          <TaggingToolDemo />
        </Callout>
        <Callout letter="F" title="Font picker" titleJp="フォントピッカー" scale="1:1" headingId="detail-f">
          <FontPickerDemo />
        </Callout>
        <Callout letter="G" title="Drag and drop" titleJp="ドラッグ＆ドロップ" scale="1:1" headingId="detail-g">
          <DragDropDemo />
        </Callout>
      </div>
    </section>

    <OpenSourceContributions />
  </main>
</Layout>

<style lang="scss">
#demos {
  display: grid;
  grid-template-columns: subgrid;
  row-gap: 4em;
  margin-top: 8rem;

  // Cut the demos off at the window's own two edges. The fold flap is a page-sized box
  // mirrored across the crease (renderFold in fold-drag.ts), so for the length of a fold or a
  // turn its box lands wherever that reflection sends it: 830px past the sheet's right edge on
  // a deep drag at a 1440 window. Nothing paints out there, because the flap's clip-path keeps
  // it on the polygon, but an unpainted box is still scrollable overflow, and the document
  // grows a horizontal scrollbar for the length of the gesture. A mobile viewport answers the
  // same overflow by widening its layout viewport instead, which leaves a phone, or Chrome's
  // responsive device mode, showing a slice of a page half again as wide as the frame, with
  // the fixed theme picker off the side of it.
  //
  // Here and not on the sheet, because the flap's paint does leave the sheet: a deep fold and
  // a turn each sweep it some 800px off the sheet's left edge, and a clip at the sheet cuts
  // that sweep out of the animation. This section is the full-width grid column, so its border
  // box runs from 0 to documentElement.clientWidth at every window size, and a clip with no
  // margin therefore falls exactly on the two edges of the window: whatever it cuts was off
  // screen already. Sideways only, which `clip` allows and `hidden` does not, so nothing is
  // clipped vertically.
  overflow-x: clip;

  @media (max-width: 52rem) {
    row-gap: 2.5em;
    margin-top: 4.5rem;
  }

  /* On the desk the gap between the header sheet and the mat is the same as between any two
     sheets, and the desk's row gap is what separates this section from the one above. */
  @media (width > 64rem) {
    row-gap: var(--desk-gap);
    margin-top: 0;
  }

  > :global(header) {
    grid-column: content;
    margin-bottom: 0;
  }

  /* The details lie on a cutting mat. Past 64rem it stops short of the viewport so the desk
     shows down both sides; below that there is no desk, so it runs edge to edge and its rim
     takes the page gutter. The four grid layers are laid out from the content box and clipped
     to it, which is what leaves the rim unruled; the last layer is the mat's own colour,
     clipped to the border box, so the rim is still mat and not desk. */
  .cutting-mat {
    --mat-rim: var(--page-gap);
    --mat-inset: 0px;
    --mat-max: 80rem;

    grid-column: full-width;
    justify-self: center;
    width: min(100% - var(--mat-inset) * 2, var(--mat-max));
    min-width: 0;
    display: grid;
    grid-template-columns: min(100%, var(--breakout-max));
    justify-content: center;
    row-gap: 4em;
    padding: var(--mat-rim);
    border: 1px solid var(--mat-edge);
    border-radius: 0.25rem;
    background-color: transparent;
    background-image:
      linear-gradient(to right, var(--mat-grid-major) 1px, transparent 1px),
      linear-gradient(to bottom, var(--mat-grid-major) 1px, transparent 1px),
      linear-gradient(to right, var(--mat-grid-minor) 1px, transparent 1px),
      linear-gradient(to bottom, var(--mat-grid-minor) 1px, transparent 1px),
      linear-gradient(var(--mat-paper), var(--mat-paper));
    background-size: 2.5rem 2.5rem, 2.5rem 2.5rem, 0.5rem 0.5rem, 0.5rem 0.5rem, auto;
    background-origin: content-box, content-box, content-box, content-box, border-box;
    background-clip: content-box, content-box, content-box, content-box, border-box;

    @media (width > 64rem) {
      --mat-rim: 1.5rem;
      --mat-inset: clamp(1.5rem, 4vw, 5rem);
    }

    @media (max-width: 52rem) {
      row-gap: 2.5em;
    }
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
  }
}
</style>
