---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';
---

<Layout>
  <main id="main">
    <span class="desk-scale full-width" aria-hidden="true"></span>
    <Name />
    <TechIconCloud />

    <section id="demos" class="full-width" aria-labelledby="demos-heading">
      <SectionHeader
        headingId="demos-heading"
        titleJp="デモ"
        title="Demos"
      />

      <VisrezLogoAnimation />
      <MarkerEditorDemo />
      <SpaceBuilderDemo />
    </section>

    <OpenSourceContributions />
    <span class="desk-edge full-width" aria-hidden="true"></span>
  </main>
</Layout>

<style lang="scss">
/* The scale glued along the board's left edge: a tick every half rem, a
   longer one every five. */
.desk-scale {
  display: none;
  position: absolute;
  inset: 0 auto 0 0;
  width: 1.5rem;
  pointer-events: none;
  background:
    linear-gradient(to right, transparent 0.875rem, rgb(0 0 0 / 0.3) 0.875rem, rgb(0 0 0 / 0.3) calc(0.875rem + 1px), transparent 0)
      0 0 / 100% 5rem repeat-y,
    repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.28) 0, rgb(0 0 0 / 0.28) 1px, transparent 1px, transparent 0.5rem)
      0 0 / 0.5rem 100% repeat-y,
    repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.3) 0, rgb(0 0 0 / 0.3) 1px, transparent 1px, transparent 1rem)
      0 0 / 0.875rem 100% repeat-y,
    linear-gradient(to right, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.12) 60%, rgb(0 0 0 / 0.08));
  border-right: 1px solid rgb(0 0 0 / 0.35);
  box-shadow: 0.125rem 0 0.375rem rgb(0 0 0 / 0.25);

  @media (min-width: 64rem) {
    display: block;
  }
}

/* The near edge of the desk, where the page ends. */
.desk-edge {
  height: 1.25rem;
  margin-top: 3rem;
  background:
    linear-gradient(to bottom, rgb(255 255 255 / 0.18), transparent 25%, rgb(0 0 0 / 0.35) 90%, rgb(0 0 0 / 0.55));
  border-top: 1px solid rgb(0 0 0 / 0.3);
}

#demos {
  display: grid;
  grid-template-columns: subgrid;
  row-gap: 4.5em;
  margin-top: 6rem;

  @media (max-width: 52rem) {
    row-gap: 3em;
    margin-top: 4rem;
  }

  > :global(header) {
    grid-column: content;
    margin-bottom: -1.5em;
  }

  > :global(:not(header)) {
    grid-column: breakout;
    min-width: 0;
  }

  :global([lang='ja']) {
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
  }
}
</style>
