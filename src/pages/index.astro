---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';

import FloorPlan, { type PlanRoom } from '@/components/Gallery/FloorPlan.astro';
import Room from '@/components/Gallery/Room.astro';
import Vitrine from '@/components/Gallery/Vitrine.astro';
import WallLabel from '@/components/Gallery/WallLabel.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';

/* The route through the gallery, and each room's footprint on the plan: two
   rooms to a row, the path snaking down. */
const ROOMS: PlanRoom[] = [
  { id: 'foyer', name: 'Foyer', x: 4, y: 4, w: 40, h: 26 },
  { id: 'vitrine', name: 'Vitrine', x: 44, y: 4, w: 72, h: 26 },
  { id: 'logo', name: 'Logo', x: 56, y: 30, w: 60, h: 30 },
  { id: 'markers', name: 'Markers', x: 4, y: 30, w: 52, h: 30 },
  { id: 'spaces', name: 'Spaces', x: 4, y: 60, w: 52, h: 36 },
  { id: 'archive', name: 'Archive', x: 56, y: 60, w: 60, h: 36 },
];
---

<Layout>
  <FloorPlan rooms={ROOMS} />

  <main id="main">
    <Room id="foyer" wall="foyer" light="skylight" ariaLabel="Foyer">
      <Name />
      <p class="wall-text">
        Six rooms. Three tools built for Visrez, the materials they were made with, and the
        patches sent upstream. Turn the sheets by their corner; the notes are folded under
        each one.
      </p>
    </Room>

    <Room id="vitrine" wall="vitrine" light="case" ariaLabel="Vitrine">
      <Vitrine>
        <TechIconCloud />
      </Vitrine>
    </Room>

    <section id="demos" class="full-width" aria-labelledby="demos-heading">
      <Room id="logo" wall="logo" label="end" display="hung" light="spot-end" ariaLabelledby="logo-label">
        <SectionHeader
          slot="lintel"
          headingId="demos-heading"
          titleJp="デモ"
          title="Demos"
          sheetCode="SH-DEMOS"
        />
        <VisrezLogoAnimation />
        <WallLabel
          slot="label"
          headingId="logo-label"
          title="Visrez Animated Loading Logo"
          medium="SVG, CSS animation"
          year="2023"
        >
          The Illustrator export was redrawn as one path and a cube, then animated by hand.
          The blue sheets behind it show each step.
        </WallLabel>
      </Room>

      <Room id="markers" wall="markers" label="start" display="hung" light="spot-start" ariaLabelledby="markers-label">
        <MarkerEditorDemo />
        <WallLabel
          slot="label"
          headingId="markers-label"
          title="Interactive Map Marker Editor"
          medium="React, Leaflet, Redux"
          year="2026"
        >
          A pin editor for venue maps. Shape, border, fill and decoration are separate parts,
          and a saved pin rebuilds itself from them.
        </WallLabel>
      </Room>

      <Room id="spaces" wall="spaces" label="end" display="plinth" light="downlight" ariaLabelledby="spaces-label">
        <SpaceBuilderDemo />
        <WallLabel
          slot="label"
          headingId="spaces-label"
          title="Space Builder · Add Tool"
          medium="Vue, Three.js"
          year="2023"
        >
          Draw a rectangle on the floor and it fills with chairs. Sliders set the spacing,
          the aisles and the seat count.
        </WallLabel>
      </Room>
    </section>

    <Room id="archive" wall="archive" light="even" ariaLabel="Archive">
      <OpenSourceContributions />
    </Room>
  </main>
</Layout>

<style lang="scss">
#demos {
  display: grid;
  grid-template-columns: subgrid;

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
  }
}

</style>

<style lang="scss" is:global>
/* The foyer is the tallest room, lit from above, with the name in the middle
   of the wall and the introduction in small type beneath it. */
#foyer {
  --room-top: 3rem;
  --room-gap: 2rem;

  @media (max-width: 52rem) {
    --room-top: 1.25rem;
  }

  .wall-text {
    max-width: 38rem;
    margin: 1.5rem auto 0;
    font-family: var(--font-poppins);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-align: center;
    text-wrap: pretty;
    color: var(--ink-muted);
  }
}

/* The vitrine room is low and close: a short wall, the case lit from directly above. */
#vitrine {
  --room-top: 3rem;
  --floor: 3rem;
}

#logo {
  --room-top: 3.5rem;
}

#markers {
  --room-top: 5rem;
}

#spaces {
  --room-top: 5.5rem;
  --floor: 3.5rem;
}

/* The archive is the last room and the phone's bottom bar sits over its floor. */
#archive {
  --floor: 4rem;

  @media (max-width: 52rem) {
    padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
  }
}
</style>
