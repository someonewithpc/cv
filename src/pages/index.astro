---
import Layout from '@/layouts/Layout.astro';

import Band from '@/components/Band.astro';
import Name from '@/components/Name.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';
---

<Layout>
  <main id="main">
    <Band number={1} material="desk" class="masthead">
      <Name />
    </Band>

    <Band number={2} material="kraft">
      <TechIconCloud />
    </Band>

    <Band number={3} material="mat" as="section" id="demos" labelledby="demos-heading">
      <SectionHeader
        headingId="demos-heading"
        titleJp="デモ"
        title="Demos"
        sheetCode="SH-03"
      />

      <VisrezLogoAnimation />
      <MarkerEditorDemo />
      <SpaceBuilderDemo />
    </Band>

    <OpenSourceContributions />
  </main>
</Layout>

<style lang="scss">
:global(#demos) {
  row-gap: 4em;

  @media (max-width: 52rem) {
    row-gap: 2.5em;
  }

  > :global(header) {
    margin-bottom: 0;
  }

  > :global(:not(header, .folio-rail)) {
    grid-column: breakout;
  }

  /* Each deck sits above its stack, with every second one set from the right edge. */
  > :global(.demo-lede) {
    margin-top: 2.5rem;
    margin-bottom: -2.5em;

    @media (max-width: 52rem) {
      margin-bottom: -1em;
    }
  }

  > :global(.demo-lede:nth-child(even of .demo-lede)) {
    justify-self: end;
    text-align: right;
  }
}
</style>
