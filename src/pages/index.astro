---
import Layout from '@/layouts/Layout.astro';

import Name from '@/components/Name.astro';
import RevisionTable from '@/components/RevisionTable.astro';
import TechIconCloud from '@/components/TechIconCloud.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Callout from '@/components/Callout.astro';

import VisrezLogoAnimation from '@/components/VisrezLogoAnimation/Demo.astro';
import MarkerEditorDemo from '@/components/MarkerEditorDemo/Demo.astro';
import SpaceBuilderDemo from '@/components/SpaceBuilderDemo/Demo.astro';

import OpenSourceContributions from '@/components/OpenSourceContributions/OpenSourceContributions.astro';
---

<Layout>
  <main id="main">
    <div class="cover">
      <TechIconCloud />
      <RevisionTable />
      <Name />
    </div>

    <section id="demos" class="full-width" aria-labelledby="demos-heading">
      <SectionHeader
        headingId="demos-heading"
        titleJp="デモ"
        title="Demos"
        sheetCode="Details A to C"
      />

      <Callout letter="A" kind="Detail" title="Loading logo" titleJp="ローディングロゴ" scale="3:1" headingId="detail-a">
        <VisrezLogoAnimation />
      </Callout>
      <Callout letter="B" kind="Detail" title="Marker editor" titleJp="マーカーエディター" scale="1:1" headingId="detail-b">
        <MarkerEditorDemo />
      </Callout>
      <Callout letter="C" kind="Section" title="Space builder" titleJp="スペースビルダー" scale="1:1" headingId="section-c">
        <SpaceBuilderDemo />
      </Callout>
    </section>

    <OpenSourceContributions />
  </main>
</Layout>

<style lang="scss">
/* The first view of the sheet: the parts list up top, the revision table and the title block
   along the bottom edge, the way a sheet keeps them. The block is what a reader looks for
   first on a drawing, so on a phone, where there is no bottom right, it comes first. */
.cover {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas:
    'parts parts'
    'revisions title';
  align-items: end;
  gap: 3rem 2rem;
  padding-block: 1.5rem 1rem;

  > :global(:nth-child(1)) {
    grid-area: parts;
  }

  > :global(:nth-child(2)) {
    grid-area: revisions;
  }

  > :global(:nth-child(3)) {
    grid-area: title;
    min-width: 0;
  }

  @media (max-width: 52rem) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'title'
      'parts'
      'revisions';
    gap: 2rem;
    padding-block: 2.75rem 0.5rem;
  }
}

#demos {
  display: grid;
  grid-template-columns: subgrid;
  row-gap: 5rem;
  margin-top: 6rem;

  @media (max-width: 52rem) {
    row-gap: 3.5rem;
    margin-top: 4rem;
  }

  > :global(header) {
    grid-column: content;
    margin-bottom: 0;
  }

  > :global(:not(header)) {
    grid-column: breakout;
    min-width: 0;
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
  }
}
</style>
