---
// Review page for Hugo's favicon pick. Remove it at landing, with public/favicon-candidates/
// minus the chosen design.
import Layout from '@/layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sizes = [16, 32, 48, 128];
const candidates = [
  { n: 6, note: 'An "H$" prompt on a dark terminal ground, with the $ in a paler green than the H.' },
  { n: 7, note: 'The same "H$" in dark green on a bright green square.' },
  { n: 8, note: 'An "H$" prompt in one green on the dark ground, with a block cursor after the $.' },
  { n: 12, note: 'Candidate 8 drawn in DejaVu Sans Mono Book, the Emacs and Ghostty face on this machine, at its own proportions.' },
  { n: 13, note: 'The same prompt in Hack Regular.' },
  { n: 14, note: 'DejaVu Sans Mono Book again, with the font\'s own underscore as the cursor.' },
];
const grounds = [
  { key: 'light', label: 'Light tab' },
  { key: 'dark', label: 'Dark tab' },
];
---

<Layout title="Favicon candidates">
  <main id="main" class="favicons">
    <h1>Favicon candidates</h1>
    <p>Each row shows one icon at 16, 32, 48 and 128 px, on a light and a dark tab colour.</p>

    {
      [...candidates, { n: 0, note: 'The current favicon, for comparison. It follows the system colour scheme, not the tab.' }].map((c) => (
        <section class="candidate" aria-labelledby={`fav-${c.n}`}>
          <h2 id={`fav-${c.n}`}>{c.n ? `Candidate ${c.n}` : 'Current'}</h2>
          <p>{c.note}</p>
          <div class="grounds">
            {grounds.map((g) => (
              <div class={`ground ${g.key}`}>
                <span class="label">{g.label}</span>
                {sizes.map((s) => (
                  <img
                    src={c.n ? `${base}favicon-candidates/${c.n}.svg` : `${base}favicon.svg`}
                    width={s}
                    height={s}
                    style={`--size: ${s / 16}rem`}
                    alt={`${c.n ? `Candidate ${c.n}` : 'Current favicon'} at ${s} px`}
                  />
                ))}
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</Layout>

<style lang="scss">
  .favicons {
    max-inline-size: 60rem;
    margin-inline: auto;
    padding: 2rem 1rem;
    color: var(--ink);
  }

  h1 {
    margin-block-end: 1rem;
  }

  .candidate {
    margin-block-start: 2rem;

    h2 {
      margin-block-end: 0.5rem;
    }

    p {
      margin-block-end: 0.75rem;
    }
  }

  .grounds {
    display: grid;
    gap: 0.5rem;
  }

  .ground {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;

    &.light {
      background: #f2f2f2;
      color: #202124;
    }

    &.dark {
      background: #202124;
      color: #f2f2f2;
    }

    img {
      inline-size: var(--size);
      block-size: var(--size);
    }
  }

  .label {
    inline-size: 5rem;
  }
</style>
