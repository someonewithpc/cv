<div class="picker-layer">
  <div
    class="picker-island"
    data-font-picker-island
    data-boot-module="/src/components/FontPickerDemo/layers/PickerLayer.boot.ts"
  >
    <div class="boot-placeholder" aria-hidden="true">
      <span class="boot-spinner"></span>
      <span>Loading the font picker…</span>
    </div>
  </div>
</div>

{/*
  No <script> here — a component reached only through Stack.astro's per-layer
  Astro.slots.render() call never gets its own hoisted script onto the page (see the
  "dev-server-drops-demo-scripts" memory). PickerLayer.boot.ts is armed instead by
  Stack.astro's own script, which the pagination doesn't touch, via data-boot-module.
*/}

<style lang="scss">
.picker-layer {
  box-sizing: border-box;
  width: 100%;
  display: grid;
  place-items: center;

  // Sized from the stack's measured pixels, never a container unit: see Stack.astro's script.
  // A landscape sheet is twice as wide as it is tall, so its height runs out first and the
  // specimen shrinks with it rather than running off the foot.
  font-size: clamp(0.625rem, 0.027 * min(var(--sheet-inline), var(--sheet-block)), 1rem);

  :global([data-sheet-orientation='portrait']) & {
    font-size: min(1rem, 0.036 * var(--sheet-inline));
  }
}

.picker-island {
  width: min(100%, 72em);
}

/* Below 56em Page.astro tucks the note under the dog-eared corner, and the column it kept for
   it stands empty. The picker takes that column, and gives the title block back the height of
   its own corner so nothing reads through it. */
@container technical-drawing-width (max-width: 56em) {
  :global(article.technical-drawing-stack > * > section > .content:has(.picker-layer)) {
    grid-column: 1 / -1;
    margin-bottom: 3.5em;
  }
}

.boot-placeholder {
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 0.75rem;
  min-height: 12em;
  color: var(--ink-muted, #666);
  font: 0.85rem/1.3 system-ui, sans-serif;
}

.boot-spinner {
  width: 1.75rem;
  height: 1.75rem;
  border: 3px solid #89ab24;
  border-top-color: transparent;
  border-radius: 50%;
  animation: picker-boot-spin 0.8s linear infinite;

  @media (prefers-reduced-motion: reduce) {
    animation: none;
    border-color: #89ab24;
  }
}

@keyframes picker-boot-spin {
  to {
    transform: rotate(360deg);
  }
}
</style>
