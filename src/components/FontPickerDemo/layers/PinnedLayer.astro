<div class="wrapper">
  <p class="sheet-note">
    Font Size sets the column's own text size. Drag it and the row grows, so the slider walks
    out from under the pointer. FixedElement pins the row where the drag started. Both columns
    get the same drag, with the pointer held in one place
  </p>

  <div
    class="held-island"
    data-held-controls-island
    data-boot-module="/src/components/FontPickerDemo/layers/PinnedLayer.boot.ts"
  >
    <div class="boot-placeholder" aria-hidden="true">
      <span class="boot-spinner"></span>
      <span>Loading the two columns…</span>
    </div>
  </div>

</div>

{/*
  No <script> here — a component reached only through Stack.astro's per-layer
  Astro.slots.render() call never gets its own hoisted script onto the page (see the
  "dev-server-drops-demo-scripts" memory). PinnedLayer.boot.ts is armed instead by
  Stack.astro's own script, which the pagination doesn't touch, via data-boot-module.
*/}

<style lang="scss">
@use "./sheet" as *;
@use "./sheetProse" as *;

.wrapper {
  @include sheet-content;

  display: grid;
  grid-template-columns: minmax(0, 1fr);
  justify-items: center;
  gap: 1em;

  // A portrait sheet drops the note, so the first column's title lands in the corner the
  // paper clip sits over. Leave the clip its room.
  :global([data-sheet-orientation='portrait']) & {
    margin-top: 1.25em;
  }
}

.held-island {
  width: min(100%, 52em);
}

/* The drag makes a column taller, and a centred artwork answers by sliding the whole thing up,
   so the row the pointer is on ends up above where it was grabbed. That is the reverse of what
   this sheet is about. Hang the columns from the top and the growth runs downwards, as it does
   in the product's own sidebar. */
:global(article.technical-drawing-stack > * > section > .content:has(.held-controls)) {
  align-self: start;
}

.sheet-note {
  @include sheet-prose;

  margin: 0;
  // A phone sheet needs its height for the two columns, and each one says this in its own
  // caption anyway
  :global([data-sheet-orientation='portrait']) & {
    display: none;
  }

  max-width: 44em;
  color: var(--ink-muted);
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.0115 * var(--sheet-inline), 1rem);
  line-height: 1.35;
  text-align: center;
  text-wrap: pretty;
}

.boot-placeholder {
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 0.75rem;
  min-height: 12em;
  color: var(--ink-muted, #666);
  font: 0.85rem/1.3 system-ui, sans-serif;
}

.boot-spinner {
  width: 1.75rem;
  height: 1.75rem;
  border: 3px solid #89ab24;
  border-top-color: transparent;
  border-radius: 50%;
  animation: held-boot-spin 0.8s linear infinite;

  @media (prefers-reduced-motion: reduce) {
    animation: none;
    border-color: #89ab24;
  }
}

@keyframes held-boot-spin {
  to {
    transform: rotate(360deg);
  }
}
</style>
