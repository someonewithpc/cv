---
---

<div class="wrapper">
  <p class="sheet-note">
    Font Size sets the column's own text size. Drag it and the row grows, so the slider walks
    out from under the pointer. FixedElement pins the row where the drag started. Both columns
    get the same drag, with the pointer held in one place
  </p>

  <div
    class="held-island"
    data-held-controls-island
  >
    <div class="boot-placeholder" aria-hidden="true">
      <span class="boot-spinner"></span>
      <span>Loading the two columns…</span>
    </div>
  </div>

</div>

<script>
  import { bootIslands } from '@/client/pageIsland';
  import { boot } from './PinnedLayer.boot';
  bootIslands('[data-held-controls-island]', boot);
</script>

<style lang="scss">
@use "./sheet" as *;
@use "./sheetProse" as *;

.wrapper {
  // A portrait sheet sets the two columns side by side at this scale, half the picker's width
  // each, and has the height for the drag to grow them
  @include sheet-content(0.03, $prose-landscape);

  display: grid;
  // The columns on the left and the note on the right, not over them: the title block takes
  // the sheet's bottom right corner, and a column that starts above it runs into it once a
  // drag has grown it. Kept to the left of the block, the growth runs into clear sheet, and
  // the note sits in the room above it
  grid-template-columns: minmax(0, 1fr) minmax(11em, 15em);
  align-items: start;
  gap: 1.5em;

  // A portrait sheet drops the note, so the first column's title lands in the corner the
  // paper clip sits over. Leave the clip its room.
  :global([data-sheet-orientation='portrait']) & {
    margin-top: 1.25em;
  }
}

.held-island {
  grid-area: 1 / 1;
  // Two of the product's 20em sidebars at the widget's scale, kept left of the title block
  // on every landscape sheet
  width: min(100%, $widget-scale * 42em);
}

.sheet-note {
  grid-area: 1 / 2;
}

// A sheet under 56em drops the note, and each column says what it shows in its own caption
@container technical-drawing-width (max-width: 56em) {
  .wrapper {
    grid-template-columns: minmax(0, 1fr);
    gap: 1em;
  }

  .sheet-note {
    display: none;
  }
}

/* The drag makes a column taller, and a centred artwork answers by sliding the whole thing up,
   so the row the pointer is on ends up above where it was grabbed. That is the reverse of what
   this sheet is about. Hang the columns from the top and the growth runs downwards, as it does
   in the product's own sidebar. */
:global(article.technical-drawing-stack > * > section > .content:has(.held-controls)) {
  align-self: start;
}

.sheet-note {
  @include sheet-prose;

  margin: 0;
  color: var(--ink-muted);
  font-family: var(--font-poppins), system-ui, sans-serif;
  line-height: 1.35;
  text-wrap: pretty;
}

.boot-placeholder {
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 0.75rem;
  min-height: 12em;
  color: var(--ink-muted, #666);
  font: 0.85rem/1.3 system-ui, sans-serif;
}

.boot-spinner {
  width: 1.75rem;
  height: 1.75rem;
  border: 3px solid #89ab24;
  border-top-color: transparent;
  border-radius: 50%;
  animation: held-boot-spin 0.8s linear infinite;

  @media (prefers-reduced-motion: reduce) {
    animation: none;
    border-color: #89ab24;
  }
}

@keyframes held-boot-spin {
  to {
    transform: rotate(360deg);
  }
}
</style>
