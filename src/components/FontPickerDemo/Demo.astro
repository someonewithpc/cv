---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';

import PickerLayer from './layers/PickerLayer.astro';
import DiscoveryLayer from './layers/DiscoveryLayer.astro';
import SourcesLayer from './layers/SourcesLayer.astro';
import FeedbackLayer from './layers/FeedbackLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

// Resolve from cwd — import.meta.url points at dist prerender chunks during build.
const srcRoot = path.join(process.cwd(), 'src');
const fontPickerEntry = path.join(
  srcRoot,
  'components/FontPickerDemo/picker/EditStyleApp.tsx',
);

const { outputFiles: [fontPickerBundle] } = await esbuild.build({
  entryPoints: [fontPickerEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  jsx: 'automatic',
  packages: 'external',
  alias: { '@': srcRoot },
  loader: {
    '.scss': 'empty',
    '.css': 'empty',
  },
});

const fontPickerSize = toKiB(fontPickerBundle.text);

const layers = {
  main: { name: null },
  discovery: { name: 'Font Discovery', pageStyle: 'blueprint' },
  sources: { name: 'External Sources', pageStyle: 'blueprint' },
  feedback: { name: 'Reactive Feedback', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="Interactive Map Font Picker"
  scale="1:1"
  size={fontPickerSize}
  date="2026"
  tech={['react']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      main: <PickerLayer />,
      discovery: <DiscoveryLayer />,
      sources: <SourcesLayer />,
      feedback: <FeedbackLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      main: (
        <PostIt background="#e8e4dc" color="black">
          Pick a face and the whole page wears it. Hover an option to try it
          on; a Google font name or a page URL adds its faces to the list
        </PostIt>
      ),
      discovery: (
        <PostIt background="#cde" color="black">
          No hardcoded font list — the dropdown is <code>document.fonts</code>,
          deduplicated by family, weight and style, since every Unicode-range
          subset registers as its own face
        </PostIt>
      ),
      sources: (
        <PostIt background="#dfd" color="black">
          Pages that set <code>X-Frame-Options</code> can't be iframed, so the
          extractor fetches the HTML through a proxy and assembles the document
          by hand — stylesheets, <code>@import</code>s and all
        </PostIt>
      ),
      feedback: (
        <PostIt background="#edf" color="black">
          The fieldset border is one conic gradient driven by three registered
          custom properties. A quarter-turn arc orbits while a fetch is pending,
          then sweeps closed in the verdict's color
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>

{/* Vite React refresh preamble — required when mounting React from an Astro script in dev. */}
<script>
  if (import.meta.hot) {
    // Vite virtual module — only exists in dev
    // @ts-expect-error
    const RefreshRuntime = (await import('/@react-refresh')).default;
    RefreshRuntime.injectIntoGlobalHook(window);
    // @ts-expect-error Vite React refresh globals
    window.$RefreshReg$ = () => {};
    // @ts-expect-error Vite React refresh globals
    window.$RefreshSig$ = () => (type) => type;
    // @ts-expect-error Vite React refresh globals
    window.__vite_plugin_react_preamble_installed__ = true;
  }
</script>

<script>
  import { bootWhenVisible } from '@/client/bootWhenVisible';

  async function bootFontPicker() {
    const mount = document.querySelector<HTMLElement>('[data-font-picker-island]');
    if (!mount || mount.dataset.bootstrapped === 'true') return;
    mount.dataset.bootstrapped = 'true';

    const [{ createElement }, { createRoot }, { default: EditStyleApp }] = await Promise.all([
      import('react'),
      import('react-dom/client'),
      import('./picker/EditStyleApp'),
    ]);

    createRoot(mount).render(createElement(EditStyleApp));
  }

  function armBoot() {
    const mount = document.querySelector<HTMLElement>('[data-font-picker-island]');
    if (!mount || mount.dataset.bootstrapped === 'true') return;

    const page =
      mount.closest<HTMLElement>('article.technical-drawing-stack > * > section')
      ?? mount;
    const stack = page.closest('article.technical-drawing-stack');

    bootWhenVisible(
      page,
      () => {
        void bootFontPicker();
      },
      { root: stack, rootMargin: '0px', threshold: 0.2 },
    );
  }

  armBoot();
</script>

<script>
  import { registerFontSettingsProperties } from './picker/registerFontSettingsProperties';

  registerFontSettingsProperties();

  const BORDER_ANIMATION_DURATION = 1000;

  document.querySelectorAll<HTMLElement>('[data-border-demo]').forEach((fieldset) => {
    // Same trick as the live subform: the pending loop eases in, then goes
    // linear at the point where the bezier is already essentially linear
    fieldset.addEventListener('animationstart', () => {
      setTimeout(() => {
        fieldset.style.setProperty('animation-timing-function', 'linear');
      }, BORDER_ANIMATION_DURATION * 0.75);
    });
    fieldset.addEventListener('animationend', () => {
      fieldset.style.removeProperty('animation-timing-function');
    });

    const buttons = fieldset.parentElement!.querySelectorAll<HTMLButtonElement>('[data-border-state]');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        fieldset.classList.remove('idle', 'pending', 'success', 'error');
        fieldset.classList.add(button.dataset.borderState!);
        buttons.forEach((b) => b.classList.toggle('active', b === button));
      });
    });
  });
</script>
