---
/**
 * Rubber-stamp WIP overlay for unfinished demo pages.
 * Pointer-events none so the page stays readable / scannable.
 */
type Props = {
  label?: string;
};

const { label = 'WIP' } = Astro.props;
---

<div class="wip-stamp" aria-hidden="true">
  <span class="wip-stamp__mark">
    <span class="wip-stamp__ring">
      <span class="wip-stamp__text">{label}</span>
      <span class="wip-stamp__sub">In progress</span>
    </span>
  </span>
</div>

<style lang="scss">
.wip-stamp {
  position: absolute;
  inset: 0;
  z-index: 8;
  display: grid;
  place-items: center;
  pointer-events: none;
  overflow: hidden;
  background: color-mix(in oklab, #3d3d3d 32%, transparent);
}

.wip-stamp__mark {
  display: grid;
  place-items: center;
  rotate: -18deg;
  opacity: 0.88;
  filter: drop-shadow(0 1px 0 color-mix(in oklab, #5a1a14 35%, transparent));
}

.wip-stamp__ring {
  display: grid;
  justify-items: center;
  gap: 0.15rem;
  padding: 0.55rem 1.1rem 0.65rem;
  border: 0.22rem solid #b33a2b;
  border-radius: 0.35rem;
  outline: 0.1rem solid color-mix(in oklab, #b33a2b 55%, transparent);
  outline-offset: 0.28rem;
  color: #b33a2b;
  background: color-mix(in oklab, #fff 55%, #b33a2b 8%);
  box-shadow:
    inset 0 0 0 0.06rem color-mix(in oklab, #b33a2b 40%, transparent),
    0 0 0 0.04rem color-mix(in oklab, #fff 40%, transparent);
  // Slight ink bleed / imperfect stamp
  mask-image: radial-gradient(ellipse 95% 90% at 50% 48%, #000 72%, transparent 100%);
}

.wip-stamp__text {
  font-family: 'Courier New', Courier, ui-monospace, monospace;
  font-size: clamp(2.4rem, 8cqi, 4.2rem);
  font-weight: 900;
  letter-spacing: 0.18em;
  line-height: 1;
  text-indent: 0.18em;
  text-transform: uppercase;
}

.wip-stamp__sub {
  font-family: 'Courier New', Courier, ui-monospace, monospace;
  font-size: clamp(0.55rem, 1.8cqi, 0.78rem);
  font-weight: 700;
  letter-spacing: 0.42em;
  text-indent: 0.42em;
  text-transform: uppercase;
  opacity: 0.9;
}
</style>
