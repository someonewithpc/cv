---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';

import DragDropScene from './MockScene/DragDropScene.astro';
import HandoffLayer from './layers/HandoffLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

// The same scene the Space Builder stack runs — this demo imports it rather than
// carrying its own copy, so the title block quotes the same number.
const srcRoot = path.join(process.cwd(), 'src');
const sceneEntry = path.join(
  srcRoot,
  'components/SpaceBuilderDemo/MockScene/scene/SpaceBuilderScene.ts',
);

const { outputFiles: [sceneBundle] } = await esbuild.build({
  entryPoints: [sceneEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  packages: 'external',
  alias: { '@': srcRoot },
});

const sceneSize = toKiB(sceneBundle.text);

const layers = {
  main: { name: null },
  handoff: { name: 'Picture to Model', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<div class="drag-drop-demo">
<TechnicalDrawingStack
  subtitle="Space Builder · Drag & Drop"
  scale="1:1"
  size={sceneSize}
  date="2023"
  tech={['vuejs', 'threejs']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      main: <DragDropScene />,
      handoff: <HandoffLayer />,
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
</div>

<style lang="scss">
// The title block is absolutely placed in the sheet's bottom-right corner, over the artwork.
// The handoff sheet ends above it, and the live sheet's catalog does.
:global(.drag-drop-demo article.technical-drawing-stack > * > section) {
  --title-block-reach: var(--title-block-block);
}

// Portrait gives the block a row of its own, so the reach goes back to 0 and nothing moves.
// The query is the one Page.astro moves the block with, not the sheet's orientation
// attribute: the two disagree while the stack's max-height clamps its 3/5 aspect, which is
// every window between about 580 and 640 wide.
@container technical-drawing (orientation: portrait) {
  :global(.drag-drop-demo article.technical-drawing-stack > * > section) {
    --title-block-reach: 0px;
  }
}

// The handoff page carries its own words, so it has no note and no column to keep for one:
// the explainer takes all three, and only the block's corner is spoken for. The empty note
// cell goes with them, or auto-placement drops it into a second row and the sheet splits
// its spare height between that row and the artwork's instead of centring the explainer.
// The cell also takes its whole height rather than shrinking onto the plate: the frames
// size themselves off the room they are given, and a cell that fits the plate would hand
// back the height they are trying to grow into.
:global(.drag-drop-demo article.technical-drawing-stack > * > section.blueprint .content) {
  grid-column: 1 / -1;
  height: 100%;
  padding-bottom: var(--title-block-reach, 0px);
}

// And the row has to be a measured one for that height to mean anything. The sheet's own
// row is auto, sized by whatever the cell asks for, and a percentage inside an auto row
// resolves to nothing: the frames would fall back to their natural size and, on a short
// sheet, run past the title block. Portrait already gives the artwork a row of its own
// above the block's, so only the wide sheets need this.
@container technical-drawing (orientation: landscape) {
  :global(.drag-drop-demo article.technical-drawing-stack > * > section.blueprint) {
    grid-template-rows: minmax(0, 1fr);
  }
}

:global(.drag-drop-demo article.technical-drawing-stack > * > section.blueprint .aside) {
  display: none;
}

// The live sheet's app runs under the title block, as the Space Builder's does. The catalog
// takes the block's width and stops above it, so the two share an edge and the ground has
// the rest.
@container technical-drawing not (orientation: portrait) {
  :global(.drag-drop-demo article.technical-drawing-stack > * > section:not(.blueprint) .drag-drop-scene-app) {
    grid-template-columns: minmax(0, 1fr) calc(var(--title-block-inline) - var(--demo-pad));
  }

  :global(.drag-drop-demo article.technical-drawing-stack > * > section:not(.blueprint) .drag-drop-scene-app .sidebar) {
    margin-bottom: calc(var(--title-block-reach) - var(--demo-pad));
  }
}
</style>
