---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';

import DragDropScene from './MockScene/DragDropScene.astro';
import HandoffLayer from './layers/HandoffLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

// The same scene the Space Builder stack runs — this demo imports it rather than
// carrying its own copy, so the title block quotes the same number.
const srcRoot = path.join(process.cwd(), 'src');
const sceneEntry = path.join(
  srcRoot,
  'components/SpaceBuilderDemo/MockScene/scene/SpaceBuilderScene.ts',
);

const { outputFiles: [sceneBundle] } = await esbuild.build({
  entryPoints: [sceneEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  packages: 'external',
  alias: { '@': srcRoot },
});

const sceneSize = toKiB(sceneBundle.text);

const layers = {
  main: { name: null },
  handoff: { name: 'Picture to Model', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<div class="drag-drop-demo">
<TechnicalDrawingStack
  subtitle="Space Builder · Drag & Drop"
  scale="1:1"
  size={sceneSize}
  date="2023"
  tech={['vuejs', 'threejs']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      main: <DragDropScene />,
      handoff: <HandoffLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      main: (
        <PostIt background="#fed" color="black">
          Hover to take over. Drag a card onto the floor, or double-click one and click where
          it goes. Drag the ground to orbit
        </PostIt>
      ),
      handoff: (
        <PostIt background="#cde" color="black">
          Where the pointer is decides what follows it
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
</div>

<style lang="scss">
// The title block is absolutely placed in the sheet's bottom-right corner, over the artwork
// column and the note's column both. That corner is the block's: the demo and the note end
// above it rather than running under its lettering.
:global(.drag-drop-demo article.technical-drawing-stack > * > section) {
  --title-block-reach: var(--title-block-block);
}

// Portrait gives the block a row of its own, so the reach goes back to 0 and nothing moves.
// The query is the one Page.astro moves the block with, not the sheet's orientation
// attribute: the two disagree while the stack's max-height clamps its 3/5 aspect, which is
// every window between about 580 and 640 wide.
@container technical-drawing (orientation: portrait) {
  :global(.drag-drop-demo article.technical-drawing-stack > * > section) {
    --title-block-reach: 0px;
  }
}

// Regular (non-portrait) layout only — reserve a gutter next to the demo content and
// centre the PostIt in whatever space is left, the same way the Space Builder stack does.
// The note is centred in its column, so a bottom margin — not padding, which would leave the
// column's own box reaching into the corner — lifts it by half of the block's height.
:global(.drag-drop-demo article.technical-drawing-stack > * > section .aside) {
  display: flex;
  justify-content: center;
  padding-left: 1.75em;
  margin-inline: 0;
  margin-bottom: var(--title-block-reach, 0px);
}

@container technical-drawing (orientation: portrait) {
  /* Portrait centres the aside itself; only the landscape gutter has to go. */
  :global(.drag-drop-demo article.technical-drawing-stack > * > section .aside) {
    padding-left: 0;
  }
}

// Narrow but still landscape (a squeezed window, short of the portrait breakpoint): the
// interactive page's aside column would otherwise reserve a third of the sheet for a note
// a few characters wide, starving the 3D viewport next to it. The static blueprint pages
// keep the even three-column split.
@container technical-drawing-width (min-width: 40.0625em) and (max-width: 64em) {
  :global(.drag-drop-demo article.technical-drawing-stack > * > section:not(.blueprint)) {
    grid-template-columns: minmax(0, 1fr) minmax(0, 11rem);
  }

  :global(.drag-drop-demo article.technical-drawing-stack > * > section:not(.blueprint) .content) {
    grid-column: 1;
  }

  :global(.drag-drop-demo article.technical-drawing-stack > * > section:not(.blueprint) .aside) {
    grid-column: 2;
    padding-left: 0.75em;
  }
}
</style>
