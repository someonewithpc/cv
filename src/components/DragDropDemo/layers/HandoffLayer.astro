---
/**
 * The drag route, in four frames of the demo itself (public/demos/drag-drop/handoff-*.webp,
 * made by scripts/capture-handoff-frames.mjs). What each frame shows is what the code
 * does: the press on a card arms a drag and the first move starts it (DragDropSceneApp.vue
 * onItemPointerdown, startItemDrag; the product's ObjectDrag.vue dragStart); while the
 * pointer is over the sidebar the card's own <img> rides it at its rendered size, grabbed
 * where the press landed, and the card stays put (dragThumbFrom, updateDragVisual; the
 * product's draggedElement); the moment the point is inside the canvas rect the picture is
 * dropped and the scene's ghost, the loaded chair mesh itself, is put on the floor under the
 * pointer (updateDragVisual, SpaceBuilderScene.setGhostAt; the product's Scene.vue dragEnter
 * hides the picture and create.start('single')); the release places one object and selects
 * it, and the tool is back to idle (endItemDrag, dropOne, placeGhostAsSingle; the product's
 * drop).
 *
 * Each callout aims at a mark, an empty positioned element at the thing's place in its
 * frame, so the label can sit over the frame's empty canvas without lying over its target.
 * The marks' positions are fractions of the frame, off the pointer path the capture script
 * drives; the authored tips are the same places on a two-by-two strip, for the no-script
 * drawing. The crop leaves the canvas a little over half of each frame (CANVAS_FRACTION),
 * which is room for a whole label, so the angles and lengths lay each one on that half,
 * tail included, and off the catalog cards beside it.
 *
 * One set of angles and lengths holds at every sheet size: the strip is wider than it is
 * tall whatever caps it, so the overlay's unit is half its height, which is one frame, and
 * a frame is always 1 unit tall by 1.8 wide.
 *
 * Two frames to a row at every sheet size: four high on a phone would leave the strip
 * taller than the sheet, and fitting it back would only shrink the frames again.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

const FRAME = { width: 1731, height: 960 };
/** The canvas's share of a frame's width, the fraction the capture script prints. */
const CANVAS_FRACTION = 0.515;
const FONT = 0.08;
/** Thinner than the default: the frames are photographs, and the arrows cross them. */
const STROKE = 0.013;

type Frame = {
  id: string;
  alt: string;
  /** Where the thing the callout names sits in the frame, as fractions of it. */
  mark: [number, number];
};

const frames: Frame[] = [
  { id: 'press', alt: 'The pointer dragging the chair card out of the catalog', mark: [0.64, 0.31] },
  { id: 'picture', alt: 'The chair picture riding the pointer over the catalog', mark: [0.59, 0.53] },
  { id: 'model', alt: 'The chair model under the pointer at the edge of the floor', mark: [0.43, 0.74] },
  { id: 'placed', alt: 'The chair placed on the floor with its selection highlight', mark: [0.36, 0.77] },
];
---

<div class="wrapper">
  <div class="handoff-layer" data-handoff-layer>
    <div class="panel">
      <header>
        <strong>Picture over the catalog, model over the floor</strong>
      </header>

      <Annotations reach={1} fontSize={FONT} strokeWidth={STROKE}>
        <div class="strip" slot="content" data-handoff-strip data-canvas-fraction={CANVAS_FRACTION}>
          {frames.map((frame, index) => (
            <figure class="frame" data-frame={frame.id}>
              <img
                src={`/demos/drag-drop/handoff-${index + 1}.webp`}
                alt={frame.alt}
                width={FRAME.width}
                height={FRAME.height}
                loading="lazy"
                decoding="async"
              />
              <span
                class="mark"
                data-mark={frame.id}
                style={`left: ${frame.mark[0] * 100}%; top: ${frame.mark[1] * 100}%;`}
                aria-hidden="true"
              />
            </figure>
          ))}
        </div>

        <Fragment slot="annotations">
          <ArrowAnnotation target='[data-mark="press"]' tipX={-0.665} tipY={-0.69} angle={-137.9} length={0.462} text="drag the object to the viewport" lines={['drag the object', 'to the viewport']} labelSide="left" fontSize={FONT} />
          <ArrowAnnotation target='[data-mark="picture"]' tipX={1.076} tipY={-0.47} angle={151.7} length={0.232} text="over the catalog it is still a picture" lines={['over the catalog', 'it is still a picture']} labelSide="left" fontSize={FONT} />
          <ArrowAnnotation target='[data-mark="model"]' tipX={-1.04} tipY={0.74} angle={65} length={0.265} text="over the floor it becomes the model" lines={['over the floor', 'it becomes the model']} labelSide="left" fontSize={FONT} />
          <ArrowAnnotation target='[data-mark="placed"]' tipX={0.665} tipY={0.77} angle={50.4} length={0.325} text="let go and it is placed" lines={['let go', 'and it is placed']} labelSide="left" fontSize={FONT} />
        </Fragment>
      </Annotations>
    </div>
  </div>
</div>

<style lang="scss">
.wrapper {
  box-sizing: border-box;
  width: 100%;
  margin-inline: auto;
  display: grid;
  place-items: center;

  // A landscape sheet gives the artwork two of its three columns and keeps the third for
  // the note and the title block. An auto track grows to whatever the strip asks for, and
  // the panel's `max-width: 100%` then measures that track instead of the column, so the
  // panel ran under both. A 1fr track is the column, and the cap bites again.
  :global([data-sheet-orientation='landscape']) & {
    grid-template-columns: minmax(0, 1fr);
  }
}

.handoff-layer {
  box-sizing: border-box;
  width: 100%;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  color: var(--ink);

  :global([data-sheet-orientation='portrait']) & {
    font-size: min(1rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)));
  }
}

.panel {
  box-sizing: border-box;
  width: fit-content;
  max-width: 100%;
  margin-inline: auto;
  padding: 0.75em 0.875em;
  border: 1px solid var(--line-strong);
  border-radius: 0.5em;
  background: var(--surface-raised);
  display: grid;
  gap: 0.625em;

  // The Annotations wrapper is this grid's item, and a grid item's own minimum size is the
  // strip's authored width, so the strip carried the panel past its cap instead of being
  // held by it. Portrait caps the wrapper itself, at 92cqw, and keeps that.
  :global([data-sheet-orientation='landscape']) & > :global(*) {
    min-width: 0;
  }
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.125em;

  strong {
    font-size: 0.875em;
  }
}

// Four fifths of the sheet's height is as tall as the panel can stand inside the mat once
// the title has its line. Every sheet so far runs out of width first, so `max-width` sizes
// the strip and the height only holds it to its own aspect on a sheet wide enough to
// outgrow it. The gap is the same fraction of the strip's width on both axes, so the strip
// keeps the frames' aspect and the callouts' authored tips hold.
.strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25%;
  width: calc(0.8 * var(--sheet-block) * 1731 / 960);
  max-width: 100%;
}

.frame {
  position: relative;
  margin: 0;
  min-width: 0;

  img {
    display: block;
    width: 100%;
    height: auto;
    box-sizing: border-box;
    border: 1px solid var(--line-strong);
    border-radius: 0.1875em;
  }
}

.mark {
  position: absolute;
  width: 0;
  height: 0;
}
</style>
