---
/**
 * The drag route, in four frames of the demo itself (public/demos/drag-drop/handoff-*.webp,
 * made by scripts/capture-handoff-frames.mjs). What each frame shows is what the code
 * does: the press on a card arms a drag and the first move starts it (DragDropSceneApp.vue
 * onItemPointerdown, startItemDrag; the product's ObjectDrag.vue dragStart); while the
 * pointer is over the sidebar the card's own <img> rides it at its rendered size, grabbed
 * where the press landed, and the card stays put (dragThumbFrom, updateDragVisual; the
 * product's draggedElement); the moment the point is inside the canvas rect the picture is
 * dropped and the scene's ghost, the loaded chair mesh itself, is put on the floor under the
 * pointer (updateDragVisual, SpaceBuilderScene.setGhostAt; the product's Scene.vue dragEnter
 * hides the picture and create.start('single')); the release places one object and selects
 * it, and the tool is back to idle (endItemDrag, dropOne, placeGhostAsSingle; the product's
 * drop).
 *
 * The frames run in one row across a sheet wider than it is tall, and two by two on a phone,
 * where a row of four would leave each frame a sliver. Each caption is set under its own
 * frame. They were leader-line callouts laid inside the frames until the row of four, which
 * cannot hold one: four frames across a 960px sheet are 217px wide, and the overlay sizes
 * its type off the strip's height, so a label inside one came out 5px tall.
 */

const FRAME = { width: 1731, height: 960 };

type Frame = {
  id: string;
  alt: string;
  /** Reads in drag order, left to right. */
  caption: string;
};

const frames: Frame[] = [
  {
    id: 'press',
    alt: 'The pointer dragging the chair card out of the catalog',
    caption: 'drag the object to the viewport',
  },
  {
    id: 'picture',
    alt: 'The chair picture riding the pointer over the catalog',
    caption: 'over the catalog it is still a picture',
  },
  {
    id: 'model',
    alt: 'The chair model under the pointer at the edge of the floor',
    caption: 'over the floor it becomes the model',
  },
  {
    id: 'placed',
    alt: 'The chair placed on the floor with its selection highlight',
    caption: 'let go and it is placed',
  },
];
---

<div class="wrapper">
  <div class="handoff-layer" data-handoff-layer>
    <div class="panel">
      <header>
        <strong>Picture over the catalog, model over the floor</strong>
        <p class="note">
          Four moments of one drag: the card's picture follows the pointer, the model takes
          over the moment the pointer crosses onto the floor, and letting go places it.
        </p>
      </header>

      <div class="strip" data-handoff-strip>
        {frames.map((frame, index) => (
          <figure class="frame" data-frame={frame.id}>
            <img
              src={`/demos/drag-drop/handoff-${index + 1}.webp`}
              alt={frame.alt}
              width={FRAME.width}
              height={FRAME.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{frame.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</div>

<style lang="scss">
.wrapper {
  box-sizing: border-box;
  width: 100%;
}

.handoff-layer {
  box-sizing: border-box;
  width: 100%;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  color: var(--ink);

  :global([data-sheet-orientation='portrait']) & {
    font-size: min(1rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)));
  }
}

// This page keeps no column for a note, so the panel takes the whole width the sheet gives
// the artwork and the frames grow with it.
.panel {
  box-sizing: border-box;
  width: 100%;
  padding: 1em;
  border: 1px solid var(--line-strong);
  border-radius: 0.5em;
  background: var(--surface-raised);
  display: grid;
  gap: 1em;
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.25em;

  /* A floor in rem under the sheet's own scale, here and on the two kinds of small text
     below: a phone sheet letters the panel at 8px, which is under any of them. */
  strong {
    font-size: max(0.8125rem, 1.125em);
  }
}

.note {
  margin: 0;
  /* Two rows at every sheet size: one 900px line is more than an eye tracks back across
     on a wide sheet, and a third row is height a short sheet has not got. */
  max-width: 92ch;
  font-size: max(0.6875rem, 0.9375em);
  line-height: 1.4;
  color: var(--ink-muted);
  text-wrap: pretty;
}

/* One row of four, and two by two only where the sheet really is taller than it is wide.
   The query is the one that moves the title block and the note, rather than the sheet's
   orientation attribute, which reads portrait for a few window widths where the sheet is
   still laid out across. */
.strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.875em;

  @container technical-drawing (orientation: portrait) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.frame {
  margin: 0;
  min-width: 0;
  display: grid;
  gap: 0.375em;
  align-content: start;

  img {
    display: block;
    width: 100%;
    height: auto;
    box-sizing: border-box;
    border: 1px solid var(--line-strong);
    border-radius: 0.1875em;
  }
}

figcaption {
  font-size: max(0.6875rem, 0.9375em);
  line-height: 1.3;
  text-wrap: pretty;
}
</style>
