---
const races = [
  {
    id: 'loaded',
    title: 'Model arrives first',
    steps: ['press', 'GLB in', 'model on pointer', 'let go'],
    result: 'places one',
    toast: 'Chair placed',
    ok: true,
  },
  {
    id: 'racing',
    title: 'Drop arrives first',
    steps: ['press', 'let go', 'nothing on the pointer'],
    result: 'places nothing',
    toast: 'Still loading · pick it again',
    ok: false,
  },
] as const;
---

<div class="wrapper">
  <div class="race-layer" aria-hidden="true">
    <div class="panel">
      <header>
        <span class="eyebrow">Add tool</span>
        <strong>Drop before load</strong>
      </header>

      <div class="races">
        {races.map((race) => (
          <figure class:list={['race', race.id]}>
            <figcaption>{race.title}</figcaption>
            <div class="track">
              {race.steps.map((step, i) => (
                <Fragment>
                  {i > 0 && <span class="op" aria-hidden="true">→</span>}
                  <span class="step-chip">{step}</span>
                </Fragment>
              ))}
            </div>
            <p class="outcome">
              <code>placeGhostAsSingle()</code>
              <span class:list={['badge', { bad: !race.ok }]}>{race.result}</span>
            </p>
            <p class="toast-line">{race.toast}</p>
          </figure>
        ))}
      </div>

      <p class="note">
        What follows the pointer over the floor is the model itself, not a stand-in. Let go
        before its file arrives and there is nothing to place, so the call returns false.
      </p>
      <p class="note">
        Only a drag can lose this race. A double-click holds a spinner over the page until
        the file is in, so it always has something to put down. A drag starts the download
        and does not wait for it. Space Builder says nothing when the drop comes first. This
        demo toasts, so you can tell a miss from a drop that worked.
      </p>
    </div>
  </div>
</div>

<style lang="scss">
$accent: #89ab24;
$warn: #d98b2b;

.wrapper {
  box-sizing: border-box;
  width: max-content;
  max-width: min(90cqw, 100%);
  margin-inline: auto;
  position: relative;
  display: grid;
  place-items: center;
}

.race-layer {
  width: max-content;
  max-width: 100%;
  display: grid;
  place-items: center;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.8rem, 0.024 * min(var(--sheet-inline), var(--sheet-block)), 1.05rem);
  color: #f4f0ea;

  /* See PathsLayer: the clamp floor is what pushes a portrait sheet off the top. */
  :global([data-sheet-orientation='portrait']) & {
    font-size: min(1.05rem, 0.024 * min(var(--sheet-inline), var(--sheet-block)));
  }
}

.panel {
  box-sizing: border-box;
  width: max-content;
  max-width: 100%;
  padding: 0.6em 0.65em;
  background: #333;
  border: 2px solid #666;
  border-radius: 0.5em;
  display: grid;
  gap: 0.45em;
  box-shadow: 0 0.3rem 0.8rem color-mix(in oklab, #000 28%, transparent);
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.08em;

  .eyebrow {
    font-size: 0.72em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }
}

.races {
  display: grid;
  gap: 0.35em;
  width: max-content;
  max-width: 100%;
}

.race {
  margin: 0;
  display: grid;
  gap: 0.25em;
  padding: 0.35em 0.45em;
  border-radius: 0.3em;
  border: 1px dashed color-mix(in oklab, #fff 22%, transparent);
  background: color-mix(in oklab, #000 22%, transparent);
  box-sizing: border-box;

  figcaption {
    font-size: 0.7em;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  &.loaded {
    border-style: solid;
    border-color: $accent;
    border-width: 2px;
    background: color-mix(in oklab, $accent 14%, transparent);

    figcaption {
      color: #e8f5b8;
      opacity: 1;
    }
  }

  &.racing {
    border-color: color-mix(in oklab, $warn 65%, transparent);
  }
}

.track {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.25em;
}

.op {
  display: grid;
  place-items: center;
  opacity: 0.55;
  font-size: 0.95em;
  line-height: 1;
}

.step-chip {
  display: inline-grid;
  place-items: center;
  padding: 0.28em 0.4em;
  border-radius: 0.22em;
  border: 1px solid #555;
  background: color-mix(in oklab, #000 22%, transparent);
  font-size: 0.72em;
  line-height: 1.2;
  color: #e8e4dc;
  white-space: nowrap;
}

.outcome {
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3em;

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72em;
    color: #c5e06a;
  }
}

.badge {
  display: inline-grid;
  place-items: center;
  padding: 0.28em 0.45em;
  border-radius: 0.22em;
  background: color-mix(in oklab, $accent 40%, #333);
  color: #e8f5b8;
  font-size: 0.7em;
  font-weight: 600;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  white-space: nowrap;

  &.bad {
    background: color-mix(in oklab, $warn 40%, #333);
    color: #ffe9cc;
  }
}

.toast-line {
  margin: 0;
  justify-self: start;
  padding: 0.25em 0.5em;
  border-radius: 0.22em;
  background: rgba(26, 179, 148, 0.92);
  color: #fff;
  font-size: 0.68em;
  font-weight: 600;
}

.note {
  // Stay inside the tracks' intrinsic width, don't widen the panel.
  width: 0;
  min-width: 100%;
  margin: 0;
  padding: 0.4em 0.45em;
  border-radius: 0.3em;
  border: 1px solid #555;
  background: #2a2a28;
  box-sizing: border-box;
  font-size: 0.75em;
  line-height: 1.3;
  opacity: 0.85;
  text-wrap: balance;
}

@container technical-drawing (orientation: portrait) {
  .wrapper {
    max-width: min(90cqw, 100%);
  }

  .races {
    width: 100%;
  }
}
</style>
