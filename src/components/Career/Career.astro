        </dd>
      </div>

      <div class="cell">
        <dt class="monospace"><small lang="ja">ばしょ</small>Location</dt>
        <dd><span class="typewriter">{location}</span></dd>
      </div>

      <div class="cell">
        <dt class="monospace"><small lang="ja">すきなこと</small>Interests</dt>
        <dd><span>{interests.join(', ')}</span></dd>
