---
/**
 * The CV proper, drawn the way a sheet records its own history: the roles are the rows of a
 * revision table, oldest revision first by number and newest at the top, and the rest of the
 * CV (degree, languages, where Hugo is, what else he does) fills title block cells beside it.
 * Everything on the sheet comes from site.json; the skills and the upstream work have sheets
 * of their own and are only referred to from here.
 */
import SectionHeader from '@/components/SectionHeader.astro';

import site from './site.json';

type Edge = { date: string; label: string };
type Link = { label: string; href: string };
type Entry = {
  id: string;
  org: string;
  place?: string;
  role?: string;
  from: Edge;
  to: Edge;
  summary?: string;
  items?: string[];
  see?: Link[];
};

const { experience, education, learning, tagline, languages, location, interests, refs } = site as typeof site & { experience: Entry[] };

/* Revisions count up from the first job, so the newest row, listed first, carries the highest number. */
const revision = (index: number) => String(experience.length - index).padStart(2, '0');

/* Under the table, the same jobs drawn as an elevation: the years run along a dimension string
   under the ground line, every job is a bar as long as it lasted, standing on the ground or
   stacked over a bar it overlapped, with its own dimension over it and a leader from its
   revision number. The degree is an outline bar in the lowest lane, under the jobs of those
   years. Under everything, on the ground, runs the continuous learning line, from the year
   Hugo started coding and still going, so it ends in an arrow instead of a tick. Wide, time runs left to right; under 44rem of sheet the drawing stands on
   end and time flows down the page, oldest at the top, so the labels get the sheet's width. */

/* A date as a fraction of a year. A bare year whose label says "Summer" is June to September. */
const at = (edge: Edge, end = false): number => {
  const [year, month] = edge.date.split('-').map(Number);
  if (month) return year + (end ? month : month - 1) / 12;
  if (edge.label.startsWith('Summer')) return year + (end ? 0.7 : 0.45);
  return year + (end ? 1 : 0);
};

type Job = Entry & {
  n: string;
  study?: boolean;
  open?: boolean;
  start: number;
  end: number;
  seasonal: boolean;
  span: string;
  lane: number;
  /* Where along the bar a leader may land, as fractions of its length, best first. */
  anchors: number[];
  lines: string[];
};

const jobs: Job[] = experience
  .map((entry, index) => {
    const start = at(entry.from);
    const end = at(entry.to, true);
    const seasonal = entry.from.label.startsWith('Summer');
    const months = Math.round((end - start) * 12);
    const span = seasonal
      ? `${Number(entry.to.date) - Number(entry.from.date) + 1} summers`
      : [months >= 12 && `${Math.floor(months / 12)}y`, months % 12 && `${months % 12}m`].filter(Boolean).join(' ');
    const org = entry.place ? `${entry.org}, ${entry.place}` : entry.org;
    const lines = entry.role ? [entry.role, org] : [org];
    return { ...entry, start, end, seasonal, span, lines, n: revision(index), lane: 0, anchors: [] };
  })
  .sort((a, b) => a.start - b.start);

/* The degree goes first, so it takes the ground lane and the jobs of those years stand on it.
   Its dates are bare years, drawn as whole years to line up with the axis's year labels. */
jobs.unshift({
  id: 'education',
  org: education.school,
  role: education.degree,
  from: { date: education.from, label: education.from },
  to: { date: education.year, label: education.year },
  summary: '',
  n: 'B',
  study: true,
  start: Number(education.from),
  end: Number(education.year) + 1,
  seasonal: false,
  span: `${education.from} to ${education.year}`,
  lane: 0,
  anchors: [],
  lines: [education.degree, `${education.minor}, ${education.short}`],
});

/* Lanes: where two bars overlap, the one that started later sits lower. The degree keeps the
   lowest lane; then, latest start first, each job goes one lane above the highest bar it
   overlaps. */
const CLEAR = 0.15;
const overlaps = (a: Job, b: Job) => a.start < b.end + CLEAR && b.start < a.end + CLEAR;
{
  const stacked = [jobs[0]];
  for (const job of jobs.slice(1).sort((a, b) => b.start - a.start)) {
    job.lane = Math.max(-1, ...stacked.filter((other) => overlaps(other, job)).map((other) => other.lane)) + 1;
    stacked.push(job);
  }
}

/* A seasonal job breaks off midway through each winter between its summers. */
const breaks = (job: Job) =>
  job.seasonal ? Array.from({ length: Number(job.to.date) - Number(job.from.date) }, (_, i) => Number(job.from.date) + i + 1.075) : [];

const ANCHORS = [0.3, 0.7, 0.5, 0.15, 0.85];
const MARGIN = 0.12;
const above = (job: Job) => jobs.filter((other) => other.lane > job.lane && other.start - MARGIN <= job.end && job.start <= other.end + MARGIN);
const covered = (job: Job, t: number) => above(job).some((other) => other.start - MARGIN <= t && t <= other.end + MARGIN);
for (const job of jobs) {
  job.anchors = ANCHORS.map((f) => job.start + f * (job.end - job.start))
    .filter((t) => !covered(job, t) && breaks(job).every((b) => Math.abs(t - b) > 0.3))
    .map((t) => (t - job.start) / (job.end - job.start));
}
const lanes = Math.max(...jobs.map((job) => job.lane)) + 1;

/* A bar with no clear anchor lies wholly under the bars over it. Its leader leaves the bar's
   end along its lane, runs out past the bars over it and turns up to its bubble there. These
   are the times it may turn at, nearest the bar first; `margin` is how far it keeps from any
   bar over it, in years. */
const elbows = (job: Job, margin: number): number[] => {
  const over = jobs.filter((other) => other.lane > job.lane);
  const beside = jobs.filter((other) => other !== job && other.lane === job.lane);
  const blocked = (t: number) => over.some((other) => other.start - margin < t && t < other.end + margin);
  const turns: { t: number; far: number }[] = [];
  for (const dir of [-1, 1]) {
    const end = dir < 0 ? job.start : job.end;
    let t = end + dir * margin;
    for (let other; (other = over.find((o) => o.start - margin < t && t < o.end + margin)); ) t = (dir < 0 ? other.start : other.end) + dir * margin;
    for (let step = 0; step <= 10; step += 1, t += dir * 0.1) {
      const [from, to] = dir < 0 ? [t, end] : [end, t];
      if (t < T0 || t > T1 || blocked(t) || beside.some((other) => other.start - margin < to && from < other.end + margin)) break;
      turns.push({ t, far: Math.abs(t - end) });
    }
  }
  return turns.sort((a, b) => a.far - b.far).map(({ t }) => t);
};

/* The learning line has not ended: it runs to the day of the build. */
const today = new Date();
const NOW = today.getFullYear() + (today.getMonth() + (today.getDate() - 1) / 31) / 12;

/* It lies under every lane, so its anchor is any point before the first job. Placed first,
   it takes the lowest label row. */
jobs.unshift({
  id: 'learning',
  org: learning.label,
  from: { date: learning.from, label: learning.from },
  to: { date: '', label: 'now' },
  summary: '',
  n: 'A',
  open: true,
  start: Number(learning.from),
  end: NOW,
  seasonal: false,
  span: `since ${learning.from}`,
  lane: -1,
  anchors: [],
  lines: [learning.label],
});
{
  const first = Math.min(...jobs.filter((job) => !job.open).map((job) => job.start));
  const learner = jobs[0];
  learner.anchors = ANCHORS.filter((f) => learner.start + f * (learner.end - learner.start) < first - MARGIN - 0.2);
}

const T0 = Number(learning.from);
const T1 = Math.floor(NOW) + 1;
const years = Array.from({ length: T1 - T0 }, (_, i) => T0 + i);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/* Width of a monospace character at the drawing's 12 unit size. */
const CH = 7.2;

/* Word wrap by character count: the drawing cannot measure its text at build time. */
const wrap = (text: string, width: number): string[] => {
  const lines: string[] = [];
  for (const word of text.split(' ')) {
    const last = lines[lines.length - 1];
    if (last !== undefined && `${last} ${word}`.length <= width) lines[lines.length - 1] = `${last} ${word}`;
    else lines.push(word);
  }
  return lines;
};

const text = (x: number, y: number, s: string, cls = '', extra = '') =>
  `<text x="${x}" y="${y}" class="${cls}" ${extra}>${esc(s)}</text>`;

/* Sizes are in drawing units, so they scale with the drawing: 12 for all lettering, set on the
   svg, and 13 for the first line of a label. */
const lettering = (x: number, y: number, s: string, first: boolean) =>
  first ? text(x, y, s, 'label typewriter', 'font-size="13"') : text(x, y, s, 'small monospace');

/* An architectural tick: a short stroke through the dimension line at 45 degrees. */
const tick = (x: number, y: number) => `<path class="tick" d="M${x - 3.5} ${y + 3.5} l7 -7"/>`;

const defs = (id: string) =>
  `<defs>
    <pattern id="${id}-hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
      <line class="hatch-line" x1="0" y1="0" x2="0" y2="6"/>
    </pattern>
    <pattern id="${id}-cut" patternUnits="userSpaceOnUse" width="3" height="3" patternTransform="rotate(-45)">
      <line class="hatch-line" x1="0" y1="0" x2="0" y2="3"/>
    </pattern>
    <pattern id="${id}-earth" patternUnits="userSpaceOnUse" width="7" height="7" patternTransform="rotate(-45)">
      <line class="earth-line" x1="0" y1="0" x2="0" y2="7"/>
    </pattern>
    <marker id="${id}-arrow" viewBox="0 0 8 8" refX="7.5" refY="4" markerWidth="8" markerHeight="8" orient="auto">
      <path class="arrow" d="M0 0.5 L8 4 L0 7.5 z"/>
    </marker>
  </defs>`;

/* The bubble carries the job's revision number from the table, or the fixed letter given to
   the degree or the continuous learning line. */
const bubble = (x: number, y: number, job: Job) =>
  `<circle class="bubble" cx="${x}" cy="${y}" r="10"/>${text(x, y + 4, job.n, 'bubble-number monospace', 'text-anchor="middle"')}`;

const group = (job: Job) => `<g class="${job.open ? 'learning' : job.study ? 'study' : 'job'}" data-job="${job.id}" data-lane="${job.lane}">`;
/* A seasonal bar is drawn in pieces, cut at its breaks with the break for a round bar: each
   cut end is an S, out over one half of the bar and back in over the other, and the half that
   turns in shows its cut face, a lobe hatched across the bar's own hatch. The two ends of a
   break mirror each other across the gap. `pos` places a time along the bar and `pt` writes an
   (along, across) pair as x y. */
const cutBar = (job: Job, pos: (t: number) => number, c0: number, c1: number, pt: (a: number, c: number) => string, attrs: string, id: string) => {
  const dir = Math.sign(pos(job.end) - pos(job.start));
  const m = (c0 + c1) / 2;
  const k = Math.abs(c1 - c0) / 4;
  const gap = 1.8 * k;
  const ends = [pos(job.start), ...breaks(job).flatMap((t) => [pos(t) - dir * gap, pos(t) + dir * gap]), pos(job.end)];
  /* Half an S at `a`, from `from` across to `to`, bulging `out` along the bar. */
  const half = (a: number, from: number, to: number, out: number) => `C${pt(a + (4 / 3) * out, from + 0.4 * (to - from))} ${pt(a + (4 / 3) * out, to - 0.4 * (to - from))} ${pt(a, to)}`;
  const face = (a: number, from: number, to: number, out: number) => `<path class="break-face" fill="url(#${id}-cut)" d="M${pt(a, from)} ${half(a, from, to, out)} ${half(a, to, from, -out)} Z"/>`;
  const pieces = ends.length / 2;
  return Array.from({ length: pieces }, (_, i) => {
    const [a, b] = [ends[2 * i], ends[2 * i + 1]];
    const first = i === 0;
    const last = i === pieces - 1;
    const far = last ? `L${pt(b, c1)}` : `${half(b, c0, m, dir * k)} ${half(b, m, c1, -dir * k)}`;
    const near = first ? `L${pt(a, c0)}` : `${half(a, c1, m, -dir * k)} ${half(a, m, c0, dir * k)}`;
    const faces = (last ? '' : face(b, m, c1, dir * k)) + (first ? '' : face(a, m, c0, -dir * k));
    return `<path ${attrs} d="M${pt(a, c0)} L${pt(b, c0)} ${far} L${pt(a, c1)} ${near} Z"/>${faces}`;
  }).join('');
};

/* The learning line: a thin bar with an arrowhead at the present instead of an end. */
const openBar = (a0: number, ae: number, c: number, pt: (a: number, c: number) => string) => {
  const head = ae - Math.sign(ae - a0) * 9;
  const points = [pt(a0, c - 2), pt(head, c - 2), pt(head, c - 5), pt(ae, c), pt(head, c + 5), pt(head, c + 2), pt(a0, c + 2)];
  return `<path class="bar learning" d="M${points.join(' L')} Z"/>`;
};

const barClass = (job: Job) => `bar${job.seasonal ? ' seasonal' : ''}${job.study ? ' study' : ''}`;
const fill = (job: Job, id: string) => (job.study ? '' : `fill="url(#${id}-hatch)"`);

/* ----- Wide: time runs left to right. ----- */
const wide = (() => {
  const W = 960;
  const L = 28;
  const R = 24;
  const PX = (W - L - R) / (T1 - T0);
  const x = (t: number) => L + (t - T0) * PX;
  const LANE = 48;
  const BAR = 20;
  const ROW = 34;

  /* `leg` is where a bent leader runs along its lane: from its turn to the bar's end. */
  type Option = { ax: number; textEnd: number; lane: number; leg?: [number, number] };
  type Spot = Option & { row: number };
  type Placed = Job & Spot;

  /* Label rows, nearest the bars first. Two labels in a row keep clear of each other, a
     leader coming down from a higher row keeps clear of the text in the rows it passes, a
     leader coming down to a lower lane keeps clear of a bent leader's run along its lane, and
     no text runs off the sheet. The search tries one row, then two and so on, and keeps the
     first layout that fits, each label at its best anchor that allows it. */
  const options: Option[][] = jobs.map((job) => {
    const width = 25 + Math.max(...job.lines.map((line) => line.length)) * CH;
    const straight = job.anchors.map((f): Option => ({ ax: x(job.start + f * (job.end - job.start)), textEnd: 0, lane: job.lane }));
    const bent = job.anchors.length
      ? []
      : elbows(job, 0.2).map((t): Option => ({ ax: x(t), textEnd: 0, lane: job.lane, leg: [x(t), t < job.start ? x(job.start) - 1 : x(job.end) + 1] }));
    return [...straight, ...bent].filter((o) => o.ax + width <= W - 4).map((o) => ({ ...o, textEnd: o.ax + width }));
  });
  const passes = (down: Spot, bent: Spot) =>
    !!bent.leg && down.lane < bent.lane && Math.min(...bent.leg) - 8 < down.ax && down.ax < Math.max(...bent.leg) + 8;
  const clear = (a: Spot, b: Spot) => {
    if (passes(a, b) || passes(b, a)) return false;
    if (a.row === b.row) return a.textEnd + 16 <= b.ax - 10 || b.textEnd + 16 <= a.ax - 10;
    const [high, low] = a.row > b.row ? [a, b] : [b, a];
    return high.ax + 12 < low.ax - 12 || low.textEnd + 4 < high.ax - 12;
  };
  const search = (rows: number, chosen: Spot[]): Spot[] | undefined => {
    if (chosen.length === jobs.length) return chosen;
    for (let row = 0; row < rows; row += 1) {
      for (const option of options[chosen.length]) {
        const next = { ...option, row };
        if (!chosen.every((other) => clear(other, next))) continue;
        const found = search(rows, [...chosen, next]);
        if (found) return found;
      }
    }
    return undefined;
  };
  let layout: Spot[] | undefined;
  for (let rows = 1; !layout; rows += 1) {
    if (rows > jobs.length) throw new Error('Career elevation: no label layout keeps every leader clear');
    layout = search(rows, []);
  }
  const placed: Placed[] = jobs.map((job, i) => ({ ...job, ...layout![i] }));
  const rows = Math.max(...placed.map((job) => job.row)) + 1;

  const TOP = 8;
  const rowY = (row: number) => TOP + 17 + (rows - 1 - row) * ROW;
  const lanesTop = TOP + rows * ROW + 8;
  const BASE = 36;
  const G = lanesTop + BASE + lanes * LANE;
  /* The learning line lies on the ground and the lanes stand on it. */
  const LY = G - 7;
  const barTop = (lane: number) => (lane < 0 ? LY - 2 : G - BASE - lane * LANE - BAR);

  const bars = placed.map((job) => {
    const x0 = x(job.start);
    const x1 = x(job.end);
    const top = barTop(job.lane);
    const dim = top - 12;
    const by = rowY(job.row);
    /* The span sits mid-bar unless the leader lands there, then beside the leader. */
    const half = (job.span.length * CH) / 2 + 8;
    let mid = (x0 + x1) / 2;
    if (!job.leg && Math.abs(job.ax - mid) < half) mid = job.ax + (job.ax - x0 > x1 - job.ax ? -half : half);
    /* A leader points at its bar's dimension line. A bent one turns once, at a right angle, and
       meets the bar's end at half its height instead. */
    const leader = job.leg ? `${job.ax} ${by + 10} ${job.ax} ${top + BAR / 2} ${job.leg[1]} ${top + BAR / 2}` : `${job.ax} ${by + 10} ${job.ax} ${dim}`;
    const shape = job.open
      ? openBar(x0, x1, LY, (a, c) => `${a} ${c}`)
      : job.seasonal
        ? cutBar(job, x, top, top + BAR, (a, c) => `${a} ${c}`, `class="${barClass(job)}" ${fill(job, 'h')}`, 'h')
        : `<rect class="${barClass(job)}" x="${x0}" y="${top}" width="${x1 - x0}" height="${BAR}" ${fill(job, 'h')}/>`;
    return `${group(job)}
      ${shape}
      ${job.study ? `<line class="centre" x1="${x0 + 4}" y1="${top + BAR / 2}" x2="${x1 - 4}" y2="${top + BAR / 2}"/>` : ''}
      <line class="ext" x1="${x0}" y1="${top - 3}" x2="${x0}" y2="${dim - 5}"/>
      ${job.open ? '' : `<line class="ext" x1="${x1}" y1="${top - 3}" x2="${x1}" y2="${dim - 5}"/>`}
      <line class="dim" x1="${x0 - 4}" y1="${dim}" x2="${job.open ? x1 : x1 + 4}" y2="${dim}"/>
      ${tick(x0, dim)}${job.open ? '' : tick(x1, dim)}
      ${text(mid, dim - 4, job.span, 'span monospace', 'text-anchor="middle"')}
      <polyline class="leader" points="${leader}" marker-end="url(#h-arrow)"/>
      ${bubble(job.ax, by, job)}
      ${job.lines.map((line, i) => lettering(job.ax + 15, by + (job.lines.length === 1 ? 4 : i === 0 ? -1 : 12), line, i === 0)).join('')}
    </g>`;
  });

  const AXIS = G + 34;
  const axis = `
    <line class="ground" x1="${L - 8}" y1="${G}" x2="${W - R + 8}" y2="${G}"/>
    <rect class="earth" x="${L - 8}" y="${G}" width="${W - L - R + 16}" height="8" fill="url(#h-earth)"/>
    <line class="dim" x1="${x(T0)}" y1="${AXIS}" x2="${x(T1)}" y2="${AXIS}"/>
    ${years.map((year) => `<line class="ext" x1="${x(year)}" y1="${G + 12}" x2="${x(year)}" y2="${AXIS + 5}"/>${tick(x(year), AXIS)}${text(x(year + 0.5), AXIS + 16, String(year), 'year monospace', 'text-anchor="middle"')}`).join('')}
    <line class="ext" x1="${x(T1)}" y1="${G + 12}" x2="${x(T1)}" y2="${AXIS + 5}"/>${tick(x(T1), AXIS)}`;

  const height = AXIS + 24;
  return `<svg class="drawing wide" viewBox="0 0 ${W} ${height}" font-size="12" aria-hidden="true">
    ${defs('h')}
    ${bars.join('')}
    ${axis}
  </svg>`;
})();

/* ----- Narrow: the same drawing on end, the ground a datum down the left. ----- */
const tall = (() => {
  /* Wider than the 360 the jobs alone took: the degree's lane and the learning line's
     and the dimensions beside each lane would otherwise narrow the labels. */
  const W = 440;
  const DX = 44;
  const S = 28;
  const TOP = 12;
  const y = (t: number) => TOP + (t - T0) * S;
  /* Each lane is its bar with the bar's dimension on the side away from the datum, as the wide
     drawing has it over the bar, so a leader coming in from the labels ends on the dimension
     line and crosses nothing but the lanes above. */
  const LANE = 40;
  const BAR = 12;
  const LC = DX + 14;
  const LANE0 = LC + 28;
  /* Past the last lane each leader bends from its bubble's height to its bar's. */
  const BEND = LANE0 + (lanes - 1) * LANE + BAR + 28;
  const LX = BEND + 28;
  const width = Math.floor((W - 4 - LX - 15) / CH);

  /* A bar under others takes a bent leader: it comes in past the lanes at its turn, runs across
     to the bar's centre line and down or up it to the bar's end. A leader to a lower lane keeps
     off that run. */
  const turns = new Map(
    jobs
      .filter((job) => !job.anchors.length)
      .map((job) => {
        const t = elbows(job, 0.3)[0];
        if (t === undefined) throw new Error(`Career elevation: no way for the ${job.id} leader around the bars over it`);
        return [job.id, { t, lane: job.lane, run: t < job.start ? [t, job.start] : [job.end, t] }];
      }),
  );
  const onRun = (job: Job, t: number) => [...turns.values()].some(({ lane, run }) => job.lane < lane && run[0] - 0.3 < t && t < run[1] + 0.3);
  const anchor = (job: Job) => {
    const turn = turns.get(job.id);
    if (turn) return turn.t;
    const times = job.anchors.map((f) => job.start + f * (job.end - job.start));
    return times.find((t) => !onRun(job, t)) ?? times[0];
  };

  type Placed = Job & { ay: number; top: number; text: string[] };
  const placed: Placed[] = jobs.map((job) => ({
    ...job,
    ay: y(anchor(job)),
    top: 0,
    text: job.lines.flatMap((line) => wrap(line, width)),
  }));

  /* Labels down the right, each pushed below the one before it when the bars are closer
     together than the labels are tall. */
  let bottom = TOP;
  for (const job of [...placed].sort((a, b) => a.ay - b.ay)) {
    job.top = Math.max(job.ay - 7, bottom + 8);
    bottom = job.top + job.text.length * 14;
  }

  /* Two short jobs in one lane can have spans longer than their bars; those move apart. */
  const spanAt = new Map(placed.map((job) => [job.id, (y(job.start) + y(job.end)) / 2]));
  for (const lane of new Set(placed.map((job) => job.lane))) {
    const inLane = placed.filter((job) => job.lane === lane).sort((a, b) => spanAt.get(a.id)! - spanAt.get(b.id)!);
    for (const [i, b] of inLane.slice(1).entries()) {
      const a = inLane[i];
      const short = ((a.span.length + b.span.length) * CH) / 2 + 6 - (spanAt.get(b.id)! - spanAt.get(a.id)!);
      if (short <= 0) continue;
      spanAt.set(a.id, spanAt.get(a.id)! - short / 2);
      spanAt.set(b.id, spanAt.get(b.id)! + short / 2);
    }
  }

  /* A span keeps off the leaders that cross its lane beside the dimension line: its own, and
     those running in to a lower lane. */
  for (const job of placed) {
    const half = (job.span.length * CH) / 2 + 5;
    const mid = spanAt.get(job.id)!;
    const across = placed.filter((other) => other === job || other.lane < job.lane).map((other) => other.ay);
    const spots = [mid, ...across.flatMap((ay) => [ay - half, ay + half])].filter((at) => across.every((ay) => Math.abs(ay - at) >= half - 0.01));
    spanAt.set(job.id, spots.sort((a, b) => Math.abs(a - mid) - Math.abs(b - mid))[0] ?? mid);
  }

  const bars = placed.map((job) => {
    const x0 = job.open ? LC - 2 : LANE0 + job.lane * LANE;
    const right = job.open ? LC + 2 : x0 + BAR;
    const y0 = y(job.start);
    const y1 = y(job.end);
    const dim = right + 10;
    const mid = spanAt.get(job.id)!;
    const by = job.top + 7;
    const turn = turns.get(job.id);
    const leg = turn ? `${x0 + BAR / 2} ${job.ay} ${x0 + BAR / 2} ${turn.t < job.start ? y0 - 1 : y1 + 1}` : `${dim} ${job.ay}`;
    const shape = job.open
      ? openBar(y0, y1, LC, (a, c) => `${c} ${a}`)
      : job.seasonal
        ? cutBar(job, y, x0, x0 + BAR, (a, c) => `${c} ${a}`, `class="${barClass(job)}" ${fill(job, 'v')}`, 'v')
        : `<rect class="${barClass(job)}" x="${x0}" y="${y0}" width="${BAR}" height="${y1 - y0}" ${fill(job, 'v')}/>`;
    return `${group(job)}
      ${shape}
      ${job.study ? `<line class="centre" x1="${x0 + BAR / 2}" y1="${y0 + 4}" x2="${x0 + BAR / 2}" y2="${y1 - 4}"/>` : ''}
      <line class="ext" x1="${right + 3}" y1="${y0}" x2="${dim + 5}" y2="${y0}"/>
      ${job.open ? '' : `<line class="ext" x1="${right + 3}" y1="${y1}" x2="${dim + 5}" y2="${y1}"/>`}
      <line class="dim" x1="${dim}" y1="${y0 - 4}" x2="${dim}" y2="${job.open ? y1 : y1 + 4}"/>
      ${tick(dim, y0)}${job.open ? '' : tick(dim, y1)}
      ${text(dim + 13, mid, job.span, 'span monospace', `text-anchor="middle" transform="rotate(-90 ${dim + 13} ${mid})"`)}
      <polyline class="leader" points="${LX - 11} ${by} ${BEND} ${job.ay} ${leg}" marker-end="url(#v-arrow)"/>
      ${bubble(LX, by, job)}
      ${job.text.map((line, i) => lettering(LX + 15, job.top + 11 + i * 14, line, i === 0)).join('')}
    </g>`;
  });

  const axis = `
    <line class="ground" x1="${DX}" y1="${y(T0) - 8}" x2="${DX}" y2="${y(T1) + 8}"/>
    <rect class="earth" x="${DX - 8}" y="${y(T0) - 8}" width="8" height="${y(T1) - y(T0) + 16}" fill="url(#v-earth)"/>
    ${years.map((year) => `${tick(DX, y(year))}${text(DX - 14, y(year + 0.5) + 4, String(year), 'year monospace', 'text-anchor="end"')}`).join('')}
    ${tick(DX, y(T1))}`;

  const height = Math.max(y(T1) + 16, bottom + 8);
  return `<svg class="drawing tall" viewBox="0 0 ${W} ${height}" font-size="12" aria-hidden="true">
    ${defs('v')}
    ${bars.join('')}
    ${axis}
  </svg>`;
})();
---

<section id="career" aria-labelledby="career-heading" tabindex="-1">
  <SectionHeader headingId="career-heading" titleJp="しごとと学校" title="Career" sheetCode="SH-CV" />

  <div class="sheet-body">
    <div class="revisions">
      <h3 id="career-experience">
        <small lang="ja">しごと</small>
        <span class="typewriter">Experience</span>
      </h3>

      <div class="table">
        <p class="head monospace" aria-hidden="true">
          <span>Rev</span>
          <span>Period</span>
          <span>Description</span>
        </p>

        <ol reversed aria-labelledby="career-experience">
          {experience.map((entry, index) => (
            <li class="row" id={`career-${entry.id}`}>
              <span class="rev monospace" aria-hidden="true">{revision(index)}</span>

              <p class="period monospace">
                <time datetime={entry.from.date}>{entry.from.label}</time>
                <span class="to"><span class="to-word">to</span> <time datetime={entry.to.date}>{entry.to.label}</time></span>
              </p>

              <div class="description">
                <h4>
                  {entry.role && <span class="role typewriter">{entry.role}</span>}
                  <span class="org monospace">
                    {entry.role && <span class="at">at </span>}{entry.org}{entry.place && <span class="place">, {entry.place}</span>}
                  </span>
                </h4>

                {entry.summary && <p>{entry.summary}</p>}

                {entry.items && (
                  <ul>
                    {entry.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}

                {entry.see && (
                  <p class="see monospace">
                    See {entry.see.map((link, i) => (
                      <>{i > 0 && ', '}<a href={link.href}>{link.label}</a></>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <dl class="cells">
      <div class="cell">
        <dt class="monospace"><small lang="ja">学校</small>Education</dt>
        <dd>
          <span class="typewriter">{education.degree}</span>
          <span>{education.minor}</span>
          <span>{education.school}, <time datetime={education.year}>{education.year}</time></span>
          {tagline && <span class="tagline">{tagline}</span>}
        </dd>
      </div>

      <div class="cell">
        <dt class="monospace"><small lang="ja">ことば</small>Languages</dt>
        <dd>
          <ul class="languages">
            {languages.map(({ name, level }) => (
              <li><span class="typewriter">{name}</span> <span class="level monospace">{level}</span></li>
            ))}
          </ul>
        </dd>
      </div>

      <div class="cell">
        <dt class="monospace"><small lang="ja">ばしょ</small>Location</dt>
        <dd><span class="typewriter">{location}</span></dd>
      </div>

      <div class="cell">
        <dt class="monospace"><small lang="ja">すきなこと</small>Interests</dt>
        <dd><span>{interests.join(', ')}</span></dd>
      </div>

      <div class="cell">
        <dt class="monospace"><small lang="ja">ほかのページ</small>See also</dt>
        <dd>
          <ul class="refs monospace">
            {refs.map(({ label, href }) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>
  </div>

  <figure class="elevation">
    <Fragment set:html={wide} />
    <Fragment set:html={tall} />
  </figure>
</section>

<style lang="scss">
/* The CV is on engineering dot paper, not drawing paper. The sheet is the theme's paper with
   a twentieth of the accent mixed in, and a faint dot every 1.25rem. The accent also lifts a
   dark sheet, which cost Forest's faint lettering its contrast, so a dark theme (one that
   inverts the fibre) takes 0.03 of lightness back off. Every fill here that reads
   --surface-page takes the new tint, the table cells and the knockout behind the drawing's
   lettering too.

   Like a real pad, the dots stop short of the edge, leaving a clean band of --dot-margin. The
   field is a layer under the content, inset so its outer dots sit that far in, and it repeats
   with space so it only ever holds whole dots. */
#career {
  --dot-paper: oklch(
    from color-mix(in oklab, var(--theme-paper, var(--neutral-1)), var(--theme-accent) 5%)
    calc(l - var(--theme-paper-invert) * 0.03) c h
  );
  --dot-ink: color-mix(in oklch, var(--ink-muted), var(--blueprint-9) 35%);
  --dot: color-mix(in oklch, var(--dot-ink) 22%, transparent);
  --dot-pitch: 1.25rem;
  --dot-radius: 0.125rem;
  --dot-margin: 0.75rem;
  --surface-page: var(--dot-paper);

  position: relative;
  isolation: isolate;

  // tabindex="-1": the accesskey's landing spot, not a Tab stop.
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -0.125rem;
  }

  &::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(var(--dot-margin) - var(--dot-pitch) / 2 + var(--dot-radius));
    background-image: radial-gradient(circle, var(--dot) 0 0.0625rem, transparent var(--dot-radius));
    background-size: var(--dot-pitch) var(--dot-pitch);
    background-repeat: space;
    pointer-events: none;
  }

  @media (width >= 48rem) {
    --dot-margin: 1rem;
  }

  @media (width > 64rem) {
    --dot-margin: 1.25rem;
  }
}

#career {
  container-type: inline-size;
  margin-top: 1.5rem;
  padding: var(--page-gap);
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--ink);

  /* Every heading and label on the sheet takes its gloss the way the Demos and Open Source
     sheets do. */
  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
    background-image: linear-gradient(transparent, transparent);
  }

  a {
    color: var(--ink-muted);
    text-decoration: underline dotted;
    text-decoration-color: var(--accent-muted);
    text-underline-offset: 0.25em;

    &:hover,
    &:focus-visible {
      color: var(--accent-text);
      text-decoration-style: solid;
      text-decoration-color: currentColor;
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 0.125rem;
      border-radius: 0.125rem;
    }
  }

  h3 {
    display: grid;
    justify-items: start;
    gap: 0.125rem;
    margin-bottom: 1rem;

    [lang='ja'] {
      font-size: 0.75rem;
    }

    .typewriter {
      font-size: 1.25rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.1;
    }
  }

  /* The revision table takes the sheet and the cells stand in a column down its right, the
     way a title block does. Below 52rem of sheet the cells go under the table, two to a line
     while there is room and one below that. */
  .sheet-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;

    @container (width >= 52rem) {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 2.5rem;
    }
  }
}

/* The drawing. Which of the two shows is the sheet's width: the wide one needs 44rem for its
   smallest lettering to stay above 8px, and the tall one is capped so its lettering never
   outgrows the notes'. */
.elevation {
  display: grid;
  justify-items: center;
  margin: 3rem 0 0;

  :global(.drawing) {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  :global(.wide) {
    display: none;
  }

  :global(.tall) {
    max-width: 27.5rem;
  }

  @container (width >= 44rem) {
    :global(.wide) {
      display: block;
    }

    :global(.tall) {
      display: none;
    }
  }

  /* Lettering: 12 drawing units is the floor, so the wide drawing at 44rem lands at 8.8px.
     The sizes are attributes in the drawing's own units, not CSS. The paper-coloured stroke
     behind each word is what breaks a line where text crosses it, as dimension text breaks
     its dimension line. */
  :global(text) {
    fill: var(--ink-muted);
    paint-order: stroke;
    stroke: var(--surface-page);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  :global(.label) {
    fill: var(--ink);
  }

  :global(.small),
  :global(.span),
  :global(.year) {
    letter-spacing: 0.02em;
  }

  :global(.bubble-number) {
    fill: var(--accent-text);
    stroke: none;
  }

  /* Line weights as on a drawing: the ground heavy, the bars medium, dimensions and leaders
     thin. */
  :global(.ground) {
    stroke: var(--ink);
    stroke-width: 2;
  }

  :global(.bar) {
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  /* The degree is study, not a job: an outline with a chain centre line instead of a hatch. */
  /* A break's cut face is hatched the other way, closer, so it reads as a face and not the bar. */
  :global(.break-face) {
    stroke: var(--ink);
    stroke-width: 1;
  }

  :global(.bar.learning) {
    fill: var(--accent);
    stroke: none;
  }

  :global(.bar.study) {
    fill: var(--surface-page);
  }

  :global(.centre) {
    stroke: var(--accent-muted);
    stroke-width: 1;
    stroke-dasharray: 10 3 2 3;
  }

  :global(.hatch-line) {
    stroke: var(--accent-muted);
    stroke-width: 1;
  }

  :global(.earth-line) {
    stroke: var(--ink-muted);
    stroke-width: 0.75;
  }

  :global(.dim),
  :global(.ext),
  :global(.leader) {
    stroke: var(--ink-muted);
    stroke-width: 0.75;
    fill: none;
  }

  :global(.ext) {
    stroke: var(--ink-faint);
  }

  :global(.tick) {
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  :global(.arrow) {
    fill: var(--ink);
  }

  :global(.bubble) {
    fill: var(--surface-page);
    stroke: var(--ink);
    stroke-width: 1;
  }
}

/* The hairlines are the grid's gaps over the block's own line colour, as on a title card. */
.table {
  /* The period column holds "to Summer 2018" on one line, its longest label. */
  --grid: 2.25rem 7.75rem minmax(0, 1fr);
  --cell-pad: 0.5rem 0.625rem 0.625rem;

  display: grid;
  gap: 1px;
  background: var(--line-strong);
  border: 1px solid var(--line-strong);
  border-radius: 0.125rem;

  ol {
    display: grid;
    gap: 1px;
  }

  .head,
  .row {
    display: grid;
    grid-template-columns: var(--grid);
    gap: 1px;

    > * {
      min-width: 0;
      padding: var(--cell-pad);
      background: var(--surface-page);
    }
  }

  .head {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);

    > * {
      background: var(--surface-sunken);
    }
  }

  .rev {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--accent-text);
    text-align: center;
  }

  .period {
    display: grid;
    align-content: start;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);

    .to-word {
      color: var(--ink-faint);
    }
  }

  .description {
    display: grid;
    gap: 0.375rem;

    h4 {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 0.5ch;
      font-size: inherit;
    }

    .role {
      font-size: 1rem;
      letter-spacing: 0.03em;
    }

    .org {
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      color: var(--ink-muted);
    }

    .at,
    .place {
      color: var(--ink-faint);
    }

    p {
      color: var(--ink-muted);
      text-wrap: pretty;
    }

    ul {
      display: grid;
      gap: 0.25rem;
      color: var(--ink-muted);

      li {
        position: relative;
        padding-inline-start: 1rem;
        text-wrap: pretty;

        /* A short dash for a marker, the way a note on a sheet is listed. */
        &::before {
          content: '';
          position: absolute;
          inset-inline-start: 0;
          top: 0.7em;
          width: 0.5rem;
          height: 1px;
          background: var(--ink-faint);
        }
      }
    }

    .see {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
  }

  /* On a narrow sheet the description would have half the width of a phone, so the revision
     and the period take one line and the description the whole width under it. */
  @container (width < 36rem) {
    --grid: 2.25rem minmax(0, 1fr);

    .head {
      display: none;
    }

    .row {
      grid-template-rows: auto auto;
    }

    .period {
      grid-template-columns: repeat(2, auto);
      justify-content: start;
      column-gap: 0.5ch;
    }

    .description {
      grid-column: 1 / -1;
    }
  }
}

.cells {
  display: grid;
  gap: 1px;
  background: var(--line-strong);
  border: 1px solid var(--line-strong);
  border-radius: 0.125rem;

  @container (width < 52rem) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @container (width < 30rem) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* An odd cell out at the end of two columns would leave a blank slot of line colour beside
     it, so it takes the whole last line instead. */
  .cell:nth-child(odd):last-child {
    grid-column: 1 / -1;
  }

  .cell {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.4375rem 0.625rem 0.625rem;
    background: var(--surface-sunken);
  }

  dt {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);

    [lang='ja'] {
      font-size: 0.625rem;
      letter-spacing: 0.08em;
      text-transform: none;
    }
  }

  dd {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-muted);
    overflow-wrap: break-word;

    > .typewriter {
      font-size: 0.75rem;
      color: var(--ink);
    }

    > .tagline {
      margin-top: 0.125rem;
      font-style: italic;
      color: var(--ink-faint);
    }
  }

  .languages,
  .refs {
    display: grid;
    gap: 0.125rem;

    li {
      display: flex;
      align-items: baseline;
      gap: 0.75ch;
    }
  }

  .languages .typewriter {
    font-size: 0.75rem;
    color: var(--ink);
  }

  .level {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .refs a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }
}
</style>
