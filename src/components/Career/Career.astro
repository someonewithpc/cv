---
/**
 * The CV proper, drawn the way a sheet records its own history: the roles are the rows of a
 * revision table, oldest revision first by number and newest at the top, and the rest of the
 * CV (degree, languages, where Hugo is, what else he does) fills title block cells beside it.
 * Everything on the sheet comes from site.json; the skills and the upstream work have sheets
 * of their own and are only referred to from here.
 */
import SectionHeader from '@/components/SectionHeader.astro';

import site from './site.json';

type Edge = { date: string; label: string };
type Link = { label: string; href: string };
type Entry = {
  id: string;
  org: string;
  place?: string;
  role?: string;
  from: Edge;
  to: Edge;
  summary: string;
  items?: string[];
  see?: Link[];
};

const { experience, education, learning, tagline, languages, location, interests, refs } = site as typeof site & { experience: Entry[] };

/* Revisions count up from the first job, so the newest row, listed first, carries the highest number. */
const revision = (index: number) => String(experience.length - index).padStart(2, '0');

/* Under the table, the same jobs drawn as an elevation: the years run along a dimension string
   under the ground line, every job is a bar as long as it lasted, standing on the ground or
   stacked over a bar it overlapped, with its own dimension over it and a leader from its
   revision number. The degree is an outline bar in the lowest lane, under the jobs of those
   years. Under everything, on the ground, runs the continuous learning line, from the year
   Hugo started coding and still going, so it ends in an arrow instead of a tick. Wide, time runs left to right; under 44rem of sheet the drawing stands on
   end and time flows down the page, oldest at the top, so the labels get the sheet's width. */

/* A date as a fraction of a year. A bare year whose label says "Summer" is June to September. */
const at = (edge: Edge, end = false): number => {
  const [year, month] = edge.date.split('-').map(Number);
  if (month) return year + (end ? month : month - 1) / 12;
  if (edge.label.startsWith('Summer')) return year + (end ? 0.7 : 0.45);
  return year + (end ? 1 : 0);
};

type Job = Entry & {
  n: string;
  study?: boolean;
  open?: boolean;
  start: number;
  end: number;
  seasonal: boolean;
  span: string;
  lane: number;
  /* Where along the bar a leader may land, as fractions of its length, best first. */
  anchors: number[];
  lines: string[];
};

const jobs: Job[] = experience
  .map((entry, index) => {
    const start = at(entry.from);
    const end = at(entry.to, true);
    const seasonal = entry.from.label.startsWith('Summer');
    const months = Math.round((end - start) * 12);
    const span = seasonal
      ? `${Number(entry.to.date) - Number(entry.from.date) + 1} summers`
      : [months >= 12 && `${Math.floor(months / 12)}y`, months % 12 && `${months % 12}m`].filter(Boolean).join(' ');
    const org = entry.place ? `${entry.org}, ${entry.place}` : entry.org;
    const lines = entry.role ? [entry.role, org] : [org];
    return { ...entry, start, end, seasonal, span, lines, n: revision(index), lane: 0, anchors: [] };
  })
  .sort((a, b) => a.start - b.start);

/* The degree goes first, so it takes the ground lane and the jobs of those years stand on it.
   Its dates are bare years, drawn as whole years to line up with the axis's year labels. */
jobs.unshift({
  id: 'education',
  org: education.school,
  role: education.degree,
  from: { date: education.from, label: education.from },
  to: { date: education.year, label: education.year },
  summary: '',
  n: '学',
  study: true,
  start: Number(education.from),
  end: Number(education.year) + 1,
  seasonal: false,
  span: `${education.from} to ${education.year}`,
  lane: 0,
  anchors: [],
  lines: [education.degree, `${education.minor}, ${education.short}`],
});

/* Lanes: a bar takes the lowest lane that is clear for it, so overlapping jobs stack. A bar
   whose whole length ends up under a higher bar could not take a leader, so it moves above
   the bars that cover it. */
const CLEAR = 0.15;
const laneEnds: number[] = [];
for (const job of jobs) {
  let lane = laneEnds.findIndex((end) => end + CLEAR <= job.start);
  if (lane < 0) lane = laneEnds.length;
  laneEnds[lane] = job.end;
  job.lane = lane;
}

/* A seasonal job breaks off midway through each winter between its summers. */
const breaks = (job: Job) =>
  job.seasonal ? Array.from({ length: Number(job.to.date) - Number(job.from.date) }, (_, i) => Number(job.from.date) + i + 1.075) : [];

const ANCHORS = [0.3, 0.7, 0.5, 0.15, 0.85];
const MARGIN = 0.12;
const above = (job: Job) => jobs.filter((other) => other.lane > job.lane && other.start - MARGIN <= job.end && job.start <= other.end + MARGIN);
const covered = (job: Job, t: number) => above(job).some((other) => other.start - MARGIN <= t && t <= other.end + MARGIN);
for (let moved = true; moved; ) {
  moved = false;
  for (const job of jobs) {
    job.anchors = ANCHORS.map((f) => job.start + f * (job.end - job.start))
      .filter((t) => !covered(job, t) && breaks(job).every((b) => Math.abs(t - b) > 0.2))
      .map((t) => (t - job.start) / (job.end - job.start));
    if (job.anchors.length) continue;
    job.lane = Math.max(...above(job).map((other) => other.lane)) + 1;
    moved = true;
  }
}
const lanes = Math.max(...jobs.map((job) => job.lane)) + 1;

/* The learning line has not ended: it runs to the day of the build. */
const today = new Date();
const NOW = today.getFullYear() + (today.getMonth() + (today.getDate() - 1) / 31) / 12;

/* It lies under every lane, so its anchor is any point before the first job. Placed first,
   it takes the lowest label row. */
jobs.unshift({
  id: 'learning',
  org: learning.label,
  from: { date: learning.from, label: learning.from },
  to: { date: '', label: 'now' },
  summary: '',
  n: '∞',
  open: true,
  start: Number(learning.from),
  end: NOW,
  seasonal: false,
  span: `since ${learning.from}`,
  lane: -1,
  anchors: [],
  lines: [learning.label],
});
{
  const first = Math.min(...jobs.filter((job) => !job.open).map((job) => job.start));
  const learner = jobs[0];
  learner.anchors = ANCHORS.filter((f) => learner.start + f * (learner.end - learner.start) < first - MARGIN - 0.2);
}

const T0 = Number(learning.from);
const T1 = Math.floor(NOW) + 1;
const years = Array.from({ length: T1 - T0 }, (_, i) => T0 + i);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/* Width of a monospace character at the drawing's 12 unit size. */
const CH = 7.2;

/* Word wrap by character count: the drawing cannot measure its text at build time. */
const wrap = (text: string, width: number): string[] => {
  const lines: string[] = [];
  for (const word of text.split(' ')) {
    const last = lines[lines.length - 1];
    if (last !== undefined && `${last} ${word}`.length <= width) lines[lines.length - 1] = `${last} ${word}`;
    else lines.push(word);
  }
  return lines;
};

const text = (x: number, y: number, s: string, cls = '', extra = '') =>
  `<text x="${x}" y="${y}" class="${cls}" ${extra}>${esc(s)}</text>`;

/* An architectural tick: a short stroke through the dimension line at 45 degrees. */
const tick = (x: number, y: number) => `<path class="tick" d="M${x - 3.5} ${y + 3.5} l7 -7"/>`;

const defs = (id: string) =>
  `<defs>
    <pattern id="${id}-hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
      <line class="hatch-line" x1="0" y1="0" x2="0" y2="6"/>
    </pattern>
    <pattern id="${id}-earth" patternUnits="userSpaceOnUse" width="7" height="7" patternTransform="rotate(-45)">
      <line class="earth-line" x1="0" y1="0" x2="0" y2="7"/>
    </pattern>
    <marker id="${id}-arrow" viewBox="0 0 8 8" refX="7.5" refY="4" markerWidth="8" markerHeight="8" orient="auto">
      <path class="arrow" d="M0 0.5 L8 4 L0 7.5 z"/>
    </marker>
  </defs>`;

/* The bubble carries the job's revision number from the table. */
const bubble = (x: number, y: number, job: Job) =>
  `<circle class="bubble" cx="${x}" cy="${y}" r="10"/>${text(x, y + 4, job.n, job.study ? 'bubble-number bubble-study' : 'bubble-number monospace', 'text-anchor="middle"')}`;

const group = (job: Job) => `<g class="${job.open ? 'learning' : job.study ? 'study' : 'job'}" data-job="${job.id}" data-lane="${job.lane}">`;
/* A seasonal bar is drawn in pieces, cut at its breaks with the drafting break line:
   straight across, a Z through the middle, straight again. `pos` places a time along the
   bar and `pt` writes an (along, across) pair as x y. */
const GAP = 4;
const cutBar = (job: Job, pos: (t: number) => number, c0: number, c1: number, pt: (a: number, c: number) => string, attrs: string) => {
  const dir = Math.sign(pos(job.end) - pos(job.start));
  const ends = [pos(job.start), ...breaks(job).flatMap((t) => [pos(t) - dir * GAP, pos(t) + dir * GAP]), pos(job.end)];
  const edge = (a: number, from: number, to: number, cut: boolean) => {
    if (!cut) return [pt(a, to)];
    const m = (from + to) / 2;
    const d = (to - from) / 4;
    return [pt(a, m - d), pt(a + 3.5, m - 0.3 * d), pt(a - 3.5, m + 0.3 * d), pt(a, m + d), pt(a, to)];
  };
  const pieces = ends.length / 2;
  return Array.from({ length: pieces }, (_, i) => {
    const [a, b] = [ends[2 * i], ends[2 * i + 1]];
    const points = [pt(a, c0), pt(b, c0), ...edge(b, c0, c1, i < pieces - 1), pt(a, c1), ...edge(a, c1, c0, i > 0)];
    return `<path ${attrs} d="M${points.join(' L')} Z"/>`;
  }).join('');
};

/* The learning line: a thin bar with an arrowhead at the present instead of an end. */
const openBar = (a0: number, ae: number, c: number, pt: (a: number, c: number) => string) => {
  const head = ae - Math.sign(ae - a0) * 9;
  const points = [pt(a0, c - 2), pt(head, c - 2), pt(head, c - 5), pt(ae, c), pt(head, c + 5), pt(head, c + 2), pt(a0, c + 2)];
  return `<path class="bar learning" d="M${points.join(' L')} Z"/>`;
};

const barClass = (job: Job) => `bar${job.seasonal ? ' seasonal' : ''}${job.study ? ' study' : ''}`;
const fill = (job: Job, id: string) => (job.study ? '' : `fill="url(#${id}-hatch)"`);

/* ----- Wide: time runs left to right. ----- */
const wide = (() => {
  const W = 960;
  const L = 28;
  const R = 24;
  const PX = (W - L - R) / (T1 - T0);
  const x = (t: number) => L + (t - T0) * PX;
  const LANE = 48;
  const BAR = 20;
  const ROW = 34;

  type Placed = Job & { ax: number; row: number; textEnd: number };

  /* Label rows, nearest the bars first. Two labels in a row keep clear of each other, a
     leader coming down from a higher row keeps clear of the text in the rows it passes, and
     no text runs off the sheet. The search tries one row, then two and so on, and keeps the
     first layout that fits, each label at its best anchor that allows it. */
  const options = jobs.map((job) => {
    const width = 25 + Math.max(...job.lines.map((line) => line.length)) * CH;
    return job.anchors.map((f) => x(job.start + f * (job.end - job.start))).filter((ax) => ax + width <= W - 4).map((ax) => ({ ax, textEnd: ax + width }));
  });
  const clear = (a: { row: number; ax: number; textEnd: number }, b: { row: number; ax: number; textEnd: number }) => {
    if (a.row === b.row) return a.textEnd + 16 <= b.ax - 10 || b.textEnd + 16 <= a.ax - 10;
    const [high, low] = a.row > b.row ? [a, b] : [b, a];
    return high.ax + 12 < low.ax - 12 || low.textEnd + 4 < high.ax - 12;
  };
  const search = (rows: number, chosen: { row: number; ax: number; textEnd: number }[]): typeof chosen | undefined => {
    if (chosen.length === jobs.length) return chosen;
    for (let row = 0; row < rows; row += 1) {
      for (const option of options[chosen.length]) {
        const next = { ...option, row };
        if (!chosen.every((other) => clear(other, next))) continue;
        const found = search(rows, [...chosen, next]);
        if (found) return found;
      }
    }
    return undefined;
  };
  let layout: { row: number; ax: number; textEnd: number }[] | undefined;
  for (let rows = 1; !layout; rows += 1) {
    if (rows > jobs.length) throw new Error('Career elevation: no label layout keeps every leader clear');
    layout = search(rows, []);
  }
  const placed: Placed[] = jobs.map((job, i) => ({ ...job, ...layout![i] }));
  const rows = Math.max(...placed.map((job) => job.row)) + 1;

  const TOP = 8;
  const rowY = (row: number) => TOP + 17 + (rows - 1 - row) * ROW;
  const lanesTop = TOP + rows * ROW + 8;
  const BASE = 36;
  const G = lanesTop + BASE + lanes * LANE;
  /* The learning line lies on the ground and the lanes stand on it. */
  const LY = G - 7;
  const barTop = (lane: number) => (lane < 0 ? LY - 2 : G - BASE - lane * LANE - BAR);

  const bars = placed.map((job) => {
    const x0 = x(job.start);
    const x1 = x(job.end);
    const top = barTop(job.lane);
    const dim = top - 12;
    const by = rowY(job.row);
    /* The span sits mid-bar unless the leader lands there, then beside the leader. */
    const half = (job.span.length * CH) / 2 + 8;
    let mid = (x0 + x1) / 2;
    if (Math.abs(job.ax - mid) < half) mid = job.ax + (job.ax - x0 > x1 - job.ax ? -half : half);
    const shape = job.open
      ? openBar(x0, x1, LY, (a, c) => `${a} ${c}`)
      : job.seasonal
        ? cutBar(job, x, top, top + BAR, (a, c) => `${a} ${c}`, `class="${barClass(job)}" ${fill(job, 'h')}`)
        : `<rect class="${barClass(job)}" x="${x0}" y="${top}" width="${x1 - x0}" height="${BAR}" ${fill(job, 'h')}/>`;
    return `${group(job)}
      ${shape}
      ${job.study ? `<line class="centre" x1="${x0 + 4}" y1="${top + BAR / 2}" x2="${x1 - 4}" y2="${top + BAR / 2}"/>` : ''}
      <line class="ext" x1="${x0}" y1="${top - 3}" x2="${x0}" y2="${dim - 5}"/>
      ${job.open ? '' : `<line class="ext" x1="${x1}" y1="${top - 3}" x2="${x1}" y2="${dim - 5}"/>`}
      <line class="dim" x1="${x0 - 4}" y1="${dim}" x2="${job.open ? x1 : x1 + 4}" y2="${dim}"/>
      ${tick(x0, dim)}${job.open ? '' : tick(x1, dim)}
      ${text(mid, dim - 4, job.span, 'span monospace', 'text-anchor="middle"')}
      <polyline class="leader" points="${job.ax} ${by + 10} ${job.ax} ${top - 1}" marker-end="url(#h-arrow)"/>
      ${bubble(job.ax, by, job)}
      ${job.lines.map((line, i) => text(job.ax + 15, by + (job.lines.length === 1 ? 4 : i === 0 ? -1 : 12), line, i === 0 ? 'label typewriter' : 'small monospace')).join('')}
    </g>`;
  });

  const AXIS = G + 34;
  const axis = `
    <line class="ground" x1="${L - 8}" y1="${G}" x2="${W - R + 8}" y2="${G}"/>
    <rect class="earth" x="${L - 8}" y="${G}" width="${W - L - R + 16}" height="8" fill="url(#h-earth)"/>
    <line class="dim" x1="${x(T0)}" y1="${AXIS}" x2="${x(T1)}" y2="${AXIS}"/>
    ${years.map((year) => `<line class="ext" x1="${x(year)}" y1="${G + 12}" x2="${x(year)}" y2="${AXIS + 5}"/>${tick(x(year), AXIS)}${text(x(year + 0.5), AXIS + 16, String(year), 'year monospace', 'text-anchor="middle"')}`).join('')}
    <line class="ext" x1="${x(T1)}" y1="${G + 12}" x2="${x(T1)}" y2="${AXIS + 5}"/>${tick(x(T1), AXIS)}`;

  const height = AXIS + 24;
  return `<svg class="drawing wide" viewBox="0 0 ${W} ${height}" aria-hidden="true">
    ${defs('h')}
    ${bars.join('')}
    ${axis}
  </svg>`;
})();

/* ----- Narrow: the same drawing on end, the ground a datum down the left. ----- */
const tall = (() => {
  /* Wider than the 360 the jobs alone took: the degree's lane and the learning line's
     would otherwise narrow the labels. */
  const W = 410;
  const DX = 44;
  const S = 28;
  const TOP = 12;
  const y = (t: number) => TOP + (t - T0) * S;
  /* Each lane is its bar with the bar's dimension on the datum side of it, so the leaders,
     which leave on the other side, cross nothing but the lanes above. */
  const LANE = 34;
  const BAR = 12;
  const LC = DX + 8 + LANE - BAR + 2;
  const LANE0 = LC + 24;
  /* Past the last lane each leader bends from its bubble's height to its bar's. */
  const BEND = LANE0 + (lanes - 1) * LANE + BAR + 8;
  const LX = BEND + 28;
  const width = Math.floor((W - 4 - LX - 15) / CH);

  type Placed = Job & { ay: number; top: number; text: string[] };
  const placed: Placed[] = jobs.map((job) => ({
    ...job,
    ay: y(job.start + job.anchors[0] * (job.end - job.start)),
    top: 0,
    text: job.lines.flatMap((line) => wrap(line, width)),
  }));

  /* Labels down the right, each pushed below the one before it when the bars are closer
     together than the labels are tall. */
  let bottom = TOP;
  for (const job of [...placed].sort((a, b) => a.ay - b.ay)) {
    job.top = Math.max(job.ay - 7, bottom + 8);
    bottom = job.top + job.text.length * 14;
  }

  /* Two short jobs in one lane can have spans longer than their bars; those move apart. */
  const spanAt = new Map(placed.map((job) => [job.id, (y(job.start) + y(job.end)) / 2]));
  for (const lane of new Set(placed.map((job) => job.lane))) {
    const inLane = placed.filter((job) => job.lane === lane).sort((a, b) => spanAt.get(a.id)! - spanAt.get(b.id)!);
    for (const [i, b] of inLane.slice(1).entries()) {
      const a = inLane[i];
      const short = ((a.span.length + b.span.length) * CH) / 2 + 6 - (spanAt.get(b.id)! - spanAt.get(a.id)!);
      if (short <= 0) continue;
      spanAt.set(a.id, spanAt.get(a.id)! - short / 2);
      spanAt.set(b.id, spanAt.get(b.id)! + short / 2);
    }
  }

  const bars = placed.map((job) => {
    const x0 = job.open ? LC - 2 : LANE0 + job.lane * LANE;
    const right = job.open ? LC + 2 : x0 + BAR;
    const y0 = y(job.start);
    const y1 = y(job.end);
    const dim = x0 - 10;
    const mid = spanAt.get(job.id)!;
    const by = job.top + 7;
    const shape = job.open
      ? openBar(y0, y1, LC, (a, c) => `${c} ${a}`)
      : job.seasonal
        ? cutBar(job, y, x0, x0 + BAR, (a, c) => `${c} ${a}`, `class="${barClass(job)}" ${fill(job, 'v')}`)
        : `<rect class="${barClass(job)}" x="${x0}" y="${y0}" width="${BAR}" height="${y1 - y0}" ${fill(job, 'v')}/>`;
    return `${group(job)}
      ${shape}
      ${job.study ? `<line class="centre" x1="${x0 + BAR / 2}" y1="${y0 + 4}" x2="${x0 + BAR / 2}" y2="${y1 - 4}"/>` : ''}
      <line class="ext" x1="${x0 - 3}" y1="${y0}" x2="${dim - 5}" y2="${y0}"/>
      ${job.open ? '' : `<line class="ext" x1="${x0 - 3}" y1="${y1}" x2="${dim - 5}" y2="${y1}"/>`}
      <line class="dim" x1="${dim}" y1="${y0 - 4}" x2="${dim}" y2="${job.open ? y1 : y1 + 4}"/>
      ${tick(dim, y0)}${job.open ? '' : tick(dim, y1)}
      ${text(dim - 4, mid, job.span, 'span monospace', `text-anchor="middle" transform="rotate(-90 ${dim - 4} ${mid})"`)}
      <polyline class="leader" points="${LX - 11} ${by} ${BEND} ${job.ay} ${right + 1} ${job.ay}" marker-end="url(#v-arrow)"/>
      ${bubble(LX, by, job)}
      ${job.text.map((line, i) => text(LX + 15, job.top + 11 + i * 14, line, i === 0 ? 'label typewriter' : 'small monospace')).join('')}
    </g>`;
  });

  const axis = `
    <line class="ground" x1="${DX}" y1="${y(T0) - 8}" x2="${DX}" y2="${y(T1) + 8}"/>
    <rect class="earth" x="${DX - 8}" y="${y(T0) - 8}" width="8" height="${y(T1) - y(T0) + 16}" fill="url(#v-earth)"/>
    ${years.map((year) => `${tick(DX, y(year))}${text(DX - 14, y(year + 0.5) + 4, String(year), 'year monospace', 'text-anchor="end"')}`).join('')}
    ${tick(DX, y(T1))}`;

  const height = Math.max(y(T1) + 16, bottom + 8);
  return `<svg class="drawing tall" viewBox="0 0 ${W} ${height}" aria-hidden="true">
    ${defs('v')}
    ${bars.join('')}
    ${axis}
  </svg>`;
})();
---

<section id="career" aria-labelledby="career-heading">
  <SectionHeader headingId="career-heading" titleJp="しごとと学校" title="Career" sheetCode="SH-CV" />

  <div class="sheet-body">
    <div class="revisions">
      <h3 id="career-experience">
        <small lang="ja">しごと</small>
        <span class="typewriter">Experience</span>
      </h3>

      <div class="table">
        <p class="head monospace" aria-hidden="true">
          <span>Rev</span>
          <span>Period</span>
          <span>Description</span>
        </p>

        <ol reversed aria-labelledby="career-experience">
          {experience.map((entry, index) => (
            <li class="row" id={`career-${entry.id}`}>
              <span class="rev monospace" aria-hidden="true">{revision(index)}</span>

              <p class="period monospace">
                <time datetime={entry.from.date}>{entry.from.label}</time>
                <span class="to"><span class="to-word">to</span> <time datetime={entry.to.date}>{entry.to.label}</time></span>
              </p>

              <div class="description">
                <h4>
                  {entry.role && <span class="role typewriter">{entry.role}</span>}
                  <span class="org monospace">
                    {entry.role && <span class="at">at </span>}{entry.org}{entry.place && <span class="place">, {entry.place}</span>}
                  </span>
                </h4>

                <p>{entry.summary}</p>

                {entry.items && (
                  <ul>
                    {entry.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}

                {entry.see && (
                  <p class="see monospace">
                    See {entry.see.map((link, i) => (
                      <>{i > 0 && ', '}<a href={link.href}>{link.label}</a></>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <dl class="cells">
      <div class="cell">
        <dt class="monospace"><small lang="ja">学校</small>Education</dt>
        <dd>
          <span class="typewriter">{education.degree}</span>
          <span>{education.minor}</span>
          <span>{education.school}, <time datetime={education.year}>{education.year}</time></span>
          {tagline && <span class="tagline">{tagline}</span>}
        </dd>
      </div>

      <div class="cell">
        <dt class="monospace"><small lang="ja">ことば</small>Languages</dt>
