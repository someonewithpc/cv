---
import { Icon } from 'astro-icon/components';

import { CONTACT } from '@/site';
import { mailLink } from '../mailLink';

/* Date of issue: the build is the issue. */
const issued = new Date().toISOString().slice(0, 7);
---

<header>
  <figure class="title-block">
    <div class="cell owner">
      <h1 lang="pt-PT">
        <ruby><span>Hugo</span><rp aria-hidden="true">(</rp><rt aria-hidden="true">[ˈuɡu]</rt><rp aria-hidden="true">)</rp></ruby> <ruby><span>Sales</span><rp aria-hidden="true">(</rp><rt aria-hidden="true">[ˈsaləʃ]</rt><rp aria-hidden="true">)</rp></ruby>
      </h1>
      <p class="sheet-role monospace">Full stack developer / FOSS contributor</p>
    </div>

    <dl class="fields monospace">
      <div class="cell">
        <dt>Drawing no.</dt>
        <dd class="typewriter">CV-001</dd>
      </div>
      <div class="cell">
        <dt>Rev.</dt>
        <dd class="typewriter">A</dd>
      </div>
      <div class="cell">
        <dt>Sheet</dt>
        <dd class="typewriter">1 / 1</dd>
      </div>
      <div class="cell">
        <dt>Scale</dt>
        <dd class="typewriter">As noted</dd>
      </div>
      <div class="cell">
        <dt>Issued</dt>
        <dd class="typewriter"><time datetime={issued}>{issued}</time></dd>
      </div>
      <div class="cell projection">
        <dt><span aria-hidden="true">Proj.</span><span class="sr-only">Projection</span></dt>
        <dd><Icon name="first-angle-projection" aria-hidden="true" /></dd>
      </div>
    </dl>

    <address class="contact monospace cell">
      <span class="field-label" aria-hidden="true">Contact</span>
      <ul>
        <li><Fragment set:html={mailLink(CONTACT.email)} /></li>
        {CONTACT.profiles.map(({ label, href }) => (
          <li>
            <a href={href} rel="me noopener noreferrer" target="_blank">
              {label}<span class="sr-only">, opens in a new tab</span>
            </a>
          </li>
        ))}
      </ul>
    </address>

    <div class="cell notes">
      <span class="field-label monospace" aria-hidden="true">Notes</span>
      <label class="bypass-contrast-check note-row">
        <input type="checkbox">
        <span>Show <span class="inline pronunciation-label">Pronunciation Guide</span></span>
      </label>
      <audio controls aria-label="Pronunciation of Hugo Sales"><source src="data:audio/mpeg;base64," type="audio/mpeg"></audio>
    </div>
  </figure>
</header>

<style lang="scss">
header {
  display: flex;
  justify-content: end;

  @media (max-width: 52rem) {
    justify-content: stretch;
  }

  /* An ISO 7200 title block: cells on a hairline grid, the frame line around it. The gaps
     between cells are the grid lines. */
  .title-block {
    --tb-line: var(--sheet-frame);

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'owner fields'
      'contact fields'
      'notes notes';
    gap: 1px;
    width: min(100%, 36rem);
    border: 2px solid var(--tb-line);
    background: var(--tb-line);
    /* The block sits on the sheet, not over its grid. */
    color: var(--ink);

    @media (max-width: 52rem) {
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'owner'
        'fields'
        'contact'
        'notes';
    }

    .cell {
      background: var(--sheet-paper);
      padding: 0.5rem 0.75rem;
      min-width: 0;
    }

    .owner {
      grid-area: owner;
      display: grid;
      align-content: end;
      gap: 0.5rem;
      padding: 1.25rem 1rem 0.875rem;

      @media (max-width: 52rem) {
        padding: 1.5rem 1rem 1rem;
      }
    }

    .field-label,
    .fields dt {
      display: block;
      font-size: 0.5625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0.25rem;
    }

    .fields {
      grid-area: fields;
      display: grid;
      grid-template-columns: repeat(2, auto);
      gap: 1px;
      margin: 0;

      @media (max-width: 52rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      > div {
        display: grid;
        align-content: start;
        min-width: 5.5rem;

        @media (max-width: 52rem) {
          min-width: 0;
        }
      }

      dd {
        margin: 0;
        font-size: 1rem;
        line-height: 1.2;
        white-space: nowrap;
      }

      .projection dd :global(svg) {
        display: block;
        width: 2.5rem;
        height: 1.25rem;
        color: var(--ink);
      }
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 6vw, 2.75rem);
      line-height: 1.1;
      color: var(--ink);

      span {
        text-decoration: underline dotted;
        text-decoration-color: var(--accent-muted);
        text-underline-offset: 4px;
      }

      ruby {
        letter-spacing: 3px;

        :is(rp, rt) {
          opacity: 0;
          transition: opacity 250ms ease;
        }
      }
    }

    .sheet-role {
      margin: 0;
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .contact {
      grid-area: contact;
      font-style: normal;
      font-size: 0.75rem;
      letter-spacing: 0.04em;

      ul {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0 0.5ch;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li {
        display: inline-flex;
        align-items: center;
      }

      /* Trailing, so a wrapped row never opens with one. */
      li:not(:last-child)::after {
        content: "·";
        margin-inline-start: 0.5ch;
        color: var(--ink-faint);
      }

      a {
        display: inline-flex;
        align-items: center;
        min-height: 1.5rem;
        color: var(--ink-muted);
        text-decoration: underline dotted;
        text-decoration-color: var(--accent-muted);
        text-underline-offset: 0.25em;

        &:hover,
        &:focus-visible {
          color: var(--accent-text);
          text-decoration-style: solid;
          text-decoration-color: currentColor;
        }

        &:focus-visible {
          outline: 2px solid var(--accent);
          outline-offset: 0.125rem;
          border-radius: 0.125rem;
        }
      }
    }

    .notes {
      grid-area: notes;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: 1rem;

      .field-label {
        margin: 0;
      }
    }

    .note-row {
      color: var(--ink-faint);
      display: inline-flex;
      align-items: center;
      gap: 0.5ch;
      width: fit-content;
      font-size: 0.875rem;
    }

    audio {
      grid-column: 1 / -1;
      width: 100%;
      height: 2rem;
      margin-top: 0.375rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 250ms ease, visibility 0s 250ms;
    }

    /* Match or beat the ruby hide rule specificity */
    &:is(:hover, :focus-within, :has(input:checked)) {
      audio,
      h1 ruby :is(rp, rt) {
        opacity: 1;
      }
    }

    /* Not on focus-within: the player is only reachable once asked for, or the keyboard would
       walk its controls on the way past the name. */
    &:is(:hover, :has(input:checked)) audio {
      visibility: visible;
      transition-delay: 0s;
    }
  }
}
</style>
