---
import { CONTACT } from '@/site';
import { mailLink } from '../mailLink';
---

<header id="profile">
  <div class="title-block">
    <div class="cell cell-name">
      <h1 lang="pt-PT" class="typewriter">
        <ruby><span>Hugo</span><rp aria-hidden="true">(</rp><rt aria-hidden="true">[ˈuɡu]</rt><rp aria-hidden="true">)</rp></ruby> <ruby><span>Sales</span><rp aria-hidden="true">(</rp><rt aria-hidden="true">[ˈsaləʃ]</rt><rp aria-hidden="true">)</rp></ruby>
      </h1>
    </div>

    <div class="cell cell-role">
      <span class="cell-label monospace">Role</span>
      <p class="typewriter">Full stack developer / FOSS contributor</p>
    </div>

    <div class="cell cell-sheet">
      <span class="cell-label monospace">Sheet</span>
      <span class="typewriter">01</span>
    </div>

    <div class="cell cell-contact">
      <span class="cell-label monospace">Contact</span>
      <address class="contact monospace">
        <ul>
          <li><Fragment set:html={mailLink(CONTACT.email)} /></li>
          {CONTACT.profiles.map(({ label, href }) => (
            <li>
              <a href={href} rel="me noopener noreferrer" target="_blank">
                {label}<span class="sr-only">, opens in a new tab</span>
              </a>
            </li>
          ))}
        </ul>
      </address>
    </div>

    <div class="cell cell-pronunciation">
      <span class="cell-label monospace">Pronunciation</span>
      <label class="bypass-contrast-check note-row">
        <input type="checkbox">
        <span>Show <span class="inline pronunciation-label">pronunciation guide</span></span>
      </label>
      <audio controls aria-label="Pronunciation of Hugo Sales"><source src="data:audio/mpeg;base64," type="audio/mpeg"></audio>
    </div>
  </div>
</header>

<style lang="scss">
header {
  display: flex;
  justify-content: center;
  margin-block: 1.25rem 0.25rem;

  @media (max-width: 52rem) {
    margin-block: 3.25rem 0.25rem;
  }

  /* The title block a drawing carries in its corner, as TitleCard.astro draws it beside each
     detail: hairline cells sized to their content, a small label over a typewriter value,
     left-aligned. The hairlines are the grid's own gaps over the block's background, so every
     cell keeps one line between it and the next and the block keeps one round the outside. */
  .title-block {
    width: min(100%, 42rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    border-radius: 0.125rem;
    box-shadow: var(--sheet-lift);

    /* On a phone the small cells pair up in two equal columns, so the block stays near the
       height of the old card; only a very narrow one stacks them. */
    @media (max-width: 30rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 22rem) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .cell {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.5rem 0.75rem 0.625rem;
    background: var(--surface-page);
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .cell-name {
    grid-column: 1 / -1;
    padding: 1rem 0.75rem 0.875rem;
  }

  .cell-label {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 9vw, 3.25rem);
    line-height: 1.15;
    color: var(--ink);

    span {
      text-decoration: underline dotted;
      text-decoration-color: var(--accent-muted);
      text-underline-offset: 4px;
    }

    ruby {
      letter-spacing: 3px;

      :is(rp, rt) {
        opacity: 0;
        transition: opacity 250ms ease;
      }
    }
  }

  .cell-role p {
    margin: 0;
    letter-spacing: 0.02em;
  }

  .contact {
    margin: 0;
    font-style: normal;
    letter-spacing: 0.02em;

    /* One line per link, no dots between them. */
    ul {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    li {
      display: flex;
      align-items: center;
    }

    :global(a) {
      display: inline-flex;
      align-items: center;
      min-height: 1.5rem;
      color: var(--ink-muted);
      text-decoration: underline dotted;
      text-decoration-color: var(--accent-muted);
      text-underline-offset: 0.25em;

      &:hover,
      &:focus-visible {
        color: var(--accent-text);
        text-decoration-style: solid;
        text-decoration-color: currentColor;
      }

      &:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 0.125rem;
        border-radius: 0.125rem;
      }
    }
  }

  .note-row {
    color: var(--ink-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    width: fit-content;
    min-height: 1.5rem;
  }

  /* The player takes no room until the box is ticked: hidden, it still measured 54px and left
     the card 86px of nothing under its last line. It is not on hover either, so the block
     ends where the writing does, and not on focus-within, or the keyboard would walk its
     controls on the way past the name. It is 300px wide by default, so on a phone narrower
     than that it is capped at the cell. */
  audio {
    display: none;
    max-width: 100%;
    margin-top: 0.25rem;
  }

  .title-block:has(input:checked) audio {
    display: block;
  }

  /* Match or beat the ruby hide rule specificity */
  .title-block:is(:hover, :focus-within, :has(input:checked)) h1 ruby :is(rp, rt) {
    opacity: 1;
  }
}
</style>
