---
import { CONTACT } from '@/site';
import { mailLink } from '../mailLink';
import pronunciation from '@/assets/pronunciation.mp3?url';
---

<header id="profile" tabindex="-1">
  <figure class="title-block">
    <p class="sheet-meta monospace" aria-hidden="true">
      <span>DWG</span>
      <span>·</span>
      <span>CV-001</span>
      <span>·</span>
      <span>REV A</span>
    </p>

    <h1 lang="pt-PT">
      <ruby><span>Hugo</span><rp aria-hidden="true">(</rp><rt aria-hidden="true">[ˈuɡu]</rt><rp aria-hidden="true">)</rp></ruby> <ruby><span>Sales</span><rp aria-hidden="true">(</rp><rt aria-hidden="true">[ˈsaləʃ]</rt><rp aria-hidden="true">)</rp></ruby>
    </h1>

    <p class="sheet-role monospace">Full stack developer / FOSS contributor</p>

    <address class="contact monospace">
      <ul>
        <li><Fragment set:html={mailLink(CONTACT.email)} /></li>
        {CONTACT.profiles.map(({ label, href }) => (
          <li>
            <a href={href} rel="me noopener noreferrer" target="_blank">
              {label}<span class="sr-only">, opens in a new tab</span>
            </a>
          </li>
        ))}
      </ul>
    </address>

    <label class="bypass-contrast-check note-row">
      <input type="checkbox">
      <span>Show <span class="inline pronunciation-label">Pronunciation Guide</span></span>
    </label>

    <audio controls aria-label="Pronunciation of Hugo Sales"><source src={pronunciation} type="audio/mpeg"></audio>
  </figure>
</header>

<style lang="scss">
@use '@/scss/hit-area' as *;
header {
  // tabindex="-1": where the H access key lands, not a Tab stop.
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -0.125rem;
  }

  display: flex;
  justify-content: center;
  margin-block: 1.25rem 0.25rem;

  @media (max-width: 52rem) {
    margin-block: 3.25rem 0.25rem;
  }

  .title-block {
    $radius: 1rem;
    $accent-length: $radius + 0.4rem;
    $frame-width: 1px;
    $accent-width: 3px;
    $accent-outset: ($accent-width - $frame-width) * 0.5;

    position: relative;
    padding: 1.5rem;
    max-width: 42rem;
    width: min(100%, 42rem);

    @media (max-width: 52rem) {
      padding: 1rem;
    }

    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;

    border-radius: $radius;
    background: var(--surface-page);
    box-shadow: var(--sheet-lift);

    /* Frame + corner accents share one rounded path; accent is wider and
       outset so its stroke stays centered on the frame. */
    &::before,
    &::after {
      content: '';
      position: absolute;
      border-style: solid;
      pointer-events: none;
    }

    &::before {
      inset: 0;
      border-width: $frame-width;
      border-color: var(--line-strong);
      border-radius: inherit;
    }

    &::after {
      top: -$accent-outset;
      right: -$accent-outset;
      bottom: -$accent-outset + 0.5px;
      left: -$accent-outset;
      border-width: $accent-width;
      border-color: var(--accent);
      border-radius: calc(#{$radius} + #{$accent-outset});
      mask-image: linear-gradient(#000, #000), linear-gradient(#000, #000);
      mask-size: $accent-length $accent-length;
      mask-position: 0 0, 100% 100%;
      mask-repeat: no-repeat;
    }

    .sheet-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5ch 0.75ch;
      margin: 0;
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 9vw, 3.25rem);
      line-height: 1.15;
      color: var(--ink);

      span {
        text-decoration: underline dotted;
        text-decoration-color: var(--accent-muted);
        text-underline-offset: 4px;
      }

      ruby {
        letter-spacing: 3px;

        :is(rp, rt) {
          opacity: 0;
          transition: opacity 250ms ease;
        }
      }
    }

    .sheet-role {
      margin: 0;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .contact {
      margin: 0.125rem 0 0;
      font-style: normal;
      font-size: 0.75rem;
      letter-spacing: 0.06em;

      ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0 0.5ch;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li {
        display: inline-flex;
        align-items: center;
      }

      li + li::before {
        content: "·";
        margin-inline-end: 0.5ch;
        color: var(--ink-faint);
      }

      :global(a) {
        display: inline-flex;
        align-items: center;
        min-height: 1.5rem;
        color: var(--ink-muted);
        text-decoration: underline dotted;
        text-decoration-color: var(--accent-muted);
        text-underline-offset: 0.25em;

        &:hover,
        &:focus-visible {
          color: var(--accent-text);
          text-decoration-style: solid;
          text-decoration-color: currentColor;
        }

        &:focus-visible {
          outline: 2px solid var(--accent);
          outline-offset: 0.125rem;
          border-radius: 0.125rem;
        }
      }
    }

    .note-row {
      font-size: 0.875em;
      color: var(--ink-faint);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5ch;
      width: fit-content;
      @include hit-area;
    }

    /* The player is 300px wide by default and still takes its room while hidden, so on a
       phone narrower than that it pushed the page past the screen. */
    audio {
      max-width: 100%;
      opacity: 0;
      visibility: hidden;
      transition: opacity 250ms ease, visibility 0s 250ms;
    }

    /* Match or beat the ruby hide rule specificity */
    &:is(:hover, :focus-within, :has(input:checked)) {
      audio,
      h1 ruby :is(rp, rt) {
        opacity: 1;
      }
    }

    /* Not on focus-within: the player is only reachable once asked for, or the keyboard would
       walk its controls on the way past the name. */
    &:is(:hover, :has(input:checked)) audio {
      visibility: visible;
      transition-delay: 0s;
    }
  }
}
</style>
