<style lang="scss">
header {
  display: flex;
  justify-content: center;
  margin-block: 1.25rem 0.25rem;

  @media (max-width: 52rem) {
    margin-block: 3.25rem 0.25rem;
  }

  .title-block {
    $radius: 1rem;
    $accent-length: $radius + 0.4rem;
    $frame-width: 1px;
    $accent-width: 3px;
    $accent-outset: ($accent-width - $frame-width) * 0.5;

    position: relative;
    padding: 2.5rem 1.5rem 1.5rem;
    max-width: 42rem;
    width: min(100%, 42rem);

    @media (max-width: 52rem) {
      padding: 1.75rem 1rem 1.15rem;
    }

    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;

    border-radius: $radius;
    background: color-mix(in oklch, var(--surface-raised), transparent 35%);

    /* Frame + corner accents share one rounded path; accent is wider and
       outset so its stroke stays centered on the frame. */
    &::before,
    &::after {
      content: '';
      position: absolute;
      border-style: solid;
      pointer-events: none;
    }

    &::before {
      inset: 0;
      border-width: $frame-width;
      border-color: var(--line-strong);
      border-radius: inherit;
    }

    &::after {
      top: -$accent-outset;
      right: -$accent-outset;
      bottom: -$accent-outset + 0.5px;
      left: -$accent-outset;
      border-width: $accent-width;
      border-color: var(--accent);
      border-radius: calc(#{$radius} + #{$accent-outset});
      mask-image: linear-gradient(#000, #000), linear-gradient(#000, #000);
      mask-size: $accent-length $accent-length;
      mask-position: 0 0, 100% 100%;
      mask-repeat: no-repeat;
    }

    .sheet-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5ch 0.75ch;
      margin: 0;
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 9vw, 3.25rem);
      line-height: 1.15;
      color: var(--ink);

      span {
        text-decoration: underline dotted;
        text-decoration-color: var(--accent-muted);
        text-underline-offset: 4px;
      }

      ruby {
        letter-spacing: 3px;

        :is(rp, rt) {
          opacity: 0;
          transition: opacity 250ms ease;
        }
      }
    }

    .sheet-role {
      margin: 0;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .note-row {
      color: var(--ink-faint);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5ch;
      width: fit-content;
    }

    audio {
      opacity: 0;
      transition: opacity 250ms ease;
    }

    /* Match or beat the ruby hide rule specificity */
    &:is(:hover, :has(input:checked)) {
      audio,
      h1 ruby :is(rp, rt) {
        opacity: 1;
      }
    }
  }
}
</style>
