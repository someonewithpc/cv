---
import site from './site.json';
import ContributionRow from './ContributionRow.astro';
import SectionHeader from './SectionHeader.astro';
import Highlights from './Highlights.astro';

const { highlights, groups } = site;

const statistics = {
  merged: groups.find((group) => group.id === 'merged')?.items.length ?? 0,
  open: groups.find((group) => group.id === 'open')?.items.length ?? 0,
  closed: groups.find((group) => group.id === 'closed')?.items.length ?? 0,
};
---

<section id="open-source" aria-labelledby="open-source-heading">
  <SectionHeader statistics={statistics} />

  <Highlights highlights={highlights} />

  {groups.map(({ id, label, items }) => (
    <section data-group={id} aria-labelledby={`group-${id}`}>
      <h3 id={`group-${id}`} class="tab marker-font">
        <span>{label}</span>
        <data value={items.length}>{items.length}</data>
      </h3>

      <div class="folder">
        <div class="ledger">
          <header aria-hidden="true">
            <span>Tech</span>
            <span>Repo</span>
            <span>Contribution</span>
          </header>

          {items.map((entry) => (
            <ContributionRow {...entry} status={id} />
          ))}
        </div>
      </div>
    </section>
  ))}
</section>

<style lang="scss">
#open-source {
  --cell-x: 1.25rem;
  --row-height: 3.75rem;
  --grid: 5.5rem minmax(14rem, 20rem) minmax(0, 1fr);
  /* The ledger's red margin rule runs down the gap after the tech column. */
  --margin-x: calc(var(--cell-x) + 5.5rem + 0.625rem);
  --ledger-rule: color-mix(in oklch, var(--line), var(--blueprint) 40%);
  --ledger-margin: oklch(0.62 0.17 25 / 0.55);

  container-type: inline-size;
  margin-top: clamp(5rem, 12vw, 8rem);
  padding-bottom: 2rem;

  :global([lang='ja']) {
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
  }

  /* Each group is a manila folder with its tab cut a third of the way along,
     and the ruled page inside it is the ledger. */
  > section {
    --tab-x: 0%;

    &:nth-of-type(2) {
      --tab-x: 32%;
    }

    &:nth-of-type(3) {
      --tab-x: 64%;
    }

    &[data-group='merged'] {
      --row-accent: hsl(145 42% 38%);
    }

    &[data-group='open'] {
      --row-accent: var(--accent);
    }

    &[data-group='closed'] {
      --row-accent: var(--ink-faint);
    }

    &[data-group='patch'],
    &[data-group='mailing_list'],
    &[data-group='project'] {
      --row-accent: var(--accent-muted);
    }

    & + section {
      margin-top: 2.5rem;
    }

    .tab {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: baseline;
      gap: 0.75rem;
      max-width: 36%;
      margin-inline-start: var(--tab-x);
      margin-bottom: -1px;
      padding: 0.5rem 1rem 0.375rem;
      border-radius: 0.375rem 0.375rem 0 0;
      font-size: 1rem;
      line-height: 1.2;
      white-space: nowrap;
      color: var(--ink);
      background: var(--theme-folder);
      box-shadow:
        inset 1px 1px 0 rgb(255 255 255 / 0.18),
        0 -1px 0 rgb(0 0 0 / 0.12);

      data {
        font-size: 0.875rem;
        color: var(--ink-muted);
      }
    }

    .folder {
      container-type: inline-size;
      padding: 0.75rem;
      border-radius: 0.25rem;
      background: var(--theme-folder);
      box-shadow:
        inset 1px 1px 0 rgb(255 255 255 / 0.18),
        0 0 0 1px rgb(0 0 0 / 0.12),
        0 0.125rem 0.25rem rgb(0 0 0 / 0.22),
        0 1rem 2rem -0.75rem rgb(0 0 0 / 0.5);
    }

    .ledger {
      --surface-raised: var(--theme-paper);

      display: grid;
      grid-template-columns: minmax(0, 1fr);
      border-radius: 0.125rem;
      color: var(--ink);
      background:
        linear-gradient(to right, transparent var(--margin-x), var(--ledger-margin) var(--margin-x), var(--ledger-margin) calc(var(--margin-x) + 1px), transparent 0),
        var(--theme-paper);
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.1),
        0 1px 2px rgb(0 0 0 / 0.2);
      overflow: hidden;

      > header,
      :global(.row) {
        display: grid;
        grid-template-columns: var(--grid);
        column-gap: 1.25rem;
        align-items: center;
        min-height: var(--row-height);
        padding-inline: var(--cell-x);
        box-sizing: border-box;

        > * {
          min-width: 0;
        }
      }

      > header {
        padding-block: 0.75rem;
        border-bottom: 1px solid var(--ledger-rule);
        font-family: monospace, system-ui;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-faint);

        span {
          overflow-wrap: break-word;
        }

        span:first-child {
          justify-self: center;
          text-align: center;
        }
      }

      :global(.row) {
        grid-template-rows: auto auto;
        min-width: 0;
        border-top: 1px solid var(--ledger-rule);

        ul {
          justify-self: center;
        }
      }
    }

    @container (max-width: 50rem) {
      --cell-x: 0.75rem;
      --row-height: 4.5rem;
      --grid: minmax(3rem, 4rem) repeat(2, minmax(0, 1fr));
      --margin-x: calc(var(--cell-x) + 4rem + 0.375rem);

      .ledger > header,
      .ledger :global(.row) {
        column-gap: 0.75rem;
      }

      .ledger > header {
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
      }
    }

    @container (max-width: 28rem) {
      --grid: 1.75rem minmax(0, 1fr);
      --margin-x: calc(var(--cell-x) + 1.75rem + 0.325rem);

      .folder {
        padding: 0.5rem;
      }

      .ledger > header {
        display: none;
      }

      .ledger > header,
      .ledger :global(.row) {
        column-gap: 0.65rem;
      }
    }
  }
}
</style>
