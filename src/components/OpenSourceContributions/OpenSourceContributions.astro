---
import site from './site.json';
import ContributionRow from './ContributionRow.astro';
import SectionHeader from './SectionHeader.astro';
import Highlights from './Highlights.astro';
import { tear, TEAR_TILE } from './tear';

const { highlights, groups } = site;

/* Drawn at the deepest tear any sheet uses; a narrow sheet squeezes the same tile shallower.
   Written once on the section, so the three sheets share one copy of each image. */
const top = tear(11, 24, 'top');
const bottom = tear(29, 24, 'bottom');
const edges = [
  `--tear-tile: ${TEAR_TILE}`,
  `--tear-top: ${top.mask}`,
  `--tear-bottom: ${bottom.mask}`,
  `--core-top: ${top.core}`,
  `--core-bottom: ${bottom.core}`,
  `--shade-top: ${top.shade}`,
  `--shade-bottom: ${bottom.shade}`,
].join('; ');

const statistics = {
  merged: groups.find((group) => group.id === 'merged')?.items.length ?? 0,
  open: groups.find((group) => group.id === 'open')?.items.length ?? 0,
  closed: groups.find((group) => group.id === 'closed')?.items.length ?? 0,
};
---

<section id="open-source" aria-labelledby="open-source-heading" style={edges} tabindex="-1" accesskey="o">
  <div class="intro">
    <SectionHeader statistics={statistics} />

    <Highlights highlights={highlights} />
  </div>

  {groups.map(({ id, label, items }, index) => (
    <div class="sheet" style={`--tear-shift: ${index * -4.5}rem`}>
      <section data-group={id} aria-labelledby={`group-${id}`}>
        <h3 id={`group-${id}`}>
          <span class="typewriter">{label}</span>
          <data value={items.length}>{items.length}</data>
        </h3>

        <div class="lines">
          <header aria-hidden="true">
            <span>Tech</span>
            <span>Repo</span>
            <span>Contribution</span>
          </header>

          {items.map((entry) => (
            <ContributionRow {...entry} status={id} />
          ))}
        </div>
      </section>
    </div>
  ))}
</section>

<style lang="scss">
@use "@/scss/_colors.scss" as colors;
@use "@/scss/_ruled.scss" as ruled;

#open-source {
  --cell-x: 1.25rem;
  --grid: 5.5rem minmax(14rem, 20rem) minmax(0, 1fr);
  --sheet-gap: 2rem;
  /* The contributions are copy, so they are set at the reader's own text size. */
  --line-size: 1rem;

  container-type: inline-size;
  margin-top: clamp(5rem, 12vw, 8rem);
  padding-bottom: 5rem;

  // tabindex="-1": the accesskey's landing spot, not a Tab stop.
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -0.125rem;
  }

  /* Layout.astro lays every band down as a sheet of paper on the desk. This band is not one
     sheet: it is the heading on a sheet and then a sheet of ruled paper per group, each one
     torn along the top and the bottom. So the band gives its own paper up, the sheets inside
     carry it and the wood shows in the gaps between them. The id is doubled to outrank the
     layout's `#main > *`. */
  &#open-source {
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  /* Narrow, the intro is paper with no rim of its own, so it takes the page gutter: the inset
     the cutting mat gives the Demos title. */
  .intro {
    padding: var(--page-gap);
    border-radius: 0.25rem;
    background: var(--surface-page);
    box-shadow: var(--sheet-lift);
  }

  @media (width > 64rem) {
    &#open-source {
      --sheet-gap: var(--desk-gap);

      margin-top: 0;
      padding: 0;
      border: 0;
    }

    .intro {
      padding: var(--sheet-pad);
      border: 1px solid var(--line);
      border-radius: 0.25rem;
      background: var(--surface-page);
      box-shadow: var(--sheet-lift);

      /* The contributions paper carries its own number, not a fraction of the drawing pages':
         these sheets are meant to read as the rougher paper of the two. Same on the torn
         pages below. */
      @include colors.paper-grain(0.25rem, $opacity: var(--theme-paper-sheet-grain, 0));
    }
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
    background-image: linear-gradient(transparent, transparent);
  }

  /* The last highlight closes the intro; the gap down to the first sheet is the stack's. */
  .intro > :global(article:last-of-type) {
    margin-bottom: 0;
  }

  /* A mask cuts a box-shadow away along with the paper, so the lift belongs to a wrapper and
     is a drop-shadow, which follows the torn edge instead of the box. */
  .sheet {
    filter:
      drop-shadow(0 1px 1px rgb(0 0 0 / 10%))
      drop-shadow(0 0.5rem 0.9rem rgb(0 0 0 / 14%));
  }

  .intro + .sheet,
  .sheet + .sheet {
    margin-top: var(--sheet-gap);
  }

  section[data-group] {
    /* One contribution to a line, each written in the band between two rules. The ruling is
       half as wide again as the line the writing would take on its own, so every band has
       room above and below its line; a row is one band tall, a row whose title wraps is two,
       and every line in it is centred in its band (src/scss/_ruled.scss). */
    --line-height: 1.25rem;
    --rule-pitch: calc(var(--line-height) * 1.5);
    /* How deep the tear eats into the sheet, top and bottom. */
    --tear: 1.5rem;
    --paper-x: 1.5rem;
    --margin-x: 3.25rem;
    /* The paper above and below the writing is a whole number of bands too, so the sheet is
       ruled from its own top edge and the rules run on evenly off both tears. */
    --paper-top: round(up, var(--tear) + 0.5rem, var(--rule-pitch));
    --paper-bottom: round(up, var(--tear) + 1rem, var(--rule-pitch));

    --paper: var(--surface-page);
    --rule-ink: light-dark(
      color-mix(in oklch, var(--ink), transparent 86%),
      color-mix(in oklch, var(--ink), transparent 80%)
    );
    --margin-ink: light-dark(
      color-mix(in oklch, oklch(0.56 0.19 27), transparent 45%),
      color-mix(in oklch, oklch(0.66 0.17 27), transparent 66%)
    );
    /* The inside of the paper, which a tear lays bare between the face and the back: whiter
       than the face on a light sheet, where the face has the grain on it and the inside does
       not, and a lighter, greyer fibre on a dark one. */
    --fibre: light-dark(
      color-mix(in oklch, var(--paper), white 80%),
      color-mix(in oklab, var(--paper), oklch(0.8 0.006 85) 40%)
    );

    display: block;
    /* With no margin the writing starts where the paper's own edge room ends. */
    padding:
      var(--paper-top)
      var(--paper-x)
      var(--paper-bottom)
      max(var(--paper-x), var(--margin-x) + 0.875rem);
    background-color: var(--paper);
    /* The ruling, then the margin line. The ruling is one pitch-tall tile repeated down the
       sheet from the top of the first band, with its rule in the tile's last pixel, so a rule
       closes every band and the ruling runs on past the writing and off both torn edges. */
    background-image:
      linear-gradient(
        to bottom,
        transparent calc(var(--rule-pitch) - 1px),
        var(--rule-ink) 0,
        var(--rule-ink) 100%
      ),
      linear-gradient(
        to right,
        transparent calc(var(--margin-x) - 1px),
        var(--margin-ink) 0,
        var(--margin-ink) var(--margin-x),
        transparent 0
      );
    background-size: 100% var(--rule-pitch), 100% 100%;
    background-position: 0 var(--paper-top), 0 0;
    background-repeat: repeat, no-repeat;

    // The grain sits on its own pseudo-element (see the mixin), so it never has to join this
    // background-image stack or its size/position/repeat lists.
    @include colors.paper-grain($opacity: var(--theme-paper-sheet-grain, 0));

    /* Each torn edge is a tile drawn at build time (tear.ts) and laid side by side along the
       sheet at its own size, so the edge is as fine on a phone as on a wide screen. The
       section hands the tiles down; --tear-shift slides them along so no two sheets tear
       alike. The sides stay cut straight. */
    mask-image: var(--tear-top), linear-gradient(#000, #000), var(--tear-bottom);
    mask-size:
      var(--tear-tile) var(--tear),
      100% calc(100% - var(--tear) * 2),
      var(--tear-tile) var(--tear);
    mask-position:
      var(--tear-shift, 0rem) top,
      0 var(--tear),
      calc(var(--tear-shift, 0rem) - 6.5rem) bottom;
    mask-repeat: repeat-x, no-repeat, repeat-x;

    /* Where the tear split the paper, the inside shows between the face and the back, with the
       face's own shadow along it. Painted through the same tiles at the same place. */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background-color: var(--fibre);
      background-image: var(--shade-top), var(--shade-bottom);
      mask-image: var(--core-top), var(--core-bottom);
      background-size: var(--tear-tile) var(--tear);
      mask-size: var(--tear-tile) var(--tear);
      background-position:
        var(--tear-shift, 0rem) top,
        calc(var(--tear-shift, 0rem) - 6.5rem) bottom;
      mask-position:
        var(--tear-shift, 0rem) top,
        calc(var(--tear-shift, 0rem) - 6.5rem) bottom;
      background-repeat: repeat-x;
      mask-repeat: repeat-x;
      pointer-events: none;
    }

    &[data-group='merged'] {
      --row-accent: hsl(145 42% 38%);
    }

    &[data-group='open'] {
      --row-accent: var(--accent);
    }

    &[data-group='closed'] {
      --row-accent: var(--ink-faint);
    }

    /* The group's name is written in the first band, the way a heading is on a page. The
       count is centred in the band and the name stands on the count's baseline. Special
       Elite gives its cap height as about half the real one, so trimming the name to its own
       cap height would centre it two pixels high. Its line box is kept short so that standing
       it on the count never makes the heading taller than its band. */
    h3 {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      margin: 0;
      font-size: 0.875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-muted);

      > :not(data) {
        line-height: 1;
      }

      data {
        @include ruled.between-the-rules($caps: true);


        font-family: monospace, system-ui;
        font-size: 0.875rem;
        color: var(--ink-faint);
      }
    }

    .lines {
      /* The repository takes only the width it needs, so the contribution gets the rest and
         reaches the end of its line before it has to wrap onto the next one. */
      --grid: 4rem minmax(11rem, 18rem) minmax(0, 1fr);

      container-type: inline-size;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      font-size: var(--line-size);

      > header,
      :global(.row) {
        display: grid;
        grid-template-columns: var(--grid);
        column-gap: var(--column-gap, 0.75rem);
        /* Every cell's first line lands on the same rule, so a row whose title wraps keeps
           its technologies and its repository up on that line rather than centred across
           both of them. */
        align-items: start;
        min-height: var(--rule-pitch);
        box-sizing: border-box;

        > * {
          min-width: 0;
        }
      }

      > header {
        font-family: monospace, system-ui;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-faint);

        span {
          @include ruled.between-the-rules($caps: true);

          overflow-wrap: break-word;
        }

        span:first-child {
          justify-self: center;
          text-align: center;
        }
      }

      :global(.row) {
        grid-template-rows: auto auto;
        min-width: 0;

        ul {
          justify-self: center;
        }
      }

      /* The columns follow the width the writing really has, the width of .lines itself, the
         same width ContributionRow.astro stacks a row by. So the header and the rows are
         answered by .lines, not by the section around it. */
      > header,
      :global(.row) {
        @container (max-width: 50rem) {
          --grid: minmax(3rem, 4rem) repeat(2, minmax(0, 1fr));
        }

        /* Past this a title beside its repository gets fewer words to a line than one written
           under it, so the repository stands over the title and the marks keep a narrow
           column of their own. */
        @container (max-width: 36rem) {
          --grid: 1.75rem minmax(0, 1fr);
          --column-gap: 0.65rem;
        }

        /* Then the marks' column and the gap beside it give way to the title. */
        @container (max-width: 26rem) {
          --grid: 1.25rem minmax(0, 1fr);
          --column-gap: 0.5rem;
        }
      }

      > header {
        @container (max-width: 50rem) {
          font-size: 0.625rem;
          letter-spacing: 0.06em;
        }

        @container (max-width: 36rem) {
          display: none;
        }
      }
    }

    /* A narrowing sheet gives its margin up first. It closes to half its width, then goes,
       red rule and all. */
    @container (max-width: 50rem) {
      --margin-x: 1.75rem;
    }

    @container (max-width: 40rem) {
      --margin-x: 0rem;
      --margin-ink: transparent;
    }

    /* A narrow sheet: wider ruling, so a title link stays a comfortable thing to hit with a
       thumb. */
    @container (max-width: 34rem) {
      --line-height: 1.5rem;
      --tear: 1rem;
      --paper-x: 0.875rem;
    }
  }
}
</style>
