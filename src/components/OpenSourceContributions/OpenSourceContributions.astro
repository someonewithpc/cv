---
import Band from '@/components/Band.astro';

import site from './site.json';
import BacktickText from './BacktickText.astro';
import ContributionRow from './ContributionRow.astro';
import SectionHeader from './SectionHeader.astro';
import Highlights from './Highlights.astro';

const { highlights, groups } = site;

type Item = (typeof groups)[number]['items'][number];

// The pull quote of a group is its biggest change by lines touched.
const largestChange = (items: Item[]) =>
  items
    .filter((item) => item.stats && item.description && item.number != null)
    .sort((a, b) => (b.stats!.additions + b.stats!.deletions) - (a.stats!.additions + a.stats!.deletions))[0];

const statistics = {
  merged: groups.find((group) => group.id === 'merged')?.items.length ?? 0,
  open: groups.find((group) => group.id === 'open')?.items.length ?? 0,
  closed: groups.find((group) => group.id === 'closed')?.items.length ?? 0,
};
---

<section id="open-source" class="full-width" aria-labelledby="open-source-heading">
  <Band number={4} material="vellum">
    <div class="sheet">
      <SectionHeader statistics={statistics} />

      <Highlights highlights={highlights} />
    </div>
  </Band>

  <Band number={5} material="ledger">
  <div class="sheet">
  {groups.map(({ id, label, items }) => {
    const pull = largestChange(items);

    return (
    <section data-group={id} aria-labelledby={`group-${id}`}>
      <h3 id={`group-${id}`}>
        <span class="typewriter">{label}</span>
        <data value={items.length}>{items.length}</data>
      </h3>

      {pull && (
        <figure class="pull">
          <blockquote cite={pull.url}>
            <p><BacktickText text={pull.description!} /></p>
          </blockquote>
          <figcaption>
            <cite>{pull.repository}#{pull.number}</cite>, the biggest change here:
            <data value={pull.stats!.additions}>+{pull.stats!.additions}</data>
            <data value={pull.stats!.deletions}>−{pull.stats!.deletions}</data>
          </figcaption>
        </figure>
      )}

      <div>
        <header aria-hidden="true">
          <span>Tech</span>
          <span>Repo</span>
          <span>Contribution</span>
        </header>

        {items.map((entry) => (
          <ContributionRow {...entry} status={id} />
        ))}
      </div>
    </section>
    );
  })}
  </div>
  </Band>
</section>

<style lang="scss">
#open-source {
  --cell-x: 1.25rem;
  --row-height: 3.75rem;
  --grid: 5.5rem minmax(14rem, 20rem) minmax(0, 1fr);

  display: grid;
  grid-template-columns: subgrid;

  /* The container the header, highlights and rows query. Not the section itself: a size
     container cannot be a subgrid, and the bands need the section to be one. */
  .sheet {
    container-type: inline-size;
  }

  :global([lang='ja']) {
    display: block;
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--ink-faint), transparent 20%);
    margin-inline-start: -0.125rem;
  }

  .sheet > section {
    &[data-group='merged'] {
      --row-accent: hsl(145 42% 38%);
    }

    &[data-group='open'] {
      --row-accent: var(--accent);
    }

    &[data-group='closed'] {
      --row-accent: var(--ink-faint);
    }

    &[data-group='patch'],
    &[data-group='mailing_list'],
    &[data-group='project'] {
      --row-accent: var(--accent-muted);
    }

    & + section {
      margin-top: 3.5rem;
    }

    /* The group head is a row of its own: label on the left, the biggest change quoted on the
       right, the ledger below both. */
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    column-gap: 3rem;
    row-gap: 1.25rem;
    align-items: end;

    @container (max-width: 50rem) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
    }

    > div {
      grid-column: 1 / -1;
    }

    .pull {
      margin: 0;
      display: grid;
      gap: 0.5rem;

      blockquote,
      p {
        margin: 0;
      }

      p {
        font-family: "Special Elite", monospace, system-ui;
        font-size: var(--type-quote);
        line-height: 1.35;
        color: var(--ink);
        text-wrap: pretty;

        &::before,
        &::after {
          color: var(--accent-text);
        }

        &::before {
          content: open-quote;
        }

        &::after {
          content: close-quote;
        }
      }

      figcaption {
        font-family: monospace, system-ui;
        font-variant-numeric: tabular-nums;
        font-size: var(--type-small);
        line-height: 1.5;
        color: var(--ink-faint);

        cite {
          font-style: normal;
          color: var(--ink-muted);
        }

        data:first-of-type {
          color: hsl(145 42% 38%);
        }

        data:last-of-type {
          color: hsl(0 48% 46%);
        }
      }
    }

    h3 {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      margin-bottom: 0;
      font-size: 0.875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-muted);

      data {
        font-family: monospace, system-ui;
        font-variant-numeric: tabular-nums;
        font-size: 0.8125rem;
        color: var(--ink-faint);
      }
    }

    > div {
      container-type: inline-size;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      border: 1px solid var(--line);
      border-left: 3px solid var(--row-accent, var(--line-strong));
      border-radius: 0.5em;
      background: var(--surface-raised);
      overflow: hidden;

      > header,
      :global(.row) {
        display: grid;
        grid-template-columns: var(--grid);
        column-gap: 1.25rem;
        align-items: center;
        min-height: var(--row-height);
        padding-inline: var(--cell-x);
        box-sizing: border-box;

        > * {
          min-width: 0;
        }
      }

      > header {
        padding-block: 0.75rem;
        border-bottom: 1px solid var(--line);
        background: var(--surface-raised);
        font-family: monospace, system-ui;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-faint);

        span {
          overflow-wrap: break-word;
        }

        span:first-child {
          justify-self: center;
          text-align: center;
        }
      }

      :global(.row) {
        grid-template-rows: auto auto;
        min-width: 0;
        border-top: 1px solid var(--line);
        background: var(--surface-raised);

        ul {
          justify-self: center;
        }
      }

      @container (max-width: 50rem) {
        --cell-x: 0.75rem;
        --row-height: 4.5rem;
        --grid: minmax(3rem, 4rem) repeat(2, minmax(0, 1fr));

        > header,
        :global(.row) {
          column-gap: 0.75rem;
        }

        > header {
          font-size: 0.6875rem;
          letter-spacing: 0.06em;
        }
      }

      @container (max-width: 28rem) {
        --grid: 1.75rem minmax(0, 1fr);

        > header {
          display: none;
        }

        > header,
        :global(.row) {
          column-gap: 0.65rem;
        }
      }
    }
  }
}
</style>
