---
import { Icon } from 'astro-icon/components';

import BacktickText from '@/components/OpenSourceContributions/BacktickText.astro';

import { resolveTechTagByIconSuffix } from '@/server/tech-tags';

type Props = {
  tags: string[];
  status: string;
  repository: string;
  title: string;
  description: string | null;
  url: string;
  number: number | null;
  stats: {
    additions: number;
    deletions: number;
    changed_files: number;
  } | null;
  updatedAt: string | null;
};

const {
  tags,
  status,
  repository,
  title,
  description,
  url,
  number,
  stats,
  updatedAt,
} = Astro.props;

const hasMeta = updatedAt || stats;
---

<details data-status={status}>
  <summary>
    <ul aria-label="Technologies">
      {tags.map((suffix) => {
        const resolved = resolveTechTagByIconSuffix(suffix);

        return resolved && (
          <li>
            <Icon name={resolved.icon} title={resolved.text} is:inline />
          </li>
        );
      })}
    </ul>

    <cite>{repository}{number !== null && `#${number}`}</cite>

    <a
      href={url}
      rel="noopener noreferrer"
      target="_blank"
      aria-label={`${title} (${repository})`}
    >
      <BacktickText text={title} />
    </a>
  </summary>

  {description && (
    <p><BacktickText text={description} /></p>
  )}

  {hasMeta && (
    <footer>
      {updatedAt && (
        <time datetime={updatedAt}>{updatedAt.slice(0, 10)}</time>
      )}
      {stats && (
        <span class="diff-stats">
          {updatedAt && ' · '}
          <span class="additions">+{stats.additions}</span>
          {' '}
          <span class="deletions">−{stats.deletions}</span>
          {' · '}
          <span class="files">{stats.changed_files} files</span>
        </span>
      )}
    </footer>
  )}
</details>

<style lang="scss">
details {
  &[data-status='merged'] {
    --row-accent: hsl(145 42% 38%);
  }

  &[data-status='open'] {
    --row-accent: var(--accent-700);
  }

  &[data-status='closed'] {
    --row-accent: var(--fg-600);
  }

  &[data-status='patch'],
  &[data-status='mailing_list'],
  &[data-status='project'] {
    --row-accent: var(--accent-650);
  }

  > summary {
    ul {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      list-style: none;

      li {
        display: flex;
        line-height: 0;
        min-height: 3rem;
        align-items: center;
        justify-content: center;

        :global(svg) {
          width: 1.375rem;
          height: 1.375rem;
        }
      }
    }

    cite {
      font-family: monospace, system-ui;
      font-style: normal;
      color: var(--fg-750);
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    a {
      font-family: sans-serif;
      color: var(--fg-900);
      line-height: 1.4;
      text-decoration: none;
      text-underline-offset: 0.15em;

      &:hover {
        color: var(--accent-750);
        text-decoration: underline;
      }
    }
  }

  &[open] > summary {
    background: var(--bg-825);
  }

  > p,
  > footer {
    padding: 0 var(--cell-x) 1rem calc(var(--cell-x) + 3px);
    background: color-mix(in oklab, var(--bg-875), var(--row-accent, var(--fg-700)) 8%);
    font-family: sans-serif;
  }

  > :not(summary):first-of-type {
    padding-top: 0.875rem;
    box-shadow: inset 0 1px 0 var(--fg-875);
  }

  > p {
    margin: 0;
    line-height: 1.65;
    color: var(--fg-800);
  }

  > footer {
    margin-top: 0.625rem;
    padding-top: 0.625rem;
    border-top: 1px solid color-mix(in oklab, var(--fg-875), transparent 40%);
    font-family: monospace, system-ui;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--fg-650);

    .additions {
      font-weight: 600;
      color: hsl(145 42% 38%);
    }

    .deletions {
      font-weight: 600;
      color: hsl(0 48% 46%);
    }

    .files {
      color: var(--accent-750);
    }
  }
}
</style>
