---
import { Icon } from 'astro-icon/components';

import BacktickText from '@/components/OpenSourceContributions/BacktickText.astro';
import TechIcon from '@/components/TechIcon.astro';

import { resolveTechByIconSuffix } from '@/server/tech-icons';

type Props = {
  tags: string[];
  status: string;
  repository: string;
  title: string;
  description?: string | null;
  url: string;
  number?: number | null;
  stats?: {
    additions: number;
    deletions: number;
    changed_files: number;
  } | null;
  updatedAt?: string | null;
};

const {
  tags,
  status,
  repository,
  title,
  description,
  url,
  number,
  stats,
  updatedAt,
} = Astro.props;

const hasMeta = updatedAt || stats;

const rowLabel = `${repository}${number == null ? '' : `#${number}`}: ${title.replaceAll('`', '')}`;
---

<div class="row" data-status={status}>
  <ul aria-label="Technologies">
    {tags.map((suffix) => {
      const resolved = resolveTechByIconSuffix(suffix);

      return resolved && (
        <li>
          <TechIcon tech={resolved} />
        </li>
      );
    })}
  </ul>

  <div class="meta">
    <cite>{repository}{number != null && `#${number}`}</cite>

    <a class="title" href={url} rel="noopener noreferrer" target="_blank"><span class="title-text"><BacktickText text={title} /></span><Icon name="lucide:external-link" class="external-link" aria-hidden="true" /><span class="sr-only"> ({repository}), opens in a new tab</span></a>
  </div>

  {/* The summary is the row: it lies under the technologies, the repository and
      the title, and only the title link is raised above it. Keeping the link out
      of the summary keeps one control from nesting inside another. */}
  <details>
    <summary aria-label={rowLabel}></summary>

    <div class="body">
      {description && (
        <p><BacktickText text={description} /></p>
      )}

      {hasMeta && (
        <footer>
          {updatedAt && (
            <time datetime={updatedAt}>{updatedAt.slice(0, 10)}</time>
          )}
          {stats && (
            <span class="diff-stats">
              {updatedAt && ' · '}
              <span class="additions">+{stats.additions}</span>
              {' '}
              <span class="deletions">−{stats.deletions}</span>
              {' · '}
              <span class="files">{stats.changed_files} files</span>
            </span>
          )}
        </footer>
      )}
    </div>
  </details>
</div>

<style lang="scss">
.row {
  > ul {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    /* The summary underneath is the toggle; only the title link takes clicks. */
    pointer-events: none;
    padding-block: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    list-style: none;

    li {
      display: flex;
      line-height: 0;
      min-height: 3rem;
      align-items: center;
      justify-content: center;

      :global(svg) {
        width: 1.375rem;
        height: 1.375rem;
      }
    }
  }

  .meta {
    display: contents;
  }

  cite {
    grid-area: 1 / 2;
    position: relative;
    z-index: 1;
    pointer-events: none;
    padding-block: 0.75rem;
    font-family: monospace, system-ui;
    font-style: normal;
    color: var(--ink-muted);
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .title {
    grid-area: 1 / 3;
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 1.5rem;
    padding-block: 0.125rem;
    /* A margin, not padding: the head keeps its breathing room without growing
       the link box the focus ring and the hover colour are drawn on. */
    margin-block: 0.625rem;
    display: block;
    width: fit-content;
    font-family: sans-serif;
    color: var(--ink);
    line-height: 1.4;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: none;
    text-wrap: pretty;

    /* The rule sits on the text, not on .title: an underline inherited from
       the wrapper would run under the mark as well in engines that paint it
       across a replaced inline. */
    .title-text {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    /* A margin rather than a space in the markup: a space would take the
       underline with it, and would let the mark wrap onto a line of its own. */
    .external-link {
      display: inline;
      width: 0.75em;
      height: 0.75em;
      margin-inline-start: 0.25em;
      vertical-align: -1px;
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 0.125rem;
      border-radius: 0.125rem;
    }
  }

  &:hover .title,
  &:has(> details > summary:focus-visible) .title,
  .title:hover {
    color: var(--accent-text);
  }

  > details {
    grid-column: 1 / -1;
    grid-row: 1 / 3;
    align-self: stretch;
    /* Back out of the row padding so the summary and the body run the full
       width of the row, as they did when the summary was the row. */
    margin-inline: calc(-1 * var(--cell-x));
    display: grid;
    /* Row 1 is the row head, row 2 the disclosed body: borrowing the row's own
       tracks keeps the summary exactly as tall as the head it covers. */
    grid-template-rows: subgrid;
    min-width: 0;

    > summary {
      grid-row: 1;
      list-style: none;
      cursor: pointer;
      transition: background 150ms ease;

      &::-webkit-details-marker {
        display: none;
      }

      &:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }
    }

    &[open] > summary {
      background: color-mix(in oklch, var(--row-accent, var(--line-strong)) 12%, transparent);
    }
  }

  &:hover > details > summary {
    background: color-mix(in oklch, var(--row-accent, var(--line-strong)) 12%, transparent);
  }

  .body {
    min-width: 0;
  }

  .body > p,
  .body > footer {
    padding: 0 var(--cell-x) 1rem;
    background: color-mix(in oklch, var(--row-accent, var(--line-strong)) 8%, transparent);
    font-family: sans-serif;
  }

  .body > :first-child {
    padding-top: 0.875rem;
    box-shadow: inset 0 1px 0 var(--line);
  }

  .body > p {
    margin: 0;
    line-height: 1.65;
    color: var(--ink-muted);
    overflow-wrap: break-word;
  }

  .body > footer {
    margin-top: 0.625rem;
    padding-top: 0.625rem;
    border-top: 1px solid color-mix(in oklch, var(--line), transparent 40%);
    font-family: monospace, system-ui;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-faint);

    .additions {
      font-weight: 600;
      color: hsl(145 42% 38%);
    }

    .deletions {
      font-weight: 600;
      color: hsl(0 48% 46%);
    }

    .files {
      color: var(--accent-text);
    }
  }

  @container (max-width: 28rem) {
    column-gap: 0.65rem;
    align-items: start;
    min-height: 0;

    > ul {
      padding-block: 0.85rem;
      flex-direction: column;
      flex-wrap: nowrap;
      align-self: center;

      li {
        min-height: 1.375rem;
      }
    }

    .meta {
      grid-area: 1 / 2;
      position: relative;
      z-index: 1;
      pointer-events: none;
      padding-block: 0.85rem;
      display: flex;
      flex-direction: column;
      row-gap: 0.35rem;
      min-width: 0;
    }

    cite,
    .title {
      grid-area: auto;
      position: static;
      z-index: auto;
      padding-block: 0;
      margin-block: 0;
    }

    cite {
      font-size: 0.75rem;
    }

    .title {
      /* The meta column ignores the pointer so the summary under it toggles;
         the link itself takes clicks back. */
      pointer-events: auto;
      padding-block: 0.125rem;
    }
  }

  @container (max-width: 24rem) {
    > ul {
      flex-direction: column;
      flex-wrap: nowrap;

      li {
        min-height: 1.375rem;
      }
    }
  }
}
</style>
