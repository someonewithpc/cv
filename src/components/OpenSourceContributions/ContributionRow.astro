---
import { Icon } from 'astro-icon/components';

import BacktickText from '@/components/OpenSourceContributions/BacktickText.astro';
import TechIcon from '@/components/TechIcon.astro';

import { resolveTechByIconSuffix } from '@/server/tech-icons';

type Props = {
  tags: string[];
  status: string;
  repository: string;
  title: string;
  description?: string | null;
  url: string;
  number?: number | null;
  stats?: {
    additions: number;
    deletions: number;
    changed_files: number;
  } | null;
  updatedAt?: string | null;
};

const {
  tags,
  status,
  repository,
  title,
  description,
  url,
  number,
  stats,
  updatedAt,
} = Astro.props;

const hasMeta = updatedAt || stats;

const rowLabel = `${repository}${number == null ? '' : `#${number}`}: ${title.replaceAll('`', '')}`;

// A row is one line of a ruled sheet, so a long name has to wrap where a reader would break
// it, after an owner or before an issue number, rather than in the middle of a word. null
// marks a break opportunity; the text either side of it is unchanged.
const citePieces: (string | null)[] = [];
repository.split('/').forEach((part, index) => {
  if (index > 0) citePieces.push('/', null);
  citePieces.push(part);
});
if (number != null) citePieces.push(null, `#${number}`);
---

<div class="row" data-status={status}>
  <ul aria-label="Technologies">
    {tags.map((suffix) => {
      const resolved = resolveTechByIconSuffix(suffix);

      return resolved && (
        <li>
          <TechIcon tech={resolved} />
        </li>
      );
    })}
  </ul>

  <div class="meta">
    <cite>{citePieces.map((piece) => (piece === null ? <wbr /> : piece))}</cite>

    <a class="title" href={url} rel="noopener noreferrer" target="_blank"><span class="title-text"><BacktickText text={title} /></span><Icon name="lucide:external-link" class="external-link" aria-hidden="true" /><span class="sr-only"> ({repository}), opens in a new tab</span></a>
  </div>

  {/* The summary is the row: it lies under the technologies, the repository and
      the title, and only the title link is raised above it. Keeping the link out
      of the summary keeps one control from nesting inside another. */}
  <details>
    <summary aria-label={rowLabel}></summary>

    <div class="body">
      {description && (
        <p><BacktickText text={description} /></p>
      )}

      {hasMeta && (
        <footer>
          {updatedAt && (
            <time datetime={updatedAt}>{updatedAt.slice(0, 10)}</time>
          )}
          {stats && (
            <span class="diff-stats">
              {updatedAt && ' · '}
              <span class="additions">+{stats.additions}</span>
              {' '}
              <span class="deletions">−{stats.deletions}</span>
              {' · '}
              <span class="files">{stats.changed_files} files</span>
            </span>
          )}
        </footer>
      )}
    </div>
  </details>
</div>

<style lang="scss">
@use "@/scss/_ruled.scss" as ruled;

.row {
  > ul {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    /* The summary underneath is the toggle; only the title link takes clicks. */
    pointer-events: none;
    /* The row is one band tall, so the marks stand centred in that band beside the writing
       and never wrap onto a second one. Three is the most any contribution carries. */
    height: var(--rule-pitch);
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    list-style: none;

    li {
      display: flex;
      line-height: 0;
      align-items: center;
      justify-content: center;

      :global(svg) {
        width: 1.125rem;
        height: 1.125rem;
      }
    }
  }

  .meta {
    display: contents;
  }

  cite {
    @include ruled.between-the-rules;

    grid-area: 1 / 2;
    position: relative;
    z-index: 1;
    pointer-events: none;
    font-family: monospace, system-ui;
    font-style: normal;
    color: var(--ink-muted);
    overflow-wrap: break-word;
  }

  .title {
    /* A title that fits is one band; a title that wraps is two, each line in its own band,
       because the line height is the ruling's own pitch. */
    @include ruled.between-the-rules;

    grid-area: 1 / 3;
    position: relative;
    z-index: 1;
    min-width: 0;
    display: block;
    width: fit-content;
    /* fit-content never goes under the longest identifier in the title, so without a cap one
       like assertStringable ran past a narrow column instead of breaking. */
    max-width: 100%;
    color: var(--ink);
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: none;
    text-wrap: pretty;
    /* The link's own underline would reach the text inside as well and draw a second, heavier
       line a pixel under the one .title-text draws. */
    text-decoration: none;

    /* The rule sits on the text, not on .title: an underline inherited from
       the wrapper would run under the mark as well in engines that paint it
       across a replaced inline. */
    .title-text {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.125em;
    }

    /* A margin rather than a space in the markup: a space would take the
       underline with it, and would let the mark wrap onto a line of its own. */
    .external-link {
      display: inline;
      width: 0.75em;
      height: 0.75em;
      margin-inline-start: 0.25em;
      vertical-align: -1px;
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 0.125rem;
      border-radius: 0.125rem;
    }
  }

  &:has(> details > summary:focus-visible) .title,
  .title:hover {
    color: var(--accent-text);
  }

  > details {
    grid-column: 1 / -1;
    grid-row: 1 / 3;
    align-self: stretch;
    display: grid;
    /* Row 1 is the row head, row 2 the disclosed body: borrowing the row's own
       tracks keeps the summary exactly as tall as the head it covers. */
    grid-template-rows: subgrid;
    min-width: 0;

    > summary {
      grid-row: 1;
      list-style: none;
      cursor: pointer;
      transition: background 150ms ease;

      &::-webkit-details-marker {
        display: none;
      }

      &:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }
    }

    /* A wash rather than a fill: the paper's ruling still runs under the row it marks. */
    &[open] > summary {
      background: color-mix(in oklch, transparent, var(--row-accent, var(--line-strong)) 14%);
    }
  }

  &:hover > details > summary {
    background: color-mix(in oklch, transparent, var(--row-accent, var(--line-strong)) 14%);
  }

  .body {
    min-width: 0;
  }

  /* The disclosed note is written on the same ruling as the rows: every line in it is one
     band tall and it carries no padding, margin or rule of its own, so opening a row still
     leaves every row under it sitting on a line. */
  .body > p,
  .body > footer {
    padding-inline: var(--cell-x);
    background: color-mix(in oklch, transparent, var(--row-accent, var(--line-strong)) 8%);
  }

  .body > p {
    @include ruled.between-the-rules;

    margin: 0;
    color: var(--ink-muted);
    overflow-wrap: break-word;
  }

  .body > footer {
    @include ruled.between-the-rules;

    font-family: monospace, system-ui;
    font-size: 0.75rem;
    color: var(--ink-faint);

    .additions {
      font-weight: 600;
      color: hsl(145 42% 38%);
    }

    .deletions {
      font-weight: 600;
      color: hsl(0 48% 46%);
    }

    .files {
      color: var(--accent-text);
    }
  }

  /* A narrow sheet stands the repository over the title, so the row is two bands and the
     marks run down the margin beside them. */
  @container (max-width: 36rem) {
    align-items: start;

    > ul {
      /* A column of marks down the margin beside two written lines: one mark to a band,
         centred in it. The column is exactly those two bands tall however many marks it
         holds, so it never makes the row longer than its writing and pushes every row under
         it off the ruling. */
      display: grid;
      grid-auto-rows: var(--rule-pitch);
      justify-items: center;
      height: calc(var(--rule-pitch) * 2);
      align-self: start;
      gap: 0;

      /* Three marks, the most a contribution carries, share the two lines between them. */
      &:has(> :nth-child(3)) {
        grid-auto-rows: calc(var(--rule-pitch) * 2 / 3);
      }

      :global(svg) {
        width: 1rem;
        height: 1rem;
      }
    }

    .meta {
      grid-area: 1 / 2;
      position: relative;
      z-index: 1;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    cite,
    .title {
      grid-area: auto;
      position: static;
      z-index: auto;
      font-size: 0.75rem;
    }

    .title {
      /* The meta column ignores the pointer so the summary under it toggles;
         the link itself takes clicks back. */
      pointer-events: auto;
    }
  }
}
</style>
