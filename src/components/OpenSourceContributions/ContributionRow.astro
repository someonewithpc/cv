---
import { Icon } from 'astro-icon/components';

import BacktickText from '@/components/OpenSourceContributions/BacktickText.astro';
import TechIcon from '@/components/TechIcon.astro';

import { resolveTechByIconSuffix } from '@/server/tech-icons';

type Props = {
  tags: string[];
  status: string;
  repository: string;
  title: string;
  description?: string | null;
  url: string;
  number?: number | null;
  stats?: {
    additions: number;
    deletions: number;
    changed_files: number;
  } | null;
  updatedAt?: string | null;
};

const {
  tags,
  status,
  repository,
  title,
  description,
  url,
  number,
  stats,
  updatedAt,
} = Astro.props;

const hasMeta = updatedAt || stats;
---

<details data-status={status}>
  <summary>
    <ul aria-label="Technologies">
      {tags.map((suffix) => {
        const resolved = resolveTechByIconSuffix(suffix);

        return resolved && (
          <li>
            <TechIcon tech={resolved} />
          </li>
        );
      })}
    </ul>

    <cite>{repository}{number != null && `#${number}`}</cite>

    <a
      href={url}
      rel="noopener noreferrer"
      target="_blank"
    >
      <BacktickText text={title} />
      <span class="sr-only"> ({repository}), opens in a new tab</span>
      <Icon name="lucide:external-link" class="external-link" aria-hidden="true" />
    </a>
  </summary>

  {description && (
    <p><BacktickText text={description} /></p>
  )}

  {hasMeta && (
    <footer>
      {updatedAt && (
        <time datetime={updatedAt}>{updatedAt.slice(0, 10)}</time>
      )}
      {stats && (
        <span class="diff-stats">
          {updatedAt && ' · '}
          <span class="additions">+{stats.additions}</span>
          {' '}
          <span class="deletions">−{stats.deletions}</span>
          {' · '}
          <span class="files">{stats.changed_files} files</span>
        </span>
      )}
    </footer>
  )}
</details>

<style lang="scss">
details {
  > summary {
    ul {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      list-style: none;

      li {
        display: flex;
        line-height: 0;
        min-height: 3rem;
        align-items: center;
        justify-content: center;

        :global(svg) {
          width: 1.375rem;
          height: 1.375rem;
        }
      }
    }

    cite {
      font-family: monospace, system-ui;
      font-style: normal;
      color: var(--ink-muted);
      line-height: 1.4;
      overflow-wrap: break-word;
    }

    a {
      min-width: 0;
      min-height: 1.5rem;
      padding-block: 0.125rem;
      display: inline-flex;
      align-items: center;
      font-family: sans-serif;
      color: var(--ink);
      line-height: 1.4;
      text-decoration: none;
      text-underline-offset: 0.15em;
      overflow-wrap: break-word;

      .external-link {
        width: 0.75em;
        height: 0.75em;
        margin-inline-start: 1ch;
        vertical-align: -0.1em;
      }

      &:hover {
        color: var(--accent);
        text-decoration: underline;
      }
    }
  }

  &[open] > summary {
    background: color-mix(in oklch, var(--surface-raised), var(--row-accent, var(--line-strong)) 10%);
  }

  > p,
  > footer {
    padding: 0 var(--cell-x) 1rem;
    background: color-mix(in oklch, var(--surface-raised), var(--row-accent, var(--line-strong)) 8%);
    font-family: sans-serif;
  }

  > :not(summary):first-of-type {
    padding-top: 0.875rem;
    box-shadow: inset 0 1px 0 var(--line);
  }

  > p {
    margin: 0;
    line-height: 1.65;
    color: var(--ink-muted);
    overflow-wrap: break-word;
  }

  > footer {
    margin-top: 0.625rem;
    padding-top: 0.625rem;
    border-top: 1px solid color-mix(in oklch, var(--line), transparent 40%);
    font-family: monospace, system-ui;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-faint);

    .additions {
      font-weight: 600;
      color: hsl(145 42% 38%);
    }

    .deletions {
      font-weight: 600;
      color: hsl(0 48% 46%);
    }

    .files {
      color: var(--accent);
    }
  }

  @container (max-width: 24rem) {
    > summary ul {
      flex-direction: column;
      flex-wrap: nowrap;

      li {
        min-height: 1.75rem;
      }
    }
  }
}
</style>
