---
const { statistics } = Astro.props;
---

<header>
  <h2 id="open-source-heading" class="tape">
    <small lang="ja">オープンソース</small>
    <span class="marker-font">Open Source</span>
  </h2>

  <dl class="tally">
    <div>
      <dt>
        <small lang="ja">マージ</small>
        Merged
      </dt>
      <dd>{statistics.merged}</dd>
    </div>
    <div>
      <dt>
        <small lang="ja">オープン</small>
        Open
      </dt>
      <dd>{statistics.open}</dd>
    </div>
    <div>
      <dt>
        <small lang="ja">クローズ</small>
        Closed
      </dt>
      <dd>{statistics.closed}</dd>
    </div>
  </dl>
</header>

<style lang="scss">
header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-end;
  gap: 1.5rem 3rem;
  margin-bottom: 3rem;

  /* The count, typed on a slip of paper dropped beside the label. */
  .tally {
    --surface-raised: var(--theme-paper);

    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    padding: 0.625rem 1rem 0.75rem;
    rotate: 1deg;
    color: var(--ink);
    background: var(--theme-paper);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.12),
      0 1px 2px rgb(0 0 0 / 0.25),
      0 0.5rem 1rem -0.5rem rgb(0 0 0 / 0.45);

    div {
      display: grid;
      gap: 0.25rem;
      min-width: 4rem;
    }

    dt {
      display: grid;
      justify-items: start;
      gap: 0.125rem;
      font-family: monospace, system-ui;
      font-size: 0.625rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);

      [lang='ja'] {
        font-size: 0.5625rem;
        letter-spacing: 0.08em;
      }
    }

    dd {
      font-family: "Special Elite", monospace, system-ui;
      font-size: 1.5rem;
      line-height: 1;
      color: var(--accent-text);
      border-bottom: 1px dashed var(--line-strong);
      padding-bottom: 0.125rem;
    }
  }

  @container (max-width: 50rem) {
    gap: 1.5rem;

    .tally {
      gap: 0.75rem 1.5rem;
    }
  }
}
</style>
