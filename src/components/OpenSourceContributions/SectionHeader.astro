---
const { statistics } = Astro.props;
---

<header>
  <div class="title">
    <p class="sheet-code monospace" aria-hidden="true">
      <span>SH-04</span>
      <span>/</span>
      <span>REV A</span>
    </p>
    <h2 id="open-source-heading">
      <small lang="ja">オープンソース</small>
      <span class="stencil">Open Source</span>
    </h2>
  </div>

  <dl>
    <div>
      <dt>
        <small lang="ja">マージ</small>
        Merged
      </dt>
      <dd>{statistics.merged}</dd>
    </div>
    <div>
      <dt>
        <small lang="ja">オープン</small>
        Open
      </dt>
      <dd>{statistics.open}</dd>
    </div>
    <div>
      <dt>
        <small lang="ja">クローズ</small>
        Closed
      </dt>
      <dd>{statistics.closed}</dd>
    </div>
  </dl>
</header>

<style lang="scss">
header {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 2rem 3rem;
  align-items: end;
  margin-bottom: 2.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--line);

  .sheet-code {
    display: flex;
    gap: 0.5ch;
    margin: 0 0 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  h2 {
    display: grid;
    justify-items: start;
    gap: 0.125rem;

    [lang='ja'] {
      font-size: 0.6875rem;
    }

    .stencil {
      font-size: var(--type-h2);
      line-height: 1;
      color: var(--ink);
    }
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    padding-top: 0.25rem;

    div {
      display: grid;
      gap: 0.35rem;
      min-width: 4.5rem;
    }

    dt {
      display: grid;
      justify-items: start;
      gap: 0.1rem;
      font-family: monospace, system-ui;
      font-size: 0.625rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-faint);

      [lang='ja'] {
        font-size: 0.5625rem;
        letter-spacing: 0.08em;
      }
    }

    dd {
      font-family: monospace, system-ui;
      font-variant-numeric: tabular-nums;
      font-size: 1.5rem;
      font-weight: 600;
      line-height: 1;
      color: var(--accent-text);
      border-bottom: 1px dashed var(--line);
      padding-bottom: 0.15rem;
    }
  }

  @container (max-width: 50rem) {
    grid-template-columns: 1fr;
    gap: 1.5rem;

    dl {
      gap: 1.25rem 2rem;
    }
  }
}
</style>
