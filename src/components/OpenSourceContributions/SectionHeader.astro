---
import SectionHeader from '../SectionHeader.astro';

const { statistics } = Astro.props;
---

<SectionHeader headingId="open-source-heading" sectionId="open-source" titleJp="オープンソース" title="Open Source" sheetCode="SH-OSS">
  <dl>
    <div>
      <dt>
        <small lang="ja" aria-hidden="true">マージ</small>
        Merged
      </dt>
      <dd>{statistics.merged}</dd>
    </div>
    <div>
      <dt>
        <small lang="ja" aria-hidden="true">オープン</small>
        Open
      </dt>
      <dd>{statistics.open}</dd>
    </div>
    <div>
      <dt>
        <small lang="ja" aria-hidden="true">クローズ</small>
        Closed
      </dt>
      <dd>{statistics.closed}</dd>
    </div>
  </dl>
</SectionHeader>

<style lang="scss">
@use "@/scss/_page-column.scss" as column;

dl {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem 2.5rem;
  padding-top: 0.25rem;

  div {
    display: grid;
    gap: 0.35rem;
    min-width: 4.5rem;
  }

  dt {
    display: grid;
    justify-items: start;
    gap: 0.1rem;
    font-family: monospace, system-ui;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);

    [lang='ja'] {
      font-size: 0.625rem;
      letter-spacing: 0.08em;
    }
  }

  dd {
    font-family: monospace, system-ui;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent-text);
    border-bottom: 1px dashed var(--line);
    padding-bottom: 0.15rem;
  }

  @media #{column.section-width("<=", 50rem)} {
    gap: 1.25rem 2rem;
  }
}
</style>
