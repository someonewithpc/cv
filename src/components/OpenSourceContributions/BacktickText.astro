---
type Props = {
  text: string;
};

const { text } = Astro.props;

const segments = text.split(/(`[^`]*`)/g).filter((segment) => segment.length > 0);

/* A code span is one unbreakable word, so a line can only take it whole and the
   prose before it gets stranded on a short line. Offer breaks after the
   punctuation a reader already parses as a boundary, so the sentence keeps
   flowing as a single line of text. Short spans always fit, so leave them whole. */
const MIN_BREAKABLE_CODE_LENGTH = 12;

const splitAfterCodePunctuation = (code: string) => (
  code.length < MIN_BREAKABLE_CODE_LENGTH ? [code] : code.split(/(?<=[{}()[\]<>,.:;\/\\|_-])/).filter((piece) => piece.length > 0)
);

/* The fragment below is written on one line on purpose: a newline inside it renders
   as a space before and after the text, and the row title's underline draws over it. */
---

<>{segments.map((segment) => (
  segment.startsWith('`') && segment.endsWith('`')
    ? <span class="backtick">{splitAfterCodePunctuation(segment.slice(1, -1)).map((piece, index) => (index > 0 ? [<wbr />, piece] : piece))}</span>
    : segment
))}</>

<style lang="scss">
.backtick {
  color: var(--accent-text);
  font-size: inherit;
  font-style: inherit;
  font-weight: 600;
}
</style>
