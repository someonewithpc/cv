---
type Props = {
  text: string;
};

const { text } = Astro.props;

const segments = text.split(/(`[^`]*`)/g).filter((segment) => segment.length > 0);
---

<>
  {segments.map((segment) => (
    segment.startsWith('`') && segment.endsWith('`')
      ? <span class="backtick">{segment.slice(1, -1)}</span>
      : segment
  ))}
</>

<style lang="scss">
.backtick {
  // Keep accent hue but darken enough for 4.5:1 on light sheet backgrounds.
  color: color-mix(in oklab, var(--accent) 42%, #1a1208 58%);
  font-size: inherit;
  font-style: inherit;
  font-weight: 600;
}
</style>
