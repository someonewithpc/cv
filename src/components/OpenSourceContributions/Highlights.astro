---
import { Icon } from 'astro-icon/components';

import TechIcon from '@/components/TechIcon.astro';

import { resolveTechByIconSuffix } from '@/server/tech-icons';

type Link = {
  label: string;
  url: string;
};

type Highlight = {
  title: string;
  role?: string;
  roleJp?: string;
  description: string;
  repository: string;
  commits?: string;
  period?: string;
  links: Link[];
  tags: string[];
};

type Props = {
  highlights: Highlight[];
};

const { highlights } = Astro.props;

// Titles read like "GNU social v3", and an id may not carry whitespace.
const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

{highlights.map((entry) => (
  <article id={`highlight-${slug(entry.title)}`} aria-labelledby={`highlight-${slug(entry.title)}-heading`}>
    <ul aria-label="Technologies">
      {entry.tags.map((suffix) => {
        const resolved = resolveTechByIconSuffix(suffix);

        return resolved && (
          <li>
            <TechIcon tech={resolved} />
          </li>
        );
      })}
    </ul>

    <header>
      {(entry.role || entry.roleJp) && (
        <p>
          {entry.roleJp && (
            <small lang="ja">{entry.roleJp}</small>
          )}
          {entry.role}
        </p>
      )}

      <h3 id={`highlight-${slug(entry.title)}-heading`}>
        <span class="typewriter">{entry.title}</span>
      </h3>

      <cite>{entry.repository}</cite>
    </header>

    {(entry.commits || entry.period) && (
      <dl>
        {entry.commits && (
          <div>
            <dt>Commits</dt>
            <dd>{entry.commits}</dd>
          </div>
        )}
        {entry.period && (
          <div>
            <dt>Period</dt>
            <dd>{entry.period}</dd>
          </div>
        )}
      </dl>
    )}

    <p>{entry.description}</p>

    {entry.links?.length > 0 && (
      <nav aria-label={`${entry.title} links`}>
        {entry.links.map(({ label, url }) => (
          <a
            href={url}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`${label} (${entry.title}), opens in a new tab`}
          >
            {label}<Icon name="lucide:external-link" class="external-link" aria-hidden="true" />
          </a>
        ))}
      </nav>
    )}
  </article>
))}

<style lang="scss">
/* An index card: the head written above the red rule, the note on the blue
   rules under it. The rules run the card's full width, so the body backs out
   of the card padding and the tech column and pads itself back in. */
article {
  --surface-raised: var(--theme-paper);
  --card-margin: calc(var(--cell-x) + 5.5rem + 1.25rem);
  --card-rule: color-mix(in oklch, var(--line), var(--blueprint) 40%);
  --card-head-rule: oklch(0.62 0.17 25 / 0.6);
  --rule-pitch: 1.75rem;

  display: grid;
  grid-template-columns: var(--grid);
  column-gap: 1.25rem;
  align-items: start;
  margin-bottom: 2.5rem;
  padding: 1.25rem var(--cell-x) 1.25rem;
  rotate: -0.5deg;
  color: var(--ink);
  background: var(--theme-paper);
  box-shadow:
    0 0 0 1px rgb(0 0 0 / 0.12),
    0 1px 2px rgb(0 0 0 / 0.25),
    0 1rem 2rem -0.75rem rgb(0 0 0 / 0.45);

  font-family: sans-serif;

  &:nth-of-type(even) {
    rotate: 0.5deg;
  }

  > ul {
    grid-column: 1;
    grid-row: 1 / -1;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.375rem;
    list-style: none;

    li {
      display: flex;
      line-height: 0;
      min-height: 3rem;
      align-items: center;
      justify-content: center;

      :global(svg) {
        width: 1.375rem;
        height: 1.375rem;
      }
    }
  }

  > header,
  > p,
  > nav,
  > dl {
    grid-column: 2 / -1;
    min-width: 0;
  }

  > header,
  > dl {
    grid-row: 1;
  }

  > header {
    display: grid;
    gap: 0.625rem;
    padding-inline-end: clamp(8rem, 28%, 14rem);
    overflow-wrap: break-word;

    p {
      display: grid;
      justify-items: start;
      gap: 0.1rem;
      font-family: monospace, system-ui;
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent-text);

      [lang='ja'] {
        font-size: 0.5625rem;
      }
    }

    h3 {
      display: grid;
      justify-items: start;
      gap: 0.125rem;

      [lang='ja'] {
        font-size: 0.625rem;
      }

      .typewriter {
        font-size: 1.375rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        line-height: 1.15;
        color: var(--ink);
      }
    }

    cite {
      font-family: monospace, system-ui;
      font-style: normal;
      font-size: 0.8125rem;
      color: var(--ink-muted);
    }
  }

  > p {
    margin-top: 0.75rem;
    margin-inline: calc(-1 * var(--card-margin)) calc(-1 * var(--cell-x));
    padding-inline: var(--card-margin) var(--cell-x);
    border-top: 2px solid var(--card-head-rule);
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 calc(var(--rule-pitch) - 1px),
      var(--card-rule) calc(var(--rule-pitch) - 1px) var(--rule-pitch)
    );
    background-origin: content-box;
    /* Pulled up so the writing sits on the rule rather than floating over it. */
    background-position: 0 -0.25rem;
    line-height: var(--rule-pitch);
    color: var(--ink-muted);
    overflow-wrap: break-word;
  }

  > nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    font-family: sans-serif;

    a {
      min-width: 0;
      max-width: 100%;
      min-height: 3rem;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      color: var(--accent-text);
      text-underline-offset: 0.15em;
      overflow-wrap: break-word;

      .external-link {
        width: 0.75em;
        height: 0.75em;
      }

      & + a::before {
        content: none;
      }
    }
  }

  > dl {
    display: flex;
    gap: 1.5rem;
    justify-self: end;
    align-self: start;
    font-family: monospace, system-ui;

    dt {
      font-size: 0.625rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    dd {
      font-size: 0.9375rem;
      font-weight: 600;
      line-height: 1;
      color: var(--accent-text);
    }

    div {
      display: grid;
      gap: 0.2rem;
    }
  }

  @container (max-width: 50rem) {
    --card-margin: calc(var(--cell-x) + 5rem + 1.25rem);

    grid-template-columns: 5rem 1fr;

    > header,
    > p,
    > nav,
    > dl {
      grid-column: 2;
    }

    > header {
      padding-inline-end: clamp(6rem, 36vw, 10rem);
    }
  }

  @container (max-width: 30rem) {
    --card-margin: var(--cell-x);

    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.65rem;

    > ul {
      grid-row: 1;
      align-self: start;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.3rem;

      li {
        min-height: 1.375rem;
      }
    }

    > header {
      grid-column: 2;
      grid-row: 1;
      padding-inline-end: 0;
    }

    > dl,
    > p,
    > nav {
      grid-column: 1 / -1;
    }

    > dl {
      grid-row: 2;
      justify-self: start;
      flex-wrap: wrap;
    }

    > p {
      grid-row: 3;
    }

    > nav {
      grid-row: 4;
    }
  }
}
</style>
