---
import { Icon } from 'astro-icon/components';

import TechIcon from '@/components/TechIcon.astro';

import { resolveTechByIconSuffix } from '@/server/tech-icons';

type Link = {
  label: string;
  url: string;
};

type Highlight = {
  title: string;
  role?: string;
  roleJp?: string;
  description: string;
  repository: string;
  links: Link[];
  tags: string[];
};

type Props = {
  highlights: Highlight[];
};

const { highlights } = Astro.props;

// Titles read like "GNU social v3", and an id may not carry whitespace.
const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

{highlights.map((entry) => (
  <article id={`highlight-${slug(entry.title)}`} aria-labelledby={`highlight-${slug(entry.title)}-heading`}>
    <ul aria-label="Technologies">
      {entry.tags.map((suffix) => {
        const resolved = resolveTechByIconSuffix(suffix);

        return resolved && (
          <li>
            <TechIcon tech={resolved} />
          </li>
        );
      })}
    </ul>

    <header>
      <h3 id={`highlight-${slug(entry.title)}-heading`}>
        <span class="typewriter">{entry.title}</span>
      </h3>

      <cite>{entry.repository}</cite>

      {(entry.role || entry.roleJp) && (
        <p class="role">
          {entry.role}
          {entry.roleJp && (
            <small lang="ja">{entry.roleJp}</small>
          )}
        </p>
      )}
    </header>

    <p>{entry.description}</p>

    {entry.links?.length > 0 && (
      <nav aria-label={`${entry.title} links`}>
        {entry.links.map(({ label, url }) => (
          <a
            href={url}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`${label} (${entry.title}), opens in a new tab`}
          >
            {label}<Icon name="lucide:external-link" class="external-link" aria-hidden="true" />
          </a>
        ))}
      </nav>
    )}
  </article>
))}

<style lang="scss">
/* Each highlight is written straight on the intro sheet, the marks in the margin column and
   the writing beside them, and a hairline rules one off from the next: the same line the
   header above them draws. */
article {
  display: grid;
  grid-template-columns: var(--grid);
  column-gap: 1.25rem;
  row-gap: 0.75rem;
  align-items: start;
  padding-block: 1.5rem;

  & + article {
    border-top: 1px solid color-mix(in oklch, var(--line), transparent 25%);
  }

  > ul {
    grid-column: 1;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.375rem;
    list-style: none;

    li {
      display: flex;
      line-height: 0;
      min-height: 3rem;
      align-items: center;
      justify-content: center;

      :global(svg) {
        width: 1.375rem;
        height: 1.375rem;
      }
    }
  }

  > header,
  > p,
  > nav {
    grid-column: 2 / -1;
    min-width: 0;
  }

  > header {
    display: grid;
    gap: 0.375rem;
    overflow-wrap: break-word;

    h3 .typewriter {
      font-size: 1.375rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      line-height: 1.15;
      color: var(--ink);
    }

    cite {
      font-family: monospace, system-ui;
      font-style: normal;
      font-size: 0.8125rem;
      color: var(--ink-muted);
    }

    /* The role after the repository, in plain text, its gloss beside it on the baseline. */
    .role {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.125rem 0.75rem;
      font-family: monospace, system-ui;
      font-size: 0.8125rem;
      color: var(--ink-muted);

      [lang='ja'] {
        font-size: 0.75rem;
      }
    }
  }

  > p {
    max-width: 52rem;
    line-height: 1.65;
    color: var(--ink-muted);
    overflow-wrap: break-word;
  }

  > nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;

    a {
      min-width: 0;
      max-width: 100%;
      min-height: 3rem;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      color: var(--accent-text);
      text-underline-offset: 0.15em;
      overflow-wrap: break-word;

      .external-link {
        width: 0.75em;
        height: 0.75em;
      }

      & + a::before {
        content: none;
      }
    }
  }

  @container (max-width: 50rem) {
    grid-template-columns: 5rem 1fr;

    > header,
    > p,
    > nav {
      grid-column: 2;
    }
  }

  /* Narrow, the marks go in a row over the writing and everything under them takes the width. */
  @container (max-width: 30rem) {
    grid-template-columns: minmax(0, 1fr);

    > ul {
      grid-column: 1;
      grid-row: 1;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.3rem;

      li {
        min-height: 1.375rem;
      }
    }

    > header,
    > p,
    > nav {
      grid-column: 1;
    }
  }
}
</style>
