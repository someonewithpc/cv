---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';
import WipStamp from '@/components/WipStamp.astro';

import MockScene from './MockScene/MockScene.astro';
import PlaceLayer from './layers/PlaceLayer.astro';
import ParametersLayer from './layers/ParametersLayer.astro';
import LayoutsLayer from './layers/LayoutsLayer.astro';
import BadgeLayer from './layers/BadgeLayer.astro';
import DnDLayer from './layers/DnDLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

const srcRoot = path.join(process.cwd(), 'src');
const sceneEntry = path.join(
  srcRoot,
  'components/SpaceBuilderDemo/MockScene/scene/SpaceBuilderScene.ts',
);

const { outputFiles: [sceneBundle] } = await esbuild.build({
  entryPoints: [sceneEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  packages: 'external',
  alias: { '@': srcRoot },
});

const sceneSize = toKiB(sceneBundle.text);

const layers = {
  main: { name: null },
  place: { name: 'Place Area', pageStyle: 'blueprint' },
  parameters: { name: 'Edit Parameters', pageStyle: 'blueprint wip' },
  layouts: { name: 'Layout Styles', pageStyle: 'blueprint' },
  badge: { name: 'Capacity Badge', pageStyle: 'blueprint' },
  dnd: { name: 'Drag & Drop', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="Space Builder · Add Tool"
  scale="1:1"
  size={sceneSize}
  date="2023"
  tech={['vue', 'three']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      main: <MockScene />,
      place: <PlaceLayer />,
      parameters: (
        <>
          <ParametersLayer />
          <WipStamp />
        </>
      ),
      layouts: <LayoutsLayer />,
      badge: <BadgeLayer />,
      dnd: <DnDLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      main: (
        <PostIt background="#e8e4dc" color="black">
          Hover or focus to take over. Add [A] opens the catalog — double-click an object (or
          Build) fills a drawn area; drag drops a single chair. Same Vue + Three.js stack as Space
          Builder.
        </PostIt>
      ),
      place: (
        <PostIt background="#cde" color="black">
          Same Three.js <code>SelectArea</code> as Add — blue corner/edge resize, pink move,
          green rotate. Orbit the empty ground; no sidebars on this page.
        </PostIt>
      ),
      parameters: (
        <PostIt background="#dfd" color="black">
          One Options shell; each layout picks its fields. Grid shows Blocks + Aisle; Circle
          swaps those for Inner Circle. Seat Count over max keeps Save off.
        </PostIt>
      ),
      layouts: (
        <PostIt background="#cfc" color="black">
          Layout chips only swap how chairs pack — the SelectArea and handles stay put. Grid,
          Offset, Hollow, Chevron, Circle, Semi-Circle, and U-Shape.
        </PostIt>
      ),
      badge: (
        <PostIt background="#edf" color="black">
          Capacity sits on the screen-bottom edge of the SelectArea. A world −Z offset sinks
          under the box when you orbit; camera-relative CSS2D keeps it readable.
        </PostIt>
      ),
      dnd: (
        <PostIt background="#fed" color="black">
          Catalog drag places one chair; Build draws an area and fills it. One Add tool, two
          outcomes.
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
