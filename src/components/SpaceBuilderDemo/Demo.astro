---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';

import MockScene from './MockScene/MockScene.astro';
import PlaceLayer from './layers/PlaceLayer.astro';
import ParametersLayer from './layers/ParametersLayer.astro';
import LayoutsLayer from './layers/LayoutsLayer.astro';
import BadgeLayer from './layers/BadgeLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

const srcRoot = path.join(process.cwd(), 'src');
const sceneEntry = path.join(
  srcRoot,
  'components/SpaceBuilderDemo/MockScene/scene/SpaceBuilderScene.ts',
);

const { outputFiles: [sceneBundle] } = await esbuild.build({
  entryPoints: [sceneEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  packages: 'external',
  alias: { '@': srcRoot },
});

const sceneSize = toKiB(sceneBundle.text);

const layers = {
  main: { name: null },
  place: { name: 'Place Area', pageStyle: 'blueprint' },
  parameters: { name: 'Edit Parameters', pageStyle: 'blueprint' },
  layouts: { name: 'Layout Styles', pageStyle: 'blueprint' },
  badge: { name: 'Capacity Badge', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<div class="space-builder-demo">
<TechnicalDrawingStack
  subtitle="Space Builder · Add Tool"
  hint="there is more underneath, turn the page"
  scale="1:1"
  size={sceneSize}
  date="2023"
  tech={['vuejs', 'threejs']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      main: <MockScene />,
      place: <PlaceLayer />,
      parameters: <ParametersLayer />,
      layouts: <LayoutsLayer />,
      badge: <BadgeLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      main: null,
      place: (
        <PostIt background="#cde" color="black">
          Blue handles resize the area, pink moves it, green rotates. Drag anywhere else to
          look around
        </PostIt>
      ),
      parameters: (
        <PostIt background="#dfd" color="black">
          Spacing, aisles, and seat count update as you drag the sliders. If the requested
          seats don't fit the selected area, a warning appears
        </PostIt>
      ),
      layouts: (
        <PostIt background="#cfc" color="black">
          Pick Grid, Circle, Boardroom, or any of the others and the chairs rearrange without
          redrawing the area
        </PostIt>
      ),
      badge: (
        <div class="badge-aside">
          <PostIt background="#edf" color="black">
            The seat count sticks to the bottom of the area on screen, without overlapping the
            selected area
          </PostIt>
          <div class="badge-formula">
            <p class="badge-formula-title">Tag offset</p>
            <math display="block">
              <mtable columnalign="right center left" columnspacing="0.4em" rowspacing="0.75em">
                <mtr>
                  <mtd><mi>φ</mi></mtd>
                  <mtd><mo>=</mo></mtd>
                  <mtd><mi>θ</mi><mo>−</mo><mi>α</mi></mtd>
                </mtr>
                <mtr>
                  <mtd><mi>r</mi></mtd>
                  <mtd><mo>=</mo></mtd>
                  <mtd>
                    <mi>min</mi>
                    <mo>⁡</mo>
                    <mstyle displaystyle="true" scriptlevel="0">
                      <mrow>
                        <mo stretchy="true" fence="true" form="prefix">(</mo>
                        <mfrac>
                          <mi>h</mi>
                          <mrow>
                            <mn>2</mn>
                            <mrow>
                              <mo stretchy="false" fence="true">|</mo>
                              <mrow>
                                <mi>cos</mi>
                                <mo>⁡</mo>
                                <mi>φ</mi>
                              </mrow>
                              <mo stretchy="false" fence="true">|</mo>
                            </mrow>
                          </mrow>
                        </mfrac>
                        <mo lspace="0.3em" rspace="0.3em">,</mo>
                        <mfrac>
                          <mi>w</mi>
                          <mrow>
                            <mn>2</mn>
                            <mrow>
                              <mo stretchy="false" fence="true">|</mo>
                              <mrow>
                                <mi>sin</mi>
                                <mo>⁡</mo>
                                <mi>φ</mi>
                              </mrow>
                              <mo stretchy="false" fence="true">|</mo>
                            </mrow>
                          </mrow>
                        </mfrac>
                        <mo stretchy="true" fence="true" form="postfix">)</mo>
                      </mrow>
                    </mstyle>
                  </mtd>
                </mtr>
                <mtr>
                  <mtd><mtext>offset</mtext></mtd>
                  <mtd><mo>=</mo></mtd>
                  <mtd><mi>r</mi><mo>+</mo><mn>0.95</mn></mtd>
                </mtr>
              </mtable>
            </math>
            <p class="badge-formula-note">
              φ is the camera's angle relative to the area; r is the distance from center to
              the area's silhouette edge at that angle.
            </p>
          </div>
        </div>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
</div>

<style lang="scss">
// A landscape sheet puts its title block in the bottom-right corner, absolutely placed over
// the artwork column. That corner belongs to the block, so a demo that fills the cell ends
// above it instead of running under its lettering.
:global(.space-builder-demo article.technical-drawing-stack > * > section) {
  --title-block-reach: var(--title-block-block);
}

// Portrait gives the block a row of its own, the reach goes back to 0, and nothing moves.
// The query is the one Page.astro moves the block with, not the sheet's orientation
// attribute. Those two disagree while the stack's max-height clamps its 3/5 aspect, which
// is every window between about 580 and 640 wide, and there the block is still cornered.
@container technical-drawing (orientation: portrait) {
  :global(.space-builder-demo article.technical-drawing-stack > * > section) {
    --title-block-reach: 0px;
  }
}

// The first sheet's app fills the sheet inside the shared --demo-inset (Page.astro), and only
// its sidebar stops above the title block. The sidebar takes the block's width, so its edge
// lines up with the block's and the viewport fills everything left of both. The 2px keeps the
// frame line clear. Portrait gives the block a row of its own, and there the sidebar keeps its
// own width.
:global(.space-builder-demo article.technical-drawing-stack > * > section:not(.blueprint) .content:has(.mock-scene-demo)) {
  --demo-pad: calc(2px + var(--demo-inset));

  padding: var(--demo-pad);
}

@container technical-drawing not (orientation: portrait) {
  :global(.space-builder-demo article.technical-drawing-stack > * > section:not(.blueprint) .space-builder-app .sidebar) {
    width: calc(var(--title-block-inline) - var(--demo-pad));
    margin-bottom: calc(var(--title-block-reach) - var(--demo-pad));
  }
}

// Regular (non-portrait) layout only: reserve a gutter next to the drawing and centre the
// PostIt in whatever space is left. Portrait mode already centres the aside below the
// content with its own margin, untouched.
:global(.space-builder-demo article.technical-drawing-stack > * > section .aside) {
  display: flex;
  justify-content: center;
  padding-left: 1.75em;
  margin-inline: 0;
}

@container technical-drawing (orientation: portrait) {
  /* Portrait centres the aside itself now; only the landscape gutter has to go. */
  :global(.space-builder-demo article.technical-drawing-stack > * > section .aside) {
    padding-left: 0;
  }
}

// Past 56em the note sits beside the artwork, but the Badge note and its formula card are taller
// than the column above the title block on sheets up to about 955px wide. Where the note would
// reach the block, it folds into the corner tab the way it does on narrower sheets. The script
// below marks those sheets. The note is only hidden, not taken out, so the column keeps its
// height and the tab comes and goes at one width.
$sheet: '.space-builder-demo article.technical-drawing-stack > * > section[data-note]';

@mixin tucked-note {
  :global(.drawing-note:not(:modal, :popover-open)) {
    visibility: hidden;
  }

  :global(.note-fold) {
    display: block;
  }
}

:global(#{$sheet}[data-note-tucked]) {
  --note-fold-reach: calc(var(--note-fold-size) - var(--sheet-margin));

  > :global(.aside) {
    @include tucked-note;
  }

  :global(.demo-transport) {
    left: calc(var(--note-fold-size) + var(--sheet-margin));
  }
}

// Without script the column asks the same question itself. It clips, and every item carries an
// empty box as tall as the block under it, so the column overflows exactly when the note would
// reach the block; the clearance above the block is a grid row of its own, so the note is
// centred where it always was. With script this stays off: the clip nudges the card's
// antialiasing by a level, and there is no deck to move without script either.
@media (scripting: none) {
  @container technical-drawing-width not (max-width: 56em) {
    :global(#{$sheet} > .aside) {
      display: grid;
      grid-template-rows: minmax(0, 1fr) var(--note-clearance);
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      padding-bottom: var(--title-block-block);
      overflow: hidden;
      container: note-column / scroll-state;
    }

    :global(#{$sheet} > .aside .drawing-note:not(:modal, :popover-open) .note-card > *) {
      position: relative;
    }

    :global(#{$sheet} > .aside .drawing-note:not(:modal, :popover-open) .note-card > *::after) {
      content: '';
      position: absolute;
      top: 100%;
      left: 0;
      width: 1px;
      height: var(--title-block-block);
    }
  }

  @container note-column scroll-state(scrollable: block-end) {
    :global(#{$sheet} > .aside) {
      @include tucked-note;
    }
  }
}

// Badge page: the formula card sits below the PostIt, never overlapping it.
.badge-aside {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6em;
  max-width: 100%;
}

.badge-formula {
  max-width: min(44ch, 100%);
  padding: 0.65em 0.9em;
  // Themed via the blueprint sheet's own tokens (see _colors.scss) instead of
  // fixed light-mode colors, so it stays legible — and reads as a recessed
  // panel rather than a stray light patch — across every site theme.
  border: 1px solid var(--line-strong);
  border-radius: 0.3em;
  background: var(--surface-sunken);
  box-shadow: 0 0.15em 0.3em rgba(0, 0, 0, 0.35);
  color: var(--ink);

  // The r row, the widest, is 17.5 of the formula's own em wide. The card beside the scene is a
  // third of the sheet less the gutter, the note's clearance and its own padding, 6rem in all,
  // so the formula takes whatever size lets that row fit that measure. Opened from the
  // dog-ear, the card has the sheet's whole width less the dialog's padding.
  math {
    display: block;
    font-size: min(1.125em, (var(--sheet-inline) / 3 - 6rem) / 17.5);
    // Prefer a local math face so stretchy fences / operators actually stretch.
    font-family: "DejaVu Math TeX Gyre", "Noto Sans Math", math, serif;
  }

  :global(.drawing-note:is(:modal, :popover-open)) & math {
    font-size: min(1.125em, (var(--sheet-inline) - 6.5rem) / 17.5);
  }

  mfrac {
    padding-block: 0.2em;
  }

  mtable {
    // Keep rows from colliding once fractions get display-style height.
    row-gap: 0.15em;
  }

  mtext {
    font-style: normal;
    font-family: inherit;
  }
}

.badge-formula-title,
.badge-formula-note {
  font-family: monospace, system-ui;
  font-size: 0.75em;
  color: var(--ink-muted);
}

.badge-formula-title {
  margin: 0 0 0.45em;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.badge-formula-note {
  margin: 0.55em 0 0;
  line-height: 1.35;
}
</style>

<script>
// A sheet whose note would reach the title block tucks it under the corner tab (the styles
// above). Offsets, not client rects: they leave out the stack's transforms, and the note and the
// block share the sheet as their offset parent. Every sheet is read before any is written. A note
// open in the dialog has left the column, so its sheet keeps the mark it had.
const sheetOf = (el: Element) => el.closest<HTMLElement>('section[data-note]');
const reaches = (sheet: HTMLElement) => {
  const block = sheet.querySelector<HTMLElement>(':scope > table');
  const items = sheet.querySelectorAll<HTMLElement>(':scope > .aside .drawing-note:not([open]) > .note-card > *');
  return !!block && [...items].some((item) => item.offsetHeight > 0 && item.offsetTop + item.offsetHeight > block.offsetTop);
};
const tuck = new ResizeObserver((entries) => {
  const sheets = new Set(entries.map((entry) => sheetOf(entry.target)).filter((sheet) => sheet !== null));
  [...sheets]
    .filter((sheet) => !sheet.querySelector(':scope > .aside .drawing-note[open]'))
    .map((sheet) => [sheet, reaches(sheet)] as const)
    .forEach(([sheet, tucked]) => {
      if (sheet.hasAttribute('data-note-tucked') !== tucked) sheet.toggleAttribute('data-note-tucked', tucked);
    });
});
for (const sheet of document.querySelectorAll<HTMLElement>('.space-builder-demo article.technical-drawing-stack section[data-note]')) {
  for (const el of sheet.querySelectorAll(':scope > .aside, :scope > .aside .note-card > *, :scope > table')) tuck.observe(el);
}
</script>
