---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';

import MockScene from './MockScene/MockScene.astro';
import PlaceLayer from './layers/PlaceLayer.astro';
import ParametersLayer from './layers/ParametersLayer.astro';
import LayoutsLayer from './layers/LayoutsLayer.astro';
import BadgeLayer from './layers/BadgeLayer.astro';
import DnDLayer from './layers/DnDLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

const srcRoot = path.join(process.cwd(), 'src');
const sceneEntry = path.join(
  srcRoot,
  'components/SpaceBuilderDemo/MockScene/scene/SpaceBuilderScene.ts',
);

const { outputFiles: [sceneBundle] } = await esbuild.build({
  entryPoints: [sceneEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  packages: 'external',
  alias: { '@': srcRoot },
});

const sceneSize = toKiB(sceneBundle.text);

const layers = {
  main: { name: null },
  place: { name: 'Place Area', pageStyle: 'blueprint' },
  parameters: { name: 'Edit Parameters', pageStyle: 'blueprint' },
  layouts: { name: 'Layout Styles', pageStyle: 'blueprint' },
  badge: { name: 'Capacity Badge', pageStyle: 'blueprint' },
  dnd: { name: 'Drag & Drop', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<div class="space-builder-demo">
<TechnicalDrawingStack
  subtitle="Space Builder · Add Tool"
  scale="1:1"
  size={sceneSize}
  date="2023"
  tech={['vuejs', 'threejs']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      main: <MockScene />,
      place: <PlaceLayer />,
      parameters: <ParametersLayer />,
      layouts: <LayoutsLayer />,
      badge: <BadgeLayer />,
      dnd: <DnDLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      main: (
        <PostIt background="#e8e4dc" color="black">
          Hover or focus to take over the auto-playing animation<br />
          Drag a chair from the catalog to place one, or double click on it and draw a
          rectangle to fill it
        </PostIt>
      ),
      place: (
        <PostIt background="#cde" color="black">
          Blue handles resize the area, pink moves it, green rotates. Click and drag elsewhere
          to look around
        </PostIt>
      ),
      parameters: (
        <PostIt background="#dfd" color="black">
          Spacing, aisles, and seat count update as you drag the sliders. If the requested
          seats don't fit the selected area, a warning appears
        </PostIt>
      ),
      layouts: (
        <PostIt background="#cfc" color="black">
          Pick Grid, Circle, Boardroom, or any of the others and the chairs rearrange without
          redrawing the area
        </PostIt>
      ),
      badge: (
        <div class="badge-aside">
          <PostIt background="#edf" color="black">
            The seat count sticks to the bottom of the area on screen, without overlapping the
            selected area
          </PostIt>
          <div class="badge-formula">
            <p class="badge-formula-title">Tag offset</p>
            <math display="block">
              <mtable columnalign="right center left" columnspacing="0.4em" rowspacing="0.75em">
                <mtr>
                  <mtd><mi>φ</mi></mtd>
                  <mtd><mo>=</mo></mtd>
                  <mtd><mi>θ</mi><mo>−</mo><mi>α</mi></mtd>
                </mtr>
                <mtr>
                  <mtd><mi>r</mi></mtd>
                  <mtd><mo>=</mo></mtd>
                  <mtd>
                    <mrow>
                      <mi>min</mi>
                      <mo>⁡</mo>
                      <mrow>
                        <mo stretchy="true" fence="true" form="prefix">(</mo>
                        <mstyle displaystyle="true" scriptlevel="0">
                          <mfrac>
                            <mi>h</mi>
                            <mrow>
                              <mn>2</mn>
                              <mrow>
                                <mo stretchy="false" fence="true">|</mo>
                                <mrow>
                                  <mi>cos</mi>
                                  <mo>⁡</mo>
                                  <mi>φ</mi>
                                </mrow>
                                <mo stretchy="false" fence="true">|</mo>
                              </mrow>
                            </mrow>
                          </mfrac>
                        </mstyle>
                        <mo lspace="0.3em" rspace="0.3em">,</mo>
                        <mstyle displaystyle="true" scriptlevel="0">
                          <mfrac>
                            <mi>w</mi>
                            <mrow>
                              <mn>2</mn>
                              <mrow>
                                <mo stretchy="false" fence="true">|</mo>
                                <mrow>
                                  <mi>sin</mi>
                                  <mo>⁡</mo>
                                  <mi>φ</mi>
                                </mrow>
                                <mo stretchy="false" fence="true">|</mo>
                              </mrow>
                            </mrow>
                          </mfrac>
                        </mstyle>
                        <mo stretchy="true" fence="true" form="postfix">)</mo>
                      </mrow>
                    </mrow>
                  </mtd>
                </mtr>
                <mtr>
                  <mtd><mtext>offset</mtext></mtd>
                  <mtd><mo>=</mo></mtd>
                  <mtd><mi>r</mi><mo>+</mo><mn>0.95</mn></mtd>
                </mtr>
              </mtable>
            </math>
            <p class="badge-formula-note">
              φ is the camera's angle relative to the area; r is the distance from center to
              the area's silhouette edge at that angle.
            </p>
          </div>
        </div>
      ),
      dnd: (
        <PostIt background="#fed" color="black">
          Grab a chair from the catalog and drop it on the floor to place a single piece
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
</div>

<style lang="scss">
// Regular (non-portrait) layout only — reserve a gutter next to the demo
// content (where a wide page like the Add tool can otherwise butt right up
// against it) and center the PostIt in whatever space is left. Portrait mode
// already centers the aside below the content with its own margin, untouched.
:global(.space-builder-demo article.technical-drawing-stack > section .aside) {
  display: flex;
  justify-content: center;
  padding-left: 1.75em;
  margin-inline: 0;
}

@container technical-drawing (orientation: portrait) {
  :global(.space-builder-demo article.technical-drawing-stack > section .aside) {
    display: block;
    padding-left: 0;
    margin-inline: auto;
  }
}

// Badge page: the formula card sits below the PostIt, never overlapping it.
.badge-aside {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6em;
  max-width: 100%;
}

.badge-formula {
  max-width: min(44ch, 100%);
  padding: 0.65em 0.9em;
  // Themed via the blueprint sheet's own tokens (see _colors.scss) instead of
  // fixed light-mode colors, so it stays legible — and reads as a recessed
  // panel rather than a stray light patch — across every site theme.
  border: 1px solid var(--line-strong);
  border-radius: 0.3em;
  background: var(--surface-sunken);
  box-shadow: 0 0.15em 0.3em rgba(0, 0, 0, 0.35);
  color: var(--ink);

  math {
    display: block;
    font-size: 1.12em;
    // Prefer a local math face so stretchy fences / operators actually stretch.
    font-family: "DejaVu Math TeX Gyre", "Noto Sans Math", math, serif;
  }

  mfrac {
    padding-block: 0.2em;
  }

  mtable {
    // Keep rows from colliding once fractions get display-style height.
    row-gap: 0.15em;
  }

  mtext {
    font-style: normal;
    font-family: inherit;
  }
}

.badge-formula-title {
  margin: 0 0 0.45em;
  font-family: monospace, system-ui;
  font-size: 0.72em;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-muted);
}

.badge-formula-note {
  margin: 0.55em 0 0;
  font-family: monospace, system-ui;
  font-size: 0.72em;
  line-height: 1.35;
  color: var(--ink-muted);
}
</style>
