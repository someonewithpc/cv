---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

const annotationScale = 0.85;
const annotationFontSize = 0.1 * annotationScale;
---

<div class="wrapper">
  <Annotations scale={annotationScale}>
    <div class="diagram" slot="content" aria-hidden="true">
      <div class="panel">
        <header>
          <span class="eyebrow">SelectArea</span>
          <strong>Create · Edit · Resize</strong>
        </header>

        <div class="stage">
          <div class="area valid">
            <span class="handle corner tl" />
            <span class="handle corner tr" />
            <span class="handle corner bl" />
            <span class="handle corner br" />
            <span class="handle edge t" />
            <span class="handle edge r" />
            <span class="handle edge b" />
            <span class="handle edge l" />
            <span class="stem" />
            <span class="handle move" />
            <span class="handle rotate" />
            <span class="label">Select an area where to place the objects</span>
          </div>

          <div class="compare">
            <figure class="sample ok">
              <figcaption><span class="badge good">Valid</span> Fits · inferrer fills</figcaption>
              <div class="mini-area ok" />
            </figure>
            <figure class="sample bad">
              <figcaption><span class="badge bad">Invalid</span> Out of bounds</figcaption>
              <div class="mini-area bad" />
            </figure>
          </div>
        </div>
      </div>
    </div>
    <Fragment slot="annotations">
      <ArrowAnnotation
        tipX={-0.72}
        tipY={-0.35}
        angle={145}
        length={0.42}
        fontSize={annotationFontSize}
        text="Corner / edge resize (0x009acd)"
      />
      <ArrowAnnotation
        tipX={-0.15}
        tipY={0.05}
        angle={35}
        length={0.4}
        fontSize={annotationFontSize}
        text="Pink center · translate"
      />
      <ArrowAnnotation
        tipX={-0.15}
        tipY={-0.55}
        angle={110}
        length={0.38}
        fontSize={annotationFontSize}
        text="Green rotate · Alt snaps"
      />
      <ArrowAnnotation
        tipX={0.72}
        tipY={0.45}
        angle={-25}
        length={0.4}
        fontSize={annotationFontSize}
        text="Validity tint on the plane"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

.wrapper {
  width: min(drawing.$artwork-width * 1.45, 92cqw);
  max-width: 100%;
  height: auto;
  max-height: 82cqh;
  aspect-ratio: 1.35 / 1;
  position: relative;
}

.diagram {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 14rem;
}

.panel {
  position: absolute;
  inset: 4%;
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 0.55rem;
  padding: 0.7rem 0.8rem;
  border: 1px solid #333;
  border-radius: 0.35rem;
  background: color-mix(in oklab, var(--blueprint, #dce8f5) 55%, #fff);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  font-family: var(--font-poppins, system-ui, sans-serif);
  color: #1d241c;

  header {
    display: grid;
    gap: 0.1rem;

    .eyebrow {
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #666;
    }

    strong {
      font-size: 0.95rem;
    }
  }
}

.stage {
  position: relative;
  min-height: 11rem;
  border-radius: 0.25rem;
  background:
    linear-gradient(180deg, #2a2a2a 0%, #212121 100%);
  border: 1px solid #444;
  overflow: hidden;
}

.area {
  position: absolute;
  border: 2px solid transparent;
  border-radius: 0.15rem;

  &.valid {
    left: 14%;
    top: 18%;
    width: 46%;
    height: 52%;
    background: color-mix(in oklab, #89ab22 42%, transparent);
    border-color: #6f8f1c;
  }
}

.handle {
  position: absolute;
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: #009acd;
  border: 1px solid #0a3a4a;
  translate: -50% -50%;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);

  &.tl { left: 0; top: 0; }
  &.tr { left: 100%; top: 0; }
  &.bl { left: 0; top: 100%; }
  &.br { left: 100%; top: 100%; }

  &.edge.t { left: 50%; top: 0; }
  &.edge.r { left: 100%; top: 50%; }
  &.edge.b { left: 50%; top: 100%; }
  &.edge.l { left: 0; top: 50%; }

  &.move {
    left: 50%;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    background: #e89ab5;
    border-color: #7a3a52;
    z-index: 2;
  }

  &.rotate {
    left: 50%;
    top: -18%;
    width: 0.65rem;
    height: 0.65rem;
    background: #89ab22;
    border-color: #3d5212;
    z-index: 2;
  }
}

.stem {
  position: absolute;
  left: 50%;
  top: -18%;
  width: 2px;
  height: 18%;
  background: #89ab22;
  translate: -50% 0;
  z-index: 1;
}

.label {
  position: absolute;
  left: 50%;
  top: -1.7rem;
  translate: -50% 0;
  white-space: nowrap;
  font-size: 0.62rem;
  padding: 0.22rem 0.5rem;
  border-radius: 0.25rem;
  background: #d9edf7;
  border: 1px solid #bce8f1;
  color: #31708f;
  font-weight: 600;
}

.compare {
  position: absolute;
  right: 4%;
  bottom: 6%;
  display: grid;
  gap: 0.4rem;
  width: 32%;
}

.sample {
  margin: 0;
  display: grid;
  gap: 0.25rem;

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.55rem;
    color: #ced4da;
  }
}

.badge {
  display: inline-block;
  padding: 0.05rem 0.3rem;
  border-radius: 0.2rem;
  font-weight: 700;
  font-size: 0.52rem;
  letter-spacing: 0.03em;
  text-transform: uppercase;

  &.good {
    background: color-mix(in oklab, #89ab22 70%, #111);
    color: #f4ffe8;
  }

  &.bad {
    background: color-mix(in oklab, #f76d65 75%, #111);
    color: #fff5f4;
  }
}

.mini-area {
  height: 1.6rem;
  border-radius: 0.15rem;
  border: 1.5px solid;

  &.ok {
    background: color-mix(in oklab, #89ab22 45%, transparent);
    border-color: #6f8f1c;
  }

  &.bad {
    background: color-mix(in oklab, #f76d65 42%, transparent);
    border-color: #e2554d;
  }
}

@container technical-drawing (orientation: portrait) {
  .wrapper {
    width: min(92cqw, calc(72cqh * 1.2));
    aspect-ratio: 1.15 / 1;
    max-height: 72cqh;
  }

  .compare {
    width: 36%;
  }
}
</style>
