---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import { LAYOUT_LABELS, LAYOUT_STYLES } from '../MockScene/scene/layoutEngine';
import { LAYOUT_ICONS } from '../MockScene/layoutIcons';

const annotationScale = 0.75;
const annotationFontSize = 0.1 * annotationScale;
---

<div class="wrapper">
  <Annotations scale={annotationScale}>
    <div class="layouts-shell" slot="content" aria-hidden="true">
      <div class="panel">
        <header>
          <span class="eyebrow">Arrange inferrers</span>
          <strong>Same area · new poses</strong>
        </header>

        <div class="layouts-layer">
          {LAYOUT_STYLES.map((style) => (
            <figure class:list={['card', style, { active: style === 'grid' }]}>
              <figcaption>{LAYOUT_LABELS[style]}</figcaption>
              <div class="layout-style-icons">
                <img src={LAYOUT_ICONS[style]} alt="" width="56" height="56" />
              </div>
            </figure>
          ))}
        </div>

        <p class="footnote">
          Chip click swaps the inferrer — area handles stay put; only poses recompute.
        </p>
      </div>
    </div>
    <Fragment slot="annotations">
      <ArrowAnnotation
        tipX={-0.7}
        tipY={-0.55}
        angle={140}
        length={0.4}
        fontSize={annotationFontSize}
        text="Active style · brand chip"
      />
      <ArrowAnnotation
        tipX={0.78}
        tipY={-0.2}
        angle={25}
        length={0.38}
        fontSize={annotationFontSize}
        text="Inferrer reflow only"
      />
      <ArrowAnnotation
        tipX={-0.15}
        tipY={0.78}
        angle={-35}
        length={0.45}
        fontSize={annotationFontSize}
        text="Catalog category layouts"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

.wrapper {
  width: min(drawing.$artwork-width * 1.6, 94cqw);
  max-width: 100%;
  max-height: 84cqh;
  aspect-ratio: 1.45 / 1;
  position: relative;
}

.layouts-shell {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: stretch;
  padding: 0.35rem;
}

.panel {
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 0.5rem;
  padding: 0.7rem 0.8rem;
  border: 1px solid #333;
  border-radius: 0.35rem;
  background: color-mix(in oklab, var(--blueprint, #dce8f5) 50%, #fff);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  font-family: var(--font-poppins, system-ui, sans-serif);
  color: #1d241c;

  > header {
    display: grid;
    gap: 0.1rem;

    .eyebrow {
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #666;
    }

    strong {
      font-size: 0.95rem;
    }
  }

  .footnote {
    margin: 0;
    font-size: 0.6rem;
    line-height: 1.35;
    color: #555;
  }
}

.layouts-layer {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.4rem;
  align-content: center;
  color: #f3f3f4;
  min-height: 0;
}

.card {
  margin: 0;
  display: grid;
  gap: 0;
  justify-items: stretch;
  border: 1px solid #495057;
  border-radius: 0.25rem;
  overflow: hidden;
  background: #323232;

  figcaption {
    order: -1;
    padding: 0.25rem;
    font-size: 0.6rem;
    font-weight: 700;
    text-align: center;
    background: #212529;
  }

  &.active {
    box-shadow: 0 0 0 2px #89ab24;

    figcaption {
      background: #89ab24;
      color: #1d241c;
    }
  }

  svg {
    width: 100%;
    aspect-ratio: 1;
    padding: 0.3rem;
    background: linear-gradient(59deg, #dee2e6 0%, #adb5bd 100%);
    color: #565656;
  }

  .layout-style-icons {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0.45rem;
    background: linear-gradient(59deg, #dee2e6 0%, #adb5bd 100%);

    img {
      width: 70%;
      height: 70%;
      object-fit: contain;
    }
  }
}

@container technical-drawing (orientation: portrait) {
  .wrapper {
    width: min(92cqw, calc(78cqh * 1.1));
    aspect-ratio: 1.05 / 1;
    max-height: 78cqh;
  }

  .layouts-layer {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 40rem) {
  .layouts-layer {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
</style>
