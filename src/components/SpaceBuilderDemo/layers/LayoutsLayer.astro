---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import { LAYOUT_LABELS, LAYOUT_STYLES } from '../MockScene/scene/layoutEngine';
import { LAYOUT_ICONS } from '../MockScene/layoutIcons';

const annotationScale = 0.85;
const annotationFontSize = 0.1 * annotationScale;

const gridDots = [
  [18, 28], [42, 28], [66, 28],
  [18, 52], [42, 52], [66, 52],
  [18, 76], [42, 76], [66, 76],
];

const circleDots = [
  [50, 22], [72, 34], [78, 58], [64, 78],
  [36, 78], [22, 58], [28, 34],
];
---

<div class="wrapper">
  <Annotations scale={annotationScale}>
    <div class="diagram" slot="content" aria-hidden="true">
      <div class="panel">
        <header>
          <span class="eyebrow">Layout styles</span>
          <strong>Same SelectArea · new chair poses</strong>
          <p class="lede">
            Click a layout chip and only the arrangement changes. The drawn area and grab
            handles stay put — Grid, Circle, Chevron, and the rest are swap-in strategies.
          </p>
        </header>

        <div class="stage">
          <div class="reflow">
            <figure class="sample">
              <figcaption>Grid</figcaption>
              <div class="mini-area">
                {gridDots.map(([x, y]) => (
                  <span class="dot" style={`--x:${x}%; --y:${y}%`} />
                ))}
              </div>
            </figure>
            <span class="reflow-arrow" aria-hidden="true">→</span>
            <figure class="sample">
              <figcaption>Circle</figcaption>
              <div class="mini-area">
                {circleDots.map(([x, y]) => (
                  <span class="dot" style={`--x:${x}%; --y:${y}%`} />
                ))}
              </div>
            </figure>
            <p class="reflow-note">
              Area + handles unchanged — the chip only swaps how seats are packed.
            </p>
          </div>

          <div class="layouts-layer">
            {LAYOUT_STYLES.map((style) => (
              <figure class:list={['style', style, { active: style === 'grid' }]}>
                <figcaption>{LAYOUT_LABELS[style]}</figcaption>
                <div class="layout-style-icons">
                  <img src={LAYOUT_ICONS[style]} alt="" width="56" height="56" />
                </div>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
    <Fragment slot="annotations">
      <ArrowAnnotation
        tipX={-0.72}
        tipY={-0.52}
        angle={145}
        length={0.4}
        fontSize={annotationFontSize}
        text="Active layout chip"
      />
      <ArrowAnnotation
        tipX={0.05}
        tipY={-0.72}
        angle={100}
        length={0.38}
        fontSize={annotationFontSize}
        text="Poses recompute"
      />
      <ArrowAnnotation
        tipX={0.78}
        tipY={0.35}
        angle={20}
        length={0.4}
        fontSize={annotationFontSize}
        text="Seven pack styles"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

.wrapper {
  width: min(drawing.$artwork-width * 1.65, 94cqw);
  max-width: 100%;
  height: auto;
  max-height: 84cqh;
  aspect-ratio: 1.5 / 1;
  position: relative;
}

.diagram {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 14rem;
}

.panel {
  position: absolute;
  inset: 3%;
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 0.45rem;
  padding: 0.65rem 0.75rem 0.7rem;
  border: 1px solid #333;
  border-radius: 0.35rem;
  background: color-mix(in oklab, var(--blueprint, #dce8f5) 55%, #fff);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  font-family: var(--font-poppins, system-ui, sans-serif);
  color: #1d241c;

  > header {
    display: grid;
    gap: 0.15rem;

    .eyebrow {
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #666;
    }

    strong {
      font-size: 0.95rem;
      line-height: 1.2;
    }

    .lede {
      margin: 0.15rem 0 0;
      max-width: 58ch;
      font-size: 0.68rem;
      line-height: 1.35;
      color: #3d453a;
    }
  }
}

.stage {
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 0.45rem;
  min-height: 0;
  padding: 0.5rem;
  border-radius: 0.25rem;
  background: linear-gradient(180deg, #2a2a2a 0%, #212121 100%);
  border: 1px solid #444;
  overflow: hidden;
}

.reflow {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  grid-template-rows: auto auto;
  gap: 0.35rem 0.45rem;
  align-items: center;
  padding: 0.35rem 0.4rem;
  border-radius: 0.2rem;
  background: #2f2f2f;
  border: 1px solid #495057;
}

.sample {
  margin: 0;
  display: grid;
  gap: 0.25rem;

  figcaption {
    font-size: 0.55rem;
    font-weight: 700;
    color: #ced4da;
    text-align: center;
  }
}

.mini-area {
  position: relative;
  height: 3.4rem;
  border-radius: 0.15rem;
  border: 2px solid #6f8f1c;
  background: color-mix(in oklab, #89ab22 32%, transparent);
}

.dot {
  position: absolute;
  left: var(--x);
  top: var(--y);
  width: 0.42rem;
  height: 0.42rem;
  translate: -50% -50%;
  border-radius: 0.08rem;
  background: #5a4030;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
}

.reflow-arrow {
  font-size: 1.1rem;
  color: #89ab22;
  font-weight: 700;
}

.reflow-note {
  grid-column: 1 / -1;
  margin: 0;
  font-size: 0.52rem;
  line-height: 1.35;
  color: #adb5bd;
  text-align: center;
}

.layouts-layer {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.35rem;
  align-content: center;
  color: #f3f3f4;
  min-height: 0;
}

.style {
  margin: 0;
  display: grid;
  gap: 0;
  justify-items: stretch;
  border: 1px solid #495057;
  border-radius: 0.25rem;
  overflow: hidden;
  background: #323232;

  figcaption {
    order: -1;
    padding: 0.22rem;
    font-size: 0.58rem;
    font-weight: 700;
    text-align: center;
    background: #212529;
  }

  &.active {
    box-shadow: 0 0 0 2px #89ab24;

    figcaption {
      background: #89ab24;
      color: #1d241c;
    }
  }

  .layout-style-icons {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0.35rem;
    background: linear-gradient(59deg, #dee2e6 0%, #adb5bd 100%);

    img {
      width: 70%;
      height: 70%;
      object-fit: contain;
    }
  }
}

@container technical-drawing (orientation: portrait) {
  .wrapper {
    width: min(94cqw, calc(76cqh * 1.2));
    aspect-ratio: 1.1 / 1;
    max-height: 76cqh;
  }

  .panel > header .lede {
    font-size: 0.62rem;
  }

  .layouts-layer {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 40rem) {
  .layouts-layer {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
</style>
