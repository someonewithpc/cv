---

<div
  class="mock-scene-demo"
  data-space-builder-island
  tabindex="-1"
>
  <div class="boot-placeholder" aria-hidden="true">
    <span class="boot-spinner" />
    <span>Loading Space Builder…</span>
  </div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from './boot';

bootIslands('[data-space-builder-island]', boot);
</script>

<style lang="scss">
// Stretch the drawing content cell so the interactive frame can fill the sheet
// (default .content is fit-content + centered, which left empty vertical space).
:global(article.technical-drawing-stack > * > section .content:has(.mock-scene-demo)) {
  place-self: stretch;
  align-self: stretch;
  justify-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  // The sheet's inner border line sits right at the cell's edge (Page.astro's inset
  // box-shadow), so a frame filling the cell would paint over it.
  box-sizing: border-box;
  padding: 2px;
  // The title block is absolutely placed in the sheet's bottom-right corner, over this
  // cell, so an app filling the cell ran its catalog and its Drag & Drop footer under the
  // block's lettering. Reserve the block's measured height at the bottom and the app ends
  // above it. --title-block-reach (Demo.astro) is that height on a sheet that corners the
  // block and 0 on one that gives it a row of its own.
  padding-bottom: calc(2px + var(--title-block-reach, 0px));
}

.mock-scene-demo {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  // Clip instead of auto — overflow:auto + max-height thrashes scrollbars
  // at the fit boundary (especially while the layout is still settling).
  overflow: hidden;
  border-radius: 0.35em;
  outline: none;
  color-scheme: only dark;
  box-shadow: inset 0 0 0 1px color-mix(in oklab, #000 35%, transparent);
  background: #212121;
  container-type: size;

  @container technical-drawing (orientation: portrait) {
    // In portrait the content row is shorter — keep a usable minimum so the
    // 3D view doesn't collapse under the aside/title block.
    min-height: min(52cqh, 100%);
  }

  &:focus-visible {
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, #000 35%, transparent),
      0 0 0 2px #89ab24;
  }

  .boot-placeholder {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    background: #212121;
    color: #adb5bd;
    font: 0.875rem/1.3 system-ui, sans-serif;
  }

  .boot-spinner {
    width: 1.75rem;
    height: 1.75rem;
    border: 3px solid #89ab24;
    border-top-color: transparent;
    border-radius: 50%;
    animation: loading-spin 0.8s linear infinite;

    @media (prefers-reduced-motion: reduce) {
      animation: none;
      border-color: #89ab24;
    }
  }
}
</style>
