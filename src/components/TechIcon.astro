---
import { Icon } from 'astro-icon/components';

import type { Tech } from '@/server/tech-icons';

type Props = {
  tech: Tech;
  class?: string;
  /** When true, hide from AT (pair with visible text, or pure decoration). */
  decorative?: boolean;
};

/** Icons whose fills must not be remapped when the page is in dark color-scheme.
 *  Iconify strips style="color-scheme" from local SVG roots, so set it on the
 *  rendered <svg> (inline style wins over the inherit rule below). */
const LOCK_COLOR_SCHEME_LIGHT = new Set([
  'php',
  'python',
  'rust',
  'prolog',
  'emacs',
  'linux',
  'gcc',
  'postgresql',
  'mysql',
  'symfony',
  'vulkan',
]);

const { tech, class: className, decorative = false } = Astro.props;
---

<span
  class:list={['tech-icon', className]}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : tech.text}
>
  <Icon
    name={tech.icon}
    is:inline
    aria-hidden="true"
    style={LOCK_COLOR_SCHEME_LIGHT.has(tech.icon) ? 'color-scheme: only light' : undefined}
  />
</span>

<style lang="scss">
.tech-icon {
  display: inline-flex;
  --icon-contrast-stroke: rgb(0 0 0 / 0.5);
  --icon-contrast-stroke-width: 3;
  --icon-outer-stroke: transparent;
  --icon-outer-stroke-width: 2.75;
  --mysql-stroke: #00618a;
  --mysql-stroke-width: 3.5;
  --postgres-stroke: #1a171b;
  --postgres-stroke-width: 1.25;

  /* Follow ThemePicker / prefers-color-scheme so SVG light-dark() strokes work.
     Layout forces color-scheme: only light on bare svg. */
  :global(svg) {
    color-scheme: inherit;
  }
}

/* Dark-following themes (dark, dark-forest): boost contrast strokes */
:global(:root:has(#theme-picker input[name='theme'][value='dark']:is(:not(.with-transition):checked, .with-transition.checked))),
:global(:root:has(#theme-picker input[name='theme'][value='dark-forest']:is(:not(.with-transition):checked, .with-transition.checked))),
:global(:root[data-theme='dark']),
:global(:root[data-theme='dark-forest']) {
  .tech-icon {
    --icon-contrast-stroke: rgb(255 255 255 / 0.65);
    --icon-contrast-stroke-width: 9;
    --icon-outer-stroke: rgb(255 255 255 / 0.85);
    --icon-outer-stroke-width: 3.25;
    --mysql-stroke: rgb(255 255 255 / 0.75);
    --mysql-stroke-width: 1.75;
    --postgres-stroke: rgb(255 255 255 / 0.55);
    --postgres-stroke-width: 1;
  }
}

@media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme]):not(:has(#theme-picker input[name='theme']:is(:not(.with-transition):checked, .with-transition.checked)))) {
    .tech-icon {
      --icon-contrast-stroke: rgb(255 255 255 / 0.65);
      --icon-contrast-stroke-width: 9;
      --icon-outer-stroke: rgb(255 255 255 / 0.85);
      --icon-outer-stroke-width: 3.25;
      --mysql-stroke: rgb(255 255 255 / 0.75);
      --mysql-stroke-width: 1.75;
      --postgres-stroke: rgb(255 255 255 / 0.55);
      --postgres-stroke-width: 1;
    }
  }
}
</style>

<style is:global>
/* SVGO drops paint-order from the SVG; without it the contrast stroke paints over the fill.
   Set on the host: it inherits, so it reaches the paths a <use> instantiates too. */
svg[data-icon='postgresql'] {
  paint-order: stroke fill;
}
</style>
