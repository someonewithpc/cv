---
import { Icon } from 'astro-icon/components';

import type { TechTag } from '@/server/tech-tags';

type Props = {
  tag: TechTag;
  class?: string;
};

/** Icons whose fills must not be remapped when the page is in dark color-scheme.
 *  Iconify strips style="color-scheme" from local SVG roots, so set it on the
 *  rendered <svg> (inline style wins over the inherit rule below). */
const LOCK_COLOR_SCHEME_LIGHT = new Set([
  'php',
  'python',
  'rust',
  'prolog',
  'emacs',
  'linux',
  'gcc',
  'mysql',
  'symfony',
  'vulkan',
]);

/** Already light via currentColor / light fills — a halo washes them out. */
const SKIP_DARK_HALO = new Set([
  'bash',
  'leaflet',
  'lisp',
  'javascript',
  'typescript',
  'css3',
]);

const { tag, class: className } = Astro.props;
const needsHalo = !SKIP_DARK_HALO.has(tag.icon);
---

<span class:list={['tech-icon', needsHalo && 'tech-icon--halo', className]}>
  <Icon
    name={tag.icon}
    is:inline
    aria-hidden="true"
    title={tag.text}
    style={LOCK_COLOR_SCHEME_LIGHT.has(tag.icon) ? 'color-scheme: only light' : undefined}
  />
</span>

<style lang="scss">
.tech-icon {
  display: inline-flex;
  width: 1.5em;
  height: 1.5em;
  flex-shrink: 0;
  --icon-contrast-stroke: rgb(0 0 0 / 0.5);
  --icon-contrast-stroke-width: 3;
  --icon-outer-stroke: transparent;
  --icon-outer-stroke-width: 2.75;
  --mysql-stroke: #00618a;
  --mysql-stroke-width: 3.5;

  /* Follow ThemePicker / prefers-color-scheme so SVG light-dark() strokes work.
     Layout forces color-scheme: only light on bare svg. */
  :global(svg) {
    width: 100%;
    height: 100%;
    color-scheme: inherit;
  }
}

@mixin dark-icon-contrast {
  --icon-contrast-stroke: rgb(255 255 255 / 0.95);
  --icon-contrast-stroke-width: 11;
  --icon-outer-stroke: rgb(255 255 255 / 0.95);
  --icon-outer-stroke-width: 4.5;
  --mysql-stroke: rgb(255 255 255 / 0.95);
  --mysql-stroke-width: 2.75;

  &.tech-icon--halo :global(svg) {
    /* Tight outline halo — keeps dark brand fills readable without blooming. */
    filter:
      drop-shadow(0 0 0.35px rgb(255 255 255 / 1))
      drop-shadow(0 0 0.7px rgb(255 255 255 / 0.95))
      drop-shadow(0 0 1.1px rgb(255 255 255 / 0.7));
  }
}

:global(:root:has(#theme-picker input[name='theme'][value='dark']:is(:not(.with-transition):checked, .with-transition.checked))) {
  .tech-icon {
    @include dark-icon-contrast;
  }
}

@media (prefers-color-scheme: dark) {
  :global(:root:not(:has(#theme-picker input[name='theme']:is(:not(.with-transition):checked, .with-transition.checked)))) {
    .tech-icon {
      @include dark-icon-contrast;
    }
  }
}
</style>
