---
/**
 * A drawing callout: a reference bubble with the detail's letter, its label, a leader down to a
 * chain-line boundary, and the view itself inside that boundary. The wrapper is a plain section
 * so the caller's own id and children sit directly in it.
 */
type Props = {
  id?: string;
  class?: string;
  /** Reference letter in the bubble: A, B, C. */
  letter: string;
  title: string;
  titleJp?: string;
  scale?: string;
  headingId: string;
  /** Which side of the view the `card` slot stands on, wherever there is a lane for it. */
  cardSide?: 'start' | 'end';
};

const { id, class: className, letter, title, titleJp, scale, headingId, cardSide } = Astro.props;

const hasCard = Astro.slots.has('card');
---

<section
  id={id}
  class:list={['callout', className]}
  data-card={hasCard ? (cardSide ?? 'start') : undefined}
  aria-labelledby={headingId}
>
  <h3 id={headingId} class="callout-label">
    <span class="callout-bubble typewriter" aria-hidden="true">{letter}</span>
    <span class="callout-text">
      <span class="callout-kind monospace">
        <span>Detail {letter}</span>
        {scale && <span class="callout-scale">Scale {scale}</span>}
      </span>
      {titleJp && <small lang="ja">{titleJp}</small>}
      <span class="callout-title typewriter">{title}</span>
    </span>
  </h3>

  {hasCard && (
    <div class="callout-card">
      <slot name="card" />
      <span class="callout-card-leader" aria-hidden="true"></span>
    </div>
  )}

  <slot />
</section>

<style lang="scss">
.callout {
  --callout-line: color-mix(in oklch, var(--ink), transparent 30%);
  --callout-pad: 1.5rem;
  /* Above and below, the clearance also has to clear a line of text the view writes outside
     its own box, the way a drawing stack writes its peel hint just under the sheet. */
  --callout-room: calc(var(--callout-pad) + 1.5rem);
  --callout-lead: 1.75rem;
  /* The label's box; the bubble sits at its bottom, so the leader below it has a known length. */
  --callout-label: 3.75rem;

  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  /* The boundary stands the same clearance off the view on all four sides, but the two sides
     are drawn outside the box rather than padded in, so the view keeps the full width of the
     column it was given. */
  padding: calc(var(--callout-label) + var(--callout-lead) + var(--callout-room)) 0 var(--callout-room);

  /* The chain-line boundary of the view: long dash, gap, short dash, gap. */
  &::before {
    content: '';
    position: absolute;
    inset: calc(var(--callout-label) + var(--callout-lead)) calc(-1 * var(--callout-pad)) 0;
    pointer-events: none;
    --dash: repeating-linear-gradient(90deg, var(--callout-line) 0 1rem, transparent 1rem 1.375rem, var(--callout-line) 1.375rem 1.625rem, transparent 1.625rem 2rem);
    --dash-v: repeating-linear-gradient(180deg, var(--callout-line) 0 1rem, transparent 1rem 1.375rem, var(--callout-line) 1.375rem 1.625rem, transparent 1.625rem 2rem);
    background:
      var(--dash) top / 100% 1px no-repeat,
      var(--dash) bottom / 100% 1px no-repeat,
      var(--dash-v) left / 1px 100% no-repeat,
      var(--dash-v) right / 1px 100% no-repeat;
  }

  > :global(*) {
    min-width: 0;
  }

  /* The side lines are drawn outside the box, and on a phone the only room out there is the
     mat's rim, so the clearance shrinks to a few pixels rather than landing on the mat's edge. */
  @media (max-width: 52rem) {
    --callout-pad: 0.375rem;
    --callout-lead: 1.5rem;
    --callout-label: 3rem;
  }
}

/* The card stands in the lane the mat opens beside the view (index.astro), so the view takes
   the rest of the column and the two together stay centred on the mat. With no lane open
   there is no card, and this is the column the view has always had. */
.callout[data-card] {
  width: min(100%, var(--breakout-max, 100%));
}

.callout[data-card='start'] {
  justify-self: end;
}

.callout[data-card='end'] {
  justify-self: start;
}

/* Never under the view: the card is shown only where the lane is (--card-display), and it is
   hung from the top of the boundary rather than laid out in the flow. */
.callout-card {
  display: var(--card-display, none);
  position: absolute;
  top: calc(var(--callout-label) + var(--callout-lead));
  width: var(--card-width, 12rem);

  .callout[data-card='start'] & {
    inset-inline-end: calc(100% + var(--card-gap, 3rem));
  }

  .callout[data-card='end'] & {
    inset-inline-start: calc(100% + var(--card-gap, 3rem));
  }
}

/* The leader runs level from the card's near edge to the boundary and ends in an arrowhead on
   it, in the boundary's own ink. The lane is measured to the view's box, so what is left over
   for the leader is the lane's gap less the clearance the boundary is drawn out at. */
.callout-card-leader {
  position: absolute;
  /* Level with the card's title cell, which is where a leader off a title block would start. */
  top: 1.75rem;
  width: calc(var(--card-gap, 3rem) - var(--callout-pad));
  height: 0.5rem;

  &::before {
    content: '';
    position: absolute;
    inset-block: calc(50% - 0.5px);
    inset-inline: 0;
    background: var(--callout-line);
  }

  &::after {
    content: '';
    position: absolute;
    inset-block: 0;
    width: 0.5rem;
    background: var(--callout-line);
  }

  .callout[data-card='start'] & {
    inset-inline-start: 100%;

    &::after {
      inset-inline-end: 0;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }
  }

  .callout[data-card='end'] & {
    inset-inline-end: 100%;

    &::after {
      inset-inline-start: 0;
      clip-path: polygon(100% 0, 0 50%, 100% 100%);
    }
  }
}

.callout-label {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--callout-label);
  display: flex;
  align-items: flex-end;
  gap: 0.875rem;
  font-size: 1rem;

  @media (max-width: 52rem) {
    gap: 0.625rem;
  }
}

.callout-bubble {
  position: relative;
  display: grid;
  place-items: center;
  flex: none;
  width: 3rem;
  height: 3rem;
  margin-left: 0.625rem;
  border: 2px solid var(--callout-line);
  border-radius: 50%;
  background: var(--mat-paper);
  font-size: 1.5rem;
  line-height: 1;
  color: var(--ink);

  /* The leader: straight down from the bubble to the boundary, ending in a dot on the line. */
  &::before {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 1px;
    height: var(--callout-lead);
    background: var(--callout-line);
  }

  &::after {
    content: '';
    position: absolute;
    top: calc(100% + var(--callout-lead) - 0.1875rem);
    left: calc(50% - 0.1875rem);
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--callout-line);
  }

  @media (max-width: 52rem) {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.25rem;
    margin-left: 0.375rem;
  }
}

.callout-text {
  display: grid;
  gap: 0.125rem;
  padding-bottom: 0.25rem;
  min-width: 0;
}

.callout-kind {
  display: flex;
  gap: 1.5rem;
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent-text);
}

.callout-scale {
  color: var(--ink-faint);
}

.callout-title {
  font-size: clamp(1.25rem, 3vw, 1.75rem);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.05;
  color: var(--ink);
  text-wrap: balance;
}

.callout :global([lang='ja']) {
  display: block;
  font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
  font-weight: 400;
  font-size: 0.6875rem;
  letter-spacing: 0.12em;
  color: color-mix(in oklch, var(--ink-faint), transparent 20%);
}
</style>
