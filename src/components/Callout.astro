---
/**
 * A drawing callout: a reference bubble with the detail's letter, its label, a leader down to a
 * chain-line boundary, and the view itself inside that boundary. The wrapper is a plain section
 * so the caller's own id and children sit directly in it.
 */
type Props = {
  id?: string;
  class?: string;
  /** Reference letter in the bubble: A, B, C. */
  letter: string;
  title: string;
  titleJp?: string;
  scale?: string;
  headingId: string;
};

const { id, class: className, letter, title, titleJp, scale, headingId } = Astro.props;
---

<section id={id} class:list={['callout', className]} aria-labelledby={headingId}>
  <h3 id={headingId} class="callout-label">
    <span class="callout-bubble typewriter" aria-hidden="true">{letter}</span>
    <span class="callout-text">
      <span class="callout-kind monospace">
        <span>Detail {letter}</span>
        {scale && <span class="callout-scale">Scale {scale}</span>}
      </span>
      {titleJp && <small lang="ja">{titleJp}</small>}
      <span class="callout-title typewriter">{title}</span>
    </span>
  </h3>
  <slot />
</section>

<style lang="scss">
.callout {
  --callout-line: color-mix(in oklch, var(--ink), transparent 30%);
  --callout-pad: 1.5rem;
  /* Above and below, the clearance also has to clear a line of text the view writes outside
     its own box, the way a drawing stack writes its peel hint just under the sheet. */
  --callout-room: calc(var(--callout-pad) + 1.5rem);
  --callout-lead: 1.75rem;
  /* The label's box; the bubble sits at its bottom, so the leader below it has a known length. */
  --callout-label: 3.75rem;

  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  /* The boundary stands the same clearance off the view on all four sides, but the two sides
     are drawn outside the box rather than padded in, so the view keeps the full width of the
     column it was given. */
  padding: calc(var(--callout-label) + var(--callout-lead) + var(--callout-room)) 0 var(--callout-room);

  /* The chain-line boundary of the view: long dash, gap, short dash, gap. */
  &::before {
    content: '';
    position: absolute;
    inset: calc(var(--callout-label) + var(--callout-lead)) calc(-1 * var(--callout-pad)) 0;
    pointer-events: none;
    --dash: repeating-linear-gradient(90deg, var(--callout-line) 0 1rem, transparent 1rem 1.375rem, var(--callout-line) 1.375rem 1.625rem, transparent 1.625rem 2rem);
    --dash-v: repeating-linear-gradient(180deg, var(--callout-line) 0 1rem, transparent 1rem 1.375rem, var(--callout-line) 1.375rem 1.625rem, transparent 1.625rem 2rem);
    background:
      var(--dash) top / 100% 1px no-repeat,
      var(--dash) bottom / 100% 1px no-repeat,
      var(--dash-v) left / 1px 100% no-repeat,
      var(--dash-v) right / 1px 100% no-repeat;
  }

  > :global(*) {
    min-width: 0;
  }

  /* The side lines are drawn outside the box, and on a phone the only room out there is the
     mat's rim, so the clearance shrinks to a few pixels rather than landing on the mat's edge. */
  @media (max-width: 52rem) {
    --callout-pad: 0.375rem;
    --callout-lead: 1.5rem;
    --callout-label: 3rem;
  }
}

.callout-label {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--callout-label);
  display: flex;
  align-items: flex-end;
  gap: 0.875rem;
  font-size: 1rem;

  @media (max-width: 52rem) {
    gap: 0.625rem;
  }
}

.callout-bubble {
  position: relative;
  display: grid;
  place-items: center;
  flex: none;
  width: 3rem;
  height: 3rem;
  margin-left: 0.625rem;
  border: 2px solid var(--callout-line);
  border-radius: 50%;
  background: var(--mat-paper);
  font-size: 1.5rem;
  line-height: 1;
  color: var(--ink);

  /* The leader: straight down from the bubble to the boundary, ending in a dot on the line. */
  &::before {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 1px;
    height: var(--callout-lead);
    background: var(--callout-line);
  }

  &::after {
    content: '';
    position: absolute;
    top: calc(100% + var(--callout-lead) - 0.1875rem);
    left: calc(50% - 0.1875rem);
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--callout-line);
  }

  @media (max-width: 52rem) {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.25rem;
    margin-left: 0.375rem;
  }
}

.callout-text {
  display: grid;
  gap: 0.125rem;
  padding-bottom: 0.25rem;
  min-width: 0;
}

.callout-kind {
  display: flex;
  gap: 1.5rem;
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent-text);
}

.callout-scale {
  color: var(--ink-faint);
}

.callout-title {
  font-size: clamp(1.25rem, 3vw, 1.75rem);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.05;
  color: var(--ink);
  text-wrap: balance;
}

.callout :global([lang='ja']) {
  display: block;
  font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
  font-weight: 400;
  font-size: 0.6875rem;
  letter-spacing: 0.12em;
  color: color-mix(in oklch, var(--ink-faint), transparent 20%);
}
</style>
