---
/**
 * A drawing callout: a reference bubble with the detail's letter, its label, a leader down to a
 * chain-line boundary, and the view itself inside that boundary. The boundary is the view's own
 * wrapper, drawn on its edge, so it goes round whatever the view is and not a guess at it.
 */
type Props = {
  id?: string;
  class?: string;
  /** Reference letter in the bubble: A, B, C. */
  letter: string;
  title: string;
  titleJp?: string;
  scale?: string;
  headingId: string;
  /** Which side of the view the `card` slot stands on, wherever there is a lane for it. */
  cardSide?: 'start' | 'end';
};

const { id, class: className, letter, title, titleJp, scale, headingId, cardSide } = Astro.props;

const hasCard = Astro.slots.has('card');
---

<section
  id={id}
  class:list={['callout', className]}
  data-card={hasCard ? (cardSide ?? 'start') : undefined}
  aria-labelledby={headingId}
>
  <h3 id={headingId} class="callout-label">
    <span class="callout-bubble typewriter" aria-hidden="true"><span class="callout-letter">{letter}</span></span>
    <span class="callout-text">
      <span class="callout-kind monospace">
        <span>Detail {letter}</span>
        {scale && <span class="callout-scale">Scale {scale}</span>}
      </span>
      {titleJp && <small lang="ja">{titleJp}</small>}
      <span class="callout-title typewriter">{title}</span>
    </span>
  </h3>

  <div class="callout-view">
    {hasCard && (
      <div class="callout-slip">
        <div class="callout-card">
          <slot name="card" />
          <span class="callout-card-leader" aria-hidden="true"></span>
        </div>
      </div>
    )}
    <slot />
  </div>
</section>

<style lang="scss">
.callout {
  --callout-line: color-mix(in oklch, var(--ink), transparent 30%);
  /* The least clearance that takes a line of text the view writes outside its own box, the
     way a drawing stack writes its peel hints above and under the sheet. */
  --callout-pad: 1.75rem;
  /* How far the side lines stand out past the column the callout is given. They are drawn in
     the mat's slack rather than padded in, because a view made narrower scales its drawing
     down and the drawing's own labels start to collide. On the desk the mat says how far
     (--mat-boundary, Layout.astro). Off the desk the mat has only its rim, and the sides keep
     to --callout-pad. */
  --callout-out: var(--mat-boundary, var(--callout-pad));
  /* Above and below the view the boundary stands as far off as it does at the sides, so it
     is the same distance from the view all round. */
  --callout-room: var(--callout-out);
  --callout-lead: 1.75rem;
  /* The label's box; the bubble sits at its bottom, so the leader below it has a known length. */
  --callout-label: 3.75rem;

  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  padding-top: calc(var(--callout-label) + var(--callout-lead));

  > :global(*) {
    min-width: 0;
  }

  /* The side lines are drawn outside the column, and on a phone the only room out there is the
     mat's rim, so they stand a few pixels out rather than landing on the mat's edge. */
  @media (max-width: 52rem) {
    --callout-pad: 0.375rem;
    --callout-lead: 1.5rem;
    --callout-label: 3rem;
    /* That is too close for the line a drawing stack writes above or under its sheet, its peel
       hint, so the stack writes it on the mat past the boundary instead (Stack.astro). */
    --hint-clear: calc(var(--callout-pad) + 0.25rem);
  }
}

/* The chain-line boundary of the view: long dash, gap, short dash, gap. The view's own wrapper
   draws it, so it goes round the view and the lines the view writes outside itself. */
.callout-view {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  margin-inline: calc(-1 * var(--callout-out));
  padding: var(--callout-room) var(--callout-out);
  --dash: repeating-linear-gradient(90deg, var(--callout-line) 0 1rem, transparent 1rem 1.375rem, var(--callout-line) 1.375rem 1.625rem, transparent 1.625rem 2rem);
  --dash-v: repeating-linear-gradient(180deg, var(--callout-line) 0 1rem, transparent 1rem 1.375rem, var(--callout-line) 1.375rem 1.625rem, transparent 1.625rem 2rem);
  background:
    var(--dash) top / 100% 1px no-repeat,
    var(--dash) bottom / 100% 1px no-repeat,
    var(--dash-v) left / 1px 100% no-repeat,
    var(--dash-v) right / 1px 100% no-repeat;

  > :global(*) {
    min-width: 0;
  }
}

/* The card stands in the lane the mat opens beside the view (index.astro), so the view takes
   the rest of the column and the two together stay centred on the mat. With no lane open
   there is no card, and this is the column the view has always had. */
.callout[data-card] {
  width: min(100%, var(--breakout-max, 100%));
}

.callout[data-card='start'] {
  justify-self: end;
}

.callout[data-card='end'] {
  justify-self: start;
}

/* Never under the view: the card is shown only where the lane is (--card-display), and it is
   hung from the top of the boundary rather than laid out in the flow. */
.callout-card {
  display: var(--card-display, none);
  position: absolute;
  top: calc(var(--callout-label) + var(--callout-lead));
  width: var(--card-width);

  .callout[data-card='start'] & {
    inset-inline-end: calc(100% + var(--card-gap));
  }

  .callout[data-card='end'] & {
    inset-inline-start: calc(100% + var(--card-gap));
  }
}

/* The leader runs level from the card's near edge to the boundary and ends in an arrowhead on
   it, in the boundary's own ink. The lane is measured to the view's box, so what is left over
   for the leader is the lane's gap less the clearance the boundary is drawn out at. */
.callout-card-leader {
  position: absolute;
  /* Level with the card's title cell, which is where a leader off a title block would start. */
  top: 1.75rem;
  width: calc(var(--card-gap) - var(--callout-out));
  height: 0.5rem;

  &::before {
    content: '';
    position: absolute;
    inset-block: calc(50% - 0.5px);
    inset-inline: 0;
    background: var(--callout-line);
  }

  &::after {
    content: '';
    position: absolute;
    inset-block: 0;
    width: 0.5rem;
    background: var(--callout-line);
  }

  .callout[data-card='start'] & {
    inset-inline-start: 100%;

    &::after {
      inset-inline-end: 0;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }
  }

  .callout[data-card='end'] & {
    inset-inline-end: 100%;

    &::after {
      inset-inline-start: 0;
      clip-path: polygon(100% 0, 0 50%, 100% 100%);
    }
  }
}

.callout-label {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--callout-label);
  display: flex;
  align-items: flex-end;
  gap: 0.875rem;
  font-size: 1rem;

  @media (max-width: 52rem) {
    gap: 0.625rem;
  }
}

.callout-bubble {
  position: relative;
  display: grid;
  place-items: center;
  /* Special Elite's ascender and descender are unequal, so centring the line box leaves the
     cap 3px above the circle's middle at both sizes: 0.14em of the face's size, measured. */
  --bubble-cap: 0.14em;
  flex: none;
  width: 3rem;
  height: 3rem;
  margin-left: 0.625rem;
  --bubble-ring: 2px;
  border: var(--bubble-ring) solid var(--callout-line);
  border-radius: 50%;
  background: var(--mat-paper);
  font-size: 1.5rem;
  line-height: 1;
  color: var(--ink);

  .callout-letter {
    display: block;
    translate: 0 var(--bubble-cap);

    /* The face's own ascent box down to its baseline, which is what the nudge above
       approximates. Not its cap box: Special Elite declares a cap height of about a third of
       its size, which lands the letter further off the middle than doing nothing at all. */
    @supports (text-box-trim: trim-both) {
      text-box-trim: trim-both;
      text-box-edge: text alphabetic;
      translate: none;
    }
  }

  /* The leader: straight down from the bubble to the boundary, ending in a dot centred on the
     line. Both hang from the padding box, which stops the ring's width short of the bubble's
     edge, and the boundary is a 1px line down from the view's top, so the dot's centre is the
     ring, the leader and half that line below it. Across, the leader is 1px wide from the
     middle, so the dot is centred half a pixel right of it too. */
  --leader-end: calc(100% + var(--bubble-ring) + var(--callout-lead) + 0.5px);

  &::before {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 1px;
    height: calc(var(--leader-end) - 100%);
    background: var(--callout-line);
  }

  &::after {
    content: '';
    position: absolute;
    top: calc(var(--leader-end) - 0.1875rem);
    left: calc(50% + 0.5px - 0.1875rem);
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--callout-line);
  }

  @media (max-width: 52rem) {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.25rem;
    margin-left: 0.375rem;
  }
}

.callout-text {
  display: grid;
  gap: 0.125rem;
  padding-bottom: 0.25rem;
  min-width: 0;
}

.callout-kind {
  display: flex;
  gap: 1.5rem;
  font-size: 0.625rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent-text);
}

.callout-scale {
  color: var(--ink-faint);
}

.callout-title {
  font-size: clamp(1.25rem, 3vw, 1.75rem);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.05;
  color: var(--ink);
  text-wrap: balance;
}

.callout :global([lang='ja']) {
  display: block;
  font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Noto Sans JP', sans-serif;
  font-weight: 400;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  color: color-mix(in oklch, var(--ink-faint), transparent 20%);
  background-image: linear-gradient(transparent, transparent);
}

/* On the desk the wrapper has no box of its own. Below the lane it is the slip's row in the
   view, as wide as the view, so the slip can measure against the stack's width (cqi) from
   inside a box narrower than it. */
.callout-slip {
  display: contents;
}

/* Below the width the lane opens at (Layout.astro) the card has nowhere to stand beside the
   drawing, so it goes under it: a slip of the sheets' paper tucked under the stack, its top
   hidden by the sheets and only its entries showing below them, the way a note sheet is filed
   with a set. It is part of the drawing, so the boundary goes round it too. It is first in the
   view so a screen reader meets it before the demo; `order` lays it down after the stack. */
@media (width < 105rem) {
  .callout[data-card] .callout-view {
    isolation: isolate;
  }

  /* The stack fans its sheets out about a pin at its top-left corner, each turned by 1.5deg
     times the log of its place (PaperStack), so the hindmost one drops below the front sheet by
     the sine of its turn times how far along it is. The slip reads the stack's page count to
     know how far that is, and the peel hint Stack.astro writes for a stack that deep. */
  $in-words: 'one', 'two', 'three', 'four', 'five', 'six', 'seven';

  @for $pages from 2 through 8 {
    .callout-view:has([data-page-count='#{$pages}']) {
      --slip-pages: #{$pages};
      --slip-hint: '#{nth($in-words, $pages - 1)} more sheets, peel this corner';
    }
  }

  .callout[data-card] .callout-slip {
    --slip-tuck: 1rem;
    --slip-inset: 1.25rem;
    /* The text's inset from every edge of the slip that shows: its sides, its foot, and at the
       top whatever lies over it, the fan or the peel hint. */
    --slip-pad: 1rem;
    /* Clear of the peel hint the stack writes under its right-hand corner. */
    --slip-width: min(34rem, 100% - 24rem);
    --slip-turn: calc(1.5deg * log(var(--slip-pages, 6)));
    --slip-sine: sin(var(--slip-turn));
    --slip-paper: var(--theme-paper, light-dark(var(--surface-raised), var(--surface-sunken)));

    order: 1;
    display: block;
    position: relative;
    z-index: -1;
    container-type: inline-size;
    /* Up past the room the stack keeps below it for its fan, which is its width times that sine
       (a percentage margin is a share of the width too), and a little under the front sheet. */
    margin-top: calc(-100% * var(--slip-sine) - var(--slip-tuck));
    pointer-events: none;
  }

  /* The entries start as high as the fan and the peel hint over them allow, with the slip's
     own inset below whatever is over their text, so the gap above the first entry matches the
     slip's sides and foot. The entries stand below the slip's lead row, and the grid makes
     that row as deep as the deepest limit asks: the fan's, and the peel hint's piece by piece.
     Rounding the slip's height to a whole pixel leaves the lead row the difference. */
  .callout[data-card] .callout-card {
    /* 1 on a landscape sheet, 0 on a portrait one: the stack turns at 40em (Stack.astro). */
    --slip-land: max(0, sign(100cqi - 40rem));
    --slip-tan: tan(var(--slip-turn));
    /* The pin every sheet turns on, from the paper clip's reach (Stack.astro, PaperStack). */
    --slip-reach: clamp(2.75rem, 7.5cqi, 4.5rem);
    --slip-pin-x: calc(var(--slip-reach) / (2 + 2 * var(--slip-land)));
    --slip-pin-y: calc(var(--slip-reach) / (4 - 2 * var(--slip-land)));
    --slip-sheet: calc(var(--slip-land) * 50cqi + (1 - var(--slip-land)) * min(500cqi / 3, 36rem, 85svh));

    display: grid;
    grid-template-columns: [title-start] fit-content(100%) [title-end] minmax(0, 1fr);
    grid-template-rows: [lead] minmax(0, 1fr) [label] auto 0.125rem [text] auto [notes] auto;
    position: relative;
    top: auto;
    inset-inline: auto;
    width: var(--slip-width);
    /* What follows the slip stands on whole pixels: a fraction moved the open-source sheet's
       ruling off its writing. */
    height: calc-size(auto, round(nearest, size, 1px));
    margin-inline-start: var(--slip-inset);
    padding: 0 var(--slip-pad) var(--slip-pad);
    background: var(--slip-paper);
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    box-shadow: 0 1px 1px rgb(0 0 0 / 10%), 0 0.375rem 0.875rem rgb(0 0 0 / 14%);
    pointer-events: auto;

    /* The slip is a typed sheet, not a title block: no cells, each entry on its own rule. The
       card and its list lend the slip's grid to the entries. */
    > :global(.title-card) {
      display: grid;
      grid-template: subgrid / subgrid;
      grid-area: 1 / 1 / -1 / -1;
      background: none;
      border: 0;
      border-radius: 0;
    }

    /* The fan's lowest sheet runs down to the right, so how far down it is over the title
       depends on where the title's text ends: the width of the title column, times the slope.
       The rest depends on the stack's width alone: from the pin to the text's left edge along
       the slope, and how far the turn drops the sheet's edge. */
    > :global(.title-card::before) {
      content: '';
      grid-area: lead / title;
      padding-top: calc(
        var(--slip-tuck) + var(--slip-pad) - 1px
        + (var(--slip-sheet) - var(--slip-pin-y)) * (1 / cos(var(--slip-turn)) - 1)
        + (var(--slip-inset) + 1px + var(--slip-pad) - var(--slip-pin-x) + 100%) * var(--slip-tan)
      );
    }

    :global(.title-card dl) {
      grid-template: subgrid / subgrid;
      grid-area: label / 1 / -1 / -1;
      gap: 0;
    }

    :global(.title-cell) {
      grid-column: 1 / -1;
      padding: 0.375rem 0 0.4375rem;
      background: none;
      border-bottom: 1px solid color-mix(in oklch, var(--line-strong), transparent 45%);
    }

    /* Medium and Year are the two narrow cells. The slip keeps to Title and Notes. */
    :global(.title-cell:not(.title-cell-wide)) {
      display: none;
    }

    /* The title's label and text stand in the title column, which is as wide as they run. */
    :global(.title-cell:first-child) {
      grid-row: label / notes;
      grid-template: subgrid / subgrid;
      gap: 0;
    }

    :global(.title-cell:first-child dt) {
      grid-area: label / title;
    }

    :global(.title-cell:first-child dd) {
      grid-area: text / title;
    }

    :global(.title-cell-notes) {
      grid-row: notes;
      border-bottom: 0;
    }

    /* The inset runs to the text itself: the cap line of the first entry, the baseline of the
       last, not the half-leading round them. */
    :global(.title-cell:first-child) {
      padding-top: 0;
    }

    :global(.title-cell:first-child dt) {
      text-box: trim-start cap alphabetic;
    }

    :global(.title-cell-notes) {
      padding-bottom: 0;
    }

    :global(.title-cell-notes dd) {
      text-box: trim-end cap alphabetic;
    }

    :global(.title-cell-notes dd) {
      font-size: 0.8125rem;
      line-height: 1.55;
    }
  }

  /* The peel hint the top stack writes under its corner: a piece of the title (its label, its
     text, the rule under it) keeps the inset below the hint only where the hint's words, or
     the arrow that runs on from them to the sheet's corner, are over it. Text beside the hint
     keeps 3rem from its words, or the two read as one line: "TITLE five more sheets".

     Each probe lays the piece's span and the hint's span side by side across the stack's
     width, as tall as the piece has to stand below the slip's top. Where they meet, the hint
     wraps under the piece and the probe is twice as tall; its negative margin takes one height
     back off, so the probe asks for that depth only when the hint is over the piece. */
  .callout-view:has(.technical-drawing-frame[data-hint-show]) .callout-card :global(.title-probe) {
    /* The hint's type (Stack.astro): smaller on a portrait sheet. */
    --probe-hint: calc(0.875rem + 0.125rem * var(--slip-land));
    /* The hint's foot below the slip's top: the stack's fan reserve, the tuck, the room the
       view keeps it from its boundary, then its offset and its line, each cut to the layout
       unit (1/64px) the way layout cuts them where the stack and the hint are laid out. */
    --probe-foot: calc(
      round(down, var(--slip-sine) * 100cqi, 1px / 64) + var(--slip-tuck) + var(--hint-clear, 0px)
      + round(down, 0.125 * var(--probe-hint), 1px / 64) + round(down, 1.2 * var(--probe-hint), 1px / 64)
    );
    --probe-depth: calc(var(--probe-foot) + var(--slip-pad) - 1px);

    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    grid-column: 1 / -1;
    grid-row-start: lead;
    justify-self: start;
    align-self: start;
    width: 100cqi;
    margin-inline-start: calc(-1 * (var(--slip-inset) + 1px + var(--slip-pad)));
    margin-bottom: calc(-1 * var(--probe-depth));
    font-size: var(--probe-hint);
    visibility: hidden;
    pointer-events: none;

    &::before,
    &::after {
      flex: none;
      height: 0;
      padding-top: var(--probe-depth);
      white-space: nowrap;
    }

    &::before {
      content: attr(data-text) / '';
      padding-inline-start: calc(var(--slip-inset) + 1px + var(--slip-pad));
    }

    &::after {
      content: var(--slip-hint) / '';
      padding-inline: 3rem 3.5em;
      font-family: 'Special Elite', monospace, system-ui;
    }
  }

  .callout-view:has(.technical-drawing-frame[data-hint-show]) .callout-card :global(.title-probe[data-probe='label']) {
    grid-row-end: label;

    &::before {
      font-family: monospace, system-ui;
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
  }

  .callout-view:has(.technical-drawing-frame[data-hint-show]) .callout-card :global(.title-probe[data-probe='title']) {
    grid-row-end: text;

    /* A line of text counts from the top of its letters, not of its line box: less the half
       leading over them, which trimming the same line to its text edge takes off. */
    &::before {
      height: auto;
      padding-top: calc(var(--probe-depth) - round(down, 1.45 * 0.875rem, 1px / 64));
      font-family: 'Special Elite', monospace, system-ui;
      font-size: 0.875rem;
      line-height: 1.45;
      letter-spacing: 0.02em;
      text-box: trim-start text;
    }
  }

  /* The rule is the cell's bottom edge, a pixel above the row's end, and runs the slip's
     width. The hint keeps only the inset from it, not the 3rem it keeps from text. */
  .callout-view:has(.technical-drawing-frame[data-hint-show]) .callout-card :global(.title-probe[data-probe='rule']) {
    grid-row-end: notes;
    --probe-depth: calc(var(--probe-foot) + var(--slip-pad));

    &::before {
      padding-inline-start: calc(var(--slip-inset) + var(--slip-width) - 1px - var(--slip-pad));
    }

    &::after {
      padding-inline-start: var(--slip-pad);
    }
  }

  .callout[data-card] .callout-card-leader {
    display: none;
  }

  /* The frame's box, and the box of any demo wrapped round it, runs on through the room kept
     for the fan, over the slip's first entry, and would take its clicks and text selection.
     Only what the frame holds takes the pointer. */
  .callout[data-card] .callout-view > :global(:not(.callout-slip)),
  .callout[data-card] .callout-view :global(.technical-drawing-frame) {
    pointer-events: none;
  }

  .callout[data-card] .callout-view :global(.technical-drawing-frame > :not(.flip-hints)) {
    pointer-events: auto;
  }
}

@media (max-width: 52rem) {
  .callout[data-card] .callout-slip {
    --slip-tuck: 0.75rem;
    --slip-inset: 0.75rem;
    --slip-width: calc(100% - 1.5rem);
    --slip-pad: 0.75rem;
  }
}

/* Without script the stack is a scroll row (PaperStack), not a fan: no sheet drops below the
   front one, so the slip has nothing to tuck under but the front sheet's own edge. With the
   turn still counted, the slip's lead row hid its Title entry behind the sheet. */
@media (scripting: none) {
  .callout[data-card] .callout-slip {
    --slip-turn: 0deg;
  }
}
</style>
