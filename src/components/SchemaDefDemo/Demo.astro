---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';

import TransformLayer from './layers/TransformLayer.astro';
import TypeMapLayer from './layers/TypeMapLayer.astro';
import PluginsLayer from './layers/PluginsLayer.astro';
import PhpstanLayer from './layers/PhpstanLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

// What the sheet ships: the script that pairs the two panes. The schema and the port of the
// driver run at build time and never reach the browser.
const srcRoot = path.join(process.cwd(), 'src');
const clientEntry = path.join(srcRoot, 'components/SchemaDefDemo/client/schemaDef.ts');

const { outputFiles: [clientBundle] } = await esbuild.build({
  entryPoints: [clientEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  alias: { '@': srcRoot },
});

const sheetSize = toKiB(clientBundle.text);

const layers = {
  transform: { name: null },
  typemap: { name: 'Type Vocabulary', pageStyle: 'blueprint' },
  plugins: { name: 'Plugin Entities', pageStyle: 'blueprint' },
  phpstan: { name: 'Static Analysis', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="schemaDef → Doctrine Metadata"
  scale="1:1"
  size={sheetSize}
  date="2020"
  tech={['gnusocial', 'doctrine']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      transform: <TransformLayer />,
      typemap: <TypeMapLayer />,
      plugins: <PluginsLayer />,
      phpstan: <PhpstanLayer />,
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
