---
import { php, phpLines } from '../php';
// Entity directories in the v3 tree as of 2022-10-21 (49a80a3c), and how many classes in
// each answer schemaDef(). Counted with grep, not estimated: 17 in core, 29 across 12
// components and 28 across 16 plugins.
const sources = [
  { path: 'src/Entity/', namespace: 'App\\Entity', count: '17', where: 'core' },
  { path: 'components/*/Entity/', namespace: 'Component\\<Name>\\Entity', count: '29', where: '12 components' },
  { path: 'plugins/*/Entity/', namespace: 'Plugin\\<Name>\\Entity', count: '28', where: '16 plugins' },
];

// ModuleManager::process, the loop that touches Doctrine, from the same tree. Lines are left
// out, never rewritten: the one comment stands where the path parsing was, and the coverage
// markers go.
const excerpt = String.raw`foreach ($module_paths as $path) {
    // … $type, $module and $dir from the path
    if (!\is_null($container) && file_exists($entity_dir = $dir . '/Entity') && is_dir($entity_dir)) {
        $entity_paths[] = $entity_dir;
        $container->findDefinition('doctrine.orm.default_metadata_driver')->addMethodCall(
            'addDriver',
            [new Reference('app.schemadef_driver'), "{$type}\\{$module}\\Entity"],
        );
    }
}`;

const excerptHtml = phpLines(excerpt.split('\n').map((text) => text.trim()).join('\n'));
const excerptLines = excerpt.split('\n').map((text, at) => ({
  html: excerptHtml[at],
  indent: Math.round((text.match(/^ */)?.[0].length ?? 0) / 4),
  text: text.trim(),
}));
---

<div class="wrapper hl" data-schemadef-sheet>
  <div class="plugins">
    <div class="flow">
      <ul class="sources">
        {sources.map((source) => (
          <li>
            <code class="path">{source.path}</code>
            <code class="namespace">{source.namespace}</code>
            <span class="count"><strong>{source.count}</strong> · {source.where}</span>
          </li>
        ))}
      </ul>

      <p class="call">
        <span class="arrow" aria-hidden="true">↓</span>
        <code set:html={php('addDriver(app.schemadef_driver, $namespace)')} />
      </p>

      <div class="chain">
        <code class="service">doctrine.orm.<wbr />default_metadata_driver</code>
        <span>One driver chain, one <code>SchemaDefDriver</code>, 74 entities as of October 2022</span>
        <code class="transient" set:html={php("isTransient($class) = !method_exists($class, 'schemaDef')")} />
      </div>
    </div>

    <figure class="excerpt">
      <figcaption><code>src/Core/ModuleManager.php</code> · <code>process()</code></figcaption>
      <code class="code">
        {excerptLines.map((line) => (
          <span class:list={['line', { comment: line.text.startsWith('//') }]} style={{ '--indent': line.indent }} set:html={line.html} />
        ))}
      </code>
    </figure>

    <p class="footnote">
      <code>plugins/Favourite/Entity/NoteFavourite.php</code> is a whole plugin table: drop it in
      and <code>note_favourite</code> exists. Its <code set:html={php("'foreign key' => true")} /> is still
      read by nobody, since the driver's association branch sits behind <code>if (false &amp;&amp; …)</code>,
      so <code>note_id</code> maps as a plain <code>INT</code>.
    </p>
  </div>
</div>

<style lang="scss">
@use '@/scss/sheet-orientation' as *;
@use "./sheet" as *;

@include fill-content-cell;

.wrapper {
  @include sheet-content;
  @include highlighted;
  @include clear-title-block;

  @include blueprint-root;
}

.plugins {
  box-sizing: border-box;
  width: min(100%, 48em);
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  grid-template-areas:
    "flow excerpt"
    "note note";
  gap: 0.75em 1em;
  align-items: center;
  color: var(--ink);

  @include portrait-sheet {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "flow"
      "excerpt"
      "note";
  }
}

.flow {
  grid-area: flow;
  display: grid;
  justify-items: stretch;
  gap: 0.375em;
}

.sources {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.375em;

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "path path"
      "namespace count";

    @include portrait-sheet {
      grid-template-areas: "path count";
    }
    gap: 0 0.5em;
    padding: 0.3125em 0.5em;
    border: 1px solid var(--line-strong);
    border-radius: 0.375em;
    background: var(--surface-raised);
  }

  .path {
    grid-area: path;
    font-size: fs(0.6875);
    font-weight: 600;
  }

  .namespace {
    grid-area: namespace;

    /* A phone's sheet is short a few lines; the path already says whose entities they are. */
    @include portrait-sheet {
      display: none;
    }

    font-size: fs(0.625);
    color: var(--ink-muted);
    overflow-wrap: anywhere;
  }

  .count {
    grid-area: count;
    align-self: end;
    font-size: fs(0.625);
    white-space: nowrap;
    color: var(--ink-muted);

    strong {
      color: var(--ink);
    }
  }
}

.call {
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.5em;
  padding-inline: 0.5em;
  font-size: fs(0.625);

  code {
    @include code-panel;

    padding: 0.125em 0.375em;
  }

  .arrow {
    font-size: 1.6em;
    line-height: 1;
  }
}

.chain {
  @include code-panel;

  display: grid;
  gap: 0.125em;
  padding: 0.375em 0.5em;
  border: 1.5px solid var(--ink);
  border-radius: 0.375em;
  font-size: fs(0.625);

  .service {
    font-size: 1.1em;
    font-weight: 600;
  }

  .transient {
    color: var(--ink-muted);
    overflow-wrap: anywhere;
  }
}

.excerpt {
  @include code-panel;

  grid-area: excerpt;
  margin: 0;
  min-width: 0;

  figcaption {
    padding: 0.25em 0.625em;
    border-bottom: 1px solid var(--line);
    font-size: fs(0.5625);
    color: var(--ink-muted);
  }

  .code {
    display: block;
    padding-block: 0.375em;
    font-size: fs(0.5625);
    line-height: 1.4;
  }

  .line {
    display: block;
    padding-left: calc((var(--indent) * 2 + 2.75) * 1ch);
    padding-right: 0.5em;
    text-indent: -2ch;
    white-space: pre-wrap;
    overflow-wrap: anywhere;

    &.comment {
      color: var(--ink-muted);
      font-style: italic;
    }
  }
}

.footnote {
  @include code-panel;

  grid-area: note;
  margin: 0;
  padding: 0.375em 0.625em;

  /* What a small sheet can spare: the boxes above carry the point. */
  @include narrow-sheet {
    display: none;
  }

  font-size: fs(0.5625);
  line-height: 1.4;
  color: var(--ink-muted);
  text-wrap: pretty;
}

code {
  font-family: monospace, system-ui;
}
</style>
