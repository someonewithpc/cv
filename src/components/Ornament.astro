---
/**
 * The things lying on the desk round the paper: decoration, so assistive tech never sees
 * them, and never in the flow, so nothing on the page moves for them. Like the folio each
 * slot is a child of #main placed in a row's margin (ornaments.ts says which and where).
 * While Hugo picks, ?ornament=<theme> shows that theme's set for the visit and
 * ?ornament=<theme>-<name> one drawing on its own; either stamps the theme on the root.
 */
import { ORNAMENT_CSS, ORNAMENTS, SETS, single } from '@/ornaments';
import { THEME_IDS } from '@/themes';

const themeOf = Object.fromEntries(ORNAMENTS.map(({ id, theme }) => [id, theme]));
const switchScript = `(() => {
  const themes = ${JSON.stringify(themeOf)};
  const sets = ${JSON.stringify(THEME_IDS)};
  const pick = new URLSearchParams(location.search).get('ornament');
  if (!pick) return;
  const theme = sets.includes(pick) ? pick : themes[pick];
  if (!theme) return;
  const root = document.documentElement;
  const stamp = () => { root.dataset.ornament = sets.includes(pick) ? 'set' : pick; root.dataset.theme = theme; };
  stamp();
  document.addEventListener('DOMContentLoaded', stamp);
})();`;
---

<script is:inline set:html={switchScript} />
{Object.entries(SETS).flatMap(([theme, placements]) => placements.map((placement, i) => (
  <div class="ornament-slot" data-slot={placement.slot} data-set={`${theme}:${i}`} aria-hidden="true"><div class="ornament"></div></div>
)))}
{ORNAMENTS.map(({ id }) => (
  <div class="ornament-slot" data-slot={single(id).slot} data-single={id} aria-hidden="true"><div class="ornament"></div></div>
))}

<style is:global set:html={ORNAMENT_CSS} />
