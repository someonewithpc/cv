---
/**
 * The sheet number in the desk's left margin: a stencil numeral with that sheet's own title
 * under it, riding along while the sheet scrolls past. It is decoration, so assistive tech
 * never sees it; the sheet carries the same words as its heading.
 *
 * It is a child of #main rather than of the sheet, because the margin it stands in belongs to
 * the desk and not to the paper. Absolutely positioned in the left margin column of the grid
 * row its sheet sits in, it takes that row as its containing block, which is what gives the
 * numeral the sheet's own height to stick along. The row is the number: there is one folio
 * per sheet and they run in page order. Both ends of the row are named, since a grid line an
 * absolutely positioned child leaves at auto resolves to the grid's own padding edge.
 */
type Props = {
  number: number;
  label: string;
};

const { number, label } = Astro.props;
---

<div class="folio-rail" style={`--folio-row: ${number} / ${number + 1}`} aria-hidden="true">
  <p class="folio">
    <span class="folio-number stencil">{String(number).padStart(2, '0')}</span>
    <span class="folio-label typewriter">{label}</span>
  </p>
</div>

<style lang="scss">
/* 80rem is the width from which the desk margin beside the mat holds a 3rem numeral with
   1.5rem clear of the window on one side and of the mat on the other (Layout.astro). Narrower
   than that the margin is a gutter, so there is no folio at all.

   The lane hangs off the paper's near edge and not the window's: the cutting mat is only as
   wide as what lies on it and is centred from there, so once the lane is at its widest the
   desk margin keeps opening and a numeral pinned to the window would be left behind in the
   corner. Hung off the mat, it stays beside the paper it numbers at every width. */
.folio-rail {
  display: none;

  @media (width >= 80rem) {
    display: block;
    position: absolute;
    grid-row: var(--folio-row);
    grid-column: full-width-start / content-start;
    inset-block: 0;
    inset-inline-start: max(0px, calc(var(--desk-edge) - var(--folio-lane)));
    inline-size: var(--folio-lane);
  }
}

.folio {
  position: sticky;
  top: 1.5rem;
  display: grid;
  justify-items: end;
  gap: 0.5rem;
  padding-inline: var(--folio-gap);
  text-align: right;
  line-height: 1;
}

.folio-number {
  font-size: var(--type-folio);
  letter-spacing: -0.02em;
  color: color-mix(in oklch, var(--ink), transparent 45%);
}

/* The label is small type on the desk, where --ink-faint measures 4.07 on arctic's wood, so it
   takes the muted ink, and it is written only where the lane holds it on a line or two. */
.folio-label {
  display: none;
  font-size: 0.8125rem;
  letter-spacing: 0.06em;
  color: var(--ink-muted);

  @media (width >= 90rem) {
    display: block;
  }
}
</style>
