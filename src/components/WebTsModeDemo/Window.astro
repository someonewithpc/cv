---
/**
 * One Emacs window onto a painted buffer: line numbers, the painted tokens, and a mode
 * line. Embedded ranges come out as elements of their own, so a sheet can outline them
 * and light one up: a range that runs over several whole lines wraps those lines in a
 * block, one that sits inside a line wraps its tokens in a span.
 */
import { depthHue, type Line, type Range, type Token } from './lexer';

/**
 * A dashed box over lines `from` to `to`, at nesting level `lane` counted from the outside
 * in. Each level is inset from the one around it, so every outline stays in view. A range
 * that sits inside one line gives `column` and `width`, in characters, and its box covers
 * only those.
 */
export type Band = { lang: string; lane: number; from: number; to: number; column?: number; width?: number };

type Props = {
  lines: Line[];
  ranges?: Range[];
  modeLine: string;
  /** How many digits the line-number gutter keeps room for. */
  gutter?: number;
  bands?: Band[];
  class?: string;
};

const { lines, ranges = [], modeLine, gutter = 2, bands = [], class: className } = Astro.props;
const lanes = bands.length ? Math.max(...bands.map((band) => band.lane)) + 1 : 0;
const lineSpan = ({ from, to }: Band) => (from === to ? `${from}` : `${from}-${to}`);
const bandStyle = (band: Band) =>
  [`--lane: ${band.lane}`, `--from: ${band.from}`, `--to: ${band.to}`]
    .concat(band.column === undefined ? [] : [`--column: ${band.column}`, `--width: ${band.width}`])
    .join('; ');
const byId = new Map(ranges.map((range) => [range.id, range]));

// A range is a block when its tokens reach more than one line.
const linesOfRange = new Map<string, Set<number>>();
for (const line of lines) {
  for (const token of line.tokens) {
    if (token.range === 'host') continue;
    const seen = linesOfRange.get(token.range) ?? new Set<number>();
    seen.add(line.number);
    linesOfRange.set(token.range, seen);
  }
}
const isBlock = (id: string) => (linesOfRange.get(id)?.size ?? 0) > 1;

// The block each line sits in, if all of it does. An empty line inside a block has no
// tokens to say so, so it takes the block its neighbours agree on.
const lineBlock = lines.map((line) => {
  const owners = new Set(line.tokens.filter((token) => token.text.trim()).map((token) => token.range));
  const [only] = owners;
  return owners.size === 1 && only !== 'host' && isBlock(only) ? only : null;
});
lineBlock.forEach((id, index) => {
  if (id !== null || lines[index].tokens.some((token) => token.text.trim())) return;
  const before = lineBlock[index - 1];
  const after = lineBlock.slice(index + 1).find((other) => other !== null);
  if (before && before === after) lineBlock[index] = before;
});

type Row = { block: string | null; lines: Line[] };
const rows: Row[] = [];
lines.forEach((line, index) => {
  const block = lineBlock[index];
  const last = rows.at(-1);
  if (last && last.block === block && block !== null) last.lines.push(line);
  else rows.push({ block, lines: [line] });
});

// Within a line, tokens of one inline range go in one wrapper.
type Segment = { range: string | null; tokens: Token[] };
function segments(line: Line): Segment[] {
  const out: Segment[] = [];
  for (const token of line.tokens) {
    const range = token.range !== 'host' && !isBlock(token.range) ? token.range : null;
    const last = out.at(-1);
    if (last && last.range === range) last.tokens.push(token);
    else out.push({ range, tokens: [token] });
  }
  return out;
}

const faceClass = (token: Token) => {
  if (token.face === 'default') return undefined;
  return token.depth ? `f-${token.face} deep` : `f-${token.face}`;
};
const faceStyle = (token: Token) => (token.depth ? `--depth: ${token.depth}; --hue: ${depthHue(token.depth)}` : undefined);

const label = (id: string) => {
  const range = byId.get(id);
  return range ? `${range.lang}: ${range.node}` : id;
};
---

<div class:list={['emacs-window', className]} style={`--gutter: ${gutter}; --lanes: ${lanes}`}>
  <div class="text">
    {bands.length > 0 && (
      <ol class="bands" aria-label="Parser ranges, outermost first">
        {bands.map((band) => (
          <li
            class:list={['band', { inline: band.column !== undefined }]}
            data-lang={band.lang}
            data-lane={band.lane}
            data-from={band.from}
            data-to={band.to}
            style={bandStyle(band)}
          >
            <span class="band-label" aria-hidden="true">{band.lang} {lineSpan(band)}</span>
            <span class="sr-only">{band.lang}, {band.from === band.to ? `line ${band.from}` : `lines ${band.from} to ${band.to}`}</span>
          </li>
        ))}
      </ol>
    )}
    {rows.map((row) => row.block ? (
      <div class="block" data-range={row.block} data-lang={byId.get(row.block)?.lang} tabindex="0" role="group" aria-label={label(row.block)}>
        {row.lines.map((line) => (
          <div class="line"><span class="ln" aria-hidden="true">{line.number}</span><code>{line.tokens.map((token) => (
            <span class={faceClass(token)} style={faceStyle(token)}>{token.text}</span>
          ))}</code></div>
        ))}
      </div>
    ) : row.lines.map((line) => (
      <div class="line"><span class="ln" aria-hidden="true">{line.number}</span><code>{segments(line).map((segment) => segment.range ? (
        <span class="range" data-range={segment.range} data-lang={byId.get(segment.range)?.lang} tabindex="0" role="group" aria-label={label(segment.range)}>{segment.tokens.map((token) => (
          <span class={faceClass(token)} style={faceStyle(token)}>{token.text}</span>
        ))}</span>
      ) : segment.tokens.map((token) => (
        <span class={faceClass(token)} style={faceStyle(token)}>{token.text}</span>
      )))}</code></div>
    )))}
  </div>
  <div class="mode-line" aria-hidden="true">{modeLine}</div>
</div>

<style lang="scss">
@use "./layers/sheet" as *;

.emacs-window {
  @include buffer-faces;

  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  min-width: 0;
  min-height: 0;
  background: var(--buffer-paper);
  color: var(--buffer-ink);
  font-family: monospace, system-ui;
  line-height: 1.25;
}

.text {
  --line: 1.25em;
  --pad: 0.25em;
  // How far each level of nesting sits in from the one around it. Across, each level steps
  // in; down, the innermost boxes sit on the line edges and each outer level steps out into
  // the gap between lines, so no dashed edge crosses the letters.
  --inset-inline: 0.625ch;
  --inset-block: 0.125em;
  // Clear space between the code and the scrollbar.
  --gap-end: 1ch;

  position: relative;
  min-height: 0;
  padding-block: var(--pad);
  padding-inline: calc(var(--lanes) * var(--inset-inline)) calc(var(--lanes) * var(--inset-inline) + var(--gap-end));
  overflow: hidden;
}

// The ranges, one dashed box each, with the language and its lines in the top right corner.
.bands {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 0;
  list-style: none;
  pointer-events: none;
}

.band {
  --out: calc((var(--lanes) - 1 - var(--lane)) * var(--inset-block));

  position: absolute;
  top: calc(var(--pad) + (var(--from) - 1) * var(--line) - var(--out));
  left: calc(var(--lane) * var(--inset-inline));
  right: calc(var(--lane) * var(--inset-inline) + var(--gap-end) / 2);
  height: calc((var(--to) - var(--from) + 1) * var(--line) + 2 * var(--out));
  box-sizing: border-box;
  border: 1px dashed var(--lang);
}

// A range inside one line: a box around its characters, with the label on the line above,
// clear of the code on either side.
.band.inline {
  left: calc(var(--lanes) * var(--inset-inline) + var(--gutter) * 1ch + 1.5ch + var(--column) * 1ch - 0.25ch);
  right: auto;
  width: calc(var(--width) * 1ch + 0.5ch);

  .band-label {
    top: auto;
    right: auto;
    bottom: 100%;
    left: 0;
  }
}

.band-label {
  position: absolute;
  top: 0.125em;
  right: 0.5ch;
  padding: 0 0.5ch;
  font-size: max(0.5rem, 0.75em);
  line-height: 1.2;
  white-space: nowrap;
  color: var(--lang);
  background: var(--buffer-paper);
}

.line {
  display: grid;
  grid-template-columns: calc(var(--gutter) * 1ch + 1.5ch) minmax(0, 1fr);
  white-space: pre;
}

code {
  font: inherit;
  overflow: hidden;
  text-overflow: clip;
}

.ln {
  padding-right: 1ch;
  text-align: right;
  color: var(--buffer-dim);
  user-select: none;
}

.block {
  position: relative;
}

.mode-line {
  padding: 0.125em 0.5ch;
  overflow: hidden;
  background: var(--buffer-mode-line);
  color: var(--buffer-ink);
  white-space: pre;
  text-overflow: ellipsis;
}

@include face-classes;
</style>
