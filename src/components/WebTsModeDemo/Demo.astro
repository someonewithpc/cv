---
import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';

import BufferLayer from './layers/BufferLayer.astro';
import RangesLayer from './layers/RangesLayer.astro';
import DepthLayer from './layers/DepthLayer.astro';
import DoctorLayer from './layers/DoctorLayer.astro';

// The package's Lisp, core and seven host files, at the commit the sheets were drawn from
// (web-ts-mode 0c179b1): 141,504 bytes over 3,507 lines. The sheet ships no code of its own
// to measure; the buffer is painted at build time.
const packageSize = '138.2KiB';

const layers = {
  buffer: { name: null },
  ranges: { name: 'Parser Ranges', pageStyle: 'blueprint' },
  depth: { name: 'Selector Depth Hue', pageStyle: 'blueprint' },
  doctor: { name: 'Doctor Report', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<div class="web-ts-mode-demo">
<TechnicalDrawingStack
  subtitle="web-ts-mode"
  scale="1:1"
  size={packageSize}
  date="2026"
  tech="emacs"
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      buffer: <BufferLayer />,
      ranges: <RangesLayer />,
      depth: <DepthLayer />,
      doctor: <DoctorLayer />,
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
</div>

<style lang="scss">
// Where the stack differs from the default sheet: no page carries a note, so the artwork has
// the sheet's whole width, and its cell takes the whole height too, so a window can show as
// much of a buffer as fits and cut the rest.

// The title block is absolutely placed in the sheet's bottom-right corner, over the artwork.
// How far it reaches, across and up, for each layer to keep its own content clear of: the
// live buffer gives up the width, the drawings the height. Portrait gives the block a row of
// its own, so there both stay 0.
:global(.web-ts-mode-demo article.technical-drawing-stack > * > section) {
  --reach-inline: 0px;
  --reach-block: 0px;
}

@container technical-drawing (orientation: landscape) {
  // For a height inside the cell to mean anything the sheet's row has to be a measured
  // one: its own row is auto, and a percentage inside an auto row resolves to nothing.
  :global(.web-ts-mode-demo article.technical-drawing-stack > * > section) {
    --reach-inline: calc(var(--title-block-inline) + 0.5em);
    --reach-block: var(--title-block-block);

    grid-template-rows: minmax(0, 1fr);
  }
}

:global(.web-ts-mode-demo article.technical-drawing-stack > * > section .content) {
  place-self: stretch;
  height: 100%;
  max-height: 100%;
  min-height: 0;
  box-sizing: border-box;
}
</style>
