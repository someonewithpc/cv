---
/**
 * The live sheet: one of this CV's own components as web-ts-mode would paint it, done at
 * build time. Nothing parses in the browser. The toggle outlines the ranges each embedded
 * parser is handed, and pointing at a token lights up the range that owns it, with the
 * echo area naming the parser and the rule. All of it is CSS: no script, no island.
 */
import Window, { type Band } from '../Window.astro';
import { lexAstro } from '../lexer';
import { bufferFile, readBuffer } from '../samples';

const source = await readBuffer();
const { lines, ranges } = lexAstro(source);

// The dashed boxes over the buffer, one level per step of nesting. The astro parser reads the
// whole file. The template is markup the astro grammar parses itself, so it has no parser of
// its own, but it is the part of the file the inner ranges sit in. Each span runs from the
// first line with code in it to the last. A range inside one line, like an expression in
// the markup, is boxed around its own characters only.
const lineAt = (offset: number) => source.slice(0, offset).split('\n').length;
function span(start: number, end: number) {
  const text = source.slice(start, end);
  const first = start + text.search(/\S/);
  const last = start + text.trimEnd().length - 1;
  const from = lineAt(first);
  const to = lineAt(last);
  const lineStart = source.lastIndexOf('\n', start - 1) + 1;
  const lineEnd = source.indexOf('\n', start);
  const wholeLine = !source.slice(lineStart, start).trim() && !source.slice(end, lineEnd).trim();
  if (from !== to || wholeLine) return { from, to };
  return { from, to, column: start - lineStart, width: end - start };
}
const templateStart = source.startsWith('---') ? source.indexOf('\n---', 3) + 4 : 0;
const bands: Band[] = [
  { lang: 'astro', lane: 0, ...span(0, source.length) },
  ...ranges
    .filter((range) => range.end <= templateStart)
    .map((range): Band => ({ lang: range.lang, lane: 1, ...span(range.start, range.end) })),
  { lang: 'html', lane: 1, ...span(templateStart, source.length) },
  ...ranges
    .filter((range) => range.start >= templateStart)
    .map((range): Band => ({ lang: range.lang, lane: 2, ...span(range.start, range.end) })),
];
const gutter = String(lines.length).length;

const echo = [
  { id: 'idle', text: 'Point at or tab to the code to see which parser owns it' },
  { id: 'host', text: 'astro: the host parser, over the whole buffer' },
  ...ranges.map((range) => ({ id: range.id, text: `${range.lang}: ${range.rule}, :local t` })),
];

// Pointing at a range lights it and names its parser. One rule per range the lexer found, so
// a longer buffer needs no edit here. Stylesheet rules cannot count the ranges, so they are
// written out here and emitted beside the buffer.
const rangeRules = ranges
  .map(({ id }) => {
    const hovered = `.buffer-layer[data-web-ts-buffer]:has([data-range='${id}']:is(:hover, :focus-visible))`;
    return [
      `${hovered} [data-range='${id}'] { background: color-mix(in oklch, var(--lang) 22%, var(--buffer-paper)); }`,
      `${hovered} .echo [data-echo='idle'] { display: none; }`,
      `${hovered} .echo [data-echo='${id}'] { display: inline; }`,
    ].join('\n');
  })
  .join('\n');
---

<style is:inline set:html={rangeRules} />

<div class="wrapper">
  <div class="buffer-layer" data-web-ts-buffer>
    <section class="notes" aria-label="Notes">
      <span class="notes-heading">Notes</span>
      <ol>
        <li>
          web-ts-mode is an Emacs major mode for files that mix languages. This Astro component
          from the CV has TypeScript in its frontmatter, markup with expressions in it, and a
          SCSS style block.
        </li>
        <li>
          The astro parser reads the whole file, markup included. The TypeScript and the SCSS
          each get a parser of their own that sees only its range. Each dashed box is one range,
          drawn inside the range that holds it.
        </li>
        <li>
          The site's build colours the code with a small lexer that follows the mode's faces.
          The ranges are the ones Emacs 31.1 hands each parser for this file.
        </li>
      </ol>
    </section>
    <label class="toggle">
      <input type="checkbox" class="show-ranges" checked />
      <span>Outline the ranges in the buffer</span>
    </label>

    <div class="frame">
      <Window
        lines={lines}
        ranges={ranges}
        gutter={gutter}
        bands={bands}
        modeLine={`-:%%-  ${bufferFile}    (Web-TS)`}
      />
      <p class="echo">
        {echo.map(({ id, text }) => <span data-echo={id}>{text}</span>)}
      </p>
    </div>
  </div>
</div>

<style lang="scss">
@use '@/scss/hit-area' as *;
@use "./sheet" as *;

.wrapper {
  @include sheet-content;

  display: grid;
  height: 100%;
  min-height: 0;
  /* The title block claims the bottom-right corner. Where the sheet is wide the words
     stand over it in a column of their own, the block's width, and the window has the rest;
     narrower, the words go above the window and the window stops clear of the block. */
  padding-bottom: calc($sheet-margin + var(--reach-block, 0px));

  @container technical-drawing-width (min-width: 56em) {
    :global([data-sheet-orientation='landscape']) & {
      padding-bottom: $sheet-margin;
    }
  }
}

.buffer-layer {
  @include buffer-faces;

  box-sizing: border-box;
  width: 100%;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: auto auto minmax(0, 1fr);
  gap: 0.375em;
  font-size: clamp(0.5rem, 0.0135 * var(--sheet-inline), 0.75rem);
  color: var(--ink);

  :global([data-sheet-orientation='portrait']) & {
    font-size: clamp(0.5rem, 0.024 * var(--sheet-inline), 0.75rem);
  }

  @container technical-drawing-width (min-width: 56em) {
    :global([data-sheet-orientation='landscape']) & {
      grid-template-columns: minmax(0, 1fr) var(--title-block-inline, 0px);
      grid-template-rows: auto minmax(0, 1fr);
      column-gap: 1.5em;

      .notes {
        grid-column: 2;
        grid-row: 1 / -1;
        align-self: start;
        max-height: calc(100% - var(--reach-block, 0px) - 0.75em);
        overflow: hidden;
      }

      .toggle,
      .frame {
        grid-column: 1;
      }
    }
  }
}

.notes {
  @include drawing-notes;

  font-size: 1.125em;
}

// The switch reads like one of the title block's labels.
.toggle {
  display: inline-flex;
  justify-self: start;
  align-items: center;
  gap: 0.75ch;
  font-family: monospace, system-ui;
  font-size: max(0.5rem, 0.875em);
  letter-spacing: 0.04em;
  color: var(--ink-muted);
  cursor: pointer;
  /* Over the frame's top edge, which the hit box reaches into. */
  z-index: 1;
  @include hit-area;

  input {
    margin: 0;
    accent-color: var(--control-accent);
  }
}

.frame {
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  min-height: 0;
  border: 1px solid var(--line-strong);
  border-radius: 0.25em;
  overflow: hidden;

  :global(.emacs-window .text) {
    overflow: auto;
    scrollbar-width: thin;
  }
}

.echo {
  margin: 0;
  padding: 0.125em 0.5ch;
  min-height: 1.3em;
  background: var(--buffer-paper);
  border-top: 1px solid var(--buffer-line);
  font-family: monospace, system-ui;
  color: var(--buffer-ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;

  span {
    display: none;
  }

  [data-echo='idle'] {
    display: inline;
    color: var(--buffer-dim);
  }
}

// Which parser a range, a block or an outline stands for.
.buffer-layer :global([data-lang='astro']) { --lang: var(--lang-astro); }
.buffer-layer :global([data-lang='html']) { --lang: var(--lang-html); }
.buffer-layer :global([data-lang='tsx']),
.buffer-layer :global([data-lang='typescript']) { --lang: var(--lang-tsx); }
.buffer-layer :global([data-lang='scss']),
.buffer-layer :global([data-lang='css']) { --lang: var(--lang-scss); }

// The outlines show while the toggle is on.
.buffer-layer:not(:has(.show-ranges:checked)) :global(.emacs-window .bands) {
  display: none;
}

// Pointing at a token lights its owner: the range around it, or the Astro parser when it
// sits outside every embedded range. The echo area says which.
.buffer-layer :global(.emacs-window .range),
.buffer-layer :global(.emacs-window .block) {
  outline-color: transparent;
  transition: background-color 120ms ease;

  &:focus-visible {
    outline: 2px solid var(--lang);
  }
}

// Inside :has() nothing is scoped, so the window's own classes need no :global there.
.buffer-layer:has(.emacs-window .text:hover):not(:has(.emacs-window .range:hover, .emacs-window .block:hover)) {
  :global(.emacs-window .text) {
    background: color-mix(in oklch, var(--lang-astro) 14%, var(--buffer-paper));
  }

  :global(.emacs-window .range),
  :global(.emacs-window .block) {
    background: var(--buffer-paper);
  }

  .echo [data-echo='idle'] { display: none; }
  .echo [data-echo='host'] { display: inline; }
}

@media (prefers-reduced-motion: reduce) {
  .buffer-layer :global(.emacs-window .range:not([data-full-motion] *)),
  .buffer-layer :global(.emacs-window .block:not([data-full-motion] *)) {
    transition: none;
  }
}
</style>
