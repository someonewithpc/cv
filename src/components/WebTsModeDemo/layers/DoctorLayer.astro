---
/**
 * A `bin/web-ts doctor` report, the one the checkout printed on Hugo's machine, laid out
 * line for line as web-ts-doctor.el inserts it. The lines about a server that is not on
 * PATH are picked out; everything else is the plain text of a special-mode buffer.
 */
type Row = { text: string; status?: 'ok' | 'found' | 'absent' };

const grammars = ['astro', 'css', 'tsx', 'typescript', 'javascript', 'html', 'scss', 'xml', 'jsdoc', 'vue'];

const report: Row[] = [
  { text: 'web-ts-mode doctor' },
  { text: '=================' },
  { text: '' },
  { text: 'Emacs: 31.1' },
  { text: 'System type: gnu/linux' },
  { text: '' },
  { text: 'Grammars' },
  { text: '--------' },
  ...grammars.map((lang): Row => ({ text: `  ${lang}: ok`, status: 'ok' })),
  { text: '' },
  { text: 'LSP' },
  { text: '---' },
  { text: '  client: eglot' },
  { text: '  auto-enable: t' },
  { text: '' },
  { text: 'Language servers on PATH' },
  { text: '------------------------' },
  { text: '  astro-ls: found (node_modules/.bin/astro-ls --stdio)', status: 'found' },
  { text: '  vue: not found (tried vue-language-server, vls)', status: 'absent' },
  { text: '  html: not found (tried vscode-html-language-server, html-language-server, vscode-html-languageserver, html-languageserver)', status: 'absent' },
  { text: '  xml: not found (tried lemminx, xml-language-server)', status: 'absent' },
  { text: '  typescript: not found (tried typescript-language-server)', status: 'absent' },
  { text: '  css: not found (tried vscode-css-language-server, css-languageserver, vscode-css-languageserver)', status: 'absent' },
  { text: '' },
  { text: 'CLI' },
  { text: '---' },
  { text: '  bin/web-ts grammars  — install pinned tree-sitter grammars' },
  { text: '  bin/web-ts doctor    — this report (batch)' },
  { text: '  bin/web-ts test      — ERT suite' },
  { text: '  bin/web-ts compile   — byte-compile package .el files' },
  { text: '  bin/web-ts bench     — soft perf timings' },
];

// The word that carries the status, so the sheet can pick out what is not there.
const statusWord = { ok: 'ok', found: 'found', absent: 'not found' } as const;
function split(row: Row) {
  if (!row.status) return [row.text];
  const word = statusWord[row.status];
  const at = row.text.indexOf(`: ${word}`) + 2;
  return [row.text.slice(0, at), word, row.text.slice(at + word.length)];
}
---

<div class="wrapper">
  <p class="point typewriter">One command says what is installed and what is not</p>
  <section class="notes" aria-label="Notes">
    <span class="notes-heading">Notes</span>
    <ol>
      <li>
        Each language needs a tree-sitter grammar, and completion and error checks need a
        language server on PATH. <code>M-x web-ts-doctor</code> lists both.
      </li>
      <li>
        A missing grammar shows up as a line here. When a file opens, the mode leaves that
        language unhighlighted and carries on.
      </li>
      <li>
        This is the report from the machine that builds this CV. Every grammar is installed,
        and one server, astro-ls.
      </li>
    </ol>
  </section>

  <div class="report" role="group" aria-label="web-ts-doctor report">
    {/* One buffer in two windows, the second carrying on where the first stops, the way
        follow-mode shows a buffer too long for one. The columns do the following: rows
        flow into the second window once the first is full, and whatever still does not
        fit is below the bottom of the second, as it would be in Emacs. */}
    <pre class="flow">{report.map((row) => {
      const [before, word, after] = split(row);
      return (
        <span class:list={['row', { heading: /^[=-]+$/.test(row.text) }]}>{before || ' '}{word && <span class={`status ${row.status}`}>{word}</span>}{after}</span>
      );
    })}</pre>
    <div class="mode-lines" aria-hidden="true">
      <span>U:%%-  *web-ts-doctor*   Top   (Special Follow)</span>
      <span>U:%%-  *web-ts-doctor*         (Special Follow)</span>
    </div>
  </div>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;

  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  justify-items: center;
  row-gap: 0.625em;
  height: 100%;
  min-height: 0;
  /* The title block claims the bottom-right corner, so the report stops clear of it. */
  padding-bottom: calc($sheet-margin + var(--reach-block, 0px));
  font-size: clamp(0.5rem, 0.0118 * var(--sheet-inline), 0.875rem);
  color: var(--ink);

  :global([data-sheet-orientation='portrait']) & {
    font-size: clamp(0.5rem, 0.021 * var(--sheet-inline), 0.875rem);
  }
}

.point {
  margin: 0;
  font-size: 1.375em;
  line-height: 1.2;
  text-align: center;
  text-wrap: balance;
}

.notes {
  @include drawing-notes;

  width: 100%;
  box-sizing: border-box;
  font-size: max(0.5rem, 1em);

  ol {
    grid-template-columns: repeat(3, minmax(0, 1fr));

    @container technical-drawing (orientation: portrait) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
}

.report {
  @include buffer-faces;

  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  border: 1px solid var(--line-strong);
  border-radius: 0.25em;
  overflow: hidden;
  background: var(--buffer-paper);
  color: var(--buffer-ink);
  font-family: monospace, system-ui;
}

.flow {
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0.375em 0;
  overflow: hidden;
  columns: 2;
  column-gap: 0;
  column-fill: auto;
  column-rule: 1px solid var(--buffer-line);
  font: inherit;
  line-height: 1.2;

  @container technical-drawing (orientation: portrait) {
    columns: 1;
  }
}

.row {
  display: block;
  padding-inline: 1ch;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  break-inside: avoid;

  &.heading {
    color: var(--buffer-dim);
  }
}

// The real buffer is plain text in special-mode. Only what is not there is picked out.
.status.absent {
  font-weight: 700;
  text-decoration: underline wavy var(--accent-800);
  text-underline-offset: 0.2em;
}

.mode-lines {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  background: var(--buffer-mode-line);

  span {
    padding: 0.125em 1ch;
    overflow: hidden;
    white-space: pre;
    text-overflow: ellipsis;
  }

  span + span {
    border-left: 1px solid var(--buffer-line);
  }

  @container technical-drawing (orientation: portrait) {
    grid-template-columns: minmax(0, 1fr);

    span + span {
      display: none;
    }
  }
}
</style>
