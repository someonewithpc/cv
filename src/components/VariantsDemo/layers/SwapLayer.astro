---
const steps = [
  { call: 'selection/clear', text: 'Drop the selection so nothing points at objects about to go' },
  { call: 'layout.remove', text: 'Take each selected object out of the layout' },
  { call: 'createObject', text: 'Clone the new model, copy the old position and rotation onto it' },
  { call: 'userData', text: 'Carry the old object\'s own data over, then the clone\'s on top' },
  { call: 'adjustElevation', text: 'Only when the new object is a different size' },
  { call: 'selection/addSeveral', text: 'Select what was just built, so the next pick lands on it' },
];
---

<div class="wrapper">
  <div class="sheet" aria-hidden="true">
    <div class="panel">
      <header>
        <span class="eyebrow">three/Actions/Replace.js</span>
        <strong>A pick never moves the object</strong>
      </header>

      <div class="body">
        <div class="frames">
          <div class="frame">
            <span class="tag">Before</span>
            <span class="floor">
              <span class="obj old"></span>
            </span>
            <code>x 4.20 · z −1.85 · ry 0.35</code>
          </div>
          <span class="through">
            <span class="line"></span>
            <span class="word">replace</span>
          </span>
          <div class="frame">
            <span class="tag">After</span>
            <span class="floor">
              <span class="obj new"></span>
            </span>
            <code>x 4.20 · z −1.85 · ry 0.35</code>
          </div>
        </div>

        <ol class="steps">
          {steps.map((step) => (
            <li>
              <code>{step.call}</code>
              <span>{step.text}</span>
            </li>
          ))}
        </ol>
      </div>

      <dl class="rules">
        <div>
          <dt>Batch</dt>
          <dd>Every selected object of the same category swaps in one pass</dd>
        </div>
        <div>
          <dt>Undo</dt>
          <dd>One entry for the whole batch, pushed after the last object is built</dd>
        </div>
        <div>
          <dt>Elevation</dt>
          <dd>Reworked only for what stood on the replaced objects, and only on a size change</dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<style lang="scss">
@use './sheet' as *;

@include sheet-chrome(46em);

.body {
  display: grid;
  gap: 0.75em;
}

.frames {
  display: grid;
  grid-template-columns: minmax(0, 1fr) max-content minmax(0, 1fr);
  gap: 0.5em;
  align-items: center;
}

.frame {
  display: grid;
  justify-items: center;
  gap: 0.25em;
  padding: 0.375em;
  border: 1px solid var(--line);
  border-radius: 0.375em;
  background: var(--surface-sunken);

  code {
    font-size: 0.625em;
    color: var(--ink-muted);
  }
}

.tag {
  font-size: 0.625em;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-muted);
}

.floor {
  position: relative;
  width: 100%;
  height: 3.25em;
  border-bottom: 1px solid var(--line-strong);
  background:
    repeating-linear-gradient(
      66deg,
      transparent 0 0.5em,
      color-mix(in oklab, var(--line) 60%, transparent) 0.5em calc(0.5em + 1px)
    );
}

.obj {
  position: absolute;
  left: 58%;
  bottom: 0.375em;
  width: 2.25em;
  height: 1.5em;
  rotate: -12deg;
  border: 1.5px solid var(--ink-muted);
  border-radius: 100%;

  &.new {
    border-color: var(--accent);
    background: color-mix(in oklab, var(--accent) 22%, transparent);
  }
}

.through {
  display: grid;
  justify-items: center;
  gap: 0.25em;

  .line {
    width: 3em;
    height: 1px;
    background: var(--line-strong);
  }

  .word {
    font-family: monospace, system-ui;
    font-size: 0.625em;
    color: var(--ink-muted);
  }
}

.steps {
  margin: 0;
  padding: 0;
  list-style: none;
  counter-reset: step;
  display: grid;
  gap: 0.25em;

  li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.25em max-content minmax(0, 1fr);
    gap: 0.5em;
    align-items: baseline;
    font-size: 0.6875em;

    &::before {
      content: counter(step);
      font-size: 0.8em;
      color: var(--ink-muted);
    }

    code {
      font-size: 0.85em;
      color: var(--accent);
    }
  }
}
</style>
