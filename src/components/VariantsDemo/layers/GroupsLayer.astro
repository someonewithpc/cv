---
/**
 * The card itself, drawn still, with callouts on the parts that pick: the carousel for the
 * styles of one cell, the seat and size rows for the cell. Same markup and styles as the
 * front page's cards. The callouts are authored twice, once per sheet orientation, because
 * the cards sit side by side on a landscape sheet and stack on a portrait one.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import Card from '../Card.astro';
import { BANQUET_CARD, CHAIR_CARD } from '../variantsCatalog';

const banquet = BANQUET_CARD.variants ?? [];
const finishes = CHAIR_CARD.variants ?? [];
const seats = new Set(banquet.map((variant) => variant.pax)).size;
const sizes = new Set(banquet.map((variant) => variant.size)).size;
const countLabel = `${banquet.length} objects, one card`;
const countLabelShort = `${banquet.length} objects`;
---

<div class="wrapper">
  <div class="sheet">
    <div class="panel">
      <header>
        <span class="eyebrow">CatalogObjectField.vue · CatalogObjectThumbnailOverlay.vue · HoverSelect.vue</span>
        <strong>One card stands for every library object in its group</strong>
      </header>

      <div class="figure">
      <Annotations reach={1.5} fontSize={0.11}>
        <div class="variants-catalog drawn" slot="content" aria-hidden="true" inert>
          <Card item={CHAIR_CARD} active={true} />
          <Card item={BANQUET_CARD} />
        </div>

        <Fragment slot="annotations">
          <ArrowAnnotation tipX={-0.33} tipY={-0.5} angle={60} length={0.8} text="Arrows step the finishes" only="landscape" />
          <ArrowAnnotation tipX={-1.13} tipY={0.22} angle={-75} length={1} text="One pip per style" only="landscape" />
          <ArrowAnnotation tipX={1.78} tipY={-0.86} angle={75} length={0.45} text={countLabel} only="landscape" />
          <ArrowAnnotation tipX={1.95} tipY={0.64} angle={-10} length={0.45} text="Seats pick a cell" only="landscape" />
          <ArrowAnnotation tipX={1.95} tipY={0.84} angle={-30} length={0.6} text="Size, other axis" only="landscape" />

          <ArrowAnnotation tipX={0.82} tipY={-1.6} angle={40} length={0.45} text="Next finish" only="portrait" />
          <ArrowAnnotation tipX={0.3} tipY={-0.86} angle={10} length={0.7} text="Pip per style" only="portrait" />
          <ArrowAnnotation tipX={0.72} tipY={0.22} angle={25} length={0.4} text={countLabelShort} only="portrait" />
          <ArrowAnnotation tipX={1.02} tipY={1.72} angle={-20} length={0.3} text="Seats: a cell" only="portrait" />
          <ArrowAnnotation tipX={1.02} tipY={1.92} angle={-45} length={0.4} text="Other axis" only="portrait" />
        </Fragment>
      </Annotations>
      </div>

      <dl class="rules">
        <div>
          <dt>Group</dt>
          <dd>Every library object under one catalog entry: {finishes.length} chairs, {banquet.length} banquet sets</dd>
        </div>
        <div>
          <dt>Cells</dt>
          <dd><code>pax</code> and <code>size</code> cut the group, {seats} seat counts by {sizes} sizes here; a cell's objects are its styles</dd>
        </div>
        <div>
          <dt>Preview</dt>
          <dd>Hovering an option shows that object on the card; a click is the pick</dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<style lang="scss">
@use './sheet' as *;

@include sheet-chrome(46em);

.panel {
  justify-items: center;
}

// Room for the callouts above and below, between the header and the rules. The padding
// sits outside the annotated box so the cards alone set the callouts' unit.
.figure {
  padding: 1.75rem 0 1.5rem;
}

// The cards keep the product's own rem sizes so the callouts, in units of the artwork,
// land on the same parts at every sheet size.
.drawn {
  display: flex;
  align-items: flex-start;
  gap: 1.5rem;

  :global(.option-item) {
    width: 10rem;
    flex: 0 0 auto;
    color-scheme: only dark;
  }

  :global(.option-item .object-icons) {
    aspect-ratio: auto;
    height: 6.5rem;
  }

  @container technical-drawing (orientation: portrait) {
    flex-direction: column;
    gap: 1.5rem;
  }
}
</style>
