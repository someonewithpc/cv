---
const lanes = [
  {
    id: 'past',
    title: 'Past',
    items: [
      { text: 'markers′ · spaces′' },
      { text: 'markers″ · spaces″' },
    ],
  },
  {
    id: 'present',
    title: 'Present',
    items: [
      { code: 'markers[]', note: 'editor SVGs' },
      { code: 'spaces[]', note: 'pin → markerId' },
    ],
  },
  {
    id: 'future',
    title: 'Future',
    items: [{ empty: '∅ after edit' }],
  },
] as const;
---

<div class="wrapper">
  <div class="store-layer" aria-hidden="true">
    <div class="panel">
      <header>
        <span class="eyebrow">redux-undo</span>
        <strong>History + batch</strong>
      </header>

      <div class="timeline">
        {lanes.map((lane, i) => (
          <Fragment>
            {i > 0 && <span class="op" aria-hidden="true">→</span>}
            <figure class:list={['lane', lane.id]}>
              <figcaption>{lane.title}</figcaption>
              <ul>
                {lane.items.map((item) => (
                  <li class:list={{
                    snap: 'text' in item,
                    empty: 'empty' in item,
                    tree: 'code' in item,
                  }}>
                    {'text' in item && item.text}
                    {'empty' in item && item.empty}
                    {'code' in item && (
                      <Fragment>
                        <code>{item.code}</code>
                        <span>{item.note}</span>
                      </Fragment>
                    )}
                  </li>
                ))}
              </ul>
            </figure>
          </Fragment>
        ))}
      </div>

      <div class="batch">
        <span class="batch-label">groupedUndo.batch</span>
        <div class="batch-pipeline">
          <code class="action-chip">addMarker</code>
          <span class="op" aria-hidden="true">+</span>
          <code class="action-chip">setSpaceMarker</code>
          <span class="op" aria-hidden="true">→</span>
          <span class="result-badge">1 undo</span>
        </div>
        <p class="batch-note">
          One shared group id, so Ctrl/Z undoes the whole batch.
        </p>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
$accent: #89ab24;
$op-slot: 0.85em;

.wrapper {
  box-sizing: border-box;
  width: max-content;
  max-width: min(90cqw, 100%);
  margin-inline: auto;
  position: relative;
  display: grid;
  place-items: center;
}

.store-layer {
  width: max-content;
  max-width: 100%;
  display: grid;
  place-items: center;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.8rem, 0.024 * min(var(--sheet-inline), var(--sheet-block)), 1.05rem);
  color: #f4f0ea;

  /* A wide sheet has room this coefficient left empty: the timeline stopped under half
     the artwork area while the pages either side of it filled theirs. Below the
     breakpoint the title block sits far enough left that a bigger card runs under it.
     Keyed on the stack's attribute, not the width query, for the same reason the
     orientation is: see Stack.astro's script. */
  :global([data-sheet-width='wide']) & {
    font-size: clamp(0.8rem, 0.034 * min(var(--sheet-inline), var(--sheet-block)), 1.5rem);
  }

  /* The timeline runs down the sheet, and portrait stacks a note under it —
     the 0.8rem floor is what pushed it off the top. Keyed on the stack's
     attribute, not the orientation query: see Stack.astro's script. */
  :global([data-sheet-orientation='portrait']) & {
    font-size: min(1.5rem, 0.036 * min(var(--sheet-inline), var(--sheet-block)));
  }
}

.panel {
  box-sizing: border-box;
  width: max-content;
  max-width: 100%;
  padding: 0.6em 0.65em;
  background: #333;
  border: 2px solid #666;
  border-radius: 0.5em;
  display: grid;
  gap: 0.45em;
  box-shadow: 0 0.3rem 0.8rem color-mix(in oklab, #000 28%, transparent);
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.08em;

  .eyebrow {
    font-size: 0.72em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }
}

$lane: 9.75em;

.timeline {
  display: grid;
  grid-template-columns: $lane #{$op-slot} $lane #{$op-slot} $lane;
  align-items: stretch;
  column-gap: 0.25em;
  width: max-content;
}

.lane {
  margin: 0;
  display: grid;
  gap: 0.25em;
  align-content: start;
  width: 100%;
  min-width: 0;
  padding: 0.3em 0.4em;
  border-radius: 0.3em;
  border: 1px dashed color-mix(in oklab, #fff 22%, transparent);
  background: color-mix(in oklab, #000 22%, transparent);
  box-sizing: border-box;

  figcaption {
    font-size: 0.7em;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.85;
    text-align: center;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25em;
    font-size: 0.75em;
    line-height: 1.25;
  }

  .snap {
    padding: 0.25em 0.35em;
    border-radius: 0.22em;
    background: color-mix(in oklab, #fff 6%, transparent);
    opacity: 0.75;
  }

  .empty {
    padding: 0.25em 0.35em;
    opacity: 0.55;
    font-style: italic;
    text-align: center;
  }

  &.present {
    border-style: solid;
    border-color: $accent;
    border-width: 2px;
    background: color-mix(in oklab, $accent 14%, transparent);

    figcaption {
      color: #e8f5b8;
      opacity: 1;
    }
  }

  &.future {
    opacity: 0.85;
  }
}

.tree {
  display: grid;
  gap: 0.08em;
  padding: 0.25em 0.35em;
  border-radius: 0.22em;
  background: color-mix(in oklab, #000 18%, transparent);

  code {
    color: #c5e06a;
    font-size: 0.95em;
  }

  span {
    opacity: 0.7;
    font-size: 0.9em;
  }
}

.op {
  display: grid;
  place-items: center;
  align-self: center;
  opacity: 0.55;
  font-size: 0.95em;
  line-height: 1;
}

.batch {
  // Stay inside the timeline’s intrinsic width — don’t widen the panel.
  width: 0;
  min-width: 100%;
  display: grid;
  gap: 0.3em;
  padding: 0.4em 0.45em;
  border-radius: 0.3em;
  border: 1px solid #555;
  background: #2a2a28;
  box-sizing: border-box;
}

.batch-label {
  font-size: 0.7em;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: $accent;
}

.batch-pipeline {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.25em;
}

.action-chip {
  display: inline-grid;
  place-items: center;
  padding: 0.3em 0.4em;
  border-radius: 0.22em;
  border: 1px solid #555;
  background: color-mix(in oklab, #000 22%, transparent);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.72em;
  line-height: 1.2;
  color: #e8e4dc;
}

.result-badge {
  display: inline-grid;
  place-items: center;
  padding: 0.3em 0.45em;
  border-radius: 0.22em;
  background: color-mix(in oklab, $accent 40%, #333);
  color: #e8f5b8;
  font-size: 0.7em;
  font-weight: 600;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  white-space: nowrap;
}

.batch-note {
  margin: 0;
  font-size: 0.75em;
  opacity: 0.8;
  line-height: 1.3;
  text-wrap: balance;
}

@container technical-drawing (orientation: portrait) {
  .wrapper {
    max-width: min(90cqw, 100%);
  }

  .timeline {
    grid-template-columns: 1fr;
    width: 100%;
    row-gap: 0.25em;

    .op {
      transform: rotate(90deg);
      justify-self: center;
    }
  }
}
</style>
