---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

// Editor artwork is larger than sibling blueprint pages; scale stroke + type
// together so screen weight matches (do not override strokeWidth alone).
const annotationScale = 0.7;
const annotationFontSize = 0.1 * annotationScale;
---

<div class="wrapper">
  <Annotations scale={annotationScale} reach={1}>
    {/* inert: real MarkerEditor chrome, non-interactive diagram. */}
    <div class="editor-layer" slot="content" inert data-editor-layer-island></div>

    <Fragment slot="annotations">
      {/* Tip on left sector CP (blue circle); shaft down into the bottom gutter. */}
      <ArrowAnnotation
        tipX={-0.025}
        tipY={0.05}
        angle={325}
        length={0.4}
        fontSize={annotationFontSize}
        text="Circles: drag to edit shape"
      />
      {/* Tip on tip CP's cross (green); shaft down into the bottom gutter. */}
      <ArrowAnnotation
        tipX={-0.31}
        tipY={0.51}
        angle={360 - 325}
        length={0.2}
        fontSize={annotationFontSize}
        text="Crosses: display resulting constrained position "
      />
      {/* Tip on the sidebar's first step header; shaft up into the top gutter. */}
      <ArrowAnnotation
        tipX={0.55}
        tipY={-0.61}
        angle={135}
        length={0.15}
        fontSize={annotationFontSize}
        text="Sidebar: internal parts of a marker"
      />
    </Fragment>
  </Annotations>
</div>

{/* Vite React refresh preamble — required when mounting React from an Astro script in dev. */}
<script>
  if (import.meta.hot) {
    // Vite virtual module — only exists in dev
    // @ts-expect-error
    const RefreshRuntime = (await import('/@react-refresh')).default;
    RefreshRuntime.injectIntoGlobalHook(window);
    // @ts-expect-error Vite React refresh globals
    window.$RefreshReg$ = () => {};
    // @ts-expect-error Vite React refresh globals
    window.$RefreshSig$ = () => (type) => type;
    // @ts-expect-error Vite React refresh globals
    window.__vite_plugin_react_preamble_installed__ = true;
  }
</script>

<script>
  import { bootWhenVisible } from '@/client/bootWhenVisible';

  async function bootEditorLayer() {
    const mount = document.querySelector<HTMLElement>('[data-editor-layer-island]');
    if (!mount || mount.dataset.bootstrapped === 'true') return;
    mount.dataset.bootstrapped = 'true';

    const [{ createElement }, { createRoot }, { default: EditorLayerApp }] = await Promise.all([
      import('react'),
      import('react-dom/client'),
      import('./EditorLayerApp'),
    ]);

    // Always mount the shell — visibility / singleton handoff live inside the app
    // so we don't depend on IntersectionObserver surviving async import latency.
    createRoot(mount).render(createElement(EditorLayerApp));
  }

  function armBoot() {
    const mount = document.querySelector<HTMLElement>('[data-editor-layer-island]');
    if (!mount || mount.dataset.bootstrapped === 'true') return;

    const page =
      mount.closest<HTMLElement>('article.technical-drawing-stack > * > section')
      ?? mount;
    const stack = page.closest('article.technical-drawing-stack');

    bootWhenVisible(
      page,
      () => {
        void bootEditorLayer();
      },
      { root: stack, rootMargin: '0px', threshold: 0.2 },
    );
  }

  armBoot();
</script>

<style lang="scss">
.wrapper {
  position: relative;
  display: grid;
  place-items: center;
  width: 100%;
  min-width: 0;

  // The overlay is a child of the Annotations box, not of this wrapper.
  :global(.content > svg) {
    z-index: 2;
    pointer-events: none;
    overflow: visible;

    :global(text) {
      stroke: var(--blueprint-900);
      stroke-width: 0.004px;
      paint-order: stroke fill;
      stroke-linejoin: round;
    }

    // The chrome only fits inside the callout gutters on a frame this wide.
    // Under it the room is worth more than the callouts, whose type would be
    // unreadable at that size anyway — the note says the same thing in prose.
    @container technical-drawing-width (max-width: 56em) {
      display: none;
    }
  }
}

.editor-layer {
  // Annotations shrink-wraps its slot, and the only child here is the
  // absolutely positioned embed — so the artwork box has to be sized here or
  // it collapses to nothing. Slightly taller than the chrome so the tip isn't
  // flush with the frame.
  width: min(72cqw, calc(88cqh * 1.5));
  aspect-ratio: 1.5 / 1;
  max-width: 100%;

  // The chrome stacks on a phone sheet, so the box turns upright with it: no
  // callouts to leave gutters for, and the sheet's spare height is the whole
  // reason the stacked layout beats the side-by-side one.
  @container technical-drawing (orientation: portrait) {
    width: min(92cqw, calc(80cqh * 0.68));
    aspect-ratio: 0.68;
  }

  position: relative;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;

  :global(.editor-layer-host) {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
  }

  // Absolute embed ignores padding — inset it so arrow labels fit in the gutters.
  :global(#marker-editor-embed.marker-editor--embed) {
    inset: 14% 16% 15%;
    width: auto;
    height: auto;

    // No callouts down here, so the chrome takes the gutters back.
    @container technical-drawing-width (max-width: 56em) {
      inset: 2%;
    }
  }
}
</style>
