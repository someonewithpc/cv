---
---

<div class="selector-mock">
  <div class="grid">
    <div class="tile selected" title="Default marker"></div>
    <div class="tile" title="Custom marker"></div>
    <div class="tile action">+</div>
    <div class="tile action">×</div>
  </div>
  <p>Marker selector overlay</p>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

.selector-mock {
  display: grid;
  place-items: center;
  gap: 1rem;
  width: drawing.$artwork-width;
  min-height: 16em;
  color: var(--fg-700, #333);

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 4em);
    gap: 0.5em;
    padding: 0.75em;
    background: #333;
    border: 2px solid #666;
    border-radius: 0.5em;
  }

  .tile {
    width: 4em;
    height: 4em;
    border: 1px solid #666;
    border-radius: 0.5em;
    background:
      radial-gradient(circle at 50% 40%, #89ab24 0 35%, transparent 36%),
      linear-gradient(#444, #444);

    &.selected {
      border-color: #89ab24;
      border-width: 2px;
    }

    &.action {
      display: grid;
      place-items: center;
      color: white;
      font-size: 1.75rem;
      background: #444;
    }
  }

  p {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.8;
  }
}
</style>
