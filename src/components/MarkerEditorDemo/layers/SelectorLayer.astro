---
import { Icon } from 'astro-icon/components';

import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import defaultDecorationSvg from '../assets/default-decoration.svg?raw';
import defaultMarkerSvg from '../assets/default-marker.svg?raw';

const spaces = [
  { name: 'Lobby', label: 'A', active: false },
  { name: 'Cafe', label: 'B', active: true },
  { name: 'Plaza', label: 'C', active: false },
] as const;

/** Unedited squircle — same geometry as SquircleMarkerShape defaults. */
const squirclePath = [
  'M -0.5, 0',
  'C -0.5, -0.5  -0.5, -0.5  0, -0.5',
  '0.5, -0.5  0.5, -0.5  0.5, 0',
  '0.5, 0.5  0.5, 0.5  0, 0.5',
  '-0.5, 0.5  -0.5, 0.5  -0.5, 0',
  'z',
].join(' ');
---

<div class="wrapper">
  <Annotations reach={1}>
    <div class="selector-layer" slot="content">
      <div class="panel" aria-hidden="true">
        <ul class="chips">
          <li class="chip" title="Default marker with decoration">
            <span class="default-marker decorated">
              <span class="pin" set:html={defaultMarkerSvg} />
              <span class="decoration" set:html={defaultDecorationSvg} />
            </span>
          </li>
          <li class="chip selected" title="Space-letter squircle">
            <svg viewBox="-1 -1 2 2">
              <path d={squirclePath} fill="#a65d3f" stroke="#f4f0ea" stroke-width="0.07" />
              <text
                x="0"
                y="0.04"
                text-anchor="middle"
                dominant-baseline="middle"
                fill="#f4f0ea"
                font-size="0.7"
                font-family="Poppins, system-ui, sans-serif"
                font-weight="600"
              >B</text>
            </svg>
          </li>
          <li class="chip action" title="Create">
            <Icon name="lucide:plus" />
          </li>
          <li class="chip action" title="Upload">
            <Icon name="lucide:upload" />
          </li>
          <li class="chip action" title="Close">
            <Icon name="lucide:x" />
          </li>
        </ul>
      </div>

      <div class="resolve" aria-hidden="true">
        <ul class="spaces">
          {spaces.map((space) => (
            <li class:list={[{ active: space.active }]}>
              <svg viewBox="-1 -1 2 2">
                <path d={squirclePath} fill="#a65d3f" stroke="#f4f0ea" stroke-width="0.07" />
                <text
                  x="0"
                  y="0.04"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  fill="#f4f0ea"
                  font-size="0.7"
                  font-family="Poppins, system-ui, sans-serif"
                  font-weight="600"
                >{space.label}</text>
              </svg>
              <span>{space.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <Fragment slot="annotations">
      {/* Wide sheet: the five chips sit in one row, so + is the middle one. */}
      {/* Tip just outside the +, upper-right, aimed at its center. */}
      <ArrowAnnotation
        tipX={0.08}
        tipY={-0.4}
        angle={50}
        length={0.55}
        text="Create marker"
        arrowClass="on-wide"
        textClass="on-wide"
      />
      {/* Tip on the Cafe card's lower edge. Coming up from below is what keeps the
          label off the Plaza card, which is where a shaft to the right put it. */}
      <ArrowAnnotation
        tipX={0}
        tipY={1.04}
        angle={201}
        length={0.7}
        text="Same marker, matches the pin order"
        arrowClass="on-wide"
        textClass="on-wide"
      />

      {/* Phone sheet: the chips wrap to three columns, which moves + to the
          top-right and makes the artwork taller than it is wide. */}
      <ArrowAnnotation
        tipX={0.62}
        tipY={-1.15}
        angle={56}
        length={0.33}
        text="Create marker"
        arrowClass="on-narrow"
        textClass="on-narrow"
      />
      {/* Tip on the Cafe card's lower edge, under its marker — coming up from
          below keeps the shaft off the cards. */}
      <ArrowAnnotation
        tipX={0}
        tipY={1.25}
        angle={201}
        length={0.76}
        text="Same marker, matches the pin order"
        arrowClass="on-narrow"
        textClass="on-narrow"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

.wrapper {
  width: min(#{drawing.$artwork-width * 1.25}, 100%);
  max-width: 100%;

  // Square, so on a landscape sheet — half as tall as it is wide — the height
  // cap has to be a width term, or the space row runs under the title block.
  // Portrait has the height and skips it.
  @container technical-drawing (orientation: landscape) {
    width: min(#{drawing.$artwork-width * 1.25}, 100%, 88cqh);
  }
  aspect-ratio: 1;
  display: grid;
  place-items: center;

  // Wrapping the chips moves everything the callouts point at, so each
  // orientation carries its own set and hides the other's.
  :global(.on-narrow) {
    display: none;
  }

  @container technical-drawing (orientation: portrait) {
    :global(.on-wide) {
      display: none;
    }

    :global(.on-narrow) {
      display: revert;
    }
  }
}

.selector-layer {
  display: grid;
  justify-items: center;
  gap: 1.25em;
  width: 100%;
  font-size: 1.25em;
  color: var(--fg-700, #f4f0ea);
  font-family: var(--font-poppins), system-ui, sans-serif;
}

.panel {
  padding: 0.85em;
  background: #333;
  border: 2px solid #666;
  border-radius: 0.5em;
  color: #f4f0ea;
  box-shadow: 0 0.35rem 0.9rem color-mix(in oklab, #000 28%, transparent);
}

.chips {
  $item-size: 3.1em;
  $gap: 0.5em;

  display: grid;
  // One row for the diagram so + / upload / × stay beside the markers.
  grid-template-columns: repeat(5, $item-size);
  gap: $gap;

  // Five chips in a row is a panel as wide as a phone sheet. Wrap instead of
  // shrinking the chips — the sheet has height to spare and they stay legible.
  @container technical-drawing (orientation: portrait) {
    grid-template-columns: repeat(3, $item-size);
  }
  margin: 0;
  padding: 0;
  list-style: none;
  width: fit-content;
}

.chip {
  position: relative;
  width: 3.1em;
  height: 3.1em;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.25em;
  box-sizing: border-box;
  border: 2px solid #666;
  border-radius: 0.5em;
  background: #444;
  overflow: visible;
  color: #fff;

  :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  &.selected {
    border-color: #89ab24;
  }

  &.action {
    color: #fff;

    :global(svg) {
      width: 1.45em;
      height: 1.45em;
      stroke: currentColor;
      stroke-width: 2.25;
    }
  }

  .default-marker {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;

    .pin {
      display: contents;

      :global(svg) {
        width: 100%;
        height: 100%;
        color-scheme: only light;
        // Warm fill reads clearly under the blue house decoration.
        --accent-800: #c47a3a;
        --accent-400: #5c3a1e;
      }
    }

    &.decorated .decoration {
      position: absolute;
      left: 50%;
      // Pin bulb center sits below the geometric mid of the viewBox.
      top: 40%;
      width: 55%;
      height: 55%;
      translate: -50% -50%;
      pointer-events: none;

      :global(svg) {
        width: 100%;
        height: 100%;
      }
    }
  }
}

.resolve {
  display: grid;
  width: 100%;
}

.spaces {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.45em;
  margin: 0;
  padding: 0;
  list-style: none;

  li {
    display: grid;
    justify-items: center;
    gap: 0.3em;
    padding: 0.45em 0.25em 0.5em;
    border: 1px dashed color-mix(in oklab, var(--fg-700, #fff) 35%, transparent);
    border-radius: 0.45em;
    background: color-mix(in oklab, #000 18%, transparent);

    &.active {
      border-style: solid;
      border-color: #89ab24;
      background: color-mix(in oklab, #89ab24 16%, transparent);
    }

    svg {
      width: 2.75em;
      height: auto;
    }

    span {
      font-size: 0.7em;
      opacity: 0.85;
    }
  }
}
</style>
