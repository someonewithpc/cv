---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

/** Same tile geometry as MarkerEditor preview background. */
const crossTileSvg =
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='-1 -1 2 2'>"
  + "<line x1='-0.25' y1='0' x2='0.25' y2='0' stroke='%23aaa7' stroke-width='0.1'/>"
  + "<line x1='0' y1='-0.25' x2='0' y2='0.25' stroke='%23aaa7' stroke-width='0.1'/>"
  + '</svg>';

const crossTileUrl = `url("data:image/svg+xml,${crossTileSvg}")`;

const annotationScale = 0.55;
const annotationFontSize = 0.1 * annotationScale;
---

<div class="wrapper">
  <Annotations scale={annotationScale} reach={1}>
    <div class="background-layer" slot="content">
      <div class="panel">
        <header>
          <span class="eyebrow">Preview chrome</span>
          <strong>Crosshair background</strong>
        </header>

        <div class="compare">
          <figure class="card fail-card">
            <figcaption>
              <span class="badge bad">Failed</span>
              Overlapping linear-gradients
            </figcaption>
            <div class="sample fail-both debug odd-width"></div>
            <p class="note">
              H + V stripe layers stack into a grid, but each axis rounds its stops alone, so the
              columns drift.
            </p>
          </figure>

          <figure class="card win-card">
            <figcaption>
              <span class="badge good">Shipped</span>
              SVG tile · repeat × 17
            </figcaption>
            <div class="sample shipped" style={`--cross-tile: ${crossTileUrl}`}></div>
            <p class="note">
              One tiny SVG draws a centered <code>+</code> from two short strokes in a
              <code>viewBox="-1 -1 2 2"</code>. <code>background-repeat</code> tiles that cell so
              every cross stays coherent.
            </p>
          </figure>
        </div>

        <div class="pipeline">
          <figure class="mini">
            <figcaption>H stripes</figcaption>
            <div class="sample fail-h debug"></div>
            <p class="mini-note">Rows, no columns</p>
          </figure>
          <span class="op" aria-hidden="true">+</span>
          <figure class="mini">
            <figcaption>V stripes</figcaption>
            <div class="sample fail-v debug"></div>
            <p class="mini-note">Columns, no rows</p>
          </figure>
          <span class="op" aria-hidden="true">→</span>
          <figure class="mini intent">
            <figcaption>Overlap = grid</figcaption>
            <div class="sample fail-both debug"></div>
            <p class="mini-note">Crosses where lines meet</p>
          </figure>
          <div class="divider"></div>
          <figure class="mini tile-step">
            <figcaption>SVG cell</figcaption>
            <div class="sample tile">
              <svg viewBox="-1 -1 2 2" aria-hidden="true">
                <line x1="-0.25" y1="0" x2="0.25" y2="0" stroke="#aaa7" stroke-width="0.14" />
                <line x1="0" y1="-0.25" x2="0" y2="0.25" stroke="#aaa7" stroke-width="0.14" />
              </svg>
            </div>
            <p class="mini-note">Short +, then tiled</p>
          </figure>
        </div>
      </div>
    </div>

    <Fragment slot="annotations">
      {/* Both labels sit in the panel's header row, right of the heading, the one
          part of the panel with nothing in it; the sheet has no room around the
          panel. The arrows come down from there into each sample's top-right. The
          failed grid's lines end each 1/9 column and each 17.22% row, so 8/9 and
          0.1722 is the junction one cell in from the top-right corner; the tile grid
          is 17 crosses wide and centred, so 14.5/17 is the third cross from the right
          and the row four tiles above the middle one. */}
      <ArrowAnnotation
        target=".fail-card .sample"
        anchor="0.8889 0.1722"
        tipX={-0.12}
        tipY={-0.5}
        angle={60}
        length={0.35}
        lengthOffset={{ x: -0.05 }}
        fontSize={annotationFontSize}
        text="Subpixel jitter"
        only="landscape"
      />
      <ArrowAnnotation
        target=".win-card .sample"
        anchor="0.8529 0.1354"
        tipX={0.81}
        tipY={-0.55}
        angle={120}
        length={0.28}
        labelSide="left"
        lengthOffset={{ x: -0.05 }}
        fontSize={annotationFontSize}
        text="Stable crosses"
        only="landscape"
      />
      {/* Portrait: the header is two lines and the samples sit lower, so the
          shafts are longer. */}
      <ArrowAnnotation
        target=".fail-card .sample"
        anchor="0.8889 0.1722"
        tipX={-0.12}
        tipY={-0.24}
        angle={60}
        length={0.6}
        fontSize={annotationFontSize}
        text="Subpixel jitter"
        only="portrait"
      />
      <ArrowAnnotation
        target=".win-card .sample"
        anchor="0.8529 0.1354"
        tipX={0.8}
        tipY={-0.33}
        angle={120}
        length={0.62}
        labelSide="left"
        fontSize={annotationFontSize}
        text="Stable crosses"
        only="portrait"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use '@/scss/sheet-orientation' as *;
$preview-bg: #3d3d3b;
$line-real: #aaa7;
$stripe-h: #5a9e3e;
$stripe-v: #2d6b1f;
$cell-debug: 11.111%;

.wrapper {
  width: min(68cqw, calc(84cqh * 1.4));
  aspect-ratio: 1.4 / 1;
  max-height: 84cqh;
  position: relative;
  display: grid;
  place-items: stretch;

  @container technical-drawing (orientation: portrait) {
    width: 92cqw;
    aspect-ratio: auto;
    max-height: none;
  }

  > :global(svg) {
    z-index: 2;
    pointer-events: none;
  }
}

.background-layer {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: stretch;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.5rem, 0.024 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  color: #f4f0ea;
}

.panel {
  box-sizing: border-box;
  padding: 0.85em;
  background: #333;
  border: 2px solid #666;
  border-radius: 0.55em;
  display: grid;
  gap: 0.75em;
  align-content: start;
  box-shadow: 0 0.35rem 0.9rem color-mix(in oklab, #000 28%, transparent);
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.15em;

  .eyebrow {
    font-size: max(0.5rem, 0.75em);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }
}

.compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.65em;
  min-height: 0;
}

.card {
  margin: 0;
  display: grid;
  gap: 0.35em;
  min-width: 0;

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: max(0.5rem, 0.75em);
    font-weight: 600;
  }

  .note {
    margin: 0;
    font-size: max(0.5rem, 0.75em);
    opacity: 0.75;
    line-height: 1.35;

    code {
      font-size: max(0.5rem, 0.875em);
      opacity: 0.95;
    }
  }
}

.badge {
  display: inline-grid;
  place-items: center;
  padding: 0.12em 0.4em;
  border-radius: 0.25em;
  font-size: max(0.5rem, 0.75em);
  letter-spacing: 0.04em;
  text-transform: uppercase;

  &.bad {
    background: color-mix(in oklab, #c45c2a 40%, #333);
    color: #ffd4b8;
  }

  &.good {
    background: color-mix(in oklab, #89ab24 40%, #333);
    color: #e8f5b8;
  }
}

.sample {
  // A gradient stop in % measures along its own axis, so the `to bottom` period has to
  // carry the box ratio or the debug cells come out as wide as the sample is.
  --sample-aspect: 1.55;
  --cell-x: #{$cell-debug};
  --cell-y: calc(#{$cell-debug} * var(--sample-aspect));

  box-sizing: border-box;
  width: 100%;
  aspect-ratio: var(--sample-aspect) / 1;
  border-radius: 0.35em;
  border: 1px solid #666;
  overflow: hidden;
  background-color: $preview-bg;

  &.odd-width {
    width: calc(100% - 1.25px);
    justify-self: center;
  }

  &.fail-h.debug {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--cell-y) - 1px),
      #{$stripe-h} calc(var(--cell-y) - 1px),
      #{$stripe-h} var(--cell-y)
    );
  }

  &.fail-v.debug {
    background-image: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc(var(--cell-x) - 2.5px),
      #{$stripe-v} calc(var(--cell-x) - 2.5px),
      #{$stripe-v} var(--cell-x)
    );
  }

  &.fail-both.debug {
    border-color: $stripe-h;
    border-width: 2px;
    background-image:
      repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(var(--cell-x) - 2.5px),
        #{$stripe-v} calc(var(--cell-x) - 2.5px),
        #{$stripe-v} var(--cell-x)
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--cell-y) - 1px),
        #{$stripe-h} calc(var(--cell-y) - 1px),
        #{$stripe-h} var(--cell-y)
      ),
      linear-gradient($preview-bg);
  }

  &.tile {
    display: grid;
    place-items: center;
    background:
      linear-gradient(#4a4a47 0 0) center / 1px 100% no-repeat,
      linear-gradient(#4a4a47 0 0) center / 100% 1px no-repeat,
      $preview-bg;

    svg {
      width: 55%;
      height: auto;
    }
  }

  &.shipped {
    $crosses: 17;
    $cell-size: calc(100% / $crosses);

    background:
      var(--cross-tile) repeat center / $cell-size,
      linear-gradient($preview-bg);
  }
}

.pipeline {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  grid-template-rows: auto 1fr auto;
  gap: 0.35em 0.45em;
  align-items: stretch;
}

.mini {
  margin: 0;
  display: grid;
  grid-template-rows: subgrid;
  grid-row: 1 / span 3;
  gap: 0.2em;
  min-width: 0;

  figcaption {
    font-size: max(0.5rem, 0.625em);
    font-weight: 600;
    opacity: 0.8;
    text-align: center;
    align-self: end;
  }

  .sample {
    // Stretching to the row killed the ratio the cell size is derived from.
    --sample-aspect: 1.4;
    align-self: start;
  }

  .mini-note {
    margin: 0;
    min-height: 1.25em;
    font-size: max(0.5rem, 0.625em);
    opacity: 0.7;
    line-height: 1.25;
    text-align: center;
  }

  &.intent .sample {
    // Idealized equal stop widths so the pipeline shows intent, not the bug.
    background-image:
      repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(var(--cell-x) - 1px),
        #{$stripe-v} calc(var(--cell-x) - 1px),
        #{$stripe-v} var(--cell-x)
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--cell-y) - 1px),
        #{$stripe-h} calc(var(--cell-y) - 1px),
        #{$stripe-h} var(--cell-y)
      ),
      linear-gradient($preview-bg);
  }
}

.op {
  grid-row: 2;
  align-self: center;
  opacity: 0.55;
  font-size: max(0.5rem, 0.875em);
  text-align: center;
  line-height: 1;
}

.divider {
  grid-row: 1 / span 3;
  justify-self: center;
  width: 1px;
  align-self: stretch;
  margin: 0.15em 0.1em;
  background: color-mix(in oklab, #f4f0ea 35%, transparent);
}

@container technical-drawing (orientation: portrait) {
  /* Stacking the two cards doubled the panel's height, and portrait has less
     of it to give, not more — keep them side by side. */
  .compare {
    gap: 0.45em;
  }

}

/* The pipeline is the second telling of what the compare cards already show,
   and it is the difference between fitting the sheet and running off it.
   Keyed on the stack's attribute, not the orientation query: a query-driven
   display toggle here cost a second on the way back to landscape (see
   Stack.astro's script). */
@include portrait-sheet {
  .pipeline {
    display: none;
  }
}
</style>
