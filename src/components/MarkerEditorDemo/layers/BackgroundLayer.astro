---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

/** Same tile geometry as MarkerEditor preview background. */
const crossTileSvg =
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='-1 -1 2 2'>"
  + "<line x1='-0.25' y1='0' x2='0.25' y2='0' stroke='%23aaa7' stroke-width='0.1'/>"
  + "<line x1='0' y1='-0.25' x2='0' y2='0.25' stroke='%23aaa7' stroke-width='0.1'/>"
  + '</svg>';

const crossTileUrl = `url("data:image/svg+xml,${crossTileSvg}")`;
---

<div class="wrapper">
  <Annotations>
    <div class="background-layer" slot="content" aria-hidden="true">
      <div class="panel">
        <header>
          <span class="eyebrow">Preview chrome</span>
          <strong>Crosshair background</strong>
        </header>

        <div class="compare">
          <figure class="card fail-card">
            <figcaption>
              <span class="badge bad">Failed</span>
              Overlapping linear-gradients
            </figcaption>
            <div class="sample fail-both debug odd-width"></div>
            <p class="note">H + V layers round stops independently → uneven columns</p>
          </figure>

          <figure class="card win-card">
            <figcaption>
              <span class="badge good">Shipped</span>
              SVG tile · repeat × 17
            </figcaption>
            <div class="sample shipped" style={`--cross-tile: ${crossTileUrl}`}></div>
            <p class="note">One coherent cross per cell — no stripe drift</p>
          </figure>
        </div>

        <div class="pipeline">
          <figure class="mini">
            <figcaption>Base</figcaption>
            <div class="sample base"></div>
          </figure>
          <span class="arrow" aria-hidden="true">→</span>
          <figure class="mini">
            <figcaption>H</figcaption>
            <div class="sample fail-h debug"></div>
          </figure>
          <span class="arrow" aria-hidden="true">+</span>
          <figure class="mini">
            <figcaption>V</figcaption>
            <div class="sample fail-v debug"></div>
          </figure>
          <span class="arrow" aria-hidden="true">→</span>
          <figure class="mini">
            <figcaption>Tile</figcaption>
            <div class="sample tile">
              <svg viewBox="-1 -1 2 2" aria-hidden="true">
                <line x1="-0.25" y1="0" x2="0.25" y2="0" stroke="#aaa7" stroke-width="0.14" />
                <line x1="0" y1="-0.25" x2="0" y2="0.25" stroke="#aaa7" stroke-width="0.14" />
              </svg>
            </div>
          </figure>
        </div>
      </div>
    </div>

    <Fragment slot="annotations">
      <ArrowAnnotation
        tipX={-0.4}
        tipY={-0.15}
        angle={155}
        length={0.38}
        text="Subpixel jitter  "
      />
      <ArrowAnnotation
        tipX={0.42}
        tipY={-0.15}
        angle={-30}
        length={0.38}
        text="Stable crosses  "
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
$preview-bg: #3d3d3b;
$line-real: #aaa7;
$line-magenta: #ff00ff;
$stripe-green: #146b28;
$cell-debug: 11.111%;

.wrapper {
  width: min(68cqw, calc(84cqh * 1.4));
  aspect-ratio: 1.4 / 1;
  max-height: 84cqh;
  position: relative;
  display: grid;
  place-items: stretch;

  @container technical-drawing (orientation: portrait) {
    width: min(92cqw, calc(70cqh * 1.05));
    aspect-ratio: 1.05 / 1;
    max-height: 70cqh;
  }

  > :global(svg) {
    z-index: 2;
    pointer-events: none;
  }
}

.background-layer {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: stretch;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.55rem, 2.4cqmin, 1rem);
  color: #f4f0ea;
}

.panel {
  box-sizing: border-box;
  padding: 0.85em;
  background: #333;
  border: 2px solid #666;
  border-radius: 0.55em;
  display: grid;
  gap: 0.75em;
  align-content: start;
  box-shadow: 0 0.35rem 0.9rem color-mix(in oklab, #000 28%, transparent);
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.15em;

  .eyebrow {
    font-size: 0.7em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }
}

.compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.65em;
  min-height: 0;
}

.card {
  margin: 0;
  display: grid;
  gap: 0.35em;
  min-width: 0;

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.78em;
    font-weight: 600;
  }

  .note {
    margin: 0;
    font-size: 0.68em;
    opacity: 0.75;
    line-height: 1.3;
  }
}

.badge {
  display: inline-grid;
  place-items: center;
  padding: 0.12em 0.4em;
  border-radius: 0.25em;
  font-size: 0.75em;
  letter-spacing: 0.04em;
  text-transform: uppercase;

  &.bad {
    background: color-mix(in oklab, #ff00ff 35%, #333);
    color: #ffc0ff;
  }

  &.good {
    background: color-mix(in oklab, #89ab24 40%, #333);
    color: #e8f5b8;
  }
}

.sample {
  box-sizing: border-box;
  width: 100%;
  aspect-ratio: 1.55 / 1;
  border-radius: 0.35em;
  border: 1px solid #666;
  overflow: hidden;
  background-color: $preview-bg;

  &.odd-width {
    width: calc(100% - 1.25px);
    justify-self: center;
  }

  &.base {
    background: $preview-bg;
  }

  &.fail-h.debug {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(#{$cell-debug} - 1px),
      #{$line-magenta} calc(#{$cell-debug} - 1px),
      #{$line-magenta} #{$cell-debug}
    );
  }

  &.fail-v.debug {
    background-image: repeating-linear-gradient(
      to right,
      transparent 0,
      transparent calc(#{$cell-debug} - 2.5px),
      #{$stripe-green} calc(#{$cell-debug} - 2.5px),
      #{$stripe-green} #{$cell-debug}
    );
  }

  &.fail-both.debug {
    border-color: $line-magenta;
    border-width: 2px;
    background-image:
      repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(#{$cell-debug} - 2.5px),
        #{$stripe-green} calc(#{$cell-debug} - 2.5px),
        #{$stripe-green} #{$cell-debug}
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(#{$cell-debug} - 1px),
        #{$line-magenta} calc(#{$cell-debug} - 1px),
        #{$line-magenta} #{$cell-debug}
      ),
      linear-gradient($preview-bg);
  }

  &.tile {
    display: grid;
    place-items: center;

    svg {
      width: 55%;
      height: auto;
    }
  }

  &.shipped {
    $crosses: 17;
    $cell-size: calc(100% / $crosses);

    background:
      var(--cross-tile) repeat center / $cell-size,
      linear-gradient($preview-bg);
  }
}

.pipeline {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  gap: 0.35em;
  align-items: center;
}

.mini {
  margin: 0;
  display: grid;
  gap: 0.2em;
  min-width: 0;

  figcaption {
    font-size: 0.65em;
    font-weight: 600;
    opacity: 0.8;
    text-align: center;
  }

  .sample {
    aspect-ratio: 1.4 / 1;
  }
}

.arrow {
  opacity: 0.55;
  font-size: 0.9em;
  text-align: center;
}

@container technical-drawing (orientation: portrait) {
  .compare {
    grid-template-columns: 1fr;
  }

  .pipeline {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: auto;

    .arrow {
      display: none;
    }
  }
}
</style>
