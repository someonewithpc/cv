---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';

import MockMap from './MockMap/MockMap.astro';
import SelectorLayer from './layers/SelectorLayer.astro';
import EditorLayer from './layers/EditorLayer.astro';
import EditorAside from './layers/EditorAside.astro';
import BackgroundLayer from './layers/BackgroundLayer.astro';
import PartsLayer from './layers/PartsLayer.astro';
import StoreLayer from './layers/StoreLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

// Resolve from cwd — import.meta.url points at dist prerender chunks during build.
const srcRoot = path.join(process.cwd(), 'src');
const markerEditorEntry = path.join(
  srcRoot,
  'components/MarkerEditorDemo/markers/MarkerEditor/index.tsx',
);

const { outputFiles: [markerEditorBundle] } = await esbuild.build({
  entryPoints: [markerEditorEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  jsx: 'automatic',
  packages: 'external',
  alias: { '@': srcRoot },
  loader: {
    '.scss': 'empty',
    '.css': 'empty',
    '.svg': 'empty',
  },
});

const markerEditorSize = toKiB(markerEditorBundle.text);

const layers = {
  main: { name: null },
  selector: { name: 'Marker Selector', pageStyle: 'blueprint' },
  editor: { name: 'Marker Editor', pageStyle: 'blueprint' },
  background: { name: 'Preview Background', pageStyle: 'blueprint' },
  parts: { name: 'Composable Parts', pageStyle: 'blueprint' },
  store: { name: 'Undoable Store', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="Interactive Map Marker Editor"
  scale="1:1"
  size={markerEditorSize}
  date="2026"
  tech={['react', 'leaflet']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      main: <MockMap />,
      selector: <SelectorLayer />,
      editor: <EditorLayer />,
      background: <BackgroundLayer />,
      parts: <PartsLayer />,
      store: <StoreLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      main: (
        <PostIt background="#e8e4dc" color="black">
          Hover or focus to take over, then click a pin to open the marker picker. Ctrl/Cmd+Z undoes.
        </PostIt>
      ),
      selector: (
        <PostIt background="#cde" color="black">
          Pick or create a marker for a space. If the decoration is a space number or letter, the
          selector rewrites every thumbnail to that space’s label — one shared marker, Lobby A /
          Cafe B / Plaza C.
        </PostIt>
      ),
      editor: (<EditorAside />),
      background: (
        <PostIt background="#dfd" color="black">
          H and V stripe layers were meant to stack into a cross grid, but each axis rounded stops
          alone and the columns drifted. A tiny SVG <code>+</code> tiled with{' '}
          <code>background-repeat</code> keeps every cell coherent.
        </PostIt>
      ),
      parts: (
        <PostIt background="#cfc" color="black">
          Shape, border, fill, and decoration stack into one marker. On save, each MarkerPart
          writes typed <code>data-*</code> attributes onto the SVG so load can rebuild the same
          parts.
        </PostIt>
      ),
      store: (
        <PostIt background="#edf" color="black">
          Marker and space mutations live under redux-undo. <code>groupedUndo.batch</code> wraps
          multi-dispatch saves so Ctrl/Z undoes the whole edit as one step.
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
