---
import mapUrl from './map.svg?url';
---

<div class="mock-map-demo" data-mock-map>
  {/* img isolates the SVG from page CSS (theme/color inheritance was tinting fills). */}
  <img class="mock-map-svg" src={mapUrl} width="800" height="800" alt="" decoding="async" loading="lazy" />
  <div class="mock-map-island" data-mock-map-island></div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from './boot';

bootIslands('[data-mock-map]', boot);
</script>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

// Larger than the shared logo artwork so the map can read as a scene
$mock-map-width: drawing.$artwork-width * 1.75;

.mock-map-demo {
  position: relative;
  width: min(#{$mock-map-width}, 100%);
  max-width: 100%;

  // Square, so on a landscape sheet — half as tall as it is wide — the height
  // cap has to be a width term, or the map runs off the mat and out from
  // under the title block. Portrait has the height and skips it.
  @container technical-drawing (orientation: landscape) {
    width: min(#{$mock-map-width}, 100%, 88cqh);
  }

  // On a sheet too narrow for callout gutters the title block still claims
  // the bottom-right corner, and a centred square runs under it — sit at the
  // datum edge instead, like a drawing view. Portrait maps span the sheet,
  // so the auto margin resolves to zero there.
  @container technical-drawing-width (max-width: 56em) {
    margin-right: auto;
  }
  aspect-ratio: 1;
  overflow: hidden;
  // Lets the marker selector switch to its docked layout on small maps.
  container: mock-map / inline-size;
  border-radius: 0.35em;
  outline: none;
  color-scheme: only light;
  box-shadow: inset 0 0 0 1px color-mix(in oklab, #000 6%, transparent);
  forced-color-adjust: none;
  --map-scale: 1;
  --map-focus-x: 0.5;
  --map-focus-y: 0.5;

  .mock-map-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
    transform-origin: 0 0;
    transform: translate(
        calc((0.5 - var(--map-focus-x) * var(--map-scale)) * 100%),
        calc((0.5 - var(--map-focus-y) * var(--map-scale)) * 100%)
      )
      scale(var(--map-scale));
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;

    // The zoom says where the map went, so reduced motion keeps it, only quicker
    @media (prefers-reduced-motion: reduce) {
      transition-duration: 0.2s;
    }
  }

  .mock-map-island {
    position: absolute;
    inset: 0;
  }
}

// A landscape sheet too narrow for the wide one's type is half as tall as it is wide, and the
// square map left its right half empty. There the map takes the whole sheet, the way a map widget
// fills whatever box the venue's page gives it, and the title block lies over its corner. The
// square stays the sheet's height, so the pins keep their place on it; the SVG draws its streets
// past the viewBox into the room either side. Only the pins and the selector keep off the block
// (MockMapOverlay.scss). The script names the band on the stack, so without it nothing changes.
$narrow-landscape: "article.technical-drawing-stack[data-sheet-orientation='landscape'][data-sheet-width='narrow']";

:global(#{$narrow-landscape} > * > section:has(.mock-map-demo)) {
  // The gap the Space Builder keeps between the frame line and an app that fills the sheet.
  --map-pad: calc(2px + var(--demo-inset));
  grid-template-rows: minmax(0, 1fr);
}

:global(#{$narrow-landscape} > * > section .content:has(.mock-map-demo)) {
  grid-column: 1 / -1;
  align-self: stretch;
  height: 100%;
  box-sizing: border-box;
  padding: var(--map-pad);
}

:global(#{$narrow-landscape}) .mock-map-demo {
  width: 100%;
  height: 100%;
  aspect-ratio: auto;
  margin: 0;
  // Sized by the sheet now, so the map can read its own height: the square is 100cqh.
  container-type: size;
  // The streets end a little way past the viewBox; the land carries on to the edges.
  background: #efebe3;

  .mock-map-svg {
    position: absolute;
    inset: 0;
    // The square sits in the middle of the wider box, so the zoom is the same one in units of
    // the square, about its left edge.
    transform-origin: calc(50% - 50cqh) 0;
    transform: translate(
        calc((0.5 - var(--map-focus-x) * var(--map-scale)) * 100cqh),
        calc((0.5 - var(--map-focus-y) * var(--map-scale)) * 100cqh)
      )
      scale(var(--map-scale));
  }
}
</style>
