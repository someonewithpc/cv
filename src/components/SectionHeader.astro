---
type Props = {
  headingId: string;
  titleJp: string;
  title: string;
};

const { headingId, titleJp, title } = Astro.props;
---

<header>
  <h2 id={headingId}>
    <span class="typewriter">{title}</span>
    <small lang="ja">{titleJp}</small>
  </h2>
</header>

<style lang="scss">
header {
  margin-bottom: 2.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid color-mix(in oklch, var(--line), transparent 25%);

  /* The gloss is lettered beside the title on its baseline, the way a bilingual drawing sets
     its second language, and wraps under it where the title takes the width. */
  h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;

    [lang='ja'] {
      font-size: 0.75rem;
    }

    .typewriter {
      font-size: clamp(2.25rem, 5.5vw, 3.25rem);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.05;
      color: var(--ink);
    }
  }
}
</style>
