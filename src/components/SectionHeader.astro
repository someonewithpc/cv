---
type Props = {
  headingId: string;
  titleJp: string;
  title: string;
};

const { headingId, titleJp, title } = Astro.props;
---

<header>
  <h2 id={headingId}>
    <small lang="ja">{titleJp}</small>
    <span class="typewriter">{title}</span>
  </h2>
</header>

<style lang="scss">
header {
  margin-bottom: 2.5rem;

  h2 {
    display: grid;
    justify-items: start;
    gap: 0.125rem;

    [lang='ja'] {
      font-size: 0.6875rem;
    }

    .typewriter {
      font-size: clamp(2.25rem, 5.5vw, 3.25rem);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.05;
      color: var(--fg-900);
    }
  }
}
</style>
