---
type Props = {
  headingId: string;
  titleJp: string;
  title: string;
  sheetCode?: string;
};

const { headingId, titleJp, title, sheetCode = 'SH' } = Astro.props;
---

<header>
  <p class="sheet-code monospace" aria-hidden="true">{sheetCode}</p>
  <h2 id={headingId}>
    <small lang="ja">{titleJp}</small>
    <span class="typewriter">{title}</span>
  </h2>
</header>

<style lang="scss">
header {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  margin-bottom: 0;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--sheet-frame);

  .sheet-code {
    order: 1;
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  h2 {
    display: grid;
    justify-items: start;
    gap: 0.125rem;

    [lang='ja'] {
      font-size: 0.6875rem;
    }

    .typewriter {
      font-size: clamp(1.75rem, 4.5vw, 2.5rem);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.05;
      color: var(--ink);
    }
  }
}
</style>
