---
type Props = {
  headingId: string;
  titleJp: string;
  title: string;
};

const { headingId, titleJp, title } = Astro.props;
---

<header>
  <h2 id={headingId} class="tape">
    <small lang="ja">{titleJp}</small>
    <span class="marker-font">{title}</span>
  </h2>
</header>

<style lang="scss" is:global>
/* A strip of masking tape stuck to the desk, the section's name written on it
   in marker. Global because the open-source header re-uses the same strip. */
.tape {
  --tape-ink: oklch(0.24 0.03 260);

  position: relative;
  display: inline-grid;
  gap: 0;
  width: fit-content;
  padding: 0.375rem 1.75rem 0.5rem;
  rotate: -1.5deg;
  color: var(--tape-ink);
  background: var(--theme-tape);
  box-shadow: 0 0.125rem 0.375rem rgb(0 0 0 / 0.28);
  clip-path: polygon(
    0.5% 0, 99.4% 4%, 100% 32%, 99.1% 58%, 100% 82%, 99.4% 100%,
    0.9% 96%, 0 74%, 0.7% 48%, 0 18%
  );

  [lang='ja'] {
    display: block;
    margin-inline-start: 0.125rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: color-mix(in oklch, var(--tape-ink), transparent 15%);
  }

  .marker-font {
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    line-height: 1.1;
  }
}
</style>
