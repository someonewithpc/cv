---
import { highlightLines } from '@/highlight';

// The argument each caller passes, marked.
const where = { text: 'where', open: '<span class="hot">', close: '</span>' };

// Where the one builder's SQL ends up, the way app/models/library_object.rb wrote it on the
// branch. The bodies are cut down to the lines that show what the builder was handed.
const targets = [
  {
    id: 'backfill',
    title: 'Backfill',
    when: 'rake data_migrations:initialize_…, once',
    where: '"1=1"',
    sql: [
      'INSERT IGNORE INTO library_object_synthetic_properties',
      '  (library_object_id, name, value)',
      '#{size_synthetic_property_select_sql}',
      'UNION ALL',
      '#{pax_synthetic_property_select_sql};',
    ],
  },
  {
    id: 'insert',
    title: 'trigger.after(:insert)',
    when: null,
    where: '"id = NEW.id"',
    sql: [
      'INSERT INTO library_object_synthetic_properties',
      '  (library_object_id, name, value)',
      '#{size_synthetic_property_select_sql("id = NEW.id")}',
      'UNION ALL',
      '#{pax_synthetic_property_select_sql("id = NEW.id")};',
    ],
  },
  {
    id: 'update',
    title: 'trigger.after(:update).of(:size)',
    when: null,
    where: '"id = NEW.id"',
    sql: [
      'UPDATE library_object_synthetic_properties AS lops',
      'JOIN (',
      '  #{size_synthetic_property_select_sql("id = NEW.id")}',
      ') AS temp',
      'ON lops.library_object_id = temp.library_object_id',
      '  AND lops.name = temp.name',
      'SET lops.value = temp.value',
      'WHERE lops.library_object_id = NEW.id;',
    ],
  },
  {
    id: 'delete',
    title: 'trigger.after(:delete)',
    when: null,
    where: null,
    sql: [
      'DELETE FROM library_object_synthetic_properties',
      'WHERE library_object_synthetic_properties.library_object_id = OLD.id;',
    ],
  },
];

// The builder, with the argument each caller passes marked where it is taken and where it lands.
const builder = highlightLines([
  'def self.size_synthetic_property_select_sql(',
  where,
  ` = "1=1")
  <<~SQL.chomp
    WITH RECURSIVE split_sizes AS (…)  -- one row per dimension
    SELECT id AS library_object_id, 'Size (centimeters)' AS name,
      GROUP_CONCAT(CONCAT(ROUND(size, 1 - FLOOR(LOG10(size))), 'cm') SEPARATOR ' by ') AS value
    FROM split_sizes WHERE #{`,
  where,
  `} AND size <> '' GROUP BY id
    UNION ALL  -- five more, and the exact cm and m where they round
  SQL
end`,
], 'ruby').join('\n');

// A long name may wrap after an underscore, a dot or an opening bracket, never inside a word,
// and never to leave a stub such as `id` alone on the next line.
const breakable = (line: string) => line.split(/(?<=[_.(])(?![a-z]{1,3}\b)/i);

// Each body as the heredoc it sits in, so its interpolations read as Ruby, with a break
// opportunity at every place breakable allows.
const body = (sql: string[]) =>
  highlightLines(
    sql.flatMap((line, index) => [
      ...(index > 0 ? ['\n'] : []),
      ...breakable(line).flatMap((part, at) => (at > 0 ? [{ insert: '<wbr>' }, part] : [part])),
    ]),
    'ruby',
    { context: ['<<~SQL\n', '\nSQL'] },
  );
---

<div class="wrapper synthetic-blueprint hl">
  <div class="trigger-layer">
    <div class="panel">
      <header>
        <strong>The same SQL in the backfill and three triggers</strong>
        <span>The backfill and the insert and update triggers on <code>library_objects</code> call
          one Ruby method, each with its own <code>where</code>. The delete trigger only deletes
          the rows. The hairtrigger gem writes the triggers into a migration.</span>
      </header>

      <div class="builder">
        <span class="caption"><code>app/models/library_object.rb</code></span>
        <pre class="hl-box"><code set:html={builder} /></pre>
      </div>

      <ol class="targets">
        {targets.map((target) => (
          <li class="target" data-target={target.id}>
            <span class="head">
              <span class="title">{target.title}</span>
              {target.when && <span class="when">{target.when}</span>}
              {target.where && (
                <span class="source"><code>where</code> = <code class="hot">{target.where}</code></span>
              )}
            </span>
            <pre class="hl-box"><code>{body(target.sql).map((line) => <span class="line" set:html={line} />)}</code></pre>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>

<style lang="scss">
@use '@/scss/sheet-orientation' as *;
@use "./sheet" as *;

.wrapper {
  @include blueprint-wrapper;
}

.trigger-layer {
  @include sheet-type;

  box-sizing: border-box;
  width: min(100%, 72em);
}

.panel {
  @include panel;

  gap: 0.375em;
}

header {
  display: grid;
  gap: 0.125em;

  strong {
    @include small-type(0.875);
  }

  span {
    @include small-type(0.6875);
    color: var(--ink-muted);
    text-wrap: pretty;
  }
}

code,
pre {
  font-family: monospace, system-ui;
}

pre {
  margin: 0;
  padding: 0.375em 0.5em;
  border: 1px solid var(--line);
  border-radius: 0.25em;
  background: var(--surface-sunken);
  white-space: pre-wrap;
  line-height: 1.25;
}

.builder {
  display: grid;
  gap: 0.25em;
  justify-self: center;
  width: min(100%, 64em);

  .caption {
    @include small-type(0.6875);
    color: var(--ink-muted);
  }

  pre {
    @include small-type(0.5625);
    overflow-wrap: anywhere;
  }
}

.hot {
  color: var(--accent-text);
  font-weight: 600;
}

/* In the code the mark takes the warm role, which is tuned to the code's ground. */
pre :global(.hot) {
  color: var(--hl-warm);
  font-weight: 600;

  /* The marked argument stays one colour, whatever kind its word is. */
  :global(span) {
    color: inherit;
  }
}

/* The four in one row of equal cards: each card spans a heading row and a code row the
   four share, so the code blocks start on one line and end on another. The row is as tall
   as its longest body, so the widths are set to make that one short: the update body has
   the longest lines and gets the widest column.
   A portrait sheet stacks them. */
.targets {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 0.85fr) minmax(0, 1.4fr) minmax(0, 0.8fr);
  grid-template-rows: auto 1fr;
  gap: 0 0.5em;
  margin: 0;
  padding: 0;
  list-style: none;

  /* On a narrow landscape sheet the title block sits under the last two columns, so the
     row has to end above it; the update body takes more of the width there. */
  @container technical-drawing (width < 47.5rem) {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 0.55fr);
  }

  @include portrait-sheet {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: none;
    row-gap: 0.5em;
  }
}

.target {
  display: grid;
  grid-row: span 2;
  grid-template-rows: subgrid;
  row-gap: 0.125em;

  @include portrait-sheet {
    grid-row: auto;
    grid-template-rows: auto auto;
  }
  min-width: 0;
  padding: 0.375em 0.5em;
  border: 1px solid var(--line-strong);
  border-radius: 0.375em;
  background: var(--surface-raised);

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    align-self: start;
    gap: 0 0.75em;
  }

  .title {
    font-family: monospace, system-ui;
    @include small-type(0.75);
    font-weight: 600;
  }

  .when,
  .source {
    @include small-type(0.625);
    color: var(--ink-muted);
  }

  pre {
    margin-top: 0.25em;
    @include small-type(0.5625);
    overflow-wrap: break-word;
  }

  /* A wrapped line hangs under its own start, so it reads as one line of SQL. */
  .line {
    display: block;
    padding-inline-start: 2ch;
    text-indent: -2ch;
  }

  &[data-target='backfill'] {
    border-style: dashed;
  }
}
</style>
