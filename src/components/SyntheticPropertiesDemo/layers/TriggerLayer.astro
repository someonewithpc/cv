---
// Where the one builder's SQL ends up, the way app/models/library_object.rb wrote it on the
// branch. The bodies are cut down to the lines that show what the builder was handed.
const targets = [
  {
    id: 'backfill',
    title: 'Backfill',
    when: 'rake data_migrations:initialize_library_object_properties_concatenated, once',
    where: '"1=1"',
    sql: [
      'INSERT IGNORE INTO library_object_synthetic_properties',
      '  (library_object_id, name, value)',
      '#{size_synthetic_property_select_sql}',
      'UNION ALL',
      '#{pax_synthetic_property_select_sql};',
    ],
  },
  {
    id: 'insert',
    title: 'trigger.after(:insert)',
    when: 'library_objects, each row',
    where: '"id = NEW.id"',
    sql: [
      'INSERT INTO library_object_synthetic_properties',
      '  (library_object_id, name, value)',
      '#{size_synthetic_property_select_sql("id = NEW.id")}',
      'UNION ALL',
      '#{pax_synthetic_property_select_sql("id = NEW.id")}',
    ],
  },
  {
    id: 'update',
    title: 'trigger.after(:update).of(:size)',
    when: 'library_objects, each row',
    where: '"id = NEW.id"',
    sql: [
      'UPDATE library_object_synthetic_properties AS lops',
      'JOIN (',
      '  #{size_synthetic_property_select_sql("id = NEW.id")}',
      ') AS temp',
      'ON lops.library_object_id = temp.library_object_id',
      '  AND lops.name = temp.name',
      'SET lops.value = temp.value',
      'WHERE lops.library_object_id = NEW.id;',
    ],
  },
  {
    id: 'delete',
    title: 'trigger.after(:delete)',
    when: 'library_objects, each row',
    where: null,
    sql: [
      'DELETE FROM library_object_synthetic_properties',
      'WHERE library_object_synthetic_properties.library_object_id = OLD.id;',
    ],
  },
];
---

<div class="wrapper">
  <div class="trigger-layer" aria-hidden="true">
    <div class="panel">
      <header>
        <strong>One Ruby method, four places its SQL runs</strong>
        <span>The backfill and the trigger bodies call the same method with a different
          <code>where</code>, so they cannot drift apart. The hairtrigger gem writes the
          triggers out as a migration.</span>
      </header>

      <div class="builder">
        <span class="caption"><code>app/models/library_object.rb</code></span>
        <pre><code><span class="k">def</span> self.size_synthetic_property_select_sql(<span class="hot">where</span> = <span class="s">"1=1"</span>)
  <span class="k">&lt;&lt;~SQL</span>.chomp
    <span class="c">-- one row per dimension: SUBSTRING_INDEX takes the head, the rest recurses</span>
    WITH RECURSIVE split_sizes AS (…)

    SELECT id AS library_object_id, 'Size (centimeters)' AS name,
      GROUP_CONCAT(CONCAT(ROUND(size, 1 - FLOOR(LOG10(size))), 'cm') SEPARATOR ' by ') AS value
    FROM split_sizes WHERE #{'#{'}<span class="hot">where</span>{'}'} AND size &lt;&gt; '' GROUP BY id

    UNION ALL
    <span class="c">-- five more of the same: meters, inches with " and with in, feet-inches with '" and with ft in</span>
  <span class="k">SQL</span>
<span class="k">end</span></code></pre>
      </div>

      <svg class="wires" viewBox="0 0 400 24" preserveAspectRatio="none">
        <path d="M200 0 V8 H100 V24" />
        <path d="M200 8 H300 V24" />
      </svg>

      <ol class="targets">
        {targets.map((target) => (
          <li class="target" data-target={target.id}>
            <span class="head">
              <span class="title">{target.title}</span>
              <span class="when">{target.when}</span>
              {target.where && (
                <span class="source"><code>where</code> = <code class="hot">{target.where}</code></span>
              )}
            </span>
            <pre><code>{target.sql.join('\n')}</code></pre>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include blueprint-wrapper;
}

.trigger-layer {
  @include sheet-type;

  box-sizing: border-box;
  width: min(100%, 54em);
}

.panel {
  @include panel;

  gap: 0.375em;
}

header {
  display: grid;
  gap: 0.125em;

  strong {
    font-size: 0.875em;
  }

  span {
    font-size: 0.6875em;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
}

code,
pre {
  font-family: monospace, system-ui;
}

pre {
  margin: 0;
  padding: 0.375em 0.5em;
  border: 1px solid var(--line);
  border-radius: 0.25em;
  background: var(--surface-sunken);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.35;
}

.builder {
  display: grid;
  gap: 0.25em;
  justify-self: center;
  width: min(100%, 46em);

  .caption {
    font-size: 0.6875em;
    color: var(--ink-muted);
  }

  pre {
    font-size: 0.625em;
  }
}

.k {
  color: var(--accent-text);
  font-weight: 600;
}

.c {
  color: var(--ink-muted);
}

.s {
  color: var(--ink-muted);
}

.hot {
  color: var(--accent-text);
  font-weight: 600;
}

.wires {
  display: block;
  width: 100%;
  height: 1.25em;
  overflow: visible;

  path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  :global([data-sheet-orientation='portrait']) & {
    display: none;
  }
}

.targets {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.5em;
  margin: 0;
  padding: 0;
  list-style: none;
}

.target {
  display: grid;
  align-content: start;
  gap: 0.125em;
  min-width: 0;
  padding: 0.375em 0.5em;
  border: 1px solid var(--line-strong);
  border-radius: 0.375em;
  background: var(--surface-raised);

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75em;
  }

  .title {
    font-family: monospace, system-ui;
    font-size: 0.75em;
    font-weight: 600;
  }

  .when,
  .source {
    font-size: 0.625em;
    color: var(--ink-muted);
  }

  pre {
    margin-top: 0.25em;
    font-size: 0.625em;
  }

  &[data-target='backfill'] {
    border-style: dashed;
  }
}
</style>
