---
import { highlightLines } from '@/highlight';
import { paxProperties, sample, searchableText, storedSizeProperties } from '../units';

// The sample object's rows in the synthetic table, and what the second trigger layer folds
// them into. The id is a placeholder.
const objectId = 1024;
const rows = [...storedSizeProperties(sample.size), ...paxProperties(sample.pax)];
const text = searchableText(rows);

// The upsert the second trigger runs, with the clause that keeps one row per object marked.
const upsert = highlightLines(`INSERT INTO library_object_properties_concatenated
  (\`library_object_id\`, \`values\`)
SELECT
    lops.library_object_id,
    GROUP_CONCAT(CONCAT(lops.\`value\`, ' ', lops.\`name\`)
      SEPARATOR ' ')
  FROM library_object_synthetic_properties lops
  WHERE lops.library_object_id = NEW.library_object_id
    AND \`lops\`.\`value\` IS NOT NULL
  GROUP BY lops.library_object_id
⟦ON DUPLICATE KEY UPDATE⟧ \`values\` = VALUES(\`values\`);`, 'sql', { inserts: { '⟦': '<span class="hot">', '⟧': '</span>' } }).join('\n');
---

<div class="wrapper synthetic-blueprint hl">
  <div class="index-layer">
    <div class="panel">
      <header>
        <strong>An object's rows joined into one string for FULLTEXT search</strong>
        <span>Triggers on <code>library_object_synthetic_properties</code> rebuild the string whenever one of the object's rows changes.</span>
      </header>

      <div class="flow">
        <div class="rows">
          <span class="caption"><code>library_object_synthetic_properties</code></span>
          <table>
            <thead>
              <tr><th scope="col">object</th><th scope="col">name</th><th scope="col">value</th></tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td class="id">{objectId}</td>
                  <td>{row.name}</td>
                  <td class="value">{row.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="upsert">
          <span class="caption"><code>app/models/library_object_synthetic_property.rb</code> · AFTER INSERT, UPDATE and DELETE, each row</span>
          <pre class="hl-box"><code set:html={upsert} /></pre>
          <span class="arrow" aria-hidden="true">↓</span>
          <span class="caption"><code>library_object_properties_concatenated.values</code> · FULLTEXT</span>
          <pre class="text">{text}</pre>
        </div>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
@use '@/scss/sheet-orientation' as *;
@use "./sheet" as *;

.wrapper {
  @include blueprint-wrapper;
}

.index-layer {
  @include sheet-type;

  box-sizing: border-box;
  width: min(100%, 52em);
}

.panel {
  @include panel;
}

header {
  display: grid;
  gap: 0.125em;

  strong {
    @include small-type(0.875);
  }

  span {
    @include small-type(0.6875);
    color: var(--ink-muted);
    text-wrap: pretty;
  }
}

code,
pre {
  font-family: monospace, system-ui;
}

.flow {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  gap: 0.75em;
  align-items: start;

  @include portrait-sheet {
    grid-template-columns: minmax(0, 1fr);
  }
}

.rows,
.upsert {
  display: grid;
  gap: 0.25em;
  min-width: 0;
}

.caption {
  @include small-type(0.625);
  color: var(--ink-muted);
  overflow-wrap: anywhere;
}

table {
  width: 100%;
  border-collapse: collapse;
  @include small-type(0.625);
}

th,
td {
  padding: 0.2em 0.4em;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: baseline;
}

thead th {
  font-weight: 600;
  color: var(--ink-muted);
  border-bottom-color: var(--line-strong);
}

td.id,
td.value {
  font-family: monospace, system-ui;
}

td.id {
  color: var(--ink-faint);
}

pre {
  margin: 0;
  padding: 0.375em 0.5em;
  border: 1px solid var(--line);
  border-radius: 0.25em;
  background: var(--surface-sunken);
  @include small-type(0.5625);
  line-height: 1.35;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

pre.text {
  border-color: var(--line-strong);
}

pre :global(.hot) {
  color: var(--hl-warm);
  font-weight: 600;

  /* The marked clause stays one colour, whatever kinds its words are. */
  :global(span) {
    color: inherit;
  }
}

.arrow {
  justify-self: center;
  line-height: 1;
  color: var(--ink-muted);
}
</style>
