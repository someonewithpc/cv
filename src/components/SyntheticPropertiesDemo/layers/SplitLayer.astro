---
import {
  matches,
  paxProperties,
  renderings,
  sample,
  sampleQueries,
  searchableText,
  sizeProperties,
  splitSizes,
  storedSizeProperties,
  walkthrough,
} from '../units';

// The page opens on the sample, rendered here so the sheet reads in full before the
// script arrives; the script rebuilds the same markup from the same functions.
const dimensions = splitSizes(sample.size);
const sizes = sizeProperties(sample.size);
const pax = paxProperties(sample.pax);
const text = searchableText([...storedSizeProperties(sample.size), ...pax]);
---

<div
  class="synthetic-demo"
  data-synthetic-demo
  data-walkthrough={JSON.stringify(walkthrough)}
>
  <div
    class="synthetic-tool"
    data-live
    data-autoplay="off"
    data-autoplay-hint-playing="the sheet types by itself"
    data-autoplay-caption-user="PAUSED"
    data-autoplay-hint-user="press play to go on"
    tabindex="-1"
  >
    <header class="lede">
      <strong>One table's size, split, converted and searched</strong>
      <p>
        The table's size is stored as <code>{sample.size}</code>, in centimetres. When the
        row is saved, triggers split it on <code>x</code>, write each piece in centimetres,
        metres, inches and feet, and store every form in the text that search reads.
      </p>
    </header>
    <p class="inert-note">The walkthrough types in these fields. They don't take your own typing.</p>

    <ol class="stages">
      <li class="stage source">
        <span class="stage-label"><span class="step">1</span> Stored <code>library_objects</code></span>
        <div class="fields">
          <label class="field size-field">
            <span class="field-name"><code>size</code></span>
            <input
              class="size-input"
              type="text"
              value={sample.size}
              readonly
              tabindex="-1"
              spellcheck="false"
              autocomplete="off"
              aria-label="Size, in centimetres, dimensions split by x"
            />
          </label>
          <label class="field pax-field">
            <span class="field-name"><code>pax</code></span>
            <input
              class="pax-input"
              type="text"
              inputmode="numeric"
              value={sample.pax}
              readonly
              tabindex="-1"
              spellcheck="false"
              autocomplete="off"
              aria-label="Seats"
            />
          </label>
        </div>
        <span class="split-label">split on <code>x</code>, one row per dimension</span>
        <ol class="chips" aria-label="Dimensions">
          {dimensions.map((dimension, index) => (
            <li class:list={['chip', { invalid: dimension.cm === null }]} data-dim={index} style={{ '--i': index }}>
              {dimension.raw}
            </li>
          ))}
        </ol>
      </li>

      <li class="stage render">
        <span class="stage-label"><span class="step">2</span> Converted <code>library_object_synthetic_properties</code></span>
        <ul class="renderings">
          {sizes.map((property, row) => (
            <li class="rendering" data-unit={renderings[row].id} style={{ '--row': row }}>
              <span class="name" title={property.name}>{renderings[row].short}</span>
              <span class="value">
                {property.pieces.map((piece, index) => (
                  <Fragment>
                    {index > 0 && <span class="by"> by </span>}
                    <span class="piece" data-dim={index} style={{ '--i': index }}>{piece}</span>
                  </Fragment>
                ))}
              </span>
            </li>
          ))}
          {pax.map((property, row) => (
            <li class="rendering pax" style={{ '--row': sizes.length + row }}>
              <span class="name">{property.name}</span>
              <span class="value"><span class="piece">{property.value}</span></span>
            </li>
          ))}
        </ul>
      </li>

      <li class="stage search">
        <span class="stage-label"><span class="step">3</span> Searched <code>library_object_properties_concatenated</code></span>
        <label class="field query-field">
          <span class="field-name">search</span>
          <input
            class="query-input"
            type="search"
            readonly
            tabindex="-1"
            spellcheck="false"
            autocomplete="off"
            aria-label="Search the text"
          />
          <span class="query-result" aria-live="polite"></span>
        </label>
        <div class="text-row">
          <span class="row-head">
            <span class="row-name">this table's search text</span>
            <span class="row-verdict"></span>
          </span>
          <pre class="text">{text}</pre>
        </div>
        <ul class="queries" aria-label="Other searches against this text">
          {sampleQueries.map((query) => {
            const hit = matches(text, query);
            return (
              <li class="query" data-query={query} data-hit={String(hit)}>
                <span class="query-text">{query}</span>
                <span class="verdict">{hit ? '✓ found' : '✗ no match'}</span>
              </li>
            );
          })}
        </ul>
      </li>
    </ol>
  </div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-synthetic-demo]', boot);
</script>

<style lang="scss">
@use "./sheet" as *;

/* The tool fills the sheet inside the shared --demo-inset (Page.astro), under the title
   block. The 2px keeps the frame line clear. */
:global(article.technical-drawing-stack > * > section .content:has(.synthetic-demo)) {
  --demo-pad: calc(2px + var(--demo-inset, 0px));

  place-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: var(--demo-pad);
}

.synthetic-demo {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.synthetic-tool {
  @include sheet-type(0.03, 0.031);

  --gutter: 1em;

  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 0.75em;
  padding: 0.875em var(--gutter);
  /* The title block lies over the tool's bottom-right corner, so the stages scroll on past
     it by the block's height and the last line can be read clear of it. */
  padding-bottom: calc(var(--gutter) + var(--title-block-block, 0px));
  border: 1px solid var(--line-strong);
  border-radius: 0.5em;
  background: var(--surface-raised);
  outline: none;

  :global([data-sheet-orientation='portrait']) & {
    --gutter: 0.75em;

    gap: 0.5em;
    padding-top: 0.625em;
  }

  /* Portrait gives the title block a row of its own. */
  @container technical-drawing (orientation: portrait) {
    padding-bottom: var(--gutter);
  }
}

code,
pre,
input {
  font-family: monospace, system-ui;
}

.lede {
  display: grid;
  gap: 0.25em;
  text-wrap: pretty;

  strong {
    font-size: 1.125em;
    line-height: 1.2;
  }

  p {
    margin: 0;
    font-size: max(0.5rem, 0.8125em);
    line-height: 1.4;
    color: var(--ink-muted);
  }

  code {
    color: var(--ink);
  }
}

/* The three stages read left to right, an arrow in each gap; a portrait sheet stacks
   them and the arrows point down. */
.stages {
  --stage-gap: 1.75em;

  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1.2fr);
  gap: var(--stage-gap);
  margin: 0;
  padding: 0;
  list-style: none;
  counter-reset: stage;

  :global([data-sheet-orientation='portrait']) & {
    --stage-gap: 1.25em;

    grid-template-columns: minmax(0, 1fr);
  }
}

.stage {
  position: relative;
  display: grid;
  align-content: start;
  gap: 0.375em;
  min-width: 0;

  & + &::before {
    content: '→';
    position: absolute;
    top: 0.75em;
    left: calc(-1 * var(--stage-gap));
    width: var(--stage-gap);
    text-align: center;
    font-size: 1.125em;
    line-height: 1;
    color: var(--ink-faint);

    :global([data-sheet-orientation='portrait']) & {
      content: '↓';
      top: calc(-1 * var(--stage-gap));
      left: 0;
      width: auto;
      height: var(--stage-gap);
      line-height: var(--stage-gap);
      padding-left: 0.75em;
    }
  }
}

.stage-label {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: baseline;
  column-gap: 0.375em;
  font-size: max(0.5rem, 0.75em);
  font-weight: 600;
  line-height: 1.3;

  /* The table the stage writes to, on its own line under the word. */
  code {
    grid-column: 2;
    font-weight: 400;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

.step {
  grid-row: 1 / span 2;
  align-self: start;
  display: inline-grid;
  place-items: center;
  width: 1.5em;
  height: 1.5em;
  border-radius: 50%;
  background: var(--accent);
  color: var(--surface-page);
  font-size: max(0.5rem, 0.875em);
  line-height: 1;
}

.split-label {
  font-size: max(0.5rem, 0.6875em);
  color: var(--ink-muted);

  /* A phone-height sheet has no room for the asides. */
  :global([data-sheet-orientation='portrait']) & {
    display: none;
  }
}

.fields {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 5em;
  gap: 0.5em;
}

.field {
  display: flex;
  align-items: center;
  gap: 0.375em;
  min-width: 0;

  input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    padding: 0.25em 0.4em;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--surface-page);
    color: var(--ink);
    font-size: 1em;

    /* Read-only: no caret and no text cursor, so nothing offers to take typing. */
    caret-color: transparent;
    cursor: default;

    &::placeholder {
      color: var(--ink-faint);
    }
  }
}

.inert-note {
  margin: 0;
  font-size: max(0.5rem, 0.75em);
  color: var(--ink-muted);

  /* A click on a field flashes the line that says it takes no typing. */
  &:global(.nudge) {
    animation: nudge 1.2s ease-out;
  }
}

@keyframes nudge {
  from {
    color: var(--accent-text);
  }
}

/* The walkthrough's hand, drawn as the other demos draw it and placed by translate alone:
   cursorMotion.ts animates each hop and folds the arrow's tip into every keyframe. */
.synthetic-tool :global(.demo-cursor) {
  position: absolute;
  z-index: 3;
  top: 0;
  left: 0;
  width: 2em;
  height: 2em;
  transform-origin: 12% 8%;
  pointer-events: none;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><path d="M4 2.5v24.2l6.4-6.2 4.1 9.7 4.2-1.8-4.1-9.6H26z" fill="%23fff" stroke="%23222" stroke-width="1.6" stroke-linejoin="round"/></svg>') center / contain no-repeat;
  filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.25));
  transition:
    opacity 0.32s ease,
    scale 0.12s ease;

  &[hidden] {
    display: none;
  }
}

.synthetic-tool :global(.demo-cursor--fading) {
  opacity: 0;
}

.field-name {
  flex: none;
  font-size: max(0.5rem, 0.75em);
  color: var(--ink-muted);
}

/* The field the walkthrough is typing into. */
.synthetic-tool[data-autoplay='playing'] input.typing {
  outline: 2px dashed var(--accent);
  outline-offset: 1px;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375em;
  min-height: 1.6em;
  margin: 0;
  padding: 0;
  list-style: none;

  :global([data-sheet-orientation='portrait']) & {
    display: none;
  }
}

.chip {
  padding: 0.125em 0.5em;
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  background: var(--surface-sunken);
  font-family: monospace, system-ui;
  cursor: default;

  &.invalid {
    border-style: dashed;
    color: var(--ink-faint);
    text-decoration: line-through;
  }
}

.renderings {
  display: grid;
  gap: 0.125em;
  margin: 0;
  padding: 0;
  list-style: none;
}

.rendering {
  display: grid;
  grid-template-columns: 3.25em minmax(0, 1fr);
  gap: 0.5em;
  align-items: baseline;
  padding: 0.125em 0.375em;
  border-radius: 2px;
  background: var(--surface-sunken);

  .name {
    font-size: max(0.5rem, 0.6875em);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .value {
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.875em);
    overflow-wrap: anywhere;
  }

  .by {
    color: var(--ink-faint);
  }

  &.pax {
    .name {
      font-family: monospace, system-ui;
    }
  }

  /* A hairline between the size rows and the seat rows. */
  &.pax:first-of-type,
  &:not(.pax) + &.pax {
    margin-top: 0.25em;
  }
}

.piece {
  display: inline-block;
  transition: color 0.15s ease;
}

/* Pointing at a chip lights the pieces it fanned out into. */
.synthetic-tool[data-dim-hover='0'] .piece[data-dim='0'],
.synthetic-tool[data-dim-hover='1'] .piece[data-dim='1'],
.synthetic-tool[data-dim-hover='2'] .piece[data-dim='2'],
.synthetic-tool[data-dim-hover='3'] .piece[data-dim='3'] {
  color: var(--accent);
  font-weight: 600;
}

.query-field input {
  font-size: 1.0625em;
}

/* The object's row in the searchable table, and what the current search made of it. A hit
   draws it solid in the accent with the match marked; a miss draws it dashed and faded,
   with the query named in the corner, so the two read apart at a glance. */
.text-row {
  display: grid;
  border: 1px solid var(--line);
  border-radius: 0.375em;
  background: var(--surface-sunken);
  overflow: hidden;

  &[data-hit='true'] {
    border-color: var(--accent);
    box-shadow: inset 0.25em 0 0 var(--accent);
  }

  &[data-hit='false'] {
    border-style: dashed;
    border-color: var(--ink-muted);

    .text {
      color: var(--ink-faint);
    }
  }
}

.row-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.25em 0.75em;
  padding: 0.25em 0.625em;
  border-bottom: 1px solid var(--line);
  font-size: max(0.5rem, 0.6875em);
  color: var(--ink-muted);
}

.row-verdict {
  font-weight: 600;

  [data-hit='true'] > .row-head > & {
    color: var(--accent-text);
  }

  [data-hit='false'] > .row-head > & {
    color: var(--ink);
  }
}

.text {
  margin: 0;
  padding: 0.5em 0.625em;
  font-size: max(0.5rem, 0.6875em);
  line-height: 1.45;
  white-space: pre-wrap;
  overflow-wrap: anywhere;

  :global([data-sheet-orientation='portrait']) & {
    font-size: max(0.5rem, 0.625em);
  }

  /* A tint of the accent rather than --accent-muted, which is a light fill on the dark
     themes and takes the light text with it. */
  :global(mark) {
    background: color-mix(in oklch, var(--accent) 30%, transparent);
    color: inherit;
    border-radius: 2px;
    outline: 1px solid var(--accent);
  }
}

/* The sample searches, each asked of the same row: a hit is filled and solid, a miss is
   dashed and faded, and both say which in words. */
.queries {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375em;
  margin: 0;
  padding: 0;
  list-style: none;
}

.query {
  display: inline-flex;
  align-items: baseline;
  gap: 0.5em;
  padding: 0.125em 0.5em;
  border: 1px solid var(--line);
  border-radius: 2px;
  font-size: max(0.5rem, 0.8125em);

  .query-text {
    font-family: monospace, system-ui;
  }

  .verdict {
    font-size: max(0.5rem, 0.8em);
    white-space: nowrap;
  }

  &[data-hit='true'] {
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 18%, transparent);
    color: var(--ink);

    .verdict {
      color: var(--accent-text);
      font-weight: 600;
    }
  }

  &[data-hit='false'] {
    border-style: dashed;
    border-color: var(--ink-faint);
    color: var(--ink-muted);
  }
}

.query-result {
  flex: none;
  min-width: 5.5em;
  font-size: max(0.5rem, 0.75em);
  font-weight: 600;
  white-space: nowrap;

  &[data-hit='true'] {
    color: var(--accent-text);
  }

  &[data-hit='false'] {
    color: var(--ink);
  }
}

/* A run of the pipeline: the chips drop in one after another, each rendering fans out
   behind them a row at a time, and the text flashes as it takes the new values. */
.synthetic-tool.running {
  .chip {
    animation: chip-in 0.3s calc(var(--i) * 80ms) both cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rendering .piece {
    animation: piece-in 0.35s calc(240ms + var(--row) * 50ms + var(--i, 0) * 70ms) both ease-out;
  }

  .text {
    animation: text-flash 0.9s 700ms both ease-out;
  }
}

@keyframes chip-in {
  from {
    opacity: 0;
    translate: 0 -0.5em;
  }
}

@keyframes piece-in {
  from {
    opacity: 0;
    translate: -0.75em 0;
  }
}

@keyframes text-flash {
  from {
    background: var(--accent-muted);
  }
}

@media (prefers-reduced-motion: reduce) {
  .synthetic-tool.running {
    .chip,
    .rendering .piece,
    .text {
      animation: none;
    }
  }

  .piece {
    transition: none;
  }

  .inert-note:global(.nudge) {
    animation: none;
  }
}
</style>
