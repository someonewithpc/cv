---
import { feetAndInches, renderDimension, renderings } from '../units';

// Two of the sample's dimensions, and one chosen for its carry: 182.5cm is 71.85in, five
// feet and 11.85in, and the 11.85 rounds up into a sixth foot.
const columns = [160, 80, 182.5];
const carry = 182.5;
const carried = feetAndInches(carry);
const carryInches = carry / 2.54;
const wholeFeet = Math.floor(carryInches / 12);
const rest = carryInches - wholeFeet * 12;

// The rule each rendering applies to one row of split_sizes, as SQL would say it.
const rules: Record<(typeof renderings)[number]['id'], string> = {
  cm: 'ROUND(cm)',
  m: 'ROUND(cm / 100, 2)',
  'in-mark': 'ROUND(cm / 2.54)',
  in: 'ROUND(cm / 2.54)',
  'ft-mark': 'FLOOR, then ROUND the rest',
  'ft-in': 'FLOOR, then ROUND the rest',
};
const feet = new Set(['ft-mark', 'ft-in']);
---

<div class="wrapper">
  <div class="render-layer" aria-hidden="true">
    <div class="panel">
      <header>
        <strong>One size, six ways to write it</strong>
        <span>Every row of <code>split_sizes</code> renders six times; each rendering is
          <code>GROUP_CONCAT</code>ed back with <code>' by '</code> and the six are
          <code>UNION ALL</code>ed</span>
      </header>

      <table>
        <thead>
          <tr>
            <th scope="col">Rendering</th>
            {columns.map((cm) => <th scope="col" class="num">{cm}</th>)}
          </tr>
        </thead>
        <tbody>
          {renderings.map((rendering) => (
            <tr>
              <th scope="row">
                <span class="name">{rendering.name}</span>
                <code class="rule">{rules[rendering.id]}</code>
              </th>
              {columns.map((cm) => (
                <td class:list={['num', { carry: cm === carry && feet.has(rendering.id) }]}>
                  {renderDimension(cm, rendering.id)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>

      <p class="note">
        <span class="swatch" aria-hidden="true"></span>
        <span>
          {carry}cm is {carryInches.toFixed(2)}in: {wholeFeet}ft and {rest.toFixed(2)}in left.
          The rest rounds to 12, so it carries: <code>{carried.feet}ft{carried.inches}in</code>, never
          <code>{wholeFeet}ft12in</code>
        </span>
      </p>
    </div>
  </div>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include blueprint-wrapper;
}

.render-layer {
  @include sheet-type;

  box-sizing: border-box;
  width: min(100%, 40em);
}

.panel {
  @include panel;
}

header {
  display: grid;
  gap: 0.125em;

  strong {
    font-size: 0.875em;
  }

  span {
    font-size: 0.6875em;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
}

code {
  font-family: monospace, system-ui;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.75em;
}

th,
td {
  padding: 0.25em 0.5em;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: baseline;
}

thead th {
  font-weight: 600;
  color: var(--ink-muted);
  border-bottom-color: var(--line-strong);
}

tbody th {
  font-weight: 400;

  .name {
    display: block;
  }

  .rule {
    display: block;
    font-size: 0.8125em;
    color: var(--ink-faint);
  }
}

.num {
  font-family: monospace, system-ui;
  text-align: right;
  white-space: nowrap;
}

td.carry {
  background: var(--accent-muted);
  outline: 1px solid var(--accent);
  outline-offset: -1px;
}

.note {
  display: flex;
  gap: 0.5em;
  align-items: baseline;
  margin: 0;
  font-size: 0.6875em;
  line-height: 1.35;
  color: var(--ink-muted);
  text-wrap: pretty;
}

.swatch {
  flex: none;
  width: 0.75em;
  height: 0.75em;
  background: var(--accent-muted);
  outline: 1px solid var(--accent);
}
</style>
