{/* src/middleware.ts swaps "next" for this note's paper, in page order. */}
<aside class="marker-font" data-paper="next" style={{ '--background': Astro.props.background, '--color': Astro.props.color }}>
  {Astro.props.title && <h3>{Astro.props.title}</h3>}
  <slot />
</aside>

<style lang="scss">
aside {
  color-scheme: only light;

  /* The open note dialog (TechnicalDrawing/Page.astro) hands down its own
     measure and type size; anywhere else the narrow marker column applies. */
  max-width: var(--note-width, min(16ch, 100%));
  position: relative;
  padding: 0.75em 1em;
  border-radius: 0 0 0 2em/3em;
  box-shadow:
    0 0.25em 0.375em 0.25em rgba(0,0,0,0.2);
  background: var(--background);
  color: var(--color);

  line-height: 1.25rem;
  font-size: var(--note-font-size, 1.2rem);
  text-wrap: pretty;

  @container technical-drawing (orientation: portrait) {
    font-size: var(--note-font-size, clamp(0.85rem, 3.8cqw, 1.1rem));
    line-height: 1.2;
    /* Clears the peeled corner, which sits 1.5em tall in the bottom left and
       otherwise eats the start of the last line. */
    padding: 0.55em 0.7em 1.6em;
  }

  h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5em;
  }

  &:before,
  &:after {
    content: "";
    display: block;
    position: absolute;
    pointer-events: none;
  }

  /* The peel stays inside the note's own box: the mask cuts the curl's
