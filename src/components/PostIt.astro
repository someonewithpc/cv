  &[data-paper='taped'] {
    border-radius: 0.125em;
    rotate: 1deg;

    &:before {
      top: -0.5em;
      left: 50%;
      width: 4.5em;
      height: 1.125em;
      translate: -50% 0;
      rotate: -3deg;
      background:
