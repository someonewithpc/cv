---
import flipHint from './assets/flip-hint.svg?raw';

import { deterministicId } from '@/server/deterministicId';

export type Props = {
  /** Tag name for the stack wrapper element. */
  as?: string;
  class?: string;
  /** Number of pages; the default slot is called as a function once per index. */
  pageCount: number;
  /** Accessible name of the stack. */
  label?: string;
};

const { as: tagName = 'div', class: className, pageCount, label } = Astro.props;
const Tag = tagName;

// One pair of gradients per stack: a page carries its clip wherever the stack goes, and a
// shared id would leave every clip painted from the first stack's gradient. Named from the
// stack's own accessible name and page count, both fixed for a given stack, so the id (and
// the document's hashes) are the same on every build (#220 C66).
const clipId = deterministicId(label ?? 'stack', pageCount);

// One gem-clip wire, split at the top bend into its two physical layers. The wire leans with
// the resting fold-back crease — its outer-right edge runs along that crease, bottoming out at
// the pin (see --fold-pin-x/-y below) — so the whole body sits inside the corner region a flip
// folds behind the stack: the wrappers' crease cut (see their clip-path below) swallows the
// wire together with the corner, the clip vanishing with the paper it sits on. The "under"
// path's far half is the back bar, hidden by the page itself (it renders beneath the page
// content — see the template), so only the bend peeks past the page edge the lean points it
// at, reading as a clip slid all the way on. The "over" path is the front bar pressing on the
// page.
const clipGradient = (id: string) => `<defs>
    <linearGradient id="${id}" x1="0" y1="0" x2="28" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#f2f4f7" />
      <stop offset="40%" stop-color="#aeb4bd" />
      <stop offset="60%" stop-color="#7c828d" />
      <stop offset="100%" stop-color="#d8dbe0" />
    </linearGradient>
  </defs>`;

const paperClipUnder = `<div class="paper-clip-under"><svg aria-hidden="true" focusable="false" viewBox="0 0 28 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path
    d="M5 22 V50 a9 9 0 0 0 18 0 V14 a6.25 6.25 0 0 0 -12.5 0"
    stroke="url(#paper-clip-under-gradient-${clipId})"
    stroke-width="3"
    stroke-linecap="round"
  />
  ${clipGradient(`paper-clip-under-gradient-${clipId}`)}
</svg></div>`;

const paperClipOver = `<svg aria-hidden="true" focusable="false" viewBox="0 0 28 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path
    d="M10.5 14 V44 a4 4 0 0 0 8 0 V22"
    stroke="url(#paper-clip-over-gradient-${clipId})"
    stroke-width="3"
    stroke-linecap="round"
  />
  ${clipGradient(`paper-clip-over-gradient-${clipId}`)}
</svg>`;

// The fold flap, paper clip, back-grab handle, and flip hint are siblings of the page content,
// not children: the page's crease clip-path (and the page's own overflow) clips descendants,
// and these elements must be able to overhang the page — the flap when a large fold wraps past
// an edge, the clip because its bend wraps over the page's top edge. Order matters: the flap
// comes after the clip so the folded-over paper covers its wire when dragged across it, and the
// hint rides above everything. (The wire's back bar is separate — prepended before the page
// content in the template so the page itself hides it.)
const foldFront = `<div class="paper-clip">${paperClipOver}</div><div class="paper-fold"></div><div class="paper-back-grab"></div>${flipHint}`;

// Each page stays the SlotString the render returned. Its hoisted scripts ride in a property
// of that object, replayed only when it reaches the output whole; a concatenation or template
// literal keeps the markup and drops the scripts, which is how every slotted component lost
// its <script> for a while.
const pages = await Promise.all(
  Array.from({ length: pageCount }, (_, index) => Astro.slots.render('default', [index])),
);
---

<!-- The status beside the stack is what a screen reader hears once a turn has settled
     (announceFront in fold-drag.ts). It is a sibling, not a child: every child of the stack is a
     page. -->
<Tag
  data-paper-stack-root
  data-paper-stack
  class={className}
  data-page-count={pageCount}
  style={`--page-count: ${pageCount}`}
  role={tagName === 'article' ? undefined : 'group'}
  aria-label={label}
>
  {pages.map((page, index) => (
    <div class={index === 0 ? 'paper-front' : undefined} style={`--page-index: ${index + 1}`}>{index === 0 && <Fragment set:html={paperClipUnder} />}{page}{index === 0 && <Fragment set:html={foldFront} />}</div>
  ))}
</Tag>
<div class="sr-only" role="status" data-paper-status></div>

<style lang="scss" is:global>
@use 'sass:math';
@use '@/scss/technical-drawing' as drawing;
@use '@/scss/colors' as colors;

// The stack's custom properties, typed so they transition and animate. At the top level of the
// sheet, where Sass leaves them alone: nested in a selector, it would bubble each one out into
// an invalid rule.
//
// Everything registered not inherited moves: --fold-x/-y on every frame of a drag, the rest over
// a turn or a resize. An inherited property that moves makes the browser re-resolve the style of
// every element below it, and below a page wrapper is everything printed on the page, some two
// thousand elements, so a turn restyled the stack several times over. Not inherited, a change
// reaches only the elements below that say `inherit` for it: the page content, the flap, the clip
// wrappers, the grab handle, and the band and strip pseudo-elements. Each of those reads it one
// level below where it is written, and nothing deeper reads any of them.
@each $name in
  fold-x, fold-y, fold-back-x, fold-back-y, fold-page-w, fold-page-h,
  // The pile's reach, transitioned on the stack so the strip behind the crease climbs with it.
  pile-rise, pile-drift,
  // A turned page's own step out, transitioned on the page so its cut, band and translate climb
  // together.
  turned-drift, turned-rise,
  // The crease intercepts the page content derives from --fold-x/-y for its clip-path.
  crease-excess-x, crease-excess-y, crease1-x, crease1-y, crease2-x, crease2-y,
  // A landing's second crease, written on the flap by renderLanding and read there alone.
  land-x, land-y
{
  @property --#{$name} {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
}

// The resting crease and the pin follow the sheet's width (Stack.astro's --paper-clip-reach), so
// inherited they re-resolved on every element under the stack at each resize step: most of a
// step's layout. The page, its pile strip, the clip and its wire read them and say so.
@each $name in fold-back-rest-x, fold-back-rest-y, fold-pin-x, fold-pin-y {
  @property --#{$name} {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
}

@each $name in pile-lean, paper-peek {
  @property --#{$name} {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
}

@property --page-index {
  syntax: '<number>';
  inherits: false;
  initial-value: 1;
}

@each $name in
  flip-progress, pages-turned,
  // What the stack and the pages derive from the count and the index.
  pile-arc, pile-arc-under, turned-rank, turned, turned-arc
{
  @property --#{$name} {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
}

// The strip's turn clock (see --pile-rise below): at rest by default.
@property --turn-ease {
  syntax: '<number>';
  inherits: false;
  initial-value: 1;
}

// The pile's paper, set on the stack by syncPileSurface and unset while nothing is turned, where
// the strip falls back to the front page's own. No initial value, so unset it stays invalid and
// the fallback applies.
@property --pile-paper {
  syntax: '*';
  inherits: false;
}

// restIdleFold's switch for the pulse layers, set on the sheet and read one level down (by the
// clip's shadow two, through the clip): not inherited, so setting it restyles those and not the
// page's content.
// The sheet takes it from the stack otherwise, where it keeps the pulse off until the reveal
// has run (releasePulse in fold-drag.ts).
@property --fold-pulse {
  syntax: '*';
  inherits: false;
}

// The reveal's go-ahead (see watchStackReveal in fold-drag.ts), set once on the stack and read by
// its pages alone.
@property --fold-reveal {
  syntax: '*';
  inherits: false;
}

// How far the flap is off the page, typed so its tone eases between rest, in hand and past the
// commit point. Set on the flap and the cast shadow themselves, so nothing inherits it while it
// eases.
@property --fold-lift {
  syntax: '<number>';
  inherits: false;
  initial-value: 0;
}

// How far the resting dog-ear's pulse grows it (see fold-pulse-keyframes below).
$fold-pulse-x: 3cm;
$fold-pulse-y: 2cm;

// CSS's ease-in-out, cubic-bezier(0.42, 0, 0.58, 1), at progress $s: the curve's x solved for
// its parameter by halving, then its y there.
@function ease-in-out($s) {
  $lo: 0;
  $hi: 1;
  $t: $s;
  @for $_ from 1 through 32 {
    $t: ($lo + $hi) * 0.5;
    $x: 3 * (1 - $t) * (1 - $t) * $t * 0.42 + 3 * (1 - $t) * $t * $t * 0.58 + $t * $t * $t;
    @if $x < $s {
      $lo: $t;
    } @else {
      $hi: $t;
    }
  }
  @return 3 * (1 - $t) * $t * $t + $t * $t * $t;
}

[data-paper-stack-root] {
  anchor-name: --technical-drawing-stack;
  anchor-scope: --technical-drawing-stack;

  &[data-paper-stack] {
    // No dog-ear pulse until the reveal has run: fold-drag.ts clears this when it ends
    // (watchStackReveal), and the front page's pulse layers come into being then (see
    // initial-fold-reveal below).
    --fold-pulse: none;

    // The stack's own box is an upright rectangle around the whole fan, including the
    // margin reserved for the splay, so a ring on it misses the sheet the reader is
    // looking at. Put it on the front sheet instead: it turns with the splay, and
    // fold-drag.ts hands the paper-front class to the next page on a committed flip,
    // so the ring follows the paper.
    //
    // The sheet rather than its wrapper, and inside its edge rather than outside it,
    // because the sheet is what wears the crease clip-path: an outline drawn within
    // the clipped box is cut by that same path, so the ring bends around the folded
    // corner instead of crossing it, and it keeps doing that through a drag for free,
    // frame by frame, with no second element and no filter.
    //
    // The fold flap is in for the same reason: it is clipped to the folded-over corner,
    // so the ring runs along the dog-ear's own two edges and stops at the crease, and
    // the paper ends up ringed the way it is drawn. The clip, grab handle and hint stay
    // out: they ride on top of the page rather than being the page.
    &:focus-visible {
      outline: none;

      > .paper-front > :not(.paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
        outline: 2px solid var(--ink);
        outline-offset: -0.125rem;
      }
    }

    display: grid;
    grid-template-areas: "content";

    // A sideways swipe over the stack turns its pages (fold-drag.ts), so the browser mustn't
    // spend it panning. Vertical is left to the browser: the page still scrolls under a finger
    // that means to scroll, and it takes the gesture back the moment it decides that's what is
    // happening. Which is only half the bargain — this is settled the instant a finger lands,
    // before anyone knows what the finger is for, so a finger that turns out to be working the
    // paper would scroll the page out from under itself. fold-drag.ts cancels the touch moves of
    // any finger a gesture has claimed, which is what actually holds the page still.
    touch-action: pan-y;

    $per-page-splay: 1.5deg;
    $border-radius: calc(0.5em + 1px);

    // The one light in the drawing: what a fold shows is the sheet's back lit flat where it
    // lies down, in shadow where it curls up out of the crease, and casting a shadow on the
    // page under it beside the crease. Both the flap and the cast shadow measure their
    // gradients from the page's bottom-right corner along the crease's normal, where the
    // crease itself lies --flap-crease in (fold-x·sin a, a being the crease's angle). The
    // shade widens with the fold: a resting dog-ear casts a sliver, a sheet lifted across
    // the page a broad soft band, capped so a page-sized fold does not go grey to the middle.
    // max() keeps atan2 off (0, 0) during the reveal's delay, where the fold is 0 by 0.
    // Computed on each element that shades from them, not on the sheet: a custom property
    // set there is inherited, and one that moves every drag frame would restyle everything
    // printed on the page.
    @mixin fold-crease {
      --flap-angle: atan2(var(--fold-y), max(var(--fold-x), 1px));
      --flap-crease: calc(var(--fold-x) * sin(var(--flap-angle)));
      --fold-shade-w: clamp(0.5em, var(--flap-crease) * 0.6, 5em);
    }

    // How far the flap is off the page: 0 lying flat, 1 in hand (hovered or dragged, and the
    // outgoing sheet's flap folding away after a flip), 2 past the commit point. The flap
    // brightens and its cast shadow deepens with it, in place of the brightness and
    // drop-shadow filters this used to run through, which re-filtered a page-sized layer on
    // every frame of a drag. Declared and eased on the two elements that read it, keyed on
    // the paper-in-hand and paper-will-commit classes fold-drag.ts puts on the sheet: a
    // :has() on the flap's state would restyle the whole document at every hover and grab.
    @mixin fold-lift {
      --fold-lift: 0;
      transition: --fold-lift 200ms ease-out;

      @media (prefers-reduced-motion: reduce) {
        transition-duration: 0s;
      }
    }

    // How big the dog-ear sits when nothing is touching it: where the opening reveal lands and
    // where the pulse starts and returns (see the keyframes below). Published as custom
    // properties because the crease it draws — from (100% - x, 100%) to (100%, 100% - y) on the
    // front page — is what anything pointing at the fold from outside the stack has to aim at.
    // The size itself lives in scss/_technical-drawing.scss, shared with the frame's own
    // declaration in TechnicalDrawing/Stack.astro so the two cannot drift apart.
    --fold-rest-x: #{drawing.$fold-rest-x};
    --fold-rest-y: #{drawing.$fold-rest-y};

    // The folded-back corner's resting crease runs along the paper clip wire's outer-left
    // edge: intercepts (2.25em, 4.5em) by default, a 1-in-2 lean. The pin — where the wire's
    // edge bottoms out on that crease, halfway along — is where the paper is held: the splay
    // pivots around it, and the fold's crease can approach it but never cross it (see
    // fold-drag.ts).
    //
    // The lean is the one knob here, and everything downstream is derived from it rather than
    // written out again: the pin below, the wire's own angle and which edge it slides on (see
    // the svg rule), the corner cut every page wears, and — in fold-drag.ts, which reads these
    // back — the fully-folded seed a flip lands on and the direction a back-drag pulls. A stack
    // whose pages are tall can lay the clip flatter by swapping the two, which transposes the
    // whole arrangement; the default suits a page wider than it is tall.
    --fold-back-rest-x: var(--paper-clip-lean-x, 2.25em);
    --fold-back-rest-y: var(--paper-clip-lean-y, 4.5em);
    --fold-pin-x: calc(var(--fold-back-rest-x) / 2);
    --fold-pin-y: calc(var(--fold-back-rest-y) / 2);

    // The initial value its @property rule gives it as well, spelled out for a browser that
    // does not register it: there var(--flip-progress) would be undefined, which invalidates the
    // pages' rotate below at computed-value time. rotate: none doesn't just drop the splay — it stops each page
    // from being the containing block for its absolutely-positioned clip wrappers, flashing
    // the paper clip at the viewport's top-left corner while the page loads.
    --flip-progress: 0;

    // How many pages have been turned, counted onto the stack by fold-drag.ts. Same reason for
    // the fallback as above: every page's rotate reads it.
    --pages-turned: 0;

    // The folded-back top-left corner's size, inherited by every page's clip-path so the whole
    // stack's corner folds behind as one; transitioning it here is what eases the resting size
    // and the proximity tease in and out.
    transition:
      --fold-back-x 300ms ease-out, --fold-back-y 300ms ease-out,
      --turn-ease 250ms ease-in-out;

    @media (prefers-reduced-motion: reduce) {
      transition-duration: 0s;
    }

    // The fan pivots every page about the pin near the top-left, so the hindmost sheet — turned
    // the furthest, by the same $per-page-splay·log(n) the pages' rotate below uses — drops
    // below the front page's bottom edge by its own width times the sine of that turn. A
    // rotation is invisible to layout, so the stack's box stops at the front page and whatever
    // follows rides up under the fan, however much gap it was given: at three demos a page wide,
    // a 4em row-gap was showing as a few pixels. Reserve the drop here, where the splay is
    // decided, so every stack pays for its own fan and the gap around one means what it says.
    // 100cqw is the *frame's* width — an element never queries a container it declares itself,
    // and the stack declares `technical-drawing` — which is the stack's own width, since it
    // spans the frame.
    margin-bottom: calc(100cqw * sin(#{$per-page-splay} * log(var(--page-count))));

    // The pile of pages already turned. The pages still to come fan out below the front one,
    // which is what says there is more underneath; the ones already turned had nothing saying
    // they were still there, since a flip drops them into that same fan, at the back of it. So
    // they leave it: a turned page rises out of the stack's top edge instead, the way it went
    // over the clip, one step further for each page turned before it. What is left to read
    // stands below, what has been read stands above, and the two piles never share an edge — the
    // top edge is also the one side free of the dog-ear, the clip and the title block.
    //
    // The pile steps out on the same law the fan below splays on: a log of the rank, so each
    // page adds less than the one before and the corners bend over instead of running off in a
    // straight line. $turn-lift is how far the first page turned rises, $turn-splay how far it
    // leans on the pin, and $turn-drift how far it slides back towards the clip. The drift is
    // the one term that stays even with the rank, which is what bows the corner column: the
    // pages spread sideways at a steady rate while their rise closes up. $turn-under is how far
    // the band of sheet back reaches down behind the front page, so it never ends in mid-air.
    $turn-lift: 0.5em;
    $turn-splay: 0.5deg;
    $turn-drift: 0.125em;
    $turn-under: 0.75em;

    // Where the page turned most recently stands — the furthest page of the pile, rank
    // --pages-turned — on the same law the pages below apply to their own rank: how far it has
    // risen, slid back and leaned. The strip behind the front page's crease reaches up to that
    // page's crease (see .paper-front::before), so while a page is on its way there the strip
    // has to follow the page, not the number: a page turned forward climbs from the front crease
    // to its place at the top of the pile, and until it has passed the page turned before it
    // the strip ends on that one's crease. --turn-ease runs 0 to 1 over the turn (fold-drag.ts
    // resets it at each restack; the page's own --turned-rise eases on the same clock), so the
    // furthest crease is the higher of the two. Easing these three between the two resting
    // positions instead left the strip's tip standing up to 3px proud of the pile at the top of
    // the crease, with page background beside it, for most of the turn. A page coming back the
    // other way takes the front in one step (fold-drag.ts cancels its transitions as it
    // promotes it), so the pile's furthest crease is the resting one from that moment.
    --pile-arc: calc(log(1 + var(--pages-turned)) / log(2));
    --pile-arc-under: calc(log(max(var(--pages-turned), 1)) / log(2));
    --pile-rise: max(
      #{$turn-lift} * var(--pile-arc-under),
      #{$turn-lift} * var(--pile-arc) * var(--turn-ease)
    );
    --pile-drift: max(
      #{$turn-drift} * max(var(--pages-turned) - 1, 0),
      #{$turn-drift} * var(--pages-turned) * var(--turn-ease)
    );
    --pile-lean: min(
      -1 * #{$turn-splay} * var(--pile-arc-under),
      -1 * #{$turn-splay} * var(--pile-arc) * var(--turn-ease)
    );

    // The papers a page can be printed on, the same values TechnicalDrawing/Page.astro paints
    // the sheet's face with. Named here on the stack so that each page below can pick its own
    // as --paper-surface, and fold-drag.ts can hand the pile's page on as --pile-paper by name.
    --paper-plain: #{colors.$sheet-paper};
    --paper-blueprint: var(--blueprint);

    & > div {
      grid-area: content;
      border-radius: $border-radius;
      --fold-back-rest-x: inherit;
      --fold-back-rest-y: inherit;
      --fold-pin-x: inherit;
      --fold-pin-y: inherit;
      transform-origin: var(--fold-pin-x) var(--fold-pin-y);

      // What the stack writes or transitions, read here and by the pseudo-elements below.
      // Every property that moves is registered as not inherited (the @property rules at the
      // top), so that a change re-resolves the few elements that read it and not everything
      // printed on the page, and each reader one level down says so.
      --fold-back-x: inherit;
      --fold-back-y: inherit;
      --flip-progress: inherit;
      --pages-turned: inherit;
      --pile-rise: inherit;
      --pile-drift: inherit;
      --pile-lean: inherit;
      --pile-paper: inherit;

      // The turned pages are the last --pages-turned of the order — a flip sends the front page
      // to --page-count and shifts the rest down — so the rank is 1 on the page turned first,
      // which now lies nearest the pages still to come, and --pages-turned on the one turned
      // most recently, which a flip sent under the whole stack and which therefore stands
      // furthest out. Everything still to come ranks 0 or less.
      --turned-rank: calc(var(--page-index) - var(--page-count) + var(--pages-turned));
      --turned: clamp(0, var(--turned-rank), 1);
      // log base 2 of one past the rank: 1 for the first page turned, then 1.58, 2, 2.32, and
      // 0 for everything still to come. Written as a ratio of natural logs because that is the
      // form the fan above uses.
      --turned-arc: calc(log(1 + max(var(--turned-rank), 0)) / log(2));
      --turned-rise: calc(#{$turn-lift} * var(--turned-arc));
      --turned-drift: calc(#{$turn-drift} * max(var(--turned-rank), 0));

      // Paint order: back to front by --page-index, which already reads the pile the right way
      // round. A turned page carries the highest indices, so it paints behind the bottom page of
      // the stack, and within the pile the page turned most recently paints behind the rest.
      order: calc(-1 * var(--page-index));
      // --flip-progress (set to 1 by fold-drag.ts for the length of a drag) closes the fan by
      // one page: the front page and the one behind it square up — so their folded-back corners
      // stay flush instead of fanning a gap open at the top-left — and by the time a committed
      // flip renumbers the stack there's no rotation left to pop. --paper-peek
      // (inline, set by the back-fold tease) swings the hindmost page a little further out of
      // the fan when the pointer nears the folded-back corner, showing the page a back-drag
      // would bring over; the rotate transition below eases both effects.
      // A turned page leaves the fan below and leans the other way instead, so the fan always
      // counts the pages still to come.
      rotate: calc(
        (1 - var(--turned)) * #{$per-page-splay} * log(max(var(--page-index) - var(--flip-progress), 1))
        - #{$turn-splay} * var(--turned-arc)
        + var(--paper-peek, 0deg)
      );
      translate: calc(-1 * var(--turned-drift)) calc(-1 * var(--turned-rise));

      // The sheet's back is the paper's own colour, and every shade on it is a translucent black
      // or white laid over that, so one set of gradients serves every theme's paper. The page
      // sets its paper on its own section, which the flap and the band, as its siblings, can't
      // see; the page's class says which paper it is, and it never changes, so the :has()
      // rule below matches once. All of it is var() and light-dark(), so a theme switch
      // repaints the backs with the faces and nothing has to read them again.
      --paper-surface: var(--paper-plain);
      --bend-paper: var(--paper-surface);

      &:has(> .blueprint) {
        --paper-surface: var(--paper-blueprint);
      }

      // The flap's lift (see the fold-lift mixin), on the flap and on the cast shadow. A flap
      // past the commit point is in hand too, so the second rule follows the first.
      &.paper-in-hand > .paper-fold,
      &.paper-in-hand > .paper-clip::after {
        --fold-lift: 1;
      }
      &.paper-will-commit > .paper-fold,
      &.paper-will-commit > .paper-clip::after {
        --fold-lift: 2;
      }
      // The drift and the rise are what ease, not the translate they feed: the corner cut and
      // the band below read the same two numbers, so cut, band and translate arrive together
      // and the page's left edge stays on the stack's while it climbs. Easing the translate on
      // its own left the cut at the new drift while the translate was still catching up, which
      // opened a hairline of page background at the top of the crease, between the strip and
      // the band, for the length of the turn. Both are registered as lengths.
      // TODO transition rotate at startup isn't working
      transition: rotate 250ms ease-in-out, --turned-drift 250ms ease-in-out, --turned-rise 250ms ease-in-out;

      @media (prefers-reduced-motion: reduce) {
        transition-duration: 0s;
      }

      // The front page. A class rather than :first-child: fold-drag.ts hands it to the next
      // page when a completed drag flips this one onto the back of the stack, without touching
      // DOM order — so the rotate transition above can animate every page's re-splay.
      &.paper-front {
        // The stack's top-left corner, folded away behind the clip. As a bare cut it is a hole,
        // and with pages standing in the pile behind the stack their edges show through it. This
        // is the paper that went round the back: a strip of sheet back running from the front
        // page's crease up to the same crease on the furthest page of the pile, painted the way
        // the fold flap paints a sheet's back — in that furthest page's own colour, with its
        // hairline edge.
        // It paints before the page's own children, so the clip's wire still lies over it.
        //
        // Its near edge is the front page's crease, (--fold-back-x, 0) to (0, --fold-back-y),
        // plus a hairline of slack to close the seam. Its far edge is that crease as the furthest
        // page carries it: the page's cut stands --pile-drift over (see the corner cut on the
        // other pages below), and the page then slides back by that drift and up by
        // --pile-rise, and leans --pile-lean about the pin — the order the browser applies a
        // page's translate and rotate — so the strip meets that page's corner at any width and
        // however many pages have piled up. Nothing is folded until a page has been turned, and
        // until then the pile's crease is the front page's own.
        &::before {
          content: "";
          position: absolute;
          --fold-back-x: inherit;
          --fold-back-y: inherit;
          --pages-turned: inherit;
          --pile-rise: inherit;
          --pile-drift: inherit;
          --pile-lean: inherit;
          --pile-paper: inherit;
          --fold-pin-x: inherit;
          --fold-pin-y: inherit;
          $pin-x: var(--fold-pin-x);
          $pin-y: var(--fold-pin-y);
          --lean-cos: cos(var(--pile-lean));
          --lean-sin: sin(var(--pile-lean));
          --pile-crease-top-x: calc(
            #{$pin-x} - var(--pile-drift)
            + (var(--fold-back-x) + var(--pile-drift) - #{$pin-x}) * var(--lean-cos)
            + #{$pin-y} * var(--lean-sin)
          );
          --pile-crease-top-y: calc(
            #{$pin-y} - var(--pile-rise)
            + (var(--fold-back-x) + var(--pile-drift) - #{$pin-x}) * var(--lean-sin)
            - #{$pin-y} * var(--lean-cos)
          );
          --pile-crease-left-x: calc(
            #{$pin-x} - var(--pile-drift)
            + (var(--pile-drift) - #{$pin-x}) * var(--lean-cos)
            - (var(--fold-back-y) - #{$pin-y}) * var(--lean-sin)
          );
          --pile-crease-left-y: calc(
            #{$pin-y} - var(--pile-rise)
            + (var(--pile-drift) - #{$pin-x}) * var(--lean-sin)
            + (var(--fold-back-y) - #{$pin-y}) * var(--lean-cos)
          );
          // The box starts above the page by the pile's rise plus room for the lean, and the
          // polygon measures its y from there.
          --strip-top: calc(var(--pile-rise) + 1em);
          left: 0;
          top: calc(-1 * var(--strip-top));
          width: calc(var(--fold-back-x) + 1em);
          height: calc(var(--fold-back-y) + var(--strip-top) + 1px);

          // Paper does not fold flat along a line: between the front crease and the pile it
          // rolls over the pile's edge in a rounded bend, and that is what this quadrilateral
          // stands for. Two things make it read as one. Its long edges bow outward, three
          // extra points on each set out along the crease's normal by a share of the bend's
          // width (the near bow lies under the front sheet, and is there so the shape stays a
          // whole), while the four corners stay on the two creases. And it is shaded across
          // its width, from the crease to the pile, the way the flap is shaded from its own
          // crease: in shadow where the sheet turns up out of the front crease, the plain
          // paper over the apex, a little darker again where it turns under at the pile's
          // edge. The normal is (sin a, cos a) for a the crease's angle, pointing into the
          // page; the gradient runs the other way, and its stops are measured from the box
          // corner the gradient line starts at, which for that direction is the bottom-right
          // one.
          --bend-angle: atan2(var(--fold-back-y), var(--fold-back-x));
          --bend-sin: sin(var(--bend-angle));
          --bend-cos: cos(var(--bend-angle));
          --bend-width: calc(var(--pile-rise) * var(--bend-cos));
          --bend-bow: calc(var(--bend-width) * 0.3);
          --bend-far-ax: var(--pile-crease-top-x);
          --bend-far-ay: calc(var(--pile-crease-top-y) + var(--strip-top));
          --bend-far-bx: var(--pile-crease-left-x);
          --bend-far-by: calc(var(--pile-crease-left-y) + var(--strip-top));
          --bend-near-ax: calc(var(--fold-back-x) + 1px);
          --bend-near-ay: var(--strip-top);
          --bend-near-bx: 0px;
          --bend-near-by: calc(var(--fold-back-y) + 1px + var(--strip-top));
          --bend-side: calc(var(--bend-bow) * 0.7071);
          clip-path: polygon(
            var(--bend-near-ax) var(--bend-near-ay),
            var(--bend-far-ax) var(--bend-far-ay),
            calc(var(--bend-far-ax) + (var(--bend-far-bx) - var(--bend-far-ax)) * 0.25 - var(--bend-side) * var(--bend-sin))
              calc(var(--bend-far-ay) + (var(--bend-far-by) - var(--bend-far-ay)) * 0.25 - var(--bend-side) * var(--bend-cos)),
            calc(var(--bend-far-ax) + (var(--bend-far-bx) - var(--bend-far-ax)) * 0.5 - var(--bend-bow) * var(--bend-sin))
              calc(var(--bend-far-ay) + (var(--bend-far-by) - var(--bend-far-ay)) * 0.5 - var(--bend-bow) * var(--bend-cos)),
            calc(var(--bend-far-ax) + (var(--bend-far-bx) - var(--bend-far-ax)) * 0.75 - var(--bend-side) * var(--bend-sin))
              calc(var(--bend-far-ay) + (var(--bend-far-by) - var(--bend-far-ay)) * 0.75 - var(--bend-side) * var(--bend-cos)),
            var(--bend-far-bx) var(--bend-far-by),
            var(--bend-near-bx) var(--bend-near-by),
            calc(var(--bend-near-bx) + (var(--bend-near-ax) - var(--bend-near-bx)) * 0.25 + var(--bend-side) * var(--bend-sin))
              calc(var(--bend-near-by) + (var(--bend-near-ay) - var(--bend-near-by)) * 0.25 + var(--bend-side) * var(--bend-cos)),
            calc(var(--bend-near-bx) + (var(--bend-near-ax) - var(--bend-near-bx)) * 0.5 + var(--bend-bow) * var(--bend-sin))
              calc(var(--bend-near-by) + (var(--bend-near-ay) - var(--bend-near-by)) * 0.5 + var(--bend-bow) * var(--bend-cos)),
            calc(var(--bend-near-bx) + (var(--bend-near-ax) - var(--bend-near-bx)) * 0.75 + var(--bend-side) * var(--bend-sin))
              calc(var(--bend-near-by) + (var(--bend-near-ay) - var(--bend-near-by)) * 0.75 + var(--bend-side) * var(--bend-cos))
          );
          --bend-crease: calc((1em - 1px) * var(--bend-sin) + (var(--fold-back-y) + 1px) * var(--bend-cos));
          // The strip is the back of the page turned most recently, going round behind the
          // stack, so it is that page's paper and not the front page's — pages in one stack can
          // carry different backgrounds. fold-drag.ts names the furthest page's paper on
          // the stack as --pile-paper whenever the pile changes, and leaves
          // it unset when nothing is turned, where the strip is transparent anyway. The fold
          // flap above stays on --bend-paper: that one really is the front page's own sheet.
          --pile-bend-paper: var(--pile-paper, var(--bend-paper));
          background:
            linear-gradient(
              calc(-1 * var(--bend-angle)),
              rgb(0 0 0 / 0.38) calc(var(--bend-crease) - var(--bend-bow)),
              rgb(0 0 0 / 0) calc(var(--bend-crease) + var(--bend-width) * 0.55),
              rgb(0 0 0 / 0.14) calc(var(--bend-crease) + var(--bend-width) + var(--bend-bow))
            )
            var(--pile-bend-paper);
          border: 1px solid var(--line-strong);
          opacity: clamp(0, var(--pages-turned), 1);
          pointer-events: none;
        }

        // The page content, but not the fold flap / paper clip / grab handle / flip hint riding
        // on top of it (or the clip's back bar riding under it): clip-path clips descendants
        // too, and those must be able to overhang the page.
        > :not(.paper-fold, .paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
          --fold-x: inherit;
          --fold-y: inherit;
          --fold-page-w: inherit;
          --fold-page-h: inherit;
          --fold-back-x: inherit;
          --fold-back-y: inherit;
          // --fold-page-w/-h (actual pixel size) are kept in sync by fold-drag.ts via
          // ResizeObserver on this div — needed because the crease's excess/ratio
          // terms below mix lengths and can't be computed against a bare percentage
          // (percentages aren't real lengths until layout, so e.g. dividing by --fold-x
          // wouldn't type-check against 100%).
          //
          // The crease is the line through (--fold-page-w - fold-x, H) and (W, --fold-page-h -
          // fold-y) — same two points as before — clipped to the page rectangle. Which edges it
          // actually crosses (bottom+right / left+right / bottom+top / left+top) depends on
          // whether fold-x exceeds the page width and/or fold-y exceeds its height; crease1/
          // crease2 below is a single closed form that covers all four cases continuously, so
          // the polygon further down never needs to branch on which case it's in. Keeping the
          // crease away from the pin is fold-drag.ts's job (the rim clamp in onFoldDrag), not
          // this formula's — flooring these above 0 would bend the crease.
          --crease-excess-x: max(var(--fold-x) - var(--fold-page-w), 0px);
          --crease-excess-y: max(var(--fold-y) - var(--fold-page-h), 0px);
          --crease1-x: max(var(--fold-page-w) - var(--fold-x), 0px);
          // Each intercept below needs how far the crease has overrun the page as a fraction of
          // its own reach — one length over another, written the obvious way as (a / b). Firefox
          // won't type-check that division and throws the whole clip-path out as invalid, which
          // leaves the front page uncut: no dog-ear, and no folded-back corner at the top left
          // either. (A drag paints its own inline clip-path, so the corner would appear under the
          // hand and vanish again the moment the CSS rule took back over.) tan(atan2(a, b)) is
          // that same a/b as a plain number, out of trig functions every engine does have.
          // max() on the divisors keeps atan2 off (0, 0), which is undefined: at --fold-x/y 0
          // (before the reveal animation's delay ends) the ratio would otherwise be 0/0 → NaN,
          // which censors into a polygon missing half the page. The floor only kicks in when the
          // excess is 0 anyway, so it never changes the shape.
          --crease1-y: clamp(
            0px,
            var(--fold-page-h) - var(--fold-y) * tan(atan2(var(--crease-excess-x), max(var(--fold-x), 1px))),
            var(--fold-page-h)
          );
          --crease2-x: clamp(
            0px,
            var(--fold-page-w) - var(--fold-x) * tan(atan2(var(--crease-excess-y), max(var(--fold-y), 1px))),
            var(--fold-page-w)
          );
          --crease2-y: max(var(--fold-page-h) - var(--fold-y), 0px);

          // The two corners here (bottom-left, top-right) collapse to zero-area "spikes" when
          // the fold doesn't reach that far — see crease1/crease2 above — so this one polygon
          // covers every case without branching. The first and last vertices cut the top-left
          // corner folded away behind the stack (every other page cuts the same corner — see
          // the &:not(.paper-front) rule below); at 0 they collapse to (0, 0).
          clip-path: polygon(
            var(--fold-back-x) 0px,
            0px var(--fold-back-y),
            0px var(--fold-page-h),
            var(--crease1-x) var(--crease1-y),
            var(--crease2-x) var(--crease2-y),
            var(--fold-page-w) 0px
          );
        }

        // Invisible handle over the folded-back top-left corner — grabbing it (once the stack
        // has flipped, see [data-paper-flipped] below) drags the previous page back over the
        // front.
        & > .paper-back-grab {
          --fold-back-x: inherit;
          --fold-back-y: inherit;
          position: absolute;
          left: 0;
          top: 0;
          width: calc(var(--fold-back-x) + 1em);
          height: calc(var(--fold-back-y) + 1em);
          touch-action: none;
          cursor: grab;
          display: none;

          &:active {
            cursor: grabbing;
          }
        }

        // Commit feedback: fades in riding the flap (fold-drag.ts writes the flap's visual
        // center every drag frame) while releasing would carry the gesture through (see
        // .paper-fold--will-commit above). A flap pulled out to the sheet's edge, or one coming
        // back from off the sheet, has its centre there too, so the hint stops a mat and half
        // its own size short of each edge and stays on the paper. Before the first drag frame
        // the two lengths are unset, the insets resolve to auto, and it rests in the corner.
        & > .paper-flip-hint {
          --flip-hint-inset: calc(1rem + 1.25em);

          position: absolute;
          left: clamp(var(--flip-hint-inset), var(--flip-hint-x), 100% - var(--flip-hint-inset));
          top: clamp(var(--flip-hint-inset), var(--flip-hint-y), 100% - var(--flip-hint-inset));
          translate: -50% -50%;
          width: 2.5em;
          height: 2.5em;
          color: var(--ink);
          filter: drop-shadow(0 1px 2px rgb(0 0 0 / 35%));
          opacity: 0;
          scale: 0.5;
          transition: opacity 200ms ease-out, scale 200ms ease-out;
          pointer-events: none;

          @media (prefers-reduced-motion: reduce) {
            scale: none;
            transition-property: opacity;
          }
        }

        &.paper-will-commit > .paper-flip-hint {
          opacity: 1;
          scale: 1;
        }

        // Both wire layers ride in full-page wrappers so the svg can position against the page
        // box. The wrappers repeat the pages' folded-back corner cut (their svg must overhang
        // the page, so they can't just live under the page's own clip-path): the crease edge
        // between the last two vertices runs through the cut's real intercepts, and the two
        // extension vertices flanking them continue it past the page box at the resting lean,
        // far enough to clear the wire's overhang — one flanks the top intercept by a whole
        // (rest-x, -rest-y) step, the other reaches 3em out past the left edge and drops
        // whatever the lean makes that (hence the tan(atan2()) rise-over-run; a bare ratio is
        // a division Firefox won't take, see the crease formula above). At --fold-back 0 the
        // cut collapses to a
        // line through the corner that the wire sits just clear of (its outer-right edge rides
        // the resting crease, one wire-width away); at rest the crease edge coincides with
        // that outer-right edge — the wire disappears in sync with the corner folding back.
        & > .paper-clip,
        & > .paper-clip-under {
          --fold-back-x: inherit;
          --fold-back-y: inherit;
          --fold-back-rest-x: inherit;
          --fold-back-rest-y: inherit;
          position: absolute;
          inset: 0;
          pointer-events: none;
          clip-path: polygon(
            calc(var(--fold-back-x) + var(--fold-back-rest-x)) calc(-1 * var(--fold-back-rest-y)),
            calc(100% + 3em) calc(-1 * var(--fold-back-rest-y)),
            calc(100% + 3em) calc(100% + 3em),
            -3em calc(100% + 3em),
            -3em calc(var(--fold-back-y) + 3em * tan(atan2(var(--fold-back-rest-y), var(--fold-back-rest-x)))),
            0px var(--fold-back-y),
            var(--fold-back-x) 0px
          );
        }

        // The shadow the lifted corner casts on the page under it: a soft band on the far side
        // of the crease from the flap, darkest along the crease, gone --fold-shade-w in towards
        // the corner. It rides the clip's wrapper because that is the one page-sized layer
        // between the sheet and the flap, and it already wears the folded-back corner cut,
        // which keeps the shadow off the strip that paints there. The sheet's content is
        // clipped away on this side of the crease, so what the band darkens is whatever page
        // shows through the hole. The gradient stops with the crease; the flap covers the near
        // side. Nothing here changes per frame that the flap does not change too, its stops
        // read the same --fold-x/-y, which the pseudo-element takes from the clip wrapper.
        & > .paper-clip {
          --fold-x: inherit;
          --fold-y: inherit;
        }

        & > .paper-clip::after {
          --fold-x: inherit;
          --fold-y: inherit;
          @include fold-crease;
          @include fold-lift;
          content: "";
          position: absolute;
          inset: 0;
          border-radius: $border-radius;
          background: linear-gradient(
            calc(-1 * var(--flap-angle)),
            rgb(0 0 0 / 0) calc(var(--flap-crease) - var(--fold-shade-w)),
            rgb(0 0 0 / calc(0.22 + 0.1 * var(--fold-lift))) var(--flap-crease),
            rgb(0 0 0 / 0) var(--flap-crease)
          );
        }

        & > .paper-clip > svg,
        & > .paper-clip-under > svg {
          position: absolute;
          --fold-back-rest-x: inherit;
          --fold-back-rest-y: inherit;
          --fold-pin-x: inherit;
          --fold-pin-y: inherit;
          left: var(--fold-pin-x);
          top: var(--fold-pin-y);
          // The wire's outer-right edge lies on the resting fold-back crease: its bottom point
          // (viewBox 24.5, 50 → 87.5%, 78.125% of the box) sits on the pin, and the lean
          // matches the crease's own slope, which is what the rotate reads off the intercepts
          // (atan(1/2) from vertical at the default lean). The body extends from that edge
          // toward the page corner — the side a flip folds behind the stack — and the width is
          // sized against the crease's clearance from that corner, rest-x·rest-y/|rest|, which
          // a swapped lean leaves untouched: much wider and the wire's flank crosses the corner
          // and hangs off the page.
          //
          // The wire runs 3.125em from the pin one way and 0.875em the other, so the bend end
          // always overshoots the crease's nearer intercept and pokes off the page there —
          // which reads as a clip slid all the way onto that edge, and so has to be the edge
          // the wire lies more along. Standing the box up (no flip) sends the bend to the top
          // intercept, which is right while the crease is steeper than 45°; past that the wire
          // is more horizontal than vertical and belongs on the left edge instead, so it turns
          // end for end. scaleY is that turn — a reflection along the wire's own length, which
          // moves the bend without taking the body off the corner side the way a half-turn
          // would — and sign() picks it straight off the lean, so the edge can't fall out of
          // step with the angle. (The two are only ambiguous at exactly 45°, where sign() is 0
          // and the wire would collapse; a lean that square has no edge to prefer anyway.)
          //
          // The width is that clearance itself, less an eighth, rather than a fixed em: a stack
          // that sizes its corner to the sheet gets a clip sized to the corner it pins, instead
          // of a wire whose flank crosses the crease and hangs off the page once the corner is
          // small. x·sin(atan2(y, x)) is x·y/|(x, y)|, which calc cannot write directly because
          // it will not multiply two lengths.
          translate: -87.5% -78.125%;
          transform-origin: 87.5% 78.125%;
          rotate: atan2(var(--fold-back-rest-x), var(--fold-back-rest-y));
          transform: scaleY(sign(var(--fold-back-rest-y) - var(--fold-back-rest-x)));
          width: calc(
            0.875 * var(--fold-back-rest-x)
            * sin(atan2(var(--fold-back-rest-y), var(--fold-back-rest-x)))
          );
          height: auto;
        }

        & > .paper-clip > svg {
          filter: drop-shadow(0 1px 2px rgb(0 0 0 / 45%));
        }

        &:has(> .paper-fold:hover) {
          animation-play-state: paused;
        }

        // The reveal waits for the reader: held until fold-drag.ts sets --fold-reveal on the
        // stack, the first time the stack's bottom edge, where the dog-ear is, comes on screen.
        // Run from load, it played out on every stack while the reader was still at the top of
        // the page. The pulse is not there at all until the reveal has finished: the stack's
        // --fold-pulse keeps its three layers' animations off. While the page's clip-path pulse
        // exists, even held or still in its delay, Chrome keeps painting the crease clip it
        // had when that animation started, at no fold: the flap drew itself over an uncut
        // corner, and the cut only caught up when the pulse's delay ran out.
        animation: 500ms 500ms ease-in-out initial-fold-reveal 1 forwards;
        --fold-reveal: inherit;
        --fold-pulse: inherit;
        animation-play-state: var(--fold-reveal, paused);

        // The corner lands at rest at once. A zero-length animation still ends, and its
        // animationend is what fold-drag.ts waits for.
        @media (prefers-reduced-motion: reduce) {
          animation-duration: 0s;
          animation-delay: 0s;
        }

        @keyframes initial-fold-reveal {
          from { --fold-x: 0cm; --fold-y: 0cm; }
          to { --fold-x: #{drawing.$fold-rest-x}; --fold-y: #{drawing.$fold-rest-y}; }
        }

        // Then the resting dog-ear breathes: it holds at rest, eases out to $fold-pulse-x/-y
        // and back, on a 7.5s loop. Animating --fold-x/-y would say that in one place, but
        // every frame would then resolve style on the page and repaint the sheet, the frame
        // and the clip's shadow: about 1,900 paints in 5s for each stack on screen, for as
        // long as it is on screen. So each layer the fold draws animates the one property of
        // its own that the compositor can run without the page, all three sampled from the
        // same fold size:
        //
        // - the page content's crease clip-path, whose two crease vertices move with the fold
        //   (fold-pulse-page);
        // - the flap, drawn at rest and carried to each size by a transform: stretched to the
        //   new box, then reflected across the new crease in place of the old one
        //   (fold-pulse-flap);
        // - the cast shadow, which lies in the corner triangle and so only scales out from the
        //   corner (fold-pulse-shade).
        //
        // Every shading stop is a share of the crease's distance from the corner, so the
        // stretched drawing is the drawing at the new size. What does stretch is the flap's
        // 1px edge, which thickens with the fold towards the peak. The ease-in-out is sampled
        // into linear steps because the flap's reflection is not linear in the size: sampled,
        // it follows the same path as the other two.
        $pulse-steps: 10;

        @mixin fold-pulse-keyframes($name) {
          @keyframes #{$name} {
            @for $i from 0 through $pulse-steps {
              $s: math.div($i, $pulse-steps);
              $e: ease-in-out($s);
              $x: drawing.$fold-rest-x + ($fold-pulse-x - drawing.$fold-rest-x) * $e;
              $y: drawing.$fold-rest-y + ($fold-pulse-y - drawing.$fold-rest-y) * $e;
              #{if($i == 0, 'from, 50%', if($i == $pulse-steps, '90%, to', percentage(0.5 + 0.4 * $s)))} {
                @content($x, $y);
              }
            }
          }
        }

        @include fold-pulse-keyframes(fold-pulse-page) using ($x, $y) {
          clip-path: polygon(
            var(--fold-back-x) 0px,
            0px var(--fold-back-y),
            0px 100%,
            calc(100% - #{$x}) 100%,
            100% calc(100% - #{$y}),
            100% 0px
          );
        }

        // The flap's box is the fold's size plus a 1px border all round, so it stretches
        // border edge to border edge. Its centre, the transform origin, moves by half the
        // growth.
        @include fold-pulse-keyframes(fold-pulse-flap) using ($x, $y) {
          $angle: math.atan2($y, $x);
          transform:
            translate(math.div(drawing.$fold-rest-x - $x, 2), math.div(drawing.$fold-rest-y - $y, 2))
            rotate(-$angle) scaleX(-1) rotate($angle)
            scale(
              math.div($x + 2px, drawing.$fold-rest-x + 2px),
              math.div($y + 2px, drawing.$fold-rest-y + 2px)
            );
        }

        @include fold-pulse-keyframes(fold-pulse-shade) using ($x, $y) {
          scale: math.div($x, drawing.$fold-rest-x) math.div($y, drawing.$fold-rest-y);
        }

        // The three share one clock: the same timing, started together whenever a page takes
        // the front, and paused, cancelled and restarted together by fold-drag.ts, which
        // restarts them by setting --fold-pulse to none for a frame on the sheet (each layer
        // takes it by `inherit`; the sheet takes it from the stack, which holds it at none
        // until the reveal). The play state comes down from the sheet too, so a pointer
        // on the flap still holds the pulse.
        @mixin fold-pulse($name) {
          --fold-pulse: inherit;
          animation: var(--fold-pulse, #{$name}) 7.5s 1.5s linear infinite alternate;
          animation-play-state: inherit;

          @media (prefers-reduced-motion: reduce) {
            animation: none;
          }
        }

        > :not(.paper-fold, .paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
          @include fold-pulse(fold-pulse-page);
        }

        > .paper-fold:not(.paper-fold--active) {
          @include fold-pulse(fold-pulse-flap);
        }

        > .paper-clip {
          --fold-pulse: inherit;
          animation-play-state: inherit;
        }

        > .paper-clip::after {
          @include fold-pulse(fold-pulse-shade);
          transform-origin: 100% 100%;
        }
      }

      // The same top-left corner cut as the front page's polygon above — the fold-back sizes
      // are inherited from the stack, so every page's corner folds behind as one. Unconditional
      // (not scoped to [data-paper-flipped]) so the cut grows and shrinks with the transitioned
      // sizes instead of popping when the attribute toggles.
      //
      // The whole cut, left edge and all, moves over by the page's own drift, which cancels the
      // translate above: a turned page leans back towards the clip, and without this its left
      // edge would stand out past the stack's, a stripe of it showing all the way down beside
      // the front page. Cancelling the drift here instead of dropping it keeps the pile's arc,
      // which the drift is what bows, and puts every page's crease on the stack's own crease,
      // which is what lets one dog-ear the size of the cut cover the pile (see
      // .paper-front::before). --turned-drift is 0 on a page still to come, so their cut is
      // unchanged.
      &:not(.paper-front) > * {
        --fold-back-x: inherit;
        --fold-back-y: inherit;
        --turned-drift: inherit;
        clip-path: polygon(
          calc(var(--fold-back-x) + var(--turned-drift)) 0px,
          var(--turned-drift) var(--fold-back-y),
          var(--turned-drift) 100%,
          100% 100%,
          100% 0px
        );
      }

      // The fold flap. Styled at this level rather than under .paper-front: a committed flip
      // restacks the pages at the fold's furthest reach, and the flap then rides the flipped
      // sheet — no longer the front page — while it folds back down behind the stack.
      & > .paper-fold {
        --fold-x: inherit;
        --fold-y: inherit;
        width: var(--fold-x);
        height: var(--fold-y);

        // The far triangle of the box: the corner is cut off along the crease, from the box's
        // bottom-left to its top-right. The box stands 1px past the sheet's right and bottom
        // edges (below), so those two tips do too, and the reflection under this swaps them: a
        // sliver of the tip drawn at the sheet's right edge lands under its bottom edge, and the
        // other way round. Each tip is chamfered 2px back along its sheet edge, to the point
        // 1.5px in on the crease, which covers the part whose mirror image falls off the sheet.
        clip-path: polygon(
          0% 0%,
          0% calc(100% - 2px),
          1.5px calc(100% - 1.5px * tan(var(--flap-angle))),
          calc(100% - 1.5px / max(tan(var(--flap-angle)), 0.001)) 1.5px,
          calc(100% - 2px) 0%
        );

        border-top-left-radius: $border-radius;

        $angle: atan2(var(--fold-y), var(--fold-x));
        transform-origin: center;
        transform: rotate(calc(-1 * #{$angle})) scaleX(-1) rotate(calc(#{$angle}));

        // The back of the sheet: plain paper, no page texture. --paper-surface is the page's
        // own paper, picked on the sheet above: as a sibling of the page this element can't see
        // background definitions scoped inside it (e.g. a blueprint page redefining its surface).
        //
        // Lit where it lies flat, at its free corner, and in shadow where it curls up out of
        // the crease: the fold is the one place the sheet turns away from the light. Two
        // gradients along the crease's normal, measured from the box's bottom-right corner
        // (see the fold-crease mixin): a darkening that peaks on the crease and is gone
        // --flap-curl either side of it, and a sheen at the corner that the lift brings up. Both
        // are mirrored about the crease, on purpose. The resting box above shows the far
        // triangle, corner at twice the crease distance, reflected across the crease's
        // perpendicular; the full-size box the drag switches to shows the corner triangle,
        // corner at 0, reflected across the crease itself. Either way the corner is a flap's
        // length from the crease, and one symmetric gradient lights both without a branch.
        @include fold-crease;
        @include fold-lift;
        --flap-sheen: calc(0.05 * var(--fold-lift));
        --flap-flat: calc(0.12 - 0.06 * var(--fold-lift));
        --flap-fold: calc(0.38 - 0.04 * var(--fold-lift));
        --flap-curl: calc(var(--fold-shade-w) * 0.8);
        // A landing, forward or a back-drag's approach, folds the sheet a second time, at a
        // crease that travels between the resting crease and the tip. In this box's own
        // coordinates that crease is another corner fold, which fold-drag.ts writes here as
        // --land-x/-y (renderLanding) in the same terms as --fold-x/-y, so it takes the same
        // darkening. The crease closes into the corner as the landing completes and the first
        // fold's rendering takes over, so the shade fades out over its last 3em. The layer is
        // in the list only while a landing runs, under the class fold-drag.ts sets with the
        // lengths: at rest it would be an empty gradient on every flap of every stack, and
        // the specs read the flap's list.
        --land-angle: atan2(max(var(--land-y), 1px), max(var(--land-x), 1px));
        --land-crease: calc(var(--land-x) * sin(var(--land-angle)));
        --land-curl: calc(clamp(0.5em, var(--land-crease) * 0.6, 5em) * 0.8);
        --land-fade: min(1, tan(atan2(var(--land-crease), 3em)));
        --land-fold: calc((var(--flap-fold) - var(--flap-flat)) * var(--land-fade));
        --flap-shade:
          linear-gradient(
            calc(-1 * var(--flap-angle)),
            rgb(255 255 255 / var(--flap-sheen)) 0px,
            rgb(255 255 255 / 0) calc(var(--flap-crease) * 0.6),
            rgb(255 255 255 / 0) calc(var(--flap-crease) * 1.4),
            rgb(255 255 255 / var(--flap-sheen)) calc(var(--flap-crease) * 2)
          ),
          linear-gradient(
            calc(-1 * var(--flap-angle)),
            rgb(0 0 0 / var(--flap-flat)) calc(var(--flap-crease) - var(--flap-curl)),
            rgb(0 0 0 / var(--flap-fold)) var(--flap-crease),
            rgb(0 0 0 / var(--flap-flat)) calc(var(--flap-crease) + var(--flap-curl))
          );
        background: var(--flap-shade) var(--bend-paper);
        &.paper-fold--landing {
          background:
            linear-gradient(
              calc(-1 * var(--land-angle)),
              rgb(0 0 0 / 0) calc(var(--land-crease) - var(--land-curl)),
              rgb(0 0 0 / var(--land-fold)) var(--land-crease),
              rgb(0 0 0 / 0) calc(var(--land-crease) + var(--land-curl))
            ),
            var(--flap-shade) var(--bend-paper);
        }
        border: 1px solid var(--line-strong);

        position: absolute;
        right: -1px;
        bottom: -1px;
        touch-action: none;

        // At no fold the box is its border alone, a 2px square over the sheet's corner: held
        // before the reveal, it showed as a stray dot there.
        opacity: sign(var(--fold-x));

        // While dragging (and briefly during the release settle), fold-drag.ts switches to
        // this full-size mode and drives clip-path/transform directly via inline styles —
        // the crease can now wrap around either corner, so it no longer fits in a box
        // tightly sized to fold-x/fold-y the way the idle state above does.
        &.paper-fold--active {
          width: auto;
          height: auto;
          inset: 0;
          opacity: 1;
          // Full-size, so every box corner coincides with a page corner: rounding them all
          // rounds whichever folded-over page corners the hole polygon includes (the clip
          // vertices there are sharp, but they pass exactly through the box corners, so the
          // rounded painting shows through).
          border-radius: $border-radius;
        }

        &:hover {
          cursor: grab;
        }

        &:active {
          cursor: grabbing;
        }

        // Past the commit point the sheet lifts a step further (--fold-lift 2, from the sheet's
        // paper-will-commit class): the flap brightens past its in-hand tone and its shadow
        // deepens, so crossing the threshold reads as a state change.

        // A committed flip keeps this flap on the outgoing sheet until it has folded away behind
        // the stack, so fold-drag.ts stands a second one in on the page taking the front, which
        // would otherwise wear a bare corner cut until the flip ended. It only paints the resting
        // dog-ear: the hand still finds the real flap, which takes this one's place the moment the
        // flip is done with it.
        &.paper-fold--stand-in {
          pointer-events: none;
        }
      }
    }

    // The band of sheet back a risen page shows above the front one: the page's own colour,
    // picked on the sheet because a background defined inside the page can't be seen from out
    // here, darkened exactly as the fold flap darkens the same paper, with the
    // sheet's hairline edge and its corner. It runs $turn-under behind the front page, so the
    // bottom of the band is never in view and what shows is exactly how far the sheet has
    // risen. ::after, not ::before: the page content would paint over it. The opacity is not
    // transitioned on purpose — a page coming back is the front page the moment it is promoted,
    // and a band fading out over it would wipe across the top of the sheet.
    & > div::after {
      content: "";
      position: absolute;
      --fold-back-x: inherit;
      --fold-back-y: inherit;
      --turned-drift: inherit;
      --turned-rise: inherit;
      --turned: inherit;
      --band-height: calc(var(--turned-rise) + #{$turn-under});
      // The left inset cancels the page's drift, as the corner cut below does, so the band ends
      // on the stack's left edge rather than out past it.
      inset: 0 0 auto var(--turned-drift);
      height: var(--band-height);
      // The band covers the sheet's own folded corner, so it has to be folded away too or the
      // pile would end in square corners stacked up the dog-ear's column. Same crease, run down
      // to the bottom of the band: it starts --fold-back-x in at the top and comes in by the
      // band's height over the crease's reach. (tan(atan2()) is one length over another as a
      // plain number, a division Firefox won't take; see the crease formula above.)
      //
      // Not floored at 0: a band taller than the fold reaches past the point where the crease
      // leaves the page, and the crease has to keep its slope there so the band ends on the
      // page's own left edge. Flooring it stood the band's edge up straight instead, leaving a
      // wedge of the sheet below the crease uncovered, which showed as a pale notch of the
      // next sheet's margin between one page of the pile and the next.
      --band-crease-x: calc(
        var(--fold-back-x) * (1 - tan(atan2(var(--band-height), max(var(--fold-back-y), 1px))))
      );
      clip-path: polygon(var(--fold-back-x) 0px, var(--band-crease-x) 100%, 100% 100%, 100% 0px);
      // The page in front of this one in the pile lies on the band and casts a shadow up onto
      // it from its top edge, which stands --turned-step below the band's top: the whole rise
      // for the first page turned, whose neighbour is the front page, and the difference
      // between two rises for the rest. The band is otherwise the sheet's back at a touch
      // under the paper's own tone, no brighter than the flap lying flat. The rank and the
      // rise are the sheet's own; the pseudo-element takes them from it.
      --turned-rank: inherit;
      --turned-rise: inherit;
      --turned-step: calc(var(--turned-rise) - #{$turn-lift} * log(max(var(--turned-rank), 1)) / log(2));
      background:
        linear-gradient(
          rgb(0 0 0 / 0.06),
          rgb(0 0 0 / 0.06) calc(var(--turned-step) - 0.5em),
          rgb(0 0 0 / 0.3) var(--turned-step)
        )
        var(--paper-surface);
      border: 1px solid var(--line-strong);
      border-top-right-radius: $border-radius;
      opacity: var(--turned);
      pointer-events: none;
    }

    // Once a page has been flipped to the back there is a previous page to go back to: the
    // stack's top-left corner rests folded away behind, and the grab handle over it activates.
    // The resting cut is the crease the paper clip pins: it runs along the wire's outer-left
    // edge, passing through the pin (the pin sits halfway down it, so pin = rest/2 satisfies
    // the crease equation exactly). fold-drag.ts's tease keeps the crease in that pinned
    // family, pivoting it around the pin.
    &[data-paper-flipped] {
      --fold-back-x: var(--fold-back-rest-x);
      --fold-back-y: var(--fold-back-rest-y);

      > .paper-front > .paper-back-grab {
        display: block;
      }
    }

    // With nothing turned the front page's corner is whole at once. When a turn wraps round to
    // the first page, the pile empties in one step (the strip over the cut goes with it) but the
    // cut still eases shut, and through it showed the pile's sheets gliding back under the stack:
    // a wedge of blueprint blue at the corner of a plain page. The other pages keep easing, under
    // it. A back-turn to the first page draws its cut inline as it comes over, so this reaches it
    // only once the page has landed.
    &:not([data-paper-flipped])
      > .paper-front
      > :not(.paper-fold, .paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
      --fold-back-x: 0px;
      --fold-back-y: 0px;
    }
  }
}
// Without JS the one stack above is the reader's copy too: these rules turn it into a plain
// scroll-snap row and switch off everything only fold-drag.ts gives meaning to. They live in the
// bundle with the rest, under a media query that is false on any page that runs script, so they
// never reach the scripted stack. They used to sit in a <noscript><style>, which is only hidden
// while scripting is on: a page loaded with JS and then switched off (DevTools, no reload) printed
// the block's source as text above the stack. The !importants outrank the scripted sheet's own
// compound selectors and the inline styles fold-drag.ts leaves behind; nothing else ever
// competes with them.
@media (scripting: none) {
  [data-paper-stack-root][data-paper-stack] {
    // How far each sheet under the current one shows below it.
    --pile-step: 0.25rem;
    // How far the row reaches past the sheet on either side. A snap lands on a whole pixel and a
    // sheet is rarely a whole number of pixels wide, so a sheet can rest up to half a pixel off
    // centre; a row cut flush with it would shave that side's border. The gap between sheets
    // keeps the next one out of that strip.
    --row-slack: 0.125rem;
    --pile-paper: var(--theme-paper, light-dark(var(--surface-raised), var(--surface-sunken)));

    display: flex !important;
    flex-direction: row;
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scroll-behavior: smooth;
    touch-action: auto !important;
    transition: none !important;
    counter-reset: paper-sheet;
    // The slack goes on outside the box the stack sizes (width and aspect ratio), so the sheets
    // keep the size they have with script on.
    box-sizing: content-box;
    margin-inline: calc(-1 * var(--row-slack));
    padding-inline: var(--row-slack);
    column-gap: calc(2 * var(--row-slack));

    // The rest of the stack, as two sheet edges under the one in front: the row scrolls past
    // them, the pile stays put. The margin is the pile's room. The row's corners are the
    // sheet's own, --row-slack further out, so they clip nothing of it; the shadows take the
    // slack back off each side and drop by it, which leaves the pile where it was.
    border-radius: calc(0.5em + var(--row-slack));
    box-shadow:
      0 calc(var(--pile-step) + var(--row-slack)) 0 calc(-0.5 * var(--pile-step) - var(--row-slack)) var(--pile-paper),
      0 calc(var(--pile-step) + var(--row-slack)) 0 calc(1px - 0.5 * var(--pile-step) - var(--row-slack)) var(--line-strong),
      0 calc(2 * var(--pile-step) + var(--row-slack)) 0 calc(-1 * var(--pile-step) - var(--row-slack)) var(--pile-paper),
      0 calc(2 * var(--pile-step) + var(--row-slack)) 0 calc(1px - var(--pile-step) - var(--row-slack)) var(--line-strong);
    margin-bottom: calc(2 * var(--pile-step)) !important;

    > * {
      flex: 0 0 100%;
      /* Clip both axes — annotation SVGs are 200% overlays and otherwise inflate
         scrollWidth, leaving a permanent horizontal scrollbar on every page. */
      overflow: clip;
      // The sheet's own corner. The scripted stack's calc(0.5em + 1px) clips nothing there, since
      // nothing clips that wrapper; here it would shave the sheet's rounded corner.
      border-radius: 0.5em !important;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      container-type: scroll-state;
      counter-increment: paper-sheet;
      order: 0 !important;
      rotate: none !important;
      animation: none !important;
      transition: none !important;

      > * {
        clip-path: none !important;
        animation: none !important;
        transition: opacity 200ms ease-out, scale 200ms ease-out;
      }

      // A sheet the row is not resting on sits back, so the current one reads at full strength.
      @container scroll-state(not (snapped: x)) {
        > * {
          opacity: 0.5;
          scale: 0.96;
        }
      }

      > :is(.paper-fold, .paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      scroll-behavior: auto;

      > * > * {
        transition: none;
        scale: none !important;
      }
    }

    // Firefox has neither ::scroll-button() nor ::scroll-marker, so nothing on the row said it
    // scrolls: one sheet filled it, and the scrollbar is an overlay that shows only mid-scroll.
    // There the sheets stand a rem apart, as the first carousel had them (TechnicalDrawingStack,
    // f9110506), and each is narrow enough that the next one's edge shows on the right. They
    // snap by their start so the edge stays on that side (the last sheet shows the one before it
    // instead), and a flick stops at the next sheet. The condition is the whole CSS carousel's,
    // so a browser that draws the arrows and dots keeps one full-width sheet.
    @supports not (selector(::scroll-marker) and selector(::scroll-button(right))) {
      --sheet-peek: 1.75rem;
      gap: 1rem;
      // A start snap aims the sheet at the row's own edge, not inside the slack, and Firefox rested
      // the second sheet 2px past that edge, which cut off its left border. The padding moves the
      // snap inside the slack.
      scroll-padding-inline: var(--row-slack);
      scrollbar-color: var(--line-strong) transparent;
      // The scrollbar shows here, inside the row. Sized by its aspect ratio, the row gave the
      // scrollbar the bottom 6px of every sheet wherever scrollbars take space (Firefox headless,
      // a desktop with overlay scrollbars off). Padding under the sheets changes nothing, the
      // scrollbar takes its room off the content box first, and scrollbar-gutter reserves for the
      // block-axis one only. So the row takes its height from the sheet and grows by the
      // scrollbar, whatever height that is, and by nothing where the scrollbar is an overlay. A
      // size container has no content to size by, so the sheet's height goes in as the row's
      // intrinsic one, and the sheets take it themselves, since a flex line in a contained box
      // is no taller than its items. The sheet is already capped at the height the frame capped
      // the row to on a phone (Stack.astro).
      height: auto;
      max-height: none;
      aspect-ratio: auto;
      contain-intrinsic-block-size: var(--sheet-block);

      > * {
        flex-basis: calc(100% - var(--sheet-peek));
        block-size: var(--sheet-block);
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }
    }

    // A dot per sheet in the sheet's bottom margin, and an arrow on each side edge, half on the
    // sheet and half off. All of them lie on the stack, not beside it: above it is the
    // section's heading and below it the card slip, which tucks up under the sheets. Both or
    // neither; without them the row keeps its scrollbar and the pile.
    @supports selector(::scroll-marker) and selector(::scroll-button(right)) {
      // Half of each arrow lies past the sheet's side edge, so the circle is never wider than
      // twice the room beside the sheet. On a phone the mat runs edge to edge and leaves 12 to
      // 15px there.
      --arrow-size: min(2rem, 100vw - anchor-size(width) + 2 * var(--row-slack));
      // The arrow is drawn, not set in a font. A glyph sits where its font puts it, below the
      // circle's middle in most monospace faces. It is a shaft --arrow-length long and a head
      // --arrow-head tall, both --arrow-stroke thick, pointing to the previous sheet.
      --arrow-length: 0.75rem;
      --arrow-head: 0.625rem;
      --arrow-stroke: 2px;
      --dot-size: 0.5rem;
      --dot-hit: 1.5rem;
      // The sheet's bottom margin, which nothing on a sheet draws in (TechnicalDrawing/Page.astro).
      --dot-mat: 1rem;

      @container technical-drawing-width (max-width: 40em) {
        --dot-mat: 0.625rem;
        --dot-size: 0.375rem;
      }

      scroll-marker-group: after;
      scrollbar-width: none;

      &::scroll-marker-group {
        position-anchor: --technical-drawing-stack;
        position: absolute;
        top: calc(anchor(bottom) - var(--dot-mat));
        left: calc(anchor(left) + var(--row-slack));
        right: calc(anchor(right) + var(--row-slack));
        height: var(--dot-mat);
        display: flex;
        justify-content: center;
        align-items: center;
      }

      > *::scroll-marker {
        content: "" / "Sheet " counter(paper-sheet);
        box-sizing: border-box;
        flex: none;
        width: var(--dot-hit);
        height: var(--dot-hit);
        border-radius: 50%;
        background: radial-gradient(
          circle,
          var(--dot-fill, transparent) calc(var(--dot-size) / 2 - 1px),
          var(--line-strong) calc(var(--dot-size) / 2 - 1px) calc(var(--dot-size) / 2),
          transparent calc(var(--dot-size) / 2 + 0.5px)
        );
        cursor: pointer;
      }

      > *::scroll-marker:hover {
        --dot-fill: var(--line-strong);
      }

      > *::scroll-marker:target-current {
        --dot-fill: var(--accent);
      }

      &::scroll-button(*) {
        position-anchor: --technical-drawing-stack;
        position: absolute;
        top: calc(anchor(center) - var(--arrow-size) / 2);
        box-sizing: border-box;
        width: var(--arrow-size);
        height: var(--arrow-size);
        padding: 0;
        border: 2px solid var(--accent);
        border-radius: 50%;
        color: var(--ink);
        // Each arm of the head is the diagonal of a square half the head's height, from the tip
        // at the shaft's end to the head's top or bottom corner. Every piece is placed from the
        // circle's centre.
        --arm: calc(var(--arrow-head) / 2);
        --arm-x: calc(50% - (var(--arrow-length) - var(--arm)) / 2);
        --arm-line: transparent calc(50% - var(--arrow-stroke) / 2),
          currentColor calc(50% - var(--arrow-stroke) / 2) calc(50% + var(--arrow-stroke) / 2),
          transparent calc(50% + var(--arrow-stroke) / 2);
        background:
          linear-gradient(to top left, var(--arm-line))
            var(--arm-x) calc(50% - var(--arm) / 2) / var(--arm) var(--arm) no-repeat,
          linear-gradient(to bottom left, var(--arm-line))
            var(--arm-x) calc(50% + var(--arm) / 2) / var(--arm) var(--arm) no-repeat,
          linear-gradient(currentColor, currentColor)
            center / var(--arrow-length) var(--arrow-stroke) no-repeat,
          var(--surface-raised);
