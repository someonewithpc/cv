---
import flipHint from './assets/flip-hint.svg?raw';

export type Props = {
  /** Tag name for the stack wrapper element. */
  as?: string;
  class?: string;
  /** Number of pages; the default slot is called as a function once per index. */
  pageCount: number;
  /** Accessible name of the stack. */
  label?: string;
};

const { as: tagName = 'div', class: className, pageCount, label } = Astro.props;
const Tag = tagName;

// One pair of gradients per stack: a page carries its clip wherever the stack goes, and a
// shared id would leave every clip painted from the first stack's gradient.
const clipId = crypto.randomUUID().slice(0, 8);

// One gem-clip wire, split at the top bend into its two physical layers. The wire leans with
// the resting fold-back crease — its outer-right edge runs along that crease, bottoming out at
// the pin (see --fold-pin-x/-y below) — so the whole body sits inside the corner region a flip
// folds behind the stack: the wrappers' crease cut (see their clip-path below) swallows the
// wire together with the corner, the clip vanishing with the paper it sits on. The "under"
// path's far half is the back bar, hidden by the page itself (it renders beneath the page
// content — see the template), so only the bend peeks past the page edge the lean points it
// at, reading as a clip slid all the way on. The "over" path is the front bar pressing on the
// page.
const clipGradient = (id: string) => `<defs>
    <linearGradient id="${id}" x1="0" y1="0" x2="28" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#f2f4f7" />
      <stop offset="40%" stop-color="#aeb4bd" />
      <stop offset="60%" stop-color="#7c828d" />
      <stop offset="100%" stop-color="#d8dbe0" />
    </linearGradient>
  </defs>`;

const paperClipUnder = `<div class="paper-clip-under"><svg viewBox="0 0 28 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path
    d="M5 22 V50 a9 9 0 0 0 18 0 V14 a6.25 6.25 0 0 0 -12.5 0"
    stroke="url(#paper-clip-under-gradient-${clipId})"
    stroke-width="3"
    stroke-linecap="round"
  />
  ${clipGradient(`paper-clip-under-gradient-${clipId}`)}
</svg></div>`;

const paperClipOver = `<svg viewBox="0 0 28 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path
    d="M10.5 14 V44 a4 4 0 0 0 8 0 V22"
    stroke="url(#paper-clip-over-gradient-${clipId})"
    stroke-width="3"
    stroke-linecap="round"
  />
  ${clipGradient(`paper-clip-over-gradient-${clipId}`)}
</svg>`;

// The fold flap, paper clip, back-grab handle, and flip hint are siblings of the page content,
// not children: the page's crease clip-path (and the page's own overflow) clips descendants,
// and these elements must be able to overhang the page — the flap when a large fold wraps past
// an edge, the clip because its bend wraps over the page's top edge. Order matters: the flap
// comes after the clip so the folded-over paper covers its wire when dragged across it, and the
// hint rides above everything. (The wire's back bar is separate — prepended before the page
// content in the template so the page itself hides it.)
const foldFront = `<div class="paper-clip">${paperClipOver}</div><div class="paper-fold"></div><div class="paper-back-grab"></div>${flipHint}`;

// Each page stays the SlotString the render returned. Its hoisted scripts ride in a property
// of that object, replayed only when it reaches the output whole; a concatenation or template
// literal keeps the markup and drops the scripts, which is how every slotted component lost
// its <script> for a while.
const pages = await Promise.all(
  Array.from({ length: pageCount }, (_, index) => Astro.slots.render('default', [index])),
);
---

<noscript>
  <!--
    Without JS the one stack below is the reader's copy too: these rules turn it into a plain
    scroll-snap row and switch off everything only fold-drag.ts gives meaning to. Plain CSS,
    deliberately: a <style> nested in <noscript> is the one kind Astro leaves alone — it isn't
    hoisted into the bundle (which is the point, these rules must not reach the scripted stack)
    and so it isn't compiled either. `lang="scss"` would be an inert attribute and, worse, `//`
    comments would reach the browser as parse errors that swallow the declaration after them.
    Nesting below is native CSS nesting, which needs no compiler. The !importants outrank the
    scripted sheet's own compound selectors; nothing else ever competes with them.
  -->
  <style>
    [data-paper-stack-root][data-paper-stack] {
      display: flex !important;
      flex-direction: row;
      position: relative;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scroll-behavior: smooth;
      touch-action: auto !important;
      margin-bottom: 0 !important;
      transition: none !important;

      > * {
        flex: 0 0 100%;
        /* Clip both axes — annotation SVGs are 200% overlays and otherwise inflate
           scrollWidth, leaving a permanent horizontal scrollbar on every page. */
        overflow: clip;
        scroll-snap-align: center;
        order: 0 !important;
        rotate: none !important;
        animation: none !important;
        transition: none !important;

        > * {
          clip-path: none !important;
        }

        > :is(.paper-fold, .paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
          display: none !important;
        }
      }

      @supports selector(::scroll-button(right)) {
        &::scroll-button(*) {
          position-anchor: --technical-drawing-stack;
          position: absolute;
          top: anchor(top);
        }

        &::scroll-button(left) {
          content: "⬅" / "Scroll Left";
          left: anchor(left);
        }

        &::scroll-button(right) {
          content: "⮕" / "Scroll Right";
          right: anchor(right);
        }

        &::scroll-button(*):focus-visible {
          outline-offset: 0.25rem;
        }
      }
    }
  </style>
</noscript>

<Tag
  data-paper-stack-root
  data-paper-stack
  class={className}
  style={`--page-count: ${pageCount}`}
  role="region"
  aria-label={label}
>
  {pages.map((page, index) => (
    <div class={index === 0 ? 'paper-front' : undefined} style={`--page-index: ${index + 1}`}>{index === 0 && <Fragment set:html={paperClipUnder} />}{page}{index === 0 && <Fragment set:html={foldFront} />}</div>
  ))}
</Tag>

<style lang="scss" is:global>
[data-paper-stack-root] {
  anchor-name: --technical-drawing-stack;
  anchor-scope: --technical-drawing-stack;

  &[data-paper-stack] {
    // The stack's own box is an upright rectangle around the whole fan, including the
    // margin reserved for the splay, so a ring on it misses the sheet the reader is
    // looking at. Put it on the front sheet instead: it turns with the splay, and
    // fold-drag.ts hands the paper-front class to the next page on a committed flip,
    // so the ring follows the paper.
    //
    // The sheet rather than its wrapper, and inside its edge rather than outside it,
    // because the sheet is what wears the crease clip-path: an outline drawn within
    // the clipped box is cut by that same path, so the ring bends around the folded
    // corner instead of crossing it, and it keeps doing that through a drag for free,
    // frame by frame, with no second element and no filter.
    //
    // The fold flap is in for the same reason: it is clipped to the folded-over corner,
    // so the ring runs along the dog-ear's own two edges and stops at the crease, and
    // the paper ends up ringed the way it is drawn. The clip, grab handle and hint stay
    // out: they ride on top of the page rather than being the page.
    &:focus-visible {
      outline: none;

      > .paper-front > :not(.paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
        outline: 2px solid var(--ink);
        outline-offset: -0.125rem;
      }
    }

    display: grid;
    grid-template-areas: "content";

    // A sideways swipe over the stack turns its pages (fold-drag.ts), so the browser mustn't
    // spend it panning. Vertical is left to the browser: the page still scrolls under a finger
    // that means to scroll, and it takes the gesture back the moment it decides that's what is
    // happening. Which is only half the bargain — this is settled the instant a finger lands,
    // before anyone knows what the finger is for, so a finger that turns out to be working the
    // paper would scroll the page out from under itself. fold-drag.ts cancels the touch moves of
    // any finger a gesture has claimed, which is what actually holds the page still.
    touch-action: pan-y;

    $per-page-splay: 1.5deg;
    $border-radius: calc(0.5em + 1px);

    // The folded-back corner's resting crease runs along the paper clip wire's outer-left
    // edge: intercepts (2.25em, 4.5em) by default, a 1-in-2 lean. The pin — where the wire's
    // edge bottoms out on that crease, halfway along — is where the paper is held: the splay
    // pivots around it, and the fold's crease can approach it but never cross it (see
    // fold-drag.ts).
    //
    // The lean is the one knob here, and everything downstream is derived from it rather than
    // written out again: the pin below, the wire's own angle and which edge it slides on (see
    // the svg rule), the corner cut every page wears, and — in fold-drag.ts, which reads these
    // back — the fully-folded seed a flip lands on and the direction a back-drag pulls. A stack
    // whose pages are tall can lay the clip flatter by swapping the two, which transposes the
    // whole arrangement; the default suits a page wider than it is tall.
    --fold-back-rest-x: var(--paper-clip-lean-x, 2.25em);
    --fold-back-rest-y: var(--paper-clip-lean-y, 4.5em);
    --fold-pin-x: calc(var(--fold-back-rest-x) / 2);
    --fold-pin-y: calc(var(--fold-back-rest-y) / 2);

    // Plain-CSS fallback for the first paint: until fold-drag.ts registers the typed custom
    // properties, var(--flip-progress) is undefined, which invalidates the pages' rotate below
    // at computed-value time. rotate: none doesn't just drop the splay — it stops each page
    // from being the containing block for its absolutely-positioned clip wrappers, flashing
    // the paper clip at the viewport's top-left corner while the page loads.
    --flip-progress: 0;

    // How many pages have been turned, counted onto the stack by fold-drag.ts. Same reason for
    // the fallback as above: every page's rotate reads it.
    --pages-turned: 0;

    // The folded-back top-left corner's size, inherited by every page's clip-path so the whole
    // stack's corner folds behind as one; transitioning it here is what eases the resting size
    // and the proximity tease in and out.
    transition: --fold-back-x 300ms ease-out, --fold-back-y 300ms ease-out;

    // The fan pivots every page about the pin near the top-left, so the hindmost sheet — turned
    // the furthest, by the same $per-page-splay·log(n) the pages' rotate below uses — drops
    // below the front page's bottom edge by its own width times the sine of that turn. A
    // rotation is invisible to layout, so the stack's box stops at the front page and whatever
    // follows rides up under the fan, however much gap it was given: at three demos a page wide,
    // a 4em row-gap was showing as a few pixels. Reserve the drop here, where the splay is
    // decided, so every stack pays for its own fan and the gap around one means what it says.
    // 100cqw is the *frame's* width — an element never queries a container it declares itself,
    // and the stack declares `technical-drawing` — which is the stack's own width, since it
    // spans the frame.
    margin-bottom: calc(100cqw * sin(#{$per-page-splay} * log(var(--page-count))));

    // The pile of pages already turned. The pages still to come fan out below the front one,
    // which is what says there is more underneath; the ones already turned had nothing saying
    // they were still there, since a flip drops them into that same fan, at the back of it. So
    // they leave it: a turned page rises out of the stack's top edge instead, the way it went
    // over the clip, one step further for each page turned before it. What is left to read
    // stands below, what has been read stands above, and the two piles never share an edge — the
    // top edge is also the one side free of the dog-ear, the clip and the title block.
    //
    // $turn-lift is how far each turned page rises and $turn-splay how far it swings on the pin;
    // the cues below use one, the other, or both. $turn-under is how far the band of sheet back
    // reaches down behind the front page, so it never ends in mid-air.
    $turn-lift: 0.375em;
    $turn-splay: 1.25deg;
    $turn-under: 0.75em;

    & > div {
      grid-area: content;
      border-radius: $border-radius;
      transform-origin: var(--fold-pin-x) var(--fold-pin-y);

      // The turned pages are the last --pages-turned of the order — a flip sends the front page
      // to --page-count and shifts the rest down — so this is 1 on a page that has been turned
      // and 0 on one still to come, and the rank counts 1 for the page turned most recently up
      // to --pages-turned for the first one turned, which is the one furthest out.
      --turned: clamp(0, var(--page-index) - var(--page-count) + var(--pages-turned), 1);
      --turned-rank: calc(var(--page-count) - var(--page-index) + 1);

      // Paint order. Back to front by --page-index, except that the turned pages take theirs the
      // other way round: the page turned most recently lies nearest the stack and has to paint
      // over the ones turned before it, or the pile above shows only its furthest sheet and the
      // rest hide behind that one's back. The shift (past --page-count, by twice the page's own
      // distance from it) keeps the whole pile behind every page still to come.
      order: calc(-1 * (var(--page-index) + var(--turned) * (2 * (var(--page-count) - var(--page-index)) + 1)));
      // --flip-progress (set to 1 by fold-drag.ts for the length of a drag) closes the fan by
      // one page: the front page and the one behind it square up — so their folded-back corners
      // stay flush instead of fanning a gap open at the top-left — and by the time a committed
      // flip renumbers the stack there's no rotation left to pop. --paper-peek
      // (inline, set by the back-fold tease) swings the hindmost page a little further out of
      // the fan when the pointer nears the folded-back corner, showing the page a back-drag
      // would bring over; the rotate transition below eases both effects.
      // A turned page leaves the fan below and takes the cue's own swing instead, so the fan
      // always counts the pages still to come.
      rotate: calc(
        (1 - var(--turned)) * #{$per-page-splay} * log(max(var(--page-index) - var(--flip-progress), 1))
        + var(--turned) * var(--turned-swing, 0deg)
        + var(--paper-peek, 0deg)
      );
      translate: 0 calc(-1 * var(--turned) * var(--turned-rise, 0px));
      // TODO transition rotate at startup isn't working
      transition: rotate 250ms ease-in-out, translate 250ms ease-in-out;

      // The front page. A class rather than :first-child: fold-drag.ts hands it to the next
      // page when a completed drag flips this one onto the back of the stack, without touching
      // DOM order — so the rotate transition above can animate every page's re-splay.
      &.paper-front {
        // The page content, but not the fold flap / paper clip / grab handle / flip hint riding
        // on top of it (or the clip's back bar riding under it): clip-path clips descendants
        // too, and those must be able to overhang the page.
        > :not(.paper-fold, .paper-back-grab, .paper-clip, .paper-clip-under, .paper-flip-hint) {
          // --fold-page-w/-h (actual pixel size) are kept in sync by fold-drag.ts via
          // ResizeObserver on this div — needed because the crease's excess/ratio
          // terms below mix lengths and can't be computed against a bare percentage
          // (percentages aren't real lengths until layout, so e.g. dividing by --fold-x
          // wouldn't type-check against 100%).
          //
          // The crease is the line through (--fold-page-w - fold-x, H) and (W, --fold-page-h -
          // fold-y) — same two points as before — clipped to the page rectangle. Which edges it
          // actually crosses (bottom+right / left+right / bottom+top / left+top) depends on
          // whether fold-x exceeds the page width and/or fold-y exceeds its height; crease1/
          // crease2 below is a single closed form that covers all four cases continuously, so
          // the polygon further down never needs to branch on which case it's in. Keeping the
          // crease away from the pin is fold-drag.ts's job (the rim clamp in onFoldDrag), not
          // this formula's — flooring these above 0 would bend the crease.
          --crease-excess-x: max(var(--fold-x) - var(--fold-page-w), 0px);
          --crease-excess-y: max(var(--fold-y) - var(--fold-page-h), 0px);
          --crease1-x: max(var(--fold-page-w) - var(--fold-x), 0px);
          // Each intercept below needs how far the crease has overrun the page as a fraction of
          // its own reach — one length over another, written the obvious way as (a / b). Firefox
          // won't type-check that division and throws the whole clip-path out as invalid, which
          // leaves the front page uncut: no dog-ear, and no folded-back corner at the top left
          // either. (A drag paints its own inline clip-path, so the corner would appear under the
          // hand and vanish again the moment the CSS rule took back over.) tan(atan2(a, b)) is
          // that same a/b as a plain number, out of trig functions every engine does have.
          // max() on the divisors keeps atan2 off (0, 0), which is undefined: at --fold-x/y 0
          // (before the reveal animation's delay ends) the ratio would otherwise be 0/0 → NaN,
          // which censors into a polygon missing half the page. The floor only kicks in when the
          // excess is 0 anyway, so it never changes the shape.
          --crease1-y: clamp(
            0px,
            var(--fold-page-h) - var(--fold-y) * tan(atan2(var(--crease-excess-x), max(var(--fold-x), 1px))),
            var(--fold-page-h)
          );
          --crease2-x: clamp(
            0px,
            var(--fold-page-w) - var(--fold-x) * tan(atan2(var(--crease-excess-y), max(var(--fold-y), 1px))),
            var(--fold-page-w)
          );
          --crease2-y: max(var(--fold-page-h) - var(--fold-y), 0px);

          // The two corners here (bottom-left, top-right) collapse to zero-area "spikes" when
          // the fold doesn't reach that far — see crease1/crease2 above — so this one polygon
          // covers every case without branching. The first and last vertices cut the top-left
          // corner folded away behind the stack (every other page cuts the same corner — see
          // the &:not(.paper-front) rule below); at 0 they collapse to (0, 0).
          clip-path: polygon(
            var(--fold-back-x) 0px,
            0px var(--fold-back-y),
            0px var(--fold-page-h),
            var(--crease1-x) var(--crease1-y),
            var(--crease2-x) var(--crease2-y),
            var(--fold-page-w) 0px
          );
        }

        // Invisible handle over the folded-back top-left corner — grabbing it (once the stack
        // has flipped, see [data-paper-flipped] below) drags the previous page back over the
        // front.
        & > .paper-back-grab {
          position: absolute;
          left: 0;
          top: 0;
          width: calc(var(--fold-back-x) + 1em);
          height: calc(var(--fold-back-y) + 1em);
          touch-action: none;
          cursor: grab;
          display: none;

          &:active {
            cursor: grabbing;
          }
        }

        // Commit feedback: fades in riding the flap (fold-drag.ts keeps left/top at the flap's
        // visual center every drag frame) while releasing would carry the gesture through (see
        // .paper-fold--will-commit above).
        & > .paper-flip-hint {
          position: absolute;
          translate: -50% -50%;
          width: 2.5em;
          height: 2.5em;
          color: var(--ink);
          filter: drop-shadow(0 1px 2px rgb(0 0 0 / 35%));
          opacity: 0;
          scale: 0.5;
          transition: opacity 200ms ease-out, scale 200ms ease-out;
          pointer-events: none;
        }

        &:has(> .paper-fold--will-commit) > .paper-flip-hint {
          opacity: 1;
          scale: 1;
        }

        // Both wire layers ride in full-page wrappers so the svg can position against the page
        // box. The wrappers repeat the pages' folded-back corner cut (their svg must overhang
        // the page, so they can't just live under the page's own clip-path): the crease edge
        // between the last two vertices runs through the cut's real intercepts, and the two
        // extension vertices flanking them continue it past the page box at the resting lean,
        // far enough to clear the wire's overhang — one flanks the top intercept by a whole
        // (rest-x, -rest-y) step, the other reaches 3em out past the left edge and drops
        // whatever the lean makes that (hence the tan(atan2()) rise-over-run; a bare ratio is
        // a division Firefox won't take, see the crease formula above). At --fold-back 0 the
        // cut collapses to a
        // line through the corner that the wire sits just clear of (its outer-right edge rides
        // the resting crease, one wire-width away); at rest the crease edge coincides with
        // that outer-right edge — the wire disappears in sync with the corner folding back.
        & > .paper-clip,
        & > .paper-clip-under {
          position: absolute;
          inset: 0;
          pointer-events: none;
          clip-path: polygon(
            calc(var(--fold-back-x) + var(--fold-back-rest-x)) calc(-1 * var(--fold-back-rest-y)),
            calc(100% + 3em) calc(-1 * var(--fold-back-rest-y)),
            calc(100% + 3em) calc(100% + 3em),
            -3em calc(100% + 3em),
            -3em calc(var(--fold-back-y) + 3em * tan(atan2(var(--fold-back-rest-y), var(--fold-back-rest-x)))),
            0px var(--fold-back-y),
            var(--fold-back-x) 0px
          );
        }

        & > .paper-clip > svg,
        & > .paper-clip-under > svg {
          position: absolute;
          left: var(--fold-pin-x);
          top: var(--fold-pin-y);
          // The wire's outer-right edge lies on the resting fold-back crease: its bottom point
          // (viewBox 24.5, 50 → 87.5%, 78.125% of the box) sits on the pin, and the lean
          // matches the crease's own slope, which is what the rotate reads off the intercepts
          // (atan(1/2) from vertical at the default lean). The body extends from that edge
          // toward the page corner — the side a flip folds behind the stack — and the width is
          // sized against the crease's clearance from that corner, rest-x·rest-y/|rest|, which
          // a swapped lean leaves untouched: much wider and the wire's flank crosses the corner
          // and hangs off the page.
          //
          // The wire runs 3.125em from the pin one way and 0.875em the other, so the bend end
          // always overshoots the crease's nearer intercept and pokes off the page there —
          // which reads as a clip slid all the way onto that edge, and so has to be the edge
          // the wire lies more along. Standing the box up (no flip) sends the bend to the top
          // intercept, which is right while the crease is steeper than 45°; past that the wire
          // is more horizontal than vertical and belongs on the left edge instead, so it turns
          // end for end. scaleY is that turn — a reflection along the wire's own length, which
          // moves the bend without taking the body off the corner side the way a half-turn
          // would — and sign() picks it straight off the lean, so the edge can't fall out of
          // step with the angle. (The two are only ambiguous at exactly 45°, where sign() is 0
          // and the wire would collapse; a lean that square has no edge to prefer anyway.)
          translate: -87.5% -78.125%;
          transform-origin: 87.5% 78.125%;
          rotate: atan2(var(--fold-back-rest-x), var(--fold-back-rest-y));
          transform: scaleY(sign(var(--fold-back-rest-y) - var(--fold-back-rest-x)));
          width: 1.75em;
          height: auto;
        }

        & > .paper-clip > svg {
          filter: drop-shadow(0 1px 2px rgb(0 0 0 / 45%));
        }

        &:has(> .paper-fold:hover) {
          animation-play-state: paused;
        }

        animation:
          500ms 500ms ease-in-out initial-fold-reveal 1 forwards,
          7.5s 1.5s ease-in-out fold-reveal-pulse infinite alternate
        ;

        @media (prefers-reduced-motion: reduce) {
          animation-iteration-count: 1, 0;
        }

        @keyframes initial-fold-reveal {
          from { --fold-x: 0cm; --fold-y: 0cm; }
          to { --fold-x: 2cm; --fold-y: 1cm; }
        }

        @keyframes fold-reveal-pulse {
          from, 50% { --fold-x: 2cm; --fold-y: 1cm; }
          90%, to { --fold-x: 3cm; --fold-y: 2cm; }
        }
      }

      // The same top-left corner cut as the front page's polygon above — the fold-back sizes
      // are inherited from the stack, so every page's corner folds behind as one. Unconditional
      // (not scoped to [data-paper-flipped]) so the cut grows and shrinks with the transitioned
      // sizes instead of popping when the attribute toggles.
      &:not(.paper-front) > * {
        clip-path: polygon(var(--fold-back-x) 0px, 0px var(--fold-back-y), 0px 100%, 100% 100%, 100% 0px);
      }

      // The fold flap. Styled at this level rather than under .paper-front: a committed flip
      // restacks the pages at the fold's furthest reach, and the flap then rides the flipped
      // sheet — no longer the front page — while it folds back down behind the stack.
      & > .paper-fold {
        width: calc(var(--fold-x));
        height: calc(var(--fold-y));

        clip-path: polygon(0% 0%, 0% 100%, calc(100% - var(--fold-x)) 100%, 100% calc(100% - var(--fold-y)), 100% 0%);

        border-top-left-radius: $border-radius;

        $angle: atan2(var(--fold-y), var(--fold-x));
        transform-origin: center;
        transform: rotate(calc(-1 * #{$angle})) scaleX(-1) rotate(calc(#{$angle}));

        // The back of the sheet: plain paper, no page texture. --paper-surface is the page's
        // own resolved background color, lifted onto the sheet by fold-drag.ts — as a sibling
        // of the page this element can't see background definitions scoped inside it (e.g. a
        // blueprint page redefining its surface).
        background: var(--paper-surface, var(--surface-sunken));
        border: 1px solid var(--line-strong);
        filter: brightness(75%);
        transition: filter 200ms ease-out;

        position: absolute;
        right: -1px;
        bottom: -1px;
        touch-action: none;

        // While dragging (and briefly during the release settle), fold-drag.ts switches to
        // this full-size mode and drives clip-path/transform directly via inline styles —
        // the crease can now wrap around either corner, so it no longer fits in a box
        // tightly sized to fold-x/fold-y the way the idle state above does.
        &.paper-fold--active {
          width: auto;
          height: auto;
          inset: 0;
          // Full-size, so every box corner coincides with a page corner: rounding them all
          // rounds whichever folded-over page corners the hole polygon includes (the clip
          // vertices there are sharp, but they pass exactly through the box corners, so the
          // rounded painting shows through).
          border-radius: $border-radius;
        }

        &:hover {
          cursor: grab;
          filter: brightness(95%);
        }

        &:active {
          cursor: grabbing;
        }

        // The drag is far enough along that releasing here carries it through — the page onto
        // the back of the stack going forward, or the previous page landing in front coming
        // back. Lift the flap's brightness (past the hover value, which applies throughout a
        // drag) so crossing the threshold reads as a state change.
        &.paper-fold--will-commit {
          filter: brightness(115%) drop-shadow(0 0 0.5em rgb(0 0 0 / 35%));
        }

        // A committed flip keeps this flap on the outgoing sheet until it has folded away behind
        // the stack, so fold-drag.ts stands a second one in on the page taking the front, which
        // would otherwise wear a bare corner cut until the flip ended. It only paints the resting
        // dog-ear: the hand still finds the real flap, which takes this one's place the moment the
        // flip is done with it.
        &.paper-fold--stand-in {
          pointer-events: none;
        }
      }
    }

    // Cue 1, the swing. The turned pages stay bare and lean back over the clip on the same pin
    // the fan turns on, so what stands above the stack is each sheet's own top edge: a wedge
    // per page, widening away from the clip, mirroring the fan below.
    &[data-stack-cue="1"] > div {
      --turned-swing: calc(-1 * #{$turn-splay} * log(1 + var(--turned-rank)));
    }

    // Cue 2, the backs. Each turned page rises square out of the top edge and paints the blank
    // back of its own sheet, so the pile is face-down paper and the number of edges in it is
    // the number of pages read.
    &[data-stack-cue="2"] > div {
      --turned-rise: calc(#{$turn-lift} * var(--turned-rank));
    }

    // Cue 3, the leaning backs. The same sheet backs, closer together and fanned on the pin, so
    // the pile leans the way the pages went instead of standing square to the stack.
    &[data-stack-cue="3"] > div {
      --turned-rise: calc(0.25em * var(--turned-rank));
      --turned-swing: calc(-1 * 0.375deg * var(--turned-rank));
    }

    // The band of sheet back a risen page shows above the front one: the page's own colour,
    // which fold-drag.ts lifts onto it because a background defined inside the page can't be
    // seen from out here, darkened exactly as the fold flap darkens the same paper, with the
    // sheet's hairline edge and its corner. It runs $turn-under behind the front page, so the
    // bottom of the band is never in view and what shows is exactly how far the sheet has
    // risen. ::after, not ::before: the page content would paint over it. The opacity is not
    // transitioned on purpose — a page coming back is the front page the moment it is promoted,
    // and a band fading out over it would wipe across the top of the sheet.
    &[data-stack-cue="2"] > div::after,
    &[data-stack-cue="3"] > div::after {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: calc(var(--turned-rise, 0px) + #{$turn-under});
      // The left end carries the same folded-back corner as the sheet it belongs to: the cut's
      // own crease, continued up through the band, so the pile's ends step along the diagonal
      // rather than stopping against a wall of their own. (tan(atan2()) is the band's height
      // over the crease's drop as a plain number — a bare division of two lengths is one
      // Firefox throws the whole clip-path out for; see the front page's crease above.)
      clip-path: polygon(
        var(--fold-back-rest-x) 0px,
        100% 0px,
        100% 100%,
        calc(var(--fold-back-rest-x) * (1 - tan(atan2(var(--turned-rise, 0px) + #{$turn-under}, var(--fold-back-rest-y))))) 100%
      );
      background: var(--paper-surface, var(--surface-sunken));
      border: 1px solid var(--line-strong);
      border-top-right-radius: $border-radius;
      filter: brightness(94%);
      opacity: var(--turned);
      pointer-events: none;
    }

    // Once a page has been flipped to the back there is a previous page to go back to: the
    // stack's top-left corner rests folded away behind, and the grab handle over it activates.
    // The resting cut is the crease the paper clip pins: it runs along the wire's outer-left
    // edge, passing through the pin (the pin sits halfway down it, so pin = rest/2 satisfies
    // the crease equation exactly). fold-drag.ts's tease keeps the crease in that pinned
    // family, pivoting it around the pin.
    &[data-paper-flipped] {
      --fold-back-x: var(--fold-back-rest-x);
      --fold-back-y: var(--fold-back-rest-y);

      > .paper-front > .paper-back-grab {
        display: block;
      }
    }
  }
}
</style>

<script>
  import { initPaperStackFold } from './fold-drag';
  initPaperStackFold();
</script>
