      &::scroll-button(*):enabled:hover {
        background-color: color-mix(in oklch, var(--surface-raised), var(--accent) 8%);
      }

      // Dimmed, the ring still has to read over both the sheet and the mat it straddles.
      &::scroll-button(*):disabled {
