<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

.all-together-layer {
  width: min(#{drawing.$artwork-width}, 100%);
  max-width: 100%;
  aspect-ratio: 1;
  display: grid;
  place-items: center;

  // Each part runs its own copy of the 15 s timeline, so a frame restyles only the parts that
  // move and the turn of the scene stays a transform
  $timing: 15s linear infinite;

  // Every property rests at the logo itself when nothing animates it
  @media (prefers-reduced-motion: reduce) {
    &:not([data-full-motion] *) :is(.scene, .face-mask-full, .face-mask-path, .path, path) {
      animation: none;
    }
  }

  .scene {
    width: 60%;
    aspect-ratio: 1;
    display: grid;
    transform-style: preserve-3d;
    transform: rotateX(0deg) rotateY(0deg);
    animation: visrez-logo-all-together-scene $timing;
  }

  svg {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .face {
    transform: translateZ(0);
  }

  .face-mask-full {
    opacity: 0;
    animation: visrez-logo-all-together-mask-full $timing;
  }

  .face-mask-path {
    opacity: 0;
    animation: visrez-logo-all-together-mask-path $timing;
  }

  .path {
    transform: translateZ(0em);
    animation: visrez-logo-all-together-path $timing;

    path {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 0;
    }
  }

  .stroke-gradient {
    animation: visrez-logo-all-together-stroke-gradient $timing;
  }

  .stroke-white {
    opacity: 0;
    animation: visrez-logo-all-together-stroke-white $timing;
  }

  @keyframes visrez-logo-all-together-scene {
    0%, 12% {
      transform: rotateX(0deg) rotateY(0deg);
    }

    20%, 48%, 52%, 58%, 62% {
      transform: rotateX(-30deg) rotateY(45deg);
    }

    71% {
      transform: rotateX(-3deg) rotateY(4.5deg);
    }

    72%, 100% {
      transform: rotateX(0deg) rotateY(0deg);
    }
  }

  @keyframes visrez-logo-all-together-mask-full {
    0%, 12% {
      opacity: 0;
    }

    20%, 48%, 52% {
      opacity: 1;
    }

    58%, 62%, 71%, 72%, 100% {
      opacity: 0;
    }
  }

  @keyframes visrez-logo-all-together-mask-path {
    0%, 12%, 20%, 48%, 52% {
      opacity: 0;
    }

    58%, 62%, 71% {
      opacity: 1;
    }

    72%, 100% {
      opacity: 0;
    }
  }

  @keyframes visrez-logo-all-together-path {
    0%, 12% {
      transform: translateZ(0em);
    }

    20%, 48%, 52%, 58%, 62% {
      transform: translateZ(6em);
    }

    71% {
      transform: translateZ(0.6em);
    }

    72%, 100% {
      transform: translateZ(0em);
    }
  }

  @keyframes visrez-logo-all-together-stroke-gradient {
    0%, 12% {
      stroke-dasharray: 1 1;
      opacity: 1;
    }

    19.99% {
      stroke-dasharray: 1 1;
    }

    20% {
      stroke-dasharray: 0 1;
      opacity: 0;
    }

    48%, 52%, 58%, 62% {
      stroke-dasharray: 1 1;
      opacity: 0;
    }

    67% {
      opacity: 1;
    }

    71%, 72%, 100% {
      stroke-dasharray: 1 1;
      opacity: 1;
    }
  }

  @keyframes visrez-logo-all-together-stroke-white {
    0%, 12% {
      stroke-dasharray: 1 1;
      opacity: 0;
    }

    19.99% {
      stroke-dasharray: 1 1;
    }

    20% {
      stroke-dasharray: 0 1;
      opacity: 1;
