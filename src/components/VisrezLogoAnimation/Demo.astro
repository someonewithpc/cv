---
import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import Annotation from '@/components/TechnicalDrawing/Annotation.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';
import PostIt from '@/components/PostIt.astro';

import Result from './Result.astro';
import VisrezLogoAnimationRaw from './Result.astro?raw';
import OriginalVisrezLogo from './OriginalLogo.astro';
import OriginalVisrezLogoRaw from './OriginalLogo.astro?raw';
import CubeLayer from './Cube/Layer.astro';

function toKiB(text: string) {
  return Math.ceil(text.length / 1024 * 10) / 10 + 'KiB';
}

const visrezLogoAnimationSize = toKiB(VisrezLogoAnimationRaw);
const originalVisrezLogoSize = toKiB(OriginalVisrezLogoRaw);
---

<TechnicalDrawingStack
  subtitle="Visrez Animated Loading Logo"
  scale="3:1"
  size={visrezLogoAnimationSize}
  date="2023"
  layers={{
    main: { name: null, size: visrezLogoAnimationSize },
    original: { name: 'Original Logo', size: originalVisrezLogoSize, pageStyle: 'blueprint' },
    cube: { name: 'Cube :)' },
  }}
>
  <fragment
    slot="layers"
  >
    {(layer) => ({
      main: (
        <Result />
      ),
      original: (
        <Annotations>
          <OriginalVisrezLogo slot="content" style="scale: 0.675" />
          <Fragment slot="annotations">
            <path d="M 0.3 -0.5 l 0.125 -0.175 l 1 0" />
            <text x="0.42" y="-0.72">3 Overlapping <tspan class="monospace" fill="var(--accent-800)">&lt;span&gt;</tspan></text>

            <path d="M -0.3 -0.5 l -0.5 -0.6 l 1.07 0" />
            <text x="-0.83" y="-1.14">Overly complex structure</text>

            <path d="M 0.3 0.5 l 0.5 0.6 l -1.4 0" />
            <text x="-0.6" y="1.06">Awkwardly sized <tspan class="monospace" fill="var(--accent-800)">viewBox</tspan></text>
          </Fragment>
        </Annotations>
      ),
      cube: (
        <CubeLayer />
      ),
    }[layer])}
  </fragment>

  <fragment
    slot="aside"
  >
    {(layer) => ({
      original: (
        <PostIt background="#ea1" color="black">
          The original logo was created in Illustrator and had problems which made animating it harder
        </PostIt>
      ),
      cube: (
        <div style="display: flex; flex-direction: column; gap: 3em; align-items: center;">
          <PostIt background="#3a3" color="black">
            We can think of the logo as a rotated cube
          </PostIt>

          <div style="font-size: 1.5rem; padding: 1em; border: 1px solid var(--fg-800); border-radius: 0.5em;">
            <math display="block" xmlns="http://www.w3.org/1998/Math/MathML">
              <mrow>
                <mfrac>
                  <mrow>
                    <mi>sin</mi><mo>(</mo><mrow><mn>45</mn><mo>&#xb0;</mo></mrow><mo>)</mo>
                  </mrow>
                  <mrow><mn>2</mn></mrow>
                </mfrac>
                <mo>=</mo>
                <msqrt>
                  <mrow>
                    <mn>2</mn>
                  </mrow>
                </msqrt>
                <mo>&asymp;</mo>
                <mn>0.707</mn>
              </mrow>
            </math>
          </div>
        </div>
      ),
    }[layer])}
    </fragment>
</TechnicalDrawingStack>
