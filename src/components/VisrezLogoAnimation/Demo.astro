---
import TechnicalDrawing from '@/components/TechnicalDrawing.astro';
import Result from './Result.astro';
import VisrezLogoAnimationRaw from './Result.astro?raw';

function toKiB(text: string) {
  return Math.ceil(text.length / 1024 * 10) / 10 + 'KiB';
}

const visrezLogoAnimationSize = toKiB(VisrezLogoAnimationRaw);
---

<TechnicalDrawing
  title="Visrez Animated Loading Logo"
  scale="3:1"
  size={visrezLogoAnimationSize}
  date="2023"
  layers={{
    main: 'Result',
    original: 'Original Logo',
  }}
>
  <fragment
    slot="layers"
  >
    {(layer) => ({
      main: (<Result />),
      yo: (<Result />),
    }[layer])}
  </fragment>
</TechnicalDrawing>
