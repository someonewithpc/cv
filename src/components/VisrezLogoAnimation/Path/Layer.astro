---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';
---

<div class="wrapper">
  <Annotations reach={1.6} scale={0.85}>
    <svg class="path-layer" aria-hidden="true" focusable="false" viewBox="-1 -1 2 2" slot="content">
      <g transform="translate(0, 0.2) scale(.707)">
        <circle cx="1" cy="-0.707" r={0.224 / 2} fill="gray" class="first-vertex-virtual" />
        {/* The drawn vertices, as the stroke covers them: unpainted, for the callouts to anchor to. */}
        <circle cx="0.6" cy="-0.4242" r={0.224 / 2} fill="none" data-vertex="first" />
        <circle cx="0" cy="0" r={0.224 / 2} fill="none" data-vertex="second" />
        <circle cx="-1" cy="-0.707" r={0.224 / 2} fill="none" data-vertex="third" />
        <path
          d="M.6-.42L0 0l-1-.707 1-.707 1 .707v1L0 1l-1-.707V-.2"
          stroke-width=".224"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
          pathLength="1"
        />
      </g>
    </svg>

    <Fragment slot="annotations">
      {/* Each tip lands on the edge of its vertex's circle, on the side the shaft comes
          from, so the arrowhead is not under the stroke. */}
      <ArrowAnnotation
        target=".first-vertex-virtual"
        anchor="0.854 0.146"
        tipX={0.77}
        tipY={-0.36}
        angle={30}
        length={0.2}
        text="(1.0, -0.707)"
        textClass="monospace first-vertex-virtual"
        arrowClass="first-vertex-virtual"
      />

      <ArrowAnnotation
        target='[data-vertex="first"]'
        anchor="0.854 0.854"
        tipX={0.48}
        tipY={-0.04}
        angle={-30}
        length={0.2}
        text="(1.0, -0.707) * 0.6"
        textClass="monospace first-vertex"
        arrowClass="first-vertex"
      />

      <ArrowAnnotation
        target='[data-vertex="second"]'
        anchor="0.854 0.854"
        tipX={0.06}
        tipY={0.26}
        angle={-30}
        length={0.2}
        text="(0.0, 0.0)"
        textClass="monospace second-vertex"
        arrowClass="second-vertex"
      />

      {/* The label is pushed right of the shaft's foot, so the shaft's climb clears it. */}
      <ArrowAnnotation
        target='[data-vertex="third"]'
        anchor="0.146 0.854"
        tipX={-0.76}
        tipY={-0.24}
        angle={-30 - 90}
        length={0.5}
        labelSide="right"
        lengthOffset={{ x: 0.15, y: 0 }}
        text="(-1.0, -0.707)"
        textClass="monospace third-vertex"
        arrowClass="third-vertex"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

@property --first-vertex-virtual-visible {
  syntax: 'visible | hidden';
  inherits: true;
  initial-value: visible;
}

@property --first-vertex-visible {
  syntax: 'visible | hidden';
  inherits: true;
  initial-value: visible;
}

@property --second-vertex-visible {
  syntax: 'visible | hidden';
  inherits: true;
  initial-value: hidden;
}

@property --third-vertex-visible {
  syntax: 'visible | hidden';
  inherits: true;
  initial-value: hidden;
}

@property --path-dash-offset {
  syntax: '<number>';
  inherits: true;
  initial-value: 1;
}

.wrapper {
  width: min(#{drawing.$artwork-width}, 100%);
  max-width: 100%;
  aspect-ratio: 1;

  .path-layer {
    width: 100%;
    height: 100%;
  }

  path {
    stroke: white;
    stroke-dasharray: 1;
    stroke-dashoffset: var(--path-dash-offset);
  }

  :global(.first-vertex-virtual) {
    visibility: var(--first-vertex-virtual-visible);
  }

  :global(.first-vertex) {
    visibility: var(--first-vertex-visible);
  }

  :global(.second-vertex) {
    visibility: var(--second-vertex-visible);
  }

  :global(.third-vertex) {
    visibility: var(--third-vertex-visible);
  }

  animation: visrez-logo-path-dash-animation-demo-path-layer 10s 0.5s linear forwards infinite;

  @keyframes visrez-logo-path-dash-animation-demo-path-layer {
    from {
      --path-stroke: white;
      --path-dash-offset: 0.999;
      --first-vertex-virtual-visible: visible;
    }

    20% {
      --first-vertex-virtual-visible: hidden;
      --path-dash-offset: 0.9;
    }

    30% {
      --first-vertex-visible: hidden;
      --second-vertex-visible: visible;
    }

    40% {
      --second-vertex-visible: hidden;
      --first-vertex-virtual-visible: hidden;
    }

    55% {
      --third-vertex-visible: visible;
    }

    56% {
      --third-vertex-visible: hidden;
    }

    63% {
      --first-vertex-virtual-visible: visible;
      --first-vertex-visible: hidden;
    }

    85%, to {
      --first-vertex-virtual-visible: hidden;
      --first-vertex-visible: hidden;
      --path-dash-offset: 0;
    }
  }
}
</style>
