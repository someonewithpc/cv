---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';
---

<div class="wrapper">
  <Annotations seed="visrez-logo-path" reach={1.6} scale={0.85}>
    <svg class="path-layer" aria-hidden="true" focusable="false" viewBox="-1 -1 2 2" slot="content">
      <g transform="translate(0, 0.2) scale(.707)">
        <circle cx="1" cy="-0.707" r={0.224 / 2} class="first-vertex-virtual" />
        {/* The drawn vertices, as the stroke covers them: unpainted, for the callouts to anchor to. */}
        <circle cx="0.6" cy="-0.4242" r={0.224 / 2} fill="none" data-vertex="first" />
        <circle cx="0" cy="0" r={0.224 / 2} fill="none" data-vertex="second" />
        <circle cx="-1" cy="-0.707" r={0.224 / 2} fill="none" data-vertex="third" />
        <path
          d="M.6-.42L0 0l-1-.707 1-.707 1 .707v1L0 1l-1-.707V-.2"
          stroke-width=".224"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
          pathLength="1"
        />
      </g>
    </svg>

    <Fragment slot="annotations">
      {/* Each tip lands on the edge of its vertex's circle, on the side the shaft comes
          from, so the arrowhead is not under the stroke. */}
      <ArrowAnnotation
        target=".first-vertex-virtual"
        anchor="0.854 0.146"
        tipX={0.77}
        tipY={-0.36}
        angle={30}
        length={0.2}
        text="(1.0, -0.707)"
        textClass="monospace first-vertex-virtual"
        arrowClass="first-vertex-virtual"
      />

      <ArrowAnnotation
        target='[data-vertex="first"]'
        anchor="0.854 0.854"
        tipX={0.48}
        tipY={-0.04}
        angle={-30}
        length={0.2}
        text="(1.0, -0.707) * 0.6"
        textClass="monospace first-vertex"
        arrowClass="first-vertex"
      />

      <ArrowAnnotation
        target='[data-vertex="second"]'
        anchor="0.854 0.854"
        tipX={0.06}
        tipY={0.26}
        angle={-30}
        length={0.2}
        text="(0.0, 0.0)"
        textClass="monospace second-vertex"
        arrowClass="second-vertex"
      />

      {/* The label is pushed right of the shaft's foot, so the shaft's climb clears it. */}
      <ArrowAnnotation
        target='[data-vertex="third"]'
        anchor="0.146 0.854"
        tipX={-0.76}
        tipY={-0.24}
        angle={-30 - 90}
        length={0.5}
        labelSide="right"
        lengthOffset={{ x: 0.15, y: 0 }}
        text="(-1.0, -0.707)"
        textClass="monospace third-vertex"
        arrowClass="third-vertex"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

.wrapper {
  width: min(#{drawing.$artwork-width}, 100%);
  max-width: 100%;
  aspect-ratio: 1;

  .path-layer {
    width: 100%;
    height: 100%;
  }

  // Each part runs its own copy of the 10 s timeline, so a frame restyles and repaints only the
  // part that moves. The vertices switch on and off with steps at the moments they did when
  // the timeline drove inherited custom properties.
  $timing: 10s 0.5s linear forwards infinite;

  path {
    stroke: var(--ink);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: visrez-logo-path-layer-dash $timing;
  }

  :global(.first-vertex-virtual) {
    animation: visrez-logo-path-layer-first-vertex-virtual $timing;
    animation-timing-function: step-end;
  }

  :global(circle.first-vertex-virtual) {
    fill: var(--ink-faint);
  }

  :global(.first-vertex) {
    animation: visrez-logo-path-layer-first-vertex $timing;
    animation-timing-function: step-end;
  }

  :global(.second-vertex) {
    visibility: hidden;
    animation: visrez-logo-path-layer-second-vertex $timing;
    animation-timing-function: step-end;
  }

  :global(.third-vertex) {
    visibility: hidden;
    animation: visrez-logo-path-layer-third-vertex $timing;
    animation-timing-function: step-end;
  }

  @media (prefers-reduced-motion: reduce) {
    &:not([data-full-motion] *) {
      path,
      :global(:is(.first-vertex-virtual, .first-vertex, .second-vertex, .third-vertex)) {
        animation: none;
      }

      path {
        stroke-dashoffset: 0;
      }

      :global(:is(.first-vertex-virtual, .first-vertex)) {
        visibility: hidden;
      }
    }
  }

  @keyframes visrez-logo-path-layer-dash {
    from {
      stroke-dashoffset: 0.999;
    }

    20% {
      stroke-dashoffset: 0.9;
    }

    85%, to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes visrez-logo-path-layer-first-vertex-virtual {
    from {
      visibility: visible;
    }

    10% {
      visibility: hidden;
    }

    51.5% {
      visibility: visible;
    }

    74%, to {
      visibility: hidden;
    }
  }

  @keyframes visrez-logo-path-layer-first-vertex {
    from {
      visibility: visible;
    }

    15%, to {
      visibility: hidden;
    }
  }

  @keyframes visrez-logo-path-layer-second-vertex {
    from {
      visibility: hidden;
    }

    15% {
      visibility: visible;
    }

    35%, to {
      visibility: hidden;
    }
  }

  @keyframes visrez-logo-path-layer-third-vertex {
    from {
      visibility: hidden;
    }

    27.5% {
      visibility: visible;
    }

    55.5%, to {
      visibility: hidden;
    }
  }
}
</style>
