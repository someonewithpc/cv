---
/* The logo's markup with a note on each step, set by src/highlight.ts; the notes after
   `--` are no XML syntax, so they are set as comments. */
import { highlightBlock } from '@/highlight';

const listing = `<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="-1 -1 2 2"       -- Define the coordinate system to go
                            -- from (-1, -1) with a width of (2, 2)
>
  <g style="scale: 0.707;"> -- Scale the overall shape down. Because
                            -- we move up (and down) by 2 * 0.707,
                            -- the overall height becomes 4 * 0.707 = 2.828,
                            -- so we scale down by 0.707 to get a height of 2
    <path
      d="M 0.6, -0.42       -- Move to 60% of (1, -0.707)
         L  0, 0            -- Draw a line to (0, 0)
         l -1, -0.707       -- Draw a relative line by moving (-1, -0.707)
         l  1, -0.707       -- Draw a relative line by moving ( 1, -0.707)
         l  1, 0.707        -- Draw a relative line by moving ( 1, 0.707)
         v  1               -- Draw a vertical line by moving (0, 1)
         L  0, 1            -- Draw a line by moving to (0, 1)
         l -1, -0.707       -- Draw a relative line by moving (-1, -0.707)
         v -0.2"            -- Draw a vertical line by moving (0, -0.2)
      pathLength="1"        -- Tell the renderer to treat the length
                            -- of the path as being 1
    />
  </g>
</svg>
`;
---

<Fragment set:html={highlightBlock(listing, 'xml', { lineComment: '--', className: 'path-data-layer' })} />

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

:global(article.technical-drawing-stack > * > section.path-data) {
  overflow: hidden;
}

:global(article.technical-drawing-stack > * > section.path-data > .content) {
  translate: unset;
  grid-column: 1 / -1;
  grid-row: 1 / -1;
  place-self: stretch;
  width: 100%;
  height: 100%;
  font-size: 1rem;
  overflow: hidden;
  justify-content: flex-start;
  min-height: 0;

  /* Portrait gives the title block a row of its own; spanning to -1 would put
     the listing underneath it. */
  @container technical-drawing (orientation: portrait) {
    grid-row: 1;
  }

  :global(pre) {
    flex: 1 1 auto;
    min-height: 0;
    margin: 1em 1.25em;
    padding: 1em;
    max-width: 100%;
    overflow: auto;

    /* Sideways scrolling inside a swipeable carousel is a trap, so on a portrait sheet
       shrink the listing until its longest line fits the sheet instead. */
    &, :global(code) {
      font-size: drawing.portrait-or(min(0.875rem, 0.0195 * var(--sheet-inline)), 0.875rem);
      line-height: 1.35;
    }

    @container technical-drawing (orientation: portrait) {
      margin: 0.5em;
      padding: 0.5em;
    }

    & > :global(code) > :global(.line) {
      &:nth-child(1), &:nth-child(2), &:nth-child(5), &:nth-last-child(2), &:nth-last-child(1) {
        opacity: 0.5;
      }
    }
  }
}
</style>
