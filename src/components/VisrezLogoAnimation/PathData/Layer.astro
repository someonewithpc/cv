---
import { Code } from 'astro:components';
---

<div class="wrapper">
  <Code lang="xml" code='<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="-1 -1 2 2" -- Define the coordinate system to go
                      -- from (-1, -1) with a width of (2, 2)
>
  <g style="scale: 0.707;" -- Scale the overall shape down. Because
                           -- we move up (and down) by 2 * 0.707,
                           -- the overall height becomes 4 * 0.707 = 2.828,
                           -- so we scale down by 0.707 to get a height of 2
  >
    <path
      d="M 0.6, -0.42"  -- Move to 60% of (1, -O.707)
        "L  0, 0"       -- Draw a line to the absolute (0, 0)
        "l -1, -0.707"  -- Draw a relative line by moving (-1, -0.707)
        "l  1, -0.707"  -- Draw a relative line by moving ( 1, -0.707)
        "l  1, 0.707"   -- Draw a relative line by moving ( 1, 0.707)
        "v  1"          -- Draw a vertical line by moving (0, 1)
        "L  0, 1"       -- Draw a line by moving to the absolute position (0, 1)
        "l -1, -0.707"  -- Draw a relative line by moving (-1, -0.707)
        "v -O.2"        -- Draw a vertical line by moving (0, -0.2)
      pathLength="1"    -- Tell the renderer to assume the length of the path is 1
    />
  </g>
</svg>'
  />
</div>

<style lang="scss">
.wrapper {
  position: relative;

  :global(pre) {
    position: absolute;
    top: 50%;
    translate: -17.5% -60%;

    padding: 0.5em;
    font-size: 1rem;
  }

  :global(pre > code > .line) {
    &:nth-child(1), &:nth-child(2), &:nth-child(5), &:nth-last-child(2), &:nth-last-child(1) {
      opacity: 0.5;
    }
  }
}
</style>
