<figure>
  {Array.from({ length: 6 }, () => (<div class="face"/>))}
</figure>

<style lang="scss">
figure {
  $width: 10em;
  transform-style: preserve-3d;
  width: 100%;
  height: 100%;
  display: grid;

  transform-origin: calc($width / 2) calc($width / 2) 0;
  transform: rotateX(-45deg) rotateY(45deg);

  .face {
    grid-area: 1 / 1;
    inset: 0;
    width: $width;
    height: $width;
    background: var(--accent-700);
    border: 0.25em solid var(--accent-800);

    transform-origin: center center 0;

    &:nth-child(6) { transform: rotateX(-0.25turn) translateZ(calc($width / 2)); }
    &:nth-child(5) { transform: rotateX( 0.25turn) translateZ(calc($width / 2)); }
    &:nth-child(4) { transform: rotateY(-0.00turn) translateZ(calc($width / 2)); }
    &:nth-child(3) { transform: rotateY(-0.25turn) translateZ(calc($width / 2)); }
    &:nth-child(2) { transform: rotateY(-0.50turn) translateZ(calc($width / 2)); }
    &:nth-child(1) { transform: rotateY(-0.75turn) translateZ(calc($width / 2)); }

    @for $i from 1 through 6 {
      &:nth-child(#{$i}) {
        position: relative;

        &:before {
          content: "#{$i}";
          font-size: 4rem;
          position: absolute;
          left: 50%;
          top: 50%;
          translate: -50% -50%;
        }
      }
    }
  }
}
</style>
