---
import PostIt from '@/components/PostIt.astro';
---

<div class="cube-aside">
  <PostIt background="#3a3" color="black">
    We can think of the logo as a rotated cube
  </PostIt>

  <div class="formula">
    <math display="block" xmlns="http://www.w3.org/1998/Math/MathML">
      <mrow>
        <mi>sin</mi><mo>(</mo><mrow><mn>45</mn><mo>&#xb0;</mo></mrow><mo>)</mo>
        <mo>=</mo>
        <mfrac>
          <msqrt>
            <mrow>
              <mn>2</mn>
            </mrow>
          </msqrt>
          <mn>2</mn>
        </mfrac>
        <mo>&asymp;</mo>
        <mn>0.707</mn>
      </mrow>
    </math>
  </div>
</div>

<style lang="scss">
.cube-aside {
  display: flex;
  flex-direction: column;
  gap: 1em;
  align-items: center;
}

.formula {
  /* The open note dialog hands down its own type size; the equation cannot
     wrap, so at full size its border ran off narrow sheets. */
  font-size: var(--note-font-size, 1.5rem);
  max-width: 100%;
  overflow-x: auto;
  padding: 1em;
  border: 1px solid var(--sheet-ink);
  border-radius: 0.5em;
}
</style>
