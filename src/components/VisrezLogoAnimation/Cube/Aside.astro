---
import PostIt from '@/components/PostIt.astro';
---

<div class="cube-aside">
  <PostIt background="#3a3" color="black">
    We can think of the logo as a rotated cube
  </PostIt>

  <div class="formula">
    <math display="block" xmlns="http://www.w3.org/1998/Math/MathML">
      <mrow>
        <mfrac>
          <mrow>
            <mi>sin</mi><mo>(</mo><mrow><mn>45</mn><mo>&#xb0;</mo></mrow><mo>)</mo>
          </mrow>
          <mrow><mn>2</mn></mrow>
        </mfrac>
        <mo>=</mo>
        <msqrt>
          <mrow>
            <mn>2</mn>
          </mrow>
        </msqrt>
        <mo>&asymp;</mo>
        <mn>0.707</mn>
      </mrow>
    </math>
  </div>
</div>

<style lang="scss">
.cube-aside {
  display: flex;
  flex-direction: column;
  gap: 1em;
  align-items: center;
}

.formula {
  font-size: 1.5rem;
  padding: 1em;
  border: 1px solid var(--fg-800);
  border-radius: 0.5em;
}
</style>
