---
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import Cube from './Cube.astro';
---

<Annotations seed="visrez-logo-cube">
  <Cube slot="content" />
  <Fragment slot="annotations">
    {/* The tilted cube's outline is a hexagon whose right vertices sit a quarter and
        three quarters down the edges' joint box, which the script re-reads once the
        tilt has run. Before it runs the edges lie in one flat square and the tips sit
        on its right edge. */}
    <g class="annotations">
      <ArrowAnnotation
        target=".edge"
        anchor="1 0.25"
        tipX={Math.sqrt(2) / 2}
        tipY={-0.41}
        angle={30}
        length={0.2}
        text="(1.0, -0.707)"
        textClass="monospace"
      />

      <ArrowAnnotation
        target=".edge"
        anchor="1 0.75"
        tipX={Math.sqrt(2) / 2}
        tipY={0.41}
        angle={-30}
        length={0.2}
        text="(1.0, 0.707)"
        textClass="monospace"
      />
    </g>
  </Fragment>
</Annotations>

<style lang="scss">
// Drawn at once under reduced motion, unless the visitor pressed play on the sheet
@media (prefers-reduced-motion: reduce) {
  .annotations:not([data-full-motion] *) {
    :global(path) {
      animation: none;
      stroke-dashoffset: 0;
    }

    :global(text) {
      animation: none;
      clip-path: none;
    }
  }
}

.annotations {
  $duration: 0.25s;

  :global(path) {
    stroke-dasharray: 1;
    animation:
      3.1s visrez-logo-cube-marker-start 0s linear forwards 1,
      $duration visrez-logo-cube-paths 3s linear forwards 1
    ;
    stroke-dashoffset: 1;

    @keyframes visrez-logo-cube-marker-start {
      from, 99% {
        marker-start: none;
      }
    }

    @keyframes visrez-logo-cube-paths {
      from {
        stroke-dashoffset: 1;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
  }

  :global(text) {
    clip-path: rect(0 0 100% 0);
    animation: $duration visrez-logo-cube-texts 3s linear forwards 1;

    @keyframes visrez-logo-cube-texts {
      from {
        clip-path: rect(0 0 100% 0);
      }
      to {
        clip-path: rect(0 100% 100% 0);
      }
    }
  }
}
</style>
