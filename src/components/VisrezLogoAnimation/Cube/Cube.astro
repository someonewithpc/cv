<figure>
  <div class="scene">
    {Array.from({ length: 12 }, () => (<div class="edge"/>))}
  </div>
</figure>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

$width: drawing.$artwork-width * 0.5;

figure {
  --cube-size: #{$width};
  --cube-stroke: 0.25em;

  display: inline-grid;
  width: fit-content;
  height: fit-content;
  /* The padding is clearance for the spin: a tilted side reaches 0.82 of its
     length from the centre, so half a side on every edge holds it. The same
     on all four keeps the figure square, which is the box the callouts are
     measured against. */
  padding: calc(var(--cube-size) / 2);
  margin: 0;

  /* The padding is what sets the figure's min-content — em-sized it outgrew
     the portrait sheet, and cqw keeps it tied to the sheet. */
  @container technical-drawing (orientation: portrait) {
    --cube-size: 26cqw;
  }
}

.scene {
  transform-style: preserve-3d;
  width: var(--cube-size);
  height: var(--cube-size);
  display: grid;

  transform-origin: center center;
  backface-visibility: hidden;

  animation:
    0.5s ease-in forwards tilt,
    2.5s linear 0.5s forwards spin;

  $xRot: calc(atan2(1, sqrt(2)));

  @keyframes tilt {
    to {
      transform: rotateX($xRot) rotateY(45deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotateX($xRot) rotateY(45deg);
    }
    to {
      transform: rotateX($xRot) rotateY(calc(1turn + 45deg));
    }
  }

  /* Each edge is drawn once, as two strips crossed at a right angle about the
     edge's axis. Bordered faces drew every edge twice, and a lone flat strip
     thins to nothing as it turns edge-on; the cross keeps at least 0.707 of
     the stroke facing the viewer whichever way the cube sits. The strips run
     half a stroke past each end so the corners close. */
  .edge {
    --half: calc(var(--cube-size) / 2);

    grid-area: 1 / 1;
    place-self: center;
    position: relative;
    width: calc(var(--cube-size) + var(--cube-stroke));
    height: var(--cube-stroke);
    transform-style: preserve-3d;
    transform-origin: center center 0;

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--ink);
    }

    &::after {
      transform: rotateX(0.25turn);
    }

    /* Same pattern as a face (rotate, then translateZ to the surface) followed
       by the offset along the face to its rim. The front and back faces give
       the eight edges across and up; the left and right faces' rims give the
       four running front to back. */
    &:nth-child(1)  { transform: rotateY(0turn)     translateZ(var(--half)) translateY(calc(-1 * var(--half))); }
    &:nth-child(2)  { transform: rotateY(0turn)     translateZ(var(--half)) translateY(var(--half)); }
    &:nth-child(3)  { transform: rotateY(0turn)     translateZ(var(--half)) rotateZ(0.25turn) translateY(calc(-1 * var(--half))); }
    &:nth-child(4)  { transform: rotateY(0turn)     translateZ(var(--half)) rotateZ(0.25turn) translateY(var(--half)); }
    &:nth-child(5)  { transform: rotateY(0.5turn)   translateZ(var(--half)) translateY(calc(-1 * var(--half))); }
    &:nth-child(6)  { transform: rotateY(0.5turn)   translateZ(var(--half)) translateY(var(--half)); }
    &:nth-child(7)  { transform: rotateY(0.5turn)   translateZ(var(--half)) rotateZ(0.25turn) translateY(calc(-1 * var(--half))); }
    &:nth-child(8)  { transform: rotateY(0.5turn)   translateZ(var(--half)) rotateZ(0.25turn) translateY(var(--half)); }
    &:nth-child(9)  { transform: rotateY(0.25turn)  translateZ(var(--half)) translateY(calc(-1 * var(--half))); }
    &:nth-child(10) { transform: rotateY(0.25turn)  translateZ(var(--half)) translateY(var(--half)); }
    &:nth-child(11) { transform: rotateY(-0.25turn) translateZ(var(--half)) translateY(calc(-1 * var(--half))); }
    &:nth-child(12) { transform: rotateY(-0.25turn) translateZ(var(--half)) translateY(var(--half)); }
  }
}
</style>
