<figure>
  <div class="scene">
    {Array.from({ length: 6 }, () => (<div class="face"/>))}
  </div>
</figure>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

$width: drawing.$artwork-width * 0.5;

figure {
  --cube-size: #{$width};

  display: inline-grid;
  width: fit-content;
  height: fit-content;
  /* The padding is clearance for the spin: a tilted side reaches 0.82 of its
     length from the centre, so half a side on every edge holds it. The same
     on all four keeps the figure square, which is the box the callouts are
     measured against. */
  padding: calc(var(--cube-size) / 2);
  margin: 0;

  /* The padding is what sets the figure's min-content — em-sized it outgrew
     the portrait sheet, and cqw keeps it tied to the sheet. */
  @container technical-drawing (orientation: portrait) {
    --cube-size: 26cqw;
  }
}

.scene {
  transform-style: preserve-3d;
  width: var(--cube-size);
  height: var(--cube-size);
  display: grid;

  transform-origin: center center;
  backface-visibility: hidden;

  animation:
    0.5s ease-in forwards tilt,
    2.5s linear 0.5s forwards spin;

  $xRot: calc(atan2(1, sqrt(2)));

  @keyframes tilt {
    to {
      transform: rotateX($xRot) rotateY(45deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotateX($xRot) rotateY(45deg);
    }
    to {
      transform: rotateX($xRot) rotateY(calc(1turn + 45deg));
    }
  }

  .face {
    grid-area: 1 / 1;
    inset: 0;
    width: var(--cube-size);
    height: var(--cube-size);
    border: 0.25em solid var(--ink);

    transform-origin: center center 0;

    &:nth-child(6) { transform: rotateX(-0.25turn) translateZ(calc(var(--cube-size) / 2)); }
    &:nth-child(5) { transform: rotateX( 0.25turn) translateZ(calc(var(--cube-size) / 2)); }
    &:nth-child(4) { transform: rotateY(-0.00turn) translateZ(calc(var(--cube-size) / 2)); }
    &:nth-child(3) { transform: rotateY(-0.25turn) translateZ(calc(var(--cube-size) / 2)); }
    &:nth-child(2) { transform: rotateY(-0.50turn) translateZ(calc(var(--cube-size) / 2)); }
    &:nth-child(1) { transform: rotateY(-0.75turn) translateZ(calc(var(--cube-size) / 2)); }
  }
}
</style>
