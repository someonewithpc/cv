<figure>
  <div class="scene">
    {Array.from({ length: 6 }, () => (<div class="face"/>))}
  </div>
</figure>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

$width: drawing.$artwork-width * 0.5;

figure {
  display: inline-grid;
  width: fit-content;
  height: fit-content;
  padding: $width calc($width / 2);
  margin: 0;
}

.scene {
  transform-style: preserve-3d;
  width: $width;
  height: $width;
  display: grid;

  transform-origin: center center;
  backface-visibility: hidden;

  animation:
    0.5s ease-in forwards tilt,
    2.5s linear 0.5s forwards spin;

  $xRot: calc(atan2(1, sqrt(2)));

  @keyframes tilt {
    to {
      transform: rotateX($xRot) rotateY(45deg);
    }
  }

  @keyframes spin {
    from {
      transform: rotateX($xRot) rotateY(45deg);
    }
    to {
      transform: rotateX($xRot) rotateY(calc(1turn + 45deg));
    }
  }

  .face {
    grid-area: 1 / 1;
    inset: 0;
    width: $width;
    height: $width;
    border: 0.125em solid var(--accent-800);

    transform-origin: center center 0;

    &:nth-child(6) { transform: rotateX(-0.25turn) translateZ(calc($width / 2)); }
    &:nth-child(5) { transform: rotateX( 0.25turn) translateZ(calc($width / 2)); }
    &:nth-child(4) { transform: rotateY(-0.00turn) translateZ(calc($width / 2)); }
    &:nth-child(3) { transform: rotateY(-0.25turn) translateZ(calc($width / 2)); }
    &:nth-child(2) { transform: rotateY(-0.50turn) translateZ(calc($width / 2)); }
    &:nth-child(1) { transform: rotateY(-0.75turn) translateZ(calc($width / 2)); }
  }
}
</style>
