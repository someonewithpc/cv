---
import { exampleConfig, listInstances } from '../config';
import { collectFediverseHostnames, collectHostnames, subjectAltName } from '../hosts';

// Every server's names, and each place `generate` writes them. The marks come out of the same
// functions that write the files, so a name is marked in a column only if that file holds it.
const instances = listInstances(exampleConfig);
const tld = exampleConfig.defaults?.local_tld;
const inSnippet = new Set(collectHostnames(exampleConfig));
const inNix = new Set(collectFediverseHostnames(exampleConfig));

const columns = [
  { file: 'hosts.snippet', short: 'snippet', where: 'apply-hosts → /etc/hosts', has: (_: string[], name: string) => inSnippet.has(name) },
  { file: 'hosts.nix', short: '.nix', where: 'NixOS networking.hosts', has: (_: string[], name: string) => inNix.has(name) },
  { file: 'server_name', short: 'nginx', where: "the server's nginx block", has: (names: string[], name: string) => names.includes(name) },
  { file: 'subjectAltName', short: 'SAN', where: "the server's certificate", has: (names: string[], name: string) => subjectAltName(names).includes(`DNS:${name}`) },
];

const servers = instances.map((instance) => ({
  key: instance.key,
  software: instance.software,
  names: instance.hostnames.map((name) => ({
    name,
    alias: name !== instance.hostname,
    marks: columns.map((column) => column.has(instance.hostnames, name)),
  })),
}));
---

<div class="wrapper">
  <div class="hosts-layer" aria-hidden="true">
    <header>
      <strong>Every server answers to two names</strong>
      <span class="caption">
        Its hostname, and a <code>.{tld}</code> twin from <code>defaults.local_tld</code>, each written
        everywhere it has to resolve or be served
      </span>
    </header>

    <table>
      <thead>
        <tr>
          <th class="name" scope="col">name</th>
          {columns.map(({ file, short, where }) => (
            <th scope="col"><code class="file">{file}</code><code class="short">{short}</code><span class="where">{where}</span></th>
          ))}
        </tr>
      </thead>
      {servers.map(({ key, software, names }) => (
        <tbody>
          <tr class="server">
            <th colspan={columns.length + 1} scope="rowgroup">{key} <span class="where">{software}</span></th>
          </tr>
          {names.map(({ name, alias, marks }) => (
            <tr>
              <th class:list={['name', { alias }]} scope="row"><code>{name}</code></th>
              {marks.map((mark) => (
                <td class:list={{ mark }} />
              ))}
            </tr>
          ))}
        </tbody>
      ))}
    </table>

    <p class="key">
      {columns.map(({ file, short }) => <span><code>{short}</code> <code class="full">{file}</code></span>)}
    </p>

    <dl class="rules">
      <div>
        <dt>Why two</dt>
        <dd><code>*.localhost</code> already resolves to 127.0.0.1, so <code>hosts.nix</code> leaves it out. <code>*.{tld}</code> needs an entry.</dd>
      </div>
      <div>
        <dt>apply-hosts</dt>
        <dd>Merges the marked block from <code>files/hosts.snippet</code> into <code>/etc/hosts</code>.</dd>
      </div>
      <div>
        <dt>NixOS</dt>
        <dd>The flake exports <code>nixosModules.hosts</code>, which reads <code>files/hosts.nix</code>.</dd>
      </div>
      <div>
        <dt>Dev shell</dt>
        <dd>Entering it checks every <code>*.{tld}</code> name with <code>getent</code> and prints one hint if one does not resolve.</dd>
      </div>
    </dl>
  </div>
</div>

<style lang="scss">
@use "./sheet" as *;

/* The sheet centres its content by default; this one takes the whole sheet, as the live one does. */
:global(article.technical-drawing-stack > * > section .content:has(.hosts-layer)) {
  place-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
}

.wrapper {
  @include sheet-content;

  height: 100%;
  min-height: 0;

  /* The title block takes a row off the bottom of a short sheet; a portrait one gives it a
     row of its own. On a wide sheet it sits under the notes' column. */
  :global([data-sheet-width='narrow']) & {
    padding-bottom: calc(var(--title-block-block, 0px) + $sheet-margin);
  }

  :global([data-sheet-orientation='portrait']) & {
    padding-bottom: $sheet-margin;
  }
}

.hosts-layer {
  /* The notes' column is as wide as the title block under it, as on the live sheet. */
  --side: max(18em, var(--title-block-inline, 0px));

  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--side);
  grid-template-rows: auto auto auto;
  align-content: start;
  column-gap: 1.5em;
  row-gap: 0.75em;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  color: var(--ink);

  /* Keyed on the stack's attributes, not the width query: a font size that comes out of a
     container query re-lays everything under it on each resize step. See Stack.astro. */
  :global([data-sheet-width='narrow']) &,
  :global([data-sheet-orientation='portrait']) & {
    grid-template-columns: minmax(0, 1fr);

    /* The notes need a column of their own, and a short or a phone's sheet has none. */
    .rules {
      display: none;
    }
  }

  /* A phone's columns are too narrow for the file names; each takes a short one. */
  .short {
    display: none;
  }

  .key {
    display: none;
  }

  :global([data-sheet-orientation='portrait']) & .key {
    grid-row: 3;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em 1em;
    font-size: 0.75em;
    color: var(--ink-muted);

    code {
      color: var(--ink);
      font-weight: 600;
    }

    .full {
      color: inherit;
      font-weight: 400;
    }
  }

  :global([data-sheet-orientation='portrait']) & thead {
    .where,
    .file {
      display: none;
    }

    .short {
      display: inline;
    }
  }
}

header {
  grid-column: 1;
  display: grid;
  gap: 0.125em;

  strong {
    font-size: 0.9375em;
  }
}

.caption {
  font-size: 0.75em;
  line-height: 1.4;
  color: var(--ink-muted);

  /* A short sheet keeps its height for the table. */
  :global([data-sheet-width='narrow']:not([data-sheet-orientation='portrait'])) & {
    display: none;
  }
}

code {
  font-family: $code-font;
}

table {
  grid-column: 1;
  grid-row: 2;
  align-self: start;
  width: 100%;
  border-collapse: collapse;
  font-size: 0.75em;

  th,
  td {
    padding: 0.375em 0.5em;
    border-bottom: 1px solid var(--line);
  }

  thead th {
    vertical-align: bottom;
    text-align: center;
    font-weight: 600;
    border-bottom: 1px solid var(--ink);

    &.name {
      text-align: left;
    }
  }

  .where {
    display: block;
    font-weight: 400;
    font-size: 0.9em;
    color: var(--ink-muted);
  }

  /* A short sheet has the width for the file names but not the height for a second line,
     nor for four servers at the full row height. */
  :global([data-sheet-width='narrow']:not([data-sheet-orientation='portrait'])) & {
    line-height: 1.25;

    th,
    td {
      padding-block: 0.125em;
    }

    .server th {
      padding-top: 0.375em;
    }

    thead .where {
      display: none;
    }
  }

  .server th {
    padding-top: 0.625em;
    text-align: left;
    font-weight: 600;
    border-bottom-color: var(--line-strong);

    .where {
      display: inline;
      margin-left: 0.5em;
    }
  }

  th.name {
    text-align: left;
    font-weight: 400;
    white-space: nowrap;

    &.alias code {
      color: var(--accent-text);
    }
  }

  td {
    text-align: center;
  }

  /* A mark is a dot drawn in the ink, the same size in every cell. */
  td.mark::before {
    content: "";
    display: inline-block;
    width: 0.625em;
    height: 0.625em;
    border-radius: 50%;
    background: var(--ink);
    vertical-align: middle;
  }
}

.rules {
  grid-column: 2;
  grid-row: 1 / -1;
  align-self: start;
  margin: 0;
  display: grid;
  gap: 0.75em;

  div {
    display: grid;
    gap: 0.125em;
    padding-left: 0.625em;
    border-left: 1px solid var(--line-strong);
  }

  dt {
    font-size: 0.6875em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    font-size: 0.75em;
    line-height: 1.4;
    text-wrap: pretty;
  }
}
</style>
