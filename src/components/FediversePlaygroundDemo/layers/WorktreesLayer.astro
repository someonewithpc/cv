---
import { exampleConfig } from '../config';
import { planWorktrees, RUNGS, worktreeCommand } from '../worktrees';

// What each bare mirror holds on a first sync. `git clone --bare` copies origin's branches in
// as local heads and keeps no remote-tracking refs, so the third rung is there for a mirror
// cloned some other way.
const refs = {
  'social-v3': { local: ['main', 'v3'], remote: [] },
  'social-v2': { local: ['nightly'], remote: [] },
};

// The example config puts Bob on main, which collides with nothing. The sheet is drawn for the
// case the rename exists for, Bob asking for v3 while Alice's worktree holds it, and says so.
const bob = exampleConfig.instances['gnusocial-bob'];
const example = { ...exampleConfig, instances: { ...exampleConfig.instances, 'gnusocial-bob': { ...bob, branch: 'v3' } } };

const plans = planWorktrees(example, refs);
const mirrors = [...new Set(plans.map((plan) => plan.mirror))].map((mirror) => ({
  mirror,
  plans: plans.filter((plan) => plan.mirror === mirror),
}));

// The instance the ladder is drawn for: the one that had to be renamed.
const renamed = plans.find((plan) => plan.collidesWith) ?? plans[0];
const ladder = RUNGS.map((why, rung) => ({
  why,
  rung,
  command: worktreeCommand(rung, { path: renamed.worktree, branch: renamed.requested, checkout: renamed.checkout }),
  taken: rung === renamed.rung,
  skipped: rung < renamed.rung,
  unreached: rung > renamed.rung,
}));
---

<div class="wrapper">
  <div class="worktrees-layer" aria-hidden="true">
    <div class="panel">
      <header>
        <strong>One bare mirror per software, one worktree per instance</strong>
        <span class="caption">
          An example: the shipped config puts bob on {bob.branch}. Here he asks for v3, which alice's
          worktree already holds, so the branch is renamed after him.
        </span>
      </header>

      <div class="mirrors">
        {mirrors.map(({ mirror, plans }) => (
          <div class="mirror">
            <div class="repo">
              <code>{mirror}</code>
              <span class="caption">git clone --bare · fetch --all on every sync</span>
            </div>
            <ul class="trees">
              {plans.map((plan) => (
                <li class:list={{ collision: plan.collidesWith }}>
                  <code class="path">{plan.worktree}</code>
                  {plan.collidesWith ? (
                    <span class="branch">
                      <s>{plan.requested}</s>
                      <span class="held">held by {plan.collidesWith}</span>
                      <span class="arrow">→</span>
                      <code class="renamed">{plan.checkout}</code>
                    </span>
                  ) : (
                    <span class="branch"><code>{plan.checkout}</code></span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="ladder">
        <span class="caption">{renamed.instance}: the first rung that matches runs</span>
        <ol>
          {ladder.map(({ why, command, taken, skipped, unreached }) => (
            <li class:list={{ taken, skipped, unreached }}>
              <span class="why">{why}</span>
              <code>{command}</code>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include clear-of-title-block;

  margin-inline: auto;
  display: grid;
  place-items: center;
}

.worktrees-layer {
  box-sizing: border-box;
  width: min(100%, 44em);
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  color: var(--ink);

  /* Keyed on the stack's attributes, not the width query: a font size that comes out of a
     container query re-lays everything under it on each resize step. See Stack.astro. */
  :global([data-sheet-width='narrow']) & {
    /* A short landscape sheet: the type gives a little. */
    font-size: clamp(0.625rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  }

  :global([data-sheet-orientation='portrait']) & {
    font-size: min(1rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)));
  }
}

.panel {
  box-sizing: border-box;
  width: 100%;
  padding: 0.75em 0.875em;
  border: 1px solid var(--line-strong);
  border-radius: 0.5em;
  background: var(--surface-raised);
  display: grid;
  gap: 0.625em;
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.125em;

  strong {
    font-size: 0.875em;
  }
}

code {
  font-family: $code-font;
}

.caption {
  font-size: 0.625em;
  color: var(--ink-muted);
}

.mirrors {
  display: grid;
  gap: 0.5em;
}

.mirror {
  display: grid;
  grid-template-columns: 11em minmax(0, 1fr);
  align-items: start;
  gap: 0.75em;

  :global([data-sheet-orientation='portrait']) & {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25em;
  }
}

.repo {
  display: flex;
  flex-direction: column;
  gap: 0.125em;
  padding: 0.25em 0.5em;
  border: 1px solid var(--ink);
  border-radius: 0.25em;

  code {
    font-size: 0.75em;
    font-weight: 600;
  }
}

.trees {
  list-style: none;
  margin: 0;
  padding: 0 0 0 0.75em;
  border-left: 1px solid var(--line-strong);
  display: grid;
  gap: 0.25em;

  li {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75em;
    font-size: 0.75em;

    /* The branch off the mirror's trunk. */
    &::before {
      content: "";
      position: absolute;
      left: -1em;
      top: 0.7em;
      width: 0.75em;
      border-top: 1px solid var(--line-strong);
    }
  }

  .path {
    min-width: 15em;
  }
}

.branch {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.375em;

  s {
    font-family: $code-font;
    color: var(--ink-muted);
  }

  .held {
    font-size: 0.85em;
    color: var(--ink-muted);
  }

  .renamed {
    padding: 0 0.25em;
    border: 1px solid var(--accent);
    border-radius: 0.2em;
    color: var(--accent);
  }
}

.ladder {
  display: grid;
  gap: 0.25em;
  padding-top: 0.5em;
  border-top: 1px solid var(--line);

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2em;
    counter-reset: rung;
  }

  li {
    counter-increment: rung;
    display: grid;
    grid-template-columns: 1.25em 11em minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5em;
    padding: 0.125em 0.375em;
    border: 1px solid transparent;
    border-radius: 0.25em;
    font-size: 0.6875em;

    &::before {
      content: counter(rung) ".";
      color: var(--ink-muted);
    }

    :global([data-sheet-orientation='portrait']) & {
      grid-template-columns: 1.25em minmax(0, 1fr);

      code {
        grid-column: 2;
      }
    }
  }

  .why {
    color: var(--ink-muted);
  }

  code {
    overflow-wrap: anywhere;
  }

  .skipped {
    opacity: 0.6;

    code {
      text-decoration: line-through;
      text-decoration-color: var(--ink-faint);
    }
  }

  .unreached {
    opacity: 0.6;
  }

  .taken {
    border-color: var(--accent);

    .why {
      color: var(--ink);
    }
  }
}
</style>
