---
import { buildComposeFile } from '../compose';
import { exampleConfig, listInstances, withEnabled } from '../config';
import { renderSequence, type Lane, type Layout, type Step } from '../sequence';

// The lanes and the conditions on the arrows come out of the compose file the builder writes
// for Alice alone; the steps inside the installer are install/social-v3.sh's own, and the last
// row is the server block the recipe writes for her.
const compose = buildComposeFile(withEnabled(exampleConfig, { 'gnusocial-bob': false, 'gnusocial-v2': false, 'mastodon-carol': false }));
const alice = listInstances(exampleConfig).find((instance) => instance.key === 'gnusocial-alice')!;
const app = alice.instance_id;
const installer = `${app}-install`;
const condition = (service: string, dependency: string) =>
  (compose.services[service].depends_on as Record<string, { condition: string }>)[dependency].condition;
const healthcheck = compose.services.db.healthcheck as { test: string[]; interval: string; retries: number };

const prefix = 'gnusocial-';
const lanes = ['db', installer, app, 'nginx'];
const lane = (service: string) => lanes.indexOf(service);
// A lane is too narrow for a whole instance's name, so it breaks after the prefix.
const heads: Lane[] = lanes.map((id) => ({
  id,
  head: id.startsWith(prefix) ? [prefix, id.slice(prefix.length)] : [id],
}));

const steps: Step[] = [
  { kind: 'self', lane: lane('db'), text: `${healthcheck.test[1].split(' ')[0]} every ${healthcheck.interval}` },
  { kind: 'message', from: lane('db'), to: lane(installer), text: condition(installer, 'db') },
  { kind: 'self', lane: lane(installer), text: 'composer install' },
  { kind: 'message', from: lane(installer), to: lane('db'), text: 'doctrine:schema:create' },
  { kind: 'self', lane: lane(installer), text: 'app:populate_initial_values' },
  { kind: 'message', from: lane(installer), to: lane('db'), text: 'seed-v3-admin.php' },
  { kind: 'end', lane: lane(installer), text: 'exit 0' },
  { kind: 'message', from: lane(installer), to: lane(app), text: condition(app, installer), gate: true },
  { kind: 'self', lane: lane(app), text: 'entrypoint.sh' },
  { kind: 'message', from: lane(app), to: lane('nginx'), text: 'nginx.depends_on' },
  { kind: 'self', lane: lane('nginx'), text: `server_name ${alice.hostnames.join(' ')}` },
];

const layouts: Layout[] = ['landscape', 'short', 'portrait'];
const drawings = layouts.map((layout) => renderSequence(heads, steps, layout)).join('');
---

<div class="wrapper">
  <div class="install-layer" aria-hidden="true">
    <header>
      <strong>A one-shot installer brings each server up</strong>
      <span class="caption">{app}'s containers, in the order the compose file starts them</span>
    </header>

    <div class="figure" set:html={drawings} />

    <dl class="rules">
      <div>
        <dt>One shot</dt>
        <dd>The installer has <code>restart: no</code>. Its lane stops at <code>exit 0</code>, and only then does the app start.</dd>
      </div>
      <div>
        <dt>Run again</dt>
        <dd>If the <code>language</code> table has rows, the script only seeds the admin again and exits 0, so <code>up</code> is safe to repeat.</dd>
      </div>
      <div>
        <dt>Its name</dt>
        <dd><code>CONFIG_DOMAIN={alice.hostname}</code> tells the server who it is on the network. Its admin is <code>admin@{alice.hostname}</code>.</dd>
      </div>
      <div>
        <dt>v2</dt>
        <dd>The v2 server has the same pair, gated on <code>mariadb</code> instead of Postgres.</dd>
      </div>
    </dl>
  </div>
</div>

<style lang="scss">
@use "./sheet" as *;

/* The sheet centres its content by default; this one takes the whole sheet, as the live one does. */
:global(article.technical-drawing-stack > * > section .content:has(.install-layer)) {
  place-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
}

.wrapper {
  @include sheet-content;

  height: 100%;
  min-height: 0;

  /* The title block takes a row off the bottom of a short sheet; a portrait one gives it a
     row of its own. On a wide sheet it sits under the notes' column. */
  :global([data-sheet-width='narrow']) & {
    padding-bottom: calc(var(--title-block-block, 0px) + $sheet-margin);
  }

  :global([data-sheet-orientation='portrait']) & {
    padding-bottom: $sheet-margin;
  }
}

.install-layer {
  /* The notes' column is as wide as the title block under it, as on the live sheet. */
  --side: max(18em, var(--title-block-inline, 0px));

  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--side);
  grid-template-rows: auto minmax(0, 1fr);
  column-gap: 1.5em;
  row-gap: 0.75em;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.75rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  color: var(--ink);

  /* Keyed on the stack's attributes, not the width query: a font size that comes out of a
     container query re-lays everything under it on each resize step. See Stack.astro. */
  :global([data-sheet-width='narrow']) &,
  :global([data-sheet-orientation='portrait']) & {
    grid-template-columns: minmax(0, 1fr);

    /* The notes need a column of their own, and a short or a phone's sheet has none. */
    .rules {
      display: none;
    }
  }
}

header {
  grid-column: 1;
  display: grid;
  gap: 0.125em;

  strong {
    font-size: 0.9375em;
  }
}

.caption {
  font-size: 0.75em;
  color: var(--ink-muted);

  /* A short sheet keeps its height for the drawing. */
  :global([data-sheet-width='narrow']:not([data-sheet-orientation='portrait'])) & {
    display: none;
  }
}

code {
  font-family: $code-font;
}

.figure {
  grid-column: 1;
  grid-row: 2;
  position: relative;
  min-height: 12em;

  :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: $code-font;
    overflow: visible;
  }

  :global(svg:is(.short, .portrait)) {
    display: none;
  }

  :global([data-sheet-width='narrow']) & {
    :global(svg.landscape) {
      display: none;
    }

    :global(svg.short) {
      display: block;
    }
  }

  :global([data-sheet-orientation='portrait']) & {
    :global(svg:is(.landscape, .short)) {
      display: none;
    }

    :global(svg.portrait) {
      display: block;
    }
  }

  :global(text) {
    fill: var(--ink);
    text-anchor: middle;
  }

  :global(rect.head) {
    fill: var(--sheet-paper);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  :global(text.head) {
    font-weight: 600;
  }

  :global(text.head.prefix) {
    font-weight: 400;
    fill: var(--ink-muted);
  }

  :global(.lifeline) {
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }

  :global(rect.step) {
    fill: var(--sheet-paper);
    stroke: var(--ink-muted);
    stroke-width: 1;
  }

  :global(rect.step.end) {
    stroke: var(--ink);
  }

  :global(.message) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }

  :global(.message.gate) {
    stroke: var(--accent);
    stroke-width: 2;
  }

  :global([id^='install-arrow-'] path) {
    fill: var(--ink);
  }

  :global([id^='install-gate-'] path) {
    fill: var(--accent);
  }

  /* A label crossing a lifeline paints a gap of paper into it. */
  :global(text.label) {
    paint-order: stroke;
    stroke: var(--sheet-paper);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  :global(text.label.gate) {
    fill: var(--accent-text);
    font-weight: 600;
  }
}

.rules {
  grid-column: 2;
  grid-row: 1 / -1;
  align-self: start;
  margin: 0;
  display: grid;
  gap: 0.75em;

  div {
    display: grid;
    gap: 0.125em;
    padding-left: 0.625em;
    border-left: 1px solid var(--line-strong);
  }

  dt {
    font-size: 0.6875em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    font-size: 0.75em;
    line-height: 1.4;
    text-wrap: pretty;
  }
}
</style>
