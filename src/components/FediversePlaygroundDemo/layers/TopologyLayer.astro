---
import { exampleConfig, initiallyEnabled, withEnabled } from '../config';
import { buildComposeFile, PLANNED_RECIPES, RECIPES } from '../compose';
import { composeView, LEFT_OUT, lineCount } from '../composeView';
import { renderGraphs, summary } from '../graph';
import { composeHtml } from '../yaml';

// The opening state is built here by the same code the island runs, so the sheet reads the
// same with scripts off, and the first toggle only redraws.
const config = withEnabled(exampleConfig, initiallyEnabled);
const compose = buildComposeFile(config);
const yaml = composeHtml(composeView(compose));

const toggles = Object.entries(exampleConfig.instances).map(([key, instance]) => ({
  key,
  short: key.replace(/^(gnusocial|mastodon)-/, ''),
  software: instance.software,
  hostname: instance.hostname,
}));
---

<div class="wrapper">
  <div class="playground" data-fediverse-playground>
    <p class="intro">
      Fediverse Playground runs a small federated network on one machine, to test how
      fediverse servers talk to each other. Switch servers on and off to redraw the
      docker-compose.yml it writes.
    </p>
    <div class="config" role="group" aria-label="Instances in playground.config.yaml">
      <p class="file">
        <span>playground.config.yaml</span>
        <span>defaults.local_tld: {exampleConfig.defaults?.local_tld}</span>
        <span>recipes: {Object.keys(RECIPES).join(', ')}</span>
        <span>planned: {PLANNED_RECIPES.map((id, index) => (
          <>{index > 0 && ' '}<span class="id">{id}{index < PLANNED_RECIPES.length - 1 && ','}</span></>
        ))}</span>
      </p>
      <fieldset>
        <legend class="sr-only">instances</legend>
        {toggles.map(({ key, short, software, hostname }) => (
          <label class="toggle">
            <input type="checkbox" name={key} checked={initiallyEnabled[key]} />
            <span class="name">{short}</span>
            <span class="meta"><span>{software}</span><span class="host">{hostname}</span></span>
          </label>
        ))}
      </fieldset>
    </div>

    <p class="status" data-live-in-control data-status>{summary(compose)}</p>

    <div class="graph" data-graph set:html={renderGraphs(config, compose)} />

    {/* Open, the file lies over the graph rather than pushing it off the sheet. */}
    <details class="yaml hl">
      <summary>
        <span>docker-compose.yml</span>
        <span class="lines" data-lines>{lineCount(compose)}</span>
      </summary>
      <pre tabindex="0"><code data-yaml set:html={yaml} /><span class="left-out">{LEFT_OUT}</span></pre>
    </details>
  </div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-fediverse-playground]', boot);
</script>

<style lang="scss">
@use '@/scss/sheet-orientation' as *;
@use '@/scss/hit-area' as *;
@use "./sheet" as *;

:global(article.technical-drawing-stack > * > section .content:has(.playground)) {
  place-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
}

.wrapper {
  @include sheet-content;

  height: 100%;
  min-height: 0;

  /* The title block claims the bottom-right corner. On a wide sheet it reaches up into the
     side column, whose rows stop short of it. On a narrow one it takes a row off the bottom.
     Keyed on the stack's attributes, as Stack.astro sets them. */
  :global([data-sheet-width='narrow']) & {
    padding-bottom: calc(var(--title-block-block, 0px) + $sheet-margin);
  }

  @include portrait-sheet {
    /* Portrait gives the title block its own row. */
    padding-bottom: $sheet-margin;

    /* Page.astro gives it that row only while the stack is taller than it is wide. From 624
       to 672px the frame reads portrait but the stack is wider than tall, so the block stays
       in the corner over the content and the content stops above it. */
    @container technical-drawing (orientation: landscape) {
      padding-bottom: calc(var(--title-block-block, 0px) + $sheet-margin);
    }
  }
}

.playground {
  --bar: 2em;
  /* The side column is as wide as the title block under it. */
  --side: max(20em, var(--title-block-inline, 0px));
  --gap: 1em;
  /* The panels and the graph's boxes are a step off the sheet's own paper toward its ink,
     whichever way the theme's paper lies: --surface-raised is the paper itself on the light
     themes, and a box painted with it vanished. */
  --panel: color-mix(in oklch, var(--sheet-paper), var(--ink) 6%);
  --panel-sunken: color-mix(in oklch, var(--sheet-paper), var(--ink) 12%);

  position: relative;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  display: grid;
  /* Landscape: the graph takes the sheet's height on the left, and the intro, the config and
     the status stack in a column on the right, over the title block. */
  grid-template-columns: minmax(0, 1fr) var(--side);
  grid-template-rows: auto auto auto auto minmax(0, 1fr);
  column-gap: var(--gap);
  row-gap: 0.5em;
  color: var(--ink);
  /* The side column has to end above the title block, whose height does not change with
     the sheet's, so its em is the height from the playground's top to the block's top (the
     sheet less its frame, a 1px border and --sheet-margin each side, the wrapper's top padding
     and the block) over the rows' height in em. A wide sheet's rows come to 27.5em; a narrow
     sheet's, with the intro across both columns over them, to 21.5em at most. Half an em more
     keeps them a row gap off the block. Where that comes out over 0.8em, as on the largest
     wide sheet and on most narrow ones, the type stays at 0.8em. */
  --side-rows: 28;

  --side-room: calc(var(--sheet-block) - 2px - 2 * var(--sheet-margin) - 0.75em - var(--title-block-block, 0px));
  font-size: min(0.8em, var(--side-room) / var(--side-rows));

  :global([data-sheet-width='narrow']) & {
    --side-rows: 22;
  }

  /* Portrait: one column, the graph under the rows. */
  @include portrait-sheet {
    font-size: 0.8em;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto var(--bar) minmax(0, 1fr);
  }
}

.intro {
  grid-row: 1;
  grid-column: 2;
  margin: 0 0 0.25em;
  max-width: 60em;
  font-size: 0.9em;
  line-height: 1.35;

  /* A narrow landscape sheet has too little height for the intro in the side column. */
  :global([data-sheet-width='narrow']) & {
    grid-column: 1 / -1;
  }

  @include portrait-sheet {
    grid-column: 1;
  }
}

.config {
  grid-row: 2;
  grid-column: 2;
  margin: 0;
  display: grid;
  gap: 0.25em;
  padding: 0.5em 0.625em;
  border: 1px solid var(--line-strong);
  border-radius: 0.375em;
  background: var(--panel);
  font-family: $code-font;

  @include portrait-sheet {
    grid-column: 1;
  }
}

.file {
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  column-gap: 1.5em;
  font-size: 0.75em;
  color: var(--ink-muted);

  > span:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  /* A list wraps between names, never inside one. */
  .id {
    white-space: nowrap;
  }
}

fieldset {
  margin: 0;
  padding: 0;
  border: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.25em;

  /* Four servers: a short landscape sheet takes them two a row, and portrait all four in one,
     each with its software over its hostname where there is room. */
  :global([data-sheet-width='narrow']) & {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @include portrait-sheet {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

.toggle {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  grid-template-areas:
    "box name"
    "box meta";
  column-gap: 0.5em;
  align-items: center;
  padding: 0.25em 0.375em;
  border: 1px solid var(--line);
  border-radius: 0.25em;
  cursor: pointer;

  &:hover {
    background: var(--panel-sunken);
  }

  &:has(input:focus-visible) {
    outline: 2px solid var(--control-accent);
    outline-offset: 1px;
  }

  &:has(input:checked) {
    border-color: var(--ink-muted);
  }

  input {
    grid-area: box;
    margin: 0;
    width: 1.1em;
    height: 1.1em;
    accent-color: var(--control-accent);
    cursor: inherit;
  }

  .name {
    grid-area: name;
    font-weight: 600;
  }

  .meta {
    grid-area: meta;
    font-size: 0.75em;
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    .host::before {
      content: " · ";
    }
  }

  @include portrait-sheet($or: "[data-sheet-width='narrow']") {
    .meta {
      display: grid;

      > span {
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .host::before {
        content: none;
      }
    }
  }

  /* A phone's column is too narrow for a hostname; the graph's box carries it. */
  @include portrait-sheet {
    grid-template-areas:
      "box name"
      "meta meta";

    .host {
      display: none;
    }
  }

  &:has(input:not(:checked)) .name {
    color: var(--ink-muted);
  }
}

.status {
  grid-row: 3;
  grid-column: 2;
  margin: 0;
  align-self: center;
  line-height: 1.2;
  font-family: $code-font;
  font-size: 0.75em;
  color: var(--ink-muted);

  @include portrait-sheet {
    grid-column: 1;
  }
}

/* Landscape: the summary sits under the status, and the open file covers the graph in the
   other column. Portrait: the summary has a row under the status, and the file covers
   the graph below it. Only those two take the pointer. */
.yaml {
  grid-row: 4;
  grid-column: 2;
  min-width: 0;
  min-height: 0;
  pointer-events: none;
  font-family: $code-font;

  summary {
    box-sizing: border-box;
    height: var(--bar);
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding: 0 0.75em;
    border: 1px solid var(--line-strong);
    border-radius: 0.375em;
    background: var(--panel);
    cursor: pointer;
    pointer-events: auto;
    @include hit-area;

    span {
      font-size: 0.8em;
    }

    &:focus-visible {
      outline: 2px solid var(--control-accent);
      outline-offset: 1px;
    }
  }

  .lines {
    color: var(--ink-muted);
  }

  /* Placed against the playground in landscape and against the bar in portrait, in the
     playground's em; only the text inside is set smaller. */
  pre {
    position: absolute;
    z-index: 1;
    inset: 0 calc(var(--side) + var(--gap)) 0 0;
    margin: 0;
    padding: 0.375em 0.5em;
    overflow: auto;
    border: 1px solid var(--line-strong);
    border-radius: 0.375em;
    background: var(--panel);
    pointer-events: auto;

    &:focus-visible {
      outline: 2px solid var(--control-accent);
      outline-offset: -2px;
    }
  }

  code {
    display: block;
    width: max-content;
    font-size: 0.75em;
    line-height: 1.4;
  }

  /* One line under the file for everything the sheet leaves out of it. */
  .left-out {
    display: block;
    margin-top: 0.5em;
    padding-top: 0.375em;
    border-top: 1px solid var(--line);
    font-size: 0.75em;
    color: var(--ink-muted);
    white-space: normal;
  }

  @include portrait-sheet {
    grid-row: 4 / 6;
    grid-column: 1;
    position: relative;
    z-index: 1;

    summary {
      margin-left: auto;
    }

    pre {
      inset: calc(var(--bar) + 0.5em) 0 0 0;
    }
  }
}

.graph {
  grid-row: 1 / -1;
  grid-column: 1;

  position: relative;
  min-width: 0;
  min-height: 8em;

  /* Out of flow, so the column's height is whatever the sheet leaves and the drawing scales
     into it instead of growing the row. Two drawings come in and the sheet's orientation
     picks one: the portrait one is laid out for a sheet about 340px wide. Keyed on the
     stack's attribute, not a container query, following Stack.astro. The type is set in
     the drawing's own units, and neither drawing is shown much below 1:1. */
  :global(svg.portrait) {
    display: none;
  }

  @include portrait-sheet {
    :global(svg.landscape) {
      display: none;
    }

    :global(svg.portrait) {
      display: block;
    }
  }

  :global(svg) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    font-family: $code-font;
    overflow: visible;
  }

  :global(.node rect) {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  :global(.node.shared rect) {
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  :global(.node.install rect) {
    fill: var(--panel-sunken);
  }

  :global(.node text) {
    text-anchor: middle;
    fill: var(--ink);
  }

  :global(.node .label) {
    font-size: 0.625rem;
    font-weight: 600;
  }

  :global(.node .sub) {
    font-size: 0.625rem;
    fill: var(--ink-muted);
  }

  :global(.node.ghost rect) {
    fill: none;
    stroke: var(--line);
    stroke-dasharray: 3 3;
  }

  :global(.node.ghost text) {
    fill: var(--ink-faint);
    font-weight: 400;
  }

  :global(.node.fresh) {
    animation: fediverse-appear 360ms ease-out both;
  }

  :global(.edge) {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 1;
  }

  :global(.edge.service_started) {
    stroke-dasharray: 4 3;
  }

  :global(.edge.service_completed_successfully) {
    stroke: var(--accent);
    stroke-width: 1.75;
  }

  :global([id^='fediverse-arrow-'] path) {
    fill: var(--ink-muted);
  }

  :global([id^='fediverse-gate-'] path) {
    fill: var(--accent);
  }

  :global(.gate) {
    font-size: 0.625rem;
    fill: var(--accent-text);
  }

  :global([data-sheet-width='narrow']) & {
    grid-row: 2 / -1;
  }

  @include portrait-sheet {
    grid-row: 5;
  }
}

/* The walkthrough's hand, drawn as VariantsDemo draws it and placed by translate alone:
   cursorMotion.ts animates each hop and folds the arrow's tip into every keyframe. */
.playground :global(.demo-cursor) {
  position: absolute;
  z-index: 30;
  top: 0;
  left: 0;
  width: 2.5em;
  height: 2.5em;
  transform-origin: 12% 8%;
  pointer-events: none;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><path d="M4 2.5v24.2l6.4-6.2 4.1 9.7 4.2-1.8-4.1-9.6H26z" fill="%23fff" stroke="%23222" stroke-width="1.6" stroke-linejoin="round"/></svg>') center / contain no-repeat;
  filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.25));
  transition:
    opacity 0.32s ease,
    scale 0.12s ease;
}

.playground :global(.demo-cursor--fading) {
  opacity: 0;
}

.playground :global(.demo-cursor--clicking) {
  scale: 0.88;
}

@keyframes fediverse-appear {
  from {
    opacity: 0;
    translate: 0 -4px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .graph :global(.node.fresh:not([data-full-motion] *)) {
    animation: none;
  }
}
</style>
