---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';

import TopologyLayer from './layers/TopologyLayer.astro';
import WorktreesLayer from './layers/WorktreesLayer.astro';
import InstallLayer from './layers/InstallLayer.astro';
import HostsLayer from './layers/HostsLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

const srcRoot = path.join(process.cwd(), 'src');
const clientEntry = path.join(srcRoot, 'components/FediversePlaygroundDemo/client/playground.ts');

const { outputFiles: [clientBundle] } = await esbuild.build({
  entryPoints: [clientEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  alias: { '@': srcRoot },
});

const clientSize = toKiB(clientBundle.text);

// The title block holds two icons a page, so the sheet's six tags are shared out by what each
// page is about.
const layers = {
  topology: { name: null, tech: ['typescript', 'docker'] },
  worktrees: { name: 'Mirrors & Worktrees', pageStyle: 'blueprint', tech: ['git', 'typescript'] },
  install: { name: 'One-shot Installers', pageStyle: 'blueprint', tech: ['bash', 'postgresql'] },
  hosts: { name: 'Hostnames → /etc/hosts', pageStyle: 'blueprint', tech: ['nixos', 'bash'] },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="Fediverse Playground"
  scale="1:1"
  size={clientSize}
  date="2026"
  tech={['typescript', 'docker']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      topology: <TopologyLayer />,
      worktrees: <WorktreesLayer />,
      install: <InstallLayer />,
      hosts: <HostsLayer />,
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
