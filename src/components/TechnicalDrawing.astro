---
import { Icon } from 'astro-icon/components';
---

<article>
  <section>

    <table>
      <tbody>
        <tr><td colspan=4><h2 class="typewriter">{Astro.props.title}</h2></td></tr>
        <tr>
          <td>
            <div>
              <h3 class="monospace">Scale</h3>
              <span class="typewriter">{Astro.props.scale ?? '3:1'}</span>
            </div>
          </td>

          <td>
            <div>
              <h3 class="monospace">Weight</h3>
              <span class="typewriter">{Astro.props.size ?? '-'}</span>
            </div>
          </td>

          <td>
            <div>
              <h3 class="monospace">Date</h3>
              <span class="typewriter"><time datetime={Astro.props.date}>{Astro.props.date ?? '-'}</time></span>
            </div>
          </td>

          <td>
            <div>
              <h3 class="monospace" title="Projection">Proj.</h3>
              <Icon name="first-angle-projection" title="First Angle Projection" />
            </div>
          </td>
        </tr>
      </tbody>
    </table>

  </section>
</article>

<style lang="scss">
@use 'sass:math';

article {
  width: 64em;
  height: 32em;

  background: var(--bg-850);
  color: var(--fg-850);
  border: 1px solid var(--accent-500);
  border-radius: 0.5em;
  padding: 1em;

  section {
    $border: 1px solid var(--fg-800);

    background: var(--bg-800);
    width: 100%;
    height: 100%;
    border: $border;

    position: relative;

    table {
      position: absolute;
      right: -1px;
      bottom: -1px;
      border-spacing: 0;

      td {
        border: $border;
        padding: 0.25em;

        @for $i from 1 through 20 {
          &:nth-child(#{$i}) {
            --random1: #{math.random() * 2 - 1};
            --random2: #{math.random() * 2 - 1};
            --random3: #{math.random() * 2 - 1};
          }
        }

        h2 {
          display: inline-block;
          rotate: calc(var(--random1) * 0.75deg);
          translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px);
          margin: 0.25rem;
        }

        & > div {
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          gap: 0.25rem;

          h3 {
            font-size: 0.625rem;
          }

          span {
            rotate: calc(var(--random1) * 1.5deg);
            /* translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px); */
          }

          span, svg {
            margin-inline: auto;
          }
        }
      }
    }
  }
}
</style>
