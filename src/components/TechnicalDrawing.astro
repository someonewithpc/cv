---
import { Icon } from 'astro-icon/components';

const { layers = {} } = Astro.props;
---

<section>
  <div class="content">
    <slot name="content" />
  </div>

  <table>
    <tbody>
      <tr>
        <td colspan=5>
          <header>
            <h2 class="typewriter">{Astro.props.title ?? Astro.props.subtitle}</h2>
            {Astro.props.title && Astro.props.subtitle && (<h3 class="typewriter">{Astro.props.subtitle}</h3>)}
          </header>
        </td>
      </tr>
      <tr>
        <td>
          <div>
            <h3 class="monospace">Drawing No.</h3>
            <span class="typewriter">{Astro.props.index} / {Astro.props.layerCount}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Scale</h3>
            <span class="typewriter">{Astro.props.scale ?? '3:1'}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Weight</h3>
            <span class="typewriter">{Astro.props.size ?? '-'}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Date</h3>
            <span class="typewriter"><time datetime={Astro.props.date}>{Astro.props.date ?? '-'}</time></span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace" title="Projection">Proj.</h3>
            <Icon name="first-angle-projection" title="First Angle Projection" />
          </div>
        </td>
      </tr>
    </tbody>
  </table>

</section>

<style lang="scss">
@use 'sass:math';

section {
  $border: 1px solid var(--fg-800);

  background: var(--bg-800);
  width: 100%;
  height: 100%;
  border: $border;

  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  position: relative;

  .content {
    max-height: 100%;
    translate: 50% 0%;
  }

  .layers {
    grid-column: 3;
    justify-self: center;

    display: grid;
    grid-template-columns: auto auto;

    ol {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / 3;

      a {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / 3;

        li {
          display: grid;
          grid-template-columns: subgrid;
          grid-column: 1 / 3;

          span {
            border: $border;
            margin-right: -1px;
            margin-bottom: -1px;

            $padding-inline: 0.25em;
            $padding-block: 0.375em;
            padding: $padding-inline $padding-block;
          }
        }
      }

    }
  }

  & > table {
    position: absolute;
    right: -1px;
    bottom: -1px;

    border-collapse: collapse;
    border-spacing: 0;

    td {
      border: $border;
      padding: 0.25em;

      @for $i from 1 through 20 {
        &:nth-child(#{$i}) {
          --random1: #{math.random() * 2 - 1};
          --random2: #{math.random() * 2 - 1};
          --random3: #{math.random() * 2 - 1};
        }
      }

      header {
        display: inline-block;
        rotate: calc(var(--random1) * 0.75deg);
        translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px);

        h3 {
          color: var(--fg-700);
          font-size: 0.675em;
          margin-top: 0.25rem;
        }
      }

      & > div {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.25rem;

        h3 {
          font-size: 0.625rem;
        }

        span {
          rotate: calc(var(--random1) * 1.5deg);
          /* translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px); */
        }

        span, svg {
          margin-inline: auto;
        }
      }
    }
  }
}
</style>
