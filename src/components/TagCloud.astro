---
import TechIcon from '@/components/TechIcon.astro';

import { TECH_TAGS } from '@/server/tech-tags';
---

<section aria-labelledby="tech-parts-label">
  <p id="tech-parts-label" class="parts-label monospace">Bill of materials</p>
  <ul>
    {TECH_TAGS.map((tag) => (
      <li>
        <TechIcon tag={tag} decorative />
        <span>{tag.text}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
section {
  max-width: 80ch;
  margin-inline: auto;
  margin-top: 1.5rem;

  .parts-label {
    margin: 0 0 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
  }

  ul {
    display: flex;
    justify-content: center;
    gap: 0.5em;
    flex-wrap: wrap;
  }

  li {
    padding: 0.375em 0.6em;
    border-radius: 0.55em;
    display: inline-flex;
    gap: 0.75ch;
    align-items: center;

    color: var(--ink);
    background-color: var(--surface-raised);
    border: 1px solid color-mix(in oklch, var(--line-strong), var(--accent-muted) 35%);

    font-family: monospace, system-ui;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }
}
</style>
