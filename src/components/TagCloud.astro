---
import TechIcon from '@/components/TechIcon.astro';

import { TECH_TAGS } from '@/server/tech-tags';
---

<section aria-label="Technologies">
  {TECH_TAGS.map((tag) => (
    <span>
      <TechIcon tag={tag} />
      <span>{tag.text}</span>
    </span>
  ))}
</section>

<style lang="scss">
section {
  display: flex;
  justify-content: center;
  max-width: 80ch;
  margin-inline: auto;
  gap: 0.5em;
  flex-wrap: wrap;

  & > span {
    padding: 0.4em 0.65em;
    border-radius: 100vh;
    display: inline-flex;
    gap: 0.65ch;
    align-items: center;

    color: var(--fg-900);
    background-color: var(--bg-825);
    border: 1px solid var(--accent-600);

    :global(.tech-icon) {
      width: 1.55em;
      height: 1.55em;
    }
  }
}
</style>
