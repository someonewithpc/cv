---
import { Icon } from 'astro-icon/components';

import { TECH_TAGS } from '@/server/tech-tags';
---

<section aria-label="Technologies">
  {TECH_TAGS.map(({ icon, text }) => (
    <span>
      <Icon name={icon} is:inline aria-hidden="true" title={text} />
      <span>{text}</span>
    </span>
  ))}
</section>

<style>
section {
  display: flex;
  justify-content: center;
  max-width: 80ch;
  margin-inline: auto;
  gap: 0.5em;
  flex-wrap: wrap;

  & > span {
    padding: 0.375em 0.5em;
    border-radius: 100vh;
    display: inline flex;
    gap: 1ch;
    align-items: center;

    color: var(--fg-900);
    background-color: var(--bg-850);
    border: 1px solid var(--accent-600);
  }
}
</style>
