---
type Props = {
  tipX: number;
  tipY: number;
  angle: number;
  length: number;
  text: string;
  /** Matches Annotations `fontSize` so the underline tracks glyph width. */
  fontSize?: number;
  underlinePerChar?: number;
  lengthOffset?: { x?: number; y?: number };
  arrowClass?: string;
  textClass?: string;
};

const {
  tipX,
  tipY,
  angle,
  length,
  text,
  fontSize = 0.1,
  underlinePerChar = fontSize * 0.43,
  lengthOffset,
  arrowClass,
  textClass,
} = Astro.props as Props;

const angleRad = angle * Math.PI / 180;
const underline = text.length * underlinePerChar;
const labelOffsetY = fontSize * 0.5;
---
<path
  d={`M ${tipX} ${tipY} l ${length * Math.cos(angleRad)} ${-length * Math.sin(angleRad)} l ${underline} 0`}
  pathLength="1"
  class={arrowClass}
/>
<text
  x={tipX + length * Math.cos(angleRad) + (lengthOffset?.x ?? 0)}
  y={tipY - length * Math.sin(angleRad) - labelOffsetY + (lengthOffset?.y ?? 0)}
  class={textClass}
>
  {text}
</text>
