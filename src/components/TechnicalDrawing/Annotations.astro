---
import { roundedCorners } from '@/server/svg-utils';

const vertices = [{ x: -1, y: -1 }, { x: -1, y: 1 }, { x: 1, y: 0 }];
const radius = 0.5;

const arrowPathD = roundedCorners(vertices, radius);
---

<slot name="content" />
<slot name="aside" />
<svg viewBox="-2 -2 4 4">
  <defs>
    <marker
      id="annotation-rounded-arrow"
      refX="center"
      refY="center"
      orient="auto-start-reverse"
      markerUnits="strokeWidth"
      markerWidth="4"
      markerHeight="4"
      preserveAspectRatio="xMidYMid"
      viewBox="-1 -1 2 2"
    >
      <path
        d={arrowPathD}
        style="fill: context-stroke; fill-rule: evenodd; stroke:none;"
      />
    </marker>
  </defs>

  <slot name="annotations" />
</svg>

<style lang="scss">
.content {
  anchor-name: --annotation-target;
  anchor-scope: --annotation-target;
}

svg {
  position-anchor: --annotation-target;
  position: absolute;
  left: -50%;
  top: -50%;
  height: 200%;
  width: 200%;

  :global(path) {
    marker-start: url('#annotation-rounded-arrow');
    stroke: var(--fg-800);
    stroke-width: 0.02;
    fill: none;
  }

  :global(text) {
    font-size: 0.1px;
    font-family: sans-serif;
    fill: var(--fg-800);
  }
}
</style>
