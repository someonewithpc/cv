---
import { roundedCorners } from '@/server/svg-utils';

type Props = {
  /** Multiplies the default stroke and font sizes when those props are omitted. */
  scale?: number;
  strokeWidth?: number;
  fontSize?: number;
  preserveAspectRatio?: string;
  /**
   * Furthest `|coordinate|` the callouts reach, in units of the artwork's half
   * width — 1 keeps them over the artwork, 1.5 puts a label half an artwork
   * outside it. Portrait shrinks the artwork by this so nothing runs off the
   * sheet; landscape has the room and ignores it.
   */
  reach?: number;
};

const {
  scale = 1,
  strokeWidth = 0.02 * scale,
  fontSize = 0.1 * scale,
  preserveAspectRatio = 'xMidYMid meet',
  reach = 1.5,
} = Astro.props as Props;

const vertices = [{ x: -1, y: -1 }, { x: -1, y: 1 }, { x: 1, y: 0 }];
const radius = 0.5;

const arrowPathD = roundedCorners(vertices, radius);
---

<div class="content" style={`--annotation-reach: ${reach};`}>
  <slot name="content" />
  <svg
    viewBox="-2 -2 4 4"
    preserveAspectRatio={preserveAspectRatio}
    style={`--annotation-stroke-width: ${strokeWidth}; --annotation-font-size: ${fontSize}px;`}
  >
    <defs>
      <marker
        id="annotation-rounded-arrow"
        refX="0"
        refY="0"
        orient="auto-start-reverse"
        markerUnits="strokeWidth"
        markerWidth="4"
        markerHeight="4"
        preserveAspectRatio="xMidYMid"
        viewBox="-1 -1 2 2"
      >
        <path
          d={arrowPathD}
          style="fill: context-stroke; fill-rule: evenodd; stroke:none;"
        />
      </marker>
    </defs>

    <slot name="annotations" />
  </svg>
</div>
<slot name="aside" />

<style lang="scss">
// Shrink-wrap the artwork so the 200% overlay tracks the drawing, not the
// page grid cell (Page .content is width: 100% for layout reasons).
.content {
  position: relative;
  width: fit-content;
  max-width: 100%;
  height: fit-content;

  /* Callouts reaching `reach` half-widths from the centre need `reach` times
     the artwork width of sheet. 92cqw is the sheet inside its mat; measuring
     against the drawing container rather than this box keeps a wrapper that
     already shrink-wraps the artwork from shrinking it twice. */
  @container technical-drawing (orientation: portrait) {
    max-width: min(100%, calc(92cqw / var(--annotation-reach, 1.5)));
  }
}

svg {
  position: absolute;
  left: -50%;
  top: -50%;
  height: 200%;
  width: 200%;

  :global(path) {
    marker-start: url('#annotation-rounded-arrow');
    stroke: var(--ink);
    stroke-width: var(--annotation-stroke-width, 0.02);
    fill: none;
  }

  :global(text) {
    font-size: var(--annotation-font-size, 0.1px);
    font-family: sans-serif;
    fill: var(--ink);
  }
}
</style>
