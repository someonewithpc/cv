---
import { transportKeyArtId, transportKeys } from './transport-keys';
---

<!-- The transport deck's cassette keys, drawn once for the page. Every sheet's deck
     (Page.astro) shows them through <use>, and the copy inherits the sheet's colours and
     the key's state properties from the <use> it hangs off. -->
<svg class="transport-key-art" aria-hidden="true" focusable="false">
  <defs>
    {transportKeys.map(({ id, glyph }) => (
      <g id={transportKeyArtId(id)}>
        <path class="key-bevel" d="M1 13 2.5 16.5h17L18 13Z" />
        <path class="key-bevel" d="M18 1 19.5 4.5v12L18 13Z" />
        <g class="key-cap">
          <rect class="key-face" x="1" y="1" width="17" height="12" rx="1.5" />
          <g class="key-hatch">
            <path d="M4 10.6 7.2 3.4" />
            <path d="M8.4 10.6 11.6 3.4" />
            <path d="M12.8 10.6 16 3.4" />
          </g>
          <g class="key-glyph" set:html={glyph} />
        </g>
      </g>
    ))}
  </defs>
</svg>

<style>
/* Holds the drawings; takes no room on the page. */
.transport-key-art {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}

/* One class each, no ancestors: a selector reaches the copy under a <use> only by what
   the copied node itself carries. The state (pressed, playing, pointed at) comes in
   through the properties Page.astro sets on the key. */
.key-cap {
  translate: var(--key-cap-shift);
}

.key-face {
  fill: var(--key-face-fill);
  stroke: var(--line-strong);
  stroke-width: 0.9;
}

.key-bevel {
  display: var(--key-bevel-display);
  fill: color-mix(in oklab, var(--ink) 18%, var(--surface-page));
  stroke: var(--line-strong);
  stroke-width: 0.9;
  stroke-linejoin: round;
}

.key-glyph {
  fill: var(--key-glyph-ink);
  stroke: var(--key-glyph-ink);
  stroke-width: 1.1;
  stroke-linejoin: round;
  stroke-linecap: square;
}

.key-hatch {
  display: var(--key-hatch-display);
  stroke: var(--line-strong);
  stroke-width: 0.5;
  opacity: 0.55;
}
</style>
