---
import TechnicalDrawingPage from './Page.astro';

const { layers = {} } = Astro.props;
const totalLayers = Object.keys(layers).length;
---

<article class="technical-drawing-stack">
  {Object.entries(layers).map(([id, { name, size, pageStyle }], index) => (
    <TechnicalDrawingPage
      title={name}
      subtitle={Astro.props.subtitle}
      scale={Astro.props.scale}
      size={size ?? Astro.props.size}
      date={Astro.props.date}
      index={index + 1}
      layerCount={totalLayers}
      pageStyle={pageStyle}
    >
      <Fragment slot="content">
        {Astro.slots.render('layers', [id])}
      </Fragment>
      <Fragment slot="aside">
        {Astro.slots.render('aside', [id])}
      </Fragment>
    </TechnicalDrawingPage>
  ))}

    <!-- {Object.keys(layers).length > 1 && (
  <nav class="layers">
    <ol class="monospace">
      {Object.entries(layers).map(([id, name], index) => (
      <a href="#">
              <li>
                <span>{index + 1}</span>
                <span>{name}</span>
              </li>
            </a>
            ))}
        </ol>
      </nav>
      )} -->
</article>


<style lang="scss">
article {
  width: 64em;
  height: 32em;

  background: var(--bg-850);
  color: var(--fg-850);
  border: 1px solid var(--accent-500);
  border-radius: 0.5em;

  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
  scroll-behavior: smooth;

  display: flex;
  flex-direction: row;

  position: relative;
  anchor-name: --technical-drawing-stack;
  anchor-scope: --technical-drawing-stack;

  > :global(*) {
    flex-shrink: 0;
    flex-basis: 100%;
    scroll-snap-align: center;
    animation-play-state: paused;
  }

  &::scroll-button(*) {
    position-anchor: --technical-drawing-stack;
    position: absolute;
    top: anchor(top);
  }

  &::scroll-button(left) {
    content: "⬅" / "Scroll Left";
    left: anchor(left);
  }

  &::scroll-button(right) {
    content: "⮕" / "Scroll Right";
    right: anchor(right);
  }

  &::scroll-button(*):focus-visible {
    outline-offset: 5px;
  }

}
</style>

<script lang="ts">
document.addEventListener('DOMContentLoaded', () => {
  [...document.querySelectorAll('article.technical-drawing-stack')].forEach((stack) => {
    const observer = new IntersectionObserver((intersections) => {
      [...intersections].forEach((entry) => {
        entry.target.getAnimations({ subtree: true }).forEach((animation) => {
          if (!entry.isIntersecting && (animation.playState === 'running' || animation.playState === 'finished')) {
            animation.cancel();
            animation.play();
          }
        });

        entry.target.style[
          entry.isIntersecting ? 'removeProperty' : 'setProperty'
        ]('animation-play-state', 'paused');
      });
    }, { root: stack, threshold: 0.25, scrollMargin: '25%' });
    [...stack.querySelectorAll('section')].forEach((page) => observer.observe(page));
  });
});
</script>
