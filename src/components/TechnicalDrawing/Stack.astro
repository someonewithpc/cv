---
import PaperStack from '@/components/PaperStack/index.astro';

import TechnicalDrawingPage from './Page.astro';

type Layer = {
  name: string | null;
  size?: string;
  pageStyle?: string;
  /** Per-page tech icon(s); falls back to stack `tech`. */
  tech?: string | readonly string[];
};

type Props = {
  layers?: Record<string, Layer>;
  subtitle?: string;
  scale?: string;
  size?: string;
  date?: string;
  /** Default tech icon(s) for every page (tag text or icon suffix). */
  tech?: string | readonly string[];
  /** Words next to the arrow that points at the fold. */
  hint?: string;
};

const { layers = {}, tech: stackTech } = Astro.props;
const totalLayers = Object.keys(layers).length;
// A hand writes a small count out in words; only a stack deeper than a dozen gets a digit
const inWords = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const sheetsBelow = totalLayers - 1;
const hint = Astro.props.hint ?? `${inWords[sheetsBelow] ?? sheetsBelow} more sheets, peel this corner`;
const hintBack = 'this corner drags the page back';
// One span per character, spaces included so the line's width stays put: each callout types
// itself out when it appears, and the stylesheet times each letter by its place in the line. The
// stylesheet numbers the first 48 letters itself; a longer line carries the rest's index inline.
const hintLettersNumbered = 48;
const struck = (line: string) => [...line].map((letter, index) => ({
  letter,
  style: index < hintLettersNumbered ? undefined : `--i: ${index}`,
}));
const hintLetters = struck(hint);
const hintBackLetters = struck(hintBack);

// One arrow, drawn twice and turned by the CSS. Its tip is at (6, 14) and the shaft leaves it
// along +x, so the element's left edge at half its height is the point the arrow aims at and
// `rotate` decides from which side it comes. Drawn by a hand that is not steady: the shaft
// wanders, a lighter second pass doubles part of it the way a marker does when it goes back over
// a line, and the head's two barbs are different lengths and miss both the shaft and each other.
const arrow = {
  shaft: 'M46 23 C 40 25, 30.5 24.5, 24 21 C 19 18.5, 17 14.6, 12 14.1 C 9.5 13.85, 8.5 13.95, 6 14',
  pass: 'M45 24 C 37.5 25.5, 28.5 24, 22.5 20.5',
  head: 'M15.5 8 L5.5 13.4 M13.9 19.6 L5.3 13.8',
};
---

<div class="technical-drawing-frame">
  <PaperStack as="article" class="technical-drawing-stack" pageCount={totalLayers} label={Astro.props.subtitle}>
    {(index: number) => {
      const [id, { name, size, pageStyle, tech }] = Object.entries(layers)[index];
      return (
        <TechnicalDrawingPage
          title={name}
          subtitle={Astro.props.subtitle}
          scale={Astro.props.scale}
          size={size ?? Astro.props.size}
          date={Astro.props.date}
          index={index + 1}
          layerCount={totalLayers}
          pageStyle={pageStyle}
          tech={tech ?? stackTech}
        >
          <Fragment slot="content">
            {Astro.slots.render('layers', [id])}
          </Fragment>
          <Fragment slot="aside">
            {Astro.slots.render('aside', [id])}
          </Fragment>
        </TechnicalDrawingPage>
      );
    }}
  </PaperStack>

  <div
    class="flip-hints"
    aria-hidden="true"
    style={`--hint-fwd-letters: ${hintLetters.length}; --hint-back-letters: ${hintBackLetters.length}`}
  >
    <p class="flip-hint flip-hint--fwd hint-words typewriter">{hintLetters.map(({ letter, style }) => (
      <span class="hint-letter" style={style}>{letter}</span>
    ))}</p>
    <svg class="flip-hint flip-hint--fwd hint-arrow" viewBox="0 0 48 28">
      <path class="hint-halo" d={arrow.shaft} />
      <path class="hint-halo" d={arrow.head} />
      <path class="hint-shaft" d={arrow.shaft} />
      <path class="hint-pass" d={arrow.pass} />
      <path class="hint-head" d={arrow.head} />
    </svg>

    <p class="flip-hint flip-hint--back hint-words typewriter">{hintBackLetters.map(({ letter, style }) => (
      <span class="hint-letter" style={style}>{letter}</span>
    ))}</p>
    <svg class="flip-hint flip-hint--back hint-arrow" viewBox="0 0 48 28">
      <path class="hint-halo" d={arrow.shaft} />
      <path class="hint-halo" d={arrow.head} />
      <path class="hint-shaft" d={arrow.shaft} />
      <path class="hint-pass" d={arrow.pass} />
      <path class="hint-head" d={arrow.head} />
    </svg>

    {['rest-x', 'rest-y', 'lean-x', 'lean-y'].map((length) => <span class="crease-length" data-length={length} />)}
  </div>
  <span class="sheet-probe" aria-hidden="true"></span>
</div>

<style lang="scss">
@use '@/scss/technical-drawing' as drawing;

// How long a hint takes to fade in, and how long one part of it waits for another.
$hint-fade: 400ms;

// How far the resting crease reaches along the sheet's long side, for the stack and the hint layer.
$paper-clip-reach: clamp(2.75em, 7.5cqw, 4.5em);

// The width container has to be an ancestor of the stack, not the stack itself: the stack is
// what the aspect query below styles, and an element never matches a container it declares
// (its own `container: technical-drawing / size` would also overwrite a second name set here).
.technical-drawing-frame {
  position: relative;
  container: technical-drawing-width / inline-size;

  /* The sheet's measure, worked out from the viewport the way the page lays the stack out
     rather than read off this container: a font-size that comes out of the container, by
     unit, by query or through a variable, made Chrome's layout of the deep artwork grids take
     seconds per pass (see the note where the script observes the stack). The stack spans the
     drawing's column on the cutting mat (index.astro); the mat is the window less the
     scrollbar and the desk on each side (Layout.astro); the column caps at --breakout-max.
     --scrollbar-inline is the classic scrollbar's width, which 100vw counts and the page does
     not: the script sets it, and without script it is 0.

     Both stay unregistered on purpose. The text of the expression is the same at every width,
     so a resize restyles only what reads it. A registered length resolves to new pixels at
     each step, and every element under the frame then restyles to inherit them: a step
     without script cost 50 to 65 ms more style that way. Every length in the expression is
     in vw, rem or px, since an em would be read against the artwork's own type. */
  --mat-inner: calc(
    min(100vw - var(--scrollbar-inline, 0px) - var(--mat-inset) * 2, var(--mat-max))
      - (var(--mat-rim) + var(--mat-line)) * 2
  );
  --sheet-inline: min(
    max(
      var(--mat-inner) - (var(--mat-boundary, 0px) + var(--mat-clear)) * 2,
      min(var(--mat-inner) - max(0px, var(--mat-boundary, 0px) - var(--mat-rim)) * 2, var(--breakout-max))
    ),
    var(--breakout-max)
  );
  --sheet-block: calc(var(--sheet-inline) / 2);

  // Allow the frame to shrink within the page grid instead of expanding it
  // to the stack's intrinsic width (default min-width: auto).
  min-width: 0;

  // The dog-ear's resting size, restated here for the hint layer: the hint layer is the
  // stack's sibling, so the property PaperStack publishes on the stack does not reach it by
  // inheritance. From the same scss/_technical-drawing.scss source as PaperStack's own
  // --fold-rest-x/-y, so the two cannot drift apart.
  --fold-rest-x: #{drawing.$fold-rest-x};
  --fold-rest-y: #{drawing.$fold-rest-y};
}

:global(article.technical-drawing-stack) {
  --technical-drawing-aspect: 2 / 1;

  width: 100%;
  height: auto;
  aspect-ratio: var(--technical-drawing-aspect);

  color: var(--ink);

  container: technical-drawing / size;

  /* The browser skips style, layout and paint for a stack well off screen, so a resize or a
     theme switch lays out the one or two stacks in view instead of all of them. The size
     container above already keeps the stack's box from depending on its pages, so a skipped
     stack keeps its height and the scrollbar does not move. What this adds is a paint clip at
     the box, which would cut the fanned sheets, the note tab and a turning flap that sweeps
     hundreds of pixels off the sheet; a viewport's length of margin only cuts paint that is off
     screen anyway. Safari has no clip margin, so it keeps rendering every stack. Without script
     the stack is a scroll row whose arrows are placed from the frame around it (PaperStack), and
     the containment would make the row their box instead, so that page renders every stack. */
  @supports (overflow-clip-margin: 1px) {
    @media (scripting: enabled) {
      content-visibility: auto;
      overflow-clip-margin: 100vmax;
    }
  }

  /* How far the resting crease reaches along the sheet's long side. The crease is what a flip
     folds the sheet along and what the folded-back corner is cut on, so this one number is the
     size of the dog-ear at the top left. A fixed em made it a fifth of the way across a
     phone-width sheet and a twentieth on a desktop one, so it is a fraction of the sheet
     instead, floored so the paper clip still has a corner to sit in and capped at what a
     desktop sheet already had. 100cqw is the frame's width, which is the stack's own. */
  --paper-clip-reach: #{$paper-clip-reach};
  --paper-clip-lean-x: calc(var(--paper-clip-reach) / 2);
  --paper-clip-lean-y: var(--paper-clip-reach);

  @container technical-drawing-width (max-width: 40em) {
    /* Portrait has to stack artwork, note and title block where landscape put
       them side by side, so take the height a phone actually has. */
    --technical-drawing-aspect: 3 / 5;
    max-height: min(36rem, 85svh);

    /* Transpose the paper clip with the page. The lean sets the resting crease,
       and the crease is what a flip folds the sheet along, so on a page this
       tall the landscape lean throws the corner sideways across two and a half
       page widths before it lands. Swapping the intercepts lays the clip
       flat — onto the left edge, which PaperStack derives from the same two
       numbers — and sends the fold up the long axis instead. */
    --paper-clip-lean-x: var(--paper-clip-reach);
    --paper-clip-lean-y: calc(var(--paper-clip-reach) / 2);
  }
}

// A portrait sheet is as tall as the stack's portrait rule above makes it. The script names the
// orientation the frame's width query picked; without script, the query's 40em is a 680px
// window once the gutter is at its 1.25rem cap. The hint layer is the stack's sibling and
// places a hint on the sheet's bottom edge, so it takes the same height.
:global(article.technical-drawing-stack[data-sheet-orientation='portrait']),
:global(article.technical-drawing-stack[data-sheet-orientation='portrait']) ~ .flip-hints {
  --sheet-block: min(var(--sheet-inline) * 5 / 3, 36rem, 85svh);
}

@media (scripting: none) and (width <= 680px) {
  .technical-drawing-frame {
    --sheet-block: min(var(--sheet-inline) * 5 / 3, 36rem, 85svh);
  }
}

// Two sentences drawn on the frame: this corner turns the page, and that corner brings it back.
// The script decides which stacks get them, and nothing shows until it does, which also keeps
// all of this off a page without JS.
.flip-hints {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: none;
  color: var(--accent-text);
  pointer-events: none;

  // The hint layer is the stack's sibling, not its child, so the crease numbers do not reach it
  // by inheritance. It needs the same reach and lean, transposed the same way on a page this
  // tall, to find the folded-away corner's crease. cqw is the frame's width here too.
  --paper-clip-reach: #{$paper-clip-reach};
  --paper-clip-lean-x: calc(var(--paper-clip-reach) / 2);
  --paper-clip-lean-y: var(--paper-clip-reach);

  @container technical-drawing-width (max-width: 40em) {
    --paper-clip-lean-x: var(--paper-clip-reach);
    --paper-clip-lean-y: calc(var(--paper-clip-reach) / 2);
  }
}

.technical-drawing-frame[data-hint-show] .flip-hints {
  display: block;
}

// The sheet's em and its orientation as a box, for the script's observer to read instead of
// computed style: one em wide, and a pixel taller where the width query picks portrait. The
// same em as the stack's, since both inherit the frame's type.
.sheet-probe {
  position: absolute;
  top: 0;
  left: 0;
  width: 1em;
  height: 1px;
  visibility: hidden;
  pointer-events: none;

  @container technical-drawing-width (max-width: 40em) {
    height: 2px;
  }
}

// The creases' resting intercepts as boxes, for flip-hint.ts to read in pixels.
.crease-length {
  position: absolute;
  visibility: hidden;

  &[data-length='rest-x'] { width: var(--fold-rest-x, 0); }
  &[data-length='rest-y'] { width: var(--fold-rest-y, 0); }
  &[data-length='lean-x'] { width: var(--paper-clip-lean-x); }
  &[data-length='lean-y'] { width: var(--paper-clip-lean-y); }
}

// Neither callout is there until it is called for: the peel hint waits to be scrolled to, the
// way back waits for a page to have been turned.
.flip-hint {
  position: absolute;
  margin: 0;
  line-height: 1.2;
  pointer-events: none;
  opacity: 0;
  transition: opacity $hint-fade ease;
}

.flip-hints svg {
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
}

// The peel hint waits for the reader to reach it: flip-hint.ts marks the frame once the line
// has come up past the quarter mark of the viewport, so the words are written out in front of
// the reader instead of being found already written. The mark stays, so scrolling back does not
// start the line over. And a turned page has nothing left to peel.
//
// Both rules read the stack's marks through the sibling combinator rather than :has() on the
// frame: with :has(), every mark the stack took or dropped during a turn restyled the whole
// document, about 12,000 elements, and a turn does that four times.
$peel-shown: '.technical-drawing-frame[data-hint-seen] > :global(article.technical-drawing-stack:not([data-paper-turned])) ~ .flip-hints .flip-hint--fwd';

#{$peel-shown} {
  opacity: 1;
}

// The way back waits for the turned page to lie flat and still at the front; shown while it is
// still gliding over, the arrow would be drawn across the moving sheet and whatever is on it.
// And once the reader has found the way back it stays down: the stack keeps its turned mark
// after the return, so the return has to be part of the show rule, or the settle at the end of
// the way back would bring the callout up again.
$way-back-shown: ':global(article.technical-drawing-stack[data-paper-turned][data-paper-settled]:not([data-paper-returned])) ~ .flip-hints .flip-hint--back';

#{$way-back-shown} {
  opacity: 1;
}

// Both callouts type themselves out, a letter at a time in the typewriter face, rather than
// fading in as one block: the line shows at once and each letter waits its turn, so the
// animation starts with the callout and runs again on every show. Opacity only: the face is not
// monospace, so the letters keep their width from the first frame and the arrow's measurement
// holds.
//
// Each one is read left to right. The peel hint's words are to the left of its arrow, so they
// are struck first and the arrow follows the last letter; the way back's arrow is to the left of
// its words, so the arrow comes in first and the letters start once it is there.
@mixin types-itself($lead, $arrow-delay) {
  --hint-letter-beat: 40ms;

  &.hint-words {
    transition: none;
  }

  .hint-letter {
    animation: hint-letter-struck 1ms linear both;
    animation-delay: calc(#{$lead} + var(--i) * var(--hint-letter-beat));
  }

  &.hint-arrow {
    transition-delay: $arrow-delay;
  }
}

@media (prefers-reduced-motion: no-preference) {
  #{$peel-shown} {
    @include types-itself(0ms, calc(var(--hint-fwd-letters, 0) * var(--hint-letter-beat)));
  }

  #{$way-back-shown} {
    @include types-itself($hint-fade, 0ms);
  }
}

// Each letter's place in its line, for the delay above. The count matches hintLettersNumbered in
// the frontmatter.
@for $n from 1 through 48 {
  .hint-letter:nth-child(#{$n}) {
    --i: #{$n - 1};
  }
}

@keyframes hint-letter-struck {
  from { opacity: 0; }
  to { opacity: 1; }
}


// The hint line, off the sheet in the room the fan reserves below it.
.hint-words {
  max-width: 24em;
  font-size: 1rem;
  // One line, whatever face lands: the room under the fan is about a line deep on a phone, and
  // a second line would run into the next stack's sheet.
  white-space: nowrap;

  @container technical-drawing-width (max-width: 40em) {
    font-size: 0.875rem;
  }
}

// Under the fan rather than over it: the frame's own bottom edge is where the reserve for the
// fanned pages ends, and the words are hard to read across their stripes. Where what the stack
// lies in draws a line too close round it for a line of words, it says how far out that line
// is (--hint-clear, Callout.astro), and both lines of words stand past it.
.flip-hint--fwd.hint-words {
  top: calc(100% + var(--hint-clear, 0px) + 0.125em);
  right: 3.5em;
  text-align: right;
}

.flip-hint--back.hint-words {
  top: 0;
  left: 0.5em;
  // Off the frame's top edge, then a touch further up and right, so the line stands clear of
  // the sheet's rim instead of resting on it.
  translate: 0.375em calc(-100% - 0.375em - var(--hint-clear, 0px));

  // Portrait swings the way back's arrow up over the frame's top edge instead of out past its
  // left one, through where these words would otherwise sit.
  @container technical-drawing-width (max-width: 40em) {
    left: 3em;
  }
}

// Left edge, half height: the point the tip aims at, which `rotate` then swings around. The tip
// itself stands 6/48 of the width off it along the arrow's own line, which is the gap it keeps
// between its nib and the paper.
.hint-arrow {
  width: 3.25em;
  aspect-ratio: 48 / 28;
  transform-origin: 0 50%;
  translate: 0 -50%;

  .hint-shaft { stroke-width: 2.5px; }
  .hint-pass { stroke-width: 1.25px; opacity: 0.45; }
  .hint-head { stroke-width: 2.75px; }

  // The tail crosses the fanned edges of the pages behind the sheet on its way in from the gap,
  // and marker ink on those stripes measured 1.4:1 at best. A pass in the page's own colour
  // under the stroke brings the grid paper along with the line. Opaque, because on the lighter
  // dark-forest paper the stripes showing through a 0.9 halo held the arrow to 4.2:1.
  .hint-halo {
    stroke: var(--surface-page);
    stroke-width: 7px;
  }
}

// Once flip-hint.ts has measured, each arrow is drawn over the whole layer in its own pixels,
// from the words to the crease, and the placement below is left to a page without script.
.flip-hints[data-hint-drawn] .hint-arrow {
  inset: 0;
  width: 100%;
  height: 100%;
  aspect-ratio: auto;
  rotate: none;
  translate: none;
  overflow: visible;
}

// Both arrows point at the middle of the crease they invite you to take hold of, square to it:
// aiming at the page's corner instead says nothing about which way the paper travels, and the
// corner is the one part of the fold the hand does not need.
//
// The way out is the dog-ear on the front page, whose resting crease runs from
// (100% - x, 100%) to (100%, 100% - y) of the sheet. atan2(x, y) is the angle of its normal,
// since the crease itself leans by atan2(y, x) the other way.
.flip-hint--fwd.hint-arrow {
  left: calc(100% - var(--fold-rest-x, 2cm) / 2);
  top: calc(var(--sheet-block, 100%) - var(--fold-rest-y, 1cm) / 2);
  rotate: atan2(var(--fold-rest-x, 2cm), var(--fold-rest-y, 1cm));
}

// The way back is the folded-away top-left corner, whose crease runs from (lean-x, 0) to
// (0, lean-y) and whose middle is the pin the paper clip holds. Same normal, half a turn round,
// so the arrow comes in over the cut corner rather than across the sheet.
.flip-hint--back.hint-arrow {
  left: calc(var(--paper-clip-lean-x, 2.25em) / 2);
  top: calc(var(--paper-clip-lean-y, 4.5em) / 2);
  rotate: calc(180deg + atan2(var(--paper-clip-lean-x, 2.25em), var(--paper-clip-lean-y, 4.5em)));
}

// Once armed, the hint layer stays armed: a page loaded with script and then switched off in
// DevTools keeps the attribute, while the stack it points at has become the no-script scroll
// row, with no corner to peel.
@media (scripting: none) {
  .flip-hints {
    display: none !important;
  }
}
</style>

<script>
import { initAutoplayStatus } from '@/client/autoplayStatus';
import { isFrontPage, watchFrontPage } from '@/client/frontPage';
import { isResizeHeld, onResizeHold } from '@/client/resizeHold';
import { isFoldPulse } from '@/components/PaperStack/fold-drag';
import './demo-cursor-press';

import { positionAnnotations } from './annotations-position';
import { drawFlipHints } from './flip-hint';
import { forgetTextWidths, readTitleFit, writeTitleFit } from './title-fit';

function initStack(stack: HTMLElement) {
  const onScreen = new WeakMap<HTMLElement, boolean>();

  // Being on screen is only half of it: every page of the stack shares one grid cell, so
  // intersection says nothing about which one is drawn on top. Without the --page-index
  // half, a page's intro animation ran (and finished) while it was still covered, and the
  // visitor who turned to it got the end state instead of the animation.
  const isActive = (page: HTMLElement) => Boolean(onScreen.get(page)) && isFrontPage(page);

  // While the window is being resized (src/client/resizeHold.ts) the front page's loops,
  // the dog-ear pulse among them, stop where they are and carry on once the size settles.
  // This has to be done here: once play() or pause() has run on an animation, CSS
  // animation-play-state no longer moves it.
  const heldByResize = new WeakSet<Animation>();
  const holdForResize = (animation: Animation) => {
    if (animation.playState !== 'running' && animation.playState !== 'paused') return;
    animation.pause();
    heldByResize.add(animation);
  };

  // The page's own animations and its content's. The dog-ear's pulse runs on the page too (its
  // crease clip-path), but it is one of three layers kept on one clock by PaperStack's
  // fold-drag.ts, which holds it off screen and through a resize itself; one layer stopped here
  // would leave the hole and the flap out of step.
  const animationsOf = (page: HTMLElement) =>
    page.getAnimations({ subtree: true }).filter((animation) => !isFoldPulse(animation));

  const apply = (page: HTMLElement) => {
    const active = isActive(page);

    animationsOf(page).forEach((animation) => {
      if (active) {
        if (isResizeHeld()) holdForResize(animation);
        else animation.play();
        return;
      }
      // Already held at its start by an earlier pass: leave it there. Playing it here
      // would run it off screen, which is the very thing this function is for.
      if (animation.playState !== 'running' && animation.playState !== 'finished') return;
      animation.cancel();
      // Cancelled animations get removed, so start them, but pause immediately
      animation.play();
      animation.pause();
    });

    page.style[active ? 'removeProperty' : 'setProperty']('animation-play-state', 'paused');
  };

  // Viewport root (not the stack): with root:stack the active slide was
  // "intersecting" on load even when still below the fold. Stack overflow
  // still clips off-screen carousel slides from the viewport intersection.
  const observer = new IntersectionObserver((intersections) => {
    [...intersections].forEach((entry) => {
      const page = entry.target as HTMLElement;
      onScreen.set(page, entry.isIntersecting);
      apply(page);
    });
  }, { threshold: 0.25, scrollMargin: '25%' });
  // The pages only: a demo's own sections would otherwise get an observer, a front-page
  // watcher and an inline animation-play-state of their own.
  const pages = [...stack.querySelectorAll<HTMLElement>(':scope > * > section')];
  pages.forEach((page) => {
    observer.observe(page);
    watchFrontPage(page, () => apply(page));
  });

  onResizeHold((holding) => pages.filter(isActive).forEach((page) => {
    animationsOf(page).forEach((animation) => {
      if (holding) holdForResize(animation);
      else if (heldByResize.delete(animation)) animation.play();
    });
  }));

  // A demo island boots only once its page is on screen, so the deck is listening long
  // before the first state is reported. One that beat it to it is read back instead.
  [...stack.querySelectorAll<HTMLElement>(':scope > * > section')]
    .forEach((page) => initAutoplayStatus(page));

  positionAnnotations(stack);

  // The note tab is an invoker button (command="show-modal"), which Chrome 135, Safari 26
  // and Firefox 144 act on natively. A browser without the API leaves the tab inert, and
  // below 56em the tab is the only way to the note, so it gets a click of its own there.
  // Feature-detected: where the button has the property the browser already opens it.
  // The popover attributes are the markup's fallback for pages without this script, so a
  // scripted page drops them and always opens the note as a modal.
  for (const tab of stack.querySelectorAll<HTMLButtonElement>('button.note-fold')) {
    tab.removeAttribute('popovertarget');
    const id = tab.getAttribute('commandfor');
    const note = id ? document.getElementById(id) : null;
    note?.removeAttribute('popover');
    note?.querySelector('.note-dismiss[popovertarget]')?.remove();
  }
  // The sheet is marked while its note is open, for Page.astro to hold its animations still.
  const markNoteOpen = (note: HTMLDialogElement, open: boolean) =>
    note.closest('section')?.toggleAttribute('data-note-open', open);
  for (const note of stack.querySelectorAll<HTMLDialogElement>('dialog.drawing-note')) {
    note.addEventListener('toggle', (event) => markNoteOpen(note, (event as ToggleEvent).newState === 'open'));
    note.addEventListener('close', () => markNoteOpen(note, false));
  }
  if (!('commandForElement' in HTMLButtonElement.prototype)) {
    for (const tab of stack.querySelectorAll<HTMLButtonElement>('button.note-fold')) {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('commandfor');
        const note = id ? document.getElementById(id) : null;
        if (note instanceof HTMLDialogElement && !note.open) {
          note.showModal();
          markNoteOpen(note, true);
        }
      });
    }
  }

  // The sheet's orientation and width band, restated as two data attributes for the artwork to
  // scale its type by. The container queries and units say the same thing, but a font-size that
  // comes out of them, by unit, by rule, or by an inherited variable, inside the deep grids of
  // some layers makes every em in them depend on this container, and Chrome's layout of that
  // runs seconds per pass: a resize, or docking DevTools, froze the page for twenty. The sheet's
  // size in pixels comes from CSS (the frame's --sheet-inline). The orientation and the em come
  // off the frame's probe (.sheet-probe), observed first so its entry is read before the stack's.
  const probe = stack.parentElement?.querySelector<HTMLElement>(':scope > .sheet-probe');
  if (probe) measure.observe(probe);
  measure.observe(stack);

  // The title block's own size, in plain pixels on its sheet. On a landscape sheet the block
  // is absolutely placed in the bottom-right corner, over the artwork column, so a demo that
  // fills that column has to know how far up the corner reaches to stay out of it. How far
  // that is depends on which step of the block's fit ladder the sheet width picked and on how
  // wide the text in the cells ran, so it is measured rather than restated as a constant.
  [...stack.querySelectorAll<HTMLElement>('section > table')].forEach((block) => {
    measure.observe(block);
    const sheet = block.parentElement;
    if (!sheet) return;
    fitTitleBlock.observe(sheet);
    watchFrontPage(sheet, (front) => {
      if (front) fitLater([sheet]);
    });
  });
}

// The width the artwork layers switch their type at, the same 56em their remaining
// `@container technical-drawing-width` rules use, restated here because the em is the
// container's: the frame declares the container and inherits the root's font size, and the
// stack spans the frame (which is also what the fan's `100cqw` margin below leans on). The two
// have to flip at the same width or a layer would take its wide padding with its narrow type.
const SHEET_WIDE_EM = 56;

// A write that leaves the value as it was is skipped, so a resize step that moved nothing on a
// sheet does not wake whatever watches its style attribute.
function put(el: HTMLElement, name: string, value: string) {
  if (el.style.getPropertyValue(name) !== value) el.style.setProperty(name, value);
}

// Each frame's probe as last observed: its width is the sheet's em and its height says whether
// the width query picked portrait. The probe only reports when one of those changes, so a
// step that resizes the stack alone reads the kept values.
const probes = new WeakMap<HTMLElement, { em: number, portrait: boolean }>();

// One observer for every stack, probe and title block, so a resize is answered with all the
// reads before any of the writes: a write to one stack followed by a read from the next would
// make the browser redo style in between, once per stack. Nothing here asks for computed
// style: every number comes off an entry.
const measure = new ResizeObserver((entries) => {
  const stacks = [];
  const blocks = [];
  for (const entry of entries) {
    const target = entry.target as HTMLElement;
    if (target === document.documentElement) {
      // The root is as wide as the window less a classic scrollbar, which 100vw counts, so the
      // difference is what the frame's --sheet-inline takes off the viewport. It changes when a
      // scrollbar comes or goes, not on every step.
      const [{ inlineSize }] = entry.borderBoxSize;
      put(target, '--scrollbar-inline', `${Math.max(0, window.innerWidth - inlineSize)}px`);
    } else if (target.matches('.sheet-probe')) {
      const [{ inlineSize, blockSize }] = entry.borderBoxSize;
      probes.set(target.parentElement as HTMLElement, { em: inlineSize || 16, portrait: blockSize > 1.5 });
    } else if (target.matches('article.technical-drawing-stack')) {
      const [{ inlineSize }] = entry.contentBoxSize;
      stacks.push({ stack: target, inlineSize });
    } else {
      const [{ inlineSize, blockSize }] = entry.borderBoxSize;
      blocks.push({ sheet: target.parentElement as HTMLElement, inlineSize, blockSize });
    }
  }
  for (const { stack, inlineSize } of stacks) {
    const { em, portrait } = probes.get(stack.parentElement as HTMLElement) ?? { em: 16, portrait: false };
    const wide = inlineSize >= SHEET_WIDE_EM * em;
    // Both only when they actually change. Writing the same value back is still an attribute
    // write, and this page carries enough `:has()` rules that any attribute change invalidates
    // every element in the document (see PR #50).
    const orientation = portrait ? 'portrait' : 'landscape';
    if (stack.dataset.sheetOrientation !== orientation) stack.dataset.sheetOrientation = orientation;
    const band = wide ? 'wide' : 'narrow';
    if (stack.dataset.sheetWidth !== band) stack.dataset.sheetWidth = band;
  }
  for (const { sheet, inlineSize, blockSize } of blocks) {
    put(sheet, '--title-block-inline', `${inlineSize}px`);
    put(sheet, '--title-block-block', `${blockSize}px`);
  }
});

// Which cells of the title block each sheet's own artwork leaves room for (title-fit.ts). Only
// the front page is measured: the pages behind it show no more of their block than an edge, and
// measuring all of them made a resize step through the ladder's widths a tenth slower. A page
// behind goes back to the ladder when the sheet resizes, and is measured when it comes to the
// front. Every sheet is read before any is written, so a pass costs one layout, not one per sheet.
const fitTitleBlocks = (sheets: HTMLElement[]) => sheets
  .map((sheet) => (isFrontPage(sheet) ? readTitleFit(sheet) : { sheet, fit: null }))
  .forEach(writeTitleFit);
// A frame after the sheet resized, not in the observer's callback: the annotations are moved to
// the new size by their own observer, after this one has run, and a sheet read before that
// measured its callouts where they stood at the old size.
const fitPending = new Set<HTMLElement>();
let fitFrame = 0;
const fitLater = (sheets: HTMLElement[]) => {
  sheets.forEach((sheet) => fitPending.add(sheet));
  fitFrame ||= requestAnimationFrame(() => {
    fitFrame = 0;
    const pending = [...fitPending];
    fitPending.clear();
    fitTitleBlocks(pending);
  });
};
const fitTitleBlock = new ResizeObserver((entries) => {
  fitLater(entries.map((entry) => entry.target as HTMLElement));
});

// The top stack alone carries the hints: one is a nudge, one per demo is wallpaper, and by the
// third stack the reader has worked it out. Arming them from here is also what keeps them off a
// page whose JS never ran, where nothing would turn anyway.
function armHints() {
  const frame = document.querySelector<HTMLElement>('.technical-drawing-frame');
  if (!frame) return;
  frame.setAttribute('data-hint-show', '');
  // The callout's title probes (Callout.astro) read the mark from the view above the frame.
  frame.closest('.callout-view')?.setAttribute('data-hint-show', '');
  drawFlipHints(frame);
}

function init() {
  measure.observe(document.documentElement);
  [...document.querySelectorAll<HTMLElement>('article.technical-drawing-stack')].forEach(initStack);
  armHints();

  // The block's cells are measured in its own fonts, and a sheet fitted before they arrived was
  // fitted to the fallback's widths.
  document.fonts.ready.then(() => {
    forgetTextWidths();
    fitTitleBlocks([...document.querySelectorAll<HTMLElement>('article.technical-drawing-stack section:has(> table)')]);
  });
}

/* A module script is deferred, so by the time this one runs the document is already
   "interactive" while DOMContentLoaded has still to fire. Listening for that event as
   well as calling init() ran the whole setup twice, and doubled every listener it binds.
   A doubled key press was invisible, since play twice is still play. A doubled press of
   the marks shapes 4 to 6 draw is not: they toggle, so the second undid the first. */
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init, { once: true });
} else {
  init();
}
</script>
