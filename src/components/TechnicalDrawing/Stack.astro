---
import PaperStack from '@/components/PaperStack/index.astro';

import TechnicalDrawingPage from './Page.astro';

type Layer = {
  name: string | null;
  size?: string;
  pageStyle?: string;
  /** Per-page tech icon(s); falls back to stack `tech`. */
  tech?: string | readonly string[];
};

type Props = {
  layers?: Record<string, Layer>;
  subtitle?: string;
  scale?: string;
  size?: string;
  date?: string;
  /** Default tech icon(s) for every page (tag text or icon suffix). */
  tech?: string | readonly string[];
  /** Words next to the arrow that points at the fold. */
  hint?: string;
};

const { layers = {}, tech: stackTech } = Astro.props;
const totalLayers = Object.keys(layers).length;
const hint = Astro.props.hint ?? `${totalLayers - 1} more sheets, peel this corner`;
const hintBack = 'this corner drags the page back';

// One arrow, drawn twice and turned by the CSS. Its tip is at (6, 14) and the shaft leaves it
// along +x, so the element's left edge at half its height is the point the arrow aims at and
// `rotate` decides from which side it comes. Drawn by a hand that is not steady: the shaft
// wanders, a lighter second pass doubles part of it the way a marker does when it goes back over
// a line, and the head's two barbs are different lengths and miss both the shaft and each other.
const arrow = {
  shaft: 'M46 23 C 40 25, 30.5 24.5, 24 21 C 19 18.5, 17 14.6, 12 14.1 C 9.5 13.85, 8.5 13.95, 6 14',
  pass: 'M45 24 C 37.5 25.5, 28.5 24, 22.5 20.5',
  head: 'M15.5 8 L5.5 13.4 M13.9 19.6 L5.3 13.8',
};
---

<div class="technical-drawing-frame">
  <PaperStack as="article" class="technical-drawing-stack" pageCount={totalLayers} label={Astro.props.subtitle}>
    {(index: number) => {
      const [id, { name, size, pageStyle, tech }] = Object.entries(layers)[index];
      return (
        <TechnicalDrawingPage
          title={name}
          subtitle={Astro.props.subtitle}
          scale={Astro.props.scale}
          size={size ?? Astro.props.size}
          date={Astro.props.date}
          index={index + 1}
          layerCount={totalLayers}
          pageStyle={pageStyle}
          tech={tech ?? stackTech}
        >
          <Fragment slot="content">
            {Astro.slots.render('layers', [id])}
          </Fragment>
          <Fragment slot="aside">
            {Astro.slots.render('aside', [id])}
          </Fragment>
        </TechnicalDrawingPage>
      );
    }}
  </PaperStack>

  <div class="flip-hints" aria-hidden="true">
    <p class="flip-hint flip-hint--fwd hint-words marker-font">{hint}</p>
    <svg class="flip-hint flip-hint--fwd hint-arrow" viewBox="0 0 48 28">
      <path class="hint-halo" d={arrow.shaft} />
      <path class="hint-halo" d={arrow.head} />
      <path class="hint-shaft" d={arrow.shaft} />
      <path class="hint-pass" d={arrow.pass} />
      <path class="hint-head" d={arrow.head} />
    </svg>

    <p class="flip-hint flip-hint--back hint-words marker-font">{hintBack}</p>
    <svg class="flip-hint flip-hint--back hint-arrow" viewBox="0 0 48 28">
      <path class="hint-halo" d={arrow.shaft} />
      <path class="hint-halo" d={arrow.head} />
      <path class="hint-shaft" d={arrow.shaft} />
      <path class="hint-pass" d={arrow.pass} />
      <path class="hint-head" d={arrow.head} />
    </svg>
  </div>
</div>

<style lang="scss">
// The lean a page this tall takes, shared by the stack and by the hint layer beside it.
$portrait-lean-x: 4.5em;
$portrait-lean-y: 2.25em;

// The width container has to be an ancestor of the stack, not the stack itself: the stack is
// what the aspect query below styles, and an element never matches a container it declares
// (its own `container: technical-drawing / size` would also overwrite a second name set here).
.technical-drawing-frame {
  position: relative;
  container: technical-drawing-width / inline-size;
  // Allow the frame to shrink within the page grid instead of expanding it
  // to the stack's intrinsic width (default min-width: auto).
  min-width: 0;
}

:global(article.technical-drawing-stack) {
  --technical-drawing-aspect: 2 / 1;

  width: 100%;
  height: auto;
  aspect-ratio: var(--technical-drawing-aspect);

  color: var(--ink);

  container: technical-drawing / size;

  /* How far the resting crease reaches along the sheet's long side. The crease is what a flip
     folds the sheet along and what the folded-back corner is cut on, so this one number is the
     size of the dog-ear at the top left. A fixed em made it a fifth of the way across a
     phone-width sheet and a twentieth on a desktop one, so it is a fraction of the sheet
     instead, floored so the paper clip still has a corner to sit in and capped at what a
     desktop sheet already had. 100cqw is the frame's width, which is the stack's own. */
  --paper-clip-reach: clamp(2.75em, 7.5cqw, 4.5em);
  --paper-clip-lean-x: calc(var(--paper-clip-reach) / 2);
  --paper-clip-lean-y: var(--paper-clip-reach);

  @container technical-drawing-width (max-width: 40em) {
    /* Portrait has to stack artwork, note and title block where landscape put
       them side by side, so take the height a phone actually has. */
    --technical-drawing-aspect: 3 / 5;
    max-height: min(36rem, 85svh);

    /* Transpose the paper clip with the page. The lean sets the resting crease,
       and the crease is what a flip folds the sheet along, so on a page this
       tall the landscape lean throws the corner sideways across two and a half
       page widths before it lands. Swapping the intercepts lays the clip
       flat — onto the left edge, which PaperStack derives from the same two
       numbers — and sends the fold up the long axis instead. */
    --paper-clip-lean-x: var(--paper-clip-reach);
    --paper-clip-lean-y: calc(var(--paper-clip-reach) / 2);
  }
}

// The hint layer is the stack's sibling, not its child, so the transposed lean does not reach it
// by inheritance. It needs the same two numbers to find the folded-away corner's crease.
@container technical-drawing-width (max-width: 40em) {
  .flip-hints {
    --paper-clip-lean-x: #{$portrait-lean-x};
    --paper-clip-lean-y: #{$portrait-lean-y};
  }
}

// Two sentences drawn on the frame: this corner turns the page, and that corner brings it back.
// The script decides which stacks get them, and nothing shows until it does, which also keeps
// all of this off a page without JS.
.flip-hints {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: none;
  color: var(--accent-text);
  pointer-events: none;
}

.technical-drawing-frame[data-hint-show] .flip-hints {
  display: block;
}

.flip-hint {
  position: absolute;
  margin: 0;
  line-height: 1.2;
  pointer-events: none;
  transition: opacity 400ms ease;
}

.flip-hints svg {
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
}

// The way back only makes sense once there is a page behind you, and only until you find it.
.flip-hint--back {
  opacity: 0;
}

.technical-drawing-frame:has([data-paper-turned]) {
  .flip-hint--fwd { opacity: 0; }
  .flip-hint--back { opacity: 1; }
}

.technical-drawing-frame:has([data-paper-returned]) .flip-hint--back {
  opacity: 0;
}

// The marker line, off the sheet in the room the fan reserves below it.
.hint-words {
  max-width: 24em;
  font-size: 1rem;

  @container technical-drawing-width (max-width: 40em) {
    font-size: 0.8125rem;
  }
}

// Under the fan rather than over it: the frame's own bottom edge is where the reserve for the
// fanned pages ends, and the words are hard to read across their stripes.
.flip-hint--fwd.hint-words {
  top: calc(100% + 0.125em);
  right: 3.5em;
  text-align: right;
}

.flip-hint--back.hint-words {
  top: 0;
  left: 0.5em;
  translate: 0 -100%;

  // Portrait swings the way back's arrow up over the frame's top edge instead of out past its
  // left one, through where these words would otherwise sit.
  @container technical-drawing-width (max-width: 40em) {
    left: 3em;
  }
}

// Left edge, half height: the point the tip aims at, which `rotate` then swings around. The tip
// itself stands 6/48 of the width off it along the arrow's own line, which is the gap it keeps
// between its nib and the paper.
.hint-arrow {
  width: 3.25em;
  aspect-ratio: 48 / 28;
  transform-origin: 0 50%;
  translate: 0 -50%;

  .hint-shaft { stroke-width: 2.5px; }
  .hint-pass { stroke-width: 1.25px; opacity: 0.45; }
  .hint-head { stroke-width: 2.75px; }

  // The tail crosses the fanned edges of the pages behind the sheet on its way in from the gap,
  // and marker ink on those stripes measured 1.4:1 at best. A pass in the page's own colour
  // under the stroke brings the grid paper along with the line.
  .hint-halo {
    stroke: var(--surface-page);
    stroke-width: 7px;
    opacity: 0.9;
  }
}

// Both arrows point at the middle of the crease they invite you to take hold of, square to it:
// aiming at the page's corner instead says nothing about which way the paper travels, and the
// corner is the one part of the fold the hand does not need.
//
// The way out is the dog-ear on the front page, whose resting crease runs from
// (100% - x, 100%) to (100%, 100% - y) of the sheet. atan2(x, y) is the angle of its normal,
// since the crease itself leans by atan2(y, x) the other way.
.flip-hint--fwd.hint-arrow {
  left: calc(100% - var(--fold-rest-x, 2cm) / 2);
  top: calc(var(--stack-block, 100%) - var(--fold-rest-y, 1cm) / 2);
  rotate: atan2(var(--fold-rest-x, 2cm), var(--fold-rest-y, 1cm));
}

// The way back is the folded-away top-left corner, whose crease runs from (lean-x, 0) to
// (0, lean-y) and whose middle is the pin the paper clip holds. Same normal, half a turn round,
// so the arrow comes in over the cut corner rather than across the sheet.
.flip-hint--back.hint-arrow {
  left: calc(var(--paper-clip-lean-x, 2.25em) / 2);
  top: calc(var(--paper-clip-lean-y, 4.5em) / 2);
  rotate: calc(180deg + atan2(var(--paper-clip-lean-x, 2.25em), var(--paper-clip-lean-y, 4.5em)));
}
</style>

<script>
import { initAutoplayStatus } from '@/client/autoplayStatus';
import { isFrontPage, watchFrontPage } from '@/client/frontPage';
import './demo-cursor-press';

import { positionAnnotations } from './annotations-position';

function initStack(stack: HTMLElement) {
  const onScreen = new WeakMap<HTMLElement, boolean>();

  // Being on screen is only half of it: every page of the stack shares one grid cell, so
  // intersection says nothing about which one is drawn on top. Without the --page-index
  // half, a page's intro animation ran (and finished) while it was still covered, and the
  // visitor who turned to it got the end state instead of the animation.
  const apply = (page: HTMLElement) => {
    const active = Boolean(onScreen.get(page)) && isFrontPage(page);

    page.getAnimations({ subtree: true }).forEach((animation) => {
      if (!active && (animation.playState === 'running' || animation.playState === 'finished')) {
        animation.cancel();
        // Cancelled animations get removed, so start them, but pause immediately
        animation.play();
        animation.pause();
      } else {
        animation.play();
      }
    });

    page.style[active ? 'removeProperty' : 'setProperty']('animation-play-state', 'paused');
  };

  // Viewport root (not the stack): with root:stack the active slide was
  // "intersecting" on load even when still below the fold. Stack overflow
  // still clips off-screen carousel slides from the viewport intersection.
  const observer = new IntersectionObserver((intersections) => {
    [...intersections].forEach((entry) => {
      const page = entry.target as HTMLElement;
      onScreen.set(page, entry.isIntersecting);
      apply(page);
    });
  }, { threshold: 0.25, scrollMargin: '25%' });
  [...stack.querySelectorAll('section')].forEach((page) => {
    observer.observe(page);
    watchFrontPage(page, () => apply(page));
  });

  // So the first state a demo reports is already heard.
  [...stack.querySelectorAll<HTMLElement>(':scope > * > section')]
    .forEach((page) => initAutoplayStatus(page));

  positionAnnotations(stack);

  // The dog-ear's resting size, lifted from the stack onto the frame: the hint layer is the
  // stack's sibling, so the property PaperStack publishes does not reach it by inheritance, and
  // without it the arrow has no crease to aim at. It never changes, so once is enough.
  const stackStyle = getComputedStyle(stack);
  for (const rest of ['--fold-rest-x', '--fold-rest-y']) {
    stack.parentElement?.style.setProperty(rest, stackStyle.getPropertyValue(rest));
  }

  // The sheet's size and orientation, restated as plain pixels and a data attribute for the
  // artwork to scale its type by. The container queries and units say the same thing, but a
  // font-size that comes out of them — by unit, by rule, or by an inherited variable — inside
  // the deep grids of some layers makes every em in them depend on this container, and
  // Chrome's layout of that runs seconds per pass: a resize, or docking DevTools, froze the
  // page for twenty. The orientation is read back from the aspect the width query picked.
  measure.observe(stack);
}

// One observer for every stack, so a resize is answered with all the reads before any of the
// writes: a write to one stack followed by a read from the next would make the browser redo
// style in between, once per stack.
const measure = new ResizeObserver((entries) => {
  const read = entries.map((entry) => {
    const [{ inlineSize, blockSize }] = entry.contentBoxSize;
    const [w, h] = getComputedStyle(entry.target).aspectRatio.split('/').map(Number);
    return { stack: entry.target as HTMLElement, inlineSize, blockSize, portrait: h > w };
  });
  for (const { stack, inlineSize, blockSize, portrait } of read) {
    stack.style.setProperty('--sheet-inline', `${inlineSize}px`);
    stack.style.setProperty('--sheet-block', `${blockSize}px`);
    stack.dataset.sheetOrientation = portrait ? 'portrait' : 'landscape';
    // The frame is taller than the sheet by the fan's reserve, so a hint that belongs on the
    // sheet's own bottom edge cannot be placed from the frame's box alone.
    (stack.parentElement as HTMLElement | null)?.style.setProperty('--stack-block', `${blockSize}px`);
  }
});

// The top stack alone carries the hints: one is a nudge, one per demo is wallpaper, and by the
// third stack the reader has worked it out. Arming them from here is also what keeps them off a
// page whose JS never ran, where nothing would turn anyway.
function armHints() {
  document.querySelector<HTMLElement>('.technical-drawing-frame')?.setAttribute('data-hint-show', '');
}

function init() {
  [...document.querySelectorAll<HTMLElement>('article.technical-drawing-stack')].forEach(initStack);
  armHints();
}

/* A module script is deferred, so by the time this one runs the document is already
   "interactive" while DOMContentLoaded has still to fire. Listening for that event as
   well as calling init() ran the whole setup twice, and doubled every listener it binds.
   A doubled key press was invisible, since play twice is still play. A doubled press of
   the marks shapes 4 to 6 draw is not: they toggle, so the second undid the first. */
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init, { once: true });
} else {
  init();
}
</script>
