---
import TechnicalDrawingPage from './Page.astro';

type Layer = {
  name: string | null;
  size?: string;
  pageStyle?: string;
  /** Per-page tech icon(s); falls back to stack `tech`. */
  tech?: string | readonly string[];
};

type Props = {
  layers?: Record<string, Layer>;
  subtitle?: string;
  scale?: string;
  size?: string;
  date?: string;
  /** Default tech icon(s) for every page (tag text or icon suffix). */
  tech?: string | readonly string[];
};

const { layers = {}, tech: stackTech } = Astro.props;
const totalLayers = Object.keys(layers).length;
---

<div class="technical-drawing-frame">
  <article class="technical-drawing-stack">
    {Object.entries(layers).map(([id, { name, size, pageStyle, tech }], index) => (
      <TechnicalDrawingPage
        title={name}
        subtitle={Astro.props.subtitle}
        scale={Astro.props.scale}
        size={size ?? Astro.props.size}
        date={Astro.props.date}
        index={index + 1}
        layerCount={totalLayers}
        pageStyle={pageStyle}
        tech={tech ?? stackTech}
      >
        <Fragment slot="content">
          {Astro.slots.render('layers', [id])}
        </Fragment>
        <Fragment slot="aside">
          {Astro.slots.render('aside', [id])}
        </Fragment>
      </TechnicalDrawingPage>
    ))}
  </article>

  {totalLayers > 1 && (
    <div class="technical-drawing-nav" hidden>
      <button type="button" data-dir="-1" aria-label="Previous drawing">⬅</button>
      <button type="button" data-dir="1" aria-label="Next drawing">⮕</button>
    </div>
  )}
</div>


<style lang="scss">
.technical-drawing-frame {
  container: technical-drawing-width / inline-size;
  position: relative;
  width: 100%;
  // Allow the frame to shrink within the page grid instead of expanding it
  // to the carousel's intrinsic width (default min-width: auto).
  min-width: 0;
  // Firefox: overflow:hidden on this ancestor makes the nested carousel
  // report scrollWidth but refuse scrollLeft / swipe. clip still contains
  // the frame without breaking the child's scrollport.
  overflow: clip;
}

article {
  --technical-drawing-aspect: 2 / 1;

  width: 100%;
  height: auto;
  aspect-ratio: var(--technical-drawing-aspect);

  color: var(--ink);

  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
  scroll-behavior: smooth;

  display: flex;
  flex-direction: row;

  position: relative;
  container: technical-drawing / size;
  anchor-name: --technical-drawing-stack;
  anchor-scope: --technical-drawing-stack;

  @container technical-drawing-width (max-width: 40em) {
    --technical-drawing-aspect: 3 / 4;
    max-height: min(36rem, 85svh);
  }

  > :global(*) {
    flex: 0 0 100%;
    // Clip both axes — annotation SVGs are 200% overlays and otherwise inflate
    // scrollWidth, leaving a permanent horizontal scrollbar on every page.
    overflow: clip;
    scroll-snap-align: center;
  }
}

@supports selector(::scroll-button(right)) {
  article {
    &::scroll-button(*) {
      position-anchor: --technical-drawing-stack;
      position: absolute;
      top: anchor(top);
    }

    &::scroll-button(left) {
      content: "⬅" / "Scroll Left";
      left: anchor(left);
    }

    &::scroll-button(right) {
      content: "⮕" / "Scroll Right";
      right: anchor(right);
    }

    &::scroll-button(*):focus-visible {
      outline-offset: 0.25rem;
    }
  }

  // Prefer native scroll buttons; keep the JS fallback out of the way.
  .technical-drawing-nav {
    display: none;
  }
}

.technical-drawing-nav {
  position: absolute;
  inset: 0 0 auto;
  z-index: 2;
  justify-content: space-between;
  pointer-events: none;

  // Avoid `display` on the root so `[hidden]` is not overridden.
  &:not([hidden]) {
    display: flex;
  }

  button {
    pointer-events: auto;
    margin: 0.375rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.375rem;
    background: color-mix(in oklch, var(--surface-raised), transparent 15%);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;

    &:hover,
    &:focus-visible {
      background: color-mix(in oklch, var(--surface-raised), var(--accent) 12%);
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 0.125rem;
    }
  }
}
</style>

<script>
const supportsScrollButton = CSS.supports('selector(::scroll-button(right))');

function initStack(stack: HTMLElement) {
  // Viewport root (not the stack): with root:stack the active slide was
  // "intersecting" on load even when still below the fold. Stack overflow
  // still clips off-screen carousel slides from the viewport intersection.
  const observer = new IntersectionObserver((intersections) => {
    [...intersections].forEach((entry) => {
      const target = entry.target as HTMLElement;

      target.getAnimations({ subtree: true }).forEach((animation) => {
        if (!entry.isIntersecting && (animation.playState === 'running' || animation.playState === 'finished')) {
          animation.cancel();
          // Cancelled animations get removed, so start them, but pause immediately
          animation.play();
          animation.pause();
        } else {
          animation.play();
        }
      });

      target.style[
        entry.isIntersecting ? 'removeProperty' : 'setProperty'
      ]('animation-play-state', 'paused');
    });
  }, { threshold: 0.25, scrollMargin: '25%' });
  [...stack.querySelectorAll('section')].forEach((page) => observer.observe(page));

  if (supportsScrollButton) return;

  const frame = stack.closest('.technical-drawing-frame');
  const nav = frame?.querySelector<HTMLElement>('.technical-drawing-nav');
  if (!nav) return;

  nav.hidden = false;
  nav.querySelectorAll<HTMLButtonElement>('button[data-dir]').forEach((button) => {
    button.addEventListener('click', () => {
      const dir = Number(button.dataset.dir);
      const delta = dir * stack.clientWidth;
      stack.scrollTo({ left: stack.scrollLeft + delta, behavior: 'smooth' });
    });
  });
}

function init() {
  [...document.querySelectorAll<HTMLElement>('article.technical-drawing-stack')].forEach(initStack);
}

document.addEventListener('DOMContentLoaded', init);

if (document.readyState !== 'loading') { init(); }
</script>
