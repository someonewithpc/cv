---
import { Icon } from 'astro-icon/components';
---

<section class={Astro.props.pageStyle}>
  <div class="content">
    <slot name="content" />
  </div>

  <div class="aside">
    <slot name="aside" />
  </div>

  <table>
    <tbody>
      <tr>
        <td colspan=5>
          <header>
            <h2 class="typewriter">{Astro.props.title ?? Astro.props.subtitle}</h2>
            {Astro.props.title && Astro.props.subtitle && (<h3 class="typewriter">{Astro.props.subtitle}</h3>)}
          </header>
        </td>
      </tr>
      <tr>
        <td>
          <div>
            <h3 class="monospace">Drawing No.</h3>
            <span class="typewriter">{Astro.props.index} / {Astro.props.layerCount}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Scale</h3>
            <span class="typewriter">{Astro.props.scale ?? '3:1'}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Weight</h3>
            <span class="typewriter">{Astro.props.size ?? '-'}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Date</h3>
            <span class="typewriter"><time datetime={Astro.props.date}>{Astro.props.date ?? '-'}</time></span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace" title="Projection">Proj.</h3>
            <Icon name="first-angle-projection" title="First Angle Projection" />
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</section>

<style lang="scss">
@use 'sass:math';

@use "@/scss/_colors.scss" as colors;

section {
  $border: 1px solid var(--fg-800);
  $border-offset: 1em;

  contain: size style;

  width: 100%;
  height: 100%;
  border: $border-offset solid var(--bg-800);
  outline: $border;
  outline-offset: -$border-offset;

  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  position: relative;

  background: var(--bg-800);
  &:global(.blueprint) {
    border-color: var(--blueprint-900);

    $alpha: 25%;
    $line-color: color-mix(in srgb, var(--blueprint-900), white #{$alpha});
    background-size: 1cm 1cm;
    background-image:
      linear-gradient(to right, #{$line-color} 1px, transparent 1px),
      linear-gradient(to bottom, #{$line-color} 1px, var(--blueprint-900) 1px);

    --base-fg: #fff;
    --base-bg: #ddd;
    --base-accent: hsl(
      from color-mix(in oklab, var(--theme-base-accent), var(--theme-base-fg) 40%)
      h calc(s * 2.5) l
    );

    @include colors.color-variables;
  }

  .content {
    grid-column: 1 / 3;
    place-self: center;
    position: relative;
    width: fit-content;
    height: fit-content;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .aside {
    max-height: 100%;
    grid-column: 3;
    margin-inline: auto;
  }

  .layers {
    grid-column: 3;
    justify-self: center;

    display: grid;
    grid-template-columns: auto auto;

    ol {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / 3;

      a {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / 3;

        li {
          display: grid;
          grid-template-columns: subgrid;
          grid-column: 1 / 3;

          span {
            border: $border;
            margin-right: -1px;
            margin-bottom: -1px;

            $padding-inline: 0.25em;
            $padding-block: 0.375em;
            padding: $padding-inline $padding-block;
          }
        }
      }

    }
  }

  & > table {
    position: absolute;
    right: -1px;
    bottom: -1px;

    border-collapse: collapse;
    border-spacing: 0;

    td {
      border: $border;
      padding: 0.25em;
      color: var(--fg-850);

      header {
        display: inline-block;
        rotate: calc(var(--random1) * 0.75deg);
        translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px);

        h3 {
          color: var(--fg-700);
          font-size: 0.675em;
          margin-top: 0.25rem;
        }
      }

      & > div {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.25rem;

        h3 {
          font-size: 0.625rem;
        }

        span {
          rotate: calc(var(--random1) * 1.5deg);
          /* translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px); */
        }

        span, svg {
          margin-inline: auto;
        }
      }
    }
  }

  @container technical-drawing (orientation: portrait) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1.75fr) minmax(0, 1fr);
    align-items: stretch;

    .content {
      font-size: min(1rem, 3.25cqw);

      grid-column: 1;
      grid-row: 1;
    }

    .aside {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
      align-self: end;
      width: max-content;
      max-width: calc(100% - 1em);
      height: auto;
      max-height: none;
      margin-block: 0.5em 5.5em;
      overflow: visible;
      z-index: 1;
    }

    .layers {
      grid-column: 1;
      grid-row: 2;
    }

    & > table {
      font-size: 0.75em;
    }
  }

  @for $i from 1 through 20 {
    @for $j from 1 through 20 {
      &:nth-child(#{$i}) td:nth-child(#{$j}) {
        --random1: #{math.random() * 2 - 1};
        --random2: #{math.random() * 2 - 1};
        --random3: #{math.random() * 2 - 1};
      }
    }
  }
}
</style>
