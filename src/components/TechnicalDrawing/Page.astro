---
import { Icon } from 'astro-icon/components';

import TechIcon from '@/components/TechIcon.astro';

import { resolveTechs } from '@/server/tech-icons';

type Props = {
  title?: string | null;
  subtitle?: string;
  scale?: string;
  size?: string;
  date?: string;
  index?: number;
  layerCount?: number;
  pageStyle?: string;
  /** Tech name(s) or icon suffix(es) in a square rowspan cell. */
  tech?: string | readonly string[];
};

const {
  title,
  subtitle,
  scale,
  size,
  date,
  index,
  layerCount,
  pageStyle,
  tech,
} = Astro.props;

const techs = resolveTechs(tech);

const noteId = `drawing-note-${crypto.randomUUID().slice(0, 8)}`;

/* The fold is the note's own corner peeking out from under the sheet, so it
   wears the note's paper color. The slot arrives pre-rendered (Stack.astro
   renders it per layer), which lets the PostIt's inline custom properties be
   read here instead of plumbing the color through every demo. */
const asideHtml = (await Astro.slots.render('aside')) ?? '';
const noteBackground = asideHtml.match(/--background:\s*([^;"]+)/)?.[1];
const sheetAnchor = `--${noteId}-sheet`;
const titleAnchor = `--${noteId}-title`;

/* One chassis, three glyphs: a cassette key drawn from the top left, so its cap has a
   front and a side face to drop onto when it is held down. Each glyph sits in the cap's
   own box (x 1 to 18, y 1 to 13), cut wide enough to still read at a 12px key. */
const transportKeys = [
  {
    id: 'reset',
    label: 'Reset the walkthrough',
    glyph: '<path d="M4.6 3.4v7.2" /><path d="M10 3.4 6.6 7 10 10.6Z" /><path d="M14.4 3.4 11 7l3.4 3.6Z" />',
  },
  {
    id: 'play',
    label: 'Play the walkthrough',
    glyph: '<path d="M6.6 2.9 13.9 7l-7.3 4.1Z" />',
  },
  {
    id: 'pause',
    label: 'Take over',
    glyph: '<path d="M6.6 3.2h2.3v7.6H6.6z" /><path d="M10.6 3.2h2.3v7.6h-2.3z" />',
  },
];
---

<section
  class={pageStyle}
  style={{ 'anchor-name': sheetAnchor, '--drawing-sheet-anchor': sheetAnchor, '--drawing-title-anchor': titleAnchor }}
>
  <div class="content">
    <slot name="content" />
  </div>

  <div class="aside" style={{ '--note-background': noteBackground }}>
    <dialog class="drawing-note" id={noteId} aria-label={`Note for ${title ?? subtitle ?? 'this drawing'}`}>
      <form method="dialog">
        <button class="note-dismiss" type="submit">
          <span class="sr-only">Close note</span>
        </button>
      </form>

      <div class="note-card" tabindex="-1" autofocus>
        <Fragment set:html={asideHtml} />
      </div>
    </dialog>

    <button class="note-fold" type="button" command="show-modal" commandfor={noteId}>
      <span class="note-fold-label monospace" aria-hidden="true">Note</span>
      <span class="sr-only">Open this drawing's note</span>
    </button>
  </div>

  <table aria-label={`${title ?? subtitle ?? 'Drawing'} title block`} style={{ 'anchor-name': titleAnchor }}>
    <tbody>
      <tr>
        {techs.length > 0 && (
          <td rowspan="2" class="title-tech" aria-hidden="true">
            <div class="title-tech-stack" data-count={techs.length}>
              {techs.map((entry) => (
                <TechIcon tech={entry} decorative />
              ))}
            </div>
          </td>
        )}
        <td colspan="5" class="title-name">
          <header>
            <h2 class="typewriter">{title ?? subtitle}</h2>
            {title && subtitle && (<h3 class="typewriter">{subtitle}</h3>)}
          </header>
        </td>
      </tr>
      <tr>
        <td class="title-no">
          <div>
            <span class="title-label monospace">Drawing No.</span>
            <span class="typewriter">{index} / {layerCount}</span>
          </div>
        </td>

        <td class="title-scale">
          <div>
            <span class="title-label monospace">Scale</span>
            <span class="typewriter">{scale ?? '3:1'}</span>
          </div>
        </td>

        <td class="title-weight">
          <div>
            <span class="title-label monospace">Weight</span>
            <span class="typewriter">{size ?? '-'}</span>
          </div>
        </td>

        <td class="title-date">
          <div>
            <span class="title-label monospace">Date</span>
            <span class="typewriter"><time datetime={date}>{date ?? '-'}</time></span>
          </div>
        </td>

        <td class="title-proj">
          <div>
            <span class="title-label sr-only">Projection</span>
            <Icon name="first-angle-projection" aria-hidden="true" />
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  <!-- Transport deck: cassette keys, a lamp and a readout, filled in and revealed by
       src/client/autoplayStatus.ts once a demo on this sheet reports that it is playing
       by itself. Where it is drawn depends on the deck shape (see the styles below). -->
  <div class="demo-transport" data-demo-transport data-phase="intro" hidden>
    <span class="demo-keys">
      {transportKeys.map(({ id, label, glyph }) => (
        <button class="demo-key" type="button" data-demo-key={id} title={label} aria-pressed="false">
          <span class="sr-only">{label}</span>
          <svg viewBox="0 0 21 18" aria-hidden="true">
            <path class="key-bevel" d="M1 13 2.5 16.5h17L18 13Z" />
            <path class="key-bevel" d="M18 1 19.5 4.5v12L18 13Z" />
            <g class="key-cap">
              <rect class="key-face" x="1" y="1" width="17" height="12" rx="1.5" />
              <g class="key-hatch">
                <path d="M4 10.6 7.2 3.4" />
                <path d="M8.4 10.6 11.6 3.4" />
                <path d="M12.8 10.6 16 3.4" />
              </g>
              <g class="key-glyph" set:html={glyph} />
            </g>
          </svg>
        </button>
      ))}
    </span>

    <span class="demo-led" aria-hidden="true"></span>

    <span class="demo-readout">
      <span class="demo-label monospace" aria-hidden="true">Auto play</span>
      <span class="demo-value typewriter" data-demo-value aria-hidden="true"></span>
      <span class="demo-caption monospace" data-demo-caption role="status"></span>
      <span class="demo-hint monospace" data-demo-hint></span>
    </span>

    <!-- Shape 4: a dimension line along the bottom of the drawing, ticked once per step of
         the walkthrough, with the arrowhead that advances along it doubling as the control
         and a circled zero that rewinds. -->
    <span class="demo-dimension" data-demo-dimension>
      <span class="dim-lettering monospace" aria-hidden="true">
        <span data-demo-dimension-state></span>
        <span class="dim-stop">.</span>
        <span class="dim-hint" data-demo-dimension-hint></span>
      </span>

      <span class="dim-run">
        <span class="dim-line" aria-hidden="true"></span>

        <button class="dim-arrow" type="button" data-demo-act="toggle">
          <span class="sr-only" data-demo-act-label></span>
          <svg viewBox="0 0 12 10" aria-hidden="true"><path d="M11.5 5 1 9.4V0.6Z" /></svg>
        </button>
      </span>

      <button class="dim-zero" type="button" data-demo-act="replay">
        <span class="sr-only" data-demo-act-label></span>
        <span class="dim-zero-mark monospace" aria-hidden="true">0</span>
      </button>
    </span>

    <!-- Shape 5: a stamp inked onto the drawing, re-inked when the visitor takes over, and
         a pencil note beside it that rewinds. -->
    <span class="demo-stamp" data-demo-stamp>
      <button class="stamp-mark" type="button" data-demo-act="toggle">
        <span class="sr-only" data-demo-act-label></span>
        <span class="stamp-ring" aria-hidden="true">
          <span class="stamp-line monospace" data-demo-stamp-state></span>
          <span class="stamp-sub monospace" data-demo-stamp-hint></span>
        </span>
      </button>

      <button class="stamp-replay" type="button" data-demo-act="replay">
        <svg viewBox="0 0 14 14" aria-hidden="true">
          <path d="M7 2.2a4.8 4.8 0 1 1-4.5 3.2" />
          <path class="replay-head" d="M4.4 0.4 8 2.2 4.4 4Z" />
        </svg>
        <span class="monospace">replay</span>
      </button>
    </span>

    <!-- Shape 6: the sheet's own callout, leader into the drawing and the note written on
         its shelf. Taking over strikes the line out in pencil and writes the next one. -->
    <span class="demo-margin-note" data-demo-note>
      <svg class="note-leader" viewBox="0 0 40 32" aria-hidden="true">
        <path d="M4 4 40 31" />
        <path class="note-leader-head" d="M4 4 12.2 6.4 8.6 11.2Z" />
      </svg>

      <span class="note-first monospace" data-demo-note-line></span>

      <span class="note-second monospace">
        <span aria-hidden="true">you have it.</span>
        <button class="note-link" type="button" data-demo-act="toggle">hand back</button>
        <span class="note-slash" aria-hidden="true">/</span>
        <button class="note-link" type="button" data-demo-act="replay">replay</button>
      </span>
    </span>
  </div>
</section>

<style lang="scss">
@use 'sass:math';

@use "@/scss/_colors.scss" as colors;

/* Off the paper but still in the page: the shapes that letter the state onto the
   drawing keep the live region for a screen reader and say nothing twice. */
@mixin off-the-paper {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

section {
  /* rem, not em: the title block sets its own font-size, and an em offset there
     resolved smaller than the mat and pushed the block across the frame line. */
  --sheet-margin: 1rem;

  /* The note tab's size, and how far it reaches past the mat over the artwork.
     rem for the same reason: the tab sits in the sheet's corner, not in anyone's
     text. The reach is 0 until the tab appears, so a demo can keep its controls
     off that corner with one unconditional rule (see the tucked block below). */
  --note-fold-size: 3.5rem;
  --note-fold-reach: 0px;

  contain: size style;
  overflow: clip;

  width: 100%;
  height: 100%;

  $border: 1px solid var(--line-strong);
  border: $border;
  padding: var(--sheet-margin);
  border-radius: 0.5em;

  /* The mat and the frame line, in one paint: an even ring of mat, then the line
     drawn one pixel inside it. The margin is the same on all four sides, so the
     band the deck is drawn in is whatever the bottom of that ring leaves. */
  box-shadow: inset 0 0 0 var(--sheet-margin) var(--surface-sunken),
              inset 0 0 0 calc(var(--sheet-margin) + 1px) var(--line-strong);

  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  position: relative;

  background: var(--surface-sunken);
  &:global(.blueprint) {
    @include colors.blueprint-sheet-boundary;

    // Thick margin must match the sheet fill; the outline is the visible border.
    --surface-sunken: var(--blueprint);
    background-size: 1cm 1cm;
    background-image:
      linear-gradient(to right, var(--blueprint-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--blueprint-grid) 1px, var(--blueprint) 1px);
  }

  // Unfinished carousel pages — mute the mat + artwork so the WIP stamp reads clearly.
  &:global(.wip) {
    --blueprint: color-mix(in oklch, var(--theme-blueprint) 36%, #6a6e6a 64%);
    --blueprint-grid: color-mix(in oklch, var(--blueprint), #c5c8c5 34%);
    --surface-sunken: var(--blueprint);

    background-image:
      linear-gradient(to right, var(--blueprint-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--blueprint-grid) 1px, var(--blueprint) 1px);

    .content > :global(:not(.wip-stamp)) {
      filter: grayscale(0.72) brightness(0.88) contrast(0.94);
      opacity: 0.78;
    }

    .aside {
      filter: grayscale(0.4) brightness(0.95);
      opacity: 0.88;
    }

    table {
      filter: grayscale(0.3) brightness(0.96);
      opacity: 0.92;
    }
  }

  .content {
    grid-column: 1 / 3;
    place-self: center;
    position: relative;
    /* A scene stacks its own chrome inside this cell (Space Builder's rail and
       panels run to z-index 30), which used to outrank the note tab in the
       sheet's own stacking order and paint over it. Keep that ordering here. */
    isolation: isolate;
    // Fill the grid area so children with width:min(…, 100%) resolve against
    // the page cell — not a fit-content box that collapses under min-width:0.
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: fit-content;
    max-height: 100%;
    // Visible — Visrez (and other) annotation SVGs are 200% overlays anchored to
    // this box; clipping here hides callouts that should paint onto the sheet.
    // The section + stack already overflow:clip so those overlays do not inflate
    // the carousel scrollWidth.
    overflow: visible;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    /* Em-sized artwork tracks the sheet down once it is narrower than 50em;
       wider sheets get the full 1rem. Sized from the stack's measured pixels
       (Stack.astro's script) and keyed on its orientation attribute rather
       than the width or orientation queries: a font-size that comes out of a
       container query, on a subtree with grids this deep, costs Chrome half a
       second per layout. */
    font-size: min(1rem, 0.02 * var(--sheet-inline));

    :global([data-sheet-orientation='portrait']) & {
      /* Portrait gives the artwork the full sheet width, not a third of it. */
      font-size: min(1rem, 0.038 * var(--sheet-inline));
    }
  }

  /* The deck fills the bottom band, the strip of mat between the sheet edge and the
     frame line that the title block already sits against, starting clear of the
     dog-eared corner. The band is one margin deep, like the other three sides, so
     the keys are drawn at whatever that leaves. */
  .demo-transport {
    position: absolute;
    /* Both ends sit under the frame line's corners, so the paper left around the deck
       is the same at the ends as the band is deep above and below it. */
    left: var(--sheet-margin);
    right: var(--sheet-margin);
    bottom: 0;
    height: var(--sheet-margin);
    z-index: 4;

    display: flex;
    align-items: center;
    gap: 0.5em;

    color: var(--ink);
    font-size: 0.625rem;
    line-height: 1;
    /* Paper, not chrome: the band under it shows through, and the sheet stays
       hoverable everywhere except on the keys themselves. */
    pointer-events: none;

    &[hidden] {
      display: none;
    }
  }

  .demo-keys {
    display: flex;
    align-items: center;
    gap: 0.25em;
  }

  /* Each key is line art in the sheet's ink: a cap with a side bevel, and when it
     is held down the cap sits on the bevel and takes the hatch a sectioned part
     gets in a drawing. */
  .demo-key {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;

    svg {
      display: block;
      /* What the band leaves once the margin is the same on all four sides. The
         shapes that draw the deck somewhere else set their own size. */
      height: 0.75rem;
      width: auto;
      overflow: visible;
    }

    /* The sheet's own paper, not the mat the band is: --surface-raised sits a step
       away from the mat on every theme, which left the cap looking like an outline
       with the drawing showing through it. Paper is a step the other way, and it is
       the lightest surface on the light themes and the darkest on the dark ones, so
       the cap reads as a solid key on all four. */
    .key-face {
      fill: var(--surface-page);
      stroke: var(--line-strong);
      stroke-width: 0.9;
    }

    .key-bevel {
      fill: color-mix(in oklab, var(--ink) 18%, var(--surface-page));
      stroke: var(--line-strong);
      stroke-width: 0.9;
      stroke-linejoin: round;
    }

    .key-glyph {
      fill: var(--ink);
      stroke: var(--ink);
      stroke-width: 1.1;
      stroke-linejoin: round;
      stroke-linecap: square;
    }

    .key-hatch {
      display: none;
      stroke: var(--line-strong);
      stroke-width: 0.5;
      opacity: 0.55;
    }

    &:hover .key-glyph,
    &:focus-visible .key-glyph {
      fill: var(--accent);
      stroke: var(--accent);
    }

    &:focus-visible {
      outline: 1px solid var(--accent);
      outline-offset: 0.125em;
    }

    /* Held down: the cap drops the full depth of its bevel, which disappears under it,
       and the face takes a little ink so a held key still reads at a glance once the
       bevel that used to mark it is gone. */
    &[aria-pressed='true'] {
      .key-cap {
        translate: 1.5px 3.5px;
      }

      .key-face {
        fill: color-mix(in oklab, var(--ink) 12%, var(--surface-page));
      }

      .key-bevel {
        display: none;
      }

      .key-hatch {
        display: inline;
      }
    }

    &:active .key-cap {
      translate: 1.5px 3.5px;
    }

    &:disabled {
      cursor: default;
      opacity: 0.5;
    }
  }

  .demo-transport[data-state='playing'] [data-demo-key='play'] .key-glyph {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .demo-led {
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border: 1px solid var(--ink-muted);
    border-radius: 50%;
  }

  /* Not nested under .demo-led: an `&` there carries the whole `section .demo-led`
     chain into the selector and it never matches. */
  .demo-transport[data-state='playing'] .demo-led {
    border-color: var(--accent);
    background: var(--accent);
    animation: demo-led-pulse 1.6s ease-in-out infinite;
  }

  @keyframes demo-led-pulse {
    50% { opacity: 0.25; }
  }

  /* One line, because the band is one line tall: the state reads as a stamp and
     the instruction trails it in the muted ink the title block uses for labels. */
  .demo-readout {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    min-width: 0;
  }

  .demo-caption {
    flex: none;
    letter-spacing: 0.1em;
  }

  /* Ruled off from the state the way the title block rules its cells apart. */
  .demo-hint {
    overflow: hidden;
    padding-inline-start: 0.625em;
    border-inline-start: 1px solid var(--line);
    color: var(--ink-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Only the title block cell reads the state as a labelled value. */
  .demo-label,
  .demo-value {
    display: none;
  }

  /* Shapes 4 to 6 draw marks a sheet already has instead of keys, so each is hidden
     until its own shape is asked for. */
  .demo-dimension,
  .demo-stamp,
  .demo-margin-note {
    display: none;
  }

  /* Shape 2: the deck is one more cell of the title block, sitting on its top edge so
     the two share a rule, drawn in the block's border and its label face. */
  :global(html[data-deck='2']) & {
    .demo-transport {
      position-anchor: var(--drawing-title-anchor);
      left: auto;
      right: anchor(right);
      bottom: anchor(top);
      /* Never wider than the block it sits on, and no wider than its own contents, so
         it keeps to the corner the title block already claims from the drawing. */
      max-width: anchor-size(width);
      height: auto;
      padding: 0.25rem 0.5rem;
      gap: 0.5rem;

      border: 1px solid var(--line-strong);
      border-bottom: 0;
      background: var(--surface-sunken);
    }

    .demo-key svg {
      height: 1.125rem;
    }

    /* Ruled off from the keys the way the block rules its own cells apart. */
    .demo-readout {
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      margin-inline-start: auto;
      padding-inline-start: 0.5rem;
      border-inline-start: 1px solid var(--line);
    }

    .demo-label,
    .demo-value {
      display: block;
    }

    .demo-label {
      color: var(--ink-muted);
      font-size: 0.625rem;
    }

    .demo-value {
      font-size: 0.75rem;
    }

    /* The label and value are a reading, not an announcement, so the live region stays
       in the page for a screen reader and comes off the paper. */
    .demo-caption {
      @include off-the-paper;
    }

    .demo-hint {
      display: none;
    }
  }

  /* Shape 3: the same keys in the same band as shape 1, and the instruction pays for
     the room by saying its piece once and then getting out of the way. */
  :global(html[data-deck='3']) & {
    .demo-transport[data-phase='intro'] {
      .demo-caption {
        display: none;
      }

      .demo-hint {
        display: block;
        padding-inline-start: 0;
        border-inline-start: 0;
        color: var(--ink);
      }
    }

    .demo-transport[data-phase='settled'] .demo-hint {
      display: none;
    }
  }

  /* Shape 4: a dimension line, run along the bottom edge of the drawing from the left
     margin to the title block, lettered above the way a dimension is. The arrowhead is
     where the walkthrough has got to and the control that stops it; the circled zero at
     the other end sends it back to the start. */
  :global(html[data-deck='4']) & {
    .demo-transport {
      position-anchor: var(--drawing-title-anchor);
      right: calc(anchor(left) + 0.5rem);
      /* On the frame line, inside the drawing: the band is one margin deep and a
         dimension needs its lettering as well as its line. */
      bottom: var(--sheet-margin);
      height: auto;
      align-items: flex-end;
    }

    .demo-keys,
    .demo-led {
      display: none;
    }

    .demo-readout {
      @include off-the-paper;
    }

    .demo-dimension {
      display: flex;
      flex: 1;
      min-width: 0;
      position: relative;
      flex-direction: column;
      gap: 0.25em;
      font-size: 0.625rem;
      pointer-events: none;
    }
  }

  .dim-lettering {
    margin-inline-start: 1.6em;
    overflow: hidden;
    letter-spacing: 0.1em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dim-stop,
  .dim-hint {
    color: var(--ink-muted);
  }

  /* Where the line itself runs: from the circled zero to the title block. */
  .dim-run {
    position: relative;
    margin-inline-start: 1.6em;
  }

  /* The line, its two extension ticks, and one tick per step of the walkthrough once a
     demo has said how many it has. A demo that loops without numbered steps reports
     none, and then the line is drawn plain. */
  .dim-line {
    display: block;
    height: 0.5em;
    border-bottom: 1px solid var(--line-strong);
    border-inline: 1px solid var(--line-strong);
  }

  .demo-transport[data-progress='counted'] .dim-line {
    background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size: calc(100% / var(--deck-steps, 1)) 0.3em;
    background-position: left bottom;
    background-repeat: repeat-x;
  }

  .dim-arrow,
  .dim-zero {
    position: absolute;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    pointer-events: auto;

    &:focus-visible {
      outline: 1px solid var(--accent);
      outline-offset: 0.125em;
    }

    &:disabled {
      cursor: default;
      opacity: 0.5;
    }
  }

  .dim-arrow {
    left: calc(var(--deck-progress, 0) * 100%);
    bottom: -0.125em;
    translate: -50% 0;
    transition: left 320ms ease;

    svg {
      display: block;
      height: 0.75em;
      width: auto;
      fill: currentColor;
    }

    &:hover svg,
    &:focus-visible svg {
      fill: var(--accent);
    }
  }

  .dim-zero {
    left: 0;
    bottom: -0.2em;
    line-height: 1;
  }

  .dim-zero-mark {
    display: grid;
    place-items: center;
    width: 1em;
    height: 1em;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: 0.875em;
  }

  .dim-zero:hover .dim-zero-mark,
  .dim-zero:focus-visible .dim-zero-mark {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Shape 5: a stamp pressed into the bottom right of the drawing, which is the corner
     above the title block and left of it: the note card takes the column to its right on
     a wide sheet. A pencil note beside the stamp sends the walkthrough back to the start;
     the stamp itself takes it over. */
  :global(html[data-deck='5']) & {
    .demo-transport {
      position-anchor: var(--drawing-title-anchor);
      left: auto;
      right: calc(anchor(left) + 0.5rem);
      bottom: calc(anchor(top) + 0.75rem);
      height: auto;
      width: max-content;
      max-width: 60%;
    }

    .demo-keys,
    .demo-led {
      display: none;
    }

    .demo-readout {
      @include off-the-paper;
    }

    .demo-stamp {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.3rem;
    }
  }

  /* The ink is the theme's accent at the weight it is readable on paper, and the same
     bled edge WipStamp.astro gives its own impression. */
  .stamp-mark {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-text);
    cursor: pointer;
    pointer-events: auto;
    rotate: -5deg;
    transition: rotate 120ms ease;

    &:hover,
    &:focus-visible {
      rotate: -3deg;
    }

    &:focus-visible {
      outline: 1px solid var(--accent);
      outline-offset: 0.25em;
    }

    &:disabled {
      cursor: default;
      opacity: 0.55;
    }
  }

  .stamp-ring {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.3rem 0.7rem 0.35rem;
    border: 0.14rem solid currentColor;
    border-radius: 0.25rem;
    outline: 0.06rem solid color-mix(in oklab, currentColor 55%, transparent);
    outline-offset: 0.18rem;
    /* A thin wash of paper under the impression: the drawing it is pressed onto can be a
       photograph of grass, and an ink-only stamp disappears into one. */
    background: color-mix(in oklab, var(--surface-page) 62%, transparent);
    mask-image: radial-gradient(ellipse 95% 90% at 50% 48%, #000 72%, transparent 100%);
  }

  .stamp-line {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-indent: 0.16em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .stamp-sub {
    font-size: 0.5rem;
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    text-transform: uppercase;
  }

  /* Written next to the stamp in pencil, underlined the way the sheet underlines a
     callout's own lettering. */
  .stamp-replay {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-muted);
    cursor: pointer;
    pointer-events: auto;
    font-size: 0.5625rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;

    svg {
      display: block;
      height: 1.1em;
      width: auto;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.3;
    }

    .replay-head {
      fill: currentColor;
      stroke: none;
    }

    &:hover,
    &:focus-visible {
      color: var(--accent);
    }

    &:disabled {
      cursor: default;
      opacity: 0.55;
    }
  }

  /* Shape 6: the sheet's own callout. A leader runs into the drawing, the note is
     written on its shelf, and taking over strikes that line out in pencil and writes the
     next one under it. It sits in the same corner of the drawing as the stamp. */
  :global(html[data-deck='6']) & {
    .demo-transport {
      position-anchor: var(--drawing-title-anchor);
      left: auto;
      right: calc(anchor(left) + 0.5rem);
      bottom: calc(anchor(top) + 0.75rem);
      height: auto;
      width: max-content;
      max-width: 60%;
    }

    .demo-keys,
    .demo-led {
      display: none;
    }

    .demo-readout {
      @include off-the-paper;
    }

    .demo-margin-note {
      display: flex;
      position: relative;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2em;
      padding-bottom: 0.25em;
      border-bottom: 1px solid var(--ink);
      font-size: 0.625rem;
      color: var(--ink);
    }
  }

  .note-leader {
    position: absolute;
    right: 100%;
    bottom: -1px;
    width: 2.75em;
    height: 2.2em;
    overflow: visible;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;

    .note-leader-head {
      fill: var(--ink);
      stroke: none;
    }
  }

  /* Struck through by a pencil drawn across it, not by an underline the font supplies:
     the line has to arrive when the visitor takes over, and stay off the second line. */
  .note-first {
    position: relative;

    &::after {
      content: '';
      position: absolute;
      left: -0.1em;
      right: -0.1em;
      top: 55%;
      height: 1px;
      background: var(--ink-muted);
      scale: 0 1;
      transform-origin: left center;
    }
  }

  .note-second {
    display: none;
  }

  .demo-transport[data-state='user'] {
    .note-first {
      color: var(--ink-muted);

      &::after {
        scale: 1 1;
        transition: scale 240ms ease;
      }
    }

    .note-second {
      display: block;
    }
  }

  .note-slash {
    color: var(--ink-faint);
  }

  .note-link {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    pointer-events: auto;
    text-decoration: underline;
    text-underline-offset: 0.25em;

    &:hover,
    &:focus-visible {
      color: var(--accent);
    }

    &:disabled {
      cursor: default;
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-led { animation: none; }
    .dim-arrow { transition: none; }
    .stamp-mark { transition: none; }

    .demo-transport[data-state='user'] .note-first::after { transition: none; }
  }

  .aside {
    max-height: 100%;
    max-width: 100%;
    min-width: 0;
    grid-column: 3;
    margin-inline: auto;
  }

  /* Wherever the note is shown in place, the dialog and its chrome are inert
     scaffolding: they add no boxes of their own. */
  .drawing-note:not(:modal),
  .note-card,
  .drawing-note form {
    display: contents;
  }

  .note-dismiss,
  .note-fold {
    display: none;
  }

  /* Opened from the dog-ear. The dialog is in the top layer, so it is pinned
     back onto its own sheet — the note belongs to the drawing, not to the
     document around it — covering the whole sheet, title block included.
     Anchoring only resolves for a box whose containing block is the viewport,
     which is why the dialog itself carries it. */
  .drawing-note:modal {
    position: fixed;
    position-anchor: var(--drawing-sheet-anchor);
    inset: anchor(top) anchor(right) anchor(bottom) anchor(left);
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: calc(var(--sheet-margin) + 1.25em) 1.25em;
    border: 0;
    border-radius: 0.5em;
    background: rgba(0, 0, 0, 0.45);
    color: inherit;
    overflow: clip;

    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;

    &::backdrop {
      background: none;
    }

    .note-dismiss {
      display: block;
      position: fixed;
      inset: 0;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    .note-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6em;

      position: relative;
      max-height: 100%;
      max-width: 100%;
      overflow: auto;

      /* The note is the whole point once opened — let it use the sheet. */
      --note-width: min(34ch, 100%);
      --note-font-size: 1rem;

      transition: opacity 160ms ease, translate 160ms ease;

      @starting-style {
        opacity: 0;
        translate: 0 0.75em;
      }
    }
  }

  /* Nothing under the note should keep moving while it is being read. */
  &:has(.drawing-note:modal) {
    .content,
    .content :global(*) {
      animation-play-state: paused;
    }
  }

  /* The note's own corner peeking out from under the sheet, in the sheet's
     bottom-left: it wears the note's paper hue — softened into the same
     pastel range for every note, so a saturated postit does not shout from
     the corner — and follows the page's rounded corner (the radius clips
     the background before the triangle clip-path applies). */
  .note-fold {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 3;

    width: var(--note-fold-size);
    height: var(--note-fold-size);
    padding: 0;
    border: 0;
    font: inherit;
    color: oklch(from var(--note-background, #e8e4dc) 0.28 min(c, 0.06) h);
    cursor: pointer;

    clip-path: polygon(0 0, 100% 100%, 0 100%);
    background: oklch(from var(--note-background, #e8e4dc) clamp(0.78, l, 0.92) min(c, 0.09) h);
    border-end-start-radius: 0.5em;
    /* clip-path also clips box-shadow, so the lift has to be a filter. */
    filter: drop-shadow(0.1em -0.1em 0.3em rgba(0, 0, 0, 0.45));
    transform-origin: bottom left;
    transition: scale 120ms ease;

    &:hover,
    &:focus-visible {
      scale: 1.06;
    }

    &:focus-visible {
      outline: none;
      filter: drop-shadow(0 0 0.2em var(--accent)) drop-shadow(0.1em -0.1em 0.3em rgba(0, 0, 0, 0.45));
    }
  }

  .note-fold-label {
    position: absolute;
    left: 33%;
    top: 66%;
    translate: -50% -50%;
    rotate: 45deg;
    font-size: 0.55em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Nothing in the aside slot for this page — no corner to fold. */
  .aside:not(:has(.note-card > *)) .note-fold {
    display: none;
  }

  /* No note at all: the note's column is the artwork's to use. */
  &:not(:has(.note-card > *)) {
    .content {
      grid-column: 1 / -1;
    }

    .aside {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawing-note:modal .note-card { transition: none; }
  }

  .layers {
    grid-column: 3;
    justify-self: center;

    display: grid;
    grid-template-columns: auto auto;

    ol {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / 3;

      a {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / 3;

        li {
          display: grid;
          grid-template-columns: subgrid;
          grid-column: 1 / 3;

          span {
            border: $border;
            margin-right: -1px;
            margin-bottom: -1px;

            $padding-inline: 0.25em;
            $padding-block: 0.375em;
            padding: $padding-inline $padding-block;
          }
        }
      }

    }
  }

  & > table {
    $title-tech-size: 4em;
    $title-tech-icon-size: 2.25em;

    position: absolute;
    right: var(--sheet-margin);
    bottom: var(--sheet-margin);

    border-collapse: collapse;
    border-spacing: 0;

    td {
      border: $border;
      padding: 0.25em;
      color: var(--ink);

      /* The symbol alone, a quarter under the size it draws itself at, and no
         visible label: at that width the cell fits beside the artwork on a 60em
         sheet, where the labelled cell ran 7px into the prose of two pages. */
      &.title-proj :global(svg) {
        width: 1.5em;
        height: 0.75em;
      }

      // display must stay table-cell — grid/flex on the td breaks rowspan.
      &.title-tech {
        padding: 0.25em;
        vertical-align: middle;

        .title-tech-stack {
          position: relative;
          box-sizing: border-box;
          width: $title-tech-size;
          height: $title-tech-size;
          aspect-ratio: 1;
          overflow: hidden;

          :global(.tech-icon) {
            position: absolute;

            :global(svg) {
              display: block;
              width: $title-tech-icon-size;
              height: $title-tech-icon-size;
              margin: 0;
            }

            &:first-child {
              top: 0.2em;
              left: 0.2em;
            }

            &:nth-child(2) {
              right: 0.2em;
              bottom: 0.2em;
            }
          }

          &[data-count='1'] :global(.tech-icon) {
            inset: 0;
            margin: auto;
            width: fit-content;
            height: fit-content;
          }
        }
      }

      header {
        display: inline-block;
        rotate: calc(var(--random1) * 0.75deg);
        translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px);

        h3 {
          color: var(--ink-muted);
          font-size: 0.675em;
          margin-top: 0.25rem;
        }
      }

      & > div {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.25rem;

        .title-label {
          font-size: 0.625rem;
        }

        span {
          rotate: calc(var(--random1) * 1.5deg);
          /* translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px); */
        }

        span, svg {
          margin-inline: auto;
        }
      }
    }
  }

  /* The block gives up its parts, in this order, as the room at the sheet's
     bottom-right runs out. Each step includes the ones before it. */
  /* Drop the Proj. cell. Its symbol lives in that corner cell or nowhere: a mark
     beside the title reads as part of the title, and the corner is what the fold
     covers anyway. */
  @mixin drop-proj {
    .title-proj { display: none; }
  }

  @mixin title-fit-1 {
    & > table { @include drop-proj; }
  }

  @mixin title-fit-2 {
    @include title-fit-1;
    & > table .title-scale { display: none; }
  }

  @mixin title-fit-3 {
    @include title-fit-2;
    & > table .title-weight { display: none; }
  }

  @mixin title-fit-4 {
    @include title-fit-3;

    /* The cells stop being a table so the logo cell can drop under the title
       instead of standing a column beside it. Each cell keeps its hairline, and
       the negative margins do what border-collapse did. */
    & > table {
      display: flex;
      flex-wrap: wrap;

      tbody,
      tr { display: contents; }

      td {
        display: block;
        margin: 0 -1px -1px 0;
      }

      .title-name {
        order: -1;
        flex: 1 0 100%;
      }

      .title-tech .title-tech-stack {
        width: 2.625em;
        height: 2em;
        aspect-ratio: auto;

        :global(.tech-icon svg) {
          width: 1.25em;
          height: 1.25em;
        }
      }

      .title-no,
      .title-date { order: 1; }
    }
  }

  @mixin title-fit-5 {
    @include title-fit-4;
    /* Narrow enough that the title has to take a second line. 11rem is what clears
       the artwork cell on a 60em sheet, which is as wide as a sheet gets. */
    & > table { max-width: 11rem; }
  }

  /* Pick the step from the sheet's own width. The lower bound keeps the ladder out
     of the portrait layout below, which gives the block its own row and has no
     room problem to solve. The symbol's cell, symbol only and 1.5em wide, fits
     beside the artwork on every sheet down to the width where Scale goes too:
     measured clear of the prose on every page at 960, 1024 and 1440. */
  @container technical-drawing-width (40em < width <= 50em) { @include title-fit-1; }
  @container technical-drawing-width (40em < width <= 50em) { @include title-fit-2; }
  @container technical-drawing-width (40em < width <= 46em) { @include title-fit-3; }
  @container technical-drawing-width (40em < width <= 43em) { @include title-fit-4; }
  @container technical-drawing-width (40em < width <= 41em) { @include title-fit-5; }

  /* A sheet this narrow cannot host the note beside the artwork — landscape
     included, where the sheet is half as tall as it is wide and the note runs
     over the title block. Tuck it under the dog-eared corner instead; 56em is
     the same threshold EditorLayer uses to hand the gutters to the chrome. */
  @container technical-drawing-width (max-width: 56em) {
    .aside {
      /* Only the dog-ear lives here; the note itself is in the dialog, and the
         fold positions itself against the sheet, so the wrapper adds no box. */
      display: contents;
      font-size: 1rem;
    }

    .drawing-note:not(:modal) {
      display: none;
    }

    .note-fold {
      display: block;
    }

    /* The corner is only folded out on a sheet this narrow, and at the sheet's
       bottom edge it covers the whole band. A deck drawn in the band starts past
       its diagonal here, and keeps the same clearance from it as from the ends. */
    .demo-transport {
      left: calc(var(--note-fold-size) + var(--sheet-margin));
    }

    /* The tab lies on the artwork, the way a note tucked under a sheet would.
       What it must not do is cover a control or hide behind one, so it paints
       over the cell (see .content's isolation) and every demo keeps its own
       controls off this much of the bottom-left corner. */
    --note-fold-reach: calc(var(--note-fold-size) - var(--sheet-margin));

    /* The artwork keeps the sheet centre, so the corner block gives ground —
       same size portrait uses — and wears the sheet like a real title block,
       so a diagram running underneath is clipped by it instead of mixing
       with its text. */
    & > table {
      font-size: 0.7em;
      background: var(--surface-sunken);

      td {
        padding: 0.2em;
      }
    }
  }

  @container technical-drawing (orientation: portrait) {
    /* A phone sheet cannot spare a 1rem mat on all four edges. */
    --sheet-margin: 0.625rem;

    grid-template-columns: minmax(0, 1fr);
    /* Artwork, then the deck, then the title block. The note is tucked under the
       dog-eared corner instead of taking a row of its own. */
    grid-template-rows: minmax(0, 1fr) auto auto;
    align-items: stretch;

    /* The dog-eared corner reaches 56px up the sheet, which is the whole band and most
       of the title block, so a deck drawn in the band starts against its diagonal. On a
       phone the deck takes a full-width row of its own inside the frame instead, above
       the title block, where the corner cannot reach it. A phone sheet has no room for
       the instruction beside the state, so the row is the keys, the lamp and the state. */
    .demo-transport {
      position: static;
      grid-column: 1;
      grid-row: 2;
      height: auto;
      justify-content: flex-start;
      gap: 0.5em;
      padding: 0.25rem 0.375rem;
      /* Ruled off from the title block by clear paper, not a shared line. */
      margin-bottom: 0.375rem;
      font-size: 0.625rem;
    }

    .demo-key svg {
      height: 1.125rem;
    }

    .demo-hint {
      display: none;
    }

    /* Shape 2's cell sits on the title block's top rule here, the way it does on its
       side on a wider sheet. */
    :global(html[data-deck='2']) & .demo-transport {
      margin-bottom: -1px;
      border: 1px solid var(--line-strong);
      border-bottom: 0;
    }

    /* Left, so the readout keeps clear of the page-turn corner, and on one line. */
    :global(html[data-deck='2']) & .demo-readout {
      flex-direction: row;
      align-items: baseline;
      margin-inline-start: 0;
    }

    /* Shape 4's dimension line takes the row too, full width above the title block,
       rather than the strip of drawing a wider sheet gives it. */
    :global(html[data-deck='4']) & .demo-transport {
      position: static;
      align-items: stretch;
    }

    /* Shapes 5 and 6 are marks on the drawing itself, so they keep their corner of it
       and leave the row empty. Taking the grid placement back matters: a positioned grid
       item is laid out inside its own grid area, and the title block it anchors to is a
       row further down. The block runs the full width here, so its left edge is no corner
       of the drawing; the right one is, and the note is folded away under the opposite
       corner rather than taking a column of its own. */
    :global(html[data-deck='5']) & .demo-transport,
    :global(html[data-deck='6']) & .demo-transport {
      position: absolute;
      grid-column: auto;
      grid-row: auto;
      right: anchor(right);
      padding: 0;
      margin-bottom: 0;
    }

    .content {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      max-width: 100%;
      justify-self: stretch;
      align-self: center;
    }

    .layers {
      grid-column: 1;
      grid-row: 3;
    }

    & > table {
      position: static;
      grid-column: 1;
      grid-row: 3;
      width: 100%;
      font-size: 0.7em;

      td {
        padding: 0.2em;
      }

      // Purely decorative on a phone sheet: drop the cell rather than squeeze
      // the rest of the title block to make room for it.
      @include drop-proj;

      // No longer has to stay square once the sheet can't spare the width —
      // a shorter, wider strip still reads fine at this size.
      .title-tech-stack {
        width: 2.6em;
        height: 2em;
        aspect-ratio: auto;

        :global(.tech-icon svg) {
          width: 1.3em;
          height: 1.3em;
        }
      }

      td header {
        /* Caps the cell's min-content too, so a long title cannot widen the
           block past the sheet. */
        max-width: 58cqw;

        h2,
        h3 {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        h2 {
          font-size: 0.875rem;
        }

        h3 {
          font-size: 0.625rem;
        }
      }
    }
  }

  @for $i from 1 through 20 {
    @for $j from 1 through 20 {
      &:nth-child(#{$i}) td:nth-child(#{$j}) {
        --random1: #{math.random() * 2 - 1};
        --random2: #{math.random() * 2 - 1};
        --random3: #{math.random() * 2 - 1};
      }
    }
  }
}
</style>
