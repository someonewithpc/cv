---
import { Icon } from 'astro-icon/components';

import TechIcon from '@/components/TechIcon.astro';

import { resolveTechs } from '@/server/tech-icons';

type Props = {
  title?: string | null;
  subtitle?: string;
  scale?: string;
  size?: string;
  date?: string;
  index?: number;
  layerCount?: number;
  pageStyle?: string;
  /** Tech name(s) or icon suffix(es) in a square rowspan cell. */
  tech?: string | readonly string[];
};

const {
  title,
  subtitle,
  scale,
  size,
  date,
  index,
  layerCount,
  pageStyle,
  tech,
} = Astro.props;

const techs = resolveTechs(tech);
---

<section class={pageStyle}>
  <div class="content">
    <slot name="content" />
  </div>

  <div class="aside">
    <slot name="aside" />
  </div>

  <table aria-label={`${title ?? subtitle ?? 'Drawing'} title block`}>
    <tbody>
      <tr>
        {techs.length > 0 && (
          <td rowspan="2" class="title-tech" aria-hidden="true">
            <div class="title-tech-stack" data-count={techs.length}>
              {techs.map((entry) => (
                <TechIcon tech={entry} decorative />
              ))}
            </div>
          </td>
        )}
        <td colspan="5">
          <header>
            <h2 class="typewriter">{title ?? subtitle}</h2>
            {title && subtitle && (<h3 class="typewriter">{subtitle}</h3>)}
          </header>
        </td>
      </tr>
      <tr>
        <td>
          <div>
            <h3 class="monospace">Drawing No.</h3>
            <span class="typewriter">{index} / {layerCount}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Scale</h3>
            <span class="typewriter">{scale ?? '3:1'}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Weight</h3>
            <span class="typewriter">{size ?? '-'}</span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">Date</h3>
            <span class="typewriter"><time datetime={date}>{date ?? '-'}</time></span>
          </div>
        </td>

        <td>
          <div>
            <h3 class="monospace">
              <span aria-hidden="true">Proj.</span>
              <span class="sr-only">Projection</span>
            </h3>
            <Icon name="first-angle-projection" aria-hidden="true" />
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</section>

<style lang="scss">
@use 'sass:math';

@use "@/scss/_colors.scss" as colors;

section {
  $border: 1px solid var(--line-strong);
  $border-offset: 1em;

  contain: size style;

  width: 100%;
  height: 100%;
  border: $border-offset solid var(--surface-sunken);
  outline: $border;
  outline-offset: -$border-offset;

  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  position: relative;

  background: var(--surface-sunken);
  &:global(.blueprint) {
    @include colors.blueprint-sheet-boundary;

    // Thick margin must match the sheet fill; the outline is the visible border.
    border-color: var(--blueprint);
    background-color: var(--blueprint);
    background-size: 1cm 1cm;
    background-image:
      linear-gradient(to right, var(--blueprint-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--blueprint-grid) 1px, var(--blueprint) 1px);
  }

  // Unfinished carousel pages — mute the mat + artwork so the WIP stamp reads clearly.
  &:global(.wip) {
    --blueprint: color-mix(in oklch, var(--theme-blueprint) 36%, #6a6e6a 64%);
    --blueprint-grid: color-mix(in oklch, var(--blueprint), #c5c8c5 34%);
    border-color: var(--blueprint);
    background-color: var(--blueprint);
    background-image:
      linear-gradient(to right, var(--blueprint-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--blueprint-grid) 1px, var(--blueprint) 1px);

    .content > :global(:not(.wip-stamp)) {
      filter: grayscale(0.72) brightness(0.88) contrast(0.94);
      opacity: 0.78;
    }

    .aside {
      filter: grayscale(0.4) brightness(0.95);
      opacity: 0.88;
    }

    table {
      filter: grayscale(0.3) brightness(0.96);
      opacity: 0.92;
    }
  }

  .content {
    grid-column: 1 / 3;
    place-self: center;
    position: relative;
    width: fit-content;
    max-width: 100%;
    height: fit-content;
    max-height: 100%;
    // Clip — overflow:auto + fit-content thrashes scrollbars at the fit boundary
    // and scrollbar-gutter:stable leaves permanent tracks on every blueprint page.
    overflow: clip;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .aside {
    max-height: 100%;
    grid-column: 3;
    margin-inline: auto;
  }

  .layers {
    grid-column: 3;
    justify-self: center;

    display: grid;
    grid-template-columns: auto auto;

    ol {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / 3;

      a {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / 3;

        li {
          display: grid;
          grid-template-columns: subgrid;
          grid-column: 1 / 3;

          span {
            border: $border;
            margin-right: -1px;
            margin-bottom: -1px;

            $padding-inline: 0.25em;
            $padding-block: 0.375em;
            padding: $padding-inline $padding-block;
          }
        }
      }

    }
  }

  & > table {
    $title-tech-size: 4em;
    $title-tech-icon-size: 2.25em;

    position: absolute;
    right: -1px;
    bottom: -1px;

    border-collapse: collapse;
    border-spacing: 0;

    td {
      border: $border;
      padding: 0.25em;
      color: var(--ink);

      // display must stay table-cell — grid/flex on the td breaks rowspan.
      &.title-tech {
        padding: 0.25em;
        vertical-align: middle;

        .title-tech-stack {
          position: relative;
          box-sizing: border-box;
          width: $title-tech-size;
          height: $title-tech-size;
          aspect-ratio: 1;
          overflow: hidden;

          :global(.tech-icon) {
            position: absolute;

            :global(svg) {
              display: block;
              width: $title-tech-icon-size;
              height: $title-tech-icon-size;
              margin: 0;
            }

            &:first-child {
              top: 0.2em;
              left: 0.2em;
            }

            &:nth-child(2) {
              right: 0.2em;
              bottom: 0.2em;
            }
          }

          &[data-count='1'] :global(.tech-icon) {
            inset: 0;
            margin: auto;
            width: fit-content;
            height: fit-content;
          }
        }
      }

      header {
        display: inline-block;
        rotate: calc(var(--random1) * 0.75deg);
        translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px);

        h3 {
          color: var(--ink-muted);
          font-size: 0.675em;
          margin-top: 0.25rem;
        }
      }

      & > div {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.25rem;

        h3 {
          font-size: 0.625rem;
        }

        span {
          rotate: calc(var(--random1) * 1.5deg);
          /* translate: calc(var(--random2) * 2px) calc(var(--random2) * 2px); */
        }

        span, svg {
          margin-inline: auto;
        }
      }
    }
  }

  @container technical-drawing (orientation: portrait) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1.75fr) minmax(0, 1fr);
    align-items: stretch;

    .content {
      font-size: min(1rem, 3.25cqw);

      grid-column: 1;
      grid-row: 1;
    }

    .aside {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
      align-self: end;
      width: max-content;
      max-width: calc(100% - 1em);
      height: auto;
      max-height: none;
      margin-block: 0.5em 5.5em;
      overflow: visible;
      z-index: 1;
    }

    .layers {
      grid-column: 1;
      grid-row: 2;
    }

    & > table {
      font-size: 0.75em;
    }
  }

  @for $i from 1 through 20 {
    @for $j from 1 through 20 {
      &:nth-child(#{$i}) td:nth-child(#{$j}) {
        --random1: #{math.random() * 2 - 1};
        --random2: #{math.random() * 2 - 1};
        --random3: #{math.random() * 2 - 1};
      }
    }
  }
}
</style>
