---
/**
 * The wipe's script, five steps in the order the picker runs them, each with the lines it
 * runs, and under the frames what transformPath does with a path. Every fragment is
 * checked against its source at build, whitespace aside, so the sheet cannot drift from the
 * code. Shiki colours the fragments at build with github-dark, the theme the loading logo's
 * path data sheet was coloured with, so nothing ships to colour them at runtime. Beside the
 * steps, the geometry of the last frame: the viewport with the icon's box in its corner, and the icon grown to the end frame, drawn to the theme on
 * screen's own factor and cut at the drawing's edge.
 */
import fs from 'node:fs/promises';
import path from 'node:path';

import { Icon } from 'astro-icon/components';
import { Code } from 'astro:components';

import { THEME_IDS, THEMES } from '@/themes';

import { shownCss } from '../shown';
import { tonesCss } from '../tones';

type Fragment = { code: string[]; from: 'picker' | 'utils'; check?: string };

const steps: { name: string; fragment: Fragment }[] = [
  {
    name: 'Start the transition with `startViewTransition`, the switch as its callback',
    /* The callback is stood in for: the check covers the call. */
    fragment: {
      code: ['const viewTransition = document.startViewTransition(() => { /**/ });'],
      from: 'picker',
      check: 'const viewTransition = document.startViewTransition(',
    },
  },
  {
    name: 'Once `ready`, measure the icon into `rect` and read its path',
    fragment: {
      code: [
        'viewTransition.ready.then(async () => {',
        '  const rect = svg.getBoundingClientRect();',
        '  const pathData = path.getPathData({ normalize: true });',
      ],
      from: 'picker',
    },
  },
  {
    name: 'For the first frame, map the path from its `viewBox` onto the icon\'s box',
    fragment: {
      code: [
        '  const startPathData = transformPath(pathData, viewBox,',
        '    { x: rect.x, y: rect.y, width: rect.width, height: rect.height });',
      ],
      from: 'picker',
    },
  },
  {
    name: 'For the last frame, map it onto a square `2 × size` wide, centred on `cx`, `cy`',
    fragment: {
      code: [
        '  const size = Math.hypot(window.innerWidth, window.innerHeight)',
        '    * scaleFactor;',
        '  const cx = rect.x + rect.width / 2;',
        '  const cy = rect.y + rect.height / 2;',
        '  const endPathData = transformPath(pathData, viewBox,',
        '    { x: cx - size, y: cy - size, width: size * 2, height: size * 2 });',
      ],
      from: 'picker',
    },
  },
  {
    name: 'Clip the new page to the first frame with `clip-path: path()` and grow it to the last',
    fragment: {
      code: [
        '  document.documentElement.animate(',
        '    [{ clipPath: `path("${pathDataToString(startPathData)}")` },',
        '     { clipPath: `path("${pathDataToString(endPathData)}")` }],',
        '    { duration: 500, easing: \'ease-in\',',
        '      pseudoElement: \'::view-transition-new(theme-transition)\' });',
      ],
      from: 'picker',
    },
  },
];

/* Inside transformPath (src/client/svg-utils.ts): one line each, with what it does. */
const inside: { fragment: Fragment; note: string }[] = [
  {
    fragment: {
      code: ['const mapWidthAbsolute = (x: number) => ((x - fromViewBox.x) / fromViewBox.width) * toViewBox.width + toViewBox.x;'],
      from: 'utils',
    },
    note: 'Scales `x` from the `viewBox` width to the box\'s width and adds the box\'s left. `y` likewise.',
  },
  {
    fragment: { code: ['return [mapWidthAbsolute(width), mapHeightAbsolute(height)];'], from: 'utils' },
    note: 'Each command\'s values go through in `x`, `y` pairs.',
  },
  {
    fragment: { code: ['values: (transformers[type] ?? thrower(type))(values),'], from: 'utils' },
    note: 'Keeps each command\'s letter and maps its values into viewport pixels, the unit `clip-path: path()` takes.',
  },
];

/* Prose with code words in backticks, set as inline code. */
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const ticks = (text: string) => escape(text).replace(/`([^`]+)`/g, '<code>$1</code>');

/* The fragments must be their source's own lines: compare with whitespace dropped and a
   comma before a bracket or at the end taken off, line by line, and fail the build on the
   first that is not in it. */
const norm = (text: string) => text.replace(/,\s*$/, '').replace(/,\s*([}\])])/g, '$1').replace(/\s*([()[\]{}])\s*/g, '$1').replace(/\s+/g, ' ').trim();
const read = async (file: string) => norm(await fs.readFile(path.join(process.cwd(), file), 'utf8'));
const sources = { picker: await read('src/components/ThemePicker.astro'), utils: await read('src/client/svg-utils.ts') };
for (const { code, from, check } of [...steps.map((step) => step.fragment), ...inside.map((row) => row.fragment)]) {
  for (const line of check ? [check] : code) {
    if (!sources[from].includes(norm(line))) throw new Error(`CodeLayer: not in the ${from} source: ${line}`);
  }
}

/* The drawing, in a 150 by 100 box: the viewport fills it, 16:10, with room above for the
   dimension and beside the corner for the icon's label. The end frame is the icon grown to
   its true size for each theme, centred on the icon's box and cut at the drawing's edge, so
   the dimension line runs off the drawing and carries a break. Labels are HTML, placed in
   per cent of the box. */
const box = { width: 150, height: 100 };
const viewport = { x: 6, y: 26, width: 102.4, height: 64 };
const right = viewport.x + viewport.width;
const bottom = viewport.y + viewport.height;
const icon = { size: 8, inset: 2 };
const cx = right - icon.inset - icon.size / 2;
const cy = viewport.y + icon.inset + icon.size / 2;
const dimY = 14;
const diagonal = Math.hypot(viewport.width, viewport.height);
const pct = (x: number, y: number) => `--x: ${(x / box.width) * 100}%; --y: ${(y / box.height) * 100}%`;
const frames = THEME_IDS.map((id) => {
  const factor = THEMES[id].transitionScaleFactor;
  return { id, factor, span: (2 * diagonal * factor) / box.width };
});
---

<div class="code-sheet">
  <header>
    <strong>The wipe's script in five steps, and the geometry of its last frame</strong>
  </header>

  <ol class="steps" aria-label="The wipe's script">
    {steps.map(({ name, fragment }, index) => (
      <li>
        <span class="step-name"><span class="balloon">{index + 1}</span><span set:html={ticks(name)} /></span>
        <Code code={fragment.code.join('\n')} lang="ts" theme="github-dark" wrap={null} />
        {index === 3 && (
          <div class="inside">
            <span class="inside-name">Inside <code>transformPath</code>, for both frames</span>
            {inside.map((row) => (
              <div class="row">
                <Code code={row.fragment.code.join('\n')} lang="ts" theme="github-dark" wrap={null} />
                <span class="note" set:html={ticks(row.note)} />
              </div>
            ))}
          </div>
        )}
      </li>
    ))}
  </ol>

  <div class="figure">
    <div class="drawing" aria-hidden="true">
      {frames.map(({ id, span }) => (
        <span class="end-icon" data-shown={id} style={`${pct(cx, cy)}; --span: ${span}`}>
          <Icon name={THEMES[id].icons.checked} />
        </span>
      ))}

      <svg class="geometry" viewBox={`0 0 ${box.width} ${box.height}`}>
        <rect class="viewport" x={viewport.x} y={viewport.y} width={viewport.width} height={viewport.height} />
        <line class="diagonal" x1={viewport.x} y1={bottom} x2={right} y2={viewport.y} />
        <line class="extension" x1={cx} y1={cy - icon.size / 2 - 1} x2={cx} y2={dimY - 2} />
        <line class="dim" x1="0" y1={dimY} x2={cx} y2={dimY} />
        <line class="tick" x1={cx} y1={dimY - 1.5} x2={cx} y2={dimY + 1.5} />
        <polyline class="break" points={`${viewport.x + 6},${dimY - 3} ${viewport.x + 4},${dimY + 3} ${viewport.x + 2},${dimY - 3}`} />
        <rect class="icon-box" x={cx - icon.size / 2} y={cy - icon.size / 2} width={icon.size} height={icon.size} />
        <circle class="centre" cx={cx} cy={cy} r="0.6" />
      </svg>

      <span class="corner-icon" style={pct(cx, cy)}>
        {THEME_IDS.map((id) => <Icon name={THEMES[id].icons.checked} data-shown={id} />)}
      </span>

      {frames.map(({ id, factor }) => (
        <span class="label" data-shown={id} style={`${pct(cx / 2, dimY - 1.5)}; --dx: -50%; --dy: -100%`}><code>size = diagonal × {factor}</code></span>
      ))}
      <span class="label" style={`${pct(cx + icon.size / 2 + 2, cy)}; --dx: 0; --dy: -50%`}><code>rect</code>, <code>cx</code>, <code>cy</code></span>
      <span class="label" style={`${pct(viewport.x + viewport.width / 2 + 3, viewport.y + viewport.height / 2 + 3)}; --dx: 0; --dy: 0`}><code>diagonal</code></span>
      <span class="label" style={`${pct(viewport.x, bottom + 1)}; --dx: 0; --dy: 0`}>viewport</span>
    </div>
  </div>
</div>

<style is:global set:html={shownCss('.code-sheet') + tonesCss('.code-sheet')} />

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".code-sheet");

/* The steps take the wider left column and the sheet's full height; the drawing on the
   right stops above the title block. The right column is never narrower than the block, so
   the block reaches into that column only. */
.code-sheet {
  @include sheet-content;
  @include sheet-type(0.025, 0.032);
  @include sheet-frame;
  @include sheet-frame-side;
  grid-template-columns: minmax(0, 13fr) minmax(calc(var(--title-block-inline, 0px) - #{$sheet-margin}), 7fr);

  .figure {
    grid-column: 2;
    grid-row: 2;
    padding-bottom: var(--title-block-block, 0px);
    justify-items: center;
    container-type: size;
  }

  :global([data-sheet-orientation='portrait']) & {
    .figure {
      grid-column: auto;
      grid-row: auto;
      padding-bottom: 0;
      container-type: normal;
    }
  }
}

.steps {
  display: grid;
  gap: 0.125em;
  margin: 0;
  padding: 0;
  list-style: none;
  align-content: center;

  li {
    display: grid;
    gap: 0.125em;
    padding: 0.125em 0.5em;
    border: 1px solid var(--line);
    border-radius: 0.25em;
    background: var(--sheet-paper);
  }

  .step-name {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: max(0.625rem, 0.875em);
    line-height: 1.25;
    text-wrap: pretty;
  }

  pre {
    margin: 0;
    padding: 0.125em 0.375em;
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.75em);
    line-height: 1.2;
    white-space: pre;
    overflow-x: auto;

    :global([data-sheet-orientation='portrait']) & {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }
}

/* transformPath's lines, each with its sentence, under the frames' step. */
.inside {
  display: grid;
  gap: 0.125em;
  margin-top: 0.125em;
  padding-top: 0.25em;
  border-top: 1px solid var(--line);

  .inside-name {
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.75em);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .row {
    display: grid;
    gap: 0.125em;
  }

  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .note {
    font-size: max(0.625rem, 0.875em);
    line-height: 1.25;
    text-wrap: pretty;
  }
}

.balloon {
  display: inline-grid;
  flex: none;
  place-items: center;
  width: 1.5em;
  height: 1.5em;
  border: 1px solid var(--ink);
  border-radius: 50%;
  font-family: monospace, system-ui;
  font-size: max(0.625rem, 0.875em);
  font-weight: 600;
  line-height: 1;
  color: var(--ink);
}

/* The drawing, as large as the figure's width or height allows on a landscape sheet, where
   the figure is a size container, and as wide as the column in portrait. Its border is the
   edge the end frame is cut at. */
.drawing {
  position: relative;
  width: min(100cqw, 150cqh);
  aspect-ratio: 3 / 2;
  border: 1px solid var(--line);
  overflow: hidden;

  :global([data-sheet-orientation='portrait']) & {
    width: min(100%, 30em);
  }
}

.geometry {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;

  line,
  rect,
  circle,
  polyline {
    vector-effect: non-scaling-stroke;
  }

  .viewport,
  .diagonal,
  .dim,
  .tick,
  .extension,
  .break {
    fill: none;
    stroke: var(--tone-line);
    stroke-width: 1px;
  }

  .diagonal,
  .dim {
    stroke-dasharray: 3 2;
  }

  .icon-box {
    fill: none;
    stroke: var(--tone-accent);
    stroke-width: 1px;
  }

  .centre {
    fill: var(--tone-accent);
  }
}

/* The end frame: the icon at its true size for the theme on screen, centred on the icon's
   box, under the lines. The corner icon is the same icon at its start box. */
.end-icon,
.corner-icon {
  position: absolute;
  top: var(--y);
  left: var(--x);
  translate: -50% -50%;
  display: block;
  pointer-events: none;
}

.end-icon {
  display: var(--shown-display, none);
  width: calc(var(--span) * 100%);
  aspect-ratio: 1;
  color: var(--tone-fill);
}

.corner-icon {
  width: calc(100% * 8 / 150);
  height: calc(100% * 8 / 100);
  color: var(--ink);
}

.end-icon :global(svg),
.corner-icon :global(svg) {
  display: block;
  width: 100%;
  height: 100%;
}

.corner-icon :global(svg) {
  display: var(--shown-display, none);
}

.label {
  position: absolute;
  top: var(--y);
  left: var(--x);
  translate: var(--dx) var(--dy);
  font-family: monospace, system-ui;
  font-size: max(0.5rem, 0.75em);
  line-height: 1.25;
  white-space: nowrap;
  color: var(--ink);

  &[data-shown] {
    display: var(--shown-display, none);
  }
}
</style>
