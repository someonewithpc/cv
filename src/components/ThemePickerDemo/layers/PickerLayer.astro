---
/**
 * The live sheet: a page of its own on a stage, with the picker in its corner, doing what
 * the corner does to this page. The stage is a shadow root, so its theme switches restyle
 * the stage and nothing else; its walkthrough picks every theme in turn without touching
 * the page's stamp, its stored key or the real picker.
 *
 * The page on the stage is a wireframe: a title bar, lines of text, a table, badges and a
 * card, every block painted from the stage's own tokens so a pick recolours all of it.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';
import { highlightSpans } from '@/highlight';

import { THEME_IDS, THEMES } from '@/themes';

import { iconSvg, stageCss } from '../stage';

const css = stageCss();
const layers = ['under', 'over'] as const;

/* The wireframe's blocks: line widths as shares of their column, the table's cell widths. */
const lines = [
  [100, 92, 96, 58],
  [100, 72],
];
const cells = [12, 44, 24, 20];
const rows = 3;
const badges = 6;
const swatches = ['--accent', '--accent-muted', '--blueprint', '--surface-sunken', '--ink-muted'];
---

<div class="theme-picker-demo hl" data-theme-picker-demo>
  <div class="figure">
    <Annotations seed="theme-picker-picker" reach={1.1} fontSize={0.1}>
      <div slot="content" class="stage" data-stage>
        <template shadowrootmode="open">
          <style is:inline set:html={css}></style>
          <div class="screen" data-screen>
            {layers.map((layer) => (
              <div class="paper" data-paper={layer} hidden={layer === 'over'} inert={layer === 'over'} aria-hidden={layer === 'over' ? 'true' : undefined}>
                <div class="page">
                  <div class="title">
                    <span class="bar meta"></span>
                    <span class="bar name"></span>
                    <span class="bar role"></span>
                    <span class="contact">{[6, 4, 5, 5].map((width) => <span class="bar" style={`--w: ${width}em`}></span>)}</span>
                  </div>
                  <div class="body">
                    <div class="main">
                      <span class="heading"><span class="bar code"></span><span class="bar word"></span></span>
                      <span class="text">{lines[0].map((width) => <span class="bar" style={`--w: ${width}%`}></span>)}</span>
                      <span class="table">
                        {Array.from({ length: rows + 1 }, (_, row) => (
                          <span class="row">{cells.map((width) => <span class="bar" data-head={row === 0 ? '' : undefined} style={`--w: ${width}%`}></span>)}</span>
                        ))}
                      </span>
                      <span class="heading"><span class="bar code"></span><span class="bar word short"></span></span>
                      <span class="text">{lines[1].map((width) => <span class="bar" style={`--w: ${width}%`}></span>)}</span>
                      <span class="badges">{Array.from({ length: badges }, () => <span class="badge"></span>)}</span>
                    </div>
                    <div class="card">
                      <span class="bar label"></span>
                      <span class="bar value"></span>
                      <span class="bar label"></span>
                      <span class="bar value short"></span>
                      <span class="bar label"></span>
                      <span class="swatches">{swatches.map((token) => <span class="swatch" style={`--swatch: var(${token})`}></span>)}</span>
                      <span class="bar label"></span>
                      <span class="text">{[100, 84].map((width) => <span class="bar" style={`--w: ${width}%`}></span>)}</span>
                    </div>
                  </div>
                </div>
                <div class="corner" role={layer === 'under' ? 'group' : undefined} aria-label={layer === 'under' ? 'Pick a theme for the stage' : undefined}>
                  {THEME_IDS.map((id) => {
                    const icons = (
                      <Fragment>
                        <Fragment set:html={iconSvg(THEMES[id].icons.unchecked, 'class="unchecked"')} />
                        <Fragment set:html={iconSvg(THEMES[id].icons.checked, `class="checked" data-factor="${THEMES[id].transitionScaleFactor}"`)} />
                        <span>{THEMES[id].name}</span>
                      </Fragment>
                    );
                    return layer === 'under'
                      ? <button class="pick" type="button" data-pick={id} aria-pressed="false">{icons}</button>
                      : <span class="pick" data-pick={id}>{icons}</span>;
                  })}
                </div>
              </div>
            ))}
          </div>
          <slot is:inline></slot>
        </template>
        <p class="stamp">
          <span>stage</span>
          <code class="hl"><Fragment set:html={highlightSpans('data-demo-theme=', 'html', ['<a ', '"">'])} />{THEME_IDS.map((id) => <span data-stage-shown={id} hidden set:html={highlightSpans(`"${id}"`, 'html', ['<a b=', '>'])} />)}</code>
          <span data-stage-shown="none">unset, so the OS scheme decides</span>
        </p>
      </div>

      <Fragment slot="annotations">
        <ArrowAnnotation target="[data-stage]" anchor="1 0.12" tipX={1} tipY={-0.76} angle={0} length={0.3} text="Theme picker" only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="0 0.5" tipX={-1} tipY={0} angle={180} length={0.3} text="Sample page with its own theme" lines={['Sample page', 'with its own theme']} labelSide="left" only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="0.9 0" tipX={0.9} tipY={-1} angle={90} length={0.25} text="Theme picker" labelSide="left" only="portrait" />
      </Fragment>
    </Annotations>
  </div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-theme-picker-demo]', boot);
</script>

<style lang="scss">
@use '@/scss/sheet-orientation' as *;
@use "@/scss/_code.scss" as code;
@use "./sheet" as *;

@include stretch-cell(".theme-picker-demo");

.theme-picker-demo {
  @include code.code-chip;

  @include sheet-content;
  @include sheet-type(0.026, 0.03);
  @include clear-of-title-block;
  @include sheet-frame;
}

/* The figure is the sheet's only row now the header and the readout are gone, but it still
   takes the frame's middle, growing, row: sheet-frame's other two stay empty and collapse.
   Padding makes room for the callouts either side of the stage; the stage alone sets their
   unit. The callout overlay lies over the stage and must not take the presses meant for its
   keys. Portrait has one callout, above the stage. */
.figure {
  grid-row: 2;
  padding: 0 0.5em;

  :global(svg[data-annotations]) {
    pointer-events: none;
  }

  @include portrait-sheet {
    padding: 10% 0.5em 0;
  }
}

.stage {
  width: 30em;
  max-width: 100%;
}

/* The stage's own readout: what is stamped on it, in the stamp's own words. It is slotted
   into the stage, so it takes the stage's tokens, and stays in the page for find-in-page. */
.stamp {
  display: flex;
  flex-wrap: wrap;
  gap: 0 0.5ch;
  margin: 0;
  font-family: monospace, system-ui;
  font-size: 0.75em;
  line-height: 1.5;
  color: var(--ink-muted);

  code {
    font-family: inherit;
    color: var(--ink);
  }
}
</style>
