---
/**
 * The live sheet: a page of its own on a stage, with the picker in its corner, doing what
 * the corner does to this page. The stage is a shadow root, so its theme switches restyle
 * the stage and nothing else; its walkthrough picks every theme in turn without touching
 * the page's stamp, its stored key or the real picker. The readout under it is this page's
 * own theme, marked by the picker's selectors (shown.ts), so the two are never confused.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import { THEME_IDS, THEMES } from '@/themes';

import { shownCss } from '../shown';
import { iconSvg, stageCss } from '../stage';

const css = stageCss();
const layers = ['under', 'over'] as const;
---

<div class="theme-picker-demo" data-theme-picker-demo>
  <header>
    <span class="eyebrow">ThemePicker.astro · themes.ts</span>
    <strong>A pick cuts the new page out of the old one along the icon it was picked with</strong>
  </header>

  <div class="figure">
    <Annotations reach={1.5} fontSize={0.1}>
      <div slot="content" class="stage" data-stage>
        <template shadowrootmode="open">
          <style is:inline set:html={css}></style>
          <div class="screen" data-screen>
            {layers.map((layer) => (
              <div class="paper" data-paper={layer} hidden={layer === 'over'} inert={layer === 'over'} aria-hidden={layer === 'over' ? 'true' : undefined}>
                <div class="page">
                  <p class="name">Hugo Sales</p>
                  <p class="role">A CV drawn as a set of sheets</p>
                  <div class="rule"></div>
                  <div class="line"></div>
                  <div class="line short"></div>
                  <div class="sheet"><span class="blue"></span><span class="accent"></span></div>
                </div>
                <div class="corner" role={layer === 'under' ? 'group' : undefined} aria-label={layer === 'under' ? 'Pick a theme for the stage' : undefined}>
                  {THEME_IDS.map((id) => {
                    const icons = (
                      <Fragment>
                        <Fragment set:html={iconSvg(THEMES[id].icons.unchecked, 'class="unchecked"')} />
                        <Fragment set:html={iconSvg(THEMES[id].icons.checked, `class="checked" data-factor="${THEMES[id].transitionScaleFactor}"`)} />
                        <span>{THEMES[id].name}</span>
                      </Fragment>
                    );
                    return layer === 'under'
                      ? <button class="pick" type="button" data-pick={id} aria-pressed="false">{icons}</button>
                      : <span class="pick" data-pick={id}>{icons}</span>;
                  })}
                </div>
              </div>
            ))}
          </div>
          <p class="stamp">
            <span>stage</span>
            <code>data-demo-theme=<Fragment>{THEME_IDS.map((id) => <span data-stage-shown={id}>"{id}"</span>)}</Fragment></code>
            <span data-stage-shown="none">unset, so the OS scheme decides</span>
          </p>
        </template>
      </div>

      <Fragment slot="annotations">
        <ArrowAnnotation target="[data-stage]" anchor="1 0.1" tipX={1} tipY={-0.8} angle={0} length={0.3} text="The picker, in its corner" lines={['The picker,', 'in its corner']} only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="0.86 0.26" tipX={0.84} tipY={-0.48} angle={-20} length={0.35} text="The icon grows from here" lines={['The icon grows', 'from here']} only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="left" tipX={-0.98} tipY={0} angle={180} length={0.3} text="One page, its own tokens" lines={['One page,', 'its own tokens']} labelSide="left" only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="0.92 0" tipX={0.92} tipY={-1} angle={90} length={0.25} text="The picker" labelSide="left" only="portrait" />
        <ArrowAnnotation target="[data-stage]" anchor="0.86 0.26" tipX={0.84} tipY={-0.48} angle={-110} length={0.5} text="Grows from here" only="portrait" />
      </Fragment>
    </Annotations>
  </div>

  <dl class="rules">
    <div>
      <dt>This page</dt>
      <dd>
        <span class="theme-name" data-readout="theme">{THEME_IDS.map((id) => <span data-shown={id}>{THEMES[id].name}</span>)}</span>,
        <span data-readout="chosen">
          <span data-chosen="os">the OS colour scheme, nothing picked</span>
          <span data-chosen="pick">a pick, kept as <code>cv-theme</code></span></span>.
        Only the corner changes it.
      </dd>
    </div>
    <div>
      <dt>The stage</dt>
      <dd>A shadow root with its own copy of the tokens and its own stamp. What happens there stays there; nothing is kept.</dd>
    </div>
    <div>
      <dt>Without script</dt>
      <dd>The stage stands still on the OS scheme. The corner still switches this page, by CSS alone.</dd>
    </div>
  </dl>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-theme-picker-demo]', boot);
</script>

<style is:global set:html={shownCss('.theme-picker-demo')} />

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".theme-picker-demo");

.theme-picker-demo {
  @include sheet-content;
  @include sheet-type(0.026, 0.03);
  @include clear-of-title-block;
  @include sheet-frame;
}

/* Room for the callouts either side of the stage; the stage alone sets their unit. The
   callout overlay lies over the stage and must not take the presses meant for its keys. */
.figure {
  padding: 0 0.5em;

  :global(svg[data-annotations]) {
    pointer-events: none;
  }
}

.stage {
  width: 30em;
  max-width: 100%;
}

.theme-name {
  font-weight: 600;
}

.rules [data-shown],
.rules [data-chosen] {
  display: var(--shown-display, none);
}
</style>
