---
/**
 * The live sheet: a page of its own on a stage, with the picker in its corner, doing what
 * the corner does to this page. The stage is a shadow root, so its theme switches restyle
 * the stage and nothing else; its walkthrough picks every theme in turn without touching
 * the page's stamp, its stored key or the real picker. The readout under it is this page's
 * own theme, marked by the picker's selectors (shown.ts), so the two are never confused.
 *
 * The page on the stage is this CV at a small scale: its title block, the career table,
 * the bill of materials and a title card, every piece coloured by the stage's own tokens
 * so a pick recolours all of it.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import site from '@/components/Career/site.json';
import { CONTACT } from '@/site';
import { THEME_IDS, THEMES } from '@/themes';

import { shownCss } from '../shown';
import { iconSvg, stageCss } from '../stage';

const css = stageCss();
const layers = ['under', 'over'] as const;

/* The newest three rows of the career sheet's revision table, numbered the way it numbers them. */
const { experience } = site;
const rows = experience.slice(0, 3).map((entry, i) => ({
  rev: String(experience.length - i).padStart(2, '0'),
  role: entry.role,
  org: entry.org,
  when: `${entry.from.date.slice(0, 4)} to ${entry.to.date.slice(0, 4)}`,
}));
const text = experience[0].items.slice(0, 2).join(' ');
const contact = [CONTACT.email, ...CONTACT.profiles.map((p) => p.label)];
const badges = ['Astro', 'TypeScript', 'Sass', 'Vue', 'React', 'Ruby'];
---

<div class="theme-picker-demo" data-theme-picker-demo>
  <header>
    <span class="eyebrow">ThemePicker.astro · themes.ts</span>
    <strong>A pick cuts the new page out of the old one along the icon it was picked with</strong>
  </header>

  <div class="figure">
    <Annotations reach={1.1} fontSize={0.1}>
      <div slot="content" class="stage" data-stage>
        <template shadowrootmode="open">
          <style is:inline set:html={css}></style>
          <div class="screen" data-screen>
            {layers.map((layer) => (
              <div class="paper" data-paper={layer} hidden={layer === 'over'} inert={layer === 'over'} aria-hidden={layer === 'over' ? 'true' : undefined}>
                <div class="page">
                  <div class="title">
                    <p class="meta">DWG · CV-001 · REV A</p>
                    <p class="name">Hugo Sales</p>
                    <p class="role">Full stack developer / FOSS contributor</p>
                    <p class="contact">{contact.map((item) => <span>{item}</span>)}</p>
                  </div>
                  <div class="body">
                    <div class="main">
                      <p class="heading"><span class="code">SH-CAREER</span>Career</p>
                      <p class="text">{text}</p>
                      <table class="revisions">
                        <thead><tr><th>Rev</th><th>Role</th><th>Where</th><th>When</th></tr></thead>
                        <tbody>{rows.map((row) => <tr><td>{row.rev}</td><td>{row.role}</td><td>{row.org}</td><td>{row.when}</td></tr>)}</tbody>
                      </table>
                      <p class="heading"><span class="code">SH-BOM</span>Bill of materials</p>
                      <ul class="badges">{badges.map((badge) => <li>{badge}</li>)}</ul>
                    </div>
                    <div class="card">
                      <span class="label">Title</span>
                      <span class="value">Theme Picker</span>
                      <span class="label">Medium</span>
                      <span class="value">Astro, CSS</span>
                      <span class="label">Notes</span>
                      <span class="note">The corner picks one of four themes; a pick recolours every sheet.</span>
                    </div>
                  </div>
                </div>
                <div class="corner" role={layer === 'under' ? 'group' : undefined} aria-label={layer === 'under' ? 'Pick a theme for the stage' : undefined}>
                  {THEME_IDS.map((id) => {
                    const icons = (
                      <Fragment>
                        <Fragment set:html={iconSvg(THEMES[id].icons.unchecked, 'class="unchecked"')} />
                        <Fragment set:html={iconSvg(THEMES[id].icons.checked, `class="checked" data-factor="${THEMES[id].transitionScaleFactor}"`)} />
                        <span>{THEMES[id].name}</span>
                      </Fragment>
                    );
                    return layer === 'under'
                      ? <button class="pick" type="button" data-pick={id} aria-pressed="false">{icons}</button>
                      : <span class="pick" data-pick={id}>{icons}</span>;
                  })}
                </div>
              </div>
            ))}
          </div>
          <p class="stamp">
            <span>stage</span>
            <code>data-demo-theme=<Fragment>{THEME_IDS.map((id) => <span data-stage-shown={id}>"{id}"</span>)}</Fragment></code>
            <span data-stage-shown="none">unset, so the OS scheme decides</span>
          </p>
        </template>
      </div>

      <Fragment slot="annotations">
        <ArrowAnnotation target="[data-stage]" anchor="1 0.12" tipX={1} tipY={-0.76} angle={0} length={0.3} text="The picker: a pick grows its icon from this corner" lines={['The picker: a pick grows', 'its icon from this corner']} only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="0 0.5" tipX={-1} tipY={0} angle={180} length={0.3} text="A page of its own, with its own tokens" lines={['A page of its own,', 'with its own tokens']} labelSide="left" only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="1 0.7" tipX={1} tipY={0.4} angle={0} length={0.3} text="What is picked here stays here" lines={['What is picked here', 'stays here']} only="landscape" />
        <ArrowAnnotation target="[data-stage]" anchor="0.9 0" tipX={0.9} tipY={-1} angle={90} length={0.25} text="The picker: a pick grows its icon from this corner" lines={['The picker: a pick grows', 'its icon from this corner']} labelSide="left" only="portrait" />
      </Fragment>
    </Annotations>
  </div>

  <dl class="rules">
    <div>
      <dt>This page</dt>
      <dd>
        <span class="theme-name" data-readout="theme">{THEME_IDS.map((id) => <span data-shown={id}>{THEMES[id].name}</span>)}</span>,
        <span data-readout="chosen">
          <span data-chosen="os">the OS colour scheme, nothing picked</span>
          <span data-chosen="pick">a pick, kept as <code>cv-theme</code></span></span>.
        Only the corner changes it.
      </dd>
    </div>
    <div>
      <dt>The stage</dt>
      <dd>A shadow root with its own copy of the tokens; nothing there is kept. Without script it stands still on the OS scheme.</dd>
    </div>
  </dl>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-theme-picker-demo]', boot);
</script>

<style is:global set:html={shownCss('.theme-picker-demo')} />

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".theme-picker-demo");

.theme-picker-demo {
  @include sheet-content;
  @include sheet-type(0.026, 0.03);
  @include clear-of-title-block;
  @include sheet-frame;
}

/* Room for the callouts either side of the stage; the stage alone sets their unit. The
   callout overlay lies over the stage and must not take the presses meant for its keys.
   Portrait has one callout, above the stage, so the figure keeps it off the header. */
.figure {
  padding: 0 0.5em;

  :global(svg[data-annotations]) {
    pointer-events: none;
  }

  :global([data-sheet-orientation='portrait']) & {
    padding: 18% 0.5em 0;
  }
}

.stage {
  width: 30em;
  max-width: 100%;
}

.theme-name {
  font-weight: 600;
}

.rules {
  grid-template-columns: repeat(2, minmax(0, 1fr));

  [data-shown],
  [data-chosen] {
    display: var(--shown-display, none);
  }
}
</style>
