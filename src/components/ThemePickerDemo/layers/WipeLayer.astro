---
/**
 * The wipe, drawn: the picked icon's box in the corner is the first frame of the switch, the
 * same path grown to a square the viewport's diagonal times the theme's factor each side is
 * the last, and the new page is clipped to it in between. The drawing grows the icon of the
 * theme on screen with that theme's own factor, so it is true in every theme.
 */
import { Icon } from 'astro-icon/components';

import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import { THEME_IDS, THEMES } from '@/themes';

import { shownCss } from '../shown';

/* Three frames of the wipe, as fractions of the final square. */
const frames = [0.12, 0.4, 1];
---

<div class="wipe-sheet">
  <header>
    <span class="eyebrow">ThemePicker.astro · startViewTransition · clip-path: path()</span>
    <strong>The icon is the whole animation: its corner box is the first frame, the same path grown over the page the last</strong>
  </header>

  <div class="figure">
    <Annotations reach={1} fontSize={0.07}>
      <div slot="content" class="drawing">
        <div class="viewport" data-viewport aria-hidden="true">
          <span class="old">
            <span class="old-name"></span>
            <span class="old-line"></span>
            <span class="old-line short"></span>
          </span>
          {frames.map((size) => (
            <span class="frame" data-frame={size === 1 ? 'end' : 'mid'} style={`--size: ${size}`}>
              {THEME_IDS.map((id) => <Icon name={THEMES[id].icons.checked} data-shown={id} />)}
            </span>
          ))}
          <span class="corner" data-corner>
            {THEME_IDS.map((id) => <Icon name={THEMES[id].icons.checked} data-shown={id} />)}
          </span>
        </div>
        <ul class="factors" data-factors aria-label="Each theme's factor">
          {THEME_IDS.map((id) => (
            <li data-shown={id}>
              <Icon name={THEMES[id].icons.checked} aria-hidden="true" />
              <span class="factor">× {THEMES[id].transitionScaleFactor}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Both callouts sit inside the viewport, clear of the old page's lines top left, so
          the drawing can take the whole column in either orientation. */}
      <Fragment slot="annotations">
        <ArrowAnnotation target="[data-corner]" anchor="center" tipX={0.9} tipY={-0.86} angle={-120} length={0.35} text="Frame 1: the icon's box in the corner" lines={['Frame 1: the icon\'s box', 'in the corner']} labelSide="left" />
        <ArrowAnnotation target="[data-viewport]" anchor="0.62 0.6" tipX={0.24} tipY={0.2} angle={180} length={0.2} text="The same path, grown: a square diagonal × factor wide" lines={['The same path, grown:', 'diagonal × factor wide']} labelSide="left" />
      </Fragment>
    </Annotations>
  </div>

  <dl class="rules">
    <div>
      <dt>Old and new</dt>
      <dd><code>startViewTransition</code> holds a picture of the old page; the new one renders under it.</dd>
    </div>
    <div>
      <dt>The path</dt>
      <dd>The checked icon's <code>&lt;path&gt;</code>, mapped from its viewBox onto the corner box, then onto the square.</dd>
    </div>
    <div>
      <dt>The motion</dt>
      <dd><code>clip-path</code> from the one to the other, 500 ms ease-in. A moon is round already; a sun grows further. Off under reduced motion.</dd>
    </div>
  </dl>
</div>

<style is:global set:html={shownCss('.wipe-sheet')} />

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".wipe-sheet");

.wipe-sheet {
  @include sheet-content;
  @include sheet-type(0.024, 0.028);
  @include clear-of-title-block;
  @include sheet-frame;
  @include sheet-frame-side;
}

/* The callout overlay shrink-wraps its artwork; here the artwork is the column, capped so
   the viewport clears the title block on a landscape sheet. The overlay reaches half an
   artwork past it, and both callouts stay inside the viewport, so the figure clips it. */
.figure {
  justify-items: center;
  overflow: clip;

  :global(.content) {
    width: min(100%, 40em);
  }
}

.drawing {
  display: grid;
  gap: 0.5em;
  width: 100%;
}

/* A viewport, drawn 16:10, with the picker's corner top right. The frames are the icon
   itself, centred on the corner icon and grown to a share of the final square: a square
   --size of two diagonals wide, since the smallest factor is 1.2 and the largest 2.4. */
.viewport {
  --corner: 1.5em;

  position: relative;
  aspect-ratio: 16 / 10;
  width: 100%;
  border: 1px solid var(--line-strong);
  border-radius: 0.125em;
  background: var(--surface-sunken);
  overflow: hidden;
}

/* The old page, still under the frames: a name and two lines, top left. */
.old {
  position: absolute;
  inset: 0.75em 3em 0.75em 0.875em;
  display: grid;
  gap: 0.375em;
  align-content: start;
}

.old-name {
  width: 22%;
  height: 0.625em;
  border-radius: 0.125em;
  background: var(--ink-muted);
}

.old-line {
  width: 32%;
  height: 0.25em;
  border-radius: 0.125em;
  background: var(--ink-faint);

  &.short {
    width: 24%;
  }
}

.corner,
.frame {
  position: absolute;
  top: calc(var(--corner) * 0.5);
  right: calc(var(--corner) * 0.5);
  translate: 50% -50%;
  display: block;
}

.corner {
  width: var(--corner);
  height: var(--corner);
  color: var(--ink);
}

.frame {
  /* Percentages of the viewport box: its diagonal is 1.18 of its width and 1.89 of its height. */
  width: calc(var(--size) * 236%);
  height: calc(var(--size) * 378%);
  color: color-mix(in oklch, var(--accent), transparent calc(100% - var(--size) * 45%));
}

.corner :global(svg),
.frame :global(svg) {
  display: var(--shown-display, none);
  width: 100%;
  height: 100%;
}

/* Each theme's factor under the viewport, the one on screen in full ink. */
.factors {
  display: flex;
  justify-content: space-between;
  gap: 0.5em;
  margin: 0;
  padding: 0;
  list-style: none;

  li {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.875em);
    color: var(--ink-faint);
  }

  li[data-shown] {
    display: flex;
  }

  li :global(svg) {
    width: 1.25em;
    height: 1.25em;
  }

  /* The theme on screen: the selectors set --shown to 1 on it, the rest stay faint. */
  li {
    color: color-mix(in oklch, var(--ink) calc(var(--shown, 0) * 100%), var(--ink-faint));
  }
}
</style>
