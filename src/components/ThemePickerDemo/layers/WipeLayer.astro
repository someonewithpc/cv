---
/**
 * The wipe, drawn: the picked icon's box in the corner is the first frame of the switch, the
 * same path grown to a square the viewport's diagonal times the theme's factor each side is
 * the last, and the new page is clipped to it in between. The drawing grows the icon of the
 * theme on screen with that theme's own factor, so it is true in every theme. The frames
 * carry numbered balloons and the rules beside the drawing read them, so no text lies on it.
 */
import { Icon } from 'astro-icon/components';

import { THEME_IDS, THEMES } from '@/themes';

import { shownCss } from '../shown';

/* Three frames of the wipe, as fractions of the final square. */
const frames = [0.12, 0.4, 1];
---

<div class="wipe-sheet">
  <header>
    <strong>The visible icon drives the animation by creating a starting point from it's placement and an end point with that same icon sized to cover the whole viewport</strong>
  </header>

  <div class="figure">
    <div class="drawing">
      <div class="viewport" data-viewport aria-hidden="true">
        <span class="old">
          <span class="old-name"></span>
          <span class="old-line"></span>
          <span class="old-line short"></span>
        </span>
        {frames.map((size) => (
          <span class="frame" data-frame={size === 1 ? 'end' : 'mid'} style={`--size: ${size}`}>
            {THEME_IDS.map((id) => <Icon name={THEMES[id].icons.checked} data-shown={id} />)}
          </span>
        ))}
        <span class="corner" data-corner>
          {THEME_IDS.map((id) => <Icon name={THEMES[id].icons.checked} data-shown={id} />)}
        </span>
        <span class="balloon" data-balloon="1" style="--x: 90%; --y: 11%">1</span>
        <span class="balloon" data-balloon="2" style="--x: 18%; --y: 82%">2</span>
        <span class="balloon" data-balloon="3" style="--x: 64%; --y: 44%">3</span>
      </div>
      <ul class="factors" data-factors aria-label="Each theme's factor">
        {THEME_IDS.map((id) => (
          <li data-shown={id}>
            <Icon name={THEMES[id].icons.checked} aria-hidden="true" />
            <span class="factor">× {THEMES[id].transitionScaleFactor}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <dl class="rules">
    <div>
      <dt><span class="balloon">1</span>First frame</dt>
      <dd>The checked icon's <code>&lt;path&gt;</code>, mapped from its viewBox onto its box in the corner.</dd>
    </div>
    <div>
      <dt><span class="balloon">2</span>Last frame</dt>
      <dd>The same path, grown to a square the viewport's diagonal × the theme's factor wide.</dd>
    </div>
    <div>
      <dt><span class="balloon">3</span>Between</dt>
      <dd><code>clip-path</code> from the one to the other, 500 ms ease-in, over a picture of the old page. Off under reduced motion.</dd>
    </div>
  </dl>
</div>

<style is:global set:html={shownCss('.wipe-sheet')} />

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".wipe-sheet");

.wipe-sheet {
  @include sheet-content;
  @include sheet-type(0.024, 0.028);
  @include clear-of-title-block;
  @include sheet-frame;
  @include sheet-frame-side;
}

/* The drawing takes the column, capped so the viewport clears the title block on a
   landscape sheet. */
.figure {
  justify-items: center;
}

.drawing {
  display: grid;
  gap: 0.5em;
  width: min(100%, 40em);
}

/* A viewport, drawn 16:10, with the picker's corner top right. The frames are the icon
   itself, centred on the corner icon and grown to a share of the final square: a square
   --size of two diagonals wide, since the smallest factor is 1.2 and the largest 2.4. */
.viewport {
  --corner: 1.5em;

  position: relative;
  aspect-ratio: 16 / 10;
  width: 100%;
  border: 1px solid var(--line-strong);
  border-radius: 0.125em;
  background: var(--surface-sunken);
  overflow: hidden;
}

/* The old page, still under the frames: a name and two lines, top left. */
.old {
  position: absolute;
  inset: 0.75em 3em 0.75em 0.875em;
  display: grid;
  gap: 0.375em;
  align-content: start;
}

.old-name {
  width: 22%;
  height: 0.625em;
  border-radius: 0.125em;
  background: var(--ink-muted);
}

.old-line {
  width: 32%;
  height: 0.25em;
  border-radius: 0.125em;
  background: var(--ink-faint);

  &.short {
    width: 24%;
  }
}

.corner,
.frame {
  position: absolute;
  top: calc(var(--corner) * 0.5);
  right: calc(var(--corner) * 0.5);
  translate: 50% -50%;
  display: block;
}

.corner {
  width: var(--corner);
  height: var(--corner);
  color: var(--ink);
}

.frame {
  /* Percentages of the viewport box: its diagonal is 1.18 of its width and 1.89 of its height. */
  width: calc(var(--size) * 236%);
  height: calc(var(--size) * 378%);
  color: color-mix(in oklch, var(--accent), transparent calc(100% - var(--size) * 45%));
}

.corner :global(svg),
.frame :global(svg) {
  display: var(--shown-display, none);
  width: 100%;
  height: 100%;
}

/* Numbered balloons: a ruled disc on the sheet's paper, one on each frame of the drawing
   and one before the rule that reads it. */
.balloon {
  display: inline-grid;
  place-items: center;
  width: 1.75em;
  height: 1.75em;
  border: 1px solid var(--ink);
  border-radius: 50%;
  background: var(--sheet-paper);
  font-family: monospace, system-ui;
  font-size: max(0.625rem, 0.875em);
  font-weight: 600;
  line-height: 1;
  color: var(--ink);
}

.viewport .balloon {
  position: absolute;
  top: var(--y);
  left: var(--x);
  translate: -50% -50%;
}

.rules dt {
  display: flex;
  align-items: center;
  gap: 0.5em;
}

/* Each theme's factor under the viewport, the one on screen in full ink. */
.factors {
  display: flex;
  justify-content: space-between;
  gap: 0.5em;
  margin: 0;
  padding: 0;
  list-style: none;

  li {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.875em);
    color: var(--ink-faint);
  }

  li[data-shown] {
    display: flex;
  }

  li :global(svg) {
    width: 1.25em;
    height: 1.25em;
  }

  /* The theme on screen: the selectors set --shown to 1 on it, the rest stay faint. */
  li {
    color: color-mix(in oklch, var(--ink) calc(var(--shown, 0) * 100%), var(--ink-faint));
  }
}
</style>
