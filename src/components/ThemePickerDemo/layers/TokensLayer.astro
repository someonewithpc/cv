---
/**
 * The token layers, painted live: four seeds, the three ramps _colors.scss mixes from them,
 * and the names a sheet reads. Every swatch is the token itself, so the drawing shows the
 * theme on screen and a switch repaints it with the rest of the page.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

const seeds = ['canvas', 'ink', 'accent', 'blueprint'];
const steps = Array.from({ length: 12 }, (_, i) => i + 1);
const ramps = ['neutral', 'accent', 'blueprint'];
const names = ['--surface-page', '--ink', '--line', '--accent', '--blueprint-grid'];
---

<div class="tokens-sheet">
  <header>
    <span class="eyebrow">ThemePicker.astro · _colors.scss</span>
    <strong>Four seeds per theme, three ramps mixed from them, and the names every sheet reads</strong>
  </header>

  <div class="figure">
    <Annotations reach={1.5} fontSize={0.11}>
      <div slot="content" class="drawing">
        <ul class="seeds" data-seeds aria-label="Seeds">
          {seeds.map((seed) => (
            <li style={`--swatch: var(--theme-${seed})`}>
              <span class="swatch"></span>
              <code>{seed}</code>
            </li>
          ))}
        </ul>

        <span class="flow" aria-hidden="true">color-mix(in oklch)</span>

        <div class="ramps" data-ramps>
          {ramps.map((name) => (
            <div class="ramp">
              <code class="ramp-name">{name}</code>
              <ol aria-label={`${name} 1 to 12`}>
                {steps.map((i) => (
                  <li style={`--swatch: var(--${name}-${i})`}><span class="swatch"></span></li>
                ))}
              </ol>
            </div>
          ))}
        </div>

        <span class="flow" aria-hidden="true">var()</span>

        <ul class="names" data-names aria-label="Names">
          {names.map((token) => (
            <li style={`--swatch: var(${token})`}>
              <span class="swatch"></span>
              <code>{token}</code>
            </li>
          ))}
        </ul>
      </div>

      <Fragment slot="annotations">
        <ArrowAnnotation target="[data-seeds]" anchor="right" tipX={0.85} tipY={-0.85} angle={0} length={0.3} text="Seeds: four colours on :root, per theme" lines={['Seeds: four colours', 'on :root, per theme']} only="landscape" />
        <ArrowAnnotation target="[data-seeds]" anchor="top-right" tipX={0.85} tipY={-0.95} angle={90} length={0.25} text="Seeds: four colours on :root, per theme" lines={['Seeds: four colours', 'on :root, per theme']} labelSide="left" only="portrait" />
        <ArrowAnnotation target="[data-ramps]" anchor="right" tipX={0.9} tipY={-0.05} angle={0} length={0.3} text="Twelve steps: canvas to ink; accent and blueprint tinted, then shaded" lines={['Twelve steps: canvas to ink;', 'accent and blueprint', 'tinted, then shaded']} only="landscape" />
        <ArrowAnnotation target="[data-ramps]" anchor="left" tipX={-0.9} tipY={-0.05} angle={180} length={0.2} text="Twelve steps" lines={['Twelve', 'steps']} labelSide="left" only="portrait" />
        <ArrowAnnotation target="[data-names]" anchor="right" tipX={0.9} tipY={0.8} angle={0} length={0.3} text="Names: what a sheet reads, never a ramp step" lines={['Names: what a sheet reads,', 'never a ramp step']} only="landscape" />
        <ArrowAnnotation target="[data-names]" anchor="bottom-right" tipX={0.9} tipY={0.95} angle={-90} length={0.25} text="Names: what a sheet reads" lines={['Names: what', 'a sheet reads']} labelSide="left" only="portrait" />
      </Fragment>
    </Annotations>
  </div>

  <dl class="rules">
    <div>
      <dt>Seeds</dt>
      <dd>A theme is four oklch colours. A dark theme's ink is light, so its ramps run the other way by themselves.</dd>
    </div>
    <div>
      <dt>Ramps</dt>
      <dd>A Sass loop: neutral mixes canvas into ink in eleven equal steps; accent and blueprint tint to 8, seed at 9, shade to 12.</dd>
    </div>
    <div>
      <dt>Names</dt>
      <dd>A blueprint sheet like this one remaps them from its own paper, so the swatches here are the sheet's, not the page's.</dd>
    </div>
  </dl>
</div>

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".tokens-sheet");

.tokens-sheet {
  @include sheet-content;
  @include sheet-type(0.024, 0.028);
  @include clear-of-title-block;
  @include sheet-frame;
}

.figure {
  padding: 0 1em;
}

.drawing {
  display: grid;
  justify-items: center;
  gap: 0.375em;
  width: 26em;
  max-width: 100%;
  font-family: monospace, system-ui;
}

.swatch {
  @include swatch(1.5em);
}

.seeds,
.names {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5em 1em;
  margin: 0;
  padding: 0;
  list-style: none;

  li {
    display: grid;
    justify-items: center;
    gap: 0.125em;
    font-size: max(0.5rem, 0.75em);
  }
}

.names .swatch {
  width: 1.25em;
  height: 1.25em;
}

/* The arrow between layers, with what carries a colour down it. */
.flow {
  position: relative;
  padding-top: 1.25em;
  font-size: max(0.5rem, 0.75em);
  color: var(--ink-muted);

  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    height: 1em;
    border-left: 1px solid var(--line-strong);
  }

  &::after {
    content: '';
    position: absolute;
    top: 0.75em;
    left: 50%;
    width: 0.375em;
    height: 0.375em;
    translate: -50% 0;
    border: solid var(--line-strong);
    border-width: 0 1px 1px 0;
    rotate: 45deg;
  }
}

.ramps {
  display: grid;
  gap: 0.375em;
  width: 100%;
}

.ramp {
  display: grid;
  grid-template-columns: 5em minmax(0, 1fr);
  align-items: center;
  gap: 0.5em;

  ol {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.125em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatch {
    width: 100%;
    aspect-ratio: 1;
    height: auto;
  }
}

.ramp-name {
  font-size: max(0.5rem, 0.75em);
  text-align: right;
}
</style>
