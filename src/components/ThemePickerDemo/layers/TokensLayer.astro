---
/**
 * The token layers, painted live: four seeds, the three ramps _colors.scss mixes from them,
 * and the names a sheet reads. Every swatch is the token itself, so the drawing shows the
 * theme on screen and a switch repaints it with the rest of the page. The layers are
 * labelled in the margin, the way the ramps are, so the drawing needs no callouts.
 */
const seeds = ['canvas', 'ink', 'accent', 'blueprint'];
const steps = Array.from({ length: 12 }, (_, i) => i + 1);
const ramps = ['neutral', 'accent', 'blueprint'];
const names = ['--surface-page', '--ink', '--line', '--accent', '--blueprint'];
---

<div class="tokens-sheet">
  <header>
    <span class="eyebrow">ThemePicker.astro · _colors.scss</span>
    <strong>Four seeds per theme, three ramps mixed from them, and the names every sheet reads</strong>
  </header>

  <div class="figure">
    <div class="drawing">
      <span class="layer-name">seeds</span>
      <ul class="seeds" data-seeds aria-label="Seeds">
        {seeds.map((seed) => (
          <li style={`--swatch: var(--theme-${seed})`}>
            <span class="swatch"></span>
            <code>{seed}</code>
          </li>
        ))}
      </ul>

      <span class="flow" aria-hidden="true">color-mix(in oklch)</span>

      {ramps.map((name) => (
        <div class="ramp">
          <code class="layer-name">{name}</code>
          <ol aria-label={`${name} 1 to 12`}>
            {steps.map((i) => (
              <li style={`--swatch: var(--${name}-${i})`}><span class="swatch"></span><span class="step">{i}</span></li>
            ))}
          </ol>
        </div>
      ))}

      <span class="flow" aria-hidden="true">var()</span>

      <span class="layer-name">names</span>
      <ul class="names" data-names aria-label="Names">
        {names.map((token) => (
          <li style={`--swatch: var(${token})`}>
            <span class="swatch"></span>
            <code>{token}</code>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <dl class="rules">
    <div>
      <dt>Seeds</dt>
      <dd>Four oklch colours on <code>:root</code> per theme. A dark theme's ink is light, so its ramps run the other way by themselves.</dd>
    </div>
    <div>
      <dt>Ramps</dt>
      <dd>A Sass loop: neutral mixes canvas into ink in eleven steps; accent and blueprint tint to 8, seed at 9, shade to 12.</dd>
    </div>
    <div>
      <dt>Names</dt>
      <dd>What a sheet reads, never a step. A blueprint sheet like this one remaps them from its own paper.</dd>
    </div>
  </dl>
</div>

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".tokens-sheet");

.tokens-sheet {
  @include sheet-content;
  @include sheet-type(0.028, 0.032);
  @include sheet-frame;
  @include sheet-frame-side;
}

.figure {
  align-content: center;
}

/* The three layers on one grid: a label column, then the swatches. */
.drawing {
  display: grid;
  grid-template-columns: 5.5em minmax(0, 1fr);
  align-items: center;
  gap: 0.5em 0.75em;
  width: 100%;
  font-family: monospace, system-ui;
}

.ramp {
  display: contents;
}

.layer-name {
  font-size: max(0.5rem, 0.875em);
  letter-spacing: 0.06em;
  text-align: right;
  color: var(--ink-muted);
}

.swatch {
  @include swatch(2.5em);
}

.seeds,
.names {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5em 1.25em;
  margin: 0;
  padding: 0;
  list-style: none;

  li {
    display: grid;
    justify-items: center;
    gap: 0.25em;
    font-size: max(0.5rem, 0.875em);
  }
}

.names .swatch {
  width: 2em;
  height: 2em;
}

/* The arrow between layers, with what carries a colour down it. */
.flow {
  position: relative;
  grid-column: 2;
  justify-self: start;
  margin-left: 1em;
  padding-top: 1.25em;
  font-size: max(0.5rem, 0.875em);
  color: var(--ink-muted);

  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0.5em;
    height: 1em;
    border-left: 1px solid var(--line-strong);
  }

  &::after {
    content: '';
    position: absolute;
    top: 0.75em;
    left: 0.5em;
    width: 0.375em;
    height: 0.375em;
    translate: -50% 0;
    border: solid var(--line-strong);
    border-width: 0 1px 1px 0;
    rotate: 45deg;
  }
}

.ramp ol {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 0.25em;
  margin: 0;
  padding: 0;
  list-style: none;

  li {
    display: grid;
    justify-items: center;
    gap: 0.125em;
  }

  .swatch {
    width: 100%;
    aspect-ratio: 1;
    height: auto;
  }

  .step {
    font-size: max(0.5rem, 0.75em);
    color: var(--ink-faint);
  }
}
</style>
