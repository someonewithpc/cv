---
/**
 * Who decides the theme: the OS until something is picked, then the stamp and the radio.
 * The three rules are drawn in cascade order with a lamp each, lit by the same selectors
 * that paint the page (shown.ts), so a pick in the corner moves the light. Each card
 * carries its own note, so the drawing needs no callouts.
 */
import { shownCss } from '../shown';

const rules = [
  { mark: 'os', name: 'OS scheme', selector: '@media (prefers-color-scheme: dark) { :root:not([data-theme]):not(:has(radio:checked)) }', note: 'the OS only knows light and dark' },
  { mark: 'stamp', name: 'stamp', selector: ':root[data-theme="dark"]', note: 'written by the pick, kept as cv-theme' },
  { mark: 'radio', name: 'radio', selector: ':root:has(#theme-dark:checked)', note: 'works without script' },
];

const reload = ['localStorage', '<head> script', 'data-theme on <html>', 'first paint'];
---

<div class="default-sheet">
  <header>
    <span class="eyebrow">ThemePicker.astro · Layout.astro</span>
    <strong>The OS decides the theme until a pick, and from then on the stamp decides, before the first paint</strong>
  </header>

  <div class="figure">
    <div class="drawing">
      <ol class="cascade" data-cascade aria-label="The rules, in cascade order">
        {rules.map(({ mark, name, selector, note }) => (
          <li data-chosen={mark}>
            <span class="lamp" data-lamp aria-hidden="true"></span>
            <span class="rule-name">{name}</span>
            <span class="on">painting</span>
            <code class="selector">{selector}</code>
            <span class="note">{note}</span>
          </li>
        ))}
      </ol>

      <div class="reload-row">
        <ol class="reload" data-reload aria-label="A reload with a pick kept">
          {reload.map((stop) => <li><code>{stop}</code></li>)}
        </ol>
        <span class="caption">On a reload, eight lines in the head stamp the kept pick before the first paint</span>
      </div>
    </div>
  </div>

  <dl class="rules">
    <div>
      <dt>Nothing picked</dt>
      <dd>Only the OS rule matches, so the page follows the system and changes with it.</dd>
    </div>
    <div>
      <dt>A pick</dt>
      <dd>Writes the stamp, checks the radio, keeps <code>cv-theme</code>. <code>color-scheme: only</code> on <code>&lt;body&gt;</code> takes scrollbars and controls along.</dd>
    </div>
    <div>
      <dt>Radios by id</dt>
      <dd>An attribute inside <code>:has()</code> put every input on the page in <code>:root</code>'s invalidation set; an id names one.</dd>
    </div>
  </dl>
</div>

<style is:global set:html={shownCss('.default-sheet')} />

<style lang="scss">
@use "./sheet" as *;

@include stretch-cell(".default-sheet");

.default-sheet {
  @include sheet-content;
  @include sheet-type(0.028, 0.032);
  @include sheet-frame;
  @include sheet-frame-side;
}

.figure {
  align-content: center;
}

.drawing {
  display: grid;
  gap: 1.25em;
  width: 100%;
}

/* The three rules, drawn as a stack in cascade order, each with a lamp lit while it paints. */
.cascade {
  display: grid;
  gap: 0.625em;
  margin: 0;
  padding: 0;
  list-style: none;

  li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'lamp name on'
      'lamp selector selector'
      'lamp note note';
    align-items: center;
    gap: 0.25em 0.75em;
    padding: 0.625em 0.875em;
    border: 1px solid var(--line);
    border-radius: 0.25em;
    background: var(--sheet-paper);
    color: var(--ink-muted);
  }

  /* The selectors set --shown to 1 on the rule painting now. */
  li[data-chosen] {
    display: grid;
  }

  .lamp {
    grid-area: lamp;
    width: 0.875em;
    height: 0.875em;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in oklch, var(--accent) calc(var(--shown, 0) * 100%), transparent);
    box-shadow: 0 0 calc(var(--shown, 0) * 0.625em) var(--accent);
  }

  .rule-name {
    grid-area: name;
    font-family: monospace, system-ui;
    font-size: 1em;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .selector {
    grid-area: selector;
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.875em);
    line-height: 1.35;
    overflow-wrap: anywhere;
    color: color-mix(in oklch, var(--ink) calc(var(--shown, 0) * 100%), var(--ink-muted));
  }

  .note {
    grid-area: note;
    font-size: max(0.5rem, 0.875em);
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .on {
    grid-area: on;
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.875em);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    opacity: var(--shown, 0);
  }
}

/* A reload with a pick kept, as four stops on a line, with its caption under it. */
.reload-row {
  display: grid;
  gap: 0.375em;
}

.reload {
  display: flex;
  justify-content: space-between;
  gap: 0.5em;
  margin: 0;
  padding: 0;
  list-style: none;
  font-family: monospace, system-ui;
  font-size: max(0.5rem, 0.875em);

  li {
    position: relative;
    flex: 1;
    padding-top: 0.875em;
    text-align: center;

    &::before {
      content: '';
      position: absolute;
      top: 0.25em;
      left: 50%;
      width: 0.5em;
      height: 0.5em;
      translate: -50% 0;
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      background: var(--sheet-paper);
    }

    &::after {
      content: '';
      position: absolute;
      top: 0.5em;
      left: calc(50% + 0.25em);
      right: calc(-50% + 0.25em);
      border-top: 1px solid var(--line-strong);
    }

    &:last-child::after {
      content: none;
    }
  }
}

.caption {
  font-size: max(0.5rem, 0.875em);
  line-height: 1.35;
  text-align: center;
  color: var(--ink-muted);
}
</style>
