---
import { Icon } from 'astro-icon/components';

const THEMES = {
  light: {
    fg: '#eee',
    bg: '#222',
    blueprint: '#3f77df',
    accent: 'orange',
    follows: 'light',
    name: 'Light Theme',
    transitionScaleFactor: 2.4,
    icons: {
      checked: 'boxicons:sun-filled',
      unchecked: 'boxicons:sun',
    },
  },

  dark: {
    fg: '#222',
    bg: '#eee',
    blueprint: '#21328a',
    accent: 'orange',
    follows: 'dark',
    name: 'Dark Theme',
    transitionScaleFactor: 1.2,
    icons: {
      checked: 'boxicons:moon-filled',
      unchecked: 'boxicons:moon',
    },
  },

  /* cave: {
    fg: '#222',
    bg: '#eee',
    accent: 'orange',
    follows: 'dark',
    name: 'Cave Theme',
    icons: {
      checked: 'cave',
      unchecked: 'cave',
    },
  }, */
};

const THEMES_CSS = `
${Object.entries({ light: THEMES.light, dark: THEMES.dark }).map(([id, settings]) => (
  `  @media (prefers-color-scheme: ${id}) {
    :root:not(:has(#theme-picker input[name="theme"]:is(:not(.with-transition):checked, .with-transition.checked))) {
      --theme-base-fg: ${settings.fg};
      --theme-base-bg: ${settings.bg};
      --theme-base-accent: ${settings.accent};
      --theme-base-blueprint: ${settings.blueprint};

      --base-fg: var(--theme-base-fg);
      --base-bg: var(--theme-base-bg);
      --base-accent: var(--theme-base-accent);
      --base-blueprint: var(--theme-base-blueprint);

      --theme-kind: ${id};
    }
  }`
)).join('\n\n')}
${Object.entries(THEMES).map(([id, settings]) => `
  :root:has(#theme-picker input[name="theme"][value="${id}"]:is(:not(.with-transition):checked, .with-transition.checked)) {
    --theme-kind: ${id};

    --theme-base-fg: ${settings.fg};
    --theme-base-bg: ${settings.bg};
    --theme-base-accent: ${settings.accent};
    --theme-base-blueprint: ${settings.blueprint};

    --base-fg: var(--theme-base-fg);
    --base-bg: var(--theme-base-bg);
    --base-accent: var(--theme-base-accent);
    --base-blueprint: var(--theme-base-blueprint);

    body {
      color-scheme: only ${settings.follows};
    }
  }`).join('\n')}
`;
---

<div id="theme-picker-transition-background" />

<aside id="theme-picker">
  {Object.entries(THEMES).map(([id, settings]) => (
  <>
    <label class="bypass-contrast-check">
      <input tabindex="0" type="radio" name="theme" value={id} class="sr-only" />
      <Icon name={settings.icons.unchecked} class="unchecked" />
      <Icon name={settings.icons.checked} class="checked" data-theme-transition-scale-factor={settings.transitionScaleFactor} />
      <span>{settings.name}</span>
    </label>
  </>
  ))}
</aside>

<style lang="scss">
aside {
  padding: 0.75em;
  $border: 2px solid var(--accent-600);
  border-left: $border;
  border-bottom: $border;
  border-bottom-left-radius: 1em;

  display: inline-block;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 10;

  color: var(--fg-500);
  background: var(--bg-850);

  &:hover, &:focus-within {
    color: var(--fg-800);
    background: var(--bg-875);
  }

  label {
    cursor: pointer;

    &:focus-within {
      outline: 1px solid var(--fg-850);
    }

    display: flex block;
    align-items: center;
    gap: 1ch;

    svg {
      display: none;
    }

    &:has(input[name="theme"]:checked) svg.checked {
      display: revert;
    }

    &:has(input[name="theme"]:not(:checked)) svg.unchecked {
      display: revert;
    }
  }
}
</style>

<style is:global set:html={THEMES_CSS} />

<style is:global lang="scss">
@use "@/scss/_colors.scss" as colors;

:root {
  @include colors.color-variables;

  color-scheme: light dark;

  body {
    color: var(--fg-900);
    background: var(--bg-900);
    accent-color: var(--accent-900);

    &.theme-transition {
      view-transition-name: theme-transition;
    }

    @at-root ::view-transition-group(theme-transition) {
      animation: none;
    }
  }
}


#theme-picker-transition-background {
  position: fixed;
  inset: 0;
  background: var(--bg-900);
  z-index: -1;
}
</style>

<script>
import { transformPath, pathDataToString } from '@/client/svg-utils';

if (!('getPathData' in SVGPathElement)) {
  await import('path-data-polyfill');
}

const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

if (!prefersReducedMotion.matches) {
  const inputs = [...document.querySelectorAll<HTMLInputElement>('#theme-picker input')];
  inputs.forEach((inputEl) => {
    inputEl.classList.add('with-transition');
    inputEl.addEventListener('input', () => {
      document.body.classList.add('theme-transition');
      const viewTransition = document.startViewTransition({
        types: ['theme-transition'],
        update() {
          inputs.forEach((input) => input.classList.remove('checked'));
          inputEl.classList.add('checked');
        },
      });

      viewTransition.ready.then(() => {
        const svg = inputEl.parentElement?.querySelector<SVGSVGElement>('svg.checked');
        if (!svg) return;

        const rect = svg.getBoundingClientRect();

        const symbol = svg.querySelector<SVGSymbolElement>('symbol');
        if (!symbol) return;

        const viewBox = symbol.viewBox.baseVal;

        const path = svg.querySelector<SVGPathElement>('path');
        if (!path) return;

        const pathData = path.getPathData();

        const scaleFactor = +(svg.dataset.themeTransitionScaleFactor ?? '1');
        const size = Math.hypot(window.innerWidth, window.innerHeight) * scaleFactor;

        const startPathData = transformPath(pathData, viewBox, { x: rect.x, y: rect.y + window.scrollY, width: rect.width, height: rect.height });
        const endPathData = transformPath(pathData, viewBox, { x: rect.x - size, y: rect.y - size + window.scrollY, width: size * 2, height: size * 2 });

        document.documentElement.animate(
          [
            { clipPath: `path("${pathDataToString(startPathData)}")` },
            { clipPath: `path("${pathDataToString(endPathData)}")` },
          ],
          {
            duration: 500,
            easing: 'ease-in',
            pseudoElement: '::view-transition-new(theme-transition)',
          },
        );
      });

      viewTransition.finished.then(() => {
        document.body.classList.remove('theme-transition');
      });
    }, { passive: true });
  });
}
</script>
