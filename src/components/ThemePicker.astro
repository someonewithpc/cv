---
import { Icon } from 'astro-icon/components';

type ThemeFollows = 'light' | 'dark';

type ThemeSettings = {
  canvas: string;
  ink: string;
  accent: string;
  blueprint: string;
  /** The desk top the page lies on at wide viewports, and how much of its grain shows. */
  desk: string;
  deskGrain: string;
  /** The veneer that desk is cut from: one scan per theme, in public/desk. */
  deskWood: string;
  /**
   * A dark desk subtracts its veneer from this base rather than laying it over the desk
   * colour, because overlay scales every step by base * (1 - base) and near black that
   * leaves the tone and eats the fibre. The base is the scan's own mean colour less 28 of
   * 255, which is the lightness the desk keeps; the veil then goes opaque and hands the
   * desk its hue and chroma back while the subtraction holds the grain at full size.
   */
  deskBase?: string;
  /** How strongly the paper's fibre tile shows on a sheet (see paper-grain in _colors.scss).
      Dark paper needs less of it: soft-light lightens as much as it darkens, and on a dark
      sheet the lightened fibre reads faster than on a light one. */
  /** How strongly the paper's fibre tile shows on a sheet (see paper-grain in _colors.scss). */
  paperGrain: string;
  /** multiply for a light sheet, screen for a dark one -- see paper-grain in _colors.scss. */
  paperBlend: 'multiply' | 'screen';
  /** '1' flips the tile dark-side-up for screen on a dark sheet, '0' leaves it as scanned. */
  paperInvert: '0' | '1';
  follows: ThemeFollows;
  name: string;
  transitionScaleFactor: number;
  icons: {
    checked: string;
    unchecked: string;
  };
};

const THEMES = {
  light: {
    // Lifted from round 1's oklch(0.97 0.011 85): multiply's own darkening eats back into
    // this, and the tile's grain needs the extra headroom to read at a visible sd.
    canvas: 'oklch(0.99 0.006 85)',
    ink: 'oklch(0.24 0.025 260)',
    accent: 'oklch(0.7 0.13 65)',
    blueprint: 'oklch(0.52 0.14 255)',
    desk: 'oklch(0.76 0.05 68)',
    deskGrain: '0.85',
    /* The same oak as the other three, raised to the ash boards' tone and limed. */
    deskWood: 'oak-7760-limed',
    paperGrain: '0.7',
    paperBlend: 'multiply',
    paperInvert: '0',
    follows: 'light',
    name: 'Light',
    transitionScaleFactor: 2.4,
    icons: {
      checked: 'sun-filled',
      unchecked: 'sun',
    },
  },
  dark: {
    canvas: 'oklch(0.2 0.035 265)',
    ink: 'oklch(0.92 0.02 250)',
    accent: 'oklch(0.78 0.1 75)',
    blueprint: 'oklch(0.4 0.12 265)',
    desk: 'oklch(0.235 0.01 55)',
    deskGrain: '0',
    /* Slip-matched oak, levelled: cathedral figure across the page and no joint in it. */
    deskWood: 'oak-7760-mid',
    deskBase: 'rgb(128 97 73)',
    paperGrain: '0.6',
    paperBlend: 'screen',
    paperInvert: '1',
    follows: 'dark',
    name: 'Dark',
    transitionScaleFactor: 1.2,
    icons: {
      checked: 'moon-filled',
      unchecked: 'moon',
    },
  },
  arctic: {
    // Lifted from round 1's oklch(0.96 0.016 230) to pay back multiply's darkening, same as light.
    canvas: 'oklch(0.98 0.009 230)',
    ink: 'oklch(0.3 0.04 250)',
    accent: 'oklch(0.52 0.1 210)',
    blueprint: 'oklch(0.58 0.12 220)',
    desk: 'oklch(0.81 0.013 232)',
    deskGrain: '0.85',
    /* The same oak at its own lightness, which under a pale desk reads as bleached. */
    deskWood: 'oak-7760',
    paperGrain: '0.7',
    paperBlend: 'multiply',
    paperInvert: '0',
    follows: 'light',
    name: 'Arctic',
    transitionScaleFactor: 2,
    icons: {
      checked: 'snowflake-filled',
      unchecked: 'snowflake',
    },
  },
  'dark-forest': {
    canvas: 'oklch(0.17 0.035 145)',
    ink: 'oklch(0.9 0.035 110)',
    accent: 'oklch(0.72 0.1 95)',
    blueprint: 'oklch(0.36 0.08 165)',
    desk: 'oklch(0.225 0.03 75)',
    deskGrain: '0',
    /* The same oak smoked in the file: darker, and drained of red before the veil goes on. */
    deskWood: 'oak-7760-smoked',
    deskBase: 'rgb(76 68 62)',
    paperGrain: '0.6',
    paperBlend: 'screen',
    paperInvert: '1',
    follows: 'dark',
    name: 'Forest',
    transitionScaleFactor: 1.4,
    icons: {
      checked: 'leaf-filled',
      unchecked: 'leaf',
    },
  },
} as const satisfies Record<string, ThemeSettings>;

type ThemeId = keyof typeof THEMES;

const OS_THEMES = {
  light: THEMES.light,
  dark: THEMES.dark,
} as const;

const deskWood = (settings: ThemeSettings) => `
      --theme-desk-tile: url("/desk/${settings.deskWood}.webp");${settings.deskBase ? `
      --theme-desk-base: ${settings.deskBase};
      --theme-desk-blend: difference;
      --theme-desk-veil-blend: color;` : ''}`;

const themeVars = (settings: ThemeSettings) => `
      --theme-canvas: ${settings.canvas};
      --theme-ink: ${settings.ink};
      --theme-accent: ${settings.accent};
      --theme-blueprint: ${settings.blueprint};
      --theme-desk: ${settings.desk};
      --theme-desk-grain: ${settings.deskGrain};${deskWood(settings)}
      --theme-paper-grain: ${settings.paperGrain};
      --theme-paper-blend: ${settings.paperBlend};
      --theme-paper-invert: ${settings.paperInvert};
      --theme-mode: ${settings.follows};
      --accent-text: ${settings.follows === 'dark' ? 'var(--accent-9)' : 'oklch(from var(--theme-accent) 0.42 c h)'};
`;

/* Match the radios by id. Naming an attribute inside :has() puts every input in the
   document into the invalidation set for :root, so any `value` or `name` write
   anywhere restyled the whole page. */
const themeInputId = (id: string) => `theme-${id}`;
const themeChecked = (id: string) => `#${themeInputId(id)}:is(:not(.with-transition):checked, .with-transition.checked)`;
const ANY_THEME_CHECKED = Object.keys(THEMES).map(themeChecked).join(', ');

/* Theme application mirrors the original radio/.checked contract so view
   transitions keep working; data-theme is an extra early-paint / persistence path. */
const THEMES_CSS = `${Object.entries(OS_THEMES).map(([id, settings]) => (
  `  @media (prefers-color-scheme: ${id}) {
    :root:not([data-theme]):not(:has(${ANY_THEME_CHECKED})) {
${themeVars(settings)}
      --theme-kind: ${id};
    }
  }`
)).join('\n\n')}
${Object.entries(THEMES).map(([id, settings]) => `
  :root[data-theme="${id}"],
  :root:has(${themeChecked(id)}) {
    --theme-kind: ${id};
${themeVars(settings)}

    body {
      color-scheme: only ${settings.follows};
    }
  }`).join('\n')}
`;

const THEME_IDS = Object.keys(THEMES) as ThemeId[];

/* How the picker behaves below 52rem, where it sits over the content and there
   is no hover to lean on. `compact` only trims the chrome, `autohide` also
   slides away while scrolling down, `collapse` also shows just the active
   theme until tapped. Append ?theme-picker=<mode> to compare them on device. */
const DEFAULT_MOBILE_MODE: 'compact' | 'autohide' | 'collapse' = 'compact';
---

<div id="theme-picker-transition-background" />

<aside id="theme-picker" aria-label="Theme" data-mobile-mode={DEFAULT_MOBILE_MODE}>
  {THEME_IDS.map((id) => {
    const settings = THEMES[id];
    return (
      <label class="bypass-contrast-check">
        <input type="radio" id={themeInputId(id)} name="theme" value={id} class="sr-only" />
        <Icon name={settings.icons.unchecked} class="unchecked" aria-hidden="true" />
        <Icon name={settings.icons.checked} class="checked" data-theme-transition-scale-factor={settings.transitionScaleFactor} aria-hidden="true" />
        <span>{settings.name}</span>
      </label>
    );
  })}
</aside>

<style lang="scss">
aside {
  padding: 0.75em;
  $border: 2px solid var(--accent-muted);
  border-left: $border;
  border-bottom: $border;
  border-bottom-left-radius: 1em;

  display: inline-block;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 10;

  color: var(--ink-faint);
  background: var(--surface-raised);

  &:hover,
  &:focus-within {
    color: var(--ink);
    background: color-mix(in oklch, var(--surface-raised), var(--accent) 8%);
  }

  label {
    cursor: pointer;

    &:focus-within {
      outline: 1px solid var(--line-strong);
    }

    display: flex;
    align-items: center;
    gap: 1ch;
    min-height: 1.5rem;
    font-family: monospace, system-ui;
    font-size: 0.8125rem;

    & + & {
      margin-top: 0.35em;
    }

    svg {
      display: none;
      width: 1.125em;
      height: 1.125em;
      flex-shrink: 0;
    }

    /* The radio is the only input in a picker label, so it needs no qualifier. */
    &:has(input:checked) svg.checked {
      display: revert;
    }

    &:has(input:not(:checked)) svg.unchecked {
      display: revert;
    }
  }

  @media (max-width: 52rem) {
    padding: 0.15em 0.2em;
    border-width: 1px;
    border-bottom-left-radius: 0.7em;
    color: var(--ink-muted);
    background: color-mix(in oklch, var(--surface-raised), transparent 18%);
    backdrop-filter: blur(6px);
    transition: translate 220ms ease;

    label {
      gap: 0;
      justify-content: center;
      min-width: 1.875rem;
      min-height: 1.875rem;

      span {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
      }

      svg {
        width: 0.9375em;
        height: 0.9375em;
      }
    }
  }
}
</style>

<style is:global set:html={THEMES_CSS} />

<style is:global lang="scss">
@use "@/scss/_colors.scss" as colors;

:root {
  --theme-canvas: oklch(0.99 0.006 85);
  --theme-ink: oklch(0.24 0.025 260);
  --theme-accent: oklch(0.7 0.13 65);
  --theme-blueprint: oklch(0.52 0.14 255);
  --theme-desk: oklch(0.76 0.05 68);
  --theme-desk-grain: 0.85;
  --theme-desk-tile: url("/desk/oak-7760-limed.webp");
  --theme-paper-grain: 0.5;
  --theme-paper-grain: 0.7;
  --theme-paper-blend: multiply;
  --theme-paper-invert: 0;
  --theme-mode: light;
  --theme-kind: light;

  @include colors.color-variables;

  color-scheme: light dark;

  body {
    color: var(--ink);
    background: var(--surface-page);
    accent-color: var(--control-accent);
  }
}

/* Opt the document into a named VT only while switching themes.
   Old/new default fades are disabled so the JS clip-path wipe is the only motion. */
html.theme-transition {
  view-transition-name: theme-transition;
}

::view-transition-group(theme-transition) {
  animation-duration: 0.5s;
}

::view-transition-old(theme-transition),
::view-transition-new(theme-transition) {
  animation: none;
  mix-blend-mode: normal;
  height: 100%;
  width: 100%;
}

::view-transition-old(theme-transition) {
  z-index: 1;
}

::view-transition-new(theme-transition) {
  z-index: 2;
}

#theme-picker-transition-background {
  position: fixed;
  inset: 0;
  background: var(--surface-page);
  z-index: -1;
}
</style>

<script>
import { transformPath, pathDataToString } from '@/client/svg-utils';

const STORAGE_KEY = 'cv-theme';

let pathDataPolyfill: Promise<void> | null = null;
function ensurePathData() {
  if ('getPathData' in SVGPathElement.prototype) return Promise.resolve();
  pathDataPolyfill ??= import('path-data-polyfill').then(() => undefined);
  return pathDataPolyfill;
}

const inputs = [...document.querySelectorAll<HTMLInputElement>('#theme-picker input')];
const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

let activeTransition: ViewTransition | null = null;

const syncRadios = (id: string) => {
  inputs.forEach((input) => {
    const active = input.value === id;
    input.checked = active;
    input.classList.toggle('checked', active);
  });
};

const persistTheme = (id: string) => {
  document.documentElement.dataset.theme = id;
  try {
    localStorage.setItem(STORAGE_KEY, id);
  } catch {
    /* ignore */
  }
};

const stored = (() => {
  try {
    return localStorage.getItem(STORAGE_KEY);
  } catch {
    return null;
  }
})();

/* Restore persisted choice. Otherwise leave radios unchecked so OS prefers-color-scheme CSS wins (same as original). */
if (stored && inputs.some((input) => input.value === stored)) {
  syncRadios(stored);
  document.documentElement.dataset.theme = stored;
} else {
  document.documentElement.removeAttribute('data-theme');
}

inputs.forEach((inputEl) => {
  if (!prefersReducedMotion.matches) {
    inputEl.classList.add('with-transition');
  }

  inputEl.addEventListener('input', () => {
    const id = inputEl.value;

    const commitTheme = () => {
      syncRadios(id);
      persistTheme(id);
    };

    /* --theme-kind tracks whatever is on screen, including the OS default
       nobody has picked yet, so it also catches the first click on it. */
    const shown = getComputedStyle(document.documentElement).getPropertyValue('--theme-kind').trim();

    /* A backgrounded tab gets no rendering opportunities, so a transition started
       there never ends: it keeps the pseudo-element overlay up and swallows every
       later click. Nobody can see it anyway. */
    const hidden = () => document.visibilityState !== 'visible';

    if (prefersReducedMotion.matches || !document.startViewTransition || shown === id || hidden()) {
      commitTheme();
      return;
    }

    activeTransition?.skipTransition();
    document.documentElement.classList.add('theme-transition');

    /* Commit inside the callback, not after `finished`: a transition that stalls
       must not cost the pick. `data-theme` and `.with-transition.checked` select
       the same variables, so they can be written together. */
    const viewTransition = document.startViewTransition(commitTheme);
    activeTransition = viewTransition;

    const skipIfHidden = () => {
      if (hidden()) viewTransition.skipTransition();
    };
    document.addEventListener('visibilitychange', skipIfHidden);

    viewTransition.ready.then(async () => {
      await ensurePathData();

      const label = inputEl.parentElement;
      if (!label) {
        console.debug('[theme-transition] missing label');
        return;
      }

      /* Find the checked SVG icon within the label */
      const svg = Array.from(label.querySelectorAll<SVGSVGElement>('svg')).find((el) => el.classList.contains('checked'));
      if (!svg) {
        console.debug('[theme-transition] missing checked icon');
        return;
      }

      const path = svg.querySelector<SVGPathElement>('path');
      if (!path || typeof path.getPathData !== 'function') {
        console.debug('[theme-transition] path/getPathData unavailable');
        return;
      }

      /* astro-icon puts the viewBox on the outer <svg> and leaves the sprite
         <symbol> without one; older output had it the other way round. */
      const symbol = svg.querySelector<SVGSymbolElement>('symbol');
      const viewBox = [symbol?.viewBox.baseVal, svg.viewBox?.baseVal].find((box) => box && box.width > 0);
      if (!viewBox) {
        console.debug('[theme-transition] invalid viewBox');
        return;
      }

      /* VT overlay coords are viewport-relative — do not add scrollY. */
      const rect = svg.getBoundingClientRect();
      /* Normalize to absolute M/C/L/Z so relative-first paths (e.g. snowflake)
         are not interpreted from the viewport origin in clip-path: path(). */
      const pathData = path.getPathData({ normalize: true });
      const scaleFactor = +(svg.dataset.themeTransitionScaleFactor ?? '1');
      const size = Math.hypot(window.innerWidth, window.innerHeight) * scaleFactor;
      const cx = rect.x + rect.width / 2;
      const cy = rect.y + rect.height / 2;

      const startPathData = transformPath(pathData, viewBox, {
        x: rect.x,
        y: rect.y,
        width: rect.width,
        height: rect.height,
      });
      const endPathData = transformPath(pathData, viewBox, {
        x: cx - size,
        y: cy - size,
        width: size * 2,
        height: size * 2,
      });

      document.documentElement.animate(
        [
          { clipPath: `path("${pathDataToString(startPathData)}")` },
          { clipPath: `path("${pathDataToString(endPathData)}")` },
        ],
        {
          duration: 500,
          easing: 'ease-in',
          pseudoElement: '::view-transition-new(theme-transition)',
        },
      );
    }).catch((error) => {
      console.debug('[theme-transition] clip-path setup failed', error);
    });

    viewTransition.finished.finally(() => {
      document.removeEventListener('visibilitychange', skipIfHidden);
      /* A newer pick owns the page by now; its own cleanup will run. */
      if (activeTransition !== viewTransition) return;
      activeTransition = null;
      document.documentElement.classList.remove('theme-transition');
    });
  }, { passive: true });
});

/* The wipe captures <html>, so while it runs every point in the viewport hit-tests to
   the root and a click on the picker never reaches it. Resolve the point ourselves. */
document.addEventListener('pointerdown', (event) => {
  if (!activeTransition) return;

  const covers = (rect: DOMRect) => event.clientX >= rect.left && event.clientX <= rect.right
    && event.clientY >= rect.top && event.clientY <= rect.bottom;
  /* The sr-only radio sits a hair outside its label, so test both boxes. */
  const picked = inputs.find((input) => covers(input.parentElement!.getBoundingClientRect())
    || covers(input.getBoundingClientRect()));
  if (!picked || picked.checked) return;

  picked.checked = true;
  picked.dispatchEvent(new Event('input', { bubbles: true }));
});
</script>

