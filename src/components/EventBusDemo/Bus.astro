---
import { Icon } from 'astro-icon/components';

import { EVENT, RESIZE_EVENT, attachments, defaultAttachment, dispatch, listeners, resize, resizers, type EventResult } from './events';

type Props = {
  /** Wire the bus up to the client script and the walkthrough. */
  live?: boolean;
  /** Which attachment the emitter is showing. */
  attachment?: string;
  /** Modules drawn as not loaded, off the rail. */
  disabled?: readonly string[];
  /** Draw the tray of modules that are switched off; a page that never switches one can drop it. */
  tray?: boolean;
  /** Draw the line under the emitter that says what a listener is. */
  caption?: boolean;
  /** Draw the template that raised the event, with the branch it takes; $res stays either way. */
  branch?: boolean;
};

const {
  live = false,
  attachment = defaultAttachment,
  disabled = [],
  tray = true,
  caption = true,
  branch = true,
} = Astro.props;

const enabled = (module: string) => !disabled.includes(module);
const outcome = dispatch(attachment, enabled);
const resized = resize(enabled);
const current = attachments.find((entry) => entry.id === attachment) ?? attachments[0];

// The server draws the settled state, so the sheet reads the same before the script runs,
// without it, and on the blueprint pages that quote it.
const resultOf = (index: number): EventResult | 'skipped' => outcome.results[index] ?? 'skipped';
const loaded = listeners.map((listener, index) => ({ listener, index })).filter(({ listener }) => enabled(listener.module));
const unloaded = listeners.map((listener, index) => ({ listener, index })).filter(({ listener }) => !enabled(listener.module));
// The template's own branch runs when no listener appended a block.
const branchTaken = outcome.rendered === 'link';
const attachmentIcon = { jpeg: 'lucide:image', mp4: 'lucide:film', ogg: 'lucide:music', gif: 'lucide:image-play' } as const;
const resizeLabel = { true: 'true', unused: 'not called', off: 'off' } as const;
---

<div
  class="event-bus"
  data-live={live ? '' : undefined}
  data-attachment={current.id}
  data-result={outcome.result}
  data-rendered={outcome.rendered}
  data-thumbnail={resized.by ?? undefined}
  data-stage="view"
  tabindex={live ? -1 : undefined}
>
  <div class="emitter">
    {live ? (
      <button type="button" class="call" data-dispatch title="Dispatch again">
        <Icon name="lucide:play" class="replay" aria-hidden="true" focusable="false" />
        <code data-stage="view">Event::handle('<b>{EVENT}</b>', [$vars, &amp;$res])</code>
        <code data-stage="resize">Event::handle('<b>{RESIZE_EVENT}</b>', [&amp;$event_map, $mimetype])</code>
      </button>
    ) : (
      <span class="call">
        <code>Event::handle('<b>{EVENT}</b>', [$vars, &amp;$res])</code>
      </span>
    )}

    {caption && (
      <p class="caption">
        <span data-stage="view">
          Each listener is <code>[Module, 'on{EVENT}']</code>, in the order the modules were found
        </span>
        <span data-stage="resize">
          ImageEncoder's view asks for the GIF's thumbnail, and <code>getOrCreate</code> raises
          this. Each listener is <code>[Module, 'on{RESIZE_EVENT}']</code>
        </span>
      </p>
    )}

    {live && (
      <div class="stages" role="group" aria-label="Event for loop.gif">
        <button type="button" class="stage" data-stage="view" aria-pressed="true">{EVENT}</button>
        <button type="button" class="stage" data-stage="resize" aria-pressed="false">{RESIZE_EVENT}</button>
      </div>
    )}

    <div class="attachments" role="group" aria-label="Attachment">
      {attachments.map((entry) => (
        <button
          type="button"
          class="attachment"
          data-attachment={entry.id}
          aria-pressed={entry.id === current.id ? 'true' : 'false'}
          disabled={!live}
        >
          <Icon name={attachmentIcon[entry.id as keyof typeof attachmentIcon] ?? 'lucide:image'} aria-hidden="true" focusable="false" />
          <span class="filename">{entry.filename}</span>
          <span class="mimetype">{entry.mimetype}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="rail-frame">
    <ol class="chain" aria-label={`Listeners for ${EVENT}, in dispatch order`}>
      <li class="terminal start" aria-hidden="true">
        <span class="port"><span class="node"></span></span>
        <span class="terminal-label">dispatch</span>
      </li>

      {loaded.map(({ listener, index }) => (
        <li class="listener" data-module={listener.module} data-index={index} data-resizes={String(listener.resizes)} data-result={resultOf(index)}>
          <div class="chip">
            <span class="module">{listener.module}</span>
            <span class="meta">prio {listener.priority}</span>
            <button
              type="button"
              class="load"
              aria-pressed="true"
              aria-label={`${listener.module} loaded`}
              disabled={!live}
            >
              <span class="switch"></span>
            </button>
          </div>
          <span class="port"><span class="node"></span></span>
          <span class="result">{resultOf(index)}</span>
        </li>
      ))}

      <li class="terminal end" aria-hidden="true">
        <span class="port"><span class="node"></span></span>
        <span class="terminal-label">returns <code class="returned">{outcome.result}</code></span>
      </li>
    </ol>

    {live && <span class="token" aria-hidden="true" hidden></span>}
  </div>

  <div class="unloaded" data-empty={String(unloaded.length === 0)} hidden={!tray}>
    <span class="unloaded-label">Not loaded</span>
    <ul class="tray">
      {unloaded.map(({ listener, index }) => (
        <li class="listener" data-module={listener.module} data-index={index} data-resizes={String(listener.resizes)} data-result="off">
          <div class="chip">
            <span class="module">{listener.module}</span>
            <span class="meta">prio {listener.priority}</span>
            <button
              type="button"
              class="load"
              aria-pressed="false"
              aria-label={`${listener.module} loaded`}
              disabled={!live}
            >
              <span class="switch"></span>
            </button>
          </div>
          <span class="port"><span class="node"></span></span>
          <span class="result">off</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="emitter-branch" data-branch={String(branch)}>
    {branch && (
    <pre class="branch" data-taken={String(branchTaken)}><code><span class="if">{'{%'} for block in handle_event('{EVENT}', …) {'%}'}</span>
<span class="loop-body">    {'{{'} block | raw {'}}'}</span>
<span class="if">{'{%'} endfor {'%}'}</span>
<span class="if">{'{%'} if not handled {'%}'}</span>
<span class="fallback">    &lt;a href="{'{{'} attachment.getShowUrl(note) {'}}'}"&gt;{'{{'} title {'}}'}&lt;/a&gt;</span>
<span class="if">{'{%'} endif {'%}'}</span></code></pre>
    )}
    {branch && (
    <span class="branch-note" data-taken={String(branchTaken)}>
      <span class="when-taken">no block came back, so the template writes its own link</span>
      <span class="when-skipped">a block came back, so the template's link is not written</span>
    </span>
    )}

    {branch && (
    <div class="resize" role="group" aria-label="How the GIF's thumbnail is made">
      <span class="resize-label">then <code>getOrCreate</code> tries the resizers in this order</span>
      <code class="merge">array_merge($event_map['image/gif'], $event_map['image'])</code>
      <ol class="resizers">
        {resizers.map((resizer, index) => (
          <li class="resizer" data-module={resizer.module} data-result={resized.results[index]}>
            <code class="key">'{resizer.key}'</code>
            <span class="method">{resizer.module}::{resizer.method}</span>
            <span class="answer">{resizeLabel[resized.results[index]]}</span>
          </li>
        ))}
      </ol>
      <span class="resize-note">
        Every module handler registers at the same priority, so GNU social orders these by how
        specific the mimetype is.
      </span>
    </div>
    )}

    <figure class="res" aria-live={live ? 'polite' : undefined}>
      <figcaption><span data-stage="view">$res</span><span data-stage="resize">$event_map</span></figcaption>
      <span class="event-map">
        {resizers.map((resizer, index) => (
          <code class="entry" data-module={resizer.module} data-on={String(resized.results[index] !== 'off')}>'{resizer.key}' =&gt; [<span class="callable">{resizer.module}</span>]</code>
        ))}
      </span>
      <span class="rendered" data-kind="pending" aria-hidden="true">…</span>
      <span class="rendered" data-kind="image">
        <Icon name="lucide:image" aria-hidden="true" focusable="false" />
        <span>
          <code>&lt;img class="u-photo"&gt;</code> <span class="by">ImageEncoder</span>
        </span>
      </span>
      <span class="rendered" data-kind="video">
        <Icon name="lucide:circle-play" aria-hidden="true" focusable="false" />
        <span><code>&lt;video controls&gt;</code> <span class="by">VideoEncoder</span></span>
      </span>
      <span class="rendered" data-kind="audio">
        <Icon name="lucide:music" aria-hidden="true" focusable="false" />
        <span><code>&lt;audio controls&gt;</code> <span class="by">AudioEncoder</span></span>
      </span>
      <span class="rendered" data-kind="link">
        <Icon name="lucide:link" aria-hidden="true" focusable="false" />
        <span><u class="link-text">{current.filename}</u> <span class="by">attachment.html.twig</span></span>
      </span>
    </figure>
  </div>
</div>

<style lang="scss">
/* 1em here is the sheet's body type at this scale, so every measurement below scales
   with the page. */
.event-bus {
  --chip-inline: 10.5em;
  --rail: var(--line-strong);
  --stop: var(--accent);

  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.75em;
  align-content: center;
  outline: none;
  container-type: inline-size;
  container-name: event-bus;

  font-family: var(--font-poppins), system-ui, sans-serif;
  /* A landscape sheet under 423px tall held the type at its 0.6875rem floor while the sheet
     kept shrinking, and the column of stages ran past its bottom edge. Under 367px tall the
     type follows the sheet's height instead. */
  font-size: min(clamp(0.6875rem, 0.026 * min(var(--sheet-inline), var(--sheet-block)), 1.0625rem), 0.03 * var(--sheet-block));
  line-height: 1.35;
  color: var(--ink);

  :global([data-sheet-orientation='portrait']) & {
    /* A page that quotes the bus beside other things can hand it a smaller size. */
    font-size: var(--bus-portrait-font, clamp(0.625rem, min(0.029 * var(--sheet-inline), 0.018 * var(--sheet-block)), 0.9375rem));
  }
}

code,
pre {
  font-family: monospace, system-ui;
}

button {
  font: inherit;
  color: inherit;
}

/* The emitter: the call, which replays the dispatch, and the attachment it is about. */
.emitter {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5em 1em;
}

.call {
  display: inline-flex;
  align-items: center;
  gap: 0.5em;
  min-width: 0;
  padding: 0.375em 0.625em;
  border: 1px solid var(--line-strong);
  border-radius: 0.375em;
  background: var(--surface-raised);
  font-size: 0.875em;
  overflow-wrap: anywhere;

  b {
    color: var(--accent-text);
    font-weight: 600;
  }

  .replay {
    flex: none;
    width: 1em;
    height: 1em;
    color: var(--ink-muted);
  }
}

button.call {
  cursor: pointer;

  &:hover .replay,
  &:focus-visible .replay {
    color: var(--accent);
  }
}

.attachments {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375em;
}

/* The words that belong to one event show only while the sheet dispatches that one. */
.event-bus[data-stage='view'] :is(.call, .caption, figcaption) > [data-stage='resize'],
.event-bus[data-stage='resize'] :is(.call, .caption, figcaption) > [data-stage='view'] {
  display: none;
}

/* The GIF has two events to pick from: the view, and the thumbnail request inside it. */
.stages {
  order: 4;
  flex-basis: 100%;
  display: none;
  flex-wrap: wrap;
  gap: 0.375em;
}

.event-bus[data-attachment='gif'] .stages {
  display: flex;
}

.stage {
  padding: 0.25em 0.625em;
  border: 1px solid var(--line);
  border-radius: 0.375em;
  background: var(--surface-sunken);
  font-family: monospace, system-ui;
  font-size: max(0.5rem, 0.75em);
  color: var(--ink-muted);
  cursor: pointer;

  &[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent-text);
    font-weight: 600;
  }
}

.caption {
  order: 3;
  flex-basis: 100%;
  margin: 0;
  font-size: max(0.5rem, 0.6875em);
  color: var(--ink-muted);
}

.attachment {
  display: grid;
  grid-template-columns: auto auto;
  grid-template-rows: auto auto;
  column-gap: 0.375em;
  align-items: center;
  padding: 0.25em 0.625em;
  border: 1px solid var(--line);
  border-radius: 0.375em;
  background: var(--surface-sunken);
  text-align: left;
  cursor: pointer;

  &:disabled {
    cursor: default;
  }

  svg {
    grid-row: span 2;
    width: 1.125em;
    height: 1.125em;
    color: var(--ink-muted);
  }

  .filename {
    font-size: 0.8125em;
    font-weight: 600;
  }

  .mimetype {
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.6875em);
    color: var(--ink-muted);
  }

  &[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px var(--accent);

    svg {
      color: var(--accent);
    }
  }
}

/* The rail: a start terminal, one stop per loaded listener, and the return. Each stop
   draws its own stretch of line through its port, and the stops sit flush, so the line
   reads as one. On a narrow sheet the whole chain turns to run down the page. */
.rail-frame {
  position: relative;
}

.chain {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  align-items: stretch;
}

.chain > li {
  position: relative;
  display: grid;
  /* Fixed rows under the chips, so every port, the terminals' included, sits on one line. */
  grid-template-rows: 1fr 2.25em 1.5em;
  justify-items: center;
  min-width: 0;
}

.listener {
  flex: 1 1 var(--chip-inline);
}

.terminal {
  flex: 0 0 auto;
  width: 4.5em;
}

.port {
  position: relative;
  grid-row: 2;
  align-self: stretch;
  justify-self: stretch;
  display: grid;
  place-items: center;

  /* The rail itself, across the whole stop. */
  &::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 2px solid var(--rail);
    translate: 0 -1px;
  }

  /* The stem from the chip down to the rail. */
  .listener > &::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 50%;
    left: 50%;
    border-left: 1px solid var(--rail);
  }
}

.start .port::after {
  left: 50%;
}

.end .port::after {
  right: 50%;
}

.node {
  position: relative;
  z-index: 1;
  width: 0.625em;
  height: 0.625em;
  border: 2px solid var(--rail);
  border-radius: 50%;
  background: var(--surface-page);
  box-sizing: border-box;
}

.terminal .node {
  width: 0.875em;
  height: 0.875em;
  border-radius: 0.125em;
  background: var(--rail);
}

.terminal-label {
  grid-row: 3;
  font-size: max(0.5rem, 0.6875em);
  color: var(--ink-muted);
  text-align: center;

  code {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }
}

.event-bus[data-result='stop'] .returned {
  color: var(--stop);
}

.chip {
  grid-row: 1;
  align-self: end;
  position: relative;
  box-sizing: border-box;
  width: calc(100% - 0.75em);
  max-width: var(--chip-inline);
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.125em 0.5em;
  padding: 0.5em 0.625em;
  border: 1px solid var(--line-strong);
  border-radius: 0.375em;
  background: var(--surface-raised);
  transition:
    border-color 0.2s ease,
    opacity 0.2s ease,
    box-shadow 0.2s ease;

  .module {
    font-weight: 600;
    font-size: 0.875em;
  }

  .meta {
    grid-column: 1;
    font-family: monospace, system-ui;
    font-size: max(0.5rem, 0.6875em);
    color: var(--ink-muted);
  }

  .load {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }
}

/* The load switch: a module that is off is not in the container, so it never hears
   the event. */
.load {
  padding: 0.25em;
  margin: -0.25em;
  border: 0;
  background: none;
  cursor: pointer;

  &:disabled {
    cursor: default;
  }

  .switch {
    position: relative;
    display: block;
    width: 1.75em;
    height: 1em;
    border-radius: 0.5em;
    border: 1px solid var(--line-strong);
    background: var(--surface-sunken);
    box-sizing: border-box;
    transition: background-color 0.2s ease;

    &::after {
      content: '';
      position: absolute;
      top: 0.0625em;
      left: 0.0625em;
      width: 0.75em;
      height: 0.75em;
      border-radius: 50%;
      background: var(--ink-muted);
      transition: translate 0.2s ease, background-color 0.2s ease;
    }
  }

  &[aria-pressed='true'] .switch {
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent), transparent 75%);

    &::after {
      translate: 0.75em 0;
      background: var(--accent);
    }
  }
}

/* The answers are lowercase, so the pill centres the x-height band: the line box is
   trimmed to it and the padding is even above and below. Without the trim the line box
   is the font's, whose ascent and descent differ, and the word sits high. The pill keeps
   its own height rather than stretching to the row, or the word sits at the row's top. */
.result {
  grid-row: 3;
  align-self: center;
  padding: 0.0625em 0.5em;

  @supports (text-box-trim: trim-both) {
    padding-block: 0.45em;
    text-box: trim-both ex alphabetic;
  }

  border: 1px solid var(--line);
  border-radius: 1em;
  font-family: monospace, system-ui;
  font-size: max(0.5rem, 0.6875em);
  color: var(--ink-muted);
  background: var(--surface-raised);
}

.listener[data-result='stop'] {
  .chip {
    border-color: var(--stop);
    box-shadow: inset 0 0 0 1px var(--stop);
  }

  .port::before {
    border-left: 2px solid var(--stop);
    translate: -0.5px 0;
  }

  .node {
    border-color: var(--stop);
    background: var(--stop);
  }

  .result {
    border-color: var(--stop);
    color: var(--stop);
    font-weight: 600;
  }
}

.listener[data-result='skipped'] {
  .chip {
    border-style: dashed;
    opacity: 0.45;
  }

  .result {
    border-style: dashed;
    opacity: 0.6;
  }
}

/* Hidden until the token reaches it on a live run, so the answer comes with the event. */
.listener[data-result='pending'] .result {
  visibility: hidden;
}

.listener.hearing .chip {
  border-color: var(--ink);
}

.token {
  position: absolute;
  z-index: 2;
  top: 0;
  left: 0;
  width: 1em;
  height: 1em;
  margin: -0.5em 0 0 -0.5em;
  border-radius: 0.1875em;
  background: var(--ink);
  box-shadow: 0 0 0 0.1875em var(--surface-page);
  pointer-events: none;

  &[hidden] {
    display: none;
  }

  &.stopped {
    background: var(--stop);
  }
}

/* The modules switched off, waiting to be loaded again. */
.unloaded {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.375em 0.75em;
  min-height: 2.5em;
  padding: 0.375em 0.625em;
  border: 1px dashed var(--line);
  border-radius: 0.375em;

  &[data-empty='true'] .unloaded-label::after {
    content: ': none';
  }

  &[hidden] {
    display: none;
  }
}

.unloaded-label {
  font-size: max(0.5rem, 0.6875em);
  color: var(--ink-faint);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.tray {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5em;

  .listener {
    flex: 0 0 auto;
    padding: 0;
  }

  .chip {
    width: var(--chip-inline);
    border-style: dashed;
    background: transparent;

    .module,
    .meta {
      opacity: 0.6;
    }
  }

  .port,
  .result {
    display: none;
  }
}

/* The template that raised the event, templates/cards/blocks/attachment.html.twig, and what
   $res ended up holding. */
.emitter-branch {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-areas:
    'branch res'
    'note res';
  gap: 0.25em 1em;
  align-items: center;

  /* Without the template, $res stands alone at the start of the row. */
  &[data-branch='false'] {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'res';
  }
}

.branch {
  grid-area: branch;
  margin: 0;
  padding: 0.5em 0.75em;
  border: 1px solid var(--line);
  border-radius: 0.375em;
  background: var(--surface-sunken);
  font-size: max(0.5rem, 0.75em);
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;

  .loop-body,
  .fallback {
    transition: opacity 0.2s ease;
  }

  /* Whichever line the template does not run is struck through: the loop's body when
     nothing came back, the link when a block did. */
  &[data-taken='false'] .fallback,
  &[data-taken='true'] .loop-body {
    opacity: 0.4;
    text-decoration: line-through;
    text-decoration-color: var(--stop);
  }

  &[data-taken='true'] .fallback,
  &[data-taken='false'] .loop-body {
    color: var(--accent-text);
    font-weight: 600;
  }
}

.branch-note {
  grid-area: note;
  font-size: max(0.5rem, 0.6875em);
  color: var(--ink-muted);

  &[data-taken='true'] .when-skipped,
  &[data-taken='false'] .when-taken,
  &[data-taken='pending'] > * {
    display: none;
  }

  /* Holds its line while a run is out, so the page does not jump when the answer lands. */
  &[data-taken='pending']::before {
    content: '\2026';
  }
}

