---
import Bus from '../Bus.astro';

// The three cases of the enum, and what each one does to the chain. Two are in use: the
// tree returns next some 250 times, stop wherever a handler claims the job, and unhandled
// nowhere.
const results = [
  {
    value: 'next',
    chain: 'chain goes on',
    meaning: 'Not this handler\'s job, or its part is done and others may add theirs. Every encoder answers next to a mimetype that is not its own',
  },
  {
    value: 'stop',
    chain: 'chain halts',
    meaning: 'Claimed the job. Nothing after it hears the event, and $res holds what it appended',
  },
  {
    value: 'unhandled',
    chain: 'chain goes on',
    meaning: 'Declared in the enum, returned by no handler in the tree: a handler with nothing to add says next',
  },
];
---

<div class="wrapper">
  <div class="stop-layer">
    <p class="point">
      <strong>One handler returns <code>Event::stop</code>, and propagation ends there</strong>
      <span>
        AudioEncoder hears the JPEG first and answers next. ImageEncoder claims it and
        appends its view to <code>$res</code>. VideoEncoder never hears the event.
      </span>
    </p>

    {/* inert: the bus's buttons are illustration here, and would otherwise sit in the Tab
        order with nothing to do. */}
    <div class="figure" aria-hidden="true" inert>
      <Bus attachment="jpeg" tray={false} caption={false} branch={false} />
    </div>

    <section class="results" aria-label="The three cases of EventResult">
      <code class="enum">enum EventResult</code>
      <dl>
        {results.map((row) => (
          <div data-result={row.value}>
            <dt><code>case {row.value}</code> <span class="chain">{row.chain}</span></dt>
            <dd>{row.meaning}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include clear-title-block;

  display: grid;
  grid-template-columns: minmax(0, 1fr);
  place-items: center;
  height: 100%;
}

.stop-layer {
  box-sizing: border-box;
  width: 100%;
  max-width: 60em;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.75em;
  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.6875rem, 0.027 * min(var(--sheet-inline), var(--sheet-block)), 1.0625rem);
  color: var(--ink);

  :global([data-sheet-orientation='portrait']) & {
    font-size: clamp(0.625rem, min(0.029 * var(--sheet-inline), 0.018 * var(--sheet-block)), 0.875rem);
  }
}

code {
  font-family: monospace, system-ui;
}

.point {
  margin: 0;
  display: grid;
  gap: 0.125em;

  strong {
    font-size: 0.9375em;
  }

  span {
    font-size: 0.75em;
    color: var(--ink-muted);
    text-wrap: pretty;

    @container technical-drawing-width (max-width: 56em) {
      display: none;
    }
  }
}

.figure {
  --bus-portrait-font: clamp(0.625rem, min(0.029 * var(--sheet-inline), 0.018 * var(--sheet-block)), 0.875rem);

  min-width: 0;
}

.results {
  display: grid;
  gap: 0.375em;
  font-size: 0.6875em;
  line-height: 1.35;

  .enum {
    font-weight: 700;
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5em;
  }

  /* A narrow sheet has the height for the three cases but not for what each one means;
     the bus above already shows stop doing it. */
  @container technical-drawing-width (max-width: 56em) {
    dt {
      flex-direction: column;
      margin: 0;
    }

    dd {
      display: none;
    }
  }

  dl > div {
    padding: 0.375em 0.625em;
    border: 1px solid var(--line);
    border-radius: 0.375em;
    background: var(--surface-raised);
  }

  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5em;
    margin-bottom: 0.125em;

    code {
      font-weight: 700;
    }
  }

  .chain {
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  [data-result='stop'] {
    border-color: var(--accent);

    dt code,
    .chain {
      color: var(--accent-text);
    }
  }
}
</style>
