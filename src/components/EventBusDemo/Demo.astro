---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';

import BusLayer from './layers/BusLayer.astro';
import StopLayer from './layers/StopLayer.astro';
import DiscoveryLayer from './layers/DiscoveryLayer.astro';
import GuardLayer from './layers/GuardLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

const srcRoot = path.join(process.cwd(), 'src');
const clientEntry = path.join(srcRoot, 'components/EventBusDemo/client/eventBus.ts');

const { outputFiles: [clientBundle] } = await esbuild.build({
  entryPoints: [clientEntry],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  alias: { '@': srcRoot },
  // The press layer's own stylesheet ships with the sheet, not with this script.
  loader: { '.css': 'empty' },
});

const clientSize = toKiB(clientBundle.text);

const layers = {
  bus: { name: null },
  stop: { name: 'EventResult', pageStyle: 'blueprint' },
  discovery: { name: 'Module Discovery', pageStyle: 'blueprint' },
  guard: { name: 'Build-Time Guard', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="GNU social · Event Dispatch"
  scale="1:1"
  size={clientSize}
  date="2022"
  tech={['php', 'symfony']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      bus: <BusLayer />,
      stop: <StopLayer />,
      discovery: <DiscoveryLayer />,
      guard: <GuardLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      bus: (
        <PostIt background="#e8e4dc" color="black">
          Hover or focus to take over. Switch a plugin off and the chain closes up around
          it; pick the GIF and see who claims it now
        </PostIt>
      ),
      stop: (
        <PostIt background="#fed" color="black">
          The first handler to return stop ends the dispatch. The emitter asks one
          question of the result, and skips its own default when the answer is stop
        </PostIt>
      ),
      discovery: (
        <PostIt background="#cde" color="black">
          Nothing registers a listener by hand. Name a public method on&lt;Event&gt; and
          the container build wires it up
        </PostIt>
      ),
      guard: (
        <PostIt background="#dfd" color="black">
          A plugin with the wrong signature never reaches a request: the build that would
          wire it up refuses to finish
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
