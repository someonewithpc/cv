---
import Grid from '../Grid.astro';
import { defaultProperty, properties, walkthrough } from '../objects';
---

<div
  class="tagging-grid-demo"
  data-walkthrough={JSON.stringify(walkthrough)}
  data-tagging-grid-demo
>
  {/* Demo-only, so beside the tool and not in it. The product renames the schema in
      this spot; the picker is what makes the page worth showing on its own, since the
      stored values change with the schema. The product also drops a fully tagged object
      from the list, and the note offers it back so the sheet doesn't end up empty. */}
  <div class="demo-controls">
    <label>
      Property
      <select class="property-select" aria-label="Property schema">
        {properties.map((entry) => (
          <option value={entry.id} selected={entry.id === defaultProperty}>{entry.name}</option>
        ))}
      </select>
    </label>
    <p class="demo-note" hidden>
      <span class="hidden-count"></span>
      <button type="button" class="demo-reset">Bring them back</button>
    </p>
  </div>

  <Grid live />

  {/* The walkthrough's stand-in pointer. It sits outside the tool, which clips its
      own overflow, so the tip still reads at a field on the panel's edge. */}
  <div class="tagging-cursor" aria-hidden="true" hidden>
    <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
      <path
        d="M4 2.5v24.2l6.4-6.2 4.1 9.7 4.2-1.8-4.1-9.6H26z"
        fill="#fff"
        stroke="#222"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-tagging-grid-demo]', boot);
</script>

<style lang="scss">
@use '@/scss/demo-cursor' as cursor;
@use "./sheet" as *;

:global(article.technical-drawing-stack > * > section .content:has(.tagging-grid-demo)) {
  place-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
  padding-block: 0.5em;
}

.tagging-grid-demo {
  @include sheet-content;

  position: relative;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.5rem;
  /* A definite height, so the tool's rows resolve against the sheet rather than
     against their own content. */
  height: 100%;
  min-height: 0;
}

.tagging-grid-demo > :global(.tagging-tool) {
  flex: 1 1 0;
  min-height: 0;
}

.demo-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5em 1.5em;
  font-size: clamp(0.625rem, 0.02 * min(var(--sheet-inline), var(--sheet-block)), 0.875rem);
  font-family: monospace, system-ui;
  color: var(--ink-muted);

  label {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 700;
  }

  .property-select {
    box-sizing: border-box;
    min-width: 0;
    width: 12em;
    padding: 0.25em 0.5em;
    border: 1px solid var(--line);
    border-radius: 0.5em;
    background: var(--surface-page);
    color: var(--ink);
    font: inherit;
    font-weight: 400;

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }
  }
}

.demo-note {
  margin: 0;

  &[hidden] {
    display: none;
  }

  .demo-reset {
    margin-left: 0.5em;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-text);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
}

/* The title block lies over the tool's bottom-right corner, so the rows scroll on past it
   by the block's height and the last one can be read clear of it. Portrait gives the block
   a row of its own. */
:global(article.technical-drawing-stack) .tagging-grid-demo :global(.tagging-tool > .body) {
  padding-bottom: calc(var(--gutter) + var(--title-block-block, 0px));

  @container technical-drawing (orientation: portrait) {
    padding-bottom: var(--gutter);
  }
}

.tagging-cursor {
  @include cursor.driven($glide: 0.52s cubic-bezier(0.22, 1, 0.36, 1), $click-scale: 0.85, $drag-scale: null);
  z-index: 3;
  width: 2em;
  height: 2em;
  /* The click pulse scales around the arrow tip so the tip stays on the aimed point. */
  transform-origin: 12% 8%;
  pointer-events: none;

  &[hidden] {
    display: none;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
  }
}

@media (prefers-reduced-motion: reduce) {
  .tagging-cursor:not([data-full-motion] *) {
    transition: none;
  }
}
</style>
