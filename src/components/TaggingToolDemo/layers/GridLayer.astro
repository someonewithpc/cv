---
import Grid from '../Grid.astro';
import { walkthrough } from '../objects';
---

<div
  class="tagging-grid-demo"
  data-walkthrough={JSON.stringify(walkthrough)}
  data-boot-module="/src/components/TaggingToolDemo/client/boot.ts"
>
  <Grid live />

  {/* The walkthrough's stand-in pointer. It sits outside the tool, which clips its
      own overflow, so the tip still reads at a field on the panel's edge. */}
  <div class="tagging-cursor" aria-hidden="true" hidden>
    <svg viewBox="0 0 32 32" width="32" height="32">
      <path
        d="M4 2.5v24.2l6.4-6.2 4.1 9.7 4.2-1.8-4.1-9.6H26z"
        fill="#fff"
        stroke="#222"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</div>

{/*
  No <script> here — a component reached only through Stack.astro's per-layer
  Astro.slots.render() call never gets its own hoisted script onto the page (see the
  "dev-server-drops-demo-scripts" memory). boot.ts is armed instead by Stack.astro's own
  script, which the pagination doesn't touch, via the data-boot-module attribute above —
  this also defers loading and running taggingTool.ts until the stack scrolls into view,
  same as every other demo's island.
*/}

<style lang="scss">
:global(article.technical-drawing-stack > * > section .content:has(.tagging-grid-demo)) {
  place-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
  padding-block: 0.5em;
}

.tagging-grid-demo {
  position: relative;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  /* A definite height, so the tool's max-height resolves and it scrolls
     inside the sheet instead of running out from under the title block. */
  height: 100%;
  min-height: 0;

  @container technical-drawing-width (max-width: 56em) {
    /* The title block claims the bottom-right corner on a narrow sheet. */
    padding-bottom: 3.5em;
  }

  @container technical-drawing (orientation: portrait) {
    /* Portrait gives the title block its own row. */
    padding-bottom: 0;
  }
}

.tagging-cursor {
  position: absolute;
  z-index: 3;
  width: 2em;
  height: 2em;
  /* Hotspot at the arrow tip, and the click pulse scales around it so the tip
     stays on the aimed point. */
  translate: -12% -8%;
  transform-origin: 12% 8%;
  pointer-events: none;
  transition:
    left 0.52s cubic-bezier(0.22, 1, 0.36, 1),
    top 0.52s cubic-bezier(0.22, 1, 0.36, 1),
    scale 0.12s ease;

  &[hidden] {
    display: none;
  }

  &.clicking {
    scale: 0.85;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
  }
}

@media (prefers-reduced-motion: reduce) {
  .tagging-cursor {
    transition: none;
  }
}
</style>
