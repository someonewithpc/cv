---
import Grid from '../Grid.astro';
---

<div class="wrapper">
  {/* inert: aria-hidden alone doesn't pull the embedded Grid's real inputs/buttons out
      of the Tab order, so a keyboard user would land on illustration-only controls a
      screen reader stays silent about. Same fix as EditorLayer.astro's inert embed. */}
  <div class="missing-layer" aria-hidden="true" inert>
    <Grid completing="round" only={['round']} />

    <dl class="legend">
      <div>
        <dt>List</dt>
        <dd>The page lists only objects still missing the property, base or any variant, thirty at a time with more on scroll</dd>
      </div>
      <div>
        <dt>Leave</dt>
        <dd>Filling an object's last gap removes it from the page. This row is halfway out</dd>
      </div>
      <div>
        <dt>Save</dt>
        <dd>Change or Enter writes one row per object, <code>find_or_initialize_by</code> then <code>save!</code>. An emptied field destroys the row instead of keeping <code>""</code></dd>
      </div>
    </dl>
  </div>
</div>

<style lang="scss">
.wrapper {
  box-sizing: border-box;
  width: 100%;
  max-width: min(92cqw, 100%);
  margin-inline: auto;
  display: grid;
  place-items: center;

  @container technical-drawing-width (max-width: 56em) {
    /* The title block claims the bottom-right corner on a narrow sheet, and the
       legend's last column was running under it. The wrapper centres what it holds,
       so this has to cover the corner twice over. */
    padding-bottom: 5em;
  }

  @container technical-drawing (orientation: portrait) {
    padding-bottom: 0;
  }
}

.missing-layer {
  width: 100%;
  max-width: 44em;
  display: grid;
  gap: 0.625em;
  font-family: var(--font-poppins), system-ui, sans-serif;
  /* A short landscape sheet has to hold the grid, the legend and the title block's
     corner, so the floor goes down to where all three still fit. */
  font-size: clamp(0.625rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)), 1rem);
  color: var(--ink);

  :global([data-sheet-orientation='portrait']) & {
    font-size: min(1rem, 0.023 * min(var(--sheet-inline), var(--sheet-block)));
  }

  :global(.tagging-tool) {
    font-size: 0.75em;
    pointer-events: none;

    @container technical-drawing-width (max-width: 56em) {
      /* Two cards across cost the height four across saved, and this sheet has none
         to give: the grid pays the difference so the legend clears the title block. */
      font-size: 0.6875em;
    }

    @container technical-drawing (orientation: portrait) {
      font-size: 0.75em;
    }
  }

  /* The live page hands the tool a sheet's worth of height to divide up; here the grid
     is an illustration under a legend, so it takes what the card gives it. */
  :global(.thumbnail-image-container) {
    min-height: 0;

    @container technical-drawing-width (max-width: 56em) {
      /* A short landscape sheet has no height to spare: cap the picture so the legend
         below it stays on the paper. */
      max-height: 5.5em;
    }

    @container technical-drawing (orientation: portrait) {
      max-height: none;
    }
  }

  /* A fixed run, not the live grid's auto-fill: one base object and its three variants
     read as one row here, rather than wrapping a lone card onto a second line. Four
     across only survives a wide sheet; below that a card is too narrow to hold the
     value it is meant to show. */
  :global(.shared-properties) {
    grid-template-columns: repeat(4, minmax(0, 1fr));

    @container technical-drawing-width (max-width: 56em) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
}

.legend {
  margin: 0;
  display: grid;
  /* Three across while each column still holds a line of prose, then two, then one. */
  grid-template-columns: repeat(auto-fit, minmax(11em, 1fr));
  gap: 0.625em;

  div {
    display: flex;
    flex-direction: column;
    gap: 0.125em;
  }

  dt {
    font-family: monospace, system-ui;
    font-size: 0.625em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    font-size: 0.6875em;
    line-height: 1.35;
    text-wrap: pretty;
  }

  code {
    font-family: monospace, system-ui;
  }
}
</style>
