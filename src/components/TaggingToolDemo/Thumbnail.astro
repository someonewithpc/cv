---
import type { Art } from './objects';

type Props = { art: Art; hue: number };

const { art, hue } = Astro.props;
---

<svg class="thumb" viewBox="0 0 32 32" aria-hidden="true" style={{ '--hue': hue }}>
  {art === 'chiavari' && (
    <Fragment>
      <path class="line" d="M9 4v24M23 4v24M9 8h14M9 12h14M9 16h14" />
      <rect class="seat" x="6" y="19" width="20" height="4" rx="1" />
      <path class="line" d="M7 23l-1 6M25 23l1 6" />
    </Fragment>
  )}
  {art === 'banquet' && (
    <Fragment>
      <path class="seat" d="M8 5h16a2 2 0 0 1 2 2v9H6V7a2 2 0 0 1 2-2z" />
      <rect class="seat" x="5" y="17" width="22" height="5" rx="1.5" />
      <path class="line" d="M7 22v7M25 22v7M9 29h4M19 29h4" />
    </Fragment>
  )}
  {art === 'stool' && (
    <Fragment>
      <ellipse class="seat" cx="16" cy="8" rx="9" ry="3.5" />
      <path class="line" d="M9 10l-2 19M23 10l2 19M8.5 22h15" />
    </Fragment>
  )}
  {art === 'trestle' && (
    <Fragment>
      <rect class="seat" x="2" y="9" width="28" height="4" rx="1" />
      <path class="line" d="M9 13l-4 15M9 13l4 15M23 13l-4 15M23 13l4 15M6.5 22h5M20.5 22h5" />
    </Fragment>
  )}
</svg>

<style lang="scss">
.thumb {
  display: block;
  width: 100%;
  height: 100%;
  color: var(--ink-muted);

  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .seat {
    fill: oklch(0.72 0.11 var(--hue));
    stroke: currentColor;
    stroke-width: 1;
  }
}
</style>
