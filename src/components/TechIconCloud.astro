---
import TechIcon from '@/components/TechIcon.astro';

import { TECH_ICONS } from '@/server/tech-icons';

const hardwareCount = TECH_ICONS.filter((tech) => tech.hardware).length;
const softwareCount = TECH_ICONS.length - hardwareCount;
---

<section id="bill-of-materials" aria-labelledby="tech-icon-cloud-label" tabindex="-1">
  <p id="tech-icon-cloud-label" class="cloud-label monospace">Bill of materials</p>

  <div class="filter-bar">
    <fieldset class="filter-toggle">
      <legend class="sr-only">Filter by category</legend>
      <div class="filter-toggle-track">
        <input type="radio" name="tech-filter" id="tech-filter-all" checked>
        <label for="tech-filter-all">All</label>
        <input type="radio" name="tech-filter" id="tech-filter-software">
        <label for="tech-filter-software">Software</label>
        <input type="radio" name="tech-filter" id="tech-filter-hardware">
        <label for="tech-filter-hardware">Hardware &amp; CAD</label>
      </div>
    </fieldset>
    <p class="filter-count monospace" role="status">
      <span class="count-all">{TECH_ICONS.length} skills</span>
      <span class="count-software">{softwareCount} software</span>
      <span class="count-hardware">{hardwareCount} hardware &amp; CAD</span>
    </p>
  </div>

  <ul>
    {TECH_ICONS.map((tech) => (
      <li class:list={[{ hw: tech.hardware }]}>
        <TechIcon tech={tech} decorative />
        <span>{tech.text}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
@use '@/scss/hit-area' as *;
section {
  max-width: 80ch;
  margin-inline: auto;
  margin-top: 1.5rem;
  /* The same inset as the Career sheet; past 64rem the desk's --sheet-pad takes over. */
  padding: var(--page-gap);

  // tabindex="-1": the accesskey's landing spot, not a Tab stop.
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -0.125rem;
  }

  .cloud-label {
    margin: 0 0 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin: 0 0 1.1rem;
  }

  .filter-toggle {
    margin: 0;
    padding: 0;
    min-width: 0;
    border: none;

    .filter-toggle-track {
      $radius: 0.45rem;

      display: inline-flex;
      border: 1px solid var(--line-strong);
      border-radius: $radius;
      font-size: 0.75rem;

      /* The end labels round their own corners, where the track used to clip them, so
         each label's hit box can reach the track's border. */
      label:first-of-type {
        border-start-start-radius: calc(#{$radius} - 1px);
        border-end-start-radius: calc(#{$radius} - 1px);
      }

      label:last-of-type {
        border-start-end-radius: calc(#{$radius} - 1px);
        border-end-end-radius: calc(#{$radius} - 1px);
      }
    }

    input {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    label {
      cursor: pointer;
      padding: 0.4em 0.85em;
      font-family: monospace, system-ui;
      letter-spacing: 0.03em;
      color: var(--ink-faint);
      background: var(--surface-raised);
      user-select: none;
      @include hit-area;

      /* Under 18rem the sheet's padding leaves the three options too little room. */
      @media (max-width: 18rem) {
        padding-inline: 0.5em;
      }

      &:hover {
        color: var(--ink);
      }
    }

    input:not(:first-of-type) + label {
      box-shadow: inset 1px 0 0 var(--line-strong);
    }

    input:checked + label {
      color: color-mix(in oklch, white 90%, var(--blueprint));
      background: color-mix(in oklch, var(--blueprint), black 18%);

      &:hover {
        color: white;
      }
    }

    input:focus-visible + label {
      // Checked option always owns focus in a radio group; --ink contrasts on --blueprint.
      outline: 2px solid var(--ink);
      outline-offset: -2px;
      position: relative;
      z-index: 1;
    }
  }

  .filter-count {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-faint);

    span {
      display: none;
    }
  }

  &:has(#tech-filter-all:checked) .filter-count .count-all {
    display: inline;
  }
  &:has(#tech-filter-software:checked) .filter-count .count-software {
    display: inline;
  }
  &:has(#tech-filter-hardware:checked) .filter-count .count-hardware {
    display: inline;
  }

  ul {
    display: flex;
    justify-content: center;
    gap: 0.5em;
    flex-wrap: wrap;

    @media (max-width: 52rem) {
      gap: 0.4em;
    }
  }

  li {
    padding: 0.375em 0.6em;
    border-radius: 0.55em;
    display: inline-flex;
    gap: 0.75ch;
    align-items: center;

    color: var(--ink);
    background-color: var(--surface-raised);
    border: 1px solid color-mix(in oklch, var(--line-strong), var(--accent-muted) 35%);

    font-family: monospace, system-ui;
    font-size: 0.875rem;
    letter-spacing: 0.02em;

    transition: opacity 0.2s ease, filter 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;

    @media (max-width: 52rem) {
      padding: 0.3em 0.5em;
      font-size: 0.75rem;
      gap: 0.5ch;
    }
  }

  &:has(#tech-filter-software:checked) li.hw {
    opacity: 0.3;
    filter: grayscale(70%);
  }
  &:has(#tech-filter-hardware:checked) li:not(.hw) {
    opacity: 0.3;
    filter: grayscale(70%);
  }
  &:has(#tech-filter-software:checked) li:not(.hw) {
    border-color: color-mix(in oklch, var(--line-strong), var(--accent) 45%);
  }
  &:has(#tech-filter-hardware:checked) li.hw {
    border-color: var(--blueprint);
    background-color: color-mix(in oklch, var(--surface-raised), var(--blueprint) 10%);
  }

  @media (prefers-reduced-motion: reduce) {
    li {
      transition: none;
    }
  }
}
</style>
