---
import SectionHeader from '@/components/SectionHeader.astro';
import TechIcon from '@/components/TechIcon.astro';

import { TECH_ICONS } from '@/server/tech-icons';

const hardwareCount = TECH_ICONS.filter((tech) => tech.hardware).length;
const softwareCount = TECH_ICONS.length - hardwareCount;
---

<section id="bill-of-materials" aria-labelledby="bill-of-materials-heading">
  <SectionHeader headingId="bill-of-materials-heading" titleJp="どうぐ" title="Bill of materials" />

  <div class="filter-bar">
    <fieldset class="filter-toggle">
      <legend class="sr-only">Filter by category</legend>
      <div class="filter-toggle-track">
        <input type="radio" name="tech-filter" id="tech-filter-all" checked>
        <label for="tech-filter-all">All</label>
        <input type="radio" name="tech-filter" id="tech-filter-software">
        <label for="tech-filter-software">Software</label>
        <input type="radio" name="tech-filter" id="tech-filter-hardware">
        <label for="tech-filter-hardware">Hardware &amp; CAD</label>
      </div>
    </fieldset>
    <p class="filter-count monospace" role="status">
      <span class="count-software">{softwareCount} software</span>
      <span class="count-hardware">{hardwareCount} hardware &amp; CAD</span>
    </p>
  </div>

  <ul>
    {TECH_ICONS.map((tech) => (
      <li class:list={[{ hw: tech.hardware }]}>
        <TechIcon tech={tech} decorative />
        <span>{tech.text}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
section {
  max-width: 80ch;
  margin-inline: auto;
  margin-top: 1.5rem;

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin: 0 0 1.1rem;
  }

  .filter-toggle {
    margin: 0;
    padding: 0;
    min-width: 0;
    border: none;

    .filter-toggle-track {
      display: inline-flex;
      flex-wrap: wrap;
      max-width: 100%;
      border: 1px solid var(--line-strong);
      border-radius: 0.125rem;
      overflow: hidden;
      font-size: 0.75rem;
    }

    input {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    label {
      cursor: pointer;
      padding: 0.4em 0.85em;
      font-family: monospace, system-ui;
      letter-spacing: 0.03em;
      color: var(--ink-faint);
      background: var(--surface-page);
      user-select: none;

      &:hover {
        color: var(--ink);
      }
    }

    input:not(:first-of-type) + label {
      box-shadow: inset 1px 0 0 var(--line-strong);
    }

    input:checked + label {
      color: var(--ink);
      background: var(--surface-sunken);
    }

    input:focus-visible + label {
      // Checked option always owns focus in a radio group.
      outline: 2px solid var(--ink);
      outline-offset: -2px;
      position: relative;
      z-index: 1;
    }
  }

  .filter-count {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-faint);

    span {
      display: none;
    }
  }

  &:has(#tech-filter-software:checked) .filter-count .count-software {
    display: inline;
  }
  &:has(#tech-filter-hardware:checked) .filter-count .count-hardware {
    display: inline;
  }

  ul {
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;

    @media (max-width: 52rem) {
      gap: 0.4em;
    }
  }

  /* A chip is a cell of the title block, hairline and near square, and not a status pill. */
  li {
    padding: 0.375em 0.6em;
    border-radius: 0.125rem;
    display: inline-flex;
    gap: 0.75ch;
    align-items: center;
    // Skip layout/paint for chips while the ~500KiB inline SVG cloud is still
    // being parsed / while chips are off-screen — feels like a mid-list hang.
    content-visibility: auto;
    contain-intrinsic-size: auto 2.25rem;

    color: var(--ink);
    background-color: var(--surface-sunken);
    border: 1px solid var(--line-strong);

    font-family: monospace, system-ui;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;

    transition: opacity 0.2s ease, filter 0.2s ease;

    @media (max-width: 52rem) {
      padding: 0.3em 0.5em;
      font-size: 0.75rem;
      gap: 0.5ch;
    }
  }

  &:has(#tech-filter-software:checked) li.hw {
    opacity: 0.3;
    filter: grayscale(70%);
  }
  &:has(#tech-filter-hardware:checked) li:not(.hw) {
    opacity: 0.3;
    filter: grayscale(70%);
  }

  @media (prefers-reduced-motion: reduce) {
    li {
      transition: none;
    }
  }
}
</style>
