---
import TechIcon from '@/components/TechIcon.astro';

import { TECH_ICONS } from '@/server/tech-icons';
---

<section aria-labelledby="tech-icon-cloud-label">
  <p id="tech-icon-cloud-label" class="cloud-label monospace">Bill of materials</p>
  <ul>
    {TECH_ICONS.map((tech) => (
      <li>
        <TechIcon tech={tech} decorative />
        <span>{tech.text}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
section {
  max-width: 80ch;
  margin-inline: auto;
  margin-top: 1.5rem;

  .cloud-label {
    margin: 0 0 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
  }

  ul {
    display: flex;
    justify-content: center;
    gap: 0.5em;
    flex-wrap: wrap;

    @media (max-width: 52rem) {
      gap: 0.4em;
    }
  }

  li {
    padding: 0.375em 0.6em;
    border-radius: 0.55em;
    display: inline-flex;
    gap: 0.75ch;
    align-items: center;
    // Skip layout/paint for chips while the ~500KiB inline SVG cloud is still
    // being parsed / while chips are off-screen — feels like a mid-list hang.
    content-visibility: auto;
    contain-intrinsic-size: auto 2.25rem;

    color: var(--ink);
    background-color: var(--surface-raised);
    border: 1px solid color-mix(in oklch, var(--line-strong), var(--accent-muted) 35%);

    font-family: monospace, system-ui;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;

    @media (max-width: 52rem) {
      padding: 0.3em 0.5em;
      font-size: 0.75rem;
      gap: 0.5ch;
    }
  }
}
</style>
