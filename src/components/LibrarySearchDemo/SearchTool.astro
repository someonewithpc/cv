---
import { Icon } from 'astro-icon/components';

import { categories, colors, detailsOf, initialQuery, libraryObjects } from './objects';
import { formatScore, search, type Filters } from './search';

type Props = {
  /** Wire the tool up to the client script and the walkthrough. */
  live?: boolean;
  query?: string;
  filters?: Filters;
};

const { live = false, query = initialQuery, filters = {} } = Astro.props;

const result = search({ query, filters });
const matched = new Set(result.hits.map((hit) => hit.object.id));
// Hits in rank order, then every other object hidden behind them, so the client only
// ever reorders and unhides rows the page already has.
const rows = [
  ...result.hits,
  ...libraryObjects.filter((object) => !matched.has(object.id)).map((object) => ({ object, score: null })),
];
const countText = (hits: number) => `${hits} of ${libraryObjects.length} objects`;
---

<div
  class="library-search"
  data-live={live ? '' : undefined}
  data-query={query}
  data-filters={JSON.stringify(filters)}
>
  <div class="search-form" role="search">
    <label class="query">
      <Icon name="lucide:search" />
      <input
        class="query-input"
        type="search"
        value={query}
        placeholder="Search the library"
        aria-label="Search the library"
        autocomplete="off"
        spellcheck="false"
      />
    </label>
    <label class="filter">
      <span>Category</span>
      <select class="filter-select" data-filter="category" aria-label="Filter by category">
        <option value="">Any</option>
        {categories.map((category) => <option value={category} selected={filters.category === category}>{category}</option>)}
      </select>
    </label>
    <label class="filter">
      <span>Color</span>
      <select class="filter-select" data-filter="color" aria-label="Filter by color">
        <option value="">Any</option>
        {colors.map((color) => <option value={color} selected={filters.color === color}>{color}</option>)}
      </select>
    </label>
  </div>

  {/* A live region from the moment the visitor is the one typing (librarySearch.ts): while
      the walkthrough types, a screen reader would hear the count on every keystroke. */}
  <p class="count">{countText(result.hits.length)}</p>

  <ol class="results">
    {rows.map(({ object, score }) => (
      <li class="hit" data-object={object.id} hidden={!matched.has(object.id)}>
        <img class="thumb" src={object.image} alt="" width="160" height="160" loading="lazy" />
        <span class="text">
          <span class="name">{object.name}</span>
          <span class="details">{detailsOf(object)}</span>
        </span>
        <span class="relevance" style={{ '--score': score ?? 0 }}>
          <span class="bar" aria-hidden="true"></span>
          <span class="value">{result.terms.length ? formatScore(score) : ''}</span>
        </span>
      </li>
    ))}
    <li class="no-hits" hidden={result.hits.length > 0}>Nothing in the library matches</li>
  </ol>
</div>

<style lang="scss">
/* The product's look, Bootstrap 3 at a 14px base, carried over in em so the whole tool
   scales with the sheet. 1em here is the product's 14px. */
.library-search {
  --radius-panel: 0.714em;
  --radius-control: 0.571em;
  --gutter: 1.071em;
  --highlight: color-mix(in oklch, var(--surface-raised), var(--ink) 5%);

  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  overflow: hidden;

  font-family: var(--font-poppins), system-ui, sans-serif;
  font-size: clamp(0.625rem, 0.02 * min(var(--sheet-inline), var(--sheet-block)), 0.875rem);
  line-height: 1.428;
  color: var(--ink);

  background: var(--surface-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-panel);
}

.library-search :global(input),
.library-search :global(select) {
  font: inherit;
  color: inherit;
}

.search-form {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5em 1em;
  padding: 0.714em var(--gutter);
  border-bottom: 1px solid var(--line);
}

.query {
  flex: 1 1 14em;
  position: relative;
  display: flex;
  align-items: center;

  :global(svg) {
    position: absolute;
    left: 0.75em;
    width: 1.1em;
    height: 1.1em;
    color: var(--ink-muted);
    pointer-events: none;
  }
}

.query-input,
.filter-select {
  box-sizing: border-box;
  min-width: 0;
  height: 2.429em;
  border: 1px solid var(--line);
  border-radius: var(--radius-control);
  background: var(--surface-page);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;

  &:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent), transparent 85%);
  }
}

.query-input {
  width: 100%;
  padding: 0.429em 0.857em 0.429em 2.3em;
}

.filter {
  display: inline-flex;
  align-items: center;
  gap: 0.5em;
  font-weight: 700;

  .filter-select {
    width: 7.5em;
    padding: 0 0.5em;
    font-weight: 400;
  }
}

.count {
  margin: 0;
  padding: 0.5em var(--gutter) 0;
  font-size: 0.857em;
  color: var(--ink-muted);
}

.results {
  min-height: 0;
  margin: 0;
  padding: 0.5em var(--gutter) var(--gutter);
  list-style: none;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--line-strong) transparent;
  display: grid;
  align-content: start;
  gap: 0.357em;
}

.hit {
  display: grid;
  grid-template-columns: 3em minmax(0, 1fr) minmax(6em, 30%);
  align-items: center;
  gap: 0.75em;
  padding: 0.357em 0.571em;
  border: 1px solid var(--line);
  border-radius: var(--radius-control);
  background: var(--surface-page);

  &[hidden] {
    display: none;
  }
}

/* The product's render of the object, kept on the white it was rendered against so it
   reads the same on a dark sheet. */
.thumb {
  display: block;
  width: 3em;
  height: 3em;
  padding: 0.2em;
  box-sizing: border-box;
  border-radius: 0.357em;
  background: #fff;
  object-fit: contain;
}

.text {
  min-width: 0;
  display: flex;
  flex-direction: column;

  .name {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .details {
    font-size: 0.875em;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

/* The bar is scaled, not resized, so a re-rank animates on the compositor. */
.relevance {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 2.6em;
  align-items: center;
  gap: 0.5em;

  .bar {
    height: 0.5em;
    border-radius: 0.25em;
    background: var(--accent);
    transform-origin: left center;
    scale: var(--score) 1;
    transition: scale 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--accent), transparent 70%);
  }

  .value {
    font-family: monospace, system-ui;
    font-size: 0.857em;
    text-align: right;
    color: var(--ink-muted);
  }
}

.no-hits {
  padding: 1em;
  text-align: center;
  color: var(--ink-muted);

  &[hidden] {
    display: none;
  }
}

:global([data-sheet-orientation='portrait']) {
  .hit {
    grid-template-columns: 3em minmax(0, 1fr) minmax(5em, 35%);
  }

  .filter .filter-select {
    width: 6.5em;
  }
}

@media (prefers-reduced-motion: reduce) {
  .relevance .bar,
  .query-input,
  .filter-select {
    transition: none;
  }
}
</style>
