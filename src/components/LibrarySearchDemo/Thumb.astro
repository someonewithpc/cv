---
import type { Category } from './objects';

type Props = { category: Category };

/* Placeholder thumbnails: one line glyph per category, drawn on a 24 unit grid. The
   product shows a render of each object; nothing from its library is shown here. */
const glyphs: Record<Category, string> = {
  Chair: 'M8 3v18M8 13h9v8M8 13V3M17 13l-1-4H8',
  Table: 'M3 9h18M6 9v11M18 9v11M4 9l2-3h12l2 3',
  Set: 'M12 12m-4.5 0a4.5 4.5 0 1 0 9 0a4.5 4.5 0 1 0-9 0M10.5 2.5h3v2h-3zM10.5 19.5h3v2h-3zM2.5 10.5h2v3h-2zM19.5 10.5h2v3h-2z',
  Linen: 'M4 5h16v9l-5 5H4zM15 19v-5h5',
  Staging: 'M3 20V14h18v6M6 14V9h12v5M9 9V6h6v3',
  Lighting: 'M9 17h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.4.3.5.7.5 1.1v2h5v-2c0-.4.1-.8.5-1.1A6 6 0 0 0 12 3z',
  Decor: 'M9 3h6M10 3v4c-2.5 1.5-4 4-4 7a6 6 0 0 0 12 0c0-3-1.5-5.5-4-7V3',
};
---

<svg class="thumb" viewBox="0 0 24 24" aria-hidden="true">
  <path d={glyphs[Astro.props.category]} />
</svg>

<style>
.thumb {
  width: 100%;
  height: 100%;

  path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
}
</style>
