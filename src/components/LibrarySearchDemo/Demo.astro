---
import path from 'node:path';

import * as esbuild from 'esbuild';

import PostIt from '@/components/PostIt.astro';
import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';

import SearchLayer from './layers/SearchLayer.astro';
import RelevanceLayer from './layers/RelevanceLayer.astro';
import FiltersLayer from './layers/FiltersLayer.astro';
import SqlLayer from './layers/SqlLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

const srcRoot = path.join(process.cwd(), 'src');
const clientDir = path.join(srcRoot, 'components/LibrarySearchDemo/client');

// Both halves the sheets load, the main tool and the relevance and SQL sheets' redraw,
// split the way the page splits them so the search they share is weighed once.
const { outputFiles } = await esbuild.build({
  entryPoints: [path.join(clientDir, 'librarySearch.ts'), path.join(clientDir, 'querySheet.ts')],
  bundle: true,
  splitting: true,
  minify: true,
  write: false,
  format: 'esm',
  outdir: 'out',
  alias: { '@': srcRoot },
});

const clientSize = toKiB(outputFiles.map((file) => file.text).join(''));

const layers = {
  search: { name: null },
  relevance: { name: 'Relevance Scoring', pageStyle: 'blueprint' },
  filters: { name: 'Filters', pageStyle: 'blueprint' },
  sql: { name: 'Generated SQL', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="Library Search & Relevance"
  scale="1:1"
  size={clientSize}
  date="2024"
  tech={['rails', 'mariadb']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      search: <SearchLayer />,
      relevance: <RelevanceLayer />,
      filters: <FiltersLayer />,
      sql: <SqlLayer />,
    }[layer])}
  </fragment>
  <fragment slot="aside">
    {(layer: Layer) => ({
      search: null,
      relevance: (
        <PostIt background="#cde" color="black">
          A raw MATCH score means nothing alone, so each row reads as a share of the best one.
          Type a seat count here and 8 stops matching 81
        </PostIt>
      ),
      filters: (
        <PostIt background="#dfd" color="black">
          The category goes in before the maximum, so the best row it leaves reads 1.00. A
          property filter comes after, and can leave the top row lower
        </PostIt>
      ),
      sql: (
        <PostIt background="#edf" color="black">
          Type fast here. Repeats get dropped and stale requests aborted, and one MATCH fragment
          filters, scores and sorts whatever gets through
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>
