---
import { initialQuery, variantOf } from '../objects';
import { formatScore, mangle, search } from '../search';

// One query, with and without a category: the best row the category leaves goes to 1.00,
// because the maximum is taken inside the category too.
const query = initialQuery;
const filter = { category: 'Catering' } as const;
const TOP = 5;

const all = search({ query, filters: {} });
const filtered = search({ query, filters: filter });
const lead = filtered.hits[0]?.object.id;

/** The top rows, and the row that will climb wherever it sits below them. */
function shown(result: typeof all) {
  const rows = result.hits.slice(0, TOP).map((hit) => ({ hit, skipped: 0 }));
  const at = result.hits.findIndex((hit) => hit.object.id === lead);
  if (at >= TOP) rows.push({ hit: result.hits[at], skipped: at - TOP });
  return rows;
}

const columns = [
  { title: 'No filter', result: all, note: `${all.hits.length} rows, max ${all.max?.toFixed(3)}` },
  { title: `category = ${filter.category}`, result: filtered, note: `${filtered.hits.length} rows, max ${filtered.max?.toFixed(3)}` },
];
---

<div class="wrapper" data-blueprint-sheet>
  <div class="filters-layer">
    <div class="panel">
      <header>
        <strong>A filter narrows the relation, and the maximum comes from what is left</strong>
        <span class="query"><code>{query}</code> → <code>{mangle(query).text}</code></span>
      </header>

      <div class="compare">
        {columns.map(({ title, result, note }, index) => (
          <>
            {index > 0 && <span class="arrow">+ filter →</span>}
            <div class="column">
              <h3>{title}</h3>
              <ol>
                {shown(result).map(({ hit, skipped }) => (
                  <>
                    {skipped > 0 && <li class="gap">{skipped} more</li>}
                    <li class:list={{ lead: hit.object.id === lead }}>
                      <span class="name">{hit.object.name} <span class="variant">{variantOf(hit.object)}</span></span>
                      <span class="bar" style={{ '--score': hit.score ?? 0 }}></span>
                      <span class="value">{formatScore(hit.score)}</span>
                    </li>
                  </>
                ))}
              </ol>
              <p class="note">{note}</p>
            </div>
          </>
        ))}
      </div>

      <dl class="rules">
        <div>
          <dt>Predicate</dt>
          <dd>Each filter is one more <code>AND</code> on the relation: the category compares a column, a property goes through <code>library_object_synthetic_properties</code> by name and value</dd>
        </div>
        <div>
          <dt>Maximum</dt>
          <dd>The maximum comes from the relation with its category, so the best row a category leaves reads 1.00. The controller adds the property filter after it has built the maximum, so a property can leave the top row below 1.00</dd>
        </div>
        <div>
          <dt>Options</dt>
          <dd>A property filter offers the values already stored for it, so it never offers one that matches nothing</dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<style lang="scss">
@use '@/scss/sheet-orientation' as *;
@use "./sheet" as *;

@include blueprint-cell;

.wrapper {
  @include blueprint-wrapper;
}

.filters-layer {
  @include blueprint-type;

  width: min(100%, 46em);
}

.panel {
  @include panel;
}

header {
  display: flex;
  flex-direction: column;
  gap: 0.125em;

  strong {
    font-size: 0.875em;
  }

  .query {
    font-size: 0.75em;
    color: var(--ink-muted);
  }
}

.compare {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 0.75em;

  @include portrait-sheet {
    grid-template-columns: minmax(0, 1fr);
  }
}

.arrow {
  font-family: monospace, system-ui;
  font-size: 0.75em;
  color: var(--ink-muted);
  white-space: nowrap;
}

.column {
  display: grid;
  gap: 0.375em;
  padding: 0.5em 0.625em;
  border: 1px solid var(--line);
  border-radius: 0.375em;
  background: var(--surface-sunken);

  h3 {
    margin: 0;
    font-family: monospace, system-ui;
    font-size: 0.75em;
    font-weight: 400;
    color: var(--ink-muted);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25em;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30% 2.75em;
    align-items: center;
    gap: 0.5em;
    padding: 0.125em 0.25em;
    border-radius: 0.25em;
    font-size: 0.75em;

    &.lead {
      outline: 1px solid var(--accent);
      background: color-mix(in oklch, var(--accent), transparent 85%);
    }
  }

  .name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .variant {
    color: var(--ink-muted);
  }

  .bar {
    height: 0.625em;
    border-radius: 0.3em;
    background: var(--accent);
    transform-origin: left center;
    scale: var(--score) 1;
  }

  .value {
    text-align: right;
    font-family: monospace, system-ui;
  }

  .note {
    margin: 0;
    font-family: monospace, system-ui;
    font-size: 0.75em;
    color: var(--ink-muted);
  }

  .gap {
    display: block;
    padding: 0 0.25em;
    font-family: monospace, system-ui;
    font-size: 0.75em;
    color: var(--ink-muted);
  }
}

.rules {
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.5em;
  padding-top: 0.5em;
  border-top: 1px solid var(--line);

  @include portrait-sheet {
    grid-template-columns: minmax(0, 1fr);
  }

  div {
    display: flex;
    flex-direction: column;
    gap: 0.125em;
  }

  dt {
    font-size: 0.75em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    font-size: 0.75em;
    line-height: 1.35;
    text-wrap: pretty;
  }
}

code {
  font-family: monospace, system-ui;
}
</style>
