---
import { mangledHtml, relevanceHtml } from '../markup';
import { initialQuery } from '../objects';
import { mangle } from '../search';

const state = { query: initialQuery, filters: {} };
// The unquoted prefix the number rule stands in the way of, and what it would drag in.
const bare = '8*';
const quoted = mangle('8').text;
---

<div class="wrapper">
  <div class="relevance-layer" data-library-search="relevance" data-query={state.query} data-filters="{}">
    <div class="panel">
      <header>
        <strong>MATCH's score, over the best score the same query got</strong>
      </header>

      <div class="query-row">
        <input
          class="sheet-query"
          type="search"
          value={state.query}
          aria-label="Query"
          autocomplete="off"
          spellcheck="false"
        />
        <p class="sent">
          <span class="label">Sent as</span>
          <code class="mangled" set:html={mangledHtml(state.query)} />
          <span class="filters-note"></span>
        </p>
      </div>

      <div class="live" data-live-part set:html={relevanceHtml(state)} />

      <dl class="rules">
        <div>
          <dt>Rank</dt>
          <dd>InnoDB scores a term by how often it occurs in the row times its idf squared, and adds the terms up; a term in every row weighs nothing</dd>
        </div>
        <div>
          <dt>Normalise</dt>
          <dd>Every score is divided by the query's own maximum, so the top hit reads 1.00 whatever the raw numbers were</dd>
        </div>
        <div>
          <dt>Numbers</dt>
          <dd><code>{bare}</code> would also match 8ft, 8in and 81; <code>{quoted}</code> matches the token 8 alone, and only indexes at all with <code>innodb_ft_min_token_size = 1</code></dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-library-search="relevance"]', boot);
</script>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include blueprint-wrapper;
}

.relevance-layer {
  @include blueprint-type;

  width: min(100%, 46em);
}

.panel {
  @include panel;
}

header strong {
  font-size: 0.875em;
}

.query-row {
  display: grid;
  gap: 0.375em;
}

.sheet-query {
  @include query-field;
}

.sent {
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.25em 0.625em;
  font-size: 0.75em;

  .label {
    font-size: 0.8333em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .filters-note {
    color: var(--ink-muted);
  }
}

.mangled {
  :global(.rule-prefix) {
    color: var(--ink-faint);
  }

  :global(.rule-quoted),
  :global(.rule-folded) {
    padding: 0 0.2em;
    border-radius: 0.2em;
    background: color-mix(in oklch, var(--accent), transparent 70%);
  }

  :global(.empty) {
    color: var(--ink-faint);
  }
}

/* What relevanceHtml() prints, here and on every keystroke. */
.live {
  display: grid;
  gap: 0.5em;
  font-size: 0.6875em;

  :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  :global(th) {
    padding: 0.25em 0.5em;
    border-bottom: 1px solid var(--line-strong);
    font-weight: 400;
    font-size: 0.9em;
    letter-spacing: 0.04em;
    text-align: left;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  :global(td) {
    padding: 0.2em 0.5em;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  :global(.num) {
    text-align: right;
    font-family: monospace, system-ui;
  }

  :global(.name) {
    white-space: nowrap;
  }

  :global(.variant) {
    color: var(--ink-muted);
  }

  :global(.sum code) {
    color: var(--ink-muted);
    overflow-wrap: anywhere;
  }

  :global(.excluded) {
    color: var(--ink-faint);
  }

  :global(.score) {
    width: 30%;
  }

  :global(.meter) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.75em;
    align-items: center;
    gap: 0.5em;
  }

  :global(.bar) {
    height: 0.625em;
    border-radius: 0.3em;
    background: var(--accent);
    transform-origin: left center;
    scale: var(--score) 1;
  }

  :global(.value) {
    text-align: right;
    font-family: monospace, system-ui;
  }

  :global(.more),
  :global(.nothing) {
    margin: 0;
    color: var(--ink-muted);
  }
}

.rules {
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.5em;
  padding-top: 0.5em;
  border-top: 1px solid var(--line);

  :global([data-sheet-orientation='portrait']) & {
    grid-template-columns: minmax(0, 1fr);
  }

  div {
    display: flex;
    flex-direction: column;
    gap: 0.125em;
  }

  dt {
    font-size: 0.625em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    font-size: 0.6875em;
    line-height: 1.35;
    text-wrap: pretty;
  }
}

code {
  font-family: monospace, system-ui;
}
</style>
