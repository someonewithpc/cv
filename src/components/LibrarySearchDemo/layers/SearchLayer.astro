---
import SearchTool from '../SearchTool.astro';
import { walkthrough } from '../objects';
---

<div
  class="library-search-demo"
  data-walkthrough={JSON.stringify(walkthrough)}
  data-library-search="search"
>
  <SearchTool live />

  {/* The walkthrough's hand, the arrow the other demos draw. It sits outside the tool,
      which clips its own overflow, so the tip still reads on a control at the edge. */}
  <div class="demo-cursor" data-demo-cursor aria-hidden="true" hidden>
    <svg viewBox="0 0 32 32" width="56" height="56" aria-hidden="true">
      <path
        d="M4 2.5v24.2l6.4-6.2 4.1 9.7 4.2-1.8-4.1-9.6H26z"
        fill="#fff"
        stroke="var(--accent, #222)"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
    </svg>
    <span class="demo-cursor-label">demo</span>
  </div>
</div>

<script>
import { bootIslands } from '@/client/pageIsland';
import { boot } from '../client/boot';

bootIslands('[data-library-search="search"]', boot);
</script>

<style lang="scss">
// The tool fills the sheet inside the shared --demo-inset (Page.astro), as the Space Builder
// and Drag and drop apps do. The 2px keeps the frame line clear.
:global(article.technical-drawing-stack > * > section .content:has(.library-search-demo)) {
  --demo-pad: calc(2px + var(--demo-inset, 0px));

  place-self: stretch;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: var(--demo-pad);
}

.library-search-demo {
  // A landscape sheet lays its title block over the tool's bottom-right corner, and the
  // result list scrolls on past it by this much (SearchTool.astro). Portrait gives the block
  // a row of its own, so the reach goes back to 0. The query is the one Page.astro moves the
  // block with, not the sheet's orientation attribute.
  --title-block-reach: var(--title-block-block, 0px);

  @container technical-drawing (orientation: portrait) {
    --title-block-reach: 0px;
  }

  position: relative;
  box-sizing: border-box;
  width: 100%;
  /* A definite height, so the result list scrolls inside the sheet rather than
     growing it. */
  height: 100%;
  min-height: 0;
  display: flex;
  align-items: stretch;
}

// Placed by translate alone: cursorMotion.ts animates each hop with its own duration and
// folds the hotspot, the arrow's tip, into every keyframe. Stack.astro's style block scales
// it on a press, around the tip.
.demo-cursor {
  position: absolute;
  z-index: 3;
  top: 0;
  left: 0;
  width: 56px;
  height: 56px;
  transform-origin: 12% 8%;
  pointer-events: none;
  transition: scale 0.12s ease;

  &[hidden] {
    display: none;
  }

  svg {
    display: block;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
  }

  // Says out loud that this arrow is the walkthrough's, not the visitor's pointer.
  .demo-cursor-label {
    position: absolute;
    left: 2.25em;
    top: 2em;
    padding: 0 0.25em;
    border: 1px solid var(--accent, #222);
    border-radius: 0.25em;
    background: #fff;
    color: #222;
    font-family: monospace, system-ui;
    font-size: 0.625rem;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }
}
</style>
