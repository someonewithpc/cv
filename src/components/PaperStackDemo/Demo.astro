---
import path from 'node:path';

import * as esbuild from 'esbuild';

import TechnicalDrawingStack from '@/components/TechnicalDrawing/Stack.astro';
import PostIt from '@/components/PostIt.astro';
import { highlightInline } from '@/highlight';

import PileLayer from './layers/PileLayer.astro';
import FoldLayer from './layers/FoldLayer.astro';
import RowLayer from './layers/RowLayer.astro';

function toKiB(text: string) {
  return `${Math.ceil((text.length / 1024) * 10) / 10}KiB`;
}

// The weight in the title block is the stack's own script, the one that turns these very
// sheets, minified the way the site ships it.
const srcRoot = path.join(process.cwd(), 'src');
const { outputFiles: [bundle] } = await esbuild.build({
  entryPoints: [path.join(srcRoot, 'components/PaperStack/fold-drag.ts')],
  bundle: true,
  minify: true,
  write: false,
  format: 'esm',
  alias: { '@': srcRoot },
});
const scriptSize = toKiB(bundle.text);

const layers = {
  pile: { name: null },
  fold: { name: 'The Fold', pageStyle: 'blueprint' },
  row: { name: 'Without JavaScript', pageStyle: 'blueprint' },
} as const;

type Layer = keyof typeof layers;
---

<TechnicalDrawingStack
  subtitle="Paper Stack"
  scale="1:1"
  size={scriptSize}
  date="2026"
  tech={['css3', 'typescript']}
  layers={layers}
>
  <fragment slot="layers">
    {(layer: Layer) => ({
      pile: <PileLayer />,
      fold: <FoldLayer />,
      row: <RowLayer />,
    }[layer])}
  </fragment>

  <fragment slot="aside">
    {(layer: Layer) => ({
      pile: (
        <PostIt background="#ea1" color="black">
          Every page shares one grid cell. Which one is in front is a number,{' '}
          <Fragment set:html={highlightInline('--page-index', 'css', ['a{', '}'], 'custom-property')} />, and a turn renumbers them all
        </PostIt>
      ),
      fold: (
        <PostIt background="#cde" color="black">
          Let go with the tip past the commit point and the page turns. Short of it, the fold
          glides back. A wheel, a finger or the <kbd>←</kbd> and <kbd>→</kbd> keys turn the page too
        </PostIt>
      ),
      row: (
        <PostIt background="#fed" color="black">
          Switch JavaScript off and reload: every stack on this page is this row. Chrome draws
          the arrows and the dots; Firefox shows the next sheet's edge instead
        </PostIt>
      ),
    }[layer])}
  </fragment>
</TechnicalDrawingStack>

<style>
  /* The highlighter leaves a custom property in the ink; this one is the note's subject, so it
     takes the accent role the code keywords use, kept on one line. */
  :global(code.hl.custom-property) {
    color: var(--hl-warm);
    white-space: nowrap;
  }
</style>
