---
/**
 * What holds a demo still. The board is live: it opens a demo gate of its own
 * (src/client/frontPage.ts), the same gate every walkthrough on the page runs on, and lights
 * a lamp for each reason the gate is held. It listens and never polls, so at rest it costs
 * nothing.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

// The board is a short box, and the callout unit is its inscribed square, so the labels
// are drawn twice the usual size to read at all.
const annotationScale = 1.2;
const annotationFontSize = 0.1 * annotationScale;

const lamps = [
  { reason: 'offscreen', label: 'stack off screen' },
  { reason: 'back-page', label: 'behind the front page' },
  { reason: 'hidden', label: 'tab hidden' },
  { reason: 'resize', label: 'window resizing' },
];
---

<div class="wrapper">
  <p class="point typewriter">What holds this sheet still</p>

  <Annotations scale={annotationScale} reach={1}>
    {/* The plate leaves the board room for its labels: beside it, or under it on a phone. */}
    <div class="plate" slot="content">
    <div class="board" data-gate-board>
      <span class="notes-heading" data-part="heading">This sheet's gate</span>
      <ul class="lamps">
        {lamps.map(({ reason, label }) => (
          <li data-reason={reason}>
            <span class="lamp" aria-hidden="true"></span>
            <span class="label">{label}</span>
          </li>
        ))}
      </ul>
      <p class="tally">
        <span class="with-script">Holds since the page loaded: <span data-tally>0</span>.</span>
        <span class="without-script">Without script there is no gate. Nothing on the sheet moves, and the stack is the row on the next sheet.</span>
      </p>
    </div>
    </div>

    <Fragment slot="annotations">
      <ArrowAnnotation
        target='[data-part="heading"]'
        anchor="0.97 0.5"
        tipX={0.35}
        tipY={-0.8}
        angle={20}
        length={0.3}
        fontSize={annotationFontSize}
        text="the gate every walkthrough runs on"
        only="landscape"
      />
      <ArrowAnnotation
        target='[data-reason="resize"] .label'
        anchor="right"
        gap={0.3}
        tipX={0.15}
        tipY={0.35}
        angle={0}
        length={0.3}
        fontSize={annotationFontSize}
        text="a lamp lights while its reason holds"
        only="landscape"
      />
      <ArrowAnnotation
        target='.tally'
        anchor="right"
        tipX={0.35}
        tipY={0.8}
        angle={-15}
        length={0.35}
        fontSize={annotationFontSize}
        text="it listens, and never polls"
        only="landscape"
      />
      <ArrowAnnotation
        target='[data-part="heading"]'
        anchor="0.97 0.5"
        tipX={0.9}
        tipY={-0.6}
        angle={-90}
        length={1.75}
        labelSide="left"
        fontSize={annotationFontSize}
        text="the gate every walkthrough runs on"
        only="portrait"
      />
      <ArrowAnnotation
        target='[data-reason="resize"] .lamp'
        anchor="-0.15 1"
        tipX={-0.9}
        tipY={0.3}
        angle={-90}
        length={0.5}
        labelSide="right"
        fontSize={annotationFontSize}
        text="a lamp lights while its reason holds"
        only="portrait"
      />
      <ArrowAnnotation
        target='.tally'
        anchor="0.75 1"
        tipX={0.3}
        tipY={0.6}
        angle={-90}
        length={0.5}
        labelSide="left"
        fontSize={annotationFontSize}
        text="it listens, and never polls"
        only="portrait"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include sheet-type;

  display: grid;
  justify-items: center;
  align-content: center;
  row-gap: 0.5em;
  max-width: min(92cqw, 100%);
  margin-inline: auto;

  > :global(.content) {
    width: min(100%, 34em);
  }
}

.plate {
  box-sizing: border-box;
  width: 100%;
  padding-inline-end: 12em;

  :global([data-sheet-orientation='portrait']) & {
    padding: 0 0 7.5em;
  }
}

.point {
  @include point;
}

.board {
  @include drawing-notes;

  width: 100%;
  box-sizing: border-box;
}

.lamps {
  display: grid;
  gap: 0.375em;
  margin: 0;
  padding: 0.5em 0.75em;
  list-style: none;

  li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-family: "Special Elite", monospace, system-ui;
    font-size: max(0.5rem, 0.875em);
    line-height: 1.25;
  }
}

// The deck's LED, one per reason: an empty ring until the reason holds the gate.
.lamp {
  flex: none;
  width: 0.625em;
  height: 0.625em;
  border: 1px solid var(--ink-muted);
  border-radius: 50%;
  transition: background-color 200ms ease-out, border-color 200ms ease-out;

  [data-lit] > & {
    border-color: var(--accent);
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    transition: none;
  }
}

.tally {
  margin: 0;
  padding: 0.375em 0.75em 0.5em;
  border-top: 1px solid var(--line);
  font-size: max(0.5rem, 0.75em);
  line-height: 1.375;
  color: var(--ink-muted);
  text-wrap: pretty;
}

// One of the two lines shows, by whether the page runs script. The media query, not the
// board's own mark: a page that loses script after load keeps the mark and would lie.
.without-script {
  display: none;
}

@media (scripting: none) {
  .with-script {
    display: none;
  }

  .without-script {
    display: inline;
  }
}
</style>

<script>
import { demoGate, watchFrontPage, type PauseReason } from '@/client/frontPage';
import { onResizeHold } from '@/client/resizeHold';

const LAMPS: PauseReason[] = ['offscreen', 'back-page', 'hidden', 'resize'];

function initBoard(board: HTMLElement) {
  const gate = demoGate(board);
  const tally = board.querySelector<HTMLElement>('[data-tally]');
  let holds = 0;

  const show = () => {
    board.dataset.running = String(gate.running);
    for (const reason of LAMPS) {
      board.querySelector(`[data-reason="${reason}"]`)?.toggleAttribute('data-lit', gate.reasons.has(reason));
    }
  };

  // The gate reports when it opens or closes. A reason that joins one already holding
  // changes nothing there, so the two a reader can bring about on a held gate, the page
  // going behind the front and the window resizing, are watched as well.
  gate.onChange((running) => {
    if (!running) holds += 1;
    if (tally) tally.textContent = String(holds);
    show();
  });
  watchFrontPage(board, show);
  onResizeHold(show);
  document.addEventListener('visibilitychange', show);

  show();
  board.dataset.gateLive = '';
}

function init() {
  document.querySelectorAll<HTMLElement>('[data-gate-board]').forEach(initBoard);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init, { once: true });
} else {
  init();
}
</script>
