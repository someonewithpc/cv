---
/**
 * The stack at rest, seen from above: the front page with what a page carries, the three
 * pages still to come under it, each turned about the pin by the angle the real stack gives
 * it, the clip on the pin and the dog-ear at its resting size. Nothing is exaggerated: the
 * sheet is 30em wide in its own units, so every length here is the real one in em, and the
 * fan's angles are PaperStack/index.astro's own.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import MiniPage from './MiniPage.astro';

const annotationScale = 0.6;
const annotationFontSize = 0.1 * annotationScale;

// The front page's box, 30em wide, and the corner radius the real page has (0.5em).
const sheet = { x: 30, y: 30, w: 240, h: 120 };
const em = sheet.w / 30;
const radius = 0.5 * em;
const right = sheet.x + sheet.w;
const bottom = sheet.y + sheet.h;

// The pin the pages turn about: half the clip's lean, 2.25em by 4.5em, in from the corner.
const lean = { x: 2.25 * em, y: 4.5 * em };
const pin = { x: sheet.x + lean.x / 2, y: sheet.y + lean.y / 2 };

// The dog-ear at rest, 2cm by 1cm: a twelfth of the sheet on a wide window, a 2:1 corner, and
// the corner reflected across its crease.
const ear = { x: 2.5 * em, y: 1.25 * em };
const creaseA = { x: right - ear.x, y: bottom };
const creaseB = { x: right, y: bottom - ear.y };
const d = { x: creaseB.x - creaseA.x, y: creaseB.y - creaseA.y };
const len = Math.hypot(d.x, d.y);
const u = { x: d.x / len, y: d.y / len };
const along = (right - creaseA.x) * u.x + (bottom - creaseA.y) * u.y;
const foot = { x: creaseA.x + along * u.x, y: creaseA.y + along * u.y };
const tip = { x: 2 * foot.x - right, y: 2 * foot.y - bottom };

// The front page's outline: three rounded corners and the dog-ear's crease at the fourth.
const front = [
  `M ${sheet.x + radius} ${sheet.y}`,
  `H ${right - radius}`,
  `A ${radius} ${radius} 0 0 1 ${right} ${sheet.y + radius}`,
  `V ${creaseB.y}`,
  `L ${creaseA.x} ${creaseA.y}`,
  `H ${sheet.x + radius}`,
  `A ${radius} ${radius} 0 0 1 ${sheet.x} ${bottom - radius}`,
  `V ${sheet.y + radius}`,
  `A ${radius} ${radius} 0 0 1 ${sheet.x + radius} ${sheet.y}`,
  'Z',
].join(' ');

// Every page still to come turns about the pin by 1.5° times the natural log of its index,
// as the real stack's rotate does, so each adds less than the one before.
const fan = [2, 3, 4].map((index) => 1.5 * Math.log(index));

// The gem clip as the real one is drawn: a 28 by 64 box whose point (87.5%, 78.125%) sits on
// the pin, leaning with the resting crease, 0.875 of the lean's width across. The under wire
// paints beneath the page, so only its bend shows past the top edge; the over wire is the
// bar pressing on the page.
const clipWidth = 0.875 * lean.x * Math.sin(Math.atan2(lean.y, lean.x));
const clipScale = clipWidth / 28;
const clipAngle = (Math.atan2(lean.x, lean.y) * 180) / Math.PI;
const clipTransform = `translate(${pin.x} ${pin.y}) rotate(${clipAngle}) scale(${clipScale}) translate(-24.5 -50)`;
---

<div class="wrapper">
  <Annotations scale={annotationScale} reach={1.25}>
    <svg class="pile-drawing" viewBox="-20 -24 405 214" slot="content" aria-hidden="true">
      {/* The pages still to come, hindmost first, each a sheet like the front one. */}
      <g data-part="fan">
        {[...fan].reverse().map((angle) => (
          <g transform={`rotate(${angle} ${pin.x} ${pin.y})`}>
            <rect class="paper" x={sheet.x} y={sheet.y} width={sheet.w} height={sheet.h} rx={radius} />
            <rect class="frame" x={sheet.x + em} y={sheet.y + em} width={sheet.w - 2 * em} height={sheet.h - 2 * em} />
          </g>
        ))}
      </g>

      {/* The clip's back bar, under the page: only its bend shows past the top edge. */}
      <g data-part="clip" transform={clipTransform}>
        <path class="wire" d="M5 22 V50 a9 9 0 0 0 18 0 V14 a6.25 6.25 0 0 0 -12.5 0" />
      </g>

      {/* The front page, its bottom-right corner cut on the dog-ear's crease, and what it carries. */}
      <g data-part="front">
        <path class="paper" d={front} />
        <g transform={`translate(${sheet.x} ${sheet.y})`}>
          <MiniPage w={sheet.w} h={sheet.h} />
        </g>
      </g>

      {/* The dog-ear: the corner folded over the crease, the sheet's back showing. */}
      <polygon class="paper flap" data-part="ear" points={`${creaseA.x},${creaseA.y} ${creaseB.x},${creaseB.y} ${tip.x},${tip.y}`} />

      {/* The clip's front bar, pressing on the page. */}
      <g transform={clipTransform}>
        <path class="wire" d="M10.5 14 V44 a4 4 0 0 0 8 0 V22" />
      </g>
    </svg>

    <Fragment slot="annotations">
      <ArrowAnnotation
        target='[data-part="clip"]'
        anchor="top"
        tipX={0.02}
        tipY={-0.05}
        angle={60}
        length={0.3}
        fontSize={annotationFontSize}
        text="the clip, on the pin"
      />
      <ArrowAnnotation
        target='[data-part="front"]'
        anchor="0.62 0"
        tipX={0.4}
        tipY={0.05}
        angle={90}
        length={0.22}
        fontSize={annotationFontSize}
        text="front page, --page-index 1"
      />
      <ArrowAnnotation
        target='[data-part="ear"]'
        anchor="center"
        tipX={0.68}
        tipY={0.42}
        angle={45}
        length={0.4}
        fontSize={annotationFontSize}
        text="dog-ear, 2cm by 1cm"
      />
      <ArrowAnnotation
        target='[data-part="fan"]'
        anchor="0.9 0.98"
        tipX={0.55}
        tipY={0.62}
        angle={-30}
        length={0.35}
        fontSize={annotationFontSize}
        text="pages to come, fanned about the pin"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include sheet-type;

  display: grid;
  justify-items: center;
  align-content: center;
  max-width: min(92cqw, 100%);
  margin-inline: auto;

  > :global(.content) {
    width: min(100%, 44em);
  }
}

.pile-drawing {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;

  // Every sheet wears the real page's hairline edge and its own frame line inside the mat.
  .paper,
  .frame {
    @include line-art;
    stroke: var(--line-strong);
  }

  .paper {
    fill: var(--sheet-paper);
  }

  .flap {
    fill: color-mix(in oklch, var(--sheet-paper), var(--ink) 12%);
  }

  .wire {
    @include line-art(1.5);
    stroke: var(--ink-muted);
  }
}
</style>
