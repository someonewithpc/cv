---
/**
 * The stack in plan: the front sheet, the sheets still to come fanned below it about the pin,
 * the sheets already turned risen above its top edge, the clip on the pin and the dog-ear at
 * rest. Drawn the way PaperStack/index.astro lays it out, with the small angles and rises
 * exaggerated so they read at this size.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

const annotationScale = 0.6;
const annotationFontSize = 0.1 * annotationScale;

// The front sheet's box and its folded-back corner (the lean is 1 in 2, as on a wide sheet).
const sheet = { x: 40, y: 44, w: 160, h: 80 };
const lean = { x: 9, y: 18 };
const pin = { x: sheet.x + lean.x / 2, y: sheet.y + lean.y / 2 };
const right = sheet.x + sheet.w;
const bottom = sheet.y + sheet.h;

// A sheet with its top-left corner cut on the resting crease.
const cut = (dx = 0, dy = 0) => [
  [sheet.x + lean.x + dx, sheet.y + dy],
  [right + dx, sheet.y + dy],
  [right + dx, bottom + dy],
  [sheet.x + dx, bottom + dy],
  [sheet.x + dx, sheet.y + lean.y + dy],
].map(([x, y]) => `${x},${y}`).join(' ');

// The dog-ear: the crease from (right - 20, bottom) to (right, bottom - 10), a 2:1 rest, and
// the corner reflected across it.
const ear = { x: 20, y: 10 };
const creaseA = { x: right - ear.x, y: bottom };
const creaseB = { x: right, y: bottom - ear.y };
const d = { x: creaseB.x - creaseA.x, y: creaseB.y - creaseA.y };
const len = Math.hypot(d.x, d.y);
const u = { x: d.x / len, y: d.y / len };
const along = (right - creaseA.x) * u.x + (bottom - creaseA.y) * u.y;
const foot = { x: creaseA.x + along * u.x, y: creaseA.y + along * u.y };
const tip = { x: 2 * foot.x - right, y: 2 * foot.y - bottom };

// The fan splays each page about the pin by 1.5° times the log of its index; three times
// that here so the edges show. The pile rises half an em per log2 of the rank and drifts
// back an eighth of an em per rank, scaled up the same way.
const fan = [2, 3, 4].map((index) => 4.5 * Math.log(index));
const pile = [1, 2].map((rank) => ({ rise: 6 * Math.log2(1 + rank), drift: 1.5 * rank }));

const clipAngle = (Math.atan2(lean.x, lean.y) * 180) / Math.PI;
---

<div class="wrapper">
  <p class="point typewriter">One grid cell, every page in it</p>

  <Annotations scale={annotationScale} reach={1.25}>
    <svg class="pile-drawing" viewBox="-70 -30 380 220" slot="content" aria-hidden="true">
      {/* Behind everything: the pages already turned, the most recent furthest out. */}
      <g data-part="pile">
        {[...pile].reverse().map(({ rise, drift }) => (
          <polygon class="paper turned" points={cut(-drift, -rise)} />
        ))}
      </g>

      {/* The pages still to come, hindmost first. */}
      <g data-part="fan">
        {[...fan].reverse().map((angle) => (
          <polygon class="paper" points={cut()} transform={`rotate(${angle} ${pin.x} ${pin.y})`} />
        ))}
      </g>

      {/* The front page, its bottom-right corner cut on the dog-ear's crease. */}
      <polygon
        class="paper front"
        data-part="front"
        points={`${sheet.x + lean.x},${sheet.y} ${right},${sheet.y} ${creaseB.x},${creaseB.y} ${creaseA.x},${creaseA.y} ${sheet.x},${bottom} ${sheet.x},${sheet.y + lean.y}`}
      />
      <text class="index" x={sheet.x + 14} y={sheet.y + 32}>1</text>

      {/* The dog-ear: the corner folded over the crease, the sheet's back showing. */}
      <polygon class="paper flap" data-part="ear" points={`${creaseA.x},${creaseA.y} ${creaseB.x},${creaseB.y} ${tip.x},${tip.y}`} />

      {/* The clip on the pin, leaning with the resting crease. */}
      <g data-part="clip" transform={`translate(${pin.x} ${pin.y}) rotate(${clipAngle})`}>
        <path class="wire" d="M-3 -4 V7 a4 4 0 0 0 8 0 V-9 a2.5 2.5 0 0 0 -5 0 V4" />
      </g>
    </svg>

    <Fragment slot="annotations">
      <ArrowAnnotation
        target='[data-part="front"]'
        anchor="0.5 0.62"
        tipX={0}
        tipY={0.13}
        angle={-75}
        length={0.55}
        fontSize={annotationFontSize}
        text="front page, --page-index 1"
      />
      <ArrowAnnotation
        target='[data-part="fan"]'
        anchor="0.97 0.9"
        tipX={0.41}
        tipY={0.49}
        angle={-15}
        length={0.35}
        fontSize={annotationFontSize}
        text="still to come, 1.5° × log n"
      />
      <ArrowAnnotation
        target='[data-part="pile"]'
        anchor="0.5 0.05"
        tipX={-0.06}
        tipY={-0.4}
        angle={70}
        length={0.4}
        fontSize={annotationFontSize}
        text="already read, risen ½em × log₂ rank"
      />
      <ArrowAnnotation
        target='[data-part="clip"]'
        anchor="0 0.5"
        tipX={-0.42}
        tipY={-0.25}
        angle={180}
        length={0.3}
        labelSide="left"
        fontSize={annotationFontSize}
        text="the pin, under the clip"
      />
      <ArrowAnnotation
        target='[data-part="ear"]'
        anchor="center"
        tipX={0.37}
        tipY={0.32}
        angle={20}
        length={0.4}
        fontSize={annotationFontSize}
        text="dog-ear at rest, 2cm × 1cm"
      />
    </Fragment>
  </Annotations>

  <p class="footnote">
    Paint order is <code>order: calc(-1 * var(--page-index))</code>. A turn renumbers every page
    and the splay eases to the new count.
  </p>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include sheet-type;

  display: grid;
  justify-items: center;
  align-content: center;
  row-gap: 0.5em;
  max-width: min(92cqw, 100%);
  margin-inline: auto;

  > :global(.content) {
    width: min(100%, 38em);
  }
}

.point {
  @include point;
}

.pile-drawing {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;

  .paper {
    @include line-art;
    fill: var(--sheet-paper);
  }

  .turned {
    fill: color-mix(in oklch, var(--sheet-paper), var(--ink) 6%);
  }

  .flap {
    fill: color-mix(in oklch, var(--sheet-paper), var(--ink) 12%);
  }

  .wire {
    @include line-art;
    stroke: var(--ink-muted);
    stroke-width: 1.5;
  }

  .index {
    font-family: "Special Elite", monospace, system-ui;
    font-size: 14px;
    fill: var(--ink-faint);
  }
}

.footnote {
  margin: 0;
  font-size: max(0.5rem, 0.6875em);
  line-height: 1.35;
  color: var(--ink-muted);
  text-align: center;
  text-wrap: pretty;

  code {
    font-family: monospace, system-ui;
  }
}
</style>
