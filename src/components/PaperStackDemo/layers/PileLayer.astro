---
/**
 * The stack in plan: the front page with what a page carries, the pages still to come fanned
 * below it about the pin, the pages already turned risen above its top edge, the clip on the
 * pin and the dog-ear at rest. Drawn the way PaperStack/index.astro lays it out, with the
 * small angles and rises exaggerated so they read at this size.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

import MiniPage from './MiniPage.astro';

const annotationScale = 0.6;
const annotationFontSize = 0.1 * annotationScale;

// The front page's box and its folded-back corner (the lean is 1 in 2, as on a wide sheet).
const sheet = { x: 30, y: 30, w: 240, h: 120 };
const lean = { x: 12, y: 24 };
const pin = { x: sheet.x + lean.x / 2, y: sheet.y + lean.y / 2 };
const right = sheet.x + sheet.w;
const bottom = sheet.y + sheet.h;

// A page with its top-left corner cut on the resting crease.
const cut = (dx = 0, dy = 0) => [
  [sheet.x + lean.x + dx, sheet.y + dy],
  [right + dx, sheet.y + dy],
  [right + dx, bottom + dy],
  [sheet.x + dx, bottom + dy],
  [sheet.x + dx, sheet.y + lean.y + dy],
].map(([x, y]) => `${x},${y}`).join(' ');

// The dog-ear: a 2:1 rest, and the corner reflected across its crease.
const ear = { x: 20, y: 10 };
const creaseA = { x: right - ear.x, y: bottom };
const creaseB = { x: right, y: bottom - ear.y };
const d = { x: creaseB.x - creaseA.x, y: creaseB.y - creaseA.y };
const len = Math.hypot(d.x, d.y);
const u = { x: d.x / len, y: d.y / len };
const along = (right - creaseA.x) * u.x + (bottom - creaseA.y) * u.y;
const foot = { x: creaseA.x + along * u.x, y: creaseA.y + along * u.y };
const tip = { x: 2 * foot.x - right, y: 2 * foot.y - bottom };

// The fan splays each page about the pin by 1.5° times the log of its index; twice that
// here so the edges show. The pile rises half an em per log2 of the rank and drifts back
// an eighth of an em per rank, scaled up the same way.
const fan = [2, 3, 4].map((index) => 3 * Math.log(index));
const pile = [1, 2].map((rank) => ({ rise: 7 * Math.log2(1 + rank), drift: 2 * rank }));

const clipAngle = (Math.atan2(lean.x, lean.y) * 180) / Math.PI;
---

<div class="wrapper">
  <p class="point typewriter">The pile from above</p>

  <Annotations scale={annotationScale} reach={1.25}>
    <svg class="pile-drawing" viewBox="-85 -32 470 222" slot="content" aria-hidden="true">
      <defs>
        {/* The pages under the front one are blueprints, ruled like the real ones. */}
        <pattern id="pile-blueprint" patternUnits="userSpaceOnUse" width="10" height="10">
          <rect class="blueprint" width="10" height="10" />
          <path class="blueprint-rule" d="M 10 0 V 10 M 0 10 H 10" />
        </pattern>
      </defs>

      {/* Behind everything: the pages already turned, the most recent furthest out. */}
      <g data-part="pile">
        {[...pile].reverse().map(({ rise, drift }) => (
          <polygon class="paper turned" points={cut(-drift, -rise)} />
        ))}
      </g>

      {/* The pages still to come, hindmost first. */}
      <g data-part="fan">
        {[...fan].reverse().map((angle) => (
          <polygon class="paper ruled" points={cut()} transform={`rotate(${angle} ${pin.x} ${pin.y})`} />
        ))}
      </g>

      {/* The front page, its bottom-right corner cut on the dog-ear's crease, and what it carries. */}
      <g data-part="front">
        <polygon
          class="paper front"
          points={`${sheet.x + lean.x},${sheet.y} ${right},${sheet.y} ${creaseB.x},${creaseB.y} ${creaseA.x},${creaseA.y} ${sheet.x},${bottom} ${sheet.x},${sheet.y + lean.y}`}
        />
        <g transform={`translate(${sheet.x} ${sheet.y})`}>
          <MiniPage w={sheet.w} h={sheet.h} />
        </g>
      </g>

      {/* The dog-ear: the corner folded over the crease, the sheet's back showing. */}
      <polygon class="paper flap" data-part="ear" points={`${creaseA.x},${creaseA.y} ${creaseB.x},${creaseB.y} ${tip.x},${tip.y}`} />

      {/* The clip on the pin, leaning with the resting crease. */}
      <g data-part="clip" transform={`translate(${pin.x} ${pin.y}) rotate(${clipAngle})`}>
        <path class="wire" d="M-3.5 -5 V8 a4.5 4.5 0 0 0 9 0 V-10 a3 3 0 0 0 -6 0 V5" />
      </g>
    </svg>

    <Fragment slot="annotations">
      <ArrowAnnotation
        target='[data-part="pile"]'
        anchor="0.55 0"
        tipX={0.05}
        tipY={-0.45}
        angle={75}
        length={0.35}
        fontSize={annotationFontSize}
        text="pages already read, risen"
      />
      <ArrowAnnotation
        target='[data-part="front"]'
        anchor="0.1 0.55"
        tipX={-0.6}
        tipY={0.1}
        angle={180}
        length={0.3}
        labelSide="left"
        fontSize={annotationFontSize}
        text="front page, --page-index 1"
      />
      <ArrowAnnotation
        target='[data-part="ear"]'
        anchor="center"
        tipX={0.68}
        tipY={0.42}
        angle={45}
        length={0.4}
        fontSize={annotationFontSize}
        text="dog-ear, 2cm by 1cm"
      />
      <ArrowAnnotation
        target='[data-part="fan"]'
        anchor="0.9 0.98"
        tipX={0.55}
        tipY={0.62}
        angle={-30}
        length={0.35}
        fontSize={annotationFontSize}
        text="pages to come, fanned about the pin"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include sheet-type;

  display: grid;
  justify-items: center;
  align-content: center;
  row-gap: 0.375em;
  max-width: min(92cqw, 100%);
  margin-inline: auto;

  > :global(.content) {
    width: min(100%, 44em);
  }
}

.point {
  @include point;
}

.pile-drawing {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;

  .paper {
    @include line-art;
    fill: var(--sheet-paper);
  }

  .ruled {
    fill: url(#pile-blueprint);
  }

  .blueprint {
    fill: var(--blueprint);
  }

  .blueprint-rule {
    stroke: var(--blueprint-grid);
    stroke-width: 0.5;
    fill: none;
  }

  .turned {
    fill: color-mix(in oklch, var(--sheet-paper), var(--ink) 6%);
  }

  .flap {
    fill: color-mix(in oklch, var(--sheet-paper), var(--ink) 12%);
  }

  .wire {
    @include line-art;
    stroke: var(--ink-muted);
    stroke-width: 1.5;
  }
}
</style>
