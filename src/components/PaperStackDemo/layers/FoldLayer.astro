---
/**
 * The fold as PaperStack/index.astro draws it: three panels, one per layer, in the order
 * they are painted, then the drag on a page of its own with the points a release is judged
 * on. One fold size throughout, 60 by 40 on a 120 by 60 page, past the commit point, so the
 * release drawn would turn the page.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

// The drag panel is a page and a margin, so its labels are at the sheet's callout size
// rather than the small panels' and stay inside the panel, where nothing mirrors them.
const annotationScale = 1;
const annotationFontSize = 0.1 * annotationScale;

const w = 120;
const h = 60;
const fold = { x: 60, y: 40 };

// The crease runs from (w - fold.x, h) to (w, h - fold.y); the tip is the corner reflected
// across it (foldTipFromSize in fold-drag.ts, in sheet coordinates).
const a = { x: w - fold.x, y: h };
const b = { x: w, y: h - fold.y };
const d = { x: b.x - a.x, y: b.y - a.y };
const len = Math.hypot(d.x, d.y);
const u = { x: d.x / len, y: d.y / len };
const along = (w - a.x) * u.x + (h - a.y) * u.y;
const foot = { x: a.x + along * u.x, y: a.y + along * u.y };
const tip = { x: 2 * foot.x - w, y: 2 * foot.y - h };
const commit = { x: (w * 3) / 4, y: (h * 3) / 4 };

const pt = (p: { x: number, y: number }) => `${p.x},${p.y}`;
const flap = [a, b, tip].map(pt).join(' ');
const hole = [{ x: 0, y: 0 }, { x: w, y: 0 }, b, a, { x: 0, y: h }].map(pt).join(' ');
// The cast shadow: a band on the far side of the crease from the flap, gone 12 in.
const shade = [a, b, { x: b.x - 12 * u.y, y: b.y + 12 * u.x }, { x: a.x - 12 * u.y, y: a.y + 12 * u.x }].map(pt).join(' ');

const panels = [
  { part: 'page', caption: 'the page, cut on the crease' },
  { part: 'shade', caption: 'the shade, on the clip wrapper' },
  { part: 'flap', caption: 'the flap, the back mirrored over' },
] as const;
---

<div class="wrapper">
  <p class="point typewriter">How a fold is drawn</p>

  <ol class="layers">
    {panels.map(({ part, caption }) => (
      <li>
        <svg class="fold-drawing" viewBox="-6 -6 132 72" aria-hidden="true">
          {part === 'page' && (
            <>
              <polygon class="paper" points={hole} />
              {[14, 24, 34, 44].map((y) => <line class="rule" x1="10" y1={y} x2={y > 30 ? 46 : 100} y2={y} />)}
            </>
          )}
          {part === 'shade' && (
            <>
              <rect class="ghost" width={w} height={h} />
              <polygon class="shade" points={shade} />
            </>
          )}
          {part === 'flap' && (
            <>
              <rect class="ghost" width={w} height={h} />
              <polygon class="paper flap" points={flap} />
            </>
          )}
        </svg>
        <span class="caption">{caption}</span>
      </li>
    ))}
  </ol>

  <Annotations seed="paper-stack-fold" scale={annotationScale} reach={1}>
    <svg class="fold-drawing drag" viewBox="-24 -12 168 84" slot="content" aria-hidden="true">
      <rect class="paper" width={w} height={h} />
      <polygon class="paper flap" points={flap} />
      <line class="crease" data-part="crease" x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
      <line class="rule" x1={w} y1={h} x2={tip.x} y2={tip.y} />
      <circle class="mark" data-part="tip" cx={tip.x} cy={tip.y} r="2.5" />
      <circle class="mark" data-part="corner" cx={w} cy={h} r="2.5" />
      <g class="mark" data-part="commit" transform={`translate(${commit.x} ${commit.y})`}>
        <line x1="-3" y1="-3" x2="3" y2="3" />
        <line x1="-3" y1="3" x2="3" y2="-3" />
      </g>
      <text class="letter" x={tip.x - 9} y={tip.y + 2}>T</text>
      <text class="letter" x={w + 3} y={h + 3}>C</text>
    </svg>

    <Fragment slot="annotations">
      <ArrowAnnotation
        target='[data-part="tip"]'
        anchor="center"
        tipX={0.1}
        tipY={-0.6}
        angle={150}
        length={0.4}
        labelSide="left"
        fontSize={annotationFontSize}
        text="T, the pointer"
      />
      <ArrowAnnotation
        target='[data-part="corner"]'
        anchor="center"
        tipX={0.55}
        tipY={0.72}
        angle={-20}
        length={0.4}
        fontSize={annotationFontSize}
        text="C, the corner"
      />
      <ArrowAnnotation
        target='[data-part="crease"]'
        anchor="0.1 0.9"
        tipX={-0.1}
        tipY={0.62}
        angle={180}
        length={0.5}
        labelSide="left"
        fontSize={annotationFontSize}
        text="the crease, halfway"
      />
      <ArrowAnnotation
        target='[data-part="commit"]'
        anchor="center"
        tipX={0.19}
        tipY={0.36}
        angle={-100}
        length={0.5}
        fontSize={annotationFontSize}
        text="commit point, ¾ in"
      />
    </Fragment>
  </Annotations>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include sheet-type;

  display: grid;
  justify-items: center;
  align-content: center;
  row-gap: 0.5em;
  max-width: min(92cqw, 100%);
  margin-inline: auto;

  > :global(.content) {
    width: min(100%, 26em);
  }
}

.point {
  @include point;
}

// The three layers in a row, in paint order.
.layers {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.75em;
  width: 100%;
  max-width: 44em;
  margin: 0;
  padding: 0;
  list-style: none;
  counter-reset: layer;

  li {
    display: grid;
    gap: 0.125em;
    counter-increment: layer;
  }

  .caption::before {
    content: counter(layer) ' ';
    color: var(--ink-muted);
  }
}

.caption {
  margin: 0;
  font-family: "Special Elite", monospace, system-ui;
  font-size: max(0.5rem, 0.75em);
  line-height: 1.25;
  text-align: center;
  text-wrap: balance;
}

.fold-drawing {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;

  .paper {
    @include line-art;
    fill: var(--sheet-paper);
  }

  .flap {
    fill: color-mix(in oklch, var(--sheet-paper), var(--ink) 12%);
  }

  .ghost {
    @include line-art;
    stroke: var(--line);
    stroke-dasharray: 3 3;
  }

  .shade {
    fill: var(--ink);
    fill-opacity: 0.22;
  }

  .rule {
    @include line-art;
    stroke: var(--line-strong);
  }

  .crease {
    @include line-art;
    stroke-dasharray: 4 2;
  }

  .mark {
    @include line-art;
    fill: var(--sheet-paper);
  }

  .letter {
    font-family: "Special Elite", monospace, system-ui;
    font-size: 0.5rem;
    fill: var(--ink);
  }
}
</style>
