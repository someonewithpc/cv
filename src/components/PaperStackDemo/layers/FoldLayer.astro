---
/**
 * The fold, exploded into the three layers PaperStack/index.astro draws it with, and the
 * geometry a drag works on: the corner, the tip under the pointer and the crease between
 * them. One fold size for both figures, 60 by 40 on a 120 by 60 sheet, past the commit
 * point so the release on the right would turn the page.
 */
import Annotations from '@/components/TechnicalDrawing/Annotations.astro';
import ArrowAnnotation from '@/components/TechnicalDrawing/ArrowAnnotation.astro';

const annotationScale = 0.6;
const annotationFontSize = 0.1 * annotationScale;

const w = 120;
const h = 60;
const fold = { x: 60, y: 40 };

// The crease runs from (w - fold.x, h) to (w, h - fold.y); the tip is the corner reflected
// across it (foldTipFromSize in fold-drag.ts, in sheet coordinates).
const a = { x: w - fold.x, y: h };
const b = { x: w, y: h - fold.y };
const d = { x: b.x - a.x, y: b.y - a.y };
const len = Math.hypot(d.x, d.y);
const u = { x: d.x / len, y: d.y / len };
const along = (w - a.x) * u.x + (h - a.y) * u.y;
const foot = { x: a.x + along * u.x, y: a.y + along * u.y };
const tip = { x: 2 * foot.x - w, y: 2 * foot.y - h };
const commit = { x: (w * 3) / 4, y: (h * 3) / 4 };

const pt = (p: { x: number, y: number }) => `${p.x},${p.y}`;
const flap = [a, b, tip].map(pt).join(' ');
const hole = [{ x: 0, y: 0 }, { x: w, y: 0 }, b, a, { x: 0, y: h }].map(pt).join(' ');
// The cast shadow: a band on the far side of the crease from the flap, gone 12 in.
const shade = [a, b, { x: b.x - 12 * u.y, y: b.y + 12 * u.x }, { x: a.x - 12 * u.y, y: a.y + 12 * u.x }].map(pt).join(' ');

// Where each figure stands in the drawing.
const layers = [
  { at: { x: 40, y: 90 }, part: 'page' },
  { at: { x: 65, y: 60 }, part: 'shade' },
  { at: { x: 90, y: 30 }, part: 'flap' },
];
const drag = { x: 260, y: 50 };

const notes = [
  'A pointer drags the dog-ear. The release reads where a throw would coast to: 120 ms at the speed of the last 100 ms.',
  'A sideways wheel or trackpad scroll walks the same fold. It ends once the wheel has been quiet for four gaps, 140 to 800 ms.',
  'A finger turns the page after 8 px sideways. Up or down first, and the page scrolls instead.',
  'The arrow keys turn on the spot. There is no hand on the paper to wait for.',
  'The folded-back corner at the top left brings the last page back. It commits a quarter of the diagonal in.',
];
---

<div class="wrapper">
  <p class="point typewriter">Three layers, one crease</p>

  <Annotations scale={annotationScale} reach={1}>
    <svg class="fold-drawing" viewBox="-60 -30 460 220" slot="content" aria-hidden="true">
      {/* The exploded view, bottom layer first. */}
      {layers.map(({ at, part }) => (
        <g data-layer={part} transform={`translate(${at.x} ${at.y})`}>
          {part === 'page' && (
            <>
              <polygon class="paper" points={hole} />
              {[14, 24, 34, 44].map((y) => <line class="rule" x1="10" y1={y} x2={y > 30 ? 46 : 100} y2={y} />)}
            </>
          )}
          {part === 'shade' && (
            <>
              <rect class="ghost" width={w} height={h} />
              <polygon class="shade" points={shade} />
            </>
          )}
          {part === 'flap' && (
            <>
              <rect class="ghost" width={w} height={h} />
              <polygon class="paper flap" points={flap} />
            </>
          )}
        </g>
      ))}

      {/* The drag: the sheet, the corner, the tip and the crease between them. */}
      <g data-figure="drag" transform={`translate(${drag.x} ${drag.y})`}>
        <rect class="paper" width={w} height={h} />
        <polygon class="paper flap" points={flap} />
        <line class="crease" data-part="crease" x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
        <line class="rule" x1={w} y1={h} x2={tip.x} y2={tip.y} />
        <circle class="mark" cx={tip.x} cy={tip.y} r="2.5" />
        <circle class="mark" cx={w} cy={h} r="2.5" />
        <g class="mark" data-part="commit" transform={`translate(${commit.x} ${commit.y})`}>
          <line x1="-3" y1="-3" x2="3" y2="3" />
          <line x1="-3" y1="3" x2="3" y2="-3" />
        </g>
        <text class="letter" x={tip.x - 9} y={tip.y + 2}>T</text>
        <text class="letter" x={w + 3} y={h + 3}>C</text>
      </g>
    </svg>

    <Fragment slot="annotations">
      <ArrowAnnotation
        target='[data-layer="page"]'
        anchor="0.8 0.75"
        tipX={-0.15}
        tipY={0.5}
        angle={-80}
        length={0.35}
        fontSize={annotationFontSize}
        text="page content, cut on the crease"
      />
      <ArrowAnnotation
        target='[data-layer="shade"]'
        anchor="0.8 0.7"
        tipX={-0.04}
        tipY={0.2}
        angle={100}
        length={1}
        fontSize={annotationFontSize}
        text="shade on the clip wrapper, darkest on the crease"
      />
      <ArrowAnnotation
        target='[data-layer="flap"]'
        anchor="0.75 0.5"
        tipX={0.04}
        tipY={-0.18}
        angle={30}
        length={0.5}
        fontSize={annotationFontSize}
        text="flap, the sheet's back mirrored across the crease"
        lines={["flap, the sheet's back", "mirrored across the crease"]}
      />
      <ArrowAnnotation
        target='[data-part="commit"]'
        anchor="bottom-right"
        tipX={0.78}
        tipY={0.14}
        angle={-150}
        length={0.5}
        fontSize={annotationFontSize}
        text="commit point, ¾ w ¾ h"
      />
      <ArrowAnnotation
        target='[data-part="crease"]'
        anchor="0.15 0.85"
        tipX={0.69}
        tipY={0.22}
        angle={-110}
        length={0.5}
        labelSide="left"
        fontSize={annotationFontSize}
        text="crease, halfway between C and T"
      />
    </Fragment>
  </Annotations>

  <aside class="notes">
    <span class="notes-heading">Ways to turn</span>
    <ol>
      {notes.map((note) => <li>{note}</li>)}
    </ol>
  </aside>
</div>

<style lang="scss">
@use "./sheet" as *;

.wrapper {
  @include sheet-content;
  @include sheet-type;

  display: grid;
  justify-items: center;
  align-content: center;
  row-gap: 0.5em;
  max-width: min(92cqw, 100%);
  margin-inline: auto;

  > :global(.content) {
    width: min(100%, 40em);
  }
}

.point {
  @include point;
}

.fold-drawing {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;

  .paper {
    @include line-art;
    fill: var(--sheet-paper);
  }

  .flap {
    fill: color-mix(in oklch, var(--sheet-paper), var(--ink) 12%);
  }

  .ghost {
    @include line-art;
    stroke: var(--line);
    stroke-dasharray: 3 3;
  }

  .shade {
    fill: var(--ink);
    fill-opacity: 0.22;
  }

  .rule {
    @include line-art;
    stroke: var(--line-strong);
  }

  .crease {
    @include line-art;
    stroke-dasharray: 4 2;
  }

  .mark {
    @include line-art;
    fill: var(--sheet-paper);
  }

  .letter {
    font-family: "Special Elite", monospace, system-ui;
    font-size: 8px;
    fill: var(--ink);
  }
}

.notes {
  @include drawing-notes;

  width: 100%;

  ol {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  :global([data-sheet-orientation='portrait']) & ol {
    grid-template-columns: minmax(0, 1fr);
  }
}
</style>
