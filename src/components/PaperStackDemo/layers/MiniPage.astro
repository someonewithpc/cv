---
/**
 * What a page of the stack carries, drawn small: the frame line inside the mat, a heading,
 * a figure with one callout on it, two lines of type, the note in the right-hand column and
 * the title block in the bottom-right corner. Laid out the way TechnicalDrawing/Page.astro
 * lays the real page out, at whatever size the caller gives it, and in line art so it reads
 * on paper and on the blueprint alike. The caller draws the page's own outline and fill.
 */
type Props = { w: number; h: number };

const { w, h } = Astro.props;

// The mat is 1rem on a sheet about 30rem wide.
const m = Math.round(w / 30);
const frame = { x: m, y: m, w: w - 2 * m, h: h - 2 * m };
const col = frame.w / 3;
const inner = { x: frame.x + m, y: frame.y + m, w: 2 * col - 2 * m, h: frame.h - 2 * m };

const heading = { y: inner.y + inner.h * 0.14, x1: inner.x + inner.w * 0.28, x2: inner.x + inner.w * 0.72 };
const figure = { x: inner.x + inner.w * 0.06, y: inner.y + inner.h * 0.3, w: inner.w * 0.5, h: inner.h * 0.4 };
const callout = {
  tip: { x: figure.x + figure.w * 0.72, y: figure.y + figure.h * 0.5 },
  end: { x: figure.x + figure.w + inner.w * 0.08, y: figure.y + figure.h * 0.08 },
  run: inner.w * 0.24,
};
const type = [0.8, 0.9].map((f, i) => ({ y: inner.y + inner.h * f, w: inner.w * (i ? 0.55 : 0.78) }));
const note = { x: frame.x + 2 * col + m, y: inner.y + inner.h * 0.1, w: col - 2 * m, h: inner.h * 0.44 };
const block = { w: Math.round(w * 0.36), h: Math.round(h * 0.2) };
const blockAt = { x: frame.x + frame.w - block.w, y: frame.y + frame.h - block.h };
const tech = block.h;
const nameRow = blockAt.y + block.h * 0.45;
const cells = [1, 2, 3].map((n) => blockAt.x + tech + ((block.w - tech) * n) / 4);
const pt = (p: { x: number; y: number }) => `${p.x},${p.y}`;
---

<g class="mini-page">
  <rect class="fine" x={frame.x} y={frame.y} width={frame.w} height={frame.h} />

  <line class="ink" x1={heading.x1} y1={heading.y} x2={heading.x2} y2={heading.y} />

  <rect class="fine" x={figure.x} y={figure.y} width={figure.w} height={figure.h} rx={m / 4} />
  <polygon
    class="fine"
    points={[
      { x: figure.x + figure.w * 0.18, y: figure.y + figure.h * 0.7 },
      { x: figure.x + figure.w * 0.34, y: figure.y + figure.h * 0.25 },
      { x: figure.x + figure.w * 0.66, y: figure.y + figure.h * 0.25 },
      { x: figure.x + figure.w * 0.5, y: figure.y + figure.h * 0.7 },
    ].map(pt).join(' ')}
  />
  <path class="ink" d={`M ${pt(callout.tip)} L ${pt(callout.end)} h ${callout.run}`} />
  <circle class="ink" cx={callout.tip.x} cy={callout.tip.y} r={m / 5} />
  <line class="faint" x1={callout.end.x + callout.run * 0.1} y1={callout.end.y - m * 0.5} x2={callout.end.x + callout.run * 0.9} y2={callout.end.y - m * 0.5} />

  {type.map(({ y, w: run }) => <line class="faint" x1={inner.x} y1={y} x2={inner.x + run} y2={y} />)}

  <rect class="note" x={note.x} y={note.y} width={note.w} height={note.h} />
  {[0.3, 0.5, 0.7].map((f, i) => (
    <line class="note-line" x1={note.x + note.w * 0.15} y1={note.y + note.h * f} x2={note.x + note.w * (i === 2 ? 0.55 : 0.85)} y2={note.y + note.h * f} />
  ))}

  <g class="title-block">
    <rect class="fine paper" x={blockAt.x} y={blockAt.y} width={block.w} height={block.h} />
    <line class="fine" x1={blockAt.x + tech} y1={blockAt.y} x2={blockAt.x + tech} y2={blockAt.y + block.h} />
    <line class="fine" x1={blockAt.x + tech} y1={nameRow} x2={blockAt.x + block.w} y2={nameRow} />
    {cells.map((x) => <line class="fine" x1={x} y1={nameRow} x2={x} y2={blockAt.y + block.h} />)}
    <rect class="faint" x={blockAt.x + tech * 0.25} y={blockAt.y + tech * 0.25} width={tech * 0.5} height={tech * 0.5} />
    <line class="ink" x1={blockAt.x + tech + m * 0.5} y1={(blockAt.y + nameRow) / 2} x2={blockAt.x + tech + (block.w - tech) * 0.5} y2={(blockAt.y + nameRow) / 2} />
    <text class="index" x={blockAt.x + tech + m * 0.5} y={blockAt.y + block.h - m * 0.35} font-size={(block.h - (nameRow - blockAt.y)) * 0.8}>1</text>
  </g>
</g>

<style lang="scss">
@use "./sheet" as *;

.mini-page {
  .ink,
  .fine,
  .faint {
    @include line-art;
  }

  .fine {
    stroke: var(--line-strong);
  }

  .faint {
    stroke: var(--ink-faint);
  }

  .paper {
    fill: var(--sheet-paper);
  }

  // The note is the same paper on every theme and on the blueprint, as the real one is.
  .note {
    fill: #ea1;
    fill-opacity: 0.85;
  }

  .note-line {
    stroke: #000;
    stroke-opacity: 0.6;
    stroke-width: 1;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .index {
    font-family: "Special Elite", monospace, system-ui;
    fill: var(--ink);
  }
}
</style>
