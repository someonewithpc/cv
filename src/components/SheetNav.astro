---
/**
 * The sheet index on the cover sheet, as a drawing set carries one: every sheet in the set by
 * number and title in one row, each a link to its sheet. It stands with the
 * title block at every width, so a phone, which has no folio in the margin, still says what
 * the set holds and where the Career went once the demos moved above it.
 */
type Sheet = { number: number; title: string; id: string };

/* One entry per Folio in index.astro, in page order; design-mix.spec.ts holds the two to the
   same order. The cover links to its own header, the way back to the top once the index
   is read further down. */
const SHEETS: Sheet[] = [
  { number: 1, id: 'profile', title: 'Hugo Sales' },
  { number: 2, id: 'demos', title: 'Demos' },
  { number: 3, id: 'career', title: 'Career' },
  { number: 4, id: 'bill-of-materials', title: 'Skills' },
  { number: 5, id: 'open-source', title: 'Open Source' },
];
---

<nav class="sheet-nav monospace" aria-label="Sheets">
  <ol>
    {SHEETS.map(({ number, id, title }) => (
      <li data-current={id === 'profile' ? '' : undefined}>
        <span class="no" aria-hidden="true">{String(number).padStart(2, '0')}</span>
        <a href={`#${id}`} aria-current={id === 'profile' ? 'location' : undefined}>{title}</a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.sheet-nav');
  if (nav) {
    const links = new Map(
      [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((link) => [link.hash.slice(1), link]),
    );

    const markCurrent = (id: string) => {
      for (const [sheet, link] of links) {
        const current = sheet === id;
        if (current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
        link.parentElement?.toggleAttribute('data-current', current);
      }
    };

    /* The sheet being read is the one across a line a quarter of the way down the window:
       high enough that the cover still holds it at the top of the page, low enough that a
       link's jump, which puts its sheet's top at the window's top, lands on it. In the desk
       between two sheets the line crosses nothing, and the last sheet stays marked. */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) if (entry.isIntersecting) markCurrent(entry.target.id);
      },
      { rootMargin: '-25% 0px -75% 0px' },
    );
    for (const id of links.keys()) {
      const sheet = document.getElementById(id);
      if (sheet) observer.observe(sheet);
    }
  }
</script>

<style lang="scss">
/* A slip of the same paper as the title block, framed with the hairline the sheets on the
   desk take, so it reads as a strip on the cover and not as a second title block. */
.sheet-nav {
  width: min(100%, 42rem);
  padding: 0.25rem 1rem;
  border: 1px solid var(--line);
  border-radius: 0.25rem;
  background: var(--surface-page);
  box-shadow: var(--sheet-lift);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
}

/* One row, centred, that wraps on a phone; the numbers do the separating. */
ol {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0 1.5ch;
  margin: 0;
  padding: 0;
  list-style: none;
}

li {
  display: inline-flex;
  align-items: center;
  gap: 0.5ch;
}

.no {
  color: var(--ink-faint);
}

/* On the li and not through a :has() on it, which would restyle the page on every insertion. */
[data-current] .no {
  color: var(--accent-text);
}

/* The same link as the contact row in the title block, 1.5rem tall for the touch target. */
a {
  display: inline-flex;
  align-items: center;
  min-height: 1.5rem;
  color: var(--ink);
  text-decoration: underline dotted;
  text-decoration-color: var(--accent-muted);
  text-underline-offset: 0.25em;

  &:hover,
  &:focus-visible {
    color: var(--accent-text);
    text-decoration-style: solid;
    text-decoration-color: currentColor;
  }

  /* The sheet being read is named, not pointed at: no dotted rule under it. */
  &[aria-current] {
    text-decoration-line: none;
  }

  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.125rem;
    border-radius: 0.125rem;
  }
}
</style>
