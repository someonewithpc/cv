---
/**
 * REVIEW ONLY, strip with the ?grain, ?tile and ?theme switches in Layout.astro before this
 * lands on main.
 *
 * Two sliders on the real page: one for the fibre on a drawing stack's sheets, one for the
 * fibre on the contributions paper, per theme. They write --theme-paper-grain and
 * --theme-paper-sheet-grain inline on the html element, which outrank the theme's own rules, so
 * what moves is the shipped mechanism and nothing else. The panel keeps a number for each of
 * the four themes and hands the set back as a table to paste into the pull request.
 *
 * Open it with ?tune on any page. Nothing renders without it.
 */
import picker from './ThemePicker.astro?raw';

/* What each theme ships, read out of ThemePicker's own table at build time. Reading it live
 * off the element is no good: the picker marks the current theme with a checked radio as well
 * as with data-theme, and the rule carrying the id outranks the one carrying the attribute, so
 * no theme can be made current long enough to measure without disturbing the page. */
const THEME_IDS = ['light', 'arctic', 'dark', 'dark-forest'] as const;
const shipped = Object.fromEntries(
  THEME_IDS.map((id) => {
    const block = picker.match(new RegExp(`'?${id}'?: \\{[^}]*?paperGrain: '([\\d.]+)'[^}]*?paperSheetGrain: '([\\d.]+)'`, 's'));
    if (!block) throw new Error(`PaperTuner: no paper grain for ${id} in ThemePicker.astro`);
    return [id, { page: Number(block[1]), sheet: Number(block[2]) }];
  }),
);
---

<aside id="paper-tuner" hidden aria-label="Paper" data-shipped={JSON.stringify(shipped)}>
  <header>
    <strong>Paper</strong>
    <button type="button" data-fold aria-expanded="true">Hide</button>
  </header>
  <div data-body>
    <nav data-themes>
      <button type="button" data-theme-button="light">Light</button>
      <button type="button" data-theme-button="arctic">Arctic</button>
      <button type="button" data-theme-button="dark">Dark</button>
      <button type="button" data-theme-button="dark-forest">Forest</button>
    </nav>
    <label class="row">
      <span>Drawing sheets</span>
      <input type="range" data-slider="page" min="0" max="0.8" step="0.01" />
      <input type="number" data-number="page" min="0" max="1" step="0.01" />
    </label>
    <p class="was" data-was="page"></p>
    <label class="row">
      <span>Contributions</span>
      <input type="range" data-slider="sheet" min="0" max="0.8" step="0.01" />
      <input type="number" data-number="sheet" min="0" max="1" step="0.01" />
    </label>
    <p class="was" data-was="sheet"></p>
    <label class="row">
      <span>Paper</span>
      <input type="color" data-colour="paper" />
      <button type="button" data-clear="paper">Back</button>
    </label>
    <label class="row">
      <span>Blueprint paper</span>
      <input type="color" data-colour="blueprint" />
      <button type="button" data-clear="blueprint">Back</button>
    </label>
    <nav data-jumps>
      <button type="button" data-jump="drawings">Go to the drawings</button>
      <button type="button" data-jump="open-source">Go to contributions</button>
    </nav>
    <textarea data-export readonly rows="6" aria-label="The four themes, to paste back"></textarea>
    <nav data-actions>
      <button type="button" data-copy>Copy</button>
      <button type="button" data-reset>Reset this theme</button>
      <button type="button" data-reset-all>Reset all four</button>
    </nav>
  </div>
</aside>

<script is:inline>
  (() => {
    if (!new URLSearchParams(location.search).has('tune')) return;
    const panel = document.getElementById('paper-tuner');
    if (!panel) return;
    panel.hidden = false;

    const root = document.documentElement;
    const KEY = 'cv-paper-tune';
    const THEMES = ['light', 'arctic', 'dark', 'dark-forest'];
    const PROPERTY = { page: '--theme-paper-grain', sheet: '--theme-paper-sheet-grain' };

    const shipped = JSON.parse(panel.dataset.shipped);

    let edits = {};
    try {
      edits = JSON.parse(localStorage.getItem(KEY) ?? '{}') ?? {};
    } catch {
      edits = {};
    }
    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(edits));
      } catch {
        /* ignore */
      }
    };

    const theme = () =>
      document.querySelector('input[name="theme"]:checked')?.value ??
      root.dataset.theme ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

    const sliders = { page: panel.querySelector('[data-slider="page"]'), sheet: panel.querySelector('[data-slider="sheet"]') };
    const numbers = { page: panel.querySelector('[data-number="page"]'), sheet: panel.querySelector('[data-number="sheet"]') };
    const wases = { page: panel.querySelector('[data-was="page"]'), sheet: panel.querySelector('[data-was="sheet"]') };
    const out = panel.querySelector('[data-export]');

    const round = (n) => Math.round(n * 100) / 100;

    /* The two papers. A plain drawing sheet paints --sheet-paper, which the stylesheet works
       out per theme from the neutral ramp, and a blueprint page paints the same token set to
       the blueprint colour. Neither is a number in ThemePicker's table, so the shipped value
       is read off the page itself: a probe element inside the sheet, given the token as its
       own background, resolves the whole var chain to an rgb() the picker can take. */
    const PLAIN = 'article.technical-drawing-stack > * > section:not(.blueprint)';
    const BLUE = 'article.technical-drawing-stack > * > section.blueprint';
    const pickers = {
      paper: panel.querySelector('[data-colour="paper"]'),
      blueprint: panel.querySelector('[data-colour="blueprint"]'),
    };
    const sheet = document.createElement('style');
    document.head.append(sheet);
    const painted = {};

    const paint2d = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
    const bytes = (colour) => {
      paint2d.clearRect(0, 0, 1, 1);
      paint2d.fillStyle = colour;
      paint2d.fillRect(0, 0, 1, 1);
      return [...paint2d.getImageData(0, 0, 1, 1).data].slice(0, 3);
    };
    const hex = (colour) =>
      '#' + bytes(colour).map((v) => v.toString(16).padStart(2, '0')).join('');

    /* The export says both, because the page is written in oklch and a picker speaks hex. */
    const oklch = (colour) => {
      const [r, g, b] = bytes(colour).map((v) => v / 255);
      const lin = (v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
      const [R, G, B] = [r, g, b].map(lin);
      const l = Math.cbrt(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B);
      const m = Math.cbrt(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B);
      const t = Math.cbrt(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B);
      const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * t;
      const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * t;
      const Bb = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * t;
      return `oklch(${L.toFixed(3)} ${Math.hypot(A, Bb).toFixed(3)} ${(((Math.atan2(Bb, A) * 180) / Math.PI + 360) % 360).toFixed(0)})`;
    };

    const probe = (selector) => {
      const host = document.querySelector(selector);
      if (!host) return '';
      const mark = document.createElement('span');
      mark.style.cssText = 'position:absolute;width:0;height:0;background-color:var(--sheet-paper)';
      host.append(mark);
      const value = getComputedStyle(mark).backgroundColor;
      mark.remove();
      return value;
    };

    /* Read with the overrides off, so what comes back is the theme's own paper. */
    const readPainted = () => {
      const held = sheet.textContent;
      sheet.textContent = '';
      const value = { paper: probe(PLAIN), blueprint: probe(BLUE) };
      sheet.textContent = held;
      return value.paper && value.blueprint ? value : null;
    };

    const dress = () => {
      const edit = edits[theme()] ?? {};
      const rules = [];
      if (edit.paper) {
        rules.push(`:root { --surface-page: ${edit.paper} !important; }`);
        rules.push(`${PLAIN} { --sheet-paper: ${edit.paper} !important; }`);
      }
      if (edit.blueprint) rules.push(`:root { --theme-blueprint: ${edit.blueprint} !important; }`);
      sheet.textContent = rules.join('\n');
    };

    /* The table the Copy button hands back: one row per theme, whether or not it was opened,
       and a second block for the papers, with the oklch the stylesheet is written in. */
    const table = () => {
      const width = Math.max(...THEMES.map((id) => id.length));
      const rows = THEMES.map((id) => {
        const base = shipped[id] ?? { page: 0, sheet: 0 };
        const edit = edits[id] ?? {};
        const page = edit.page ?? base.page;
        const sheet2 = edit.sheet ?? base.sheet;
        return `${id.padEnd(width)}  ${page.toFixed(2)}  ${sheet2.toFixed(2)}`;
      });
      const paper = THEMES.filter((id) => edits[id]?.paper || edits[id]?.blueprint).map((id) => {
        const say = (which) => {
          const value = edits[id]?.[which];
          return value ? `${value} ${oklch(value)}` : 'as it was';
        };
        return `${id.padEnd(width)}  paper ${say('paper')}  blueprint ${say('blueprint')}`;
      });
      const grain = [`${'theme'.padEnd(width)}  pages sheets`, ...rows];
      return paper.length ? [...grain, '', ...paper].join('\n') : grain.join('\n');
    };

    const paint = () => {
      const id = theme();
      const base = shipped[id] ?? { page: 0, sheet: 0 };
      const edit = edits[id] ?? {};
      for (const which of ['page', 'sheet']) {
        const value = edit[which] ?? base[which];
        root.style.setProperty(PROPERTY[which], String(value));
        sliders[which].value = String(value);
        numbers[which].value = value.toFixed(2);
        const moved = edit[which] !== undefined && round(edit[which]) !== round(base[which]);
        wases[which].textContent = moved ? `${base[which].toFixed(2)} on the branch` : 'as the branch has it';
        wases[which].dataset.moved = moved ? 'yes' : 'no';
      }
      dress();
      /* The theme's own paper is only readable while that theme is the live one, and the
         picker's transition takes a moment to hand it over. */
      if (!painted[id]) {
        setTimeout(() => {
          if (theme() !== id || painted[id]) return;
          const read = readPainted();
          if (!read) return;
          painted[id] = read;
          paint();
        }, 200);
      }
      for (const which of ['paper', 'blueprint']) {
        const shippedColour = painted[id]?.[which];
        pickers[which].value = edit[which] ?? (shippedColour ? hex(shippedColour) : '#000000');
        pickers[which].disabled = !painted[id];
      }
      for (const button of panel.querySelectorAll('[data-theme-button]')) {
        button.dataset.current = button.dataset.themeButton === id ? 'yes' : 'no';
      }
      out.value = table();
    };

    const set = (which, value) => {
      const id = theme();
      const clamped = Math.min(1, Math.max(0, Number(value) || 0));
      edits[id] = { ...(edits[id] ?? {}), [which]: round(clamped) };
      save();
      paint();
    };

    for (const which of ['page', 'sheet']) {
      sliders[which].addEventListener('input', (event) => set(which, event.target.value));
      numbers[which].addEventListener('change', (event) => set(which, event.target.value));
    }

    for (const which of ['paper', 'blueprint']) {
      pickers[which].addEventListener('input', (event) => {
        const id = theme();
        edits[id] = { ...(edits[id] ?? {}), [which]: event.target.value };
        save();
        paint();
      });
      panel.querySelector(`[data-clear="${which}"]`).addEventListener('click', () => {
        const id = theme();
        if (edits[id]) delete edits[id][which];
        save();
        paint();
      });
    }

    for (const button of panel.querySelectorAll('[data-theme-button]')) {
      button.addEventListener('click', () => {
        const id = button.dataset.themeButton;
        const radio = document.getElementById(`theme-${id}`);
        if (radio) {
          radio.click();
        } else {
          root.dataset.theme = id;
        }
        /* The picker's own transition swaps the checked radio a frame late. */
        requestAnimationFrame(paint);
      });
    }

    for (const button of panel.querySelectorAll('[data-jump]')) {
      button.addEventListener('click', () => {
        const target =
          button.dataset.jump === 'drawings'
            ? document.querySelector('article.technical-drawing-stack')
            : document.getElementById('open-source');
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    panel.querySelector('[data-copy]').addEventListener('click', async (event) => {
      out.select();
      try {
        await navigator.clipboard.writeText(out.value);
        event.target.textContent = 'Copied';
      } catch {
        event.target.textContent = 'Select it and copy';
      }
      setTimeout(() => {
        event.target.textContent = 'Copy';
      }, 1600);
    });

    panel.querySelector('[data-reset]').addEventListener('click', () => {
      delete edits[theme()];
      save();
      paint();
    });

    panel.querySelector('[data-reset-all]').addEventListener('click', () => {
      edits = {};
      save();
      paint();
    });

    const fold = panel.querySelector('[data-fold]');
    fold.addEventListener('click', () => {
      const open = fold.getAttribute('aria-expanded') === 'true';
      fold.setAttribute('aria-expanded', String(!open));
      fold.textContent = open ? 'Show' : 'Hide';
      panel.querySelector('[data-body]').hidden = open;
    });

    for (const radio of document.querySelectorAll('input[name="theme"]')) {
      radio.addEventListener('change', () => requestAnimationFrame(paint));
    }
    new MutationObserver(() => paint()).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    paint();
  })();
</script>

<style lang="scss">
  aside {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 20;
    width: 18rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.625rem 0.75rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.5rem;
    background: var(--surface-raised);
    color: var(--ink);
    font: 0.8125rem/1.35 system-ui, sans-serif;
    box-shadow: 0 0.25rem 1rem rgb(0 0 0 / 0.18);
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  [data-body] {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }

  .row {
    display: grid;
    grid-template-columns: 6.5rem 1fr 3.5rem;
    align-items: center;
    gap: 0.375rem;
  }

  .was {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-align: right;

    &[data-moved='yes'] {
      color: var(--accent);
    }
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  button {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    background: var(--surface-sunken);
    color: inherit;
    font: inherit;
    cursor: pointer;

    &[data-current='yes'] {
      border-color: var(--accent);
      background: color-mix(in oklch, var(--surface-sunken), var(--accent) 22%);
    }
  }

  input[type='color'] {
    width: 100%;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    background: var(--surface-sunken);

    &:disabled {
      opacity: 0.4;
    }
  }

  input[type='number'] {
    width: 100%;
    padding: 0.125rem 0.25rem;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    background: var(--surface-sunken);
    color: inherit;
    font: inherit;
    font-variant-numeric: tabular-nums;
  }

  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    background: var(--surface-sunken);
    color: inherit;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    resize: vertical;
  }
</style>
