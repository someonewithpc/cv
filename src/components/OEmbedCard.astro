---
type Props = {
  title: string;
  name: string;
  href: string;
  email: string;
  profiles: readonly { label: string; href: string }[];
};

const { title, name, href, email, profiles } = Astro.props;
---

<div class="oembed-card">
  <p class="meta">{title}</p>
  <p class="name"><a href={href}>{name}</a></p>
  <p class="contact">
    <a href={`mailto:${email}`}>{email}</a>
    {profiles.map(({ label, href }) => (
      <>
        <span class="sep" aria-hidden="true">·</span>
        <a href={href} rel="me noopener noreferrer">{label}</a>
      </>
    ))}
  </p>
</div>

<style is:inline>
.oembed-card {
  --canvas: oklch(0.2 0.035 265);
  --ink: oklch(0.92 0.02 250);
  --accent: oklch(0.78 0.1 75);

  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 0.375rem;
  box-sizing: border-box;
  padding: 1rem 1.5rem;
  border: 1px solid color-mix(in oklch, var(--canvas), var(--ink) 64%);
  border-radius: 0.75rem;
  background: color-mix(in oklch, var(--canvas), var(--ink) 9%);
  color: var(--ink);
  text-align: center;
}

.oembed-card p {
  margin: 0;
}

.oembed-card a {
  color: inherit;
  text-decoration: none;
}

.oembed-card .meta {
  font: 0.625rem/1.4 ui-monospace, monospace, system-ui;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: color-mix(in oklch, var(--canvas), var(--ink) 73%);
}

.oembed-card .name {
  font: 1.75rem/1.15 Georgia, "Times New Roman", serif;
}

.oembed-card .name a {
  text-decoration: underline dotted color-mix(in oklch, var(--accent), var(--canvas) 20%);
  text-underline-offset: 4px;
}

.oembed-card .contact {
  font: 0.625rem/1.6 ui-monospace, monospace, system-ui;
  letter-spacing: 0.04em;
  color: color-mix(in oklch, var(--canvas), var(--ink) 73%);
}

.oembed-card .contact a {
  text-decoration: underline dotted color-mix(in oklch, var(--accent), var(--canvas) 40%);
  text-underline-offset: 3px;
}

.oembed-card .contact a:hover {
  color: var(--accent);
}

.oembed-card .sep {
  margin: 0 0.25em;
  color: color-mix(in oklch, var(--canvas), var(--ink) 45%);
}
</style>
